# Zerops leaves these out of every deployed package (zerops.yaml deployFiles). Build-only outputs, source maps and
# tests are never served at runtime.
app/**/.output
app/**/cloudflare-dist
app/**/dist-cloudflare
app/**/*.map
app/**/@mf-types.zip
app/.zerops/build-logs
app/.zerops/unit-cache
app/**/node_modules/.cache
app/apps/*/tests
app/verticals/*/tests
app/packages/*/tests
app/scripts/tests
app/scripts/integration
app/**/.scratch
app/**/.codex
app/quality-audit
app/specs
app/docs
# Build, lint and type tooling the app host never loads: it halves the deployed package and its upload.
# The storefront service builds Next.js itself; the app service never runs it.
app/node_modules/.pnpm/next@*
app/node_modules/.pnpm/@next+swc-*
app/node_modules/.pnpm/@effect+tsgo*
app/node_modules/.pnpm/@typescript+native*
app/node_modules/.pnpm/@typescript+typescript-*
app/node_modules/.pnpm/workerd@*
app/node_modules/.pnpm/@cloudflare+workerd-*
app/node_modules/.pnpm/miniflare@*
app/node_modules/.pnpm/oxlint*
app/node_modules/.pnpm/@oxlint*
app/node_modules/.pnpm/@fallow-cli*
app/node_modules/.pnpm/playwright*
app/node_modules/.pnpm/happy-dom@*
