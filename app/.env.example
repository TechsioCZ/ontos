# Development-only local PostgreSQL values.
POSTGRES_DB=ontos
POSTGRES_USER=ontos_admin
POSTGRES_PASSWORD=ontos_admin
POSTGRES_PORT=5433
ONTOS_RUNTIME_DB_PASSWORD=ontos_runtime
DATABASE_ADMIN_URL=postgresql://ontos_admin:ontos_admin@localhost:5433/ontos
DATABASE_URL=postgresql://ontos_runtime:ontos_runtime@localhost:5433/ontos
# Dedicated pilot identities; pnpm env:local:ensure derives any missing one from a loopback DATABASE_URL.
PARTY_REGISTRY_DATABASE_URL=postgresql://party_registry_runtime:party_registry_runtime@localhost:5433/ontos
PARTY_REGISTRY_WORKER_DATABASE_URL=postgresql://party_registry_worker:party_registry_worker@localhost:5433/ontos
SHELL_GATEWAY_ISSUER_DATABASE_URL=postgresql://shell_gateway_issuer:shell_gateway_issuer@localhost:5433/ontos
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3020
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3020,http://127.0.0.1:3020
# Comma-separated Better Auth user IDs eligible to initiate support impersonation.
# Eligibility does not bypass tenant-local authorization or active Core user bindings.
BETTER_AUTH_SUPPORT_USER_IDS=

# Shell-owned gateway assertion issuer. This key pair is for local development only.
# Production must supply a different Ed25519 private JWK with alg=EdDSA, use=sig, and a non-empty kid.
ONTOS_GATEWAY_ISSUER=http://localhost:3020
ONTOS_GATEWAY_PRIVATE_JWK={"crv":"Ed25519","d":"UoaeSCRqtNBHKhIQ-gzuhaTWwch5wyr5JUp0NOV_zR0","x":"QnsRCV4QqDIWrlIw_7gfUmHsm_VYzkOzxkaaQllPXqg","kty":"OKP","alg":"EdDSA","use":"sig","kid":"ontos-local-dev"}
# MicroVertical BFFs receive public verification keys only. Retain retiring keys for at least 330 seconds.
ONTOS_GATEWAY_PUBLIC_JWKS={"keys":[{"crv":"Ed25519","x":"QnsRCV4QqDIWrlIw_7gfUmHsm_VYzkOzxkaaQllPXqg","kty":"OKP","alg":"EdDSA","use":"sig","kid":"ontos-local-dev"}]}
# The Shell's module bindings. Local module-to-module calls stay unprovisioned, so the list is empty.
ONTOS_GATEWAY_MODULE_BINDINGS=[]

# Development-only local SpiceDB values. SpiceDB always serves TLS: `pnpm env:local:ensure` creates
# the development certificate (`pnpm spicedb:tls:local`) and writes it to .env as SPICEDB_CA_CERT.
SPICEDB_ENDPOINT=localhost:50051
SPICEDB_GRPC_PORT=50051
SPICEDB_HTTP_PORT=8443
SPICEDB_PRESHARED_KEY=ontos-local-development-key

# Optional Commerce Portal authentication realm. A deployment that names none of these never opted
# in; the Commerce vertical still serves readiness and every business route, and the portal routes
# answer a retryable 503. See verticals/commerce-customer-context/README.md.
COMMERCE_PORTAL_AUTH_URL=http://localhost:3020
COMMERCE_PORTAL_AUTH_DATABASE_URL=postgresql://ontos_runtime:ontos_runtime@localhost:5433/ontos
COMMERCE_PORTAL_AUTH_DATABASE_ADMIN_URL=postgresql://ontos_admin:ontos_admin@localhost:5433/ontos
COMMERCE_PORTAL_AUTH_SECRET=replace-with-at-least-32-random-characters
COMMERCE_PORTAL_AUTH_TRUSTED_ORIGINS=http://localhost:3020,http://127.0.0.1:3020

# Optional Core identity transport for Commerce enrollment. Separate from the portal realm above so
# the endpoint and its server-owned service credential rotate independently. With neither value
# named, every Core identity owner transition stays the fail-closed unavailable port.
COMMERCE_CORE_IDENTITY_BASE_URL=http://localhost:3020/shell-super-app-api
COMMERCE_CORE_IDENTITY_API_KEY=replace-with-at-least-16-random-characters

# Core Media object storage (S3-compatible API). Key names only: no provider, endpoint, bucket, region or
# credential is chosen here, and every REQUIRED key fails closed when missing. Values come from the
# deployment's secret and configuration path, never from this file.
# REQUIRED: https origin of the S3 API (plain http only on a loopback host), bucket, signing region, and
# 'path' or 'virtual-host' addressing.
CORE_MEDIA_S3_ENDPOINT=
CORE_MEDIA_S3_BUCKET=
CORE_MEDIA_S3_REGION=
CORE_MEDIA_S3_ADDRESSING_STYLE=
# REQUIRED: 'supported' only when the provider honours `If-None-Match: *` on writes, otherwise 'unsupported'.
CORE_MEDIA_S3_CONDITIONAL_CREATE=
# REQUIRED secrets (read as Redacted values, never logged).
CORE_MEDIA_S3_ACCESS_KEY_ID=
CORE_MEDIA_S3_SECRET_ACCESS_KEY=
# OPTIONAL, no default: leave empty to use the S3 protocol minimum part size and no adapter-side timeout.
CORE_MEDIA_S3_PART_SIZE_BYTES=
CORE_MEDIA_S3_REQUEST_TIMEOUT_MS=
# OPTIONAL, no default (the built-in guard is 5000). A TECHNICAL guard in milliseconds on ONE step of the platform content
# digest (one chunk write, or the final close), never a product limit and never a bound on the whole object. Takes effect only where the host provides
# `mediaDigestStepTimeoutLayer` (not yet wired in the Shell, see docs/architecture/CORE_MEDIA.md).
CORE_MEDIA_DIGEST_STEP_TIMEOUT_MS=
