# Development-only local PostgreSQL values.
POSTGRES_DB=ontos
POSTGRES_USER=ontos_admin
POSTGRES_PASSWORD=ontos_admin
POSTGRES_PORT=5433
ONTOS_RUNTIME_DB_PASSWORD=ontos_runtime
DATABASE_ADMIN_URL=postgresql://ontos_admin:ontos_admin@localhost:5433/ontos
DATABASE_URL=postgresql://ontos_runtime:ontos_runtime@localhost:5433/ontos
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3020
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3020,http://127.0.0.1:3020

# Shell-owned gateway assertion issuer. The private JWK is a deliberately unusable placeholder.
# Production must supply one Ed25519 private JWK with alg=EdDSA, use=sig, and a non-empty kid.
ONTOS_GATEWAY_ISSUER=http://localhost:3020
ONTOS_GATEWAY_PRIVATE_JWK={"kty":"OKP","crv":"Ed25519","alg":"EdDSA","use":"sig","kid":"replace-me","x":"replace-me","d":"replace-me"}
# MicroVertical BFFs receive public verification keys only. Retain retiring keys for at least 330 seconds.
ONTOS_GATEWAY_PUBLIC_JWKS={"keys":[{"kty":"OKP","crv":"Ed25519","alg":"EdDSA","use":"sig","kid":"replace-me","x":"replace-me"}]}

# Development-only local SpiceDB values. Production must provision TLS and secrets separately.
SPICEDB_ENDPOINT=localhost:50051
SPICEDB_GRPC_PORT=50051
SPICEDB_HTTP_PORT=8443
SPICEDB_PRESHARED_KEY=ontos-local-development-key
SPICEDB_INSECURE=true
