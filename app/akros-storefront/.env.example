# AKROS storefront — SERVER environment only. Never prefix any of these with NEXT_PUBLIC_.
# Catalog, prices, stock and orders always come from OntOS via the server-side BFF.
# Dedicated least-privilege AKROS storefront service key (OntOS staff app → API klíče). Required.
ONTOS_AKROS_STOREFRONT_API_KEY=
# OntOS shell gateway origin (no trailing slash).
ONTOS_SHELL_URL=https://ontos.example.cz
# Optional extra https image hosts used in OntOS product/category images (comma-separated). Set for build AND start.
STOREFRONT_IMAGE_HOSTS=
