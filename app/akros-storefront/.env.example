# AKROS storefront — SERVER environment only. Never prefix any of these with NEXT_PUBLIC_.
# mock = Kai's local prototype (generated JSON); ontos = everything from OntOS via the server-side BFF.
STOREFRONT_DATA_SOURCE=ontos
# Dedicated least-privilege AKROS storefront service key (OntOS staff app → API klíče). Required in ontos mode.
ONTOS_AKROS_STOREFRONT_API_KEY=
# OntOS shell gateway origin (no trailing slash).
ONTOS_SHELL_URL=https://ontos.example.cz
# Active application composition publisher; ONTOS_COMPOSITION_REVISION is an optional 64-hex fallback.
ONTOS_ACTIVE_APPLICATION_COMPOSITION_URL=https://ontos.example.cz/composition/active
ONTOS_COMPOSITION_REVISION=
# Optional extra https image hosts used in OntOS product/category images (comma-separated). Set for build AND start.
STOREFRONT_IMAGE_HOSTS=
