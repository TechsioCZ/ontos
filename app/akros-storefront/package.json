{
  "name": "akros-storefront",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "catalog:generate": "node scripts/generate-akros-catalog.mjs",
    "start": "next start",
    "check:browser-bundle": "node scripts/check-browser-bundle.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:component": "vitest run tests/component",
    "test:home": "node tests/browser/homepage-layout.mjs",
    "test:catalog": "node tests/browser/catalog.mjs",
    "test:carousel": "node tests/browser/home-carousel.mjs",
    "test:favorites": "node tests/browser/favorites.mjs",
    "test:product-actions": "node tests/browser/product-actions.mjs",
    "test:variant-detail": "node tests/browser/variant-detail.mjs",
    "test:product-information": "node tests/browser/product-information.mjs",
    "test:variant-list": "node tests/browser/variant-list.mjs",
    "test:variant-filters": "node tests/browser/variant-filters.mjs",
    "test:prices": "node tests/browser/product-prices.mjs",
    "test:shared-ui": "node tests/browser/shared-ui.mjs",
    "test:search-routing": "node tests/browser/search-routing.mjs",
    "test:reorder-ui": "node tests/browser/remaining-tasks.mjs 12 && node tests/browser/reorder.mjs",
    "test:favorites-routing": "node tests/browser/favorites-routing.mjs",
    "test:cart-weight": "node tests/browser/cart-weight.mjs",
    "test:addresses": "node tests/browser/address-autocomplete.mjs",
    "test:selects": "node tests/browser/select-appearance.mjs",
    "test:account": "node tests/browser/account-profile.mjs && node tests/browser/account-area.mjs",
    "test:auth": "node tests/browser/auth.mjs",
    "test:content": "node tests/browser/content.mjs",
    "test:audit": "node tests/browser/ui-audit.mjs",
    "test:browser": "pnpm run test:responsive && pnpm run test:catalog && pnpm run test:carousel && pnpm run test:favorites && pnpm run test:product-actions && pnpm run test:variant-detail && pnpm run test:product-information && pnpm run test:variant-list && pnpm run test:variant-filters && pnpm run test:prices && pnpm run test:shared-ui && pnpm run test:search-routing && pnpm run test:account && pnpm run test:auth && pnpm run test:content && pnpm run test:theme && pnpm run test:typography && pnpm run test:audit && pnpm run test:reorder-ui && pnpm run test:favorites-routing && pnpm run test:cart-weight && pnpm run test:addresses && pnpm run test:selects",
    "test:responsive": "node tests/browser/homepage-layout.mjs && node tests/browser/variant-table-layout.mjs && node tests/browser/cart-items-layout.mjs && node tests/browser/checkout-section.mjs && node tests/browser/checkout-typography-services.mjs",
    "lint": "oxlint --react-plugin --jsx-a11y-plugin --nextjs-plugin --vitest-plugin src tests",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build",
    "test:typography": "node tests/browser/global-typography.mjs",
    "test:theme": "node tests/browser/ui-kit-theme.mjs"
  },
  "dependencies": {
    "@techsio/ui-kit": "catalog:",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@iconify/tailwind4": "1.2.3",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "^26.4.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "fflate": "0.8.3",
    "jsdom": "30.1.1",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "playwright-core": "1.58.2",
    "saxes": "6.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "packageManager": "pnpm@12.4.2"
}
