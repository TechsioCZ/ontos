{
  "name": "akros-storefront",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "cloudflare:configure": "node scripts/cloudflare-config.mjs",
    "cloudflare:build": "pnpm run cloudflare:configure && AKROS_CLOUDFLARE_BUILD=1 opennextjs-cloudflare build --config .wrangler.generated.json",
    "cloudflare:deploy": "pnpm run cloudflare:configure && opennextjs-cloudflare deploy --config .wrangler.generated.json",
    "catalog:generate": "node scripts/generate-akros-catalog.mjs",
    "start": "next start",
    "check:browser-bundle": "node scripts/check-browser-bundle.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:component": "vitest run tests/component",
    "test:home": "node tests/browser/homepage-layout.mjs",
    "test:catalog": "node tests/browser/catalog.mjs",
    "test:carousel": "node tests/browser/home-carousel.mjs",
    "test:shared-ui": "node tests/browser/shared-ui.mjs",
    "test:account": "node tests/browser/account-profile.mjs && node tests/browser/account-area.mjs",
    "test:responsive": "node tests/browser/homepage-layout.mjs && node tests/browser/variant-table-layout.mjs && node tests/browser/cart-items-layout.mjs && node tests/browser/checkout-section.mjs && node tests/browser/checkout-typography-services.mjs",
    "lint": "oxlint --react-plugin --jsx-a11y-plugin --nextjs-plugin --vitest-plugin src tests",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build",
    "test:typography": "node tests/browser/global-typography.mjs",
    "test:theme": "node tests/browser/ui-kit-theme.mjs"
  },
  "dependencies": {
    "@techsio/ui-kit": "catalog:",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@iconify/tailwind4": "1.2.3",
    "@opennextjs/cloudflare": "1.20.10",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "26.4.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "fflate": "0.8.3",
    "jsdom": "30.1.1",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "playwright-core": "1.58.2",
    "saxes": "6.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.2",
    "wrangler": "4.151.3"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "packageManager": "pnpm@12.4.2"
}
