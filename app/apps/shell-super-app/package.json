{
  "name": "@app/shell-super-app",
  "version": "0.1.0",
  "private": true,
  "exports": {
    "./api": "./shared/api.ts",
    "./api/client": "./src/api/auth-client.ts"
  },
  "scripts": {
    "dev": "modern dev",
    "build": "modern build --deploy-target node && node ../../scripts/generate-ontos-shell-runtime-contract.mts --shell-directory . --target dist && ultramodern-create ultramodern public-surface --app shell-super-app --target dist && modern deploy --skip-build --deploy-target node",
    "cloudflare:build": "modern build --deploy-target cloudflare && node ../../scripts/generate-ontos-shell-runtime-contract.mts --shell-directory . --target cloudflare-dist && ultramodern-create ultramodern public-surface --app shell-super-app --target cloudflare-dist && modern deploy --skip-build --deploy-target cloudflare",
    "cloudflare:deploy": "node ../../scripts/immutable-shell-release.mts ingress-deploy --app-directory .",
    "cloudflare:preview": "pnpm run cloudflare:build && wrangler dev --config .output/wrangler.json",
    "cloudflare:proof": "ultramodern-create ultramodern cloudflare-proof --app shell-super-app",
    "serve": "modern serve",
    "typecheck": "ultramodern-create ultramodern typecheck --project tsconfig.json",
    "db:generate": "drizzle-kit generate --config drizzle.auth.config.ts",
    "db:check": "drizzle-kit check --config drizzle.auth.config.ts",
    "db:migrate": "drizzle-kit migrate --config drizzle.auth.config.ts",
    "db:verify": "node scripts/verify-auth-db-schema.mts",
    "stage:bootstrap-accounts": "node scripts/bootstrap-stage-accounts.mts",
    "test:e2e": "playwright test",
    "test:integration": "rstest --project integration",
    "test:unit": "rstest --project unit"
  },
  "dependencies": {
    "@app/assortment": "workspace:*",
    "@app/better-auth-effect-drizzle": "workspace:*",
    "@app/catalog": "workspace:*",
    "@app/commerce-customer-context": "workspace:*",
    "@app/commerce-market-catalog": "workspace:*",
    "@app/core-runtime": "workspace:*",
    "@app/inventory": "workspace:*",
    "@app/party-registry": "workspace:*",
    "@app/shared-contracts": "workspace:*",
    "@app/shared-design-tokens": "workspace:*",
    "@app/siampark-agreements": "workspace:*",
    "@app/siampark-billing-finance": "workspace:*",
    "@app/siampark-occupancy": "workspace:*",
    "@app/siampark-property": "workspace:*",
    "@app/siampark-relationships": "workspace:*",
    "@app/siampark-work": "workspace:*",
    "@authzed/authzed-node": "1.6.1",
    "@better-auth/api-key": "1.7.6",
    "@effect/opentelemetry": "4.0.0-rc.117",
    "@effect/sql-pg": "4.0.0-rc.117",
    "@modern-js/bff-effect": "catalog:ultramodern",
    "@modern-js/boundary-debugger": "catalog:ultramodern",
    "@modern-js/federation-runtime": "catalog:ultramodern",
    "@modern-js/i18n-integration": "catalog:ultramodern",
    "@modern-js/plugin-bff": "catalog:ultramodern",
    "@modern-js/plugin-bff-extensions": "catalog:ultramodern",
    "@modern-js/plugin-i18n": "catalog:ultramodern",
    "@modern-js/plugin-tanstack": "catalog:ultramodern",
    "@modern-js/runtime": "catalog:ultramodern",
    "@modern-js/runtime-extensions": "catalog:ultramodern",
    "@modern-js/runtime-renderer-extensions": "catalog:ultramodern",
    "@module-federation/modern-js-v3": "npm:@bleedingdev/mf-modern-js-v3@2.9.3",
    "@tanstack/react-router": "1.170.39",
    "@techsio/ui-kit": "0.25.1",
    "better-auth": "1.7.6",
    "drizzle-orm": "1.0.0-rc.5-ab785fc",
    "effect": "4.0.0-rc.117",
    "i18next": "26.4.2",
    "jose": "6.2.5",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260923.1",
    "@effect/platform-node": "4.0.0-rc.117",
    "@modern-js/adapter-rstest": "catalog:ultramodern",
    "@modern-js/app-tools": "catalog:ultramodern",
    "@modern-js/app-tools-extensions": "catalog:ultramodern",
    "@modern-js/plugin-bff-build-extensions": "catalog:ultramodern",
    "@modern-js/ultramodern-app-tools": "catalog:ultramodern",
    "@playwright/test": "1.61.0",
    "@rsbuild/plugin-tailwindcss": "^2.0.3",
    "@rstest/core": "0.11.12",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "bun-types": "1.4.0",
    "drizzle-kit": "1.0.0-rc.5-ab785fc",
    "effect-rstest": "https://pkg.pr.new/ScriptedAlchemy/effect-rstest@cbbf87e05c7517a85eb412d33421cd2ab5234597",
    "happy-dom": "20.8.3",
    "pg": "8.22.0",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2",
    "wrangler": "4.137.0",
    "zephyr-rspack-plugin": "1.2.4"
  },
  "modernjs": {
    "preset": "presetUltramodern",
    "role": "shell",
    "appId": "shell-super-app",
    "topology": "../../topology/reference-topology.json"
  },
  "zephyr:dependencies": {
    "partyRegistry": "@app/party-registry@workspace:*",
    "commerceMarketCatalog": "@app/commerce-market-catalog@workspace:*",
    "catalog": "@app/catalog@workspace:*",
    "inventory": "@app/inventory@workspace:*",
    "assortment": "@app/assortment@workspace:*",
    "siamparkProperty": "@app/siampark-property@workspace:*",
    "siamparkOccupancy": "@app/siampark-occupancy@workspace:*",
    "siamparkAgreements": "@app/siampark-agreements@workspace:*",
    "siamparkWork": "@app/siampark-work@workspace:*",
    "siamparkBillingFinance": "@app/siampark-billing-finance@workspace:*",
    "siamparkRelationships": "@app/siampark-relationships@workspace:*"
  }
}
