{
  "name": "@app/shell-super-app",
  "version": "0.1.0",
  "private": true,
  "exports": {
    "./api/clients": "./src/api/vertical-clients.ts"
  },
  "scripts": {
    "dev": "modern dev",
    "build": "ULTRAMODERN_ZEPHYR=false modern build && node ../../scripts/generate-public-surface-assets.mts --app shell-super-app --target dist",
    "cloudflare:build": "ULTRAMODERN_ZEPHYR=false MODERNJS_DEPLOY=cloudflare modern build && ULTRAMODERN_ZEPHYR=false MODERNJS_DEPLOY=cloudflare modern deploy --skip-build && node ../../scripts/generate-public-surface-assets.mts --app shell-super-app --target cloudflare && node ../../scripts/verify-cloudflare-output.mts --app shell-super-app",
    "cloudflare:deploy": "ULTRAMODERN_CLOUDFLARE_REQUIRE_PUBLIC_URLS=true pnpm run cloudflare:build && wrangler deploy --config .output/wrangler.json",
    "cloudflare:preview": "pnpm run cloudflare:build && wrangler dev --config .output/wrangler.json",
    "cloudflare:proof": "node ../../scripts/proof-cloudflare-version.mts --app shell-super-app",
    "serve": "modern serve",
    "typecheck": "node ../../scripts/ultramodern-typecheck.mts --project tsconfig.json"
  },
  "dependencies": {
    "@app/shared-contracts": "workspace:*",
    "@app/shared-design-tokens": "workspace:*",
    "@modern-js/plugin-bff": "npm:@bleedingdev/modern-js-plugin-bff@3.5.0-ultramodern.44",
    "@modern-js/plugin-i18n": "npm:@bleedingdev/modern-js-plugin-i18n@3.5.0-ultramodern.44",
    "@modern-js/plugin-tanstack": "npm:@bleedingdev/modern-js-plugin-tanstack@3.5.0-ultramodern.44",
    "@modern-js/runtime": "npm:@bleedingdev/modern-js-runtime@3.5.0-ultramodern.44",
    "@module-federation/bridge-react": "2.7.0",
    "@module-federation/modern-js-v3": "2.7.0",
    "@module-federation/runtime": "2.7.0",
    "@tanstack/react-router": "1.170.17",
    "@techsio/ui-kit": "0.25.1",
    "i18next": "26.3.6",
    "node-fetch": "^3.3.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "7.18.1"
  },
  "devDependencies": {
    "@effect/tsgo": "0.16.3",
    "@modern-js/app-tools": "npm:@bleedingdev/modern-js-app-tools@3.5.0-ultramodern.44",
    "@rsbuild/plugin-tailwindcss": "^2.0.3",
    "@types/node": "^20",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "tailwindcss": "^4.3.2",
    "typescript": "7.0.2",
    "wrangler": "4.109.0",
    "zephyr-rspack-plugin": "1.1.1"
  },
  "modernjs": {
    "preset": "presetUltramodern",
    "role": "shell",
    "appId": "shell-super-app",
    "topology": "../../topology/reference-topology.json"
  },
  "zephyr:dependencies": {}
}
