{
  "name": "@app/shell-super-app",
  "version": "0.1.0",
  "private": true,
  "exports": {
    "./api": "./shared/api.ts",
    "./api/client": "./src/api/auth-client.ts",
    "./testing/api-key-gateway-native": "./tests/fixtures/api-key-gateway-native.ts",
    "./testing/tenant-party-shell-http": "./tests/support/tenant-party-shell-http.ts",
    "./testing/api-key-gateway-native-child": "./tests/support/api-key-gateway-native-child.ts",
    "./outbox-worker-host": "./src/entry.core-system-worker.ts"
  },
  "scripts": {
    "dev": "modern dev",
    "build": "node ../../scripts/generate-shell-ui-candidates.mts --check --all && modern build --deploy-target node && node ../../scripts/generate-ontos-shell-runtime-contract.mts --shell-directory . --target dist && ultramodern-create ultramodern public-surface --app shell-super-app --target dist && modern deploy --skip-build --deploy-target node",
    "serve": "modern serve",
    "typecheck": "ultramodern-create ultramodern typecheck --project tsconfig.json",
    "db:generate": "drizzle-kit generate --config drizzle.auth.config.ts",
    "db:check": "drizzle-kit check --config drizzle.auth.config.ts",
    "db:migrate": "drizzle-kit migrate --config drizzle.auth.config.ts",
    "db:verify": "node scripts/verify-auth-db-schema.mts",
    "stage:bootstrap-accounts": "node scripts/bootstrap-stage-accounts.mts",
    "test:e2e": "playwright test",
    "test:integration": "rstest --project integration",
    "test:unit": "rstest --project unit"
  },
  "dependencies": {
    "@app/better-auth-effect-drizzle": "workspace:*",
    "@app/core-runtime": "workspace:*",
    "@app/shared-contracts": "workspace:*",
    "@app/shared-design-tokens": "workspace:*",
    "@authzed/authzed-node": "1.6.1",
    "@better-auth/api-key": "1.7.12",
    "@effect/opentelemetry": "4.0.7",
    "@effect/sql-pg": "4.0.7",
    "@modern-js/backend-federation-contracts": "catalog:ultramodern",
    "@modern-js/bff-effect": "catalog:ultramodern",
    "@modern-js/boundary-debugger": "catalog:ultramodern",
    "@modern-js/federation-runtime": "catalog:ultramodern",
    "@modern-js/i18n-integration": "catalog:ultramodern",
    "@modern-js/plugin-bff": "catalog:ultramodern",
    "@modern-js/plugin-bff-extensions": "catalog:ultramodern",
    "@modern-js/plugin-i18n": "catalog:ultramodern",
    "@modern-js/plugin-tanstack": "catalog:ultramodern",
    "@modern-js/runtime": "catalog:ultramodern",
    "@modern-js/runtime-extensions": "catalog:ultramodern",
    "@modern-js/runtime-renderer-extensions": "catalog:ultramodern",
    "@module-federation/modern-js-v3": "npm:@bleedingdev/mf-modern-js-v3@2.9.4",
    "@noble/hashes": "2.2.0",
    "@tanstack/react-router": "1.170.39",
    "@techsio/ui-kit": "catalog:",
    "better-auth": "1.7.12",
    "drizzle-orm": "1.0.0-rc.5-ab785fc",
    "effect": "4.0.7",
    "i18next": "26.4.2",
    "jose": "6.2.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@app/admin-ui": "workspace:*",
    "@app/email-delivery": "workspace:*",
    "@better-auth/cimd": "1.7.12",
    "@better-auth/mcp": "1.7.12",
    "@better-auth/oauth-provider": "1.7.12",
    "@modelcontextprotocol/server": "2.3.1",
    "@app/party-registry-identity-contracts": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260923.1",
    "@effect/platform-node": "4.0.7",
    "@modern-js/adapter-rstest": "catalog:ultramodern",
    "@modern-js/app-tools": "catalog:ultramodern",
    "@modern-js/app-tools-extensions": "catalog:ultramodern",
    "@modern-js/plugin-bff-build-extensions": "catalog:ultramodern",
    "@modern-js/ultramodern-app-tools": "catalog:ultramodern",
    "@playwright/test": "1.61.0",
    "@rsbuild/plugin-tailwindcss": "^2.0.3",
    "@rstest/core": "0.11.12",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "^26.4.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "bun-types": "1.4.0",
    "drizzle-kit": "1.0.0-rc.5-ab785fc",
    "effect-rstest": "https://pkg.pr.new/ScriptedAlchemy/effect-rstest@cbbf87e05c7517a85eb412d33421cd2ab5234597",
    "happy-dom": "21.0.4",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2",
    "pg": "8.22.0",
    "@modelcontextprotocol/client": "2.3.1"
  },
  "modernjs": {
    "preset": "presetUltramodern",
    "role": "shell",
    "appId": "shell-super-app",
    "topology": "../../topology/reference-topology.json"
  }
}
