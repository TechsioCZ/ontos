{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "customConditions": [
      "node"
    ],
    "skipLibCheck": true,
    "disableSourceOfProjectReferenceRedirect": true
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "**/node_modules/**"
  ],
  "references": [
    {
      "path": "../../../../tsconfig.sources.json"
    },
    {
      "path": "../../../../tsconfig.tooling-declarations.json"
    }
  ]
}
