{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "customConditions": [
      "node"
    ],
    "noEmit": true,
    "types": [
      "node"
    ],
    "skipLibCheck": true,
    "disableSourceOfProjectReferenceRedirect": true
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "integration/**",
    "**/node_modules/**"
  ],
  "references": [
    {
      "path": "../../../tsconfig.sources.json"
    },
    {
      "path": "../../../tsconfig.tooling-declarations.json"
    }
  ]
}
