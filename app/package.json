    "check:local": "node ./scripts/check-local.mts",
    "database-access:check": "node ./scripts/check-database-access-boundaries.mts",
    "lean-core:check": "node ./scripts/check-lean-core-dependencies.mts",
    "authorization:catalog:artifact": "node ./scripts/authorization-catalog-artifact.mts",
    "authorization:catalog:artifact:check": "node ./scripts/authorization-catalog-artifact.mts --check",
    "authorization:catalog:diff": "node ./scripts/authorization-catalog-diff.mts",
    "authorization:catalog:report": "node ./scripts/authorization-catalog-report.mts",
    "authorization:inventory:check": "node ./scripts/check-module-entrypoint-boundaries.mts && node ./scripts/authorization-catalog-report.mts --quiet && node ./scripts/authorization-catalog-artifact.mts --check",
    "quality:audit": "node ./scripts/quality-audit.mts",
    "quality:audit:gate": "node ./scripts/quality-audit-gate.mts",
    "quality:check": "pnpm quality:audit && pnpm quality:audit:gate && pnpm lint:suppressions",
    "quality:audit:test": "rstest --project scripts scripts/tests/quality-audit.test.mts scripts/tests/quality-audit-model.test.mts scripts/tests/quality-audit-runtime-model.test.mts scripts/tests/quality-audit-gate.test.mts scripts/tests/quality-audit-native-resolver.test.mts scripts/tests/quality-cli-lifecycle.test.mts scripts/tests/quality-audit-count-domain.test.mts scripts/tests/lint-suppression-ratchet.test.mts",
