{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "verticals/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "pnpm run \"/^dev:(?:applications|outbox-worker-host)$/\"",
    "dev:applications": "pnpm --parallel --filter @app/shell-super-app --filter './verticals/*' run dev",
    "dev:outbox-worker-host": "node --experimental-strip-types ./scripts/outbox-worker-host.generated.mts",
    "dev:shell": "pnpm --filter @app/shell-super-app dev",
    "dev:party-registry": "pnpm --filter @app/party-registry dev",
    "dev:commerce-customer-context": "pnpm --filter @app/commerce-customer-context dev",
    "dev:payment-term-catalog": "pnpm --filter @app/payment-term-catalog dev",
    "dev:payment": "pnpm --filter @app/payment dev",
    "dev:commerce-market-catalog": "pnpm --filter @app/commerce-market-catalog dev",
    "dev:catalog": "pnpm --filter @app/catalog dev",
    "dev:pricing": "pnpm --filter @app/pricing dev",
    "dev:storefront-registry": "pnpm --filter @app/storefront-registry dev",
    "dev:assortment": "pnpm --filter @app/assortment dev",
    "dev:tax": "pnpm --filter @app/tax dev",
    "build": "ultramodern-create ultramodern typecheck --build packages/shared-contracts/tsconfig.json && pnpm -r --no-sort --filter \"./verticals/*\" run build && pnpm --filter \"./apps/shell-super-app\" run build && pnpm mf:types && pnpm performance:readiness",
    "cloudflare:build": "ultramodern-create ultramodern typecheck --build packages/shared-contracts/tsconfig.json && pnpm -r --no-sort --filter \"./verticals/*\" run cloudflare:build && pnpm --filter \"./apps/shell-super-app\" run cloudflare:build && pnpm mf:types --target cloudflare && pnpm cloudflare-output:verify && pnpm cloudflare:ssr-proof",
    "cloudflare:deploy": "node ./scripts/immutable-application-release.mts deploy",
    "cloudflare:proof": "ultramodern-create ultramodern cloudflare-proof --out .codex/reports/cloudflare-version-proof/public-url-proof.json",
    "cloudflare:ssr-proof": "sh ./scripts/prove-workerd-ssr.sh",
    "cloudflare-output:verify": "ultramodern-create ultramodern cloudflare-output-verify",
    "node:backend-federation:generate": "ultramodern-create ultramodern backend-federation-generate",
    "node:proof": "ultramodern-create ultramodern backend-federation-proof",
    "mf:types": "ultramodern-create ultramodern mf-types",
    "performance:readiness": "ultramodern-create ultramodern performance-readiness",
    "zerops:materialize": "node ./scripts/materialize-ontos-zerops-runtime.mjs",
    "contract:check": "ultramodern-create ultramodern validate",
    "typecheck": "ultramodern-create ultramodern typecheck --build tsconfig.json",
    "check": "node ./scripts/check.mts",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "effect-tsgo --tsrs-lint=7.1.0-beta.tsrs3 oxlint apps verticals packages scripts tools/oxlint/effect-native/tests/*.test.mts && pnpm lint:effect-diagnostics && pnpm lint:semantic",
    "lint:semantic": "ultramodern-create ultramodern semantic-lint apps verticals packages scripts \"tools/oxlint/effect-native/tests/*.test.mts\"",
    "lint:effect-diagnostics": "node scripts/check-effect-diagnostics.mts apps/shell-super-app/tests/tsconfig.json apps/shell-super-app/tests/integration/tsconfig.json packages/shared-contracts/tests/tsconfig.json packages/shared-contracts/tests/client-runtime-types.tsconfig.json scripts/scaffolding/tsconfig.json",
    "lint:fix": "effect-tsgo --tsrs-lint=7.1.0-beta.tsrs3 oxlint apps verticals packages scripts tools/oxlint/effect-native/tests/*.test.mts --fix && pnpm lint:semantic",
    "lint:suppressions": "node ./scripts/lint-suppression-ratchet.mts",
    "lint:repository-policy": "node tools/oxlint/effect-native/repository-policy.mts",
    "ui:module-css:check": "node ./scripts/check-module-browser-css.mts",
    "skills:install": "ultramodern-create ultramodern skills install",
    "skills:check": "ultramodern-create ultramodern skills check",
    "agents:refs:install": "node ./scripts/setup-agent-reference-repos.mts",
    "agents:refs:check": "node ./scripts/setup-agent-reference-repos.mts --check",
    "api:check": "modern-api-check --rules ./scripts/api-contract-schema-rules.mts",
    "api:check:files": "modern-api-check-files --rules ./scripts/api-contract-schema-rules.mts",
    "i18n:boundaries": "modern-i18n-check",
    "postinstall": "ultramodern-create ultramodern skills install --postinstall",
    "sandbox:new": "sh ./scripts/locki-feature.sh",
    "env:local:ensure": "node ./scripts/ensure-local-environment.mts",
    "spicedb:tls:local": "node ./scripts/local-spicedb-tls.mts",
