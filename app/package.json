    "db:bootstrap-runtime-role": "node ./scripts/postgres/bootstrap-runtime-role.mts",
    "db:portal-auth:check": "node ./scripts/run-optional-commerce-portal-auth-db.mts check",
    "db:portal-auth:generate": "node ./scripts/run-optional-commerce-portal-auth-db.mts generate",
    "db:portal-auth:migrate": "node ./scripts/run-optional-commerce-portal-auth-db.mts migrate",
    "db:bootstrap-spicedb": "node ./scripts/postgres/bootstrap-spicedb-database.mts",
    "db:check": "pnpm --filter @app/core-runtime db:check && pnpm --filter @app/shell-super-app db:check && pnpm --filter @app/party-registry db:check && pnpm --filter @app/payment-term-catalog db:check && pnpm --filter @app/payment db:check && pnpm --filter @app/price-group-catalog db:check && pnpm --filter @app/commerce-customer-context db:check && pnpm --filter @app/commerce-market-catalog db:check && pnpm --filter @app/catalog db:check && pnpm --filter @app/inventory db:check && pnpm --filter @app/pricing db:check && pnpm --filter @app/assortment db:check && pnpm --filter @app/tax db:check && pnpm --filter @app/privacy db:check && pnpm --filter @app/symmy-integration db:check && pnpm db:portal-auth:check && pnpm --filter @app/projects db:check && pnpm --filter @app/commerce-cart db:check && pnpm --filter @app/commerce-order db:check && pnpm --filter @app/promotion db:check && pnpm --filter @app/communications db:check",
    "db:migrate": "pnpm db:bootstrap-runtime-role && pnpm --filter @app/core-runtime db:migrate && pnpm --filter @app/shell-super-app db:migrate && pnpm --filter @app/party-registry db:migrate && pnpm --filter @app/payment-term-catalog db:migrate && pnpm --filter @app/payment db:migrate && pnpm --filter @app/price-group-catalog db:migrate && pnpm --filter @app/commerce-customer-context db:migrate && pnpm --filter @app/commerce-market-catalog db:migrate && pnpm --filter @app/catalog db:migrate && pnpm --filter @app/inventory db:migrate && pnpm --filter @app/pricing db:migrate && pnpm --filter @app/storefront-registry db:migrate && pnpm --filter @app/assortment db:migrate && pnpm --filter @app/tax db:migrate && pnpm --filter @app/privacy db:migrate && pnpm --filter @app/symmy-integration db:migrate && pnpm --filter @app/promotion db:migrate && pnpm --filter @app/communications db:migrate && pnpm db:bootstrap-runtime-role && pnpm db:portal-auth:migrate && pnpm --filter @app/projects db:migrate && pnpm --filter @app/commerce-cart db:migrate && pnpm --filter @app/commerce-order db:migrate && pnpm db:bootstrap-runtime-role",
    "db:test": "pnpm --filter @app/core-runtime db:test && pnpm --filter @app/shell-super-app test:integration && pnpm --filter @app/party-registry db:test && pnpm --filter @app/payment-term-catalog db:test && pnpm --filter @app/payment db:test && pnpm --filter @app/price-group-catalog db:test && pnpm --filter @app/commerce-customer-context db:test && pnpm --filter @app/commerce-market-catalog db:test && pnpm --filter @app/catalog db:test && pnpm --filter @app/inventory db:test && pnpm --filter @app/pricing db:test && pnpm --filter @app/assortment db:test && pnpm --filter @app/tax db:test && pnpm --filter @app/privacy db:test && pnpm --filter @app/symmy-integration db:test && pnpm --filter @app/projects db:test && pnpm --filter @app/promotion db:test && pnpm --filter @app/communications db:test",
    "database-trust:audit": "node ./scripts/audit-database-trust-boundaries.mts",
    "db:verify": "node ./scripts/verify-application-db-schema.mts",
    "local:initialize": "node ./scripts/initialize-local-development.mts",
    "local:enrol-integrity": "node ./scripts/enrol-local-integrity-principal.mts",
    "test:unit": "pnpm -r --no-sort --if-present run test:unit && pnpm -r --no-sort --if-present run test:component && pnpm --filter @app/shared-contracts test:types",
    "test:integration": "rstest --project integration --pool.maxWorkers 1 && pnpm -r --no-sort --workspace-concurrency 1 --if-present run test:integration --pool.maxWorkers 1",
    "test:scripts": "rstest --project scripts --pool.maxWorkers 4",
    "test:scripts:timings": "rstest --project scripts --pool.maxWorkers 1 --reporters verbose",
    "test:lint-rules": "rstest --project lint-rules",
    "typecheck:lint-rules": "ultramodern-create ultramodern typecheck --project tools/oxlint/effect-native/tsconfig.json",
    "lint:effect": "node tools/oxlint/effect-native/report.mts",
