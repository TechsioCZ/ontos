{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "incremental": true,
    "tsBuildInfoFile": "../../node_modules/.cache/tsrs/packages__admin-ui__typecheck.tsbuildinfo",
    "types": [
      "node"
    ],
    "skipLibCheck": true
  },
  "include": [
    "*.mts",
    "*.ts",
    "*.tsx",
    "scripts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    ".output",
    ".modern",
    ".modernjs"
  ],
  "references": [
    {
      "path": "./tsconfig.json"
    }
  ]
}
