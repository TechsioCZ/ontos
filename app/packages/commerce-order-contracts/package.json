{
  "name": "@app/commerce-order-contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Commerce Order-owned exact Bundle/Attempt and durable commit verification contracts.",
  "exports": {
    "./verify-order-commitment-binding": "./src/apis/verify-order-commitment-binding.ts",
    "./verify-order-commitment-binding/client": "./src/api/verify-order-commitment-binding-client.ts",
    "./committed-order-approval-evidence": "./src/apis/committed-order-approval-evidence.ts",
    "./committed-order-approval-evidence/client": "./src/api/committed-order-approval-evidence-client.ts",
    "./prepared-order-pricing-binding": "./src/apis/prepared-order-pricing-binding.ts",
    "./prepared-order-pricing-binding/client": "./src/api/prepared-order-pricing-binding-client.ts",
    "./prepared-order-approval-binding": "./src/apis/prepared-order-approval-binding.ts",
    "./prepared-order-approval-binding/client": "./src/api/prepared-order-approval-binding-client.ts"
  },
  "scripts": {
    "typecheck": "ultramodern-create ultramodern typecheck --project tsconfig.json"
  },
  "dependencies": {
    "@app/core-runtime": "workspace:*",
    "@app/shared-contracts": "workspace:*",
    "effect": "4.0.7",
    "@app/pricing-contracts": "workspace:*"
  },
  "ontosContractOwner": {
    "appId": "commerce-order",
    "moduleApis": [
      "verify-order-commitment-binding",
      "committed-order-approval-evidence",
      "prepared-order-pricing-binding",
      "prepared-order-approval-binding"
    ],
    "moduleId": "commerce.order",
    "packageName": "@app/commerce-order"
  }
}
