{
  "name": "@app/core-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./actions/principal-context": "./src/actions/principal-context.ts",
    "./actions/runtime-wiring": "./src/actions/runtime-wiring.ts",
    "./auth/gateway-assertion-redemption": "./src/auth/gateway-assertion-redemption.ts",
    "./auth/system-principal-context-provenance": "./src/auth/system-principal-context-provenance.ts",
    "./http/action-runner": "./src/http/http-instrumentation-seam.ts",
    "./http/governed-read": "./src/http/governed-read.ts",
    "./http/principal-authentication": "./src/http/principal-authentication.ts",
    "./install/stage-context-bootstrap": "./src/install/stage-context-bootstrap.ts",
    "./outbox/worker": "./src/outbox/worker-entrypoint.ts",
    "./testing/actions": "./src/testing/actions.ts",
    "./workspace-environment": "./src/environment/workspace-environment.ts"
  },
  "scripts": {
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:check": "drizzle-kit check --config drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config drizzle.config.ts",
    "db:test": "rstest --project unit --project integration",
    "db:verify": "node scripts/verify-db-schema.mts",
    "test:unit": "rstest --project unit",
    "test:integration": "rstest --project integration",
    "action:test:unit": "rstest --project unit tests/unit/action-",
    "action:test:integration": "rstest --project integration tests/integration/action-",
    "outbox:test:unit": "rstest --project unit tests/unit/outbox-",
    "outbox:test:integration": "rstest --project integration tests/integration/outbox-",
    "typecheck": "node ../../scripts/ultramodern-typecheck.mts --project tsconfig.json"
  },
  "dependencies": {
    "@authzed/authzed-node": "1.6.1",
    "@effect/platform-node": "4.0.0-rc.112",
    "drizzle-orm": "1.0.0-rc.5-ab785fc",
    "effect": "4.0.0-rc.112",
    "pg": "8.22.0",
    "@effect/sql-pg": "4.0.0-rc.112"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/pg": "8.20.0",
    "drizzle-kit": "1.0.0-rc.5-ab785fc",
    "effect-rstest": "https://pkg.pr.new/ScriptedAlchemy/effect-rstest@79abbf684c7b150ee5f32694129a7caf969903bc",
    "@rstest/core": "0.11.11"
  }
}
