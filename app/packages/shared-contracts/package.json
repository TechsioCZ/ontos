{
  "name": "@app/shared-contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Generated route, ownership, and topology contracts.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./server/effect-bff-runtime": "./src/effect-bff-runtime.ts",
    "./ultramodern-build": "./src/ultramodern-build.ts",
    "./problem-details": "./src/problem-details.ts",
    "./client-runtime": "./src/client-runtime.ts",
    "./server/gateway-context-api-key": "./src/gateway-context-api-key.ts",
    "./external-identity": "./src/external-identity.ts",
    "./server/external-identity-client": "./src/external-identity-client.ts"
  },
  "scripts": {
    "test:types": "ultramodern-create ultramodern typecheck --project tests/tsconfig.json && ultramodern-create ultramodern typecheck --project tests/client-runtime-types.tsconfig.json",
    "test:unit": "rstest --project unit && pnpm test:types",
    "typecheck": "ultramodern-create ultramodern typecheck --project tsconfig.json"
