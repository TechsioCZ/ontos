{
  "name": "@app/shared-contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Generated route, ownership, and topology contracts.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./server/effect-bff-runtime": "./src/effect-bff-runtime.ts",
    "./ultramodern-build": "./src/ultramodern-build.ts",
