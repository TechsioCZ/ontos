+    chain !== undefined &&
+    isAccessPath(chain.base.expression, ['HttpApi', 'make']) &&
+    chain.base.arguments.length === 1 &&
+    stringLiteral(chain.base.arguments[0]) === `${pascalCaseStem(stem)}Api` &&
