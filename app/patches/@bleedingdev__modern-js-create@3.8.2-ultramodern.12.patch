+export const configuredMicroVerticalApiStem = (
+  verticalPath: string,
+  verticals: readonly MicroVerticalTopologyEntry[],
+): string | undefined => {
+  const topologyVertical = verticals.find(
+    (vertical) => (vertical.path ?? `verticals/${vertical.id}`) === verticalPath,
