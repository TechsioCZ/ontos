+      additionalPaths: {},
+      apiPrefix: `/${stem}-api`,
+      basePath: `/${stem}-api/${stem}`,
+      effectClientPackage: '@modern-js/plugin-bff/effect-client',
+      ownerId: stem,
+      readinessPath: `/${stem}-api/${stem}/readiness`,
+      sharedContractsPackage: '@app/shared-contracts',
+    },
+  );
