index 0000000000000000000000000000000000000000..4a9fca9f14125bae1aad62a16a28fc708c98c4d8
--- /dev/null
+++ b/src/effect-source-loader/global-vars.ts
@@ -0,0 +1,45 @@
+import { applyOptionsChain } from '@modern-js/utils';
+import type { ConfigChainWithContext, RsbuildTarget } from '@rsbuild/core';
+
+export type ServerGlobalVarsOptions = ConfigChainWithContext<
+  Record<string, unknown>,
+  { env: string; target: RsbuildTarget }
+>;
+
+declare module '@modern-js/server-core' {
+  interface SourceUserConfig {
+    globalVars?: ServerGlobalVarsOptions;
+  }
+}
+
+export const serializeServerGlobalVars = (
+  options: ServerGlobalVarsOptions | undefined,
+): Record<string, string> => {
+  const globalVars = applyOptionsChain<
+    Record<string, unknown>,
+    { env: string; target: RsbuildTarget }
+  >({}, options, {
+    env: 'server',
+    target: 'node',
+  });
+
+  return Object.fromEntries(
+    Object.entries(globalVars).map(([key, value]) => {
+      let serialized: string | undefined;
+      try {
+        serialized = JSON.stringify(value);
+      } catch (error) {
+        throw new Error(
+          `source.globalVars["${key}"] cannot be serialized exactly for BFF compilation.`,
+          { cause: error },
+        );
+      }
+      if (serialized === undefined) {
+        throw new Error(
+          `source.globalVars["${key}"] cannot be serialized exactly for BFF compilation.`,
+        );
+      }
+      return [key, serialized];
+    }),
+  );
+};
