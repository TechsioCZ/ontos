{
  "minimumVersion": "3.22.0",
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/dist-cloudflare/**",
    "**/cloudflare-dist/**",
    "**/.output/**",
    "**/.modern/**",
    "**/.modernjs/**",
    "**/modern-tanstack/**",
    "**/routeTree.gen.*",
    "tools/oxlint/effect-native/tests/fixtures/**",
    "**/.env",
    "**/.env.*",
    "repos/**",
    "vendor/**",
    "docs/**",
    "specs/**",
    ".agents/**",
    ".codex/**",
    "**/.next/**",
    "**/.open-next/**",
    "**/.wrangler/**",
    "**/.vercel/**",
    "**/coverage/**",
    "**/playwright-report/**",
    "**/test-results/**"
  ],
  "duplicates": {
    "ignoreDefaults": false,
    "ignoreImports": true
  },
  "health": {
    "maxCyclomatic": 10,
    "maxCognitive": 15,
    "maxCrap": 0,
    "suggestInlineSuppression": false
  }
}
