const sortStrings = (values: readonly string[]): readonly string[] => {
  const sorted: string[] = [];
  for (const value of values) {
    let insertionIndex = 0;
    while (insertionIndex < sorted.length && (sorted[insertionIndex]?.localeCompare(value) ?? 0) <= 0) {
      insertionIndex += 1;
    }
    sorted.splice(insertionIndex, 0, value);
  }
  return sorted;
};

const isGeneratedInfrastructureReadinessApi = (file: string, source: string): boolean => {
  const stem = /(?<stem>[^/]+)\/[^/]+\/[^/]+$/u.exec(file)?.groups?.stem;
  if (stem === undefined) {
    return false;
  }
  const endpoints = [
    ...source.matchAll(/HttpApiEndpoint\.(?<method>get|post)\(\s*'(?<name>[^']+)'\s*,\s*'(?<path>[^']+)'/gu),
  ].map((match) => {
    const { groups } = match;
    return `${groups?.method}:${groups?.name}:${groups?.path}`;
  });
  return (
    endpoints.length === 1 &&
    endpoints[0] === `get:readiness:/${stem}/readiness` &&
    source.includes(`export const ${stem}ApiContract = {`)
  );
};

const SKIPPED_DIRECTORIES = new Set(['.output', 'node_modules']);

const walk = (directory: string): Effect.Effect<readonly string[], PlatformError, FileSystem.FileSystem | Path.Path> =>
  Effect.gen(function* walkEffect() {
    const fileSystem = yield* FileSystem.FileSystem;
    const path = yield* Path.Path;
    if (!(yield* fileSystem.exists(directory))) {
      return [];
    }
    const entries = yield* fileSystem.readDirectory(directory);
    const discovered: (readonly string[])[] = [];
    for (const entry of entries) {
      if (SKIPPED_DIRECTORIES.has(entry) || entry.startsWith('dist')) {
        discovered.push([]);
      } else {
        const entryPath = path.join(directory, entry);
        const info = yield* fileSystem.stat(entryPath);
        discovered.push(info.type === 'Directory' ? yield* walk(entryPath) : [entryPath]);
      }
    }
    return sortStrings(discovered.flat());
  });

const relative = (path: Path.Path, root: string, file: string): string =>
  path.relative(root, file).replaceAll('\\', '/');

class ModuleEntrypointBoundaryError extends Schema.TaggedError<ModuleEntrypointBoundaryError>()(
  'ModuleEntrypointBoundaryError',
  { message: Schema.String },
) {}

const fail = (file: string, message: string) =>
  Effect.fail(new ModuleEntrypointBoundaryError({ message: `${file}: ${message}` }));

const requireDefined = <Value,>(
  value: Value | undefined,
  file: string,
  message: string,
): Effect.Effect<Value, ModuleEntrypointBoundaryError> =>
  value === undefined ? fail(file, message) : Effect.succeed(value);

interface ParsedEntrypoint {
  readonly access?: string;
  readonly authorization?: InventoryAuthorization;
  readonly entrypointKey?: string;
  readonly moduleKey?: string;
  readonly role?: string;
  readonly scope: 'System' | 'Tenant';
}

interface SourceToken {
  readonly end: number;
  readonly kind: SyntaxKind;
  readonly start: number;
  readonly value: string;
}

interface ObjectProperties {
  readonly closeBraceIndex: number;
  readonly values: ReadonlyMap<string, string>;
}

const tokenKindAt = (tokens: readonly SourceToken[], index: number): SyntaxKind | undefined => tokens[index]?.kind;

const isPropertyValue = (tokens: readonly SourceToken[], index: number, valueKind: SyntaxKind): boolean =>
  tokenKindAt(tokens, index) === SyntaxKind.Identifier &&
  tokenKindAt(tokens, index + 1) === SyntaxKind.ColonToken &&
  tokenKindAt(tokens, index + 2) === valueKind;

const readObjectStringProperties = (tokens: readonly SourceToken[], openBraceIndex: number): ObjectProperties => {
  const values = new Map<string, string>();
  let depth = 0;
  for (let cursor = openBraceIndex; cursor < tokens.length; cursor += 1) {
    const current = tokens[cursor];
    if (current === undefined) {
      continue;
    }
    if (current.kind === SyntaxKind.OpenBraceToken) {
      depth += 1;
    } else if (current.kind === SyntaxKind.CloseBraceToken) {
      depth -= 1;
      if (depth === 0) {
        return { closeBraceIndex: cursor, values };
      }
    } else if (depth === 1 && isPropertyValue(tokens, cursor, SyntaxKind.StringLiteral)) {
      values.set(current.value, tokens[cursor + 2]?.value ?? '');
    }
  }
  return { closeBraceIndex: tokens.length, values };
};

const readIdentifierPropertyAt = (
  tokens: readonly SourceToken[],
  cursor: number,
  depth: number,
  property: string,
  exactValue: boolean,
): string | undefined => {
  const current = tokens[cursor];
  if (depth !== 1 || current?.kind !== SyntaxKind.Identifier || current.value !== property) {
    return undefined;
  }
  const separator = tokenKindAt(tokens, cursor + 1);
  if (separator === SyntaxKind.ColonToken) {
    const end = tokenKindAt(tokens, cursor + 3);
    return tokenKindAt(tokens, cursor + 2) === SyntaxKind.Identifier &&
      (!exactValue || end === SyntaxKind.CommaToken || end === SyntaxKind.CloseBraceToken)
      ? tokens[cursor + 2]?.value
      : undefined;
  }
  return separator === SyntaxKind.CommaToken || separator === SyntaxKind.CloseBraceToken ? property : undefined;
};

const readObjectIdentifierProperty = (
  tokens: readonly SourceToken[],
  openBraceIndex: number,
  property: string,
  exactValue = false,
): string | undefined => {
  let depth = 0;
  for (let cursor = openBraceIndex; cursor < tokens.length; cursor += 1) {
    const current = tokens[cursor];
    if (current === undefined) {
      continue;
    }
    if (current.kind === SyntaxKind.OpenBraceToken) {
      depth += 1;
    } else if (current.kind === SyntaxKind.CloseBraceToken) {
      depth -= 1;
      if (depth === 0) {
        return undefined;
      }
    } else {
      const value = readIdentifierPropertyAt(tokens, cursor, depth, property, exactValue);
      if (value !== undefined) {
        return value;
      }
    }
  }
  return undefined;
};

const resolveTopLevelStringConstant = (source: string, identifier: string): string | undefined => {
  const matches = [
    ...source.matchAll(
      new RegExp(`^const\\s+${identifier}\\s*=\\s*(['"])(?<value>[^'"]+)\\1(?:\\s+as\\s+const)?;\\s*$`, 'gmu'),
    ),
  ];
  return matches.length === 1 ? matches[0]?.groups?.value : undefined;
};

const readCapabilityIssuance = (properties: ReadonlyMap<string, string>): InventoryAuthorization | undefined => {
  const credential = properties.get('credential');
  return properties.size === 2 && (credential === 'api_key' || credential === 'session')
    ? { credential, kind: 'capability_issuance' }
    : undefined;
};

/**
 * The closed `authorization` classification (O62, CUTOVER-PLAN §4.2). `action_execution` and
 * `context_permission` are gone: a protected surface carries `{ kind: 'protected' }` and the
 * capability lives only in its access declaration or workload marker.
 */
const readAuthorization = (
  tokens: readonly SourceToken[],
  openBraceIndex: number,
): InventoryAuthorization | undefined => {
  const properties = readObjectStringProperties(tokens, openBraceIndex).values;
  return Match.value(properties.get('kind')).pipe(
    Match.when('public', (kind) => (properties.size === 1 ? { kind } : undefined)),
    Match.when('authenticated_principal', (kind) => (properties.size === 1 ? { kind } : undefined)),
    Match.when('owner_local_background', (kind) => (properties.size === 1 ? { kind } : undefined)),
    Match.when('protected', (kind) => (properties.size === 1 ? { kind } : undefined)),
    Match.when('capability_issuance', () => readCapabilityIssuance(properties)),
    Match.orElse(EffectFunction.constUndefined),
  );
};

const rescanTemplateClose = (scanner: ReturnType<typeof createScanner>, depths: number[]): SyntaxKind => {
  const index = depths.length - 1;
  const depth = depths[index] ?? 0;
  if (depth !== 0) {
    depths[index] = depth - 1;
    return SyntaxKind.CloseBraceToken;
  }
  const kind = scanner.reScanTemplateToken(false);
  if (kind === SyntaxKind.TemplateTail) {
    depths.pop();
  }
  return kind;
};

const updateTemplateToken = (
  scanner: ReturnType<typeof createScanner>,
  kind: SyntaxKind,
  depths: number[],
): SyntaxKind => {
  if (kind === SyntaxKind.TemplateHead) {
    depths.push(0);
  } else if (depths.length > 0) {
    const index = depths.length - 1;
    if (kind === SyntaxKind.OpenBraceToken) {
      depths[index] = (depths[index] ?? 0) + 1;
    } else if (kind === SyntaxKind.CloseBraceToken) {
      return rescanTemplateClose(scanner, depths);
    }
  }
  return kind;
};

const tokenize = (source: string): readonly SourceToken[] => {
  const scanner = createScanner(true, LanguageVariant.Standard, source);
  const tokens: SourceToken[] = [];
  const templateExpressionBraceDepths: number[] = [];
  let scannedKind = scanner.scan();
  while (scannedKind !== SyntaxKind.EndOfFile) {
    // The native scanner can return a zero-width PrivateIdentifier for a bare
    // `#` in a regular expression (for example /^#[0-9a-f]{6}$/u). Rescan it
    // as a hash token so that traversal advances instead of growing forever.
    if (scannedKind === SyntaxKind.PrivateIdentifier && scanner.getTokenStart() === scanner.getTokenEnd()) {
      scannedKind = scanner.reScanHashToken();
    }
    const kind = updateTemplateToken(scanner, scannedKind, templateExpressionBraceDepths);
    tokens.push({ end: scanner.getTokenEnd(), kind, start: scanner.getTokenStart(), value: scanner.getTokenValue() });
    scannedKind = scanner.scan();
  }
  return tokens;
};

const entrypointScope = (token: SourceToken): ParsedEntrypoint['scope'] | undefined => {
  if (token.kind !== SyntaxKind.Identifier) {
    return undefined;
  }
  return Match.value(token.value).pipe(
    Match.when('defineSystemModuleEntrypoint', () => 'System' as const),
    Match.when('defineTenantModuleEntrypoint', () => 'Tenant' as const),
    Match.orElse(EffectFunction.constUndefined),
  );
};

const readEntrypointAuthorization = (
  tokens: readonly SourceToken[],
  start: number,
  end: number,
): InventoryAuthorization | undefined => {
  let authorization: InventoryAuthorization | undefined;
  for (let cursor = start; cursor < end; cursor += 1) {
    if (tokens[cursor]?.value === 'authorization' && isPropertyValue(tokens, cursor, SyntaxKind.OpenBraceToken)) {
      authorization = readAuthorization(tokens, cursor + 2);
    }
  }
  return authorization;
};

const readEntrypoints = (
  source: string,
  resolveActionString?: (identifier: string) => string | undefined,
): readonly ParsedEntrypoint[] => {
  const tokens = tokenize(source);
  const resolveString =
    resolveActionString ?? ((identifier: string) => resolveTopLevelStringConstant(source, identifier));
  const entrypoints: ParsedEntrypoint[] = [];
  for (const [index, token] of tokens.entries()) {
    const scope = entrypointScope(token);
    if (
      scope !== undefined &&
      tokenKindAt(tokens, index + 1) === SyntaxKind.OpenParenToken &&
      tokenKindAt(tokens, index + 2) === SyntaxKind.OpenBraceToken
    ) {
      const properties = readObjectStringProperties(tokens, index + 2);
      const moduleKeyIdentifier = readObjectIdentifierProperty(
        tokens,
        index + 2,
        'moduleKey',
        resolveActionString !== undefined,
      );
      const entrypointKeyIdentifier = readObjectIdentifierProperty(
        tokens,
        index + 2,
        'entrypointKey',
        resolveActionString !== undefined,
      );
      entrypoints.push({
        access: properties.values.get('access'),
        authorization: readEntrypointAuthorization(tokens, index + 3, properties.closeBraceIndex),
        entrypointKey:
          properties.values.get('entrypointKey') ??
          (entrypointKeyIdentifier === undefined ? undefined : resolveString(entrypointKeyIdentifier)),
        moduleKey:
          properties.values.get('moduleKey') ??
          (moduleKeyIdentifier === undefined ? undefined : resolveString(moduleKeyIdentifier)),
        role: properties.values.get('role'),
        scope,
      });
    }
  }
  return entrypoints;
};

const readStringProperties = (source: string, propertyName: string): ReadonlySet<string> => {
  const tokens = tokenize(source);
  const values = new Set<string>();
  for (const [index, token] of tokens.entries()) {
    if (
      token.kind === SyntaxKind.Identifier &&
      token.value === propertyName &&
      tokens[index + 1]?.kind === SyntaxKind.ColonToken &&
      tokens[index + 2]?.kind === SyntaxKind.StringLiteral
    ) {
      const value = tokens[index + 2]?.value;
      if (value !== undefined) {
        values.add(value);
      }
    }
  }
  return values;
};

const callsIdentifier = (source: string, identifier: string): boolean => {
  const tokens = tokenize(source);
  return tokens.some(
    (token, index) =>
      token.kind === SyntaxKind.Identifier &&
      token.value === identifier &&
      tokens[index + 1]?.kind === SyntaxKind.OpenParenToken,
  );
};

const containsIdentifier = (source: string, identifiers: ReadonlySet<string>): boolean =>
  tokenize(source).some((token) => token.kind === SyntaxKind.Identifier && identifiers.has(token.value));

const isModuleSpecifierPosition = (tokens: readonly SourceToken[], index: number): boolean => {
  const previous = tokenKindAt(tokens, index - 1);
  return (
    previous === SyntaxKind.FromKeyword ||
    previous === SyntaxKind.ImportKeyword ||
    (previous === SyntaxKind.OpenParenToken &&
      (tokenKindAt(tokens, index - 2) === SyntaxKind.ImportKeyword ||
        tokenKindAt(tokens, index - 2) === SyntaxKind.RequireKeyword ||
        (tokenKindAt(tokens, index - 2) === SyntaxKind.Identifier && tokens[index - 2]?.value === 'require')))
  );
};

const readImportedModuleSpecifiers = (source: string): readonly string[] => {
  const tokens = tokenize(source);
  const specifiers: string[] = [];
  for (const [index, token] of tokens.entries()) {
    if (token.kind !== SyntaxKind.StringLiteral) {
      continue;
    }
    if (isModuleSpecifierPosition(tokens, index)) {
      specifiers.push(token.value);
    }
  }
  return specifiers;
};

const authorizationEquals = (left: InventoryAuthorization | undefined, right: InventoryAuthorization): boolean => {
  if (left?.kind !== right.kind) {
    return false;
  }
  return right.kind === 'capability_issuance' && left.kind === 'capability_issuance'
    ? left.credential === right.credential
    : true;
};

const sourceOrEmpty = (sourceMap: ReadonlyMap<string, string>, file: string): string => sourceMap.get(file) ?? '';

const isTopLevelActionToken = (structure: string, token: SourceToken): boolean =>
  structure.charAt(token.start).trim() !== '' &&
  topLevelSeparators(`${structure.slice(0, token.start)};`, ';').includes(token.start);

const actionClosingToken = (
  tokens: readonly SourceToken[],
  start: number,
  opening: SyntaxKind,
  closing: SyntaxKind,
): number | undefined => {
  let depth = 0;
  for (let index = start; index < tokens.length; index += 1) {
    if (tokens[index]?.kind === opening) {
      depth += 1;
    } else if (tokens[index]?.kind === closing) {
      depth -= 1;
      if (depth === 0) {
        return index;
      }
    }
  }
  return undefined;
};

const hasActionParameterBinding = (tokens: readonly SourceToken[], identifier: string): boolean => {
  const control = new Set([
    SyntaxKind.IfKeyword,
    SyntaxKind.ForKeyword,
    SyntaxKind.WhileKeyword,
    SyntaxKind.SwitchKeyword,
    SyntaxKind.WithKeyword,
  ]);
  return tokens.some((token, index) => {
    if (token.kind !== SyntaxKind.OpenParenToken || control.has(tokens[index - 1]?.kind ?? SyntaxKind.Unknown)) {
      return false;
    }
    const close = actionClosingToken(tokens, index, SyntaxKind.OpenParenToken, SyntaxKind.CloseParenToken);
    const next = close === undefined ? undefined : tokens[close + 1]?.kind;
    return (
      close !== undefined &&
      (next === SyntaxKind.EqualsGreaterThanToken ||
        next === SyntaxKind.OpenBraceToken ||
        next === SyntaxKind.ColonToken) &&
      tokens
        .slice(index + 1, close)
        .some((parameter) => parameter.kind === SyntaxKind.Identifier && parameter.value === identifier)
    );
  });
};

const hasActionDestructuredBinding = (tokens: readonly SourceToken[], identifier: string): boolean =>
  tokens.some((token, index) => {
    if (
      token.kind !== SyntaxKind.ConstKeyword &&
      token.kind !== SyntaxKind.LetKeyword &&
      token.kind !== SyntaxKind.VarKeyword
    ) {
      return false;
    }
    const opening = tokens[index + 1]?.kind;
    if (opening !== SyntaxKind.OpenBraceToken && opening !== SyntaxKind.OpenBracketToken) {
      return false;
    }
    const close = actionClosingToken(
      tokens,
      index + 1,
      opening,
      opening === SyntaxKind.OpenBraceToken ? SyntaxKind.CloseBraceToken : SyntaxKind.CloseBracketToken,
    );
    return (
      close !== undefined &&
      tokens
        .slice(index + 2, close)
        .some((binding) => binding.kind === SyntaxKind.Identifier && binding.value === identifier)
    );
  });

const hasActionConstantShadow = (source: string, identifier: string, allowedStart?: number): boolean => {
  const structure = maskNonCode(source);
  const tokens = tokenize(source).filter((token) => structure.charAt(token.start).trim() !== '');
  const declarations = new Set([
    SyntaxKind.ClassKeyword,
    SyntaxKind.ConstKeyword,
    SyntaxKind.EnumKeyword,
    SyntaxKind.FunctionKeyword,
    SyntaxKind.InterfaceKeyword,
    SyntaxKind.LetKeyword,
    SyntaxKind.NamespaceKeyword,
    SyntaxKind.TypeKeyword,
    SyntaxKind.VarKeyword,
  ]);
  return (
    tokens.some(
      (token, index) =>
        token.kind === SyntaxKind.Identifier &&
        token.value === identifier &&
        token.start !== allowedStart &&
        (declarations.has(tokens[index - 1]?.kind ?? SyntaxKind.Unknown) ||
          tokens[index + 1]?.kind === SyntaxKind.EqualsToken ||
          tokens[index + 1]?.kind === SyntaxKind.EqualsGreaterThanToken),
    ) ||
    hasActionParameterBinding(tokens, identifier) ||
    hasActionDestructuredBinding(tokens, identifier)
  );
};

interface StaticActionImport {
  readonly imported: string;
  readonly modulePath: string;
  readonly typeOnly: boolean;
}

const readActionConstantImports = (source: string, identifier: string): readonly (StaticActionImport | undefined)[] => {
  const tokens = tokenize(source);
  const structure = maskNonCode(source);
  const commented = maskNonCode(source, true);
  return tokens.flatMap((token, index): readonly (StaticActionImport | undefined)[] => {
    if (token.kind !== SyntaxKind.ImportKeyword || !isTopLevelActionToken(structure, token)) {
      return [];
    }
    const end = tokens.findIndex(
      (candidate, position) => position > index && candidate.kind === SyntaxKind.SemicolonToken,
    );
    const declaration = end === -1 ? [] : tokens.slice(index, end + 1);
    const from = declaration.findIndex((candidate) => candidate.kind === SyntaxKind.FromKeyword);
    if (
      !declaration
        .slice(0, from === -1 ? declaration.length : from)
        .some((candidate) => candidate.kind === SyntaxKind.Identifier && candidate.value === identifier)
    ) {
      return [];
    }
    const statement =
      /^import\s+(?:(?<typeOnly>type)\s+)?\{(?<members>[^}]*)\}\s+from\s*(?<quote>['"])(?<modulePath>[^'"]+)\k<quote>;$/u.exec(
        commented.slice(token.start, tokens[end]?.end).trim(),
      );
    const candidates = (statement?.groups?.members ?? '').split(',').flatMap((member) => {
      const binding =
        /^(?:(?<typeOnly>type)\s+)?(?<imported>[A-Za-z_$][A-Za-z0-9_$]*)(?:\s+as\s+(?<local>[A-Za-z_$][A-Za-z0-9_$]*))?$/u.exec(
          member.trim(),
        );
      const imported = binding?.groups?.imported;
      return imported !== undefined &&
        (binding?.groups?.local ?? imported) === identifier &&
        statement?.groups?.modulePath !== undefined
        ? [
            {
              imported,
              modulePath: statement.groups.modulePath,
              typeOnly: statement.groups.typeOnly !== undefined || binding?.groups?.typeOnly !== undefined,
            },
          ]
        : [];
    });
    return candidates.length === 1 ? candidates : [undefined];
  });
};

const isExportedActionLiteral = (tokens: readonly SourceToken[], index: number, identifier: string): boolean =>
  tokens[index]?.kind === SyntaxKind.ExportKeyword &&
  tokens[index + 1]?.kind === SyntaxKind.ConstKeyword &&
  tokens[index + 2]?.kind === SyntaxKind.Identifier &&
  tokens[index + 2]?.value === identifier &&
  tokens[index + 3]?.kind === SyntaxKind.EqualsToken &&
  tokens[index + 4]?.kind === SyntaxKind.StringLiteral;

const exportedActionStringConstant = (source: string, identifier: string): string | undefined => {
  const tokens = tokenize(source);
  const structure = maskNonCode(source);
  const candidates = tokens.flatMap((token, index) => {
    if (!isExportedActionLiteral(tokens, index, identifier) || !isTopLevelActionToken(structure, token)) {
      return [];
    }
    const end =
      tokens[index + 5]?.kind === SyntaxKind.AsKeyword && tokens[index + 6]?.kind === SyntaxKind.ConstKeyword
        ? index + 7
        : index + 5;
    const name = tokens[index + 2];
    return tokens[end]?.kind === SyntaxKind.SemicolonToken &&
      name !== undefined &&
      !hasActionConstantShadow(source, identifier, name.start)
      ? [tokens[index + 4]?.value]
      : [];
  });
  return candidates.length === 1 ? candidates[0] : undefined;
};

const resolveActionEntrypointString = (
  sourceMap: ReadonlyMap<string, string>,
  file: string,
  source: string,
  identifier: string,
): string | undefined => {
  const imports = readActionConstantImports(source, identifier);
  if (imports.length === 0) {
    return resolveTopLevelStringConstant(source, identifier);
  }
  const imported = imports.length === 1 ? imports[0] : undefined;
  const owner = /^(?:apps|verticals|packages)\/[^/]+\//u.exec(file)?.[0];
  if (
    imported === undefined ||
    imported.typeOnly ||
    owner === undefined ||
    hasActionConstantShadow(source, identifier) ||
    !/^\.\.?\//u.test(imported.modulePath) ||
    !imported.modulePath.endsWith('.ts')
  ) {
    return undefined;
  }
  const target = nodePath.posix.normalize(nodePath.posix.join(nodePath.posix.dirname(file), imported.modulePath));
  const targetSource = target.startsWith(owner) ? sourceMap.get(target) : undefined;
  return targetSource === undefined ? undefined : exportedActionStringConstant(targetSource, imported.imported);
};

const readActionEntrypoints = (
  sourceMap: ReadonlyMap<string, string>,
  file: string,
  source: string,
): readonly ParsedEntrypoint[] => {
  const inline = readEntrypoints(source, (identifier) =>
    resolveActionEntrypointString(sourceMap, file, source, identifier),
  );
  const action =
    /^verticals\/party-registry\/src\/actions\/(?<action>(?:archive|unarchive)-(?:organization|person)-engagement)\.action\.ts$/u.exec(
      file,
    )?.groups?.action;
  if (action === undefined && !containsIdentifier(source, new Set(['engagementLifecycleRegistration']))) {
    return inline;
  }
  if (
    action === undefined ||
    inline.length !== 0 ||
    !hasEngagementLifecycleRegistrationContract(
      source,
      sourceOrEmpty(sourceMap, 'verticals/party-registry/src/actions/engagement-lifecycle-registration.ts'),
      action,
    )
  ) {
    return [];
  }
  return [
    {
      access: 'write',
      authorization: {
        kind: 'protected',
      },
      entrypointKey: `party.registry.${action}`,
      moduleKey: 'party.registry',
      role: 'action',
      scope: 'Tenant',
    },
  ];
};

const requireExactEntrypoint = (
  file: string,
  source: string,
  expected: Required<ParsedEntrypoint>,
  remediation: string,
  entrypoints = readEntrypoints(source),
): Effect.Effect<ParsedEntrypoint, ModuleEntrypointBoundaryError> =>
  Effect.gen(function* requireExactEntrypointEffect() {
    const entrypoint = yield* requireDefined(entrypoints[0], file, remediation);
    if (
      entrypoints.length !== 1 ||
      entrypoint.scope !== expected.scope ||
      !authorizationEquals(entrypoint.authorization, expected.authorization) ||
      entrypoint.access !== expected.access ||
      entrypoint.entrypointKey !== expected.entrypointKey ||
      entrypoint.moduleKey !== expected.moduleKey ||
      entrypoint.role !== expected.role
    ) {
      yield* fail(file, remediation);
    }
    return entrypoint;
  });

const requireGeneratedActionEntrypoint = (sourceMap: ReadonlyMap<string, string>, file: string, source: string) =>
  Effect.gen(function* requireGeneratedActionEntrypointEffect() {
    if (!hasGeneratedSourceHeader(source, `${ACTION_HEADER}\n`)) {
      yield* fail(file, 'Actions must be created and maintained with scaffold:action');
    }
    const owner = /^\/\/ @ontos-action-owner (?<owner>.+)$/mu.exec(source)?.groups?.owner;
    const action = /^\/\/ @ontos-action-slug (?<action>.+)$/mu.exec(source)?.groups?.action;
    const descriptorMessage =
      'regenerate this Action with scaffold:action so it has its governed action/write entrypoint';
    const definedOwner = yield* requireDefined(owner, file, descriptorMessage);
    const definedAction = yield* requireDefined(action, file, descriptorMessage);
    const entrypoints = readActionEntrypoints(sourceMap, file, source);
    const rawAuthorization = entrypoints[0]?.authorization;
    const authorization = yield* rawAuthorization?.kind === 'protected'
      ? Effect.succeed(rawAuthorization)
      : fail(file, 'regenerate this Action with scaffold:action so it declares a protected authorization');
    yield* requireExactEntrypoint(
      file,
      source,
      {
        access: 'write',
        authorization,
        entrypointKey: `${definedOwner}.${definedAction}`,
        moduleKey: definedOwner,
        role: 'action',
        scope: definedOwner.startsWith('core.') ? 'System' : 'Tenant',
      },
      descriptorMessage,
      entrypoints,
    );
  });

const requireGeneratedWorkerEntrypoint = (file: string, source: string) =>
  Effect.gen(function* requireGeneratedWorkerEntrypointEffect() {
    if (!hasGeneratedSourceHeader(source, `${WORKER_HEADER}\n`)) {
      yield* fail(file, 'Outbox Workers must be created and maintained with scaffold:outbox-worker');
    }
    const owner = /^\/\/ @ontos-outbox-worker-owner (?<owner>.+)$/mu.exec(source)?.groups?.owner;
    const workerKey = /^\/\/ @ontos-outbox-worker-key (?<workerKey>.+)$/mu.exec(source)?.groups?.workerKey;
    const descriptorMessage =
      'regenerate this Worker with scaffold:outbox-worker so it has its governed worker/background entrypoint';
    const definedOwner = yield* requireDefined(owner, file, descriptorMessage);
    const definedWorkerKey = yield* requireDefined(workerKey, file, descriptorMessage);
    yield* requireExactEntrypoint(
      file,
      source,
      {
        access: 'background',
        authorization: { kind: 'owner_local_background' },
        entrypointKey: definedWorkerKey,
        moduleKey: definedOwner,
        role: 'worker',
        scope: 'Tenant',
      },
      descriptorMessage,
    );
  });

const requireRouteEntrypoint = (
  file: string,
  source: string,
  moduleOwner: string,
  expectedScope: 'system' | 'tenant',
): Effect.Effect<string, ModuleEntrypointBoundaryError> =>
  Effect.gen(function* requireRouteEntrypointEffect() {
    const entrypoints = readEntrypoints(source);
    const remediation =
      'regenerate this route with scaffold:microvertical-page and load it through the Shell module-entrypoint gateway';
    const entrypoint = yield* requireDefined(entrypoints[0], file, remediation);
    const requiredScope = expectedScope === 'system' ? 'System' : 'Tenant';
    if (
      entrypoints.length !== 1 ||
      entrypoint.scope !== requiredScope ||
      entrypoint.role !== 'page' ||
      entrypoint.moduleKey !== moduleOwner ||
      entrypoint.authorization === undefined ||
      entrypoint.entrypointKey?.startsWith(`${moduleOwner}.page.`) !== true ||
      (entrypoint.access !== 'read' && entrypoint.access !== 'historical_read')
    ) {
      yield* fail(file, remediation);
    }
    return yield* requireDefined(entrypoint.entrypointKey, file, remediation);
  });

const TopologyMetadataSchema = Schema.Struct({
  shell: Schema.Struct({ id: Schema.String, path: Schema.String }),
  verticals: Schema.Array(Schema.Struct({ id: Schema.String, path: Schema.String })),
});
const decodeTopologyMetadata = Schema.decodeUnknownEffect(Schema.fromJsonString(TopologyMetadataSchema));

const VerticalPackageJsonSchema = Schema.Struct({
  exports: Schema.optionalKey(Schema.Record(Schema.String, Schema.String)),
});
const decodeVerticalPackageJson = Schema.decodeUnknownEffect(Schema.fromJsonString(VerticalPackageJsonSchema));

const OwnershipPackageSchema = Schema.Struct({
  dependencies: Schema.optionalKey(Schema.Record(Schema.String, Schema.String)),
  exports: Schema.optionalKey(Schema.Record(Schema.String, Schema.Unknown)),
  modernjs: Schema.optionalKey(
    Schema.Struct({
      apiRuntime: Schema.optionalKey(Schema.String),
      appId: Schema.optionalKey(PublicContractOwnerAppIdSchema),
      ontosModule: Schema.optionalKey(
        Schema.Struct({
          manifest: Schema.optionalKey(Schema.String),
          moduleId: Schema.optionalKey(PublicContractOwnerModuleIdSchema),
        }),
      ),
    }),
  ),
  name: Schema.optionalKey(Schema.String),
});
interface OwnershipPackage {
  readonly directory: string;
  readonly metadata: typeof OwnershipPackageSchema.Type;
}
const decodeOwnershipPackage = Schema.decodeUnknownEffect(Schema.fromJsonString(OwnershipPackageSchema));
const OwnershipReferencesSchema = Schema.Struct({
  references: Schema.optionalKey(Schema.Array(Schema.Struct({ path: Schema.String }))),
});
const decodeOwnershipReferences = Schema.decodeUnknownResult(Schema.fromJsonString(OwnershipReferencesSchema));

const readTopologyOwners = (root: string) =>
  Effect.gen(function* readTopologyOwnersEffect() {
    const fileSystem = yield* FileSystem.FileSystem;
    const path = yield* Path.Path;
    const metadata = yield* fileSystem
      .readFileString(path.join(root, 'topology/reference-topology.json'), 'utf-8')
      .pipe(Effect.flatMap(decodeTopologyMetadata));
    return new Map([
      [metadata.shell.path.replaceAll('\\', '/'), metadata.shell.id],
      ...metadata.verticals.map((app) => [app.path.replaceAll('\\', '/'), app.id] as const),
    ]);
  });

const readSourceRevision = (root: string) =>
  Effect.gen(function* readSourceRevisionEffect() {
    const configured = yield* Config.option(Config.String('ULTRAMODERN_SOURCE_REVISION'));
    if (Option.isSome(configured)) {
      return configured.value;
    }
    const spawner = yield* ChildProcessSpawner.ChildProcessSpawner;
    return yield* spawner.string(ChildProcess.make('git', ['rev-parse', 'HEAD'], { cwd: root })).pipe(
      Effect.map((revision) => {
        const trimmed = revision.trim();
        return trimmed.length === 0 ? 'working-tree' : trimmed;
      }),
      Effect.catch(() => Effect.succeed('working-tree')),
    );
  });

interface RouteEntrypointRecord {
  readonly deployment: string;
  readonly entrypointKey: string;
  readonly file: string;
}

interface CompleteModuleApiSeam {
  readonly diagnostics: readonly string[];
  readonly valid: boolean;
}

interface BoundaryCheckState {
  readonly businessPermissionEntries: BusinessPermissionInventoryEntry[];
  readonly canonicalPaths: ReadonlyMap<string, string>;
  readonly completeModuleApiSeams: Map<string, Map<string | undefined, CompleteModuleApiSeam>>;
  readonly graph: ReturnType<typeof createModuleGraph>;
  readonly inventoryEntries: ProtectedEntrypointInventoryEntry[];
  readonly owners: ReadonlyMap<string, string>;
  readonly ownershipPackages: ReadonlyMap<string, OwnershipPackage>;
  readonly root: string;
  readonly routeEntrypoints: RouteEntrypointRecord[];
  readonly sourceMap: ReadonlyMap<string, string>;
}

const hasCachedCompleteModuleApiSeam = (
  state: BoundaryCheckState,
  file: string,
  appId: string | undefined,
  diagnostics?: string[],
): boolean => {
  let ownerSeams = state.completeModuleApiSeams.get(file);
  if (ownerSeams === undefined) {
    ownerSeams = new Map();
    state.completeModuleApiSeams.set(file, ownerSeams);
  }
  let result = ownerSeams.get(appId);
  if (result === undefined) {
    const messages: string[] = [];
    result = {
      diagnostics: messages,
      valid: hasCompleteGeneratedModuleApiSeam(state.sourceMap, file, appId, messages),
    };
    ownerSeams.set(appId, result);
  }
  diagnostics?.push(...result.diagnostics);
  return result.valid;
};

const deploymentOwner = (state: BoundaryCheckState, file: string): string | undefined =>
  [...state.owners.keys()].find((owner) => file.startsWith(`${owner}/`));

// This adapter only locates literal declaration edges in the inventory. Value binding
// provenance, including modern:source and real workspace symlinks, stays with the native graph.
const ownershipDeclarationTarget = (
  state: BoundaryCheckState,
  importer: string,
  specifier: string,
): string | undefined => {
  let target: string | undefined;
  if (specifier.startsWith('.')) {
    target = nodePath.posix.normalize(nodePath.posix.join(nodePath.posix.dirname(importer), specifier));
  } else {
    for (const { directory, metadata } of state.ownershipPackages.values()) {
      if (metadata.name === undefined || (specifier !== metadata.name && !specifier.startsWith(`${metadata.name}/`))) {
        continue;
      }
      const key = specifier === metadata.name ? '.' : `.${specifier.slice(metadata.name.length)}`;
      const exported = metadata.exports?.[key];
      if (Schema.is(Schema.String)(exported) && exported.startsWith('./')) {
        const candidate = nodePath.posix.normalize(nodePath.posix.join(directory, exported));
        if (candidate.startsWith(`${directory}/`)) {
          target = candidate;
        }
      }
    }
  }
  if (target === undefined) {
    return undefined;
  }
  for (const candidate of [target, `${target}.ts`, `${target}.tsx`, `${target}.mts`, `${target}/index.ts`]) {
    const canonical = state.canonicalPaths.get(candidate);
    if (canonical !== undefined) {
      return canonical;
    }
  }
  return undefined;
};

const nativeOwnershipOrigins = (state: BoundaryCheckState, file: string): ReadonlyMap<string, readonly string[]> => {
  const origins = new Map<string, readonly string[]>();
  const module = state.graph.module(nodePath.join(state.root, file));
  for (const statement of module.file.program.body) {
    if (statement.type !== 'ImportDeclaration') {
      continue;
    }
    const paths: string[] = [];
    for (const specifier of statement.specifiers) {
      const binding = state.graph.resolve(module, specifier.local.name, 'local');
      if (binding !== undefined) {
        for (const hop of binding.chain.slice(1)) {
          paths.push(nodePath.relative(state.root, hop.path).replaceAll('\\', '/'));
        }
      }
    }
    origins.set(statement.source.value, paths);
  }
  return origins;
};

const privateImplementationPath =
  /(?:vertical\.(?:registration|manifest|runtime-declaration)\.[cm]?ts$|(?:^|\/)src\/(?:handlers|workers|db|database|repositories?)\/|(?:^|\/)workers\/)/u;
const EFFECT_HTTP_API_PROVIDER = 'effect/http-api';
const nativeContractProviders = new Set([
  'effect',
  EFFECT_SCHEMA_PROVIDER,
  'effect/SchemaGetter',
  EFFECT_CLIENT_PROVIDER,
  EFFECT_HTTP_API_PROVIDER,
]);

const nativeContractLeaf = (value: GraphValue): boolean =>
  value.kind === 'external' &&
  nativeContractProviders.has(value.specifier) &&
  (value.specifier === EFFECT_SCHEMA_PROVIDER ||
    value.specifier === 'effect/SchemaGetter' ||
    ['Schema', 'SchemaGetter', 'HttpApi', 'HttpApiEndpoint', 'HttpApiGroup'].includes(value.name) ||
    ((value.specifier === EFFECT_CLIENT_PROVIDER || value.specifier === EFFECT_HTTP_API_PROVIDER) &&
      value.name === 'HttpApiMiddleware' &&
      value.members.length === 1 &&
      value.members[0] === 'Service'));

// Opaque mutations in dormant local algorithms may taint native namespace
// evaluation. Retain the actual immutable import binding and external identity;
// eager writes are checked separately by hasImmutableContractRuntime.
const isCanonicalContractImport = (state: BoundaryCheckState, value: GraphValue): boolean => {
  if (value.kind !== 'unresolved' || value.node.type !== 'Identifier') {
    return false;
  }
  const { module, node } = value;
  return module.file.program.body.some(
    (statement) =>
      statement.type === 'ImportDeclaration' &&
      statement.importKind !== 'type' &&
      statement.specifiers.some(
        (specifier) =>
          specifier.type === 'ImportSpecifier' &&
          specifier.importKind !== 'type' &&
          specifier.local.name === node.name &&
          state.graph
            .evaluate(module, node)
            .some(
              (candidate) =>
                nativeContractLeaf(candidate) &&
                candidate.kind === 'external' &&
                (candidate.name === 'Schema' || candidate.specifier === EFFECT_SCHEMA_PROVIDER),
            ) &&
          state.graph
            .evaluate(module, specifier.local)
            .some(
              (candidate) =>
                nativeContractLeaf(candidate) &&
                candidate.kind === 'external' &&
                (candidate.name === 'Schema' || candidate.specifier === EFFECT_SCHEMA_PROVIDER) &&
                candidate.specifier === statement.source.value &&
                candidate.name ===
                  (specifier.imported.type === 'Identifier' ? specifier.imported.name : specifier.imported.value),
            ),
      ),
  );
};

// The native graph deliberately represents results of opaque Schema/HttpApi
// constructors as unresolved calls. Prove their actual callees, not their names.
const hasOnlyNativeContractLeaves = (
  state: BoundaryCheckState,
  module: SourceModule,
  expression: SchemaNode,
  visited = new Set<SchemaNode>(),
  completed = new WeakMap<SourceModule, WeakMap<SchemaNode, Map<number, boolean>>>(),
): boolean => {
  if (visited.has(expression) || visited.size >= 128) {
    return false;
  }
  let moduleProofs = completed.get(module);
  if (moduleProofs === undefined) {
    moduleProofs = new WeakMap();
    completed.set(module, moduleProofs);
  }
  let nodeProofs = moduleProofs.get(expression);
  if (nodeProofs === undefined) {
    nodeProofs = new Map();
    moduleProofs.set(expression, nodeProofs);
  }
  const remainingDepth = 128 - visited.size;
  const cached = nodeProofs.get(remainingDepth);
  if (cached !== undefined) {
    return cached;
  }
  visited.add(expression);
  // A generated aggregate can have many sibling APIs. Prove its fluent receiver spine
  // iteratively so sibling count does not consume the descriptor recursion budget.
  let fluentReceiver = expression;
  let fluentLinks = 0;
  const fluentNodes = new Set<SchemaNode>();
  while (fluentLinks < 256) {
    if (fluentNodes.has(fluentReceiver)) {
      return false;
    }
    fluentNodes.add(fluentReceiver);
    const member = fluentReceiver.type === 'CallExpression' ? fluentReceiver.callee : fluentReceiver;
    if (
      member.type !== 'MemberExpression' ||
      member.computed ||
      member.property.type !== 'Identifier' ||
      !['addHttpApi', 'annotate'].includes(member.property.name)
    ) {
      break;
    }
    fluentReceiver = member.object;
    fluentLinks += 1;
  }
  if (fluentLinks === 256) {
    return false;
  }
  const fluentRoot =
    fluentLinks > 0 && fluentReceiver.type === 'CallExpression'
      ? state.graph.evaluate(module, fluentReceiver.callee)
      : [];
  const nativeApiSpine =
    fluentRoot.length > 0 &&
    fluentRoot.every(
      (value) =>
        value.kind === 'external' &&
        (value.specifier === EFFECT_CLIENT_PROVIDER || value.specifier === EFFECT_HTTP_API_PROVIDER) &&
        value.name === 'HttpApi' &&
        value.members.length === 1 &&
        value.members[0] === 'make',
    );
  const result =
    nativeApiSpine ||
    state.graph.evaluate(module, expression).every((value) => {
      if (nativeContractLeaf(value) || isCanonicalContractImport(state, value) || isProblemDetailsFactory(value)) {
        return true;
      }
      if (value.kind !== 'unresolved' && value.kind !== 'node') {
        return false;
      }
      const { node } = value;
      if (node.type === 'Identifier' && node.name === 'Number' && state.graph.isUnboundReference(value.module, node)) {
        let immutableBound = false;
        traverseFast(value.module.file, (candidate) => {
          if (
            candidate.type === 'MemberExpression' &&
            candidate.object === node &&
            !candidate.computed &&
            candidate.property.type === 'Identifier' &&
            candidate.property.name === 'MAX_SAFE_INTEGER'
          ) {
            immutableBound = true;
          }
        });
        return immutableBound;
      }
      if (node.type !== 'CallExpression' && node.type !== 'MemberExpression') {
        return false;
      }
      const receiver = node.type === 'CallExpression' ? node.callee : node.object;
      const values = state.graph.evaluate(value.module, receiver);
      return (
        values.length > 0 && hasOnlyNativeContractLeaves(state, value.module, receiver, new Set(visited), completed)
      );
    });
  nodeProofs.set(remainingDepth, result);
  return result;
};

const contractReexportCandidates = (state: BoundaryCheckState, module: SourceModule, name: string) =>
  module.file.program.body.flatMap((statement) => {
    if (
      (statement.type !== 'ExportNamedDeclaration' && statement.type !== 'ExportAllDeclaration') ||
      statement.source === null ||
      statement.source === undefined
    ) {
      return [];
    }
    const target = ownershipDeclarationTarget(
      state,
      nodePath.relative(state.root, module.path).replaceAll('\\', '/'),
      statement.source.value,
    );
    if (target === undefined) {
      return [];
    }
    const names =
      statement.type === 'ExportAllDeclaration'
        ? [name]
        : statement.specifiers.flatMap((specifier) =>
            specifier.type === 'ExportSpecifier' &&
            (specifier.exported.type === 'Identifier' ? specifier.exported.name : specifier.exported.value) === name
              ? [specifier.local.type === 'Identifier' ? specifier.local.name : specifier.local.value]
              : [],
          );
    return names.map((exportedName) => ({ exportedName, target }));
  });

const resolveContractReexports = (
  state: BoundaryCheckState,
  module: SourceModule,
  name: string,
  visited: Set<string>,
  resolve: (
    module: SourceModule,
    name: string,
    visited: Set<string>,
  ) => ReturnType<BoundaryCheckState['graph']['resolve']>,
): ReturnType<BoundaryCheckState['graph']['resolve']> => {
  let resolved: ReturnType<BoundaryCheckState['graph']['resolve']>;
  for (const { exportedName, target } of contractReexportCandidates(state, module, name)) {
    const candidate = resolve(state.graph.module(nodePath.join(state.root, target)), exportedName, new Set(visited));
    if (candidate === undefined) {
      continue;
    }
    if (
      resolved !== undefined &&
      (resolved.kind !== 'declaration' ||
        candidate.kind !== 'declaration' ||
        resolved.module.path !== candidate.module.path ||
        resolved.expression !== candidate.expression)
    ) {
      return undefined;
    }
    resolved = candidate;
  }
  return resolved;
};

const resolveContractExport = (
  state: BoundaryCheckState,
  module: SourceModule,
  name: string,
  typeOnly: boolean,
  visited = new Set<string>(),
): ReturnType<BoundaryCheckState['graph']['resolve']> => {
  const key = `${module.path}:${name}`;
  if (visited.has(key) || visited.size >= 128) {
    return undefined;
  }
  visited.add(key);
  const binding = state.graph.resolve(module, name, 'export');
  if (binding !== undefined || !typeOnly) {
    return binding;
  }
  for (const statement of module.file.program.body) {
    if (
      statement.type !== 'ExportNamedDeclaration' ||
      statement.declaration?.type !== 'TSTypeAliasDeclaration' ||
      statement.declaration.id.name !== name
    ) {
      continue;
    }
    const type = statement.declaration.typeAnnotation;
    if (
      type.type === 'TSTypeQuery' &&
      type.exprName.type === 'TSQualifiedName' &&
      type.exprName.right.name === 'Type' &&
      type.exprName.left.type === 'Identifier'
    ) {
      return state.graph.resolve(module, type.exprName.left.name, 'local');
    }
  }
  return resolveContractReexports(state, module, name, visited, (child, exportedName, seen) =>
    resolveContractExport(state, child, exportedName, true, seen),
  );
};

const ownConstContractDeclaration = (module: SourceModule, name: string): SelectedContractDeclaration | undefined => {
  for (const statement of module.file.program.body) {
    const declaration = statement.type === 'ExportNamedDeclaration' ? statement.declaration : statement;
    if (declaration?.type !== 'VariableDeclaration' || declaration.kind !== 'const') {
      continue;
    }
    for (const binding of declaration.declarations) {
      if (
        binding.id.type === 'Identifier' &&
        binding.id.name === name &&
        binding.init !== null &&
        binding.init !== undefined
      ) {
        return { expression: binding.init, module };
      }
    }
  }
  return undefined;
};

const resolveSchemaCallReceiver = (state: BoundaryCheckState, source: SourceModule, receiver: SchemaNode) => {
  const native = receiver.type === 'Identifier' ? state.graph.resolve(source, receiver.name, 'local') : undefined;
  let binding: SelectedContractDeclaration | undefined;
  if (native?.kind === 'declaration') {
    binding = native;
  } else if (receiver.type === 'Identifier') {
    binding = ownConstContractDeclaration(source, receiver.name);
  }
  return binding !== undefined &&
    binding.expression.type === 'CallExpression' &&
    !privateImplementationPath.test(nodePath.relative(state.root, binding.module.path))
    ? binding
    : undefined;
};

const literalContractPropertyKey = (node: SchemaNode): string | undefined => {
  if (node.type === 'Identifier') {
    return node.name;
  }
  return node.type === 'StringLiteral' ? node.value : undefined;
};

interface LiteralContractData {
  readonly value: unknown;
}
const literalContractRecord = (
  node: SchemaNode,
  depth: number,
  decode: (node: SchemaNode, depth: number) => LiteralContractData | undefined,
): LiteralContractData | undefined => {
  if (node.type !== 'ObjectExpression' || node.properties.length > 32) {
    return undefined;
  }
  const entries: (readonly [string, unknown])[] = [];
  for (const property of node.properties) {
    if (property.type !== 'ObjectProperty' || property.computed || property.shorthand) {
      return undefined;
    }
    const key = literalContractPropertyKey(property.key);
    const value = decode(property.value, depth + 1);
    if (key === undefined || value === undefined || entries.some(([previous]) => previous === key)) {
      return undefined;
    }
    entries.push([key, value.value]);
  }
  return { value: Object.fromEntries(entries) };
};

/** Decode data only: no spreads, accessors, references, computed keys or executable initializers. */
const literalContractData = (node: SchemaNode, depth = 0): { readonly value: unknown } | undefined => {
  if (depth >= 16) {
    return undefined;
  }
  if (node.type === 'TSAsExpression' || node.type === 'TSSatisfiesExpression') {
    return literalContractData(node.expression, depth + 1);
  }
  if (node.type === 'StringLiteral' || node.type === 'BooleanLiteral' || node.type === 'NumericLiteral') {
    return { value: node.value };
  }
  if (node.type === 'NullLiteral') {
    return { value: null };
  }
  if (node.type === 'ArrayExpression' && node.elements.length <= 64) {
    const elements = node.elements.map((element) =>
      element === null ? undefined : literalContractData(element, depth + 1),
    );
    return elements.every((element) => element !== undefined)
      ? { value: elements.map((element) => element.value) }
      : undefined;
  }
  return literalContractRecord(node, depth, literalContractData);
};

const hasLiteralSchemaAnnotation = (node: SchemaNode): boolean => {
  if (node.type !== 'CallExpression' || node.arguments.length !== 1) {
    return false;
  }
  const [annotation] = node.arguments;
  return annotation?.type === 'ObjectExpression' && literalContractData(annotation) !== undefined;
};

const isSchemaAnnotationMethod = (node: SchemaNode): boolean =>
  node.type === 'CallExpression' &&
  node.callee.type === 'MemberExpression' &&
  (node.callee.computed
    ? node.callee.property.type === 'StringLiteral' && node.callee.property.value === 'annotate'
    : node.callee.property.type === 'Identifier' && node.callee.property.name === 'annotate');

const isNativeSchemaAnnotationFunction = (value: GraphValue): boolean =>
  value.kind === 'external' &&
  ((value.specifier === 'effect' && value.name === 'Schema' && value.members.at(-1) === 'annotate') ||
    (value.specifier === EFFECT_SCHEMA_PROVIDER &&
      (value.members.at(-1) === 'annotate' || (value.name === 'annotate' && value.members.length === 0))));

const hasClosedSchemaAnnotations = (
  state: BoundaryCheckState,
  module: SourceModule,
  expression: SchemaNode,
): boolean => {
  let closed = true;
  traverseFast(expression, (node) => {
    if (
      node.type === 'CallExpression' &&
      (isSchemaAnnotationMethod(node) ||
        state.graph.evaluate(module, node.callee).some(isNativeSchemaAnnotationFunction)) &&
      !hasLiteralSchemaAnnotation(node)
    ) {
      closed = false;
    }
  });
  return closed;
};

const isNativeSchemaConstructor = (state: BoundaryCheckState, value: GraphValue): boolean =>
  (nativeContractLeaf(value) &&
    value.kind === 'external' &&
    (value.name === 'Schema' || value.specifier === EFFECT_SCHEMA_PROVIDER)) ||
  isCanonicalContractImport(state, value);

const localSchemaCallee = (state: BoundaryCheckState, source: SourceModule, node: SchemaNode) =>
  node.type === 'Identifier' ? state.graph.resolve(source, node.name, 'local') : undefined;

const publicSchemaFactoryBody = (
  state: BoundaryCheckState,
  binding: ReturnType<BoundaryCheckState['graph']['resolve']>,
) => {
  if (
    binding?.kind !== 'declaration' ||
    binding.expression.type !== 'ArrowFunctionExpression' ||
    binding.expression.body.type !== 'CallExpression' ||
    privateImplementationPath.test(nodePath.relative(state.root, binding.module.path))
  ) {
    return null;
  }
  return { expression: binding.expression.body, module: binding.module };
};

const hasCanonicalSchemaConstructor = (
  state: BoundaryCheckState,
  module: SourceModule,
  expression: SchemaNode,
): boolean => {
  if (expression.type !== 'CallExpression') {
    return false;
  }
  let schemaCall = expression;
  let source = module;
  for (let depth = 0; depth < 32; depth += 1) {
    if (!hasClosedSchemaAnnotations(state, source, schemaCall)) {
      return false;
    }
    const constructors = state.graph.evaluate(source, schemaCall.callee);
    const localFactory = localSchemaCallee(state, source, schemaCall.callee);
    if (
      localFactory?.kind !== 'declaration' &&
      constructors.length > 0 &&
      constructors.every((value) => isNativeSchemaConstructor(state, value))
    ) {
      return true;
    }
    const { callee } = schemaCall;
    if (callee.type === 'Identifier') {
      const binding = publicSchemaFactoryBody(state, state.graph.resolve(source, callee.name, 'local'));
      if (binding === null) {
        return false;
      }
      source = binding.module;
      schemaCall = binding.expression;
      continue;
    }
    if (
      callee.type !== 'MemberExpression' ||
      callee.computed ||
      callee.property.type !== 'Identifier' ||
      !['check', 'pipe', 'annotate'].includes(callee.property.name)
    ) {
      return false;
    }
    if (callee.object.type === 'CallExpression') {
      schemaCall = callee.object;
    } else {
      const binding = resolveSchemaCallReceiver(state, source, callee.object);
      if (binding === undefined || binding.expression.type !== 'CallExpression') {
        return false;
      }
      source = binding.module;
      schemaCall = binding.expression;
    }
  }
  return false;
};

type ImmutableContractCheck = (
  state: BoundaryCheckState,
  file: string,
  visited?: Set<string>,
  nativeApi?: boolean,
  selected?: SchemaNode,
) => boolean;

const isSelectedSchemaExport = (
  state: BoundaryCheckState,
  target: string,
  name: string,
  visited: Set<string>,
  nativeApi: boolean,
  checkSource: ImmutableContractCheck,
): boolean => {
  const module = state.graph.module(nodePath.join(state.root, target));
  const binding = resolveContractExport(state, module, name, true);
  if (binding?.kind !== 'declaration' || binding.expression.type !== 'CallExpression') {
    return false;
  }
  const constructors = state.graph.evaluate(binding.module, binding.expression.callee);
  const factory = constructors.some(isProblemDetailsFactory);
  return (
    (factory || (constructors.length > 0 && constructors.every(nativeContractLeaf))) &&
    checkSource(
      state,
      nodePath.relative(state.root, binding.module.path).replaceAll('\\', '/'),
      new Set(visited),
      nativeApi,
      binding.expression,
    )
  );
};

const hasAllowedUnboundContractReference = (
  state: BoundaryCheckState,
  module: SourceModule,
  node: SchemaNode,
  typeNodes: ReadonlySet<SchemaNode>,
): boolean => {
  if (node.type !== 'Identifier' || typeNodes.has(node) || !state.graph.isUnboundReference(module, node)) {
    return true;
  }
  if (node.name === 'undefined') {
    return true;
  }
  let immutableBound = false;
  if (node.name === 'Number') {
    traverseFast(module.file, (candidate) => {
      if (
        candidate.type === 'MemberExpression' &&
        candidate.object === node &&
        !candidate.computed &&
        candidate.property.type === 'Identifier' &&
        candidate.property.name === 'MAX_SAFE_INTEGER'
      ) {
        immutableBound = true;
      }
    });
  }
  return immutableBound;
};

const isApprovedApiMetadataCall = (
  node: SchemaNode,
  approvedApiRoot: SchemaNode | undefined,
  callees: readonly GraphValue[],
): boolean =>
  approvedApiRoot !== undefined &&
  (node === approvedApiRoot ||
    (callees.length > 0 &&
      callees.every(
        (value) =>
          value.kind === 'external' &&
          value.specifier === '@modern-js/bff-effect/microvertical-api' &&
          value.name === 'createMicroVerticalOperationContext' &&
          value.members.length === 0,
      )));

const dormantNativeEffectFactoryCalls = (state: BoundaryCheckState, module: SourceModule): ReadonlySet<SchemaNode> => {
  const calls = new Set<SchemaNode>();
  traverseFast(module.file, (node) => {
    if (
      node.type !== 'CallExpression' ||
      node.callee.type !== 'CallExpression' ||
      node.arguments.length !== 1 ||
      node.callee.arguments.length !== 1 ||
      node.callee.arguments[0]?.type !== 'StringLiteral' ||
      !isFunction(node.arguments[0])
    ) {
      return;
    }
    const constructors = state.graph.evaluate(module, node.callee.callee);
    if (
      constructors.length > 0 &&
      constructors.every(
        (value) =>
          value.kind === 'external' &&
          ((value.specifier === 'effect' && value.name === 'Effect') || value.specifier === 'effect/Effect') &&
          value.members.length === 1 &&
          value.members[0] === 'fn',
      )
    ) {
      calls.add(node);
      calls.add(node.callee);
    }
  });
  return calls;
};

interface NativeSchemaOrigin {
  readonly expression: SchemaNode;
  readonly id: SchemaNode;
  readonly module: SourceModule;
}

const ownSchemaOrigin = (module: SourceModule, node: SchemaNode): NativeSchemaOrigin | undefined => {
  for (const entry of module.file.program.body) {
    const declaration = entry.type === 'ExportNamedDeclaration' ? entry.declaration : entry;
    if (declaration?.type !== 'VariableDeclaration' || declaration.kind !== 'const') {
      continue;
    }
    for (const binding of declaration.declarations) {
      if (
        binding.id.type === 'Identifier' &&
        binding.init !== undefined &&
        binding.init !== null &&
        (binding.id === node || binding.init === node)
      ) {
        return { expression: binding.init, id: binding.id, module };
      }
    }
  }
  return undefined;
};

const nativeSchemaUnionOrigin = (
  state: BoundaryCheckState,
  module: SourceModule,
  node: SchemaNode,
): NativeSchemaOrigin | undefined => {
  const values = state.graph.evaluate(module, node);
  const origins = values.flatMap((value) =>
    value.kind === 'node' || value.kind === 'unresolved'
      ? [ownSchemaOrigin(value.module, value.node)].filter((origin) => origin !== undefined)
      : [],
  );
  const [origin] = origins;
  if (
    origin === undefined ||
    !values.every(
      (value) =>
        (value.kind === 'node' || value.kind === 'unresolved') &&
        value.module.path === origin.module.path &&
        (value.node === origin.id || value.node === origin.expression),
    )
  ) {
    return undefined;
  }
  const { expression } = origin;
  return expression.type === 'CallExpression' &&
    expression.callee.type === 'MemberExpression' &&
    !expression.callee.computed &&
    expression.callee.property.type === 'Identifier' &&
    expression.callee.property.name === 'Union' &&
    hasCanonicalSchemaConstructor(state, origin.module, expression) &&
    hasOnlyNativeContractLeaves(state, origin.module, expression)
    ? origin
    : undefined;
};

const schemaTupleBinding = (
  module: SourceModule,
  name: string,
): { readonly index: number; readonly object: SchemaNode } | undefined => {
  const bindings = module.file.program.body.flatMap((entry) => {
    const declaration = entry.type === 'ExportNamedDeclaration' ? entry.declaration : entry;
    if (declaration?.type !== 'VariableDeclaration' || declaration.kind !== 'const') {
      return [];
    }
    return declaration.declarations.flatMap((binding) => {
      if (
        binding.id.type !== 'ArrayPattern' ||
        binding.id.elements.some((element) => element?.type !== 'Identifier') ||
        binding.init?.type !== 'MemberExpression' ||
        binding.init.computed ||
        binding.init.property.type !== 'Identifier' ||
        binding.init.property.name !== 'members'
      ) {
        return [];
      }
      const index = binding.id.elements.findIndex((element) => element?.type === 'Identifier' && element.name === name);
      return index === -1 ? [] : [{ index, object: binding.init.object }];
    });
  });
  return bindings.length === 1 ? bindings[0] : undefined;
};

interface UnwrappedContractMetadata {
  readonly expression: SchemaNode;
  readonly readonlyTuple: boolean;
}
const unwrappedContractMetadata = (node: SchemaNode): UnwrappedContractMetadata => {
  let expression = node;
  let readonlyTuple = false;
  for (let depth = 0; depth < 16; depth += 1) {
    if (expression.type !== 'TSAsExpression' && expression.type !== 'TSSatisfiesExpression') {
      break;
    }
    if (
      expression.type === 'TSAsExpression' &&
      expression.typeAnnotation.type === 'TSTypeReference' &&
      expression.typeAnnotation.typeName.type === 'Identifier' &&
      expression.typeAnnotation.typeName.name === 'const'
    ) {
      readonlyTuple = true;
    }
    const { expression: inner } = expression;
    expression = inner;
  }
  return { expression, readonlyTuple };
};

const referencesSchemaOrigin = (node: SchemaNode, names: ReadonlySet<string>): boolean => {
  let found = false;
  traverseFast(node, (child) => {
    if (child.type === 'Identifier' && names.has(child.name)) {
      found = true;
    }
  });
  return found;
};

const isNativeSchemaFieldsOmitFunction = (value: GraphValue): boolean =>
  value.kind === 'external' &&
  value.specifier === 'effect' &&
  value.name === 'Struct' &&
  value.members.length === 1 &&
  value.members[0] === 'omit';

const strictMetadataEscape = (node: SchemaNode, names: ReadonlySet<string>): boolean => {
  if (node.type === 'AssignmentExpression') {
    return referencesSchemaOrigin(node.right, names);
  }
  if (node.type === 'CallExpression') {
    return referencesSchemaOrigin(node.callee, names);
  }
  if (node.type === 'NewExpression') {
    return node.arguments.some((argument) => referencesSchemaOrigin(argument, names));
  }
  if (node.type === 'TaggedTemplateExpression') {
    return (
      referencesSchemaOrigin(node.tag, names) ||
      node.quasi.expressions.some((value) => referencesSchemaOrigin(value, names))
    );
  }
  if (node.type === 'ClassProperty' || node.type === 'ClassPrivateProperty' || node.type === 'ClassAccessorProperty') {
    return node.value !== null && node.value !== undefined && referencesSchemaOrigin(node.value, names);
  }
  return false;
};

const hasClosedSchemaOriginCustody = (
  state: BoundaryCheckState,
  origin: NativeSchemaOrigin,
  permittedCalls: ReadonlySet<SchemaNode> = new Set(),
  strictData = false,
): boolean => {
  const names = new Set(origin.id.type === 'Identifier' ? [origin.id.name] : []);
  for (let depth = 0; depth < 32; depth += 1) {
    const count = names.size;
    traverseFast(origin.module.file, (node) => {
      if (
        node.type === 'VariableDeclarator' &&
        node.init !== undefined &&
        node.init !== null &&
        ['Identifier', 'MemberExpression', 'ObjectExpression', 'ArrayExpression'].includes(
          unwrappedContractMetadata(node.init).expression.type,
        ) &&
        referencesSchemaOrigin(node.init, names)
      ) {
        for (const name of Object.keys(getBindingIdentifiers(node.id))) {
          names.add(name);
        }
      }
    });
    if (names.size === count) {
      break;
    }
  }
  let closed = true;
  traverseFast(origin.module.file, (node) => {
    if (strictData && strictMetadataEscape(node, names)) {
      closed = false;
    }
    if (
      (node.type === 'AssignmentExpression' && referencesSchemaOrigin(node.left, names)) ||
      (node.type === 'UpdateExpression' && referencesSchemaOrigin(node.argument, names))
    ) {
      closed = false;
    }
    if (
      node.type === 'CallExpression' &&
      !permittedCalls.has(node) &&
      node.arguments.some((argument) => referencesSchemaOrigin(argument, names))
    ) {
      const native = state.graph.evaluate(origin.module, node.callee);
      if (
        !hasCanonicalSchemaConstructor(state, origin.module, node) &&
        !(
          native.length > 0 &&
          native.every(
            (value) =>
              nativeContractLeaf(value) ||
              isCanonicalContractImport(state, value) ||
              isNativeSchemaFieldsOmitFunction(value),
          )
        )
      ) {
        closed = false;
      }
    }
  });
  return closed;
};

const immutableSchemaOrigins = new WeakMap<BoundaryCheckState, WeakMap<SchemaNode, boolean>>();
const hasImmutableSchemaOrigin = (
  state: BoundaryCheckState,
  module: SourceModule,
  origin: NativeSchemaOrigin,
  checkSource: ImmutableContractCheck,
): boolean => {
  let proofs = immutableSchemaOrigins.get(state);
  if (proofs === undefined) {
    proofs = new WeakMap();
    immutableSchemaOrigins.set(state, proofs);
  }
  const cached = proofs.get(origin.expression);
  if (cached !== undefined) {
    return cached;
  }
  let closed = true;
  traverseFast(origin.module.file, (node) => {
    if (
      (node.type === 'ObjectMethod' && (node.computed || node.kind !== 'method')) ||
      (node.type === 'ObjectProperty' && node.computed)
    ) {
      closed = false;
    }
  });
  const file = nodePath.relative(state.root, origin.module.path).replaceAll('\\', '/');
  const valid =
    closed &&
    hasClosedSchemaOriginCustody(state, origin) &&
    !privateImplementationPath.test(file) &&
    (origin.module.path === module.path ||
      checkSource(state, file, new Set([nodePath.relative(state.root, module.path)]), false, origin.expression));
  proofs.set(origin.expression, valid);
  return valid;
};

const isSchemaParameterProjection = (node: SchemaNode, parameter: string): boolean => {
  let root = node;
  const members: string[] = [];
  while (root.type === 'MemberExpression' && !root.computed && root.property.type === 'Identifier') {
    members.unshift(root.property.name);
    root = root.object;
  }
  return (
    root.type === 'Identifier' &&
    root.name === parameter &&
    members.length === 2 &&
    members[0] === 'fields' &&
    members.every((member) => !['__proto__', 'prototype', 'constructor'].includes(member))
  );
};

const isNativeSchemaStructCall = (
  state: BoundaryCheckState,
  module: SourceModule,
  node: SchemaNode | null | undefined,
): boolean =>
  node?.type === 'CallExpression' &&
  node.callee.type === 'MemberExpression' &&
  !node.callee.computed &&
  node.callee.property.type === 'Identifier' &&
  node.callee.property.name === 'Struct' &&
  hasCanonicalSchemaConstructor(state, module, node);

const hasNativeSchemaProjectionArgument = (
  state: BoundaryCheckState,
  module: SourceModule,
  node: SchemaNode,
  checkSource: ImmutableContractCheck,
  permittedCall: SchemaNode,
): boolean => {
  if (node.type !== 'Identifier') {
    return false;
  }
  const binding = schemaTupleBinding(module, node.name);
  const origin = binding === undefined ? undefined : nativeSchemaUnionOrigin(state, module, binding.object);
  const actual = nativeSchemaUnionOrigin(state, module, node);
  if (actual?.expression !== origin?.expression) {
    return false;
  }
  if (
    binding === undefined ||
    origin?.expression.type !== 'CallExpression' ||
    origin.expression.arguments.length !== 1
  ) {
    return false;
  }
  const [members] = origin.expression.arguments;
  const member = members?.type === 'ArrayExpression' ? members.elements[binding.index] : undefined;
  const schemaBinding =
    member?.type === 'Identifier' ? resolveSchemaCallReceiver(state, origin.module, member) : undefined;
  const schema = schemaBinding?.expression ?? member;
  return (
    isNativeSchemaStructCall(state, origin.module, schema) &&
    hasImmutableSchemaOrigin(state, module, origin, checkSource) &&
    hasClosedSchemaOriginCustody(state, { ...origin, id: node, module }, new Set([permittedCall]))
  );
};

const hasSchemaFieldsProjectionCall = (
  state: BoundaryCheckState,
  module: SourceModule,
  node: SchemaNode,
  checkSource: ImmutableContractCheck,
): boolean => {
  if (node.type !== 'CallExpression' || node.callee.type !== 'Identifier' || node.arguments.length !== 1) {
    return false;
  }
  const binding = ownConstContractDeclaration(module, node.callee.name);
  const referenced = state.graph.resolveReference(module, node.callee);
  if (
    binding === undefined ||
    referenced?.kind !== 'declaration' ||
    referenced.module.path !== binding.module.path ||
    referenced.expression !== binding.expression
  ) {
    return false;
  }
  if (
    binding?.expression.type !== 'ArrowFunctionExpression' ||
    binding.expression.async ||
    binding.expression.params.length !== 1 ||
    binding.expression.params[0]?.type !== 'Identifier' ||
    binding.expression.body.type !== 'ObjectExpression'
  ) {
    return false;
  }
  const [parameter] = binding.expression.params;
  const fields = binding.expression.body.properties;
  return (
    fields.length > 0 &&
    fields.every(
      (field) =>
        field.type === 'ObjectProperty' &&
        !field.computed &&
        !field.shorthand &&
        (isSchemaParameterProjection(field.value, parameter.name) ||
          hasOnlyNativeContractLeaves(state, module, field.value)),
    ) &&
    hasNativeSchemaProjectionArgument(state, module, node.arguments[0], checkSource, node)
  );
};

const schemaStructReceiver = (
  state: BoundaryCheckState,
  module: SourceModule,
  node: SchemaNode,
): NativeSchemaOrigin | undefined => {
  const binding = node.type === 'Identifier' ? resolveSchemaCallReceiver(state, module, node) : undefined;
  let expression = binding?.expression ?? node;
  const owner = binding?.module ?? module;
  if (node.type === 'Identifier') {
    const referenced = state.graph.resolveReference(module, node);
    if (
      binding === undefined ||
      referenced?.kind !== 'declaration' ||
      referenced.module.path !== binding.module.path ||
      referenced.expression !== binding.expression
    ) {
      return undefined;
    }
  }
  while (
    expression.type === 'CallExpression' &&
    expression.callee.type === 'MemberExpression' &&
    !expression.callee.computed &&
    expression.callee.property.type === 'Identifier' &&
    ['check', 'pipe'].includes(expression.callee.property.name)
  ) {
    expression = expression.callee.object;
  }
  if (!isNativeSchemaStructCall(state, owner, expression)) {
    return undefined;
  }
  if (binding !== undefined) {
    return ownSchemaOrigin(owner, binding.expression);
  }
  return ownSchemaOrigin(owner, node) ?? { expression: node, id: node, module: owner };
};

const hasSchemaFieldsOmitCall = (
  state: BoundaryCheckState,
  module: SourceModule,
  node: SchemaNode,
  checkSource: ImmutableContractCheck,
): boolean => {
  if (node.type !== 'CallExpression' || node.arguments.length !== 2) {
    return false;
  }
  const callees = state.graph.evaluate(module, node.callee);
  if (callees.length !== 1 || !callees.every(isNativeSchemaFieldsOmitFunction)) {
    return false;
  }
  const [fields, keys] = node.arguments;
  if (
    fields?.type !== 'MemberExpression' ||
    fields.computed ||
    fields.property.type !== 'Identifier' ||
    fields.property.name !== 'fields' ||
    keys?.type !== 'ArrayExpression' ||
    keys.elements.length > 128 ||
    !keys.elements.every((key) => key?.type === 'StringLiteral')
  ) {
    return false;
  }
  const schema = schemaStructReceiver(state, module, fields.object);
  return (
    schema !== undefined &&
    hasImmutableSchemaOrigin(state, module, schema, checkSource) &&
    hasClosedSchemaOriginCustody(state, { ...schema, id: fields.object, module }, new Set([node]))
  );
};

const isNativeNominalBrandFactoryCall = (
  state: BoundaryCheckState,
  module: SourceModule,
  node: SchemaNode,
): boolean => {
  if (node.type !== 'CallExpression' || node.arguments.length !== 0) {
    return false;
  }
  const values = state.graph.evaluate(module, node.callee);
  return (
    values.length === 1 &&
    values.every(
      (value) =>
        value.kind === 'external' &&
        value.specifier === 'effect' &&
        value.name === 'Brand' &&
        value.members.length === 1 &&
        value.members[0] === 'nominal',
    )
  );
};

const isSchemaAnnotationCall = (state: BoundaryCheckState, module: SourceModule, node: SchemaNode): boolean => {
  if (
    node.type === 'CallExpression' &&
    state.graph.evaluate(module, node.callee).some(isNativeSchemaAnnotationFunction)
  ) {
    return true;
  }
  if (node.type !== 'CallExpression' || node.callee.type !== 'MemberExpression' || !isSchemaAnnotationMethod(node)) {
    return false;
  }
  const receiver = node.callee.object;
  const binding = receiver.type === 'Identifier' ? resolveSchemaCallReceiver(state, module, receiver) : undefined;
  const schema = binding?.expression ?? receiver;
  if (hasCanonicalSchemaConstructor(state, binding?.module ?? module, schema)) {
    return true;
  }
  return state.graph
    .evaluate(module, receiver)
    .some(
      (value) =>
        nativeContractLeaf(value) &&
        value.kind === 'external' &&
        (value.name === 'Schema' || value.specifier === EFFECT_SCHEMA_PROVIDER),
    );
};

const hasImmutableRuntimeCall = (
  state: BoundaryCheckState,
  module: SourceModule,
  node: SchemaNode,
  dormantFactories: ReadonlySet<SchemaNode>,
  approvedApiRoot: SchemaNode | undefined,
  checkSource: ImmutableContractCheck,
): boolean => {
  if (node.type !== 'CallExpression') {
    return false;
  }
  if (isSchemaAnnotationCall(state, module, node) && !hasLiteralSchemaAnnotation(node)) {
    return false;
  }
  const callees = state.graph.evaluate(module, node.callee);
  if (
    isApprovedApiMetadataCall(node, approvedApiRoot, callees) ||
    dormantFactories.has(node) ||
    callees.some(isProblemDetailsFactory) ||
    hasCanonicalSchemaConstructor(state, module, node) ||
    hasSchemaFieldsProjectionCall(state, module, node, checkSource) ||
    hasSchemaFieldsOmitCall(state, module, node, checkSource) ||
    isNativeNominalBrandFactoryCall(state, module, node)
  ) {
    return true;
  }
  return (
    state.graph.reachable(module, node.callee).length > 0 && hasOnlyNativeContractLeaves(state, module, node.callee)
  );
};

const hasImmutableContractRuntime = (
  state: BoundaryCheckState,
  module: SourceModule,
  file: string,
  selected: SchemaNode | undefined,
  checkSource: ImmutableContractCheck,
  approvedApiRoot?: SchemaNode,
): boolean => {
  const typeNodes = new Set<SchemaNode>();
  const dormantNodes = new Set<SchemaNode>();
  traverseFast(module.file, (node) => {
    if (selected !== undefined && isFunction(node)) {
      traverseFast(node, (child) => {
        dormantNodes.add(child);
      });
    }
    if (node.type === 'TSTypeAliasDeclaration' || node.type === 'TSInterfaceDeclaration') {
      traverseFast(node, (typeNode) => {
        typeNodes.add(typeNode);
      });
    }
    if ('typeAnnotation' in node && node.typeAnnotation !== null && node.typeAnnotation !== undefined) {
      traverseFast(node.typeAnnotation, (typeNode) => {
        typeNodes.add(typeNode);
      });
    }
  });
  if (
    selected !== undefined &&
    [...nativeOwnershipOrigins(state, file).values()].some((paths) =>
      paths.some((path) => privateImplementationPath.test(path)),
    )
  ) {
    return false;
  }
  const dormantFactories =
    selected === undefined ? new Set<SchemaNode>() : dormantNativeEffectFactoryCalls(state, module);
  let immutable = true;
  traverseFast(module.file, (node) => {
    if (selected !== undefined && dormantNodes.has(node)) {
      return;
    }
    if (
      ((isFunction(node) || node.type === 'ClassDeclaration' || node.type === 'ClassExpression') &&
        selected === undefined) ||
      node.type === 'AssignmentExpression' ||
      node.type === 'UpdateExpression' ||
      node.type === 'TaggedTemplateExpression' ||
      (selected === undefined && node.type === 'VariableDeclaration' && node.kind !== 'const')
    ) {
      immutable = false;
    }
    if (
      node.type === 'CallExpression' &&
      !hasImmutableRuntimeCall(state, module, node, dormantFactories, approvedApiRoot, checkSource)
    ) {
      immutable = false;
    }
    if (selected === undefined && !hasAllowedUnboundContractReference(state, module, node, typeNodes)) {
      immutable = false;
    }
  });
  return immutable;
};

type ContractBinding = ReturnType<BoundaryCheckState['graph']['resolve']>;
type ContractImportSpecifier = ImportSpecifier | ImportDefaultSpecifier | ImportNamespaceSpecifier;

const isNativeImmutableImport = (
  state: BoundaryCheckState,
  module: SourceModule,
  specifier: ContractImportSpecifier,
  binding: ContractBinding,
  nativeApi: boolean,
): boolean => {
  if (binding?.kind === 'external' && nativeContractLeaf({ ...binding, members: [] })) {
    return true;
  }
  if (state.graph.evaluate(module, specifier.local).some(isProblemDetailsFactory)) {
    return true;
  }
  let executableBinding = false;
  if (binding?.kind === 'declaration') {
    traverseFast(binding.expression, (node) => {
      if (isFunction(node) || node.type === 'ClassDeclaration' || node.type === 'ClassExpression') {
        executableBinding = true;
      }
    });
  }
  if (
    binding?.kind === 'declaration' &&
    !executableBinding &&
    hasOnlyNativeContractLeaves(state, binding.module, binding.expression)
  ) {
    return true;
  }
  return (
    nativeApi &&
    binding?.kind === 'declaration' &&
    hasCanonicalSchemaConstructor(state, binding.module, binding.expression)
  );
};

const isImmutableContractImport = (
  state: BoundaryCheckState,
  module: SourceModule,
  file: string,
  statement: ImportDeclaration,
  visited: Set<string>,
  nativeApi: boolean,
  selected: SchemaNode | undefined,
  checkSource: ImmutableContractCheck,
): boolean =>
  statement.specifiers.length > 0 &&
  statement.specifiers.every((specifier) => {
    const binding = state.graph.resolve(module, specifier.local.name, 'local');
    const direct = ownershipDeclarationTarget(state, file, statement.source.value);
    if (direct !== undefined && privateImplementationPath.test(direct)) {
      return false;
    }
    if (
      binding?.kind === 'declaration' &&
      privateImplementationPath.test(nodePath.relative(state.root, binding.module.path))
    ) {
      return false;
    }
    if (selected !== undefined || isNativeImmutableImport(state, module, specifier, binding, nativeApi)) {
      return true;
    }
    const typeImport =
      statement.importKind === 'type' || (specifier.type === 'ImportSpecifier' && specifier.importKind === 'type');
    const target = ownershipDeclarationTarget(state, file, statement.source.value);
    if (!typeImport || target === undefined) {
      return false;
    }
    return (
      checkSource(state, target, new Set(visited)) ||
      (specifier.type === 'ImportSpecifier' &&
        isSelectedSchemaExport(
          state,
          target,
          specifier.imported.type === 'Identifier' ? specifier.imported.name : specifier.imported.value,
          visited,
          nativeApi,
          checkSource,
        ))
    );
  });

const isImmutableContractReexport = (
  state: BoundaryCheckState,
  file: string,
  statement: ExportNamedDeclaration | ExportAllDeclaration,
  visited: Set<string>,
  nativeApi: boolean,
  selected: SchemaNode | undefined,
  checkSource: ImmutableContractCheck,
): boolean => {
  if (statement.source === null || statement.source === undefined) {
    return false;
  }
  const target = ownershipDeclarationTarget(state, file, statement.source.value);
  if (target === undefined) {
    return false;
  }
  if (selected !== undefined && statement.type === 'ExportNamedDeclaration') {
    if (privateImplementationPath.test(target)) {
      return false;
    }
    const dependency = state.graph.module(nodePath.join(state.root, target));
    return statement.specifiers.every((specifier) => {
      if (specifier.type !== 'ExportSpecifier') {
        return false;
      }
      const binding = resolveContractExport(
        state,
        dependency,
        specifier.local.type === 'Identifier' ? specifier.local.name : specifier.local.value,
        statement.exportKind === 'type' || specifier.exportKind === 'type',
      );
      return (
        binding?.kind !== 'declaration' ||
        !privateImplementationPath.test(nodePath.relative(state.root, binding.module.path))
      );
    });
  }
  if (
    statement.type === 'ExportNamedDeclaration' &&
    statement.specifiers.length > 0 &&
    statement.specifiers.every(
      (specifier) =>
        specifier.type === 'ExportSpecifier' &&
        isSelectedSchemaExport(
          state,
          target,
          specifier.local.type === 'Identifier' ? specifier.local.name : specifier.local.value,
          visited,
          nativeApi,
          checkSource,
        ),
    )
  ) {
    return true;
  }
  return checkSource(state, target, visited, nativeApi, selected);
};

const isImmutablePublicContract = (
  state: BoundaryCheckState,
  file: string,
  visited = new Set<string>(),
  nativeApi = false,
  selected?: SchemaNode,
): boolean => {
  if (privateImplementationPath.test(file) || visited.has(file) || visited.size >= 128) {
    return false;
  }
  visited.add(file);
  const module = state.graph.module(nodePath.join(state.root, file));
  if (selected === undefined && module.mutations.length > 0) {
    return false;
  }
  const apiName = nativeApi ? governedApiBinding(state.sourceMap.get(file) ?? '') : undefined;
  const api = apiName === undefined ? undefined : state.graph.resolve(module, apiName, 'export');
  const approvedApiRoot = api?.kind === 'declaration' && api.expression === selected ? selected : undefined;
  if (!hasImmutableContractRuntime(state, module, file, selected, isImmutablePublicContract, approvedApiRoot)) {
    return false;
  }
  return module.file.program.body.every((statement) => {
    if (statement.type === 'ImportDeclaration') {
      return isImmutableContractImport(
        state,
        module,
        file,
        statement,
        visited,
        nativeApi,
        selected,
        isImmutablePublicContract,
      );
    }
    if (
      (statement.type === 'ExportNamedDeclaration' || statement.type === 'ExportAllDeclaration') &&
      statement.source !== null &&
      statement.source !== undefined
    ) {
      return isImmutableContractReexport(
        state,
        file,
        statement,
        visited,
        nativeApi,
        selected,
        isImmutablePublicContract,
      );
    }
    return (
      statement.type === 'ExportNamedDeclaration' ||
      statement.type === 'VariableDeclaration' ||
      statement.type === 'TSTypeAliasDeclaration' ||
      statement.type === 'TSInterfaceDeclaration'
    );
  });
};

const isNativeEffectClientConstructor = (value: GraphValue): boolean =>
  value.kind === 'external' &&
  value.specifier === EFFECT_CLIENT_PROVIDER &&
  value.name === 'makeEffectHttpApiClient' &&
  value.members.length === 0;

const isApprovedCompositionClient = (
  state: BoundaryCheckState,
  consumer: string,
  specifier: string,
  target: string,
): boolean => {
  if (!isAllowedCompositionSeam(consumer, specifier)) {
    return false;
  }
  const module = state.graph.module(nodePath.join(state.root, target));
  if (module.mutations.length > 0) {
    return false;
  }
  for (const dependency of readImportedModuleSpecifiers(state.sourceMap.get(target) ?? '')) {
    const resolved = ownershipDeclarationTarget(state, target, dependency);
    if (resolved !== undefined && privateImplementationPath.test(resolved)) {
      return false;
    }
  }
  let nativeClient = false;
  traverseFast(module.file, (node) => {
    if (node.type !== 'CallExpression') {
      return;
    }
    const genuine = state.graph.evaluate(module, node.callee).some(isNativeEffectClientConstructor);
    const [contract] = node.arguments;
    if (
      !genuine ||
      contract === undefined ||
      (contract.type !== 'Identifier' && contract.type !== 'MemberExpression')
    ) {
      return;
    }
    const binding = state.graph.resolveReference(module, contract);
    if (binding?.kind !== 'declaration' || binding.module.boundary !== module.boundary) {
      return;
    }
    const path = nodePath.relative(state.root, binding.module.path).replaceAll('\\', '/');
    if (isImmutablePublicContract(state, path)) {
      nativeClient = true;
    }
  });
  return nativeClient;
};

const isPublishedClientApiArgument = (
  state: BoundaryCheckState,
  source: SourceModule,
  argument: SchemaNode | undefined,
  api: SelectedContractDeclaration,
): boolean => {
  if (argument?.type !== 'Identifier' && argument?.type !== 'MemberExpression') {
    return false;
  }
  const actual = state.graph.resolveReference(source, argument);
  if (actual?.kind !== 'declaration') {
    return false;
  }
  if (actual.module.path === api.module.path && actual.expression === api.expression) {
    return true;
  }
  if (
    deploymentOwner(state, nodePath.relative(state.root, actual.module.path)) !==
      deploymentOwner(state, nodePath.relative(state.root, api.module.path)) ||
    argument.type !== 'Identifier'
  ) {
    return false;
  }
  const published = state.graph.resolve(api.module, argument.name, 'export');
  return (
    published?.kind === 'declaration' &&
    published.module.path === actual.module.path &&
    published.expression === actual.expression &&
    actual.expression.type === 'CallExpression' &&
    state.graph
      .reachable(actual.module, actual.expression.callee)
      .some(
        (value) =>
          value.kind === 'external' && nativeContractProviders.has(value.specifier) && value.name === 'HttpApi',
      )
  );
};

const isCanonicalGovernedWrapperCall = (
  state: BoundaryCheckState,
  source: SourceModule,
  call: Extract<SchemaNode, { readonly type: 'CallExpression' }>,
  consumerFile: string,
): boolean => {
  const [argument] = call.arguments;
  if (
    argument?.type !== 'Identifier' ||
    state.graph.isUnboundReference(source, argument) ||
    state.graph.resolveReference(source, argument)?.kind === 'declaration'
  ) {
    return false;
  }
  const canonical = ownershipDeclarationTarget(state, consumerFile, CANONICAL_CLIENT_RUNTIME_SPECIFIER);
  if (canonical === undefined || nodePath.relative(state.root, source.path).replaceAll('\\', '/') !== canonical) {
    return false;
  }
  const wrapper = state.graph.resolve(source, 'makeGovernedEffectBffClient', 'export');
  if (wrapper?.kind !== 'declaration' || wrapper.module.path !== source.path || !isFunction(wrapper.expression)) {
    return false;
  }
  let contained = false;
  traverseFast(wrapper.expression, (node) => {
    if (node === call) {
      contained = true;
    }
  });
  return contained;
};

const hasNativeClientApi = (
  state: BoundaryCheckState,
  binding: { readonly expression: SchemaNode; readonly module: SourceModule },
  api: { readonly expression: SchemaNode; readonly module: SourceModule },
): boolean => {
  if (!isFunction(binding.expression)) {
    return false;
  }
  const file = nodePath.relative(state.root, binding.module.path).replaceAll('\\', '/');
  if (
    privateImplementationPath.test(file) ||
    [...nativeOwnershipOrigins(state, file).values()].some((paths) =>
      paths.some((path) => privateImplementationPath.test(path)),
    )
  ) {
    return false;
  }
  const reachable = state.graph.reachable(binding.module, binding.expression);
  const nodes: { readonly module: SourceModule; readonly node: SchemaNode }[] = [
    { module: binding.module, node: binding.expression },
  ];
  if (reachable.some(isNativeEffectClientConstructor)) {
    for (const value of reachable) {
      if (value.kind === 'node' || value.kind === 'unresolved') {
        nodes.push({ module: value.module, node: value.node });
      }
    }
  }
  const proofs = nodes.map((entry) => {
    let native = false;
    let foreignApi = false;
    traverseFast(entry.node, (node) => {
      if (
        node.type !== 'CallExpression' ||
        !state.graph.evaluate(entry.module, node.callee).some(isNativeEffectClientConstructor)
      ) {
        return;
      }
      const [argument] = node.arguments;
      if (isPublishedClientApiArgument(state, entry.module, argument, api)) {
        native = true;
      } else if (!isCanonicalGovernedWrapperCall(state, entry.module, node, file)) {
        foreignApi = true;
      }
    });
    return { foreignApi, native };
  });
  return proofs.some((proof) => proof.native) && proofs.every((proof) => !proof.foreignApi);
};

const hasCanonicalClientRuntimeImport = (
  state: BoundaryCheckState,
  aggregate: SourceModule,
  file: string,
  statement: ImportDeclaration,
): boolean => {
  const canonical = ownershipDeclarationTarget(state, file, CANONICAL_CLIENT_RUNTIME_SPECIFIER);
  const target = ownershipDeclarationTarget(state, file, statement.source.value);
  if (canonical === undefined || target !== canonical || statement.specifiers.length === 0) {
    return false;
  }
  const runtime = state.graph.module(nodePath.join(state.root, canonical));
  return statement.specifiers.every((specifier) => {
    if (specifier.type !== 'ImportSpecifier') {
      return false;
    }
    if (statement.importKind === 'type' || specifier.importKind === 'type') {
      return true;
    }
    const exportedName = specifier.imported.type === 'Identifier' ? specifier.imported.name : specifier.imported.value;
    const actual = state.graph.resolve(aggregate, specifier.local.name, 'local');
    const published = state.graph.resolve(runtime, exportedName, 'export');
    return (
      actual?.kind === 'declaration' &&
      published?.kind === 'declaration' &&
      actual.module.path === published.module.path &&
      actual.expression === published.expression &&
      nodePath.relative(state.root, actual.module.path).replaceAll('\\', '/') === canonical
    );
  });
};

const hasValidOwnerClientImports = (
  state: BoundaryCheckState,
  owner: string,
  target: string,
  aggregate: SourceModule,
  appId: string,
): boolean => {
  const dependencies = readImportedModuleSpecifiers(state.sourceMap.get(target) ?? '');
  const imports = aggregate.file.program.body.flatMap((statement) =>
    statement.type === 'ImportDeclaration' ? [statement] : [],
  );
  for (const dependency of dependencies) {
    const origin = ownershipDeclarationTarget(state, target, dependency);
    if (origin !== undefined && privateImplementationPath.test(origin)) {
      return false;
    }
  }
  const readOwnerSource = (file: string) => state.sourceMap.get(nodePath.posix.join(owner, file)) ?? '';
  return (
    imports.every(
      (statement) =>
        isAllowedEffectClientAggregateImport(statement.source.value) ||
        hasCanonicalClientRuntimeImport(state, aggregate, target, statement),
    ) && hasValidActionGateway(dependencies, { appId, readOwnerSource })
  );
};

const hasDeclaredOwnerClient = (
  state: BoundaryCheckState,
  aggregate: SourceModule,
  api: { readonly expression: SchemaNode; readonly module: SourceModule },
): boolean => {
  let delegated = false;
  for (const statement of aggregate.file.program.body) {
    const variables = statement.type === 'ExportNamedDeclaration' ? statement.declaration : statement;
    if (variables?.type === 'VariableDeclaration' && variables.kind === 'const') {
      for (const declaration of variables.declarations) {
        if (declaration.id.type === 'Identifier') {
          const binding = state.graph.resolve(aggregate, declaration.id.name, 'local');
          if (
            binding?.kind === 'declaration' &&
            (hasNativeClientApi(state, binding, api) ||
              (binding.expression.type === 'CallExpression' &&
                state.graph.evaluate(binding.module, binding.expression.callee).some(isNativeEffectClientConstructor) &&
                isPublishedClientApiArgument(state, binding.module, binding.expression.arguments[0], api)))
          ) {
            delegated = true;
          }
        }
      }
    }
  }
  return delegated;
};

const isRuntimeOwnerClientImport = (statement: SchemaNode): boolean =>
  statement.type === 'ImportDeclaration' &&
  statement.importKind !== 'type' &&
  /^\.\/.+-client\.ts$/u.test(statement.source.value) &&
  !(
    statement.specifiers.length > 0 &&
    statement.specifiers.every((specifier) => specifier.type === 'ImportSpecifier' && specifier.importKind === 'type')
  );

const readOwnerClientImport = (
  state: BoundaryCheckState,
  owner: string,
  target: string,
  aggregate: SourceModule,
  statement: ImportDeclaration,
  api: { readonly expression: SchemaNode; readonly module: SourceModule },
  appId: string,
  moduleId: string,
): { readonly delegated: boolean; readonly generated?: string } | undefined => {
  const localClient = statement.source.value;
  const file = ownershipDeclarationTarget(state, target, localClient);
  if (file === undefined || deploymentOwner(state, file) !== owner || privateImplementationPath.test(file)) {
    return undefined;
  }
  if (isGeneratedEffectClientLeaf({ appId, localClient, moduleId, source: state.sourceMap.get(file) ?? '' })) {
    return { delegated: false, generated: file };
  }
  let nativeDelegate = false;
  for (const imported of statement.specifiers) {
    if (imported.type === 'ImportSpecifier' && imported.importKind === 'type') {
      continue;
    }
    const binding = state.graph.resolve(aggregate, imported.local.name, 'local');
    if (
      binding?.kind === 'declaration' &&
      nodePath.relative(state.root, binding.module.path).replaceAll('\\', '/') === file &&
      hasNativeClientApi(state, binding, api)
    ) {
      nativeDelegate = true;
    }
  }
  return nativeDelegate ? { delegated: true } : undefined;
};

const delegatedClientModules = (
  state: BoundaryCheckState,
  owner: string,
  target: string,
  apiTarget: string,
  appId: string,
  moduleId: string,
): ReadonlySet<string> | undefined => {
  const aggregate = state.graph.module(nodePath.join(state.root, target));
  if (!hasValidOwnerClientImports(state, owner, target, aggregate, appId)) {
    return undefined;
  }
  const apiModule = state.graph.module(nodePath.join(state.root, apiTarget));
  const apiName = governedApiBinding(state.sourceMap.get(apiTarget) ?? '');
  const api = apiName === undefined ? undefined : state.graph.resolve(apiModule, apiName, 'export');
  if (api?.kind !== 'declaration' || deploymentOwner(state, nodePath.relative(state.root, api.module.path)) !== owner) {
    return undefined;
  }
  const generated = new Set<string>();
  let delegated = hasDeclaredOwnerClient(state, aggregate, api);
  for (const statement of aggregate.file.program.body) {
    if (statement.type !== 'ImportDeclaration' || !isRuntimeOwnerClientImport(statement)) {
      continue;
    }
    const client = readOwnerClientImport(state, owner, target, aggregate, statement, api, appId, moduleId);
    if (client === undefined) {
      return undefined;
    }
    if (client.generated !== undefined) {
      generated.add(client.generated);
    }
    if (client.delegated) {
      delegated = true;
    }
  }
  return delegated ? generated : undefined;
};

const matchesSelectedContractBinding = (
  binding: ContractBinding,
  selected: { readonly expression: SchemaNode; readonly module: SourceModule },
): boolean =>
  binding?.kind === 'declaration' &&
  binding.module.path === selected.module.path &&
  binding.expression === selected.expression;

const hasNativeGovernedClientWrapper = (state: BoundaryCheckState, module: SourceModule, target: string): boolean => {
  const wrapper = state.graph.resolve(module, 'makeGovernedEffectBffClient', 'local');
  const canonicalWrapper = ownershipDeclarationTarget(state, target, CANONICAL_CLIENT_RUNTIME_SPECIFIER);
  if (
    wrapper?.kind !== 'declaration' ||
    canonicalWrapper === undefined ||
    nodePath.relative(state.root, wrapper.module.path).replaceAll('\\', '/') !== canonicalWrapper
  ) {
    return false;
  }
  let nativeSdk = false;
  traverseFast(wrapper.expression, (node) => {
    if (
      node.type === 'CallExpression' &&
      state.graph.evaluate(wrapper.module, node.callee).some(isNativeEffectClientConstructor)
    ) {
      nativeSdk = true;
    }
  });
  return nativeSdk;
};

const governedReadClientLocation = (
  state: BoundaryCheckState,
  owner: string,
  target: string,
  appId: string,
  slug: string,
): { readonly apiFile: string; readonly contractImport: string; readonly gatewayFile: string } | undefined => {
  const native = {
    apiFile: `${owner}/shared/apis/${slug}.ts`,
    contractImport: `../../shared/apis/${slug}.ts`,
    gatewayFile: `${owner}/src/api/action-gateway.ts`,
  };
  if (target === `${owner}/src/api/${slug}-client.ts`) {
    return native;
  }
  const moduleId = state.ownershipPackages.get(owner)?.metadata.modernjs?.ontosModule?.moduleId;
  const published =
    moduleId === undefined ? undefined : resolvePublishedOwnerReadClient(state.sourceMap, owner, appId, moduleId, slug);
  if (
    published?.client.sourcePath !== target ||
    !hasCachedCompleteModuleApiSeam(state, `${owner}/shared/api.ts`, appId)
  ) {
    return undefined;
  }
  const relativeImport = nodePath.posix.relative(nodePath.posix.dirname(target), published.contract.sourcePath);
  return {
    apiFile: published.contract.sourcePath,
    contractImport: relativeImport.startsWith('.') ? relativeImport : `./${relativeImport}`,
    gatewayFile: `${published.client.packagePath}/src/api/action-gateway.ts`,
  };
};

const hasGovernedClientOperation = (
  state: BoundaryCheckState,
  owner: string,
  target: string,
  appId: string,
  name: string,
  selected: { readonly expression: SchemaNode; readonly module: SourceModule },
): boolean => {
  const file = nodePath.posix.basename(target);
  if (!file.endsWith('-client.ts')) {
    return false;
  }
  const slug = file.slice(0, -'-client.ts'.length);
  const pascal = toPascalCase(slug);
  const publicOperation = `execute${pascal}`;
  const authorizedOperation = `${publicOperation}WithAuthorization`;
  if (name !== publicOperation && name !== authorizedOperation) {
    return false;
  }
  const location = governedReadClientLocation(state, owner, target, appId, slug);
  if (location === undefined) {
    return false;
  }
  const source = state.sourceMap.get(target) ?? '';
  const ownerApiValue = `${pascal}Api`;
  if (
    !hasGeneratedGovernedClientContract(source, {
      authorizedOperation,
      defaultApiPrefix: `/${appId}-api`,
      endpointGroup: toCamelCase(slug),
      generatedHeader: MODULE_API_GENERATOR_HEADER,
      invocationKind: 'module-api',
      ownerApiValue,
      ownerContractImport: location.contractImport,
      publicOperation,
    })
  ) {
    return false;
  }
  const module = state.graph.module(nodePath.join(state.root, target));
  const operation = state.graph.resolve(module, name, 'export');
  if (!matchesSelectedContractBinding(operation, selected)) {
    return false;
  }
  const { apiFile } = location;
  const api = state.graph.resolve(module, ownerApiValue, 'local');
  if (
    api?.kind !== 'declaration' ||
    nodePath.relative(state.root, api.module.path).replaceAll('\\', '/') !== apiFile ||
    !hasGeneratedModuleApiContract(state.sourceMap.get(apiFile) ?? '', ownerApiValue, toCamelCase(slug), slug)
  ) {
    return false;
  }
  if (!hasGeneratedOperationGatewayContract(state.sourceMap.get(location.gatewayFile) ?? '', appId)) {
    return false;
  }
  return hasNativeGovernedClientWrapper(state, module, target);
};

const publishesExactActionClient = (
  state: BoundaryCheckState,
  owner: string,
  appId: string,
  target: string,
  slug: string,
): boolean => {
  const publication = ownerActionClientPublication(state.sourceMap, owner, appId);
  if (publication === undefined) {
    return false;
  }
  const relativeImport = nodePath.posix.relative(nodePath.posix.dirname(publication.file), target);
  return hasGeneratedActionClientPublication(
    publication.source,
    slug,
    relativeImport.startsWith('.') ? relativeImport : `./${relativeImport}`,
  );
};

const hasPublishedActionClientOperation = (
  selection: SelectedOwnerContract,
  name: string,
  selected: SelectedContractDeclaration,
): boolean => {
  const { appId, owner, state } = selection;
  if (appId === undefined) {
    return false;
  }
  const target = nodePath.relative(state.root, selected.module.path).replaceAll('\\', '/');
  const file = nodePath.posix.basename(target);
  const suffix = '-action-client.ts';
  if (!file.endsWith(suffix) || nodePath.posix.dirname(target) !== `${owner}/src/api`) {
    return false;
  }
  const slug = file.slice(0, -suffix.length);
  const type = toPascalCase(slug);
  if (name !== `execute${type}` && name !== `execute${type}WithAuthorization`) {
    return false;
  }
  const moduleId = state.ownershipPackages.get(owner)?.metadata.modernjs?.ontosModule?.moduleId;
  if (
    moduleId === undefined ||
    !isGeneratedEffectClientLeaf({
      appId,
      localClient: `./${file}`,
      moduleId,
      source: state.sourceMap.get(target) ?? '',
    })
  ) {
    return false;
  }
  if (!publishesExactActionClient(state, owner, appId, target, slug)) {
    return false;
  }
  if (!hasCachedCompleteModuleApiSeam(state, `${owner}/shared/api.ts`, appId)) {
    return false;
  }
  const module = state.graph.module(nodePath.join(state.root, target));
  const operation = state.graph.resolve(module, name, 'export');
  if (!matchesSelectedContractBinding(operation, selected)) {
    return false;
  }
  const api = state.graph.resolve(module, `${type}ActionApi`, 'local');
  if (
    api?.kind !== 'declaration' ||
    nodePath.relative(state.root, api.module.path).replaceAll('\\', '/') !== `${owner}/shared/apis/${slug}-action.ts`
  ) {
    return false;
  }
  return (
    hasGeneratedOperationGatewayContract(state.sourceMap.get(`${owner}/src/api/action-gateway.ts`) ?? '', appId) &&
    hasNativeGovernedClientWrapper(state, module, target)
  );
};

interface SelectedOwnerContract {
  readonly appId: string | undefined;
  readonly clientModules: ReadonlySet<string> | undefined;
  readonly consumer: string;
  readonly name: string;
  readonly nativeApi: boolean;
  readonly owner: string;
  readonly state: BoundaryCheckState;
  readonly target: string;
}

const nextSelectedOwnerBinding = (state: BoundaryCheckState, binding: ContractBinding): ContractBinding => {
  if (
    binding?.kind !== 'declaration' ||
    (binding.expression.type !== 'Identifier' && binding.expression.type !== 'MemberExpression') ||
    privateImplementationPath.test(nodePath.relative(state.root, binding.module.path))
  ) {
    return undefined;
  }
  const referenced = state.graph.resolveReference(binding.module, binding.expression);
  return referenced === binding ? undefined : referenced;
};

interface SelectedContractDeclaration {
  readonly expression: SchemaNode;
  readonly module: SourceModule;
}

const exportedConstPatternIdentifiers = (module: SourceModule, name: string) =>
  module.file.program.body.flatMap((statement) => {
    if (
      statement.type !== 'ExportNamedDeclaration' ||
      statement.declaration?.type !== 'VariableDeclaration' ||
      statement.declaration.kind !== 'const'
    ) {
      return [];
    }
    return statement.declaration.declarations.flatMap((declaration) => {
      if (declaration.id.type !== 'ObjectPattern') {
        return [];
      }
      const identifier = getBindingIdentifiers(declaration.id)[name];
      return identifier === undefined ? [] : [identifier];
    });
  });

const ownExportContractDeclaration = (module: SourceModule, name: string): SelectedContractDeclaration | undefined => {
  for (const statement of module.file.program.body) {
    if (statement.type !== 'ExportNamedDeclaration') {
      continue;
    }
    if (statement.declaration?.type === 'VariableDeclaration' && statement.declaration.kind === 'const') {
      const own = statement.declaration.declarations.find(
        (declaration) => declaration.id.type === 'Identifier' && declaration.id.name === name,
      );
      if (own?.init !== undefined && own.init !== null) {
        return { expression: own.init, module };
      }
    }
    if (statement.declaration?.type === 'TSTypeAliasDeclaration' && statement.declaration.id.name === name) {
      const type = statement.declaration.typeAnnotation;
      if (
        type.type === 'TSTypeQuery' &&
        type.exprName.type === 'TSQualifiedName' &&
        type.exprName.right.name === 'Type' &&
        type.exprName.left.type === 'Identifier'
      ) {
        return ownConstContractDeclaration(module, type.exprName.left.name);
      }
    }
  }
  return undefined;
};

const evaluatedOwnerExport = (
  state: BoundaryCheckState,
  module: SourceModule,
  name: string,
  visited = new Set<string>(),
): SelectedContractDeclaration | undefined => {
  const key = `${module.path}:${name}`;
  if (visited.has(key) || visited.size >= 128) {
    return undefined;
  }
  visited.add(key);
  const direct = state.graph.resolve(module, name, 'export');
  if (direct?.kind === 'declaration') {
    return direct;
  }
  let resolved = ownExportContractDeclaration(module, name);
  for (const identifier of exportedConstPatternIdentifiers(module, name)) {
    const [value, ...extra] = state.graph.evaluate(module, identifier);
    if (extra.length > 0 || value?.kind !== 'node') {
      return undefined;
    }
    resolved = { expression: value.node, module: value.module };
  }
  for (const candidate of contractReexportCandidates(state, module, name)) {
    const value = evaluatedOwnerExport(
      state,
      state.graph.module(nodePath.join(state.root, candidate.target)),
      candidate.exportedName,
      new Set(visited),
    );
    if (value !== undefined) {
      if (
        resolved !== undefined &&
        (resolved.module.path !== value.module.path || resolved.expression !== value.expression)
      ) {
        return undefined;
      }
      resolved = value;
    }
  }
  return resolved;
};

const resolveSelectedOwnerBinding = (
  selection: SelectedOwnerContract,
  statement: ImportDeclaration,
  imported: ImportSpecifier,
): SelectedContractDeclaration | undefined => {
  const { state } = selection;
  const consumerModule = state.graph.module(nodePath.join(state.root, selection.consumer));
  const ownerModule = state.graph.module(nodePath.join(state.root, selection.target));
  const exportedName = imported.imported.type === 'Identifier' ? imported.imported.name : imported.imported.value;
  let binding =
    state.graph.resolve(consumerModule, imported.local.name, 'local') ??
    resolveContractExport(
      state,
      ownerModule,
      exportedName,
      statement.importKind === 'type' || imported.importKind === 'type',
    );
  for (let aliases = 0; aliases < 32; aliases += 1) {
    const referenced = nextSelectedOwnerBinding(state, binding);
    if (referenced === undefined) {
      break;
    }
    binding = referenced;
  }
  if (binding?.kind === 'declaration') {
    return binding;
  }
  return evaluatedOwnerExport(state, ownerModule, exportedName);
};

const hasSelectedContractConstructor = (
  selection: SelectedOwnerContract,
  binding: SelectedContractDeclaration,
): boolean => {
  if (binding.expression.type !== 'CallExpression') {
    return false;
  }
  const { state } = selection;
  const ownerModule = state.graph.module(nodePath.join(state.root, selection.target));
  const apiName =
    governedApiBinding(state.sourceMap.get(selection.target) ?? '') ?? `${toPascalCase(selection.name)}Api`;
  const apiBinding = selection.nativeApi ? state.graph.resolve(ownerModule, apiName, 'export') : undefined;
  const selectedApi = apiBinding?.kind === 'declaration' && apiBinding.expression === binding.expression;
  const problemSchema = state.graph.evaluate(binding.module, binding.expression.callee).some(isProblemDetailsFactory);
  const canonicalSchema = hasCanonicalSchemaConstructor(state, binding.module, binding.expression);
  return (
    (selectedApi || problemSchema || canonicalSchema) &&
    isImmutablePublicContract(
      state,
      nodePath.relative(state.root, binding.module.path).replaceAll('\\', '/'),
      new Set(),
      selection.nativeApi,
      binding.expression,
    )
  );
};

// Publication and closure origins establish a contract routine boundary, not
// arbitrary body purity. Runtime authority remains a distinct dependency role.
const hasPublishedContractRoutine = (
  selection: SelectedOwnerContract,
  binding: SelectedContractDeclaration,
): boolean => {
  if (selection.nativeApi || selection.clientModules !== undefined || !isFunction(binding.expression)) {
    return false;
  }
  const { state } = selection;
  const file = nodePath.relative(state.root, binding.module.path).replaceAll('\\', '/');
  if (file !== selection.target || !isImmutablePublicContract(state, file, new Set(), false, binding.expression)) {
    return false;
  }
  const callableReferences = new Set<SchemaNode>();
  const erased = new Set<SchemaNode>();
  traverseFast(binding.expression, (node) => {
    if (
      node.type === 'NewExpression' &&
      node.callee.type === 'Identifier' &&
      node.callee.name === 'Set' &&
      state.graph.isUnboundReference(binding.module, node.callee)
    ) {
      callableReferences.add(node.callee);
    }
    if ('typeAnnotation' in node && node.typeAnnotation !== null && node.typeAnnotation !== undefined) {
      traverseFast(node.typeAnnotation, (typeNode) => {
        erased.add(typeNode);
      });
    }
  });
  let valid = true;
  traverseFast(binding.expression, (node) => {
    if (!callableReferences.has(node) && !hasAllowedUnboundContractReference(state, binding.module, node, erased)) {
      valid = false;
    }
  });
  return (
    valid &&
    !state.graph
      .reachable(binding.module, binding.expression)
      .some((value) =>
        value.kind === 'node' || value.kind === 'unresolved'
          ? privateImplementationPath.test(nodePath.relative(state.root, value.module.path))
          : value.kind === 'external' &&
            (!nativeContractProviders.has(value.specifier) ||
              isNativeEffectClientConstructor(value) ||
              value.specifier === 'effect/Effect' ||
              (value.specifier === 'effect' && value.name === 'Effect')),
      )
  );
};

const closedContractObjectProperty = (node: SchemaNode, name: string): SchemaNode | undefined => {
  if (node.type !== 'ObjectExpression') {
    return undefined;
  }
  const properties = node.properties.flatMap((property) => {
    if (property.type !== 'ObjectProperty' || property.computed) {
      return [];
    }
    const key = literalContractPropertyKey(property.key);
    return key === undefined ? [] : [{ key, value: property.value }];
  });
  if (
    properties.length !== node.properties.length ||
    new Set(properties.map((property) => property.key)).size !== properties.length
  ) {
    return undefined;
  }
  return properties.find((property) => property.key === name)?.value;
};

const hasNativeReadConstruction = (read: SelectedContractDeclaration): boolean => {
  if (read.expression.type !== 'CallExpression' || read.expression.callee.type !== 'Identifier') {
    return false;
  }
  const { callee } = read.expression;
  const imports = read.module.file.program.body.flatMap((statement) =>
    statement.type === 'ImportDeclaration' &&
    statement.source.value === '@app/core-runtime' &&
    statement.importKind !== 'type'
      ? statement.specifiers.filter(
          (specifier) =>
            specifier.type === 'ImportSpecifier' &&
            specifier.importKind !== 'type' &&
            specifier.imported.type === 'Identifier' &&
            specifier.imported.name === 'defineRead' &&
            specifier.local.name === callee.name,
        )
      : [],
  );
  const [imported] = imports;
  if (imports.length !== 1 || imported?.type !== 'ImportSpecifier') {
    return false;
  }
  const permitted = new Set<SchemaNode>([callee, imported.local, imported.imported]);
  let closed = true;
  traverseFast(read.module.file, (node) => {
    if (node.type === 'Identifier' && node.name === callee.name && !permitted.has(node)) {
      closed = false;
    }
  });
  return closed;
};

const nativeReadAccessBinding = (selection: SelectedOwnerContract): ContractBinding => {
  const { state } = selection;
  const readModule = state.graph.module(
    nodePath.join(state.root, `${selection.owner}/src/api/${selection.name}.read.ts`),
  );
  const read = state.graph.resolve(readModule, `${toCamelCase(selection.name)}Read`, 'export');
  if (read?.kind !== 'declaration' || read.expression.type !== 'CallExpression') {
    return undefined;
  }
  const [descriptor] = read.expression.arguments;
  if (!hasNativeReadConstruction(read) || descriptor?.type !== 'ObjectExpression') {
    return undefined;
  }
  const access = closedContractObjectProperty(descriptor, 'accessDeclaration');
  return access?.type === 'Identifier' ? state.graph.resolveReference(read.module, access) : undefined;
};

/** Published read metadata is the exact immutable declaration consumed by the enrolled native Read. */
const hasSelectedReadAccessDeclaration = (
  selection: SelectedOwnerContract,
  binding: SelectedContractDeclaration,
): boolean => {
  const { state } = selection;
  if (
    !selection.nativeApi ||
    selection.target !== `${selection.owner}/shared/apis/${selection.name}.ts` ||
    binding.module.path !== nodePath.join(state.root, selection.target)
  ) {
    return false;
  }
  const data = literalContractData(binding.expression);
  const declaration =
    data === undefined
      ? Option.none()
      : Schema.decodeUnknownOption(AccessDeclarationSchema, {
          onExcessProperty: 'error',
        })(data.value);
  return (
    Option.isSome(declaration) &&
    declaration.value.kind === 'read' &&
    matchesSelectedContractBinding(nativeReadAccessBinding(selection), binding) &&
    isImmutablePublicContract(state, selection.target, new Set(), false, binding.expression)
  );
};

const hasSelectedNativeClientApi = (
  selection: SelectedOwnerContract,
  binding: SelectedContractDeclaration,
): boolean => {
  if (selection.clientModules === undefined) {
    return false;
  }
  const { state } = selection;
  const apiModule = state.graph.module(nodePath.join(state.root, `${selection.owner}/shared/api.ts`));
  const apiName = governedApiBinding(state.sourceMap.get(`${selection.owner}/shared/api.ts`) ?? '');
  const api = apiName === undefined ? undefined : state.graph.resolve(apiModule, apiName, 'export');
  return (
    api?.kind === 'declaration' &&
    deploymentOwner(state, nodePath.relative(state.root, binding.module.path)) === selection.owner &&
    hasNativeClientApi(state, binding, api)
  );
};

const hasReexportedSchemaInitialization = (
  state: BoundaryCheckState,
  file: string,
  module: SourceModule,
  binding: SelectedContractDeclaration,
): boolean => {
  const owner = deploymentOwner(state, file);
  const appId = owner === undefined ? undefined : state.ownershipPackages.get(owner)?.metadata.modernjs?.appId;
  const source = state.sourceMap.get(file) ?? '';
  const origin = nodePath.relative(state.root, binding.module.path).replaceAll('\\', '/');
  const apiName = governedApiBinding(source);
  if (owner === undefined || file !== `${owner}/shared/api.ts`) {
    // The data proof independently initializes the leaf; this fact describes only the facade's own allocations.
    return isImmutablePublicContract(state, file, new Set(), false, module.file);
  }
  if (
    !isImmutablePublicContract(state, origin, new Set(), false, binding.expression) ||
    deploymentOwner(state, origin) !== owner ||
    appId === undefined ||
    !hasCachedCompleteModuleApiSeam(state, file, appId) ||
    apiName === undefined
  ) {
    return false;
  }
  const api = state.graph.resolve(module, apiName, 'export');
  return (
    api?.kind === 'declaration' &&
    api.module.path === module.path &&
    isImmutablePublicContract(state, file, new Set(), true, api.expression)
  );
};

const publicDataCodecContext = (selection: SelectedOwnerContract) => {
  const { state } = selection;
  const initialization = new Map<string, boolean>();
  return {
    filename: selection.target,
    isImmutableContractSource: (file: string, exportedName?: string): boolean => {
      const key = `${file}:${exportedName ?? ''}`;
      const known = initialization.get(key);
      if (known !== undefined) {
        return known;
      }
      initialization.set(key, false);
      if (!state.sourceMap.has(file) || nodePath.posix.normalize(file) !== file || nodePath.isAbsolute(file)) {
        return false;
      }
      const module = state.graph.module(nodePath.join(state.root, file));
      const binding =
        exportedName === undefined ? undefined : resolveContractExport(state, module, exportedName, false);
      const selected = binding?.kind === 'declaration' ? binding.expression : module.file;
      const valid =
        binding?.kind === 'declaration' && binding.module.path !== module.path
          ? hasReexportedSchemaInitialization(state, file, module, binding)
          : isImmutablePublicContract(state, file, new Set(), false, selected);
      initialization.set(key, valid);
      return valid;
    },
    ownerPath: selection.owner,
    sources: state.sourceMap,
  };
};

const hasPublishedContractDataCodec = (
  selection: SelectedOwnerContract,
  exportedName: string,
  binding: SelectedContractDeclaration,
): boolean => {
  if (
    selection.nativeApi ||
    selection.clientModules !== undefined ||
    binding.module.path !== nodePath.join(selection.state.root, selection.target)
  ) {
    return false;
  }
  const source = selection.state.sourceMap.get(selection.target);
  return (
    source !== undefined &&
    provesPublicDataCodecExport(source, exportedName, publicDataCodecContext(selection)) &&
    isImmutablePublicContract(selection.state, selection.target, new Set(), false, binding.expression)
  );
};

const hasPublishedContractCodecType = (
  selection: SelectedOwnerContract,
  statement: ImportDeclaration,
  imported: ImportSpecifier,
): boolean => {
  if (
    (statement.importKind !== 'type' && imported.importKind !== 'type') ||
    selection.nativeApi ||
    selection.clientModules !== undefined
  ) {
    return false;
  }
  const { state } = selection;
  const name = imported.imported.type === 'Identifier' ? imported.imported.name : imported.imported.value;
  const source = state.sourceMap.get(selection.target);
  if (source === undefined || !provesPublicDataCodecTypeExport(source, name, publicDataCodecContext(selection))) {
    return false;
  }
  const module = state.graph.module(nodePath.join(state.root, selection.target));
  const declarations = module.file.program.body.flatMap((entry) => {
    if (entry.type !== 'ExportNamedDeclaration') {
      return [];
    }
    const value = entry.declaration;
    return (value?.type === 'ClassDeclaration' ||
      value?.type === 'TSTypeAliasDeclaration' ||
      value?.type === 'TSInterfaceDeclaration') &&
      value.id?.name === name
      ? [value]
      : [];
  });
  const [declaration] = declarations;
  return (
    declarations.length === 1 &&
    declaration !== undefined &&
    isImmutablePublicContract(state, selection.target, new Set(), false, declaration)
  );
};

const readonlyMetadataTupleSize = (
  module: SourceModule,
  expression: SchemaNode,
  origins: Map<SchemaNode, NativeSchemaOrigin>,
  seen = new Set<SchemaNode>(),
  completed = new WeakMap<SchemaNode, number>(),
): number | undefined => {
  const cached = completed.get(expression);
  if (cached !== undefined) {
    return cached;
  }
  if (seen.size >= 32 || seen.has(expression)) {
    return undefined;
  }
  seen.add(expression);
  const root = unwrappedContractMetadata(expression);
  if (!root.readonlyTuple || root.expression.type !== 'ArrayExpression' || root.expression.elements.length > 512) {
    return undefined;
  }
  const origin = ownSchemaOrigin(module, expression);
  if (origin === undefined) {
    return undefined;
  }
  origins.set(expression, origin);
  let size = 0;
  for (const element of root.expression.elements) {
    if (element?.type === 'StringLiteral') {
      size += 1;
    } else if (element?.type === 'SpreadElement' && element.argument.type === 'Identifier') {
      const child = ownConstContractDeclaration(module, element.argument.name);
      const childSize =
        child === undefined
          ? undefined
          : readonlyMetadataTupleSize(module, child.expression, origins, new Set(seen), completed);
      if (childSize === undefined) {
        return undefined;
      }
      size += childSize;
    } else {
      return undefined;
    }
    if (size > 2048) {
      return undefined;
    }
  }
  completed.set(expression, size);
  return size;
};

const hasSelectedLiteralContractMetadata = (
  selection: SelectedOwnerContract,
  binding: SelectedContractDeclaration,
): boolean => {
  if (
    selection.clientModules !== undefined ||
    binding.module.path !== nodePath.join(selection.state.root, selection.target)
  ) {
    return false;
  }
  const source = selection.state.sourceMap.get(selection.target) ?? '';
  if (hasGeneratedSourceHeader(source, MODULE_API_GENERATOR_HEADER) && !selection.nativeApi) {
    const enrolled =
      selection.appId !== undefined &&
      selection.target === `${selection.owner}/shared/apis/${selection.name}.ts` &&
      hasGeneratedModuleApiContract(
        source,
        `${toPascalCase(selection.name)}Api`,
        toCamelCase(selection.name),
        selection.name,
      ) &&
      hasCachedCompleteModuleApiSeam(selection.state, `${selection.owner}/shared/api.ts`, selection.appId);
    if (!enrolled) {
      return false;
    }
  }
  const { expression } = unwrappedContractMetadata(binding.expression);
  const scalar = ['StringLiteral', 'NumericLiteral', 'BooleanLiteral', 'NullLiteral'].includes(expression.type);
  const origins = new Map<SchemaNode, NativeSchemaOrigin>();
  return (
    (scalar || readonlyMetadataTupleSize(binding.module, binding.expression, origins) !== undefined) &&
    [...origins.values()].every((origin) => hasClosedSchemaOriginCustody(selection.state, origin, new Set(), true)) &&
    isImmutablePublicContract(selection.state, selection.target, new Set(), false, binding.expression)
  );
};

const hasSelectedOwnerImport = (
  selection: SelectedOwnerContract,
  statement: ImportDeclaration,
  imported: ContractImportSpecifier,
): boolean => {
  if (imported.type !== 'ImportSpecifier') {
    return false;
  }
  const { state } = selection;
  if (hasPublishedContractCodecType(selection, statement, imported)) {
    return true;
  }
  const binding = resolveSelectedOwnerBinding(selection, statement, imported);
  if (binding === undefined || privateImplementationPath.test(nodePath.relative(state.root, binding.module.path))) {
    return false;
  }
  if (selection.clientModules?.has(nodePath.relative(state.root, binding.module.path).replaceAll('\\', '/')) === true) {
    return true;
  }
  const exportedName = imported.imported.type === 'Identifier' ? imported.imported.name : imported.imported.value;
  if (
    selection.appId !== undefined &&
    hasGovernedClientOperation(
      state,
      selection.owner,
      nodePath.relative(state.root, binding.module.path).replaceAll('\\', '/'),
      selection.appId,
      exportedName,
      binding,
    )
  ) {
    return true;
  }
  if (hasPublishedActionClientOperation(selection, exportedName, binding)) {
    return true;
  }
  if (hasSelectedNativeClientApi(selection, binding)) {
    return true;
  }
  if (
    hasPublishedContractRoutine(selection, binding) ||
    hasPublishedContractDataCodec(selection, exportedName, binding)
  ) {
    return true;
  }
  if (hasSelectedReadAccessDeclaration(selection, binding)) {
    return true;
  }
  if (binding.expression.type !== 'CallExpression') {
    const literalData = ['StringLiteral', 'NumericLiteral', 'BooleanLiteral', 'NullLiteral'].includes(
      binding.expression.type,
    );
    return (
      hasSelectedLiteralContractMetadata(selection, binding) ||
      (literalData && isImmutablePublicContract(state, selection.target, new Set(), false, binding.expression))
    );
  }
  return hasSelectedContractConstructor(selection, binding);
};

const hasSelectedOwnerContract = (selection: SelectedOwnerContract, importedSpecifier: string): boolean => {
  const module = selection.state.graph.module(nodePath.join(selection.state.root, selection.consumer));
  const imports = module.file.program.body.filter(
    (statement) => statement.type === 'ImportDeclaration' && statement.source.value === importedSpecifier,
  );
  return (
    imports.length > 0 &&
    imports.every(
      (statement) =>
        statement.type === 'ImportDeclaration' &&
        statement.specifiers.length > 0 &&
        statement.specifiers.every((imported) => hasSelectedOwnerImport(selection, statement, imported)),
    )
  );
};

const hasNativeGeneratedOwnerApi = (
  state: BoundaryCheckState,
  owner: string,
  target: string,
  exportKey: string,
  name: string,
  source: string,
  appId: string | undefined,
): boolean => {
  const aggregate =
    exportKey === './api' && target === `${owner}/shared/api.ts` && governedApiBinding(source) !== undefined;
  const generatedLeaf =
    exportKey === `./api/${name}` &&
    target === `${owner}/shared/apis/${name}.ts` &&
    hasGeneratedSourceHeader(source, MODULE_API_GENERATOR_HEADER) &&
    hasGeneratedModuleApiContract(source, `${toPascalCase(name)}Api`, toCamelCase(name), name);
  return (
    (aggregate || generatedLeaf) &&
    appId !== undefined &&
    hasCachedCompleteModuleApiSeam(state, `${owner}/shared/api.ts`, appId)
  );
};

const enrolledOwnerClientModules = (
  state: BoundaryCheckState,
  pkg: OwnershipPackage,
  owner: string,
  target: string,
  exports: Readonly<Record<string, string>>,
  moduleId: string,
  dependencyDeclared: boolean,
  clientRole: boolean,
): ReadonlySet<string> | undefined => {
  const apiTarget = exports['./api'];
  return dependencyDeclared &&
    clientRole &&
    pkg.metadata.modernjs?.apiRuntime === 'effect' &&
    pkg.metadata.modernjs.appId !== undefined &&
    apiTarget !== undefined
    ? delegatedClientModules(
        state,
        owner,
        target,
        nodePath.posix.join(owner, apiTarget),
        pkg.metadata.modernjs.appId,
        moduleId,
      )
    : undefined;
};

const hasStrictPublishedOwnerContract = (
  state: BoundaryCheckState,
  consumerPackage: OwnershipPackage | undefined,
  pkg: OwnershipPackage,
  exports: Readonly<Record<string, string>>,
  owner: string,
  exportKey: string,
  dependencyDeclared: boolean,
): boolean => {
  const references = decodeOwnershipReferences(
    state.sourceMap.get(`${consumerPackage?.directory ?? ''}/tsconfig.json`) ?? '{}',
  );
  if (Result.isFailure(references)) {
    return false;
  }
  if (pkg.metadata.name === undefined) {
    return false;
  }
  try {
    assertPublishedCrossMicroVerticalContractUsage({
      dependencyDeclared,
      dependencyPackageJson: { ...pkg.metadata, exports },
      dependencyPackageName: pkg.metadata.name,
      moduleSpecifiers: [`${pkg.metadata.name}${exportKey.slice(1)}`],
      projectReferenceDeclared:
        consumerPackage !== undefined &&
        (references.success.references ?? []).some(
          (reference) =>
            nodePath.posix
              .normalize(nodePath.posix.join(consumerPackage.directory, reference.path))
              .replace(/\/tsconfig\.json$/u, '') === owner,
        ),
      readExportSource: (path) => state.sourceMap.get(nodePath.posix.join(pkg.directory, path)) ?? '',
    });
    return true;
  } catch {
    return false;
  }
};

const findConsumerOwnershipPackage = (state: BoundaryCheckState, consumer: string): OwnershipPackage | undefined => {
  let selected: OwnershipPackage | undefined;
  for (const candidate of state.ownershipPackages.values()) {
    if (
      consumer.startsWith(`${candidate.directory}/`) &&
      (selected === undefined || candidate.directory.length > selected.directory.length)
    ) {
      selected = candidate;
    }
  }
  return selected;
};

const hasImmediateOwnerContract = (
  state: BoundaryCheckState,
  consumer: string,
  target: string,
  specifier: string,
  dependencyDeclared: boolean,
  clientRole: boolean,
  nativeApi: boolean,
): boolean =>
  dependencyDeclared &&
  (hasPublishedGeneratedContractShim(state.sourceMap, target, state.sourceMap.get(target) ?? '') ||
    (!clientRole && !nativeApi && isImmutablePublicContract(state, target)) ||
    isApprovedCompositionClient(state, consumer, specifier, target));

const hasEligibleSelectedOwnerContract = (
  selection: SelectedOwnerContract,
  importedSpecifier: string | undefined,
  dependencyDeclared: boolean,
  clientRole: boolean,
): boolean =>
  dependencyDeclared &&
  importedSpecifier !== undefined &&
  (!clientRole || selection.clientModules !== undefined) &&
  hasSelectedOwnerContract(selection, importedSpecifier);

const isApprovedOwnerContract = (
  state: BoundaryCheckState,
  consumer: string,
  target: string,
  importedSpecifier?: string,
): boolean => {
  const owner = deploymentOwner(state, target);
  const pkg = owner === undefined ? undefined : state.ownershipPackages.get(owner);
  const moduleId = pkg?.metadata.modernjs?.ontosModule?.moduleId;
  if (owner === undefined || pkg === undefined || moduleId === undefined || pkg.metadata.name === undefined) {
    return false;
  }
  const exports = Object.fromEntries(
    Object.entries(pkg.metadata.exports ?? {}).filter((entry): entry is [string, string] =>
      Schema.is(Schema.String)(entry[1]),
    ),
  );
  const exportKey = Object.entries(exports).find(
    ([, path]) => nodePath.posix.join(pkg.directory, path) === target,
  )?.[0];
  if (exportKey === undefined) {
    return false;
  }
  const specifier = `${pkg.metadata.name}${exportKey.slice(1)}`;
  const name = nodePath.posix.basename(target, '.ts');
  const source = state.sourceMap.get(target) ?? '';
  const nativeApi = hasNativeGeneratedOwnerApi(
    state,
    owner,
    target,
    exportKey,
    name,
    source,
    pkg.metadata.modernjs?.appId,
  );
  const consumerPackage = findConsumerOwnershipPackage(state, consumer);
  const dependencyDeclared = consumerPackage?.metadata.dependencies?.[pkg.metadata.name] !== undefined;
  const clientRole = exportKey === './api/client';
  const clientModules = enrolledOwnerClientModules(
    state,
    pkg,
    owner,
    target,
    exports,
    moduleId,
    dependencyDeclared,
    clientRole,
  );
  if (hasImmediateOwnerContract(state, consumer, target, specifier, dependencyDeclared, clientRole, nativeApi)) {
    return true;
  }
  if (
    hasEligibleSelectedOwnerContract(
      { appId: pkg.metadata.modernjs?.appId, clientModules, consumer, name, nativeApi, owner, state, target },
      importedSpecifier,
      dependencyDeclared,
      clientRole,
    )
  ) {
    return true;
  }
  return hasStrictPublishedOwnerContract(state, consumerPackage, pkg, exports, owner, exportKey, dependencyDeclared);
};

const foreignPrivateOrigin = (
  state: BoundaryCheckState,
  consumer: string,
  target: string,
  visited: Set<string>,
): string | undefined => {
  const owner = deploymentOwner(state, target);
  if (owner === undefined || owner === deploymentOwner(state, consumer)) {
    return undefined;
  }
  if (isApprovedOwnerContract(state, consumer, target)) {
    return undefined;
  }
  if (visited.has(target) || visited.size >= 128) {
    return target;
  }
  visited.add(target);
  const source = state.sourceMap.get(target);
  if (source === undefined) {
    return target;
  }
  const module = state.graph.module(nodePath.join(state.root, target));
  const reexports = module.file.program.body.filter(
    (statement) =>
      (statement.type === 'ExportNamedDeclaration' || statement.type === 'ExportAllDeclaration') &&
      statement.source !== null &&
      statement.source !== undefined,
  );
  if (reexports.length === 0 || reexports.length !== module.file.program.body.length) {
    return target;
  }
  for (const specifier of readImportedModuleSpecifiers(source)) {
    const next = ownershipDeclarationTarget(state, target, specifier);
    if (next === undefined) {
      return target;
    }
    const invalid = foreignPrivateOrigin(state, consumer, next, visited);
    if (invalid !== undefined) {
      return invalid;
    }
  }
  return undefined;
};

const validateResolvedOwnerImports = (state: BoundaryCheckState, file: string, source: string) =>
  Effect.gen(function* validateResolvedOwnerImportsEffect() {
    const consumerOwner = deploymentOwner(state, file);
    const specifiers = readImportedModuleSpecifiers(source).filter((specifier) => {
      const direct = ownershipDeclarationTarget(state, file, specifier);
      const owner = direct === undefined ? undefined : deploymentOwner(state, direct);
      if (owner !== undefined && owner !== consumerOwner) {
        return true;
      }
      return [...state.ownershipPackages.values()].some(
        ({ directory, metadata }) =>
          state.owners.has(directory) &&
          directory !== consumerOwner &&
          metadata.name !== undefined &&
          (specifier === metadata.name || specifier.startsWith(`${metadata.name}/`)),
      );
    });
    if (specifiers.length === 0) {
      return;
    }
    const origins = nativeOwnershipOrigins(state, file);
    for (const specifier of specifiers) {
      const direct = ownershipDeclarationTarget(state, file, specifier);
      if (direct !== undefined && isApprovedOwnerContract(state, file, direct, specifier)) {
        continue;
      }
      const resolvedOrigins = origins.get(specifier) ?? [];
      const targets = [
        ...resolvedOrigins.filter((origin) => privateImplementationPath.test(origin)),
        ...(direct === undefined ? [] : [direct]),
        ...resolvedOrigins.filter((origin) => !privateImplementationPath.test(origin)),
      ];
      if (targets.length === 0) {
        yield* fail(
          file,
          `foreign private or unresolved owner source via ${specifier}; require a proven public descriptor/schema/client`,
        );
      }
      for (const target of targets) {
        const invalid = foreignPrivateOrigin(state, file, target, new Set());
        if (invalid !== undefined) {
          yield* fail(
            file,
            `foreign private implementation ${invalid} (via ${specifier}); use its approved public descriptor/schema/client`,
          );
        }
      }
    }
  });

const governedSourceHeader = (category: string | undefined): string | undefined => {
  if (category === 'components') {
    return '// @generated by OntOS Codesmith public-component v1\n';
  }
  if (category === 'reports') {
    return '// @generated by OntOS Codesmith Governed Contribution v1\n// @ontos-contribution-kind report\n';
  }
  if (category === 'search') {
    return '// @generated by OntOS Codesmith Governed Contribution v1\n// @ontos-contribution-kind search-provider\n';
  }
  return undefined;
};

const inventorySurface = (role: string): ProtectedEntrypointInventoryEntry['surface'] => {
  if (role === 'action') {
    return 'action';
  }
  return role === 'worker' ? 'worker' : 'route';
};

const validateRouteSource = (state: BoundaryCheckState, file: string, source: string) =>
  Effect.gen(function* validateRouteSourceEffect() {
    if (!file.endsWith('/route.meta.ts')) {
      return;
    }
    const ownerEntry = [...state.owners.entries()].find(([appPath]) => file.startsWith(`${appPath}/`));
    const [, owner] = yield* requireDefined(ownerEntry, file, 'route owner is absent from the generated topology');
    const ownerAppIds = readStringProperties(source, 'ownerAppId');
    if (ownerAppIds.size !== 1 || !ownerAppIds.has(owner)) {
      yield* fail(file, 'route ownerAppId must match the generated topology deployment identity');
    }
    const expectedScope = owner.startsWith('shell-') ? 'system' : 'tenant';
    const moduleIds = readStringProperties(source, 'moduleId');
    const moduleOwner = expectedScope === 'tenant' ? [...moduleIds][0] : owner;
    if (moduleOwner === undefined || (expectedScope === 'tenant' && moduleIds.size !== 1)) {
      yield* fail(file, 'MicroVertical route metadata must declare exactly one manifest moduleId');
    }
    state.routeEntrypoints.push({
      deployment: owner,
      entrypointKey: yield* requireRouteEntrypoint(file, source, moduleOwner, expectedScope),
      file,
    });
  });

const validateGovernedSource = (file: string, source: string) =>
  Effect.gen(function* validateGovernedSourceEffect() {
    const category = /\/src\/(?<category>components|search|reports)\//u.exec(`/${file}`)?.groups?.category;
    const expectedHeader = governedSourceHeader(category);
    const invalidGovernedSource =
      /\/src\/public-components\//u.test(`/${file}`) ||
      (expectedHeader !== undefined && !hasGeneratedSourceHeader(source, expectedHeader));
    if (invalidGovernedSource) {
      yield* fail(
        file,
        'public components, search, and reports require an approved Codesmith generator and reserved runtime registration first',
      );
    }
  });

const SEARCH_PROVIDER_KIND = 'search-provider';

interface GeneratedProviderLocation {
  readonly kind: 'report' | 'search';
  readonly name: string;
  readonly vertical: string;
}

const generatedProviderLocation = (file: string, source: string): GeneratedProviderLocation | undefined => {
  if (
    !['report', SEARCH_PROVIDER_KIND].some((kind) =>
      hasGeneratedSourceHeader(
        source,
        `// @generated by OntOS Codesmith Governed Contribution v1\n// @ontos-contribution-kind ${kind}\n`,
      ),
    )
  ) {
    return undefined;
  }
  const locations = [
    /^(?<vertical>verticals\/[^/]+)\/src\/api\/(?<name>[^/]+)-(?<kind>search|report)-client\.ts$/u,
    /^(?<vertical>verticals\/[^/]+)\/shared\/apis\/(?<name>[^/]+)-(?<kind>search|report)\.ts$/u,
    /^(?<vertical>verticals\/[^/]+)\/src\/(?<kind>search|reports)\/(?<name>[^/]+)\.provider\.ts$/u,
    /^(?<vertical>verticals\/[^/]+)\/api\/(?<name>[^/]+)-(?<kind>search|report)-server\.ts$/u,
  ];
  for (const pattern of locations) {
    const provider = pattern.exec(file)?.groups;
    if (provider?.name !== undefined && provider.vertical !== undefined) {
      return {
        kind: provider.kind === 'search' ? 'search' : 'report',
        name: provider.name,
        vertical: provider.vertical,
      };
    }
  }
  return undefined;
};

const providerModuleId = (manifest: string): string =>
  /@ontos-module-id (?<moduleId>[a-z0-9-]+(?:\.[a-z0-9-]+)*)(?![a-z0-9-])/u.exec(manifest)?.groups?.moduleId ?? '';

const providerObjectProperty = (object: Expression | undefined, key: string): Expression | undefined => {
  if (object?.type !== 'ObjectExpression') {
    return undefined;
  }
  const properties = object.properties.filter(
    (property) =>
      property.type === 'Property' &&
      !property.computed &&
      !property.method &&
      property.kind === 'init' &&
      property.key.type === 'Identifier' &&
      property.key.name === key,
  );
  const [property] = properties;
  return properties.length === 1 && property?.type === 'Property' ? property.value : undefined;
};

const providerOwnerInitializer = (source: string, name: string): Expression | undefined => {
  const parsed = parseSync('provider-owner.ts', source, { astType: 'ts', lang: 'ts', sourceType: 'module' });
  if (parsed.errors.length !== 0) {
    return undefined;
  }
  const bindings = parsed.program.body.flatMap((statement) => {
    const declaration = statement.type === 'ExportNamedDeclaration' ? statement.declaration : statement;
    return declaration?.type === 'VariableDeclaration'
      ? declaration.declarations.filter((binding) => binding.id.type === 'Identifier' && binding.id.name === name)
      : [];
  });
  return bindings.length === 1 ? (bindings[0]?.init ?? undefined) : undefined;
};

const providerOwnerSources = (sourceMap: ReadonlyMap<string, string>, vertical: string, deploymentAppId: string) =>
  Effect.gen(function* providerOwnerSourcesEffect() {
    const manifest = sourceOrEmpty(sourceMap, `${vertical}/vertical.manifest.ts`);
    const registration = sourceOrEmpty(sourceMap, `${vertical}/vertical.registration.ts`);
    const moduleId = providerModuleId(manifest);
    const declaration = sourceMap.get(`${vertical}/vertical.runtime-declaration.ts`);
    if (declaration === undefined) {
      if ([manifest, registration].some((source) => /vertical\.runtime-declaration/u.test(source))) {
        return yield* fail(vertical, 'generated providers require their resolved same-owner runtime declaration');
      }
      return { manifest, moduleId, registration };
    }
    const prefix = toCamelCase(vertical.split('/')[1] ?? '');
    const sameHeader = [manifest, registration, declaration].every(
      (source) =>
        source.startsWith(`${MODULE_CONTRACT_GENERATOR_HEADER}\n`) &&
        [
          ['deployment-app-id', deploymentAppId],
          ['module-id', moduleId],
        ].every(([key, expected]) => {
          const markers = [...source.matchAll(new RegExp(`^// @ontos-${key} ([^\\s]+)$`, 'gmu'))];
          return markers.length === 1 && markers[0]?.[1] === expected && expected !== '';
        }),
    );
    const validDeclaration = yield* Effect.try({
      catch: () =>
        new ModuleEntrypointBoundaryError({
          message: `${vertical}: generated providers require their canonical same-owner runtime declaration`,
        }),
      try: () => sameHeader && validRuntimeDeclarationViews(declaration, manifest, registration, prefix, moduleId),
    });
    if (!validDeclaration) {
      return yield* fail(vertical, 'generated providers require their canonical same-owner runtime declaration');
    }
    const fullManifest = providerOwnerInitializer(manifest, `${prefix}Manifest`);
    const manifestArgument = fullManifest?.type === 'CallExpression' ? fullManifest.arguments[0] : undefined;
    const surface =
      manifestArgument?.type === 'SpreadElement'
        ? undefined
        : providerObjectProperty(manifestArgument, 'publicSurface');
    const backendSurface = providerObjectProperty(
      providerOwnerInitializer(declaration, `${prefix}RuntimeManifest`),
      'publicSurface',
    );
    const shell = providerObjectProperty(backendSurface, 'shellContributions');
    if (surface?.type !== 'ObjectExpression' || shell?.type !== 'ObjectExpression') {
      return yield* fail(
        vertical,
        'generated providers require their authored descriptor and shell contribution objects',
      );
    }
    // Inspect original owning expressions only: unused or displaced marker pairs cannot supply contributions.
    return {
      manifest: `${manifest.slice(surface.start, surface.end)}\n${declaration.slice(shell.start, shell.end)}`,
      moduleId,
      registration,
    };
  });

const validateGeneratedProviderClient = (
  sourceMap: ReadonlyMap<string, string>,
  file: string,
  deploymentAppId: string,
  discoveredProvider?: GeneratedProviderLocation,
) =>
  Effect.gen(function* validateGeneratedProviderClientEffect() {
    const provider = discoveredProvider ?? generatedProviderLocation(file, sourceOrEmpty(sourceMap, file));
    if (provider === undefined) {
      return;
    }
    const { kind, name, vertical } = provider;
    const kindDetails =
      kind === 'search'
        ? {
            apiSuffix: 'Search',
            contributionKind: 'search-provider',
            directory: 'search',
            endpointGroup: 'search',
          }
        : {
            apiSuffix: 'Report',
            contributionKind: 'report',
            directory: 'reports',
            endpointGroup: 'reports',
          };
    const generatedHeader = `// @generated by OntOS Codesmith Governed Contribution v1\n// @ontos-contribution-kind ${kindDetails.contributionKind}\n`;
    const contractPath = `${vertical}/shared/apis/${name}-${kind}.ts`;
    const contractSource = sourceOrEmpty(sourceMap, contractPath);
    const clientPath = `${vertical}/src/api/${name}-${kind}-client.ts`;
    const clientSource = sourceOrEmpty(sourceMap, clientPath);
    const providerPath = `${vertical}/src/${kindDetails.directory}/${name}.provider.ts`;
    const providerSource = sourceOrEmpty(sourceMap, providerPath);
    const serverPath = `${vertical}/api/${name}-${kind}-server.ts`;
    const serverSource = sourceOrEmpty(sourceMap, serverPath);
    const { manifest, moduleId, registration } = yield* providerOwnerSources(sourceMap, vertical, deploymentAppId);
    const gateway = sourceOrEmpty(sourceMap, `${vertical}/src/api/action-gateway.ts`);
    const type = toPascalCase(name);
    const camel = `${type.slice(0, 1).toLowerCase()}${type.slice(1)}`;
    const ownerApiValue = `${type}${kindDetails.apiSuffix}Api`;
    const endpointGroup = generatedApiGroup(contractSource, ownerApiValue) ?? '';
    const expectedGroups = new Set([kindDetails.endpointGroup, `${camel}${kindDetails.apiSuffix}`]);
    const providerChecks = {
      apiContract: hasGeneratedProviderApiContract(contractSource, ownerApiValue, moduleId, name, kind),
      authorization: hasMatchingGeneratedProviderAuthorization(providerSource, manifest, moduleId, name, kind),
      clientContract: hasGeneratedGovernedClientContract(clientSource, {
        authorizedOperation: `load${type}ClientWithAuthorization`,
        defaultApiPrefix: `/${deploymentAppId}-api`,
        endpointGroup,
        generatedHeader,
        invocationKind: 'provider',
        ownerApiValue,
        ownerContractImport: `../../shared/apis/${name}-${kind}.ts`,
        publicOperation: `load${type}Client`,
      }),
      clientHeader: hasGeneratedSourceHeader(clientSource, generatedHeader),
      contractHeader: hasGeneratedSourceHeader(contractSource, generatedHeader),
      endpointGroup: expectedGroups.has(endpointGroup),
      legalEntityScope: hasMatchingProviderLegalEntityScope(providerSource, manifest, moduleId, name, kind),
      manifest: hasGeneratedProviderManifest(manifest, moduleId, name, kind),
      operationGateway: hasGeneratedOperationGatewayContract(gateway, deploymentAppId),
      providerHeader: hasGeneratedSourceHeader(providerSource, generatedHeader),
      readContract: hasGeneratedProviderReadContract(providerSource, moduleId, name, kind),
      registration: hasGeneratedProviderRegistration(registration, name, kind),
      serverContract: hasGeneratedGovernedServerContract(
        serverSource,
        `${camel}ReadApiLive`,
        sourceOrEmpty(sourceMap, `${vertical}/shared/api.ts`),
        deploymentAppId,
      ),
      serverHeader: hasGeneratedSourceHeader(serverSource, generatedHeader),
    };
    const failedChecks = Object.entries(providerChecks)
      .filter(([, valid]) => !valid)
      .map(([checkName]) => checkName);
    if (failedChecks.length > 0) {
      yield* fail(
        file,
        `generated search and report clients require the shared client runtime, owner-local contract, operation gateway, authorization, and correlation metadata (failed: ${failedChecks.join(', ')})`,
      );
    }
  });

const validatePublishedProviderIdentities = (
  state: BoundaryCheckState,
  file: string,
  verticalPath: string | undefined,
) =>
  Effect.gen(function* validatePublishedProviderIdentitiesEffect() {
    if (
      verticalPath === undefined ||
      (file !== `${verticalPath}/vertical.manifest.ts` &&
        file !== `${verticalPath}/vertical.registration.ts` &&
        file !== `${verticalPath}/vertical.runtime-declaration.ts`)
    ) {
      return;
    }
    const deploymentAppId = state.owners.get(verticalPath) ?? file.split('/')[1] ?? '';
    const { manifest, moduleId, registration } = yield* providerOwnerSources(
      state.sourceMap,
      verticalPath,
      deploymentAppId,
    );
    if (!hasExactGeneratedProviderIdentityTopology(manifest, registration, moduleId)) {
      yield* fail(
        file,
        'generated search and report clients require the shared client runtime and exact manifest and registration identity topology',
      );
    }
    for (const provider of generatedProviderIdentities(manifest, registration, moduleId)) {
      yield* validateGeneratedProviderClient(state.sourceMap, file, deploymentAppId, {
        ...provider,
        vertical: verticalPath,
      });
    }
  });

const isGeneratedActionHttpContract = (
  sourceMap: ReadonlyMap<string, string>,
  file: string,
  source: string,
): boolean => {
  const contract = /^(?<vertical>verticals\/[a-z][a-z0-9-]*)\/shared\/apis\/(?<slug>[a-z][a-z0-9-]*)-action\.ts$/u.exec(
    file,
  );
  const vertical = contract?.groups?.vertical;
  const slug = contract?.groups?.slug;
  const moduleId =
    vertical === undefined ? undefined : providerModuleId(sourceOrEmpty(sourceMap, `${vertical}/vertical.manifest.ts`));
  return (
    slug !== undefined &&
    moduleId !== undefined &&
    source.startsWith(
      `// @generated by OntOS Codesmith Action HTTP v1\n// @ontos-action-http-owner ${moduleId}\n// @ontos-action-http-slug ${slug}\n`,
    )
  );
};

const isGeneratedDomainProblemSchema = (file: string, source: string): boolean =>
  /\/shared\/apis\/[a-z][a-z0-9-]*-domain-(?:conflict|policy|unavailable)-problem\.ts$/u.test(`/${file}`) &&
  /^import \{ make(?:Retryable)?ProblemDetailsSchema \} from '@app\/shared-contracts\/problem-details';$/mu.test(
    source,
  ) &&
  /^export const [A-Z][A-Za-z0-9]*Domain(?:Conflict|Policy|Unavailable)ProblemSchema = make(?:Retryable)?ProblemDetailsSchema\(/mu.test(
    source,
  );

const hasGeneratedGovernedContributionHeader = (source: string): boolean =>
  ['report', SEARCH_PROVIDER_KIND].some((kind) =>
    hasGeneratedSourceHeader(
      source,
      `// @generated by OntOS Codesmith Governed Contribution v1\n// @ontos-contribution-kind ${kind}\n`,
    ),
  );

const requiresGeneratedModuleApiSeam = (
  state: BoundaryCheckState,
  file: string,
  source: string,
  diagnostics: string[],
): boolean =>
  file.endsWith('/shared/api.ts') &&
  source.includes('HttpApiEndpoint') &&
  !isGeneratedInfrastructureReadinessApi(file, source) &&
  !hasCachedCompleteModuleApiSeam(state, file, state.owners.get(file.slice(0, -'/shared/api.ts'.length)), diagnostics);

const requiresModuleApiScaffold = (sourceMap: ReadonlyMap<string, string>, file: string, source: string): boolean =>
  /\/shared\/apis\/[^/]+\.ts$/u.test(`/${file}`) &&
  !hasGeneratedSourceHeader(source, MODULE_API_GENERATOR_HEADER) &&
  !hasGeneratedGovernedContributionHeader(source) &&
  !isGeneratedActionHttpContract(sourceMap, file, source) &&
  !isGeneratedDomainProblemSchema(file, source) &&
  !hasPublishedGeneratedContractShim(sourceMap, file, source);

const validateVerticalApiSource = (state: BoundaryCheckState, file: string, source: string) =>
  Effect.gen(function* validateVerticalApiSourceEffect() {
    const { sourceMap } = state;
    const diagnostics: string[] = [];
    if (requiresGeneratedModuleApiSeam(state, file, source, diagnostics)) {
      yield* fail(
        file,
        `module APIs require an approved Codesmith generator, structured api registration, trusted context, and server ModuleEntrypointGateway integration first (failed: ${diagnostics.join('; ')})`,
      );
    }
    if (requiresModuleApiScaffold(sourceMap, file, source)) {
      yield* fail(file, 'module APIs must be created with scaffold:module-api');
    }
  });

const validateVerticalSource = (
  state: BoundaryCheckState,
  file: string,
  source: string,
  importedModuleSpecifiers: readonly string[],
) =>
  Effect.gen(function* validateVerticalSourceEffect() {
    const { sourceMap } = state;
    if (!file.includes('/verticals/') && !file.startsWith('verticals/')) {
      return;
    }
    const verticalPath = /^verticals\/[^/]+/u.exec(file)?.[0];
    yield* validatePublishedProviderIdentities(state, file, verticalPath);
    yield* validateGeneratedProviderClient(
      sourceMap,
      file,
      (verticalPath === undefined ? undefined : state.owners.get(verticalPath)) ?? file.split('/')[1] ?? '',
    );
    yield* validateVerticalApiSource(state, file, source);
    yield* validateGovernedSource(file, source);
    const privateImport = importedModuleSpecifiers.some((specifier) =>
      /(?:verticals\/|@app\/).*\/(?:src|vertical\.registration|workers|search|reports|db)(?:\/|$)/u.test(specifier),
    );
    if (privateImport) {
      yield* fail(
        file,
        'cross-vertical private imports are forbidden; use a public descriptor/client and the Shell/Core gateway',
      );
    }
  });

const validatePrivateHandlerAccess = (file: string, source: string) =>
  Effect.gen(function* validatePrivateHandlerAccessEffect() {
    const unauthorizedActionHandler =
      callsIdentifier(source, 'getActionHandler') &&
      file !== 'packages/core-runtime/src/actions/runtime.ts' &&
      file !== 'packages/core-runtime/src/actions/definition.ts';
    const unauthorizedWorkerHandler =
      callsIdentifier(source, 'getOutboxWorkerHandler') &&
      file !== 'packages/core-runtime/src/outbox/runtime.ts' &&
      file !== 'packages/core-runtime/src/outbox/definition.ts';
    if (unauthorizedActionHandler || unauthorizedWorkerHandler) {
      yield* fail(
        file,
        'private handler accessors may only be called by their Core runtime after the module-state gate',
      );
    }
  });

const validatePackageExports = (file: string, source: string) =>
  Effect.gen(function* validatePackageExportsEffect() {
    if (file.startsWith('verticals/') && file.endsWith('package.json')) {
      const packageJson = yield* decodeVerticalPackageJson(source);
      const privateExport = Object.values(packageJson.exports ?? {}).some((target) =>
        /(?:vertical\.registration|\/src\/(?:handlers|workers|routes|search|reports|db))/u.test(target),
      );
      if (privateExport) {
        yield* fail(file, 'package exports must not publish private entrypoint implementations or registrations');
      }
    }
  });

const validateRegistrationSlots = (file: string, source: string) =>
  Effect.gen(function* validateRegistrationSlotsEffect() {
    if (file.endsWith('/vertical.registration.ts')) {
      for (const marker of [
        'generated-public-component-registrations',
        'generated-search-registrations',
        'generated-report-registrations',
      ]) {
        if (!source.includes(`<${marker}>`) || !source.includes(`</${marker}>`)) {
          yield* fail(
            file,
            `Vertical Runtime Registration is missing reserved ${marker} slots; extend Codesmith first`,
          );
        }
      }
    }
  });

const validateCoreExports = (file: string, source: string) =>
  Effect.gen(function* validateCoreExportsEffect() {
    if (file === 'packages/core-runtime/src/index.ts') {
      const forbiddenGateExports = new Set([
        'checkModuleEntrypoint',
        'makeModuleEntrypointGateway',
        'makeModuleStateGate',
        'makeModuleStateSnapshot',
        'prepareModuleStateSnapshot',
      ]);
      if (containsIdentifier(source, forbiddenGateExports)) {
        yield* fail(
          file,
          'Core may export only module-entrypoint descriptors, service/gateway contracts and live layers, and typed gate failures',
        );
      }
    }
  });

const federationRuntimeMetadata = '@module-federation/runtime/package.json';

// Package metadata is inert JSON. A concatenated/computed target is not that exact resource.
const hasOnlyExactFederationMetadataCalls = (source: string): boolean => {
  const tokens = tokenize(source);
  return tokens.every(
    (token, index) =>
      token.kind !== SyntaxKind.StringLiteral ||
      token.value !== federationRuntimeMetadata ||
      !isModuleSpecifierPosition(tokens, index) ||
      (tokenKindAt(tokens, index - 1) === SyntaxKind.OpenParenToken &&
        tokenKindAt(tokens, index + 1) === SyntaxKind.CloseParenToken),
  );
};

const validateGeneralSource = (file: string, source: string, importedModuleSpecifiers: readonly string[]) =>
  Effect.gen(function* validateGeneralSourceEffect() {
    const importsFederationRuntime = importedModuleSpecifiers.some(
      (specifier) =>
        (specifier !== federationRuntimeMetadata || !hasOnlyExactFederationMetadataCalls(source)) &&
        /^@module-federation\/(?:runtime(?:-core|-tools)?|enhanced\/runtime|modern-js-v3\/runtime|bridge-react)(?:\/|$)/u.test(
          specifier,
        ),
    );
    const loadsRemote = ['loadRemote', 'preloadRemote', 'registerRemotes'].some((operation) =>
      callsIdentifier(source, operation),
    );
    if (!APPROVED_REMOTE_EDGES.has(file) && (loadsRemote || importsFederationRuntime)) {
      yield* fail(
        file,
        'raw loadRemote(...) and native Federation runtime imports are forbidden outside the approved Shell module-entrypoint loader or resolved module page',
      );
    }
    if (importedModuleSpecifiers.some((specifier) => /\/(?:remote|exposes)\//u.test(specifier))) {
      yield* fail(file, 'eager remote implementation imports are forbidden; pass a lazy thunk to the gateway');
    }
    yield* validatePrivateHandlerAccess(file, source);
    yield* validatePackageExports(file, source);
    yield* validateRegistrationSlots(file, source);
    yield* validateCoreExports(file, source);
  });

const hasExplicitPrivateMetadata = (tokens: readonly SourceToken[], start: number, end: number): boolean => {
  const values = new Map<string, readonly (SyntaxKind | undefined)[]>();
  let depth = 0;
  for (let index = start; index <= end; index += 1) {
    const token = tokens[index];
    if (token?.kind === SyntaxKind.OpenBraceToken) {
      depth += 1;
    } else if (token?.kind === SyntaxKind.CloseBraceToken) {
      depth -= 1;
    } else if (depth === 1) {
      if (token?.kind === SyntaxKind.DotDotDotToken || token?.kind === SyntaxKind.OpenBracketToken) {
        return false;
      }
      if (
        (token?.kind === SyntaxKind.Identifier || token?.kind === SyntaxKind.PublicKeyword) &&
        (token.value === 'public' || token.value === 'indexable') &&
        tokenKindAt(tokens, index + 1) === SyntaxKind.ColonToken
      ) {
        values.set(token.value, [...(values.get(token.value) ?? []), tokenKindAt(tokens, index + 2)]);
      }
    }
  }
  return ['public', 'indexable'].every((property) => {
    const kinds = values.get(property) ?? [];
    const [kind] = kinds;
    return kinds.length === 1 && kind === SyntaxKind.FalseKeyword;
  });
};

const validateCanonicalModuleRoute = (state: BoundaryCheckState) =>
  Effect.gen(function* validateCanonicalModuleRouteEffect() {
    // A deployment configuration identifies a complete Shell application. Contract-only
    // fixtures can validate descriptors without pretending to implement browser routing.
    if (!state.sourceMap.has('apps/shell-super-app/modern.config.ts') && !state.sourceMap.has(CANONICAL_MODULE_ROUTE)) {
      return;
    }
    const source = yield* requireDefined(
      state.sourceMap.get(CANONICAL_MODULE_ROUTE),
      CANONICAL_MODULE_ROUTE,
      'the Shell must declare its generic governed canonical module route',
    );
    const tokens = tokenize(source);
    const routeMetaIndex = tokens.findIndex(
      (token, index) =>
        token.kind === SyntaxKind.Identifier &&
        token.value === 'routeMeta' &&
        tokenKindAt(tokens, index + 1) === SyntaxKind.EqualsToken,
    );
    // The carrier is authored either as a bare literal or wrapped in `defineRouteMeta(...)` (O62, §4.3).
    const wrappedRouteMeta =
      tokens[routeMetaIndex + 2]?.kind === SyntaxKind.Identifier &&
      tokens[routeMetaIndex + 2]?.value === 'defineRouteMeta' &&
      tokenKindAt(tokens, routeMetaIndex + 3) === SyntaxKind.OpenParenToken;
    const carrierOffset = wrappedRouteMeta ? 4 : 2;
    const openBraceIndex =
      routeMetaIndex === -1 || tokenKindAt(tokens, routeMetaIndex + carrierOffset) !== SyntaxKind.OpenBraceToken
        ? -1
        : routeMetaIndex + carrierOffset;
    const declarationIndex = routeMetaIndex;
    const properties = readObjectStringProperties(tokens, openBraceIndex);
    if (
      declarationIndex === -1 ||
      openBraceIndex === -1 ||
      properties.values.get('canonicalPath') !== '/*' ||
      !hasExplicitPrivateMetadata(tokens, openBraceIndex, properties.closeBraceIndex)
    ) {
      yield* fail(
        CANONICAL_MODULE_ROUTE,
        'the generic canonical module route must declare /* and explicit private, non-indexable metadata without overrides',
      );
    }
    const [entrypoint] = readEntrypoints(source);
    if (
      entrypoint?.scope !== 'System' ||
      !authorizationEquals(entrypoint.authorization, { kind: 'authenticated_principal' })
    ) {
      yield* fail(
        CANONICAL_MODULE_ROUTE,
        'the generic canonical module route must retain the Shell authentication gate before owner resolution',
      );
    }
    for (const file of [
      'apps/shell-super-app/src/routes/[lang]/$.tsx',
      'apps/shell-super-app/src/routes/[lang]/$.data.ts',
      'apps/shell-super-app/src/routes/[lang]/$.data.client.ts',
    ]) {
      if (!state.sourceMap.has(file)) {
        yield* fail(file, 'the Shell must provide its generic canonical module route and loader');
      }
    }
  });

const isInventoryDescriptorSource = (file: string): boolean =>
  file.endsWith(ACTION_EXTENSION) ||
  (file.endsWith('.worker.ts') && file.includes('/src/workers/')) ||
  file.endsWith('/route.meta.ts') ||
  (file.endsWith('.read.ts') && file.includes('/src/api/')) ||
  file === 'apps/shell-super-app/api/modules/shell-governed-reads.ts' ||
  file === 'packages/core-runtime/src/auth/principal-administration-reads.ts';

const appendInventoryEntries = (state: BoundaryCheckState, file: string, source: string) =>
  Effect.gen(function* appendInventoryEntriesEffect() {
    if (!isInventoryDescriptorSource(file)) {
      return;
    }
    const deployment =
      [...state.owners.entries()].find(([appPath]) => file.startsWith(`${appPath}/`))?.[1] ?? 'shell-super-app';
    const entrypoints = file.endsWith(ACTION_EXTENSION)
      ? readActionEntrypoints(state.sourceMap, file, source)
      : readEntrypoints(source);
    for (const entrypoint of entrypoints) {
      const descriptorMessage = 'every runtime entrypoint must declare exactly one valid authorization';
      const authorization = yield* requireDefined(entrypoint.authorization, file, descriptorMessage);
      const entrypointKey = yield* requireDefined(entrypoint.entrypointKey, file, descriptorMessage);
      const owner = yield* requireDefined(entrypoint.moduleKey, file, descriptorMessage);
      const role = yield* requireDefined(entrypoint.role, file, descriptorMessage);
      state.inventoryEntries.push({
        authorization,
        deployment,
        entrypointKey,
        owner,
        surface: inventorySurface(role),
      });
    }
  });

const appendBusinessPermissionInventoryEntry = (state: BoundaryCheckState, file: string, source: string) =>
  Effect.gen(function* appendBusinessPermissionInventoryEntryEffect() {
    if (!source.startsWith(`${BUSINESS_PERMISSION_HEADER}\n`)) {
      return;
    }
    const owner = /^\/\/ @ontos-permission-owner (?<owner>.+)$/mu.exec(source)?.groups?.owner;
    const key = /^\/\/ @ontos-permission-code (?<key>.+)$/mu.exec(source)?.groups?.key;
    state.businessPermissionEntries.push({
      key: yield* requireDefined(key, file, 'regenerate this business permission with scaffold:permission'),
      owner: yield* requireDefined(owner, file, 'regenerate this business permission with scaffold:permission'),
    });
  });

const validateProductionSource = (state: BoundaryCheckState, file: string, source: string) =>
  Effect.gen(function* validateProductionSourceEffect() {
    if (file.endsWith(ACTION_EXTENSION)) {
      yield* requireGeneratedActionEntrypoint(state.sourceMap, file, source);
    }
    if (file.endsWith('.worker.ts') && file.includes('/src/workers/')) {
      yield* requireGeneratedWorkerEntrypoint(file, source);
    }
    yield* validateRouteSource(state, file, source);
    const importedModuleSpecifiers = readImportedModuleSpecifiers(source);
    if (SOURCE_EXTENSIONS.has(nodePath.extname(file))) {
      yield* validateResolvedOwnerImports(state, file, source);
    }
    yield* validateVerticalSource(state, file, source, importedModuleSpecifiers);
    yield* validateGeneralSource(file, source, importedModuleSpecifiers);
    yield* appendInventoryEntries(state, file, source);
    yield* appendBusinessPermissionInventoryEntry(state, file, source);
  });

const collectRouteSourceFiles = (state: BoundaryCheckState) =>
  Effect.gen(function* collectRouteSourceFilesEffect() {
    const seenEntrypointKeys = new Set<string>();
    const routeSourceFilesByDeployment = new Map<string, Set<string>>();
    for (const route of state.routeEntrypoints) {
      if (seenEntrypointKeys.has(`${route.deployment}:${route.entrypointKey}`)) {
        yield* fail(route.file, `route entrypoint ${route.entrypointKey} is duplicated`);
      }
      seenEntrypointKeys.add(`${route.deployment}:${route.entrypointKey}`);
      const sourceFiles = routeSourceFilesByDeployment.get(route.deployment) ?? new Set<string>();
      sourceFiles.add(route.file);
      routeSourceFilesByDeployment.set(route.deployment, sourceFiles);
    }
    return routeSourceFilesByDeployment;
  });

// The framework manifest statically imports every route.meta.ts below its directory, so it is
// current exactly when its relative imports name the deployment's route metadata files.
const validateManifestImports = (
  path: Path.Path,
  state: BoundaryCheckState,
  normalizedFile: string,
  sourceFiles: ReadonlySet<string>,
) =>
  Effect.gen(function* validateManifestImportsEffect() {
    const manifestDirectory = path.dirname(normalizedFile);
    const manifestImports = new Set(
      readImportedModuleSpecifiers(sourceOrEmpty(state.sourceMap, normalizedFile))
        .filter((specifier) => specifier.startsWith('./'))
        .map((specifier) => {
          const importedFile = path.join(manifestDirectory, specifier).replaceAll('\\', '/');
          return importedFile.endsWith('.ts') ? importedFile : `${importedFile}.ts`;
        }),
    );
    const missing = [...sourceFiles].filter((file) => !manifestImports.has(file));
    const stale = [...manifestImports].filter((file) => !sourceFiles.has(file));
    if (missing.length > 0 || stale.length > 0) {
      const missingLabel = missing.length === 0 ? 'none' : sortStrings(missing).join(', ');
      const staleLabel = stale.length === 0 ? 'none' : sortStrings(stale).join(', ');
      yield* fail(
        normalizedFile,
        `generated route manifest is stale (missing: ${missingLabel}; orphaned: ${staleLabel}); rerun ultramodern-create ultramodern routes-generate`,
      );
    }
  });

const validateRouteManifests = (path: Path.Path, files: readonly string[], root: string, state: BoundaryCheckState) =>
  Effect.gen(function* validateRouteManifestsEffect() {
    const routeSourceFilesByDeployment = yield* collectRouteSourceFiles(state);
    const routeManifests = files.filter((file) => file.endsWith('/ultramodern-route-metadata.ts'));
    const seenManifestDeployments = new Set<string>();
    for (const manifestFile of routeManifests) {
      const normalizedFile = relative(path, root, manifestFile);
      const ownerEntry = [...state.owners.entries()].find(([appPath]) => normalizedFile.startsWith(`${appPath}/`));
      const [, deployment] = yield* requireDefined(
        ownerEntry,
        normalizedFile,
        'generated route manifest owner is absent from topology',
      );
      if (seenManifestDeployments.has(deployment)) {
        yield* fail(normalizedFile, `deployment ${deployment} has multiple generated route manifests`);
      }
      seenManifestDeployments.add(deployment);
      yield* validateManifestImports(
        path,
        state,
        normalizedFile,
        routeSourceFilesByDeployment.get(deployment) ?? new Set<string>(),
      );
    }
    for (const deployment of routeSourceFilesByDeployment.keys()) {
      if (!seenManifestDeployments.has(deployment)) {
        yield* fail('generated route manifests', `deployment ${deployment} is missing its route manifest`);
      }
    }
  });

interface GatewayIssuerBinding {
  readonly credential: 'session' | 'api_key';
  readonly handler: string;
  readonly path: string;
}

// These are the existing Shell issuer contracts, including the module delegation
// authenticated by an API key. Credential kind alone cannot select a handler.
const gatewayIssuerBinding = (entrypointKey: string): GatewayIssuerBinding | null =>
  Match.value(entrypointKey).pipe(
    Match.when('shell.gateway-context.issue.session', (): GatewayIssuerBinding => ({
      credential: 'session',
      handler: 'issueGatewayContext',
      path: shellGatewayContextContract.issueGatewayContextPath,
    })),
    Match.when('shell.gateway-context.issue.api-key', (): GatewayIssuerBinding => ({
      credential: 'api_key',
      handler: 'issueApiKeyGatewayContext',
      path: shellGatewayContextContract.issueApiKeyGatewayContextPath,
    })),
    Match.when('shell.gateway-context.issue.delegated', (): GatewayIssuerBinding => ({
      credential: 'api_key',
      handler: 'issueDelegatedGatewayContext',
      path: shellGatewayContextContract.issueDelegatedGatewayContextPath,
    })),
    Match.orElse(() => null),
  );

type GatewayIssuerEntrypoint = Pick<
  ProtectedEntrypointInventoryEntry,
  'authorization' | 'deployment' | 'entrypointKey' | 'owner' | 'surface'
> & { readonly path: string };

export const validateGatewayIssuerEntrypoints = (issuers: readonly GatewayIssuerEntrypoint[]) =>
  Effect.gen(function* validateGatewayIssuerEntrypointsEffect() {
    const seen = new Set<string>();
    const exactIssuers = issuers.every((issuer) => {
      const binding = gatewayIssuerBinding(issuer.entrypointKey);
      if (binding === null || seen.has(issuer.entrypointKey)) {
        return false;
      }
      seen.add(issuer.entrypointKey);
      return (
        issuer.authorization.kind === 'capability_issuance' &&
        issuer.authorization.credential === binding.credential &&
        issuer.path === binding.path &&
        issuer.owner === shellGatewayContextContract.ownerId &&
        issuer.deployment === shellGatewayContextContract.ownerId &&
        issuer.surface === 'capability_issuance'
      );
    });
    if (issuers.length !== 3 || !exactIssuers) {
      yield* fail(
        'packages/shared-contracts/src/gateway-context.ts',
        'gateway authorization contract must classify exactly the session, direct API-key, and module delegation issuers',
      );
    }
  });

const hasIssuerHandler = (source: string, name: string): boolean => {
  const argumentsPattern = new RegExp(`^\\s*(['"])${name}\\1\\s*,`, 'u');
  for (const call of maskNonCode(source).matchAll(/\.handle\s*\(/gu)) {
    if (argumentsPattern.test(source.slice(call.index + call[0].length))) {
      return true;
    }
  }
  return false;
};

const validateGatewayRuntime = (shellApiContract: string, shellApiRuntime: string) =>
  Effect.gen(function* validateGatewayRuntimeEffect() {
    const allHandlersMounted = gatewayContextAuthorizationEntrypoints.every((issuer) => {
      const binding = gatewayIssuerBinding(issuer.entrypointKey);
      return binding !== null && binding.path === issuer.path && hasIssuerHandler(shellApiRuntime, binding.handler);
    });
    if (!shellApiContract.includes('.add(GatewayContextApiGroup)') || !allHandlersMounted) {
      yield* fail(
        'apps/shell-super-app/api/index.ts',
        'all three classified capability issuers must be mounted by the Shell API runtime',
      );
    }
  });

const gatewayDeclaration = (source: string, name: string): string => {
  const structure = maskNonCode(source);
  const declaration = new RegExp(`export\\s+const\\s+${name}\\s*=`, 'u').exec(structure);
  if (declaration === null) {
    return '';
  }
  const start = declaration.index + declaration[0].length;
  const end = topLevelSeparators(structure, ';', start)[0] ?? source.length;
  return maskNonCode(source.slice(start, end), true).trim();
};

const hasMountedIssuerPath = (
  source: string,
  gatewaySource: string,
  issuer: (typeof gatewayContextAuthorizationEntrypoints)[number],
): boolean => {
  const binding = gatewayIssuerBinding(issuer.entrypointKey);
  if (binding === null || binding.path !== issuer.path) {
    return false;
  }
  const name = binding.handler;
  const endpointPath = issuer.path.slice(shellGatewayContextContract.apiPrefix.length);
  const group = gatewayDeclaration(gatewaySource, 'GatewayContextApiGroup');
  const shellApi = gatewayDeclaration(source, 'ShellAuthenticationApi');
  return (
    maskNonCode(source, true).includes("import { GatewayContextApiGroup } from '@app/shared-contracts'") &&
    shellApi.startsWith('HttpApi.make(') &&
    /\.add\(\s*GatewayContextApiGroup\s*\)/u.test(shellApi) &&
    group.startsWith("HttpApiGroup.make('gatewayContext')") &&
    new RegExp(`\\.add\\(\\s*HttpApiEndpoint\\.post\\(\\s*'${name}'\\s*,\\s*'${endpointPath}'\\s*,`, 'u').test(group)
  );
};

const validateGatewayContract = (state: BoundaryCheckState) =>
  Effect.gen(function* validateGatewayContractEffect() {
    const gatewayContract = sourceOrEmpty(state.sourceMap, 'packages/shared-contracts/src/gateway-context.ts');
    const shellApiContract = sourceOrEmpty(state.sourceMap, 'apps/shell-super-app/shared/api.ts');
    const shellApiRuntime = sourceOrEmpty(state.sourceMap, 'apps/shell-super-app/api/index.ts');
    yield* validateGatewayIssuerEntrypoints(gatewayContextAuthorizationEntrypoints);
    for (const issuer of gatewayContextAuthorizationEntrypoints) {
      if (
        !gatewayContract.includes(`'${issuer.path}'`) ||
        !hasMountedIssuerPath(shellApiContract, gatewayContract, issuer)
      ) {
        yield* fail(
          'apps/shell-super-app/shared/api.ts',
          `capability issuer ${issuer.path} is missing from the mounted gateway contract`,
        );
      }
      state.inventoryEntries.push(issuer);
    }
    yield* validateGatewayRuntime(shellApiContract, shellApiRuntime);
  });

const checkModuleEntrypointBoundariesEffect = (workspaceRoot: string) =>
  Effect.gen(function* checkModuleEntrypointBoundariesProgram() {
    const fileSystem = yield* FileSystem.FileSystem;
    const path = yield* Path.Path;
    // The native module graph resolves real paths, so ownership must use the same workspace root.
    const root = yield* fileSystem.realPath(workspaceRoot);
    const owners = yield* readTopologyOwners(root);
    const files = [
      ...(yield* walk(path.join(root, 'apps'))),
      ...(yield* walk(path.join(root, 'verticals'))),
      ...(yield* walk(path.join(root, 'packages'))),
    ];
    const sourcePairs: (readonly [string, string])[] = [];
    for (const file of files) {
      const source = yield* fileSystem.readFileString(file, 'utf-8');
      sourcePairs.push([relative(path, root, file), source]);
    }
    const sourceMap = new Map(sourcePairs);
    const canonicalPaths = new Map<string, string>();
    const ownershipPackages = new Map<string, OwnershipPackage>();
    for (const [file, source] of sourcePairs) {
      const canonical = yield* fileSystem.realPath(path.join(root, file));
      canonicalPaths.set(file, path.relative(root, canonical).split(path.sep).join('/'));
      if (file.endsWith('/package.json')) {
        ownershipPackages.set(nodePath.posix.dirname(file), {
          directory: nodePath.posix.dirname(file),
          metadata: yield* decodeOwnershipPackage(source),
        });
      }
    }
    const state: BoundaryCheckState = {
      businessPermissionEntries: [],
      canonicalPaths,
      completeModuleApiSeams: new Map(),
      graph: createModuleGraph(),
      inventoryEntries: [],
      owners,
      ownershipPackages,
      root,
      routeEntrypoints: [],
      sourceMap,
    };
    for (const [file, source] of sourcePairs) {
      const supportedFile = SOURCE_EXTENSIONS.has(path.extname(file)) || file.endsWith('package.json');
      const productionFile = !file.includes('/tests/') && !file.includes('/fixtures/');
      if (supportedFile && productionFile) {
        yield* validateProductionSource(state, file, source);
      }
    }
    yield* validateCanonicalModuleRoute(state);
    yield* validateRouteManifests(path, files, root, state);
    yield* validateGatewayContract(state);
    const sourceRevision = yield* readSourceRevision(root).pipe(
      Effect.flatMap(Schema.decodeUnknownEffect(SourceRevisionSchema)),
      Effect.mapError(
        () =>
          new ModuleEntrypointBoundaryError({
            message: 'protected entrypoint inventory: sourceRevision must be a stable revision identifier',
          }),
      ),
    );
    const businessPermissions = normalizeBusinessPermissionInventory(state.businessPermissionEntries);
    const entries = normalizeProtectedEntrypointInventory(state.inventoryEntries);
    const inventory = {
      businessPermissions,
      entries,
      inventoryHash: hashProtectedEntrypointInventory(entries, businessPermissions),
      schemaVersion: PROTECTED_ENTRYPOINT_INVENTORY_SCHEMA_VERSION,
      sourceRevision,
    };
    const reportDirectory = path.join(root, '.codex/reports/authorization');
    yield* fileSystem.makeDirectory(reportDirectory, { recursive: true });
    yield* fileSystem.writeFileString(
      path.join(reportDirectory, 'protected-entrypoints.json'),
      serializeProtectedEntrypointInventory(inventory),
    );
  });

export const checkModuleEntrypointBoundaries = checkModuleEntrypointBoundariesEffect;

const [, invokedPath] = process.argv;
if (invokedPath !== undefined && invokedPath === import.meta.filename) {
  const main = Effect.gen(function* moduleEntrypointBoundaryMain() {
    const path = yield* Path.Path;
    const root = yield* Config.String('ULTRAMODERN_WORKSPACE_ROOT').pipe(
      Config.withDefault(path.resolve(import.meta.dirname, '..')),
    );
    yield* checkModuleEntrypointBoundariesEffect(root);
    yield* Console.log('Module entrypoint boundaries are valid.');
  });
  const runnable = Effect.scoped(Layer.build(Layer.effectDiscard(main).pipe(Layer.provide(NodeServices.layer)))).pipe(
    Effect.asVoid,
  );
  NodeRuntime.runMain(runnable);
}
