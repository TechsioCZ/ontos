#!/usr/bin/env node
import { readFile, readdir } from 'node:fs/promises';
import path from 'node:path';
import { LanguageVariant, SyntaxKind, createScanner } from '@typescript/native/unstable/ast';
import { hasCompleteGeneratedModuleApiSeam } from './generated-module-api-boundary.mts';

const SOURCE_EXTENSIONS = new Set(['.js', '.jsx', '.mjs', '.mts', '.ts', '.tsx']);
const ACTION_HEADER = '// @generated by OntOS Codesmith Action v1';
const WORKER_HEADER = '// @generated by OntOS Codesmith Outbox Worker v1';
const APPROVED_REMOTE_LOADER = 'apps/shell-super-app/src/routes/module-entrypoint-loader.ts';

const isGeneratedInfrastructureReadinessApi = (file: string, source: string): boolean => {
  const stem = file.split('/').at(-3);
  if (stem === undefined) return false;
  const endpoints = [
    ...source.matchAll(/HttpApiEndpoint\.(get|post)\(\s*'([^']+)'\s*,\s*'([^']+)'/gu),
  ].map((match) => `${match[1]}:${match[2]}:${match[3]}`);
  return (
    endpoints.length === 1 &&
    endpoints[0] === `get:readiness:/${stem}/readiness` &&
    source.includes(`export const ${stem}ApiContract = {`)
  );
};

const walk = async (directory: string): Promise<string[]> => {
  const files: string[] = [];
  let entries;
  try {
    entries = await readdir(directory, { withFileTypes: true });
  } catch (error) {
    if ((error as NodeJS.ErrnoException).code === 'ENOENT') {
      return [];
    }
    throw error;
  }
  const discovered = await Promise.all(
    entries.map((entry) => {
      if (
        entry.name === 'node_modules' ||
        entry.name.startsWith('dist') ||
        entry.name === '.output'
      ) {
        return [];
      }
      const entryPath = path.join(directory, entry.name);
      return entry.isDirectory() ? walk(entryPath) : [entryPath];
    }),
  );
  files.push(...discovered.flat());
  return files.toSorted();
};

const relative = (root: string, file: string): string =>
  path.relative(root, file).replaceAll('\\', '/');
const fail = (file: string, message: string): never => {
  throw new Error(`${file}: ${message}`);
};

interface ParsedEntrypoint {
  readonly access?: string;
  readonly constructor: 'System' | 'Tenant';
  readonly entrypointKey?: string;
  readonly moduleKey?: string;
  readonly role?: string;
}

interface SourceToken {
  readonly kind: SyntaxKind;
  readonly value: string;
}

const tokenize = (source: string): readonly SourceToken[] => {
  const scanner = createScanner(true, LanguageVariant.Standard, source);
  const tokens: SourceToken[] = [];
  const templateExpressionBraceDepths: number[] = [];
  for (let kind = scanner.scan(); kind !== SyntaxKind.EndOfFile; kind = scanner.scan()) {
    const templateDepthIndex = templateExpressionBraceDepths.length - 1;
    if (kind === SyntaxKind.TemplateHead) {
      templateExpressionBraceDepths.push(0);
    } else if (kind === SyntaxKind.OpenBraceToken && templateDepthIndex >= 0) {
      templateExpressionBraceDepths[templateDepthIndex] =
        (templateExpressionBraceDepths[templateDepthIndex] ?? 0) + 1;
    } else if (kind === SyntaxKind.CloseBraceToken && templateDepthIndex >= 0) {
      const braceDepth = templateExpressionBraceDepths[templateDepthIndex] ?? 0;
      if (braceDepth === 0) {
        kind = scanner.reScanTemplateToken();
        if (kind === SyntaxKind.TemplateTail) {
          templateExpressionBraceDepths.pop();
        }
      } else {
        templateExpressionBraceDepths[templateDepthIndex] = braceDepth - 1;
      }
    }
    tokens.push({ kind, value: scanner.getTokenValue() });
  }
  return tokens;
};

// eslint-disable-next-line complexity -- token parsing keeps descriptor fields comment-proof and dependency-free
const readEntrypoints = (source: string): readonly ParsedEntrypoint[] => {
  const tokens = tokenize(source);
  const entrypoints: ParsedEntrypoint[] = [];
  for (const [index, token] of tokens.entries()) {
    let constructor: ParsedEntrypoint['constructor'] | undefined;
    if (token.kind === SyntaxKind.Identifier && token.value === 'defineSystemModuleEntrypoint') {
      constructor = 'System';
    } else if (
      token.kind === SyntaxKind.Identifier &&
      token.value === 'defineTenantModuleEntrypoint'
    ) {
      constructor = 'Tenant';
    }
    if (
      constructor === undefined ||
      tokens[index + 1]?.kind !== SyntaxKind.OpenParenToken ||
      tokens[index + 2]?.kind !== SyntaxKind.OpenBraceToken
    ) {
      continue;
    }
    const properties = new Map<string, string>();
    let braceDepth = 0;
    for (let cursor = index + 2; cursor < tokens.length; cursor += 1) {
      const current = tokens[cursor];
      if (current?.kind === SyntaxKind.OpenBraceToken) {
        braceDepth += 1;
        continue;
      }
      if (current?.kind === SyntaxKind.CloseBraceToken) {
        braceDepth -= 1;
        if (braceDepth === 0) {
          break;
        }
        continue;
      }
      if (
        braceDepth === 1 &&
        current?.kind === SyntaxKind.Identifier &&
        tokens[cursor + 1]?.kind === SyntaxKind.ColonToken &&
        tokens[cursor + 2]?.kind === SyntaxKind.StringLiteral
      ) {
        properties.set(current.value, tokens[cursor + 2]?.value ?? '');
      }
    }
    const access = properties.get('access');
    const entrypointKey = properties.get('entrypointKey');
    const moduleKey = properties.get('moduleKey');
    const role = properties.get('role');
    entrypoints.push({
      constructor,
      ...(access === undefined ? {} : { access }),
      ...(entrypointKey === undefined ? {} : { entrypointKey }),
      ...(moduleKey === undefined ? {} : { moduleKey }),
      ...(role === undefined ? {} : { role }),
    });
  }
  return entrypoints;
};

const readStringProperties = (source: string, propertyName: string): ReadonlySet<string> => {
  const tokens = tokenize(source);
  const values = new Set<string>();
  for (const [index, token] of tokens.entries()) {
    if (
      token.kind === SyntaxKind.Identifier &&
      token.value === propertyName &&
      tokens[index + 1]?.kind === SyntaxKind.ColonToken &&
      tokens[index + 2]?.kind === SyntaxKind.StringLiteral
    ) {
      const value = tokens[index + 2]?.value;
      if (value !== undefined) {
        values.add(value);
      }
    }
  }
  return values;
};

const callsIdentifier = (source: string, identifier: string): boolean => {
  const tokens = tokenize(source);
  return tokens.some(
    (token, index) =>
      token.kind === SyntaxKind.Identifier &&
      token.value === identifier &&
      tokens[index + 1]?.kind === SyntaxKind.OpenParenToken,
  );
};

const containsIdentifier = (source: string, identifiers: ReadonlySet<string>): boolean =>
  tokenize(source).some(
    (token) => token.kind === SyntaxKind.Identifier && identifiers.has(token.value),
  );

const readImportedModuleSpecifiers = (source: string): readonly string[] => {
  const tokens = tokenize(source);
  const specifiers: string[] = [];
  for (const [index, token] of tokens.entries()) {
    if (token.kind !== SyntaxKind.StringLiteral) {
      continue;
    }
    const previous = tokens[index - 1];
    const previousPrevious = tokens[index - 2];
    if (
      previous?.kind === SyntaxKind.FromKeyword ||
      previous?.kind === SyntaxKind.ImportKeyword ||
      (previous?.kind === SyntaxKind.OpenParenToken &&
        previousPrevious?.kind === SyntaxKind.ImportKeyword)
    ) {
      specifiers.push(token.value);
    }
  }
  return specifiers;
};

const requireExactEntrypoint = (
  file: string,
  source: string,
  expected: Required<ParsedEntrypoint>,
  remediation: string,
): ParsedEntrypoint => {
  const entrypoints = readEntrypoints(source);
  const [entrypoint] = entrypoints;
  if (
    entrypoints.length !== 1 ||
    entrypoint?.constructor !== expected.constructor ||
    entrypoint.access !== expected.access ||
    entrypoint.entrypointKey !== expected.entrypointKey ||
    entrypoint.moduleKey !== expected.moduleKey ||
    entrypoint.role !== expected.role
  ) {
    fail(file, remediation);
  }
  return entrypoint;
};

const requireGeneratedActionEntrypoint = (file: string, source: string): void => {
  if (!source.startsWith(`${ACTION_HEADER}\n`)) {
    fail(file, 'Actions must be created and maintained with scaffold:action');
  }
  const owner = /^\/\/ @ontos-action-owner (?<owner>.+)$/mu.exec(source)?.groups?.['owner'];
  const action = /^\/\/ @ontos-action-slug (?<action>.+)$/mu.exec(source)?.groups?.['action'];
  if (owner === undefined || action === undefined) {
    fail(
      file,
      'regenerate this Action with scaffold:action so it has its governed action/write entrypoint',
    );
  }
  requireExactEntrypoint(
    file,
    source,
    {
      access: 'write',
      constructor: owner.startsWith('core.') ? 'System' : 'Tenant',
      entrypointKey: `${owner}.${action}`,
      moduleKey: owner,
      role: 'action',
    },
    'regenerate this Action with scaffold:action so it has its governed action/write entrypoint',
  );
};

const requireGeneratedWorkerEntrypoint = (file: string, source: string): void => {
  if (!source.startsWith(`${WORKER_HEADER}\n`)) {
    fail(file, 'Outbox Workers must be created and maintained with scaffold:outbox-worker');
  }
  const owner = /^\/\/ @ontos-outbox-worker-owner (?<owner>.+)$/mu.exec(source)?.groups?.['owner'];
  const workerKey = /^\/\/ @ontos-outbox-worker-key (?<workerKey>.+)$/mu.exec(source)?.groups?.[
    'workerKey'
  ];
  if (owner === undefined || workerKey === undefined) {
    fail(
      file,
      'regenerate this Worker with scaffold:outbox-worker so it has its governed worker/background entrypoint',
    );
  }
  requireExactEntrypoint(
    file,
    source,
    {
      access: 'background',
      constructor: 'Tenant',
      entrypointKey: workerKey,
      moduleKey: owner,
      role: 'worker',
    },
    'regenerate this Worker with scaffold:outbox-worker so it has its governed worker/background entrypoint',
  );
};

const requireRouteEntrypoint = (
  file: string,
  source: string,
  moduleOwner: string,
  expectedScope: 'system' | 'tenant',
): string => {
  const entrypoints = readEntrypoints(source);
  const [entrypoint] = entrypoints;
  if (
    entrypoints.length !== 1 ||
    entrypoint?.constructor !== (expectedScope === 'system' ? 'System' : 'Tenant') ||
    entrypoint.role !== 'page' ||
    entrypoint.moduleKey !== moduleOwner ||
    !entrypoint.entrypointKey?.startsWith(`${moduleOwner}.page.`) ||
    (entrypoint.access !== 'read' && entrypoint.access !== 'historical_read')
  ) {
    fail(
      file,
      'regenerate this route with scaffold:microvertical-page and load it through the Shell module-entrypoint gateway',
    );
  }
  return entrypoint.entrypointKey;
};

const readTopologyOwners = async (root: string): Promise<Map<string, string>> => {
  const metadata = JSON.parse(
    await readFile(path.join(root, '.modernjs/ultramodern.json'), 'utf-8'),
  ) as {
    readonly topology?: {
      readonly apps?: readonly { readonly id: string; readonly path: string }[];
    };
  };
  return new Map(
    (metadata.topology?.apps ?? []).map((app) => [app.path.replaceAll('\\', '/'), app.id]),
  );
};

// eslint-disable-next-line complexity -- this is the single repository-wide entrypoint inventory pass
export const checkModuleEntrypointBoundaries = async (root: string): Promise<void> => {
  const owners = await readTopologyOwners(root);
  const files = [
    ...(await walk(path.join(root, 'apps'))),
    ...(await walk(path.join(root, 'verticals'))),
    ...(await walk(path.join(root, 'packages'))),
  ];
  const sources = await Promise.all(files.map((file) => readFile(file, 'utf-8')));
  const sourceMap = new Map(
    files.map((file, index) => [relative(root, file), sources[index] ?? ''] as const),
  );
  const routeEntrypointKeys: string[] = [];
  for (const [index, absoluteFile] of files.entries()) {
    const file = relative(root, absoluteFile);
    const extension = path.extname(file);
    if (!SOURCE_EXTENSIONS.has(extension) && !file.endsWith('package.json')) {
      continue;
    }
    const source = sources[index];
    if (source === undefined) {
      continue;
    }
    const productionFile = !file.includes('/tests/') && !file.includes('/fixtures/');
    if (!productionFile) {
      continue;
    }
    const importedModuleSpecifiers = readImportedModuleSpecifiers(source);

    if (file.endsWith('.action.ts')) {
      requireGeneratedActionEntrypoint(file, source);
    }
    if (file.endsWith('.worker.ts') && file.includes('/src/workers/')) {
      requireGeneratedWorkerEntrypoint(file, source);
    }

    if (file.endsWith('/route.meta.ts')) {
      const ownerEntry = [...owners.entries()].find(([appPath]) => file.startsWith(`${appPath}/`));
      if (ownerEntry === undefined) {
        fail(file, 'route owner is absent from the generated topology');
      }
      const [, owner] = ownerEntry;
      const ownerAppIds = readStringProperties(source, 'ownerAppId');
      if (ownerAppIds.size !== 1 || !ownerAppIds.has(owner)) {
        fail(file, 'route ownerAppId must match the generated topology deployment identity');
      }
      const expectedScope = owner.startsWith('shell-') ? 'system' : 'tenant';
      const moduleIds = readStringProperties(source, 'moduleId');
      let moduleOwner: string | undefined = owner;
      if (expectedScope === 'tenant') {
        moduleOwner = moduleIds.size === 1 ? [...moduleIds][0] : undefined;
      }
      if (moduleOwner === undefined) {
        fail(file, 'MicroVertical route metadata must declare exactly one manifest moduleId');
      }
      routeEntrypointKeys.push(requireRouteEntrypoint(file, source, moduleOwner, expectedScope));
    }

    if (file.includes('/verticals/') || file.startsWith('verticals/')) {
      if (
        file.endsWith('/shared/api.ts') &&
        source.includes('HttpApiEndpoint') &&
        !isGeneratedInfrastructureReadinessApi(file, source) &&
        !hasCompleteGeneratedModuleApiSeam(sourceMap, file)
      ) {
        fail(
          file,
          'module APIs require an approved Codesmith generator, structured api registration, trusted context, and server ModuleEntrypointGateway integration first',
        );
      }
      if (
        /\/shared\/apis\/[^/]+\.ts$/u.test(`/${file}`) &&
        !source.startsWith('// @generated by OntOS Codesmith module-api v1\n') &&
        !/^\/\/ @generated by OntOS Codesmith Governed Contribution v1\n\/\/ @ontos-contribution-kind (?:report|search-provider)\n/u.test(
          source,
        )
      ) {
        fail(file, 'module APIs must be created with scaffold:module-api');
      }
      const governedCategory = /\/src\/(?<category>components|search|reports)\//u.exec(`/${file}`)
        ?.groups?.['category'];
      const expectedHeader =
        governedCategory === 'components'
          ? '// @generated by OntOS Codesmith public-component v1\n'
          : governedCategory === 'search'
            ? '// @generated by OntOS Codesmith Governed Contribution v1\n// @ontos-contribution-kind search-provider\n'
            : governedCategory === 'reports'
              ? '// @generated by OntOS Codesmith Governed Contribution v1\n// @ontos-contribution-kind report\n'
              : undefined;
      if (/\/src\/public-components\//u.test(`/${file}`)) {
        fail(
          file,
          'public components, search, and reports require an approved Codesmith generator and reserved runtime registration first',
        );
      }
      if (expectedHeader !== undefined && !source.startsWith(expectedHeader)) {
        fail(
          file,
          'public components, search, and reports require an approved Codesmith generator and reserved runtime registration first',
        );
      }
      if (
        importedModuleSpecifiers.some((specifier) =>
          /(?:verticals\/|@app\/).*\/(?:src|vertical\.registration|workers|search|reports|db)(?:\/|$)/u.test(
            specifier,
          ),
        )
      ) {
        fail(
          file,
          'cross-vertical private imports are forbidden; use a public descriptor/client and the Shell/Core gateway',
        );
      }
    }

    if (callsIdentifier(source, 'loadRemote') && file !== APPROVED_REMOTE_LOADER) {
      fail(
        file,
        'raw loadRemote(...) is forbidden outside the approved Shell module-entrypoint loader',
      );
    }
    if (importedModuleSpecifiers.some((specifier) => /\/(?:remote|exposes)\//u.test(specifier))) {
      fail(
        file,
        'eager remote implementation imports are forbidden; pass a lazy thunk to the gateway',
      );
    }
    if (
      (callsIdentifier(source, 'getActionHandler') &&
        file !== 'packages/core-runtime/src/actions/runtime.ts' &&
        file !== 'packages/core-runtime/src/actions/definition.ts') ||
      (callsIdentifier(source, 'getOutboxWorkerHandler') &&
        file !== 'packages/core-runtime/src/outbox/runtime.ts' &&
        file !== 'packages/core-runtime/src/outbox/definition.ts')
    ) {
      fail(
        file,
        'private handler accessors may only be called by their Core runtime after the module-state gate',
      );
    }
    if (file.startsWith('verticals/') && file.endsWith('package.json')) {
      const packageJson = JSON.parse(source) as {
        readonly exports?: Readonly<Record<string, unknown>>;
      };
      const exportedTargets = Object.values(packageJson.exports ?? {}).filter(
        (target): target is string => typeof target === 'string',
      );
      if (
        exportedTargets.some((target) =>
          /(?:vertical\.registration|\/src\/(?:handlers|workers|routes|search|reports|db))/u.test(
            target,
          ),
        )
      ) {
        fail(
          file,
          'package exports must not publish private entrypoint implementations or registrations',
        );
      }
    }
    if (file.endsWith('/vertical.registration.ts')) {
      for (const marker of [
        'generated-public-component-registrations',
        'generated-search-registrations',
        'generated-report-registrations',
      ]) {
        if (!source.includes(`<${marker}>`) || !source.includes(`</${marker}>`)) {
          fail(
            file,
            `Vertical Runtime Registration is missing reserved ${marker} slots; extend Codesmith first`,
          );
        }
      }
    }
    if (file === 'packages/core-runtime/src/index.ts') {
      const forbiddenGateExports = new Set([
        'checkModuleEntrypoint',
        'makeModuleEntrypointGateway',
        'makeModuleStateGate',
        'makeModuleStateSnapshot',
        'prepareModuleStateSnapshot',
      ]);
      if (containsIdentifier(source, forbiddenGateExports)) {
        fail(
          file,
          'Core may export only module-entrypoint descriptors, service/gateway contracts and live layers, and typed gate failures',
        );
      }
    }
  }

  const routeManifests = files.filter((file) => file.endsWith('/ultramodern-route-metadata.ts'));
  const manifestSources = await Promise.all(routeManifests.map((file) => readFile(file, 'utf-8')));
  const manifestEntrypointKeys = new Set(
    manifestSources.flatMap((source) => [...readStringProperties(source, 'entrypointKey')]),
  );
  for (const entrypointKey of routeEntrypointKeys) {
    if (!manifestEntrypointKeys.has(entrypointKey)) {
      fail(
        'generated route manifests',
        `route entrypoint ${entrypointKey} is missing; rerun the route generator`,
      );
    }
  }
};

const invokedPath = process.argv[1] === undefined ? undefined : path.resolve(process.argv[1]);
if (invokedPath === import.meta.filename) {
  const root = process.env.ULTRAMODERN_WORKSPACE_ROOT ?? path.resolve(import.meta.dirname, '..');
  await checkModuleEntrypointBoundaries(root);
  process.stdout.write('Module entrypoint boundaries are valid.\n');
}
