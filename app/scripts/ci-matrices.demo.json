  "unit": [
    {
      "name": "Unit and Component Tests (Merchandise)",
      "commands": "pnpm -r --no-sort --if-present --filter ./verticals/merchandise run test:unit\npnpm -r --no-sort --if-present --filter ./verticals/merchandise run test:component\n"
    },
