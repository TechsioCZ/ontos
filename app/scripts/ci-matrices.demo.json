      "name": "Unit and Component Tests (every other package)",
      "fetch_depth": 512,
      "setup": "command -v xmllint >/dev/null 2>&1 || sudo apt-get install --yes --no-install-recommends libxml2-utils\nmise exec -- pnpm provision:pohoda-xsd\n",
