const scopedReadPhaseCall = (returned: string, context: string) => {
  const pipeline = outputPipeExpression(returned);
  const method = new RegExp(`^${escapeRegExp(context)}\\.services\\.(?<method>[A-Za-z_$][A-Za-z0-9_$]*)\\(`, 'u').exec(
