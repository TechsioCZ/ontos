const GovernedReadKindSchema = Schema.Literals([MODULE_API_KIND, REPORT_KIND, SEARCH_PROVIDER_KIND]);
type GovernedReadKind = typeof GovernedReadKindSchema.Type;
const isGovernedReadKind = Schema.is(GovernedReadKindSchema);

interface GovernedReadContribution {
  readonly contractStem: string;
  readonly kind: GovernedReadKind;
  readonly name: string;
}

const escapeRegExp = (value: string): string => value.replaceAll(/[.*+?^${}()|[\]\\]/gu, String.raw`\$&`);

const matches = (source: string | undefined, expression: RegExp): boolean =>
  source !== undefined && expression.test(source);

const hasExactlyOne = (source: string | undefined, expression: RegExp): boolean =>
  source !== undefined && [...source.matchAll(expression)].length === 1;

const matchingDelimiterEnd = (source: string, start: number, opening: string, closing: string): number | undefined =>
  matchingDelimiter(maskNonCode(source), start, opening, closing);

const maskComments = (source: string): string => maskNonCode(source, true);

const callArgument = (source: string | undefined, declaration: RegExp, argumentIndex = 0): string | undefined => {
  if (source === undefined) {
    return undefined;
  }
  const code = maskComments(source);
  const match = declaration.exec(code);
  if (match === null) {
    return undefined;
  }
  const callStart = code.indexOf('(', match.index);
  if (callStart === -1) {
    return undefined;
  }
  const structure = maskNonCode(source);
  const callEnd = matchingDelimiter(structure, callStart, '(', ')');
  if (callEnd === undefined) {
    return undefined;
  }
  return separatedSource(code, topLevelSeparators(structure, ',', callStart + 1, callEnd), callStart + 1, callEnd)[
    argumentIndex
  ];
};

const objectArgument = (source: string | undefined, declaration: RegExp, argumentIndex = 0): string | undefined => {
  const argument = callArgument(source, declaration, argumentIndex);
  if (argument === undefined) {
    return undefined;
  }
  if (!argument.startsWith('{')) {
    return undefined;
  }
  const end = matchingDelimiterEnd(argument, 0, '{', '}');
  return end === argument.length - 1 ? argument : undefined;
};

const topLevelObjectEntries = (source: string): readonly string[] | undefined => {
  if (!source.startsWith('{') || matchingDelimiterEnd(source, 0, '{', '}') !== source.length - 1) {
    return undefined;
  }
  const separators = topLevelSeparators(maskNonCode(source), ',', 1, source.length - 1);
  return separatedSource(source, separators, 1, source.length - 1).filter((entry) => entry !== '');
};

const topLevelArrayEntries = (source: string): readonly string[] | undefined => {
  if (!source.startsWith('[') || matchingDelimiterEnd(source, 0, '[', ']') !== source.length - 1) {
    return undefined;
  }
  const separators = topLevelSeparators(maskNonCode(source), ',', 1, source.length - 1);
  return separatedSource(source, separators, 1, source.length - 1).filter((entry) => entry !== '');
};

const objectProperty = (source: string, property: string): string | undefined => {
  const entries = topLevelObjectEntries(source);
  const prefix = new RegExp(`^${escapeRegExp(property)}:\\s*`, 'u');
  const candidates = entries?.filter((entry) => prefix.test(entry)) ?? [];
  return candidates.length === 1 ? candidates[0]?.replace(prefix, '').trim() : undefined;
};

const objectPropertyValue = (source: string, property: string): string | undefined => {
  const explicit = objectProperty(source, property);
  if (explicit !== undefined) {
    return explicit;
  }
  const shorthand = topLevelObjectEntries(source)?.filter((entry) => entry === property) ?? [];
  return shorthand.length === 1 ? property : undefined;
};

const isWholeCallExpression = (source: string, declaration: RegExp): boolean => {
  const match = declaration.exec(source);
  if (match?.index === undefined) {
    return false;
  }
  const opening = source.indexOf('(', match.index);
  const closing = matchingDelimiterEnd(source, opening, '(', ')');
  return opening !== -1 && closing === source.length - 1;
};

const wholeCallArguments = (
  source: string,
  declaration: RegExp,
  rejectArgumentHoles = false,
): readonly string[] | undefined => {
  const match = declaration.exec(source);
  if (match?.index === undefined || !isWholeCallExpression(source, declaration)) {
    return undefined;
  }
  const opening = source.indexOf('(', match.index);
  const closing = matchingDelimiterEnd(source, opening, '(', ')');
  if (opening === -1 || closing === undefined) {
    return undefined;
  }
  const argumentsList = separatedSource(
    source,
    topLevelSeparators(maskNonCode(source), ',', opening + 1, closing),
    opening + 1,
    closing,
  );
  const explicitArguments = argumentsList.at(-1) === '' ? argumentsList.slice(0, -1) : argumentsList;
  if (rejectArgumentHoles && explicitArguments.some((argument) => argument === '')) {
    return undefined;
  }
  return argumentsList.filter((argument) => argument !== '');
};

interface SourceDepthAnalysis {
  readonly code: string;
  readonly prefixDepths: Int32Array;
}

// Source strings are immutable cache keys. Bound retained analyses because scripts may validate
// many disposable owners in one process; repeated contributions reuse the same owner sources.
const sourceDepthAnalyses = new Map<string, SourceDepthAnalysis>();
const MAX_SOURCE_DEPTH_ANALYSES = 32;
const sourceDepthAnalysis = (source: string): SourceDepthAnalysis => {
  const cached = sourceDepthAnalyses.get(source);
  if (cached !== undefined) {
    return cached;
  }
  const code = maskNonCode(source);
  const prefixDepths = new Int32Array(code.length + 1);
  let depth = 0;
  for (let index = 0; index < code.length; index += 1) {
    const character = code.charAt(index);
    if ('{(['.includes(character)) {
      depth += 1;
    } else if ('})]'.includes(character)) {
      depth -= 1;
    }
    prefixDepths[index + 1] = depth;
  }
  if (sourceDepthAnalyses.size >= MAX_SOURCE_DEPTH_ANALYSES) {
    const oldest = sourceDepthAnalyses.keys().next().value;
    if (oldest !== undefined) {
      sourceDepthAnalyses.delete(oldest);
    }
  }
  const analysis = { code, prefixDepths };
  sourceDepthAnalyses.set(source, analysis);
  return analysis;
};

const codeDepthBeforePosition = (source: string, target: number): number =>
  sourceDepthAnalysis(source).prefixDepths[target] ?? 0;

const codeDepthAtPosition = (source: string, target: number): number | undefined =>
  isCodePosition(source, target) ? codeDepthBeforePosition(source, target) : undefined;

const isTopLevelCodePosition = (source: string, target: number): boolean => codeDepthAtPosition(source, target) === 0;

interface SourceRange {
  readonly end: number;
  readonly start: number;
  readonly value: string;
}

const assignedExpressionRange = (source: string, declaration: RegExp): SourceRange | undefined => {
  const code = maskComments(source);
  const structure = sourceDepthAnalysis(source).code;
  const flags = declaration.flags.includes('g') ? declaration.flags : `${declaration.flags}g`;
  const declarations = [...structure.matchAll(new RegExp(declaration.source, flags))].filter(
    (candidate) => candidate.index !== undefined && isTopLevelCodePosition(source, candidate.index),
  );
  if (declarations.length !== 1) {
    return undefined;
  }
  const [match] = declarations;
  if (match?.index === undefined) {
    return undefined;
  }
  const start = match.index + match[0].length;
  const [index] = topLevelSeparators(structure, ';', start);
  if (index === undefined) {
    return undefined;
  }
  const value = code.slice(start, index);
  const valueStart = start + value.length - value.trimStart().length;
  const valueEnd = start + value.trimEnd().length;
  return {
    end: valueEnd,
    start: valueStart,
    value: code.slice(valueStart, valueEnd),
  };
};

const assignedExpression = (source: string, declaration: RegExp): string | undefined =>
  assignedExpressionRange(source, declaration)?.value;

const constInitializer = (source: string, name: string): string | undefined => {
  const structure = maskNonCode(source);
  const declaration = new RegExp(`(?:export\\s+)?const\\s+${escapeRegExp(name)}\\b`, 'gu');
  const declarationMatches = [...structure.matchAll(declaration)].filter(
    (candidate) => candidate.index !== undefined && isTopLevelCodePosition(source, candidate.index),
  );
  const match = declarationMatches.length === 1 ? declarationMatches[0] : undefined;
  if (match?.index === undefined) {
    return undefined;
  }
  const searchStart = match.index + match[0].length;
  const equals = [...structure.slice(searchStart).matchAll(/[=](?![=>])/gu)]
    .map((candidate) => searchStart + (candidate.index ?? -1))
    .find((index) => index >= searchStart && isTopLevelCodePosition(source, index));
  if (equals === undefined) {
    return undefined;
  }
  const [end] = topLevelSeparators(structure, ';', equals + 1);
  return end === undefined ? undefined : source.slice(equals + 1, end).trim();
};

const isEffectFnCallback = (source: string): boolean => {
  if (!source.startsWith('Effect.fn(')) {
    return false;
  }
  const opening = source.indexOf('(');
  const closing = matchingDelimiterEnd(source, opening, '(', ')');
  const invocation = closing === undefined ? '' : source.slice(closing + 1).trim();
  const callback = invocation.startsWith('(') ? callArgument(`invoke${invocation}`, /^invoke\(/u) : undefined;
  return (
    callback !== undefined &&
    matchingDelimiterEnd(invocation, 0, '(', ')') === invocation.length - 1 &&
    (matches(callback, /^(?:async\s+)?function\*?(?:\s+[A-Za-z_$][A-Za-z0-9_$]*)?\s*\(/u) ||
      matches(callback, /^(?:async\s+)?(?:\([^)]*\)|[A-Za-z_$][A-Za-z0-9_$]*)\s*=>/u))
  );
};

const hasBalancedArrowCallback = (source: string): boolean => {
  const candidate = maskComments(source)
    .replace(/^async\s+/u, '')
    .trim();
  if (!candidate.startsWith('(')) {
    return /^[A-Za-z_$][A-Za-z0-9_$]*\s*=>/u.test(candidate);
  }
  const closing = matchingDelimiterEnd(candidate, 0, '(', ')');
  if (closing === undefined) {
    return false;
  }
  const suffix = candidate.slice(closing + 1).trim();
  if (suffix.startsWith('=>')) {
    return true;
  }
  const [arrow] = topLevelSeparators(maskNonCode(suffix), '=', 0, suffix.length, true);
  return suffix.startsWith(':') && arrow !== undefined && suffix.slice(arrow, arrow + 2) === '=>';
};

const isExecutableCallback = (candidate: string | undefined, ownerSource?: string): boolean => {
  if (candidate === undefined || /^(?:null|undefined)(?:\s+as\b[\s\S]*)?$/u.test(candidate)) {
    return false;
  }
  if (
    hasBalancedArrowCallback(candidate) ||
    isEffectFnCallback(candidate) ||
    matches(candidate, /^(?:async\s+)?function\*?(?:\s+[A-Za-z_$][A-Za-z0-9_$]*)?\s*\(/u)
  ) {
    return true;
  }
  if (ownerSource === undefined || !/^[A-Za-z_$][A-Za-z0-9_$]*$/u.test(candidate)) {
    return false;
  }
  const initializer = constInitializer(ownerSource, candidate);
  return initializer !== undefined && initializer !== candidate && isExecutableCallback(initializer);
};

const callbackReturnedExpression = (handlerSource: string): string | undefined => {
  const structure = maskNonCode(handlerSource);
  const arrow = structure.indexOf('=>');
  if (arrow === -1) {
    return undefined;
  }
  const body = handlerSource.slice(arrow + 2).trim();
  if (!body.startsWith('{')) {
    return body;
  }
  const bodyStructure = maskNonCode(body);
  const returns = [...bodyStructure.matchAll(/\breturn\s+/gu)].filter(
    (match) => match.index !== undefined && codeDepthBeforePosition(body, match.index) === 1,
  );
  const finalReturn = returns.at(-1);
  if (finalReturn?.index === undefined) {
    return undefined;
  }
  const returned = body.slice(finalReturn.index + finalReturn[0].length);
  const statementEnd = returned.indexOf(';');
  return (statementEnd === -1 ? returned : returned.slice(0, statementEnd)).trim();
};

const isReadHandlerCallback = (candidate: string | undefined, ownerSource: string): boolean => {
  if (!isExecutableCallback(candidate, ownerSource) || candidate === undefined) {
    return false;
  }
  const resolved = /^[A-Za-z_$][A-Za-z0-9_$]*$/u.test(candidate) ? constInitializer(ownerSource, candidate) : candidate;
  if (resolved === undefined) {
    return false;
  }
  if (isEffectFnCallback(resolved)) {
    return /\byield\*|\.pipe\(/u.test(maskNonCode(resolved, true));
  }
  const expression = callbackReturnedExpression(resolved);
  return /\bEffect\.[A-Za-z_$][A-Za-z0-9_$]*\s*\(|\.pipe\(/u.test(maskNonCode(expression ?? '', true));
};

interface GeneratedSlotRange {
  readonly bodyEnd: number;
  readonly bodyStart: number;
  readonly depth: number;
  readonly markerEnd: number;
  readonly markerStart: number;
}

const generatedSlotRange = (source: string, startMarker: string, endMarker: string): GeneratedSlotRange | undefined => {
  const markerStart = source.indexOf(startMarker);
  const markerEnd = source.indexOf(endMarker);
  const depth = markerStart === -1 ? undefined : codeDepthBeforePosition(source, markerStart);
  if (
    markerStart === -1 ||
    markerEnd <= markerStart ||
    depth === undefined ||
    !isCodePosition(source, markerStart) ||
    !isCodePosition(source, markerEnd) ||
    codeDepthBeforePosition(source, markerEnd) !== depth ||
    source.includes(startMarker, markerStart + startMarker.length) ||
    source.includes(endMarker, markerEnd + endMarker.length)
  ) {
    return undefined;
  }
  return {
    bodyEnd: markerEnd,
    bodyStart: markerStart + startMarker.length,
    depth,
    markerEnd,
    markerStart,
  };
};

const generatedSlotEntries = (
  source: string,
  startMarker: string,
  endMarker: string,
): readonly string[] | undefined => {
  const slot = generatedSlotRange(source, startMarker, endMarker);
  if (slot === undefined) {
    return undefined;
  }
  const structure = sourceDepthAnalysis(source).code;
  const entries: string[] = [];
  let start = slot.bodyStart;
  for (let index = slot.bodyStart; index < slot.bodyEnd; index += 1) {
    if (structure[index] === ',' && codeDepthBeforePosition(source, index) === slot.depth) {
      const entry = source.slice(start, index).trim();
      if (entry !== '') {
        entries.push(entry);
      }
      start = index + 1;
    }
  }
  const finalEntry = source.slice(start, slot.bodyEnd).trim();
  if (finalEntry !== '') {
    entries.push(finalEntry);
  }
  return entries;
};

const entriesAcrossSlots = (
  source: string,
  slots: readonly (readonly [string, string])[],
): readonly string[] | undefined => {
  const entries = slots.map(([start, end]) => generatedSlotEntries(source, start, end));
  return entries.some((candidate) => candidate === undefined)
    ? undefined
    : entries.flatMap((candidate) => candidate ?? []);
};

const objectEntryKey = (entry: string): string | undefined => {
  const match = /^(?:'(?<single>[^']+)'|"(?<double>[^"]+)"|(?<bare>[A-Za-z][A-Za-z0-9-]*))\s*:/u.exec(entry);
  return match?.groups?.single ?? match?.groups?.double ?? match?.groups?.bare;
};

const slotHasExactlyOneCodeMatch = (
  source: string,
  startMarker: string,
  endMarker: string,
  expression: RegExp,
  depthOffset: number | null = 0,
): boolean => {
  const slot = generatedSlotRange(source, startMarker, endMarker);
  if (slot === undefined) {
    return false;
  }
  const flags = expression.flags.includes('g') ? expression.flags : `${expression.flags}g`;
  return (
    [...source.slice(slot.bodyStart, slot.bodyEnd).matchAll(new RegExp(expression.source, flags))].filter(
      (candidate) => {
        if (candidate.index === undefined) {
          return false;
        }
        const depth = codeDepthAtPosition(source, slot.bodyStart + candidate.index);
        return depth !== undefined && (depthOffset === null || depth === slot.depth + depthOffset);
      },
    ).length === 1
  );
};

const slotIsInsideObjectProperty = (
  source: string,
  property: string,
  startMarker: string,
  endMarker: string,
): boolean => {
  const code = maskComments(source);
  const slot = generatedSlotRange(source, startMarker, endMarker);
  if (slot === undefined) {
    return false;
  }
  const propertyPattern = new RegExp(`\\b${escapeRegExp(property)}:\\s*\\{`, 'gu');
  const containers = [...code.matchAll(propertyPattern)].filter((match) => {
    const opening = code.indexOf('{', match.index);
    const closing = matchingDelimiterEnd(code, opening, '{', '}');
    return (
      match.index !== undefined &&
      codeDepthAtPosition(source, match.index) === slot.depth - 1 &&
      closing !== undefined &&
      opening < slot.markerStart &&
      closing > slot.markerEnd
    );
  });
  return containers.length === 1;
};

const defaultExportExpression = (source: string): string | undefined =>
  assignedExpression(source, /^\s*export default\s+/mu);

const returnedEffectBffDefinition = (source: string): string | undefined => {
  const returned = callbackReturnedExpression(source);
  const declaration = /^(?:defineEffectBff|assembleEffectBffRuntime)\(/u;
  if (returned === undefined || !isWholeCallExpression(returned, declaration)) {
    return undefined;
  }
  const structure = maskNonCode(source);
  const arrow = structure.indexOf('=>');
  const body = arrow === -1 ? undefined : source.slice(arrow + 2).trim();
  const returnedCalls = [...structure.matchAll(/\breturn\s+(?:defineEffectBff|assembleEffectBffRuntime)\(/gu)];
  if (body?.startsWith('{') === true && (returnedCalls.length !== 1 || returnedCalls[0]?.index === undefined)) {
    return undefined;
  }
  return objectArgument(returned, declaration);
};

const exportedRuntimeFactory = (source: string): SourceRange | undefined => {
  const exported = defaultExportExpression(source);
  if (exported === undefined || !/^[A-Za-z][A-Za-z0-9]*$/u.test(exported)) {
    return undefined;
  }
  const runtimeInitializer = constInitializer(source, exported);
  const factory = /^(?<factory>make[A-Za-z][A-Za-z0-9]*ApiRuntime)\(/u.exec(runtimeInitializer ?? '')?.groups?.factory;
  const factoryExpression =
    factory === undefined
      ? undefined
      : assignedExpressionRange(source, new RegExp(`export const ${escapeRegExp(factory)}\\s*=\\s*`, 'u'));
  return factoryExpression === undefined ||
    runtimeInitializer === undefined ||
    !isWholeCallExpression(runtimeInitializer, new RegExp(`^${escapeRegExp(factory ?? '')}\\(`, 'u'))
    ? undefined
    : factoryExpression;
};

const effectBffDefinition = (source: string): string | undefined => {
  const exported = defaultExportExpression(source);
  if (exported === undefined) {
    return undefined;
  }
  if (/^(?:defineEffectBff|assembleEffectBffRuntime)\(/u.test(exported)) {
    return isWholeCallExpression(exported, /^(?:defineEffectBff|assembleEffectBffRuntime)\(/u)
      ? objectArgument(exported, /^(?:defineEffectBff|assembleEffectBffRuntime)\(/u)
      : undefined;
  }
  if (!/^[A-Za-z][A-Za-z0-9]*$/u.test(exported)) {
    return undefined;
  }
  const factory = exportedRuntimeFactory(source);
  return factory === undefined ? undefined : returnedEffectBffDefinition(factory.value);
};

const hasExactValueImport = (
  source: string,
  value: string,
  modulePath: string,
  allowAdditionalImports = false,
): boolean => {
  const code = maskComments(source);
  const imports = [
    ...source.matchAll(
      new RegExp(
        `^\\s*import\\s*\\{(?<values>[^}]*)\\}\\s*from\\s*(?<quote>['"])${escapeRegExp(modulePath)}\\k<quote>;`,
        'gmu',
      ),
    ),
  ].filter((candidate) => candidate.index !== undefined && isTopLevelCodePosition(source, candidate.index));
  const importedValues = imports.flatMap((candidate) =>
    (candidate.groups?.values ?? '').split(',').map((entry) => entry.trim()),
  );
  const importedBinding = /\bas\s+(?<binding>[A-Za-z_$][A-Za-z0-9_$]*)\s*$/u.exec(value)?.groups?.binding ?? value;
  return (
    (allowAdditionalImports || imports.length === 1) &&
    importedValues.filter((candidate) => candidate === value).length === 1 &&
    !matches(code, new RegExp(`\\b(?:class|const|function|let|var)\\s+${escapeRegExp(importedBinding)}\\b`, 'u'))
  );
};

interface OutputPipeExpression {
  readonly base: string;
  readonly transforms: readonly string[];
}

const outputPipeExpression = (source: string): OutputPipeExpression | undefined => {
  const structure = maskNonCode(source);
  let match: RegExpExecArray | undefined;
  for (const candidate of structure.matchAll(/\.pipe\s*\(/gu)) {
    if (candidate.index !== undefined && codeDepthBeforePosition(source, candidate.index) === 0) {
      match = candidate;
    }
  }
  if (match?.index === undefined) {
    return undefined;
  }
  const opening = structure.indexOf('(', match.index);
  const closing = matchingDelimiterEnd(source, opening, '(', ')');
  if (opening === -1 || closing !== source.length - 1) {
    return undefined;
  }
  return {
    base: source.slice(0, match.index).trim(),
    transforms: separatedSource(
      source,
      topLevelSeparators(structure, ',', opening + 1, closing),
      opening + 1,
      closing,
    ).filter((transform) => transform !== ''),
  };
};

const isOutputSafeLayerTransform = (source: string): boolean =>
  /^(?:GovernedReadLayer|Layer)\.orDie$/u.test(source) ||
  isWholeCallExpression(source, /^(?:GovernedReadLayer|Layer)\.provide(?:Merge)?\(/u);

const MAX_OUTPUT_COMPOSITION_DEPTH = 64;
const MAX_OUTPUT_COMPOSITION_IDENTIFIERS = 32;

const outputCompositionIncludes = (
  source: string,
  expression: string,
  expectedLayer: string,
  seen: Set<string> = new Set<string>(),
  depth = 0,
): boolean => {
  if (depth >= MAX_OUTPUT_COMPOSITION_DEPTH) {
    return false;
  }
  const candidate = expression.trim();
  if (candidate === expectedLayer) {
    return true;
  }
  if (/^[A-Za-z_$][A-Za-z0-9_$]*$/u.test(candidate)) {
    if (seen.has(candidate) || seen.size >= MAX_OUTPUT_COMPOSITION_IDENTIFIERS) {
      return false;
    }
    seen.add(candidate);
    const initializer = constInitializer(source, candidate);
    return initializer !== undefined && outputCompositionIncludes(source, initializer, expectedLayer, seen, depth + 1);
  }
  const piped = outputPipeExpression(candidate);
  if (piped !== undefined) {
    return (
      piped.transforms.length > 0 &&
      piped.transforms.every(isOutputSafeLayerTransform) &&
      outputCompositionIncludes(source, piped.base, expectedLayer, seen, depth + 1)
    );
  }
  const merged = wholeCallArguments(candidate, /^(?:GovernedReadLayer|Layer)\.mergeAll\(/u);
  return (
    merged !== undefined &&
    merged.some((operand) => outputCompositionIncludes(source, operand, expectedLayer, seen, depth + 1))
  );
};

const slotIsMountedByAssembler = (
  source: string,
  runtimeSource: string,
  layerName: string,
  expectedApi: string,
): boolean => {
  const definition = effectBffDefinition(source);
  if (
    definition === undefined ||
    definition.includes('...') ||
    objectPropertyValue(definition, 'api') !== expectedApi ||
    !hasExactlyOne(maskNonCode(source), /\bassembleEffectBffRuntime\(/gu) ||
    !hasExactValueImport(source, 'assembleEffectBffRuntime', BFF_ASSEMBLY_MODULE)
  ) {
    return false;
  }
  const handlers = objectPropertyValue(definition, 'handlers');
  return handlers !== undefined && outputCompositionIncludes(runtimeSource, handlers, layerName);
};

const definesExpectedRuntime = (definition: string | undefined, expectedApi: string, runtimeName: string): boolean =>
  definition !== undefined &&
  !definition.includes('...') &&
  objectPropertyValue(definition, 'api') === expectedApi &&
  hasExactlyOne(
    definition,
    runtimeName === 'layer'
      ? /(?:\{|,)\s*layer(?:\s*:\s*layer)?\s*(?:,|\})/gu
      : new RegExp(`(?:\\{|,)\\s*layer\\s*:\\s*${escapeRegExp(runtimeName)}\\s*(?:,|\\})`, 'gu'),
  );

const legacyRuntimeMount = (
  source: string,
  code: string,
  runtimeSource: string,
  closing: number,
  layerName: string,
  expectedApi: string,
): boolean => {
  const runtimeDeclaration = /const\s+(?<name>[A-Za-z][A-Za-z0-9]*)\s*=\s*HttpApiBuilder\.layer\(/u.exec(runtimeSource);
  const runtimeName = runtimeDeclaration?.groups?.name;
  if (runtimeDeclaration === null || runtimeName === undefined) {
    return false;
  }
  const runtimeStart = closing + 1 + runtimeDeclaration.index;
  const runtimeEnd = code.indexOf('satisfies EffectRuntimeLayer', runtimeStart);
  if (runtimeEnd <= runtimeStart) {
    return false;
  }
  const runtimeSlice = code.slice(runtimeStart, runtimeEnd);
  const definition = effectBffDefinition(source);
  return (
    callArgument(runtimeSlice, /HttpApiBuilder\.layer\(/u) === expectedApi &&
    matches(runtimeSlice, new RegExp(`(?:GovernedReadLayer|Layer)\\.provide\\(${escapeRegExp(layerName)}\\)`, 'u')) &&
    hasExactlyOne(code, /\bdefineEffectBff\(/gu) &&
    definesExpectedRuntime(definition, expectedApi, runtimeName)
  );
};

const slotIsInsideMountedLayer = (
  source: string,
  startMarker: string,
  endMarker: string,
  expectedApi: string,
): boolean => {
  const code = maskComments(source);
  const slot = generatedSlotRange(source, startMarker, endMarker);
  if (slot === undefined) {
    return false;
  }
  const declarations = [
    ...code
      .slice(0, slot.markerStart)
      .matchAll(/(?:export\s+)?const\s+(?<name>[A-Za-z][A-Za-z0-9]*)\s*=\s*(?:GovernedReadLayer|Layer)\.mergeAll\(/gu),
  ];
  let declaration: RegExpExecArray | undefined;
  for (const candidate of declarations) {
    if (codeDepthAtPosition(source, candidate.index) === slot.depth - 1) {
      declaration = candidate;
    }
  }
  const layerName = declaration?.groups?.name;
  if (declaration === undefined || layerName === undefined) {
    return false;
  }
  const layerStart = declaration.index;
  const opening = code.indexOf('(', layerStart);
  const closing = matchingDelimiterEnd(code, opening, '(', ')');
  if (closing === undefined || closing <= slot.markerEnd) {
    return false;
  }
  const runtimeSource = code.slice(closing + 1);
  if (slotIsMountedByAssembler(source, runtimeSource, layerName, expectedApi)) {
    return true;
  }
  return legacyRuntimeMount(source, code, runtimeSource, closing, layerName, expectedApi);
};

// A trailing slot comment may precede an ASI-terminated root. Stop at the next
// top-level export rather than swallowing that declaration into the fluent expression.
const apiStatementEnd = (source: string, start: number): number | undefined => {
  const [semicolon] = topLevelSeparators(maskNonCode(source), ';', start);
  const nextExport = [...maskComments(source).matchAll(/\bexport\s/gu)].find(
    (match) => match.index > start && isTopLevelCodePosition(source, match.index),
  )?.index;
  if (semicolon === undefined) {
    return nextExport;
  }
  return nextExport === undefined ? semicolon : Math.min(semicolon, nextExport);
};

const governedApiDeclarationPrefix = (binding: string): string =>
  `export const ${binding}(?:\\s*:\\s*[A-Za-z][A-Za-z0-9]*(?:\\.[A-Za-z][A-Za-z0-9]*)*)?\\s*=\\s*`;

/** Resolve the actual exported root containing the generated slot, never an alias or decoy. */
export const governedApiBinding = (source: string): string | undefined => {
  const slot = generatedSlotRange(source, GOVERNED_API_SLOT_START, GOVERNED_API_SLOT_END);
  if (slot === undefined) {
    return undefined;
  }
  const candidates = [
    ...maskComments(source).matchAll(
      new RegExp(`${governedApiDeclarationPrefix('(?<name>[A-Za-z][A-Za-z0-9]*)')}HttpApi\\.make\\(`, 'gu'),
    ),
  ]
    .filter((match) => isTopLevelCodePosition(source, match.index))
    .map((match) => match.groups?.name)
    .filter((name) => {
      if (name === undefined) {
        return false;
      }
      const root = assignedExpressionRange(source, new RegExp(governedApiDeclarationPrefix(escapeRegExp(name)), 'u'));
      const statementEnd = root === undefined ? undefined : apiStatementEnd(source, root.start);
      return (
        root !== undefined &&
        statementEnd !== undefined &&
        slot.markerStart > root.start &&
        slot.markerEnd < statementEnd
      );
    });
  return candidates.length === 1 ? candidates[0] : undefined;
};

const hasClosedHeaderParseTail = (source: string, tail: string, closing: string): boolean =>
  ['@modern-js/bff-effect/effect-client', HTTP_API_CONTRACT_MODULE].some((module) =>
    hasExactValueImport(source, 'HttpApi', module, true),
  ) &&
  ['identity', GOVERNED_HTTP_API_IDENTITY_ALIAS].some(
    (identity) =>
      tail === `${closing} .annotate(HttpApi.HeadersParseOptions, { onExcessProperty: 'ignore' }) .pipe(${identity})` &&
      hasExactValueImport(source, identity === 'identity' ? identity : `identity as ${identity}`, 'effect', true),
  );

const governedSharedApiRoot = (source: string): SourceRange | undefined => {
  const binding = governedApiBinding(source);
  const apiRoot =
    binding === undefined
      ? undefined
      : assignedExpressionRange(source, new RegExp(governedApiDeclarationPrefix(escapeRegExp(binding)), 'u'));
  const slot = generatedSlotRange(source, GOVERNED_API_SLOT_START, GOVERNED_API_SLOT_END);
  if (apiRoot === undefined || slot === undefined) {
    return undefined;
  }
  const statementEnd = apiStatementEnd(source, apiRoot.start);
  if (statementEnd === undefined) {
    return undefined;
  }
  const additions = maskNonCode(source.slice(slot.bodyStart, slot.bodyEnd), true).trim();
  const trailing = maskComments(
    source.slice(slot.markerEnd + GOVERNED_API_SLOT_END.length, statementEnd).replace(/^;(?=\r?\n)/u, ''),
  ).trim();
  // The composed API is closed exactly once, after every generated addition.
  const closedTail = trailing.replaceAll(/\s+/gu, ' ');
  const closing = GOVERNED_HTTP_API_CLOSING_ANNOTATION;
  const hasStableIdentityTail =
    closedTail === `${closing} .pipe(${GOVERNED_HTTP_API_IDENTITY_ALIAS})` &&
    hasExactValueImport(source, `identity as ${GOVERNED_HTTP_API_IDENTITY_ALIAS}`, 'effect', true);
  return /^(?:\.addHttpApi\([A-Za-z][A-Za-z0-9]*\)\s*)*$/u.test(additions) &&
    (closedTail === `${closing} .pipe(identity)` ||
      hasStableIdentityTail ||
      hasClosedHeaderParseTail(source, closedTail, closing))
    ? apiRoot
    : undefined;
};

const hasGovernedSharedApiRoot = (source: string): boolean => governedSharedApiRoot(source) !== undefined;

const hasInjectedGovernedReadRuntime = (source: string): boolean => {
  const factory = exportedRuntimeFactory(source);
  if (factory === undefined) {
    return false;
  }
  const code = maskNonCode(factory.value);
  // The generated binding may be the first explicitly typed injection in an owner runtime
  // factory. Its caller and mounted layers are checked separately, and TS checks the layer type.
  const injection =
    /const\s+\[\s*governedReadRuntimeLive,\s*[A-Za-z0-9_,\s]+\]\s*=\s*(?<args>[A-Za-z][A-Za-z0-9]*)\s*;/u.exec(code);
  const args = injection?.groups?.args;
  if (
    args === undefined ||
    injection?.index === undefined ||
    codeDepthAtPosition(factory.value, injection.index) !== 1
  ) {
    return false;
  }
  const signature = new RegExp(`\\.\\.\\.${escapeRegExp(args)}:\\s*(?<type>[A-Za-z][A-Za-z0-9]*)`, 'u').exec(code);
  const type = signature?.groups?.type;
  return (
    type !== undefined &&
    new RegExp(
      `type ${escapeRegExp(type)}\\s*=\\s*readonly\\s*\\[\\s*readRuntime:\\s*Layer\\.Layer<\\s*ReadRuntime\\s*[,>]`,
      'u',
    ).test(maskNonCode(source)) &&
    effectBffDefinition(source) !== undefined
  );
};

interface NamedSourceImport {
  readonly imported: string;
  readonly modulePath: string;
  readonly typeOnly: boolean;
}

const topLevelBindingDeclarations = (source: string, binding: string): readonly RegExpMatchArray[] =>
  [
    ...maskNonCode(source).matchAll(
      new RegExp(
        `\\b(?:class|const|enum|function|interface|let|namespace|type|var)\\s+${escapeRegExp(binding)}\\b`,
        'gu',
      ),
    ),
  ].filter((match) => match.index !== undefined && isTopLevelCodePosition(source, match.index));

const namedSourceImport = (source: string, binding: string, allowTypeOnly = false): NamedSourceImport | undefined => {
  const imports = [
    ...maskComments(source).matchAll(
      /^\s*import\s+(?:(?<typeOnly>type)\s+)?(?:[A-Za-z_$][A-Za-z0-9_$]*\s*,\s*)?\{(?<values>[^}]*)\}\s*from\s*(?<quote>['"])(?<modulePath>[^'"]+)\k<quote>;?/gmu,
    ),
  ].filter((match) => match.index !== undefined && isTopLevelCodePosition(source, match.index));
  const candidates = imports.flatMap((match) =>
    (match.groups?.values ?? '').split(',').flatMap((entry) => {
      const imported =
        /^(?:(?<typeOnly>type)\s+)?(?<imported>[A-Za-z_$][A-Za-z0-9_$]*)(?:\s+as\s+(?<local>[A-Za-z_$][A-Za-z0-9_$]*))?$/u.exec(
          entry.trim(),
        );
      const name = imported?.groups?.imported;
      const local = imported?.groups?.local ?? name;
      const modulePath = match.groups?.modulePath;
      return name === undefined || local !== binding || modulePath === undefined
        ? []
        : [
            {
              imported: name,
              modulePath,
              typeOnly: match.groups?.typeOnly !== undefined || imported?.groups?.typeOnly !== undefined,
            },
          ];
    }),
  );
  const candidate = candidates.length === 1 ? candidates[0] : undefined;
  return candidate === undefined ||
    (!allowTypeOnly && candidate.typeOnly) ||
    topLevelBindingDeclarations(source, binding).length > 0
    ? undefined
    : candidate;
};

// This branch proves only a typed owner injection merged with the canonical Crypto layer.
// Every protected occurrence must have a known immutable role; unknown argument escapes fail closed.
const cryptoReadTuple = (source: string, factory: SourceRange) => {
  const factorySource = source.slice(factory.start, factory.end);
  const signature = /^\(\s*\.\.\.(?<args>[A-Za-z][A-Za-z0-9]*):\s*(?<type>[A-Za-z][A-Za-z0-9]*)\s*\)/u.exec(
    factorySource,
  );
  const args = signature?.groups?.args;
  const tupleType = signature?.groups?.type;
  if (args === undefined || tupleType === undefined || signature === null) {
    return null;
  }
  const code = maskNonCode(source);
  const tuplePattern = new RegExp(`type ${escapeRegExp(tupleType)}\\s*=\\s*readonly\\s*\\[`, 'gu');
  const tuples = [...code.matchAll(tuplePattern)];
  const tuple = tuples.length === 1 ? tuples[0] : undefined;
  const opening = tuple?.index === undefined ? undefined : code.indexOf('[', tuple.index);
  const closing = opening === undefined ? undefined : matchingDelimiter(code, opening, '[', ']');
  if (
    tuple?.index === undefined ||
    opening === undefined ||
    closing === undefined ||
    !isTopLevelCodePosition(source, tuple.index)
  ) {
    return null;
  }
  const tupleBody = code.slice(opening + 1, closing);
  const elements = separatedSource(
    tupleBody,
    topLevelSeparators(tupleBody, ',', 0, tupleBody.length, true),
    0,
    tupleBody.length,
  ).filter(Boolean);
  if (!/^readRuntime:\s*Layer\.Layer<\s*ReadRuntime\s*[,>]/u.test(elements[0] ?? '')) {
    return null;
  }
  return { args, closing, elements, factorySource, signature, tupleIndex: tuple.index, tupleType };
};

const hasCryptoReadDominance = (
  factorySource: string,
  injection: number,
  merge: number,
  slot: GeneratedSlotRange,
  returned: number,
): boolean =>
  codeDepthBeforePosition(factorySource, injection) === 1 &&
  codeDepthBeforePosition(factorySource, merge) === 1 &&
  injection < merge &&
  merge < slot.markerStart &&
  slot.depth === 2 &&
  codeDepthBeforePosition(factorySource, returned) === 1 &&
  returned > slot.markerEnd;

const cryptoReadBinding = (factorySource: string, args: string) => {
  const factoryCode = maskNonCode(factorySource);
  const destructures = [
    ...factoryCode.matchAll(/const\s*\[(?<bindings>[A-Za-z0-9_,\s]+)\]\s*=\s*(?<args>[A-Za-z][A-Za-z0-9]*)\s*;/gu),
  ];
  const injection = destructures.length === 1 ? destructures[0] : undefined;
  const local = injection?.groups?.bindings?.split(',')[0]?.trim();
  const mergePattern = new RegExp(
    `const governedReadRuntimeLive\\s*=\\s*Layer\\.merge\\(nodeCryptoLayer,\\s*${escapeRegExp(local ?? '')}\\s*\\)\\s*;`,
    'gu',
  );
  const merges = [...factoryCode.matchAll(mergePattern)];
  const merge = merges.length === 1 ? merges[0] : undefined;
  const slot = generatedSlotRange(factorySource, GOVERNED_HANDLER_LAYER_SLOT_START, GOVERNED_HANDLER_LAYER_SLOT_END);
  const returns = [...factoryCode.matchAll(/\breturn\b/gu)];
  const returned = returns.length === 1 ? returns[0] : undefined;
  if (
    local === undefined ||
    injection?.index === undefined ||
    merge?.index === undefined ||
    slot === undefined ||
    returned?.index === undefined
  ) {
    return null;
  }
  if (
    injection.groups?.args !== args ||
    !hasCryptoReadDominance(factorySource, injection.index, merge.index, slot, returned.index)
  ) {
    return null;
  }
  return { injection: injection[0], local, merge: merge[0] };
};

const cryptoReadInvocation = (source: string, elements: readonly string[]) => {
  const exported = defaultExportExpression(source);
  const invocation = exported === undefined ? undefined : constInitializer(source, exported);
  const maker = /^(?<name>make[A-Za-z][A-Za-z0-9]*ApiRuntime)\(/u.exec(invocation ?? '')?.groups?.name;
  const actualArguments =
    maker === undefined || invocation === undefined
      ? undefined
      : wholeCallArguments(invocation, new RegExp(`^${escapeRegExp(maker)}\\(`, 'u'));
  if (
    exported === undefined ||
    maker === undefined ||
    actualArguments === undefined ||
    actualArguments.length !== elements.length ||
    actualArguments.some((argument) => !/^[A-Za-z][A-Za-z0-9]*$/u.test(argument)) ||
    constInitializer(source, actualArguments[0] ?? '') === undefined
  ) {
    return null;
  }
  return { actualArguments, exported, invocation, maker };
};

const cryptoReadImportedArguments = (
  source: string,
  elements: readonly string[],
  actualArguments: readonly string[],
) => {
  const importedArguments = new Set<string>();
  for (const [index, argument] of actualArguments.entries()) {
    if (index === 0 || constInitializer(source, argument) !== undefined) {
      continue;
    }
    const imported = namedSourceImport(source, argument);
    if (
      !/^[A-Za-z][A-Za-z0-9]*:\s*Layer\.Layer<\s*GatewayAssertionRedemptionService\s*>$/u.test(elements[index] ?? '') ||
      imported?.imported !== 'GatewayAssertionRedemptionLive' ||
      imported.modulePath !== './auth/gateway-assertion-redemption.ts'
    ) {
      return null;
    }
    importedArguments.add(argument);
  }
  return importedArguments;
};

const cryptoReadProtectedNames = (
  args: string,
  local: string,
  tupleType: string,
  maker: string,
  exported: string,
  importedArguments: ReadonlySet<string>,
) => {
  const protectedNames = new Set([
    args,
    local,
    'governedReadRuntimeLive',
    'Layer',
    'GovernedReadLayer',
    'nodeCryptoLayer',
    'ReadRuntime',
    tupleType,
    maker,
    exported,
  ]);
  if (protectedNames.size !== 10) {
    return null;
  }
  for (const argument of importedArguments) {
    if (protectedNames.has(argument)) {
      return null;
    }
    protectedNames.add(argument);
  }
  if (importedArguments.size > 0) {
    protectedNames.add('GatewayAssertionRedemptionService');
  }
  return protectedNames;
};

const hasCryptoReadImports = (source: string, importedArguments: ReadonlySet<string>): boolean => {
  // Local binding -> [module, exported name].
  const expectedImports = new Map([
    ['Layer', [EFFECT_EDGE_MODULE, 'Layer']],
    ['GovernedReadLayer', ['effect', 'Layer']],
    ['nodeCryptoLayer', ['@effect/platform-node/NodeCrypto', 'layer']],
    ['ReadRuntime', [CORE_RUNTIME_MODULE, 'ReadRuntime']],
  ]);
  if (importedArguments.size > 0) {
    expectedImports.set('GatewayAssertionRedemptionService', [
      CORE_RUNTIME_MODULE,
      'GatewayAssertionRedemptionService',
    ]);
  }
  for (const [binding, [modulePath, original]] of expectedImports) {
    const typeOnly = binding === 'ReadRuntime' || binding === 'GatewayAssertionRedemptionService';
    const imported = namedSourceImport(source, binding, typeOnly);
    if (imported?.modulePath !== modulePath || imported.imported !== original || (typeOnly && !imported.typeOnly)) {
      return false;
    }
  }
  return true;
};

const cryptoReadRemainingSource = (
  source: string,
  factorySource: string,
  signature: string,
  injection: string,
  merge: string,
  tupleIndex: number,
  closing: number,
  importedArguments: ReadonlySet<string>,
  maker: string,
  invocation: string | undefined,
  exported: string,
) => {
  // Remove only the declarations and imports whose identities and exact roles were proved.
  let remaining = source.replace(
    factorySource,
    factorySource.replace(signature, '()').replace(injection, '').replace(merge, ''),
  );
  remaining = remaining.slice(0, tupleIndex) + ' '.repeat(closing + 1 - tupleIndex) + remaining.slice(closing + 1);
  let invalidImport = false;
  remaining = remaining.replaceAll(/^\s*import\s+(?:type\s+)?\{[^}]*\}\s*from\s*['"][^'"]+['"];?/gmu, (declaration) => {
    const values = /\{(?<values>[^}]*)\}/u.exec(declaration)?.groups?.values ?? '';
    for (const entry of values.split(',').map((value) => value.trim())) {
      if (
        /^GatewayAssertionRedemptionLive\b/u.test(entry) &&
        ![...importedArguments].some(
          (argument) =>
            entry ===
            (argument === 'GatewayAssertionRedemptionLive'
              ? argument
              : `GatewayAssertionRedemptionLive as ${argument}`),
        )
      ) {
        invalidImport = true;
      }
      if (
        /^(?:type\s+)?(?:Layer|layer|ReadRuntime)\b/u.test(entry) &&
        !/^(?:Layer|Layer as GovernedReadLayer|layer as nodeCryptoLayer|(?:type )?ReadRuntime)$/u.test(entry)
      ) {
        invalidImport = true;
      }
    }
    return ' '.repeat(declaration.length);
  });
  if (invalidImport) {
    return null;
  }
  remaining = remaining.replace(
    new RegExp(`export const ${escapeRegExp(maker)}\\s*=`, 'u'),
    'export const ignoredFactory =',
  );
  remaining = remaining.replace(invocation ?? '', 'ignoredFactory()');
  remaining = remaining.replace(new RegExp(`const ${escapeRegExp(exported)}\\s*=`, 'u'), 'const ignoredRuntime =');
  remaining = remaining.replace(new RegExp(`export default ${escapeRegExp(exported)}\\s*;`, 'u'), '');
  return remaining;
};

const isCryptoReadLayerReference = (
  tokens: readonly ReadFactoryToken[],
  index: number,
  token: ReadFactoryToken,
  member: string | undefined,
  call: boolean,
): boolean => {
  const typeMember =
    token.value === 'Layer' &&
    (member === 'Layer' || member === 'Error') &&
    tokens[index + 3]?.kind === SyntaxKind.LessThanToken;
  const immutableCall =
    tokens[index + 1]?.kind === SyntaxKind.DotToken &&
    call &&
    (token.value === 'Layer'
      ? ['merge', 'mergeAll', 'provide', 'provideMerge', 'succeed'].includes(member ?? '')
      : member === 'provide');
  const pipeTransform =
    member === 'orDie' &&
    tokens[index + 1]?.kind === SyntaxKind.DotToken &&
    tokens[index - 1]?.kind === SyntaxKind.CommaToken &&
    tokens[index + 3]?.kind === SyntaxKind.CommaToken;
  return typeMember || immutableCall || pipeTransform;
};

const isCryptoReadLayerConsumer = (tokens: readonly ReadFactoryToken[], parent: number | undefined): boolean => {
  if (parent === undefined) {
    return false;
  }
  return (
    ['Layer', 'GovernedReadLayer'].includes(tokens[parent - 3]?.value ?? '') &&
    tokens[parent - 2]?.kind === SyntaxKind.DotToken &&
    ['merge', 'mergeAll', 'provide', 'provideMerge'].includes(tokens[parent - 1]?.value ?? '')
  );
};

const isCryptoReadLayerArgument = (
  tokens: readonly ReadFactoryToken[],
  index: number,
  parent: number | undefined,
): boolean => {
  const end = index + 1;
  return (
    isCryptoReadLayerConsumer(tokens, parent) &&
    [SyntaxKind.OpenParenToken, SyntaxKind.CommaToken].includes(tokens[index - 1]?.kind ?? SyntaxKind.Unknown) &&
    [SyntaxKind.CommaToken, SyntaxKind.CloseParenToken].includes(tokens[end]?.kind ?? SyntaxKind.Unknown)
  );
};

const isCryptoReadProtectedReference = (
  tokens: readonly ReadFactoryToken[],
  index: number,
  parent: number | undefined,
): boolean => {
  const token = tokens[index];
  if (token === undefined) {
    return false;
  }
  if (
    tokens[index - 1]?.kind === SyntaxKind.DotToken ||
    tokens[index - 1]?.kind === SyntaxKind.QuestionDotToken ||
    tokens[index - 1]?.kind === SyntaxKind.NewKeyword
  ) {
    return false;
  }
  const member = tokens[index + 2]?.value;
  const call = tokens[index + 3]?.kind === SyntaxKind.OpenParenToken;
  if (token.value === 'Layer' || token.value === 'GovernedReadLayer') {
    return isCryptoReadLayerReference(tokens, index, token, member, call);
  }
  if (token.value === 'nodeCryptoLayer' || token.value === 'governedReadRuntimeLive') {
    return isCryptoReadLayerArgument(tokens, index, parent);
  }
  return false;
};

const hasClosedCryptoReadReferences = (remaining: string, protectedNames: ReadonlySet<string>): boolean => {
  const tokens = tokenizeGovernedClient(remaining);
  const stack: number[] = [];
  for (const [index, token] of tokens.entries()) {
    if (token.kind === SyntaxKind.CloseParenToken) {
      stack.pop();
    }
    if (
      token.kind === SyntaxKind.Identifier &&
      protectedNames.has(token.value) &&
      !isCryptoReadProtectedReference(tokens, index, stack.at(-1))
    ) {
      return false;
    }
    if (token.kind === SyntaxKind.OpenParenToken) {
      stack.push(index);
    }
  }
  return true;
};

const hasCryptoMergedReadInjection = (source: string, factory: SourceRange): boolean => {
  const tuple = cryptoReadTuple(source, factory);
  if (tuple === null) {
    return false;
  }
  const binding = cryptoReadBinding(tuple.factorySource, tuple.args);
  if (binding === null) {
    return false;
  }
  const invocation = cryptoReadInvocation(source, tuple.elements);
  if (invocation === null) {
    return false;
  }
  const importedArguments = cryptoReadImportedArguments(source, tuple.elements, invocation.actualArguments);
  if (importedArguments === null) {
    return false;
  }
  const protectedNames = cryptoReadProtectedNames(
    tuple.args,
    binding.local,
    tuple.tupleType,
    invocation.maker,
    invocation.exported,
    importedArguments,
  );
  if (protectedNames === null || !hasCryptoReadImports(source, importedArguments)) {
    return false;
  }
  const remaining = cryptoReadRemainingSource(
    source,
    tuple.factorySource,
    tuple.signature[0],
    binding.injection,
    binding.merge,
    tuple.tupleIndex,
    tuple.closing,
    importedArguments,
    invocation.maker,
    invocation.invocation,
    invocation.exported,
  );
  return remaining !== null && hasClosedCryptoReadReferences(remaining, protectedNames);
};

const wholeCall = (expression: string | undefined, callee: RegExp): boolean =>
  expression !== undefined && isWholeCallExpression(expression, callee);

/** New owner constructors retain exact public Core and own-registration import provenance. */
const hasCanonicalGeneratedReadAuthority = (source: string): boolean => {
  if (source.includes('const governedActiveApplicationCompositionLive =')) {
    const config = namedSourceImport(source, 'GovernedApplicationCompositionConfigLive');
    const nativeSource = namedSourceImport(source, 'GovernedApplicationCompositionSourceLive');
    const authority = assignedExpression(source, /const governedActiveApplicationCompositionLive\s*=\s*/u);
    if (
      config?.imported !== 'ActiveApplicationCompositionConfigLive' ||
      config.modulePath !== '@app/core-runtime/modules/active-application-composition' ||
      nativeSource?.imported !== 'ActiveApplicationCompositionSourceLive' ||
      nativeSource.modulePath !== '@app/core-runtime/modules/active-application-composition-source' ||
      authority === undefined ||
      !/^GovernedApplicationCompositionConfigLive\.pipe\(\s*GovernedReadLayer\.provide\(governedApplicationCompositionSourceLive\),?\s*\)$/u.test(
        authority,
      )
    ) {
      return false;
    }
  }

  return true;
};

const hasConstructorOwnerPair = (
  source: string,
  argumentsSource: string,
  factory: string,
  importedFactory: NamedSourceImport,
  backendRegistration?: string,
): boolean => {
  const pair = /^(?<deployment>[A-Za-z][A-Za-z0-9]*),\s*(?<registration>[A-Za-z][A-Za-z0-9]*),?$/u.exec(
    argumentsSource,
  )?.groups;
  if (pair === undefined) {
    return false;
  }
  const deployment = namedSourceImport(source, pair.deployment ?? '');
  const registration = namedSourceImport(source, pair.registration ?? '');
  if (
    deployment?.modulePath !== '../shared/ultramodern-build.ts' ||
    deployment.imported !== 'ultramodernDeliveryUnit' ||
    !(
      (registration?.modulePath === '../vertical.registration.ts' &&
        /^[a-z][A-Za-z0-9]*Registration$/u.test(registration.imported)) ||
      (backendRegistration !== undefined &&
        registration?.modulePath === '../vertical.runtime-declaration.ts' &&
        registration.imported === backendRegistration)
    )
  ) {
    return false;
  }
  for (const [local, imported] of [
    [factory, importedFactory],
    [pair.deployment, deployment],
    [pair.registration, registration],
  ] as const) {
    if (
      local === undefined ||
      imported === undefined ||
      !hasExactValueImport(
        source,
        imported.imported === local ? local : `${imported.imported} as ${local}`,
        imported.modulePath,
        true,
      )
    ) {
      return false;
    }
  }
  return true;
};

const hasBoundOwnerRuntimeConstructor = (
  source: string,
  runtimeCall: RegExpMatchArray,
  backendRegistration?: string,
): boolean => {
  const factory = runtimeCall.groups?.factory;
  if (factory === undefined || runtimeCall.index === undefined || source[runtimeCall.index - 1] === '.') {
    return false;
  }
  const opening = runtimeCall.index + runtimeCall[0].lastIndexOf('(');
  const closing = matchingDelimiterEnd(source, opening, '(', ')');
  if (closing === undefined) {
    return false;
  }
  const argumentsSource = source.slice(opening + 1, closing).trim();
  const importedFactory = namedSourceImport(source, factory);
  const isRead = factory === 'makeReadRuntimeLive' || factory === 'GovernedMakeReadRuntimeLive';
  if (
    importedFactory?.modulePath !== CORE_RUNTIME_MODULE ||
    importedFactory.imported !== (isRead ? 'makeReadRuntimeLive' : 'makeActionRuntimeLive')
  ) {
    return false;
  }
  // Existing Core Action construction remains supported; new owner-bound calls are closed pairs.
  if (!isRead && /^[A-Za-z][A-Za-z0-9]*$/u.test(argumentsSource)) {
    return true;
  }
  return hasConstructorOwnerPair(source, argumentsSource, factory, importedFactory, backendRegistration);
};

const hasBoundOwnerRuntimeConstructors = (source: string, backendRegistration?: string): boolean => {
  if (!hasCanonicalGeneratedReadAuthority(source)) {
    return false;
  }
  const runtimeCalls = [
    ...maskNonCode(source).matchAll(
      /\b(?<factory>makeReadRuntimeLive|GovernedMakeReadRuntimeLive|makeActionRuntimeLive|GovernedMakeActionRuntimeLive)\s*\(/gu,
    ),
  ];
  return runtimeCalls.every((runtimeCall) => hasBoundOwnerRuntimeConstructor(source, runtimeCall, backendRegistration));
};

const GOVERNED_READ_DEPENDENCY_PROVISION = 'GovernedReadLayer.provide(governedReadRuntimeDependenciesLive)';

const hasOwnerBoundReadPipe = (expression: string | undefined, provider: string): boolean => {
  const pipeline = expression === undefined ? undefined : outputPipeExpression(expression);
  if (
    pipeline === undefined ||
    !/^(?:makeReadRuntimeLive|GovernedMakeReadRuntimeLive)\(\s*[A-Za-z][A-Za-z0-9]*,\s*[A-Za-z][A-Za-z0-9]*,?\s*\)$/u.test(
      pipeline.base,
    )
  ) {
    return false;
  }
  const generatedOwner =
    /^GovernedMakeReadRuntimeLive\(\s*governedActionDeliveryUnit,\s*governedOwnerRegistration,?\s*\)$/u.test(
      pipeline.base,
    );
  return (
    pipeline.transforms[0] === provider &&
    (!generatedOwner ||
      pipeline.transforms[1] === 'GovernedReadLayer.provide(governedActiveApplicationCompositionLive)')
  );
};

const hasLegacyReadRuntimePipe = (expression: string | undefined): boolean =>
  wholeCall(expression, /^ReadRuntimeLive\.pipe\(/u) &&
  callArgument(expression, /^ReadRuntimeLive\.pipe\(/u) === 'Layer.provide(readRuntimeDependenciesLive)';

const hasGovernedHandlerRoot = (source: string, backendRegistration?: string): boolean => {
  if (!hasBoundOwnerRuntimeConstructors(source, backendRegistration)) {
    return false;
  }
  const factory = exportedRuntimeFactory(source);
  const factoryCode = factory === undefined ? '' : maskNonCode(factory.value);
  const typedRest = /^\(\s*\.\.\.[A-Za-z][A-Za-z0-9]*:\s*[A-Za-z][A-Za-z0-9]*\s*\)/u.test(factoryCode);
  const localMergeBinding = /\b(?:const|let|var)\s+governedReadRuntimeLive\s*=/u.test(factoryCode);
  if (factory !== undefined && (typedRest || localMergeBinding)) {
    const tuples = [...factoryCode.matchAll(/\b(?:const|let|var)\s*\[/gu)];
    const direct = /const\s*\[\s*governedReadRuntimeLive\s*,/u.test(factoryCode);
    if (tuples.length !== 1 || !direct || localMergeBinding) {
      return hasCryptoMergedReadInjection(source, factory);
    }
    // This is a typed executed factory: failed direct injection cannot borrow a legacy module root.
    return hasInjectedGovernedReadRuntime(source);
  }
  if (hasInjectedGovernedReadRuntime(source)) {
    return true;
  }
  const runtime = assignedExpression(source, /const governedReadRuntimeLive\s*=\s*/u);
  if (
    runtime === undefined ||
    (!/^readRuntimeLive$/u.test(runtime) &&
      !runtime.startsWith('GovernedReadRuntimeLive.pipe(') &&
      !hasOwnerBoundReadPipe(runtime, GOVERNED_READ_DEPENDENCY_PROVISION))
  ) {
    return false;
  }
  if (runtime === 'readRuntimeLive') {
    const ownerRuntime = assignedExpression(source, /const readRuntimeLive\s*=\s*/u);
    if (
      !hasOwnerBoundReadPipe(ownerRuntime, 'Layer.provide(readRuntimeDependenciesLive)') &&
      !hasLegacyReadRuntimePipe(ownerRuntime)
    ) {
      return false;
    }
  } else if (hasOwnerBoundReadPipe(runtime, GOVERNED_READ_DEPENDENCY_PROVISION)) {
    // Constructor and both argument imports were checked above; retain the exact dependency pipe.
  } else if (
    !isWholeCallExpression(runtime, /^GovernedReadRuntimeLive\.pipe\(/u) ||
    callArgument(runtime, /^GovernedReadRuntimeLive\.pipe\(/u) !== GOVERNED_READ_DEPENDENCY_PROVISION
  ) {
    return false;
  }
  return effectBffDefinition(source) !== undefined;
};

const hasGovernedSupportSlots = (handlerRoot: string): boolean => {
  const supportImportStart = '// <generated-governed-http-handler-support-imports>';
  const supportLayerStart = '// <generated-governed-http-handler-support-layers>';
  const supportImports = handlerRoot.includes(supportImportStart)
    ? generatedSlotRange(handlerRoot, supportImportStart, '// </generated-governed-http-handler-support-imports>')
    : null;
  const supportLayers = handlerRoot.includes(supportLayerStart)
    ? generatedSlotRange(handlerRoot, supportLayerStart, '// </generated-governed-http-handler-support-layers>')
    : null;
  const generatedHandlers = assignedExpressionRange(handlerRoot, /export const governedReadApiHandlersLive\s*=\s*/u);
  return (
    (supportImports === null || supportImports?.depth === 0) &&
    (supportLayers === null ||
      (generatedHandlers !== undefined &&
        supportLayers !== undefined &&
        supportLayers.markerStart > generatedHandlers.start &&
        supportLayers.markerEnd < generatedHandlers.end))
  );
};

export const hasValidGovernedHttpCompositionRoot = (sharedApi: string, handlerRoot: string): boolean => {
  const sharedRoot = governedSharedApiRoot(sharedApi);
  const expectedApi = governedApiBinding(sharedApi);
  const sharedImports = generatedSlotRange(
    sharedApi,
    '// <generated-governed-http-api-imports>',
    '// </generated-governed-http-api-imports>',
  );
  const handlerImports = generatedSlotRange(
    handlerRoot,
    '// <generated-governed-http-handler-imports>',
    '// </generated-governed-http-handler-imports>',
  );
  const mounted =
    expectedApi !== undefined &&
    slotIsInsideMountedLayer(
      handlerRoot,
      GOVERNED_HANDLER_LAYER_SLOT_START,
      GOVERNED_HANDLER_LAYER_SLOT_END,
      expectedApi,
    );
  return (
    sharedRoot !== undefined &&
    hasGovernedHandlerRoot(handlerRoot) &&
    sharedImports?.depth === 0 &&
    handlerImports?.depth === 0 &&
    hasGovernedSupportSlots(handlerRoot) &&
    mounted
  );
};

const governedReadContribution = (contractStem: string, source: string): GovernedReadContribution | undefined => {
  if (hasGeneratedSourceHeader(source, MODULE_API_HEADER)) {
    return { contractStem, kind: MODULE_API_KIND, name: contractStem };
  }
  const candidateKind = /^\/\/ @ontos-contribution-kind (?<kind>report|search-provider)$/mu.exec(source)?.groups?.kind;
  if (!hasGeneratedSourceHeader(source, GOVERNED_CONTRIBUTION_HEADER) || !isGovernedReadKind(candidateKind)) {
    return undefined;
  }
  const kind = candidateKind;
  const suffix = kind === REPORT_KIND ? '-report' : '-search';
  if (!contractStem.endsWith(suffix)) {
    return undefined;
  }
  return {
    contractStem,
    kind,
    name: contractStem.slice(0, -suffix.length),
  };
};

const generatedHeader = (kind: GovernedReadKind): string =>
  kind === MODULE_API_KIND ? MODULE_API_HEADER : `${GOVERNED_CONTRIBUTION_HEADER}// @ontos-contribution-kind ${kind}\n`;

const contributionProfiles = {
  'module-api': {
    accessKinds: new Set(["'detail'", "'list'"]),
    directory: 'api',
    readSuffix: '.read',
    registrationCategory: 'api',
    registrationSection: 'apis',
    role: 'api',
    schemaSuffix: '',
    typeSuffix: '',
  },
  report: {
    accessKinds: new Set(["'report'"]),
    directory: 'reports',
    readSuffix: '.provider',
    registrationCategory: 'reports',
    registrationSection: 'reports',
    role: 'report',
    schemaSuffix: 'Provider',
    typeSuffix: 'Report',
  },
  'search-provider': {
    accessKinds: new Set(["'search'"]),
    directory: 'search',
    readSuffix: '.provider',
    registrationCategory: 'search',
    registrationSection: 'search',
    role: 'search',
    schemaSuffix: 'Provider',
    typeSuffix: 'Search',
  },
} as const;

const contributionServerStem = (contribution: GovernedReadContribution): string =>
  contribution.kind === MODULE_API_KIND ? `${contribution.name}-read` : contribution.contractStem;

const contributionRole = (kind: GovernedReadKind): string => contributionProfiles[kind].role;
const contributionGroup = (kind: GovernedReadKind, name: string): string =>
  `${toCamelCase(name)}${contributionProfiles[kind].typeSuffix}`;
const contributionApiValue = (kind: GovernedReadKind, name: string): string =>
  `${toPascalCase(name)}${contributionProfiles[kind].typeSuffix}Api`;
const contributionReadDirectory = (kind: GovernedReadKind): string => contributionProfiles[kind].directory;
const contributionSchemaStem = (kind: GovernedReadKind, name: string): string =>
  `${toPascalCase(name)}${contributionProfiles[kind].schemaSuffix}`;
const contributionEndpoint = (contribution: GovernedReadContribution, moduleId: string): string =>
  contribution.kind === MODULE_API_KIND
    ? `/reads/${contribution.name}`
    : `/${moduleId}/${contributionProfiles[contribution.kind].directory}/${contribution.name}`;

const hasObjectProperties = (source: string, expected: Readonly<Record<string, string>>): boolean =>
  Object.entries(expected).every(([property, value]) => objectProperty(source, property) === value);

const hasContractImports = (source: string, expected: Readonly<Record<string, string>>): boolean =>
  Object.entries(expected).every(([name, specifier]) => hasExactValueImport(source, name, specifier, true));

const isWholeObjectCall = (expression: string | undefined, value: string | undefined, callee: RegExp): boolean =>
  expression !== undefined &&
  value !== undefined &&
  !value.includes('...') &&
  isWholeCallExpression(expression, callee);

const hasReadDescriptorPolicy = (read: string, allowedAccessKinds: ReadonlySet<string>): boolean => {
  const policies = objectProperty(read, 'policies');
  const accessKind = objectProperty(read, 'accessKind');
  const normalizedAccessKind = /^['"](?<value>[^'"]+)['"]$/u.exec(accessKind ?? '')?.groups?.value;
  return (
    normalizedAccessKind !== undefined &&
    allowedAccessKinds.has(`'${normalizedAccessKind}'`) &&
    matches(objectProperty(read, 'legalEntityScope'), /^['"](?:required|optional|forbidden)['"]$/u) &&
    matches(
      objectProperty(read, 'permissionTarget'),
      /^['"](?:assortment_permission|business_permission|conditional|legal_entity|module|resource|tenant)['"]$/u,
    ) &&
    policies !== undefined &&
    policies.startsWith('[') &&
    matchingDelimiterEnd(policies, 0, '[', ']') === policies.length - 1
  );
};

const hasScopedFactoryInputTypes = (source: string, parameters: readonly string[]): boolean =>
  parameters.length >= 2 &&
  parameters.length <= 3 &&
  parameters[0] === 'transaction: ScopedTransactionExecutor' &&
  parameters[1] === 'scope: OperationalScope' &&
  (parameters.length === 2 ||
    parameters[2] === 'compositionRevision?: string' ||
    parameters[2] === 'compositionRevision: string | undefined') &&
  ['ScopedTransactionExecutor', 'OperationalScope'].every((name) => {
    const imported = namedSourceImport(source, name, true);
    return imported?.imported === name && imported.modulePath === CORE_RUNTIME_MODULE;
  });

const scopedNativeGeneratorOpening = (initializer: string, generatorSource: string): number | undefined => {
  const generator = /^function\*(?:\s+[A-Za-z_$][A-Za-z0-9_$]*)?\s*\(/u.exec(generatorSource);
  return generator !== null &&
    isEffectFnCallback(initializer) &&
    /^(?<quote>['"])[A-Za-z][A-Za-z0-9._-]*\k<quote>$/u.test(callArgument(initializer, /^Effect\.fn\(/u) ?? '') &&
    callArgument(initializer, /^Effect\.fn\(/u, 1) === undefined
    ? generator[0].length - 1
    : undefined;
};

const hasScopedReadFactoryExport = (source: string, binding: string): boolean => {
  if (
    topLevelBindingDeclarations(source, binding).length !== 1 ||
    !new RegExp(`\\bexport\\s+const\\s+${escapeRegExp(binding)}\\s*=`, 'u').test(maskComments(source))
  ) {
    return false;
  }
  const initializer = constInitializer(source, binding);
  if (initializer === undefined) {
    return false;
  }
  const effectOpening = initializer.startsWith('Effect.fn(') ? initializer.indexOf('(') : undefined;
  const effectClosing =
    effectOpening === undefined ? undefined : matchingDelimiterEnd(initializer, effectOpening, '(', ')');
  const wrapped = effectClosing === undefined ? undefined : initializer.slice(effectClosing + 1).trim();
  const callback =
    wrapped !== undefined && wrapped.startsWith('(') ? callArgument(`invoke${wrapped}`, /^invoke\(/u) : initializer;
  if (callback === undefined) {
    return false;
  }
  const generatorOpening =
    effectOpening === undefined ? undefined : scopedNativeGeneratorOpening(initializer, callback);
  if (!hasBalancedArrowCallback(callback) && generatorOpening === undefined) {
    return false;
  }
  const opening = generatorOpening ?? 0;
  const closing = matchingDelimiterEnd(callback, opening, '(', ')');
  if (closing === undefined) {
    return false;
  }
  const parameters = separatedSource(
    maskComments(callback),
    topLevelSeparators(maskNonCode(callback), ',', opening + 1, closing, true),
    opening + 1,
    closing,
  ).filter((value) => value !== '');
  return (
    hasScopedFactoryInputTypes(source, parameters) &&
    (effectOpening === undefined || hasExactValueImport(source, 'Effect', 'effect'))
  );
};

const hasNativeReadServiceFactoryExport = (source: string, binding: string): boolean => {
  const code = maskComments(source);
  const declarations = [
    ...code.matchAll(new RegExp(`\\bexport\\s+const\\s+${escapeRegExp(binding)}\\s*:\\s*`, 'gu')),
  ].filter((match) => match.index !== undefined && isTopLevelCodePosition(source, match.index));
  const declaration = declarations.length === 1 ? declarations[0] : undefined;
  if (declaration?.index === undefined || topLevelBindingDeclarations(source, binding).length !== 1) {
    return false;
  }
  const annotationStart = declaration.index + declaration[0].length;
  const [separator] = topLevelSeparators(maskNonCode(source), '=;', annotationStart, source.length, true);
  if (separator === undefined || source.charAt(separator) !== '=') {
    return false;
  }
  const annotation = code.slice(annotationStart, separator).trim();
  const nativeType = /^(?<binding>[A-Za-z_$][A-Za-z0-9_$]*)\s*(?<arguments><[\s\S]+>)$/u.exec(annotation);
  const typeBinding = nativeType?.groups?.binding;
  const argumentsSource = nativeType?.groups?.arguments;
  const nativeImport = typeBinding === undefined ? undefined : namedSourceImport(source, typeBinding, true);
  return (
    argumentsSource !== undefined &&
    topLevelSeparators(maskNonCode(argumentsSource), '>', 0, argumentsSource.length, true)[0] ===
      argumentsSource.length - 1 &&
    nativeImport?.imported === 'ReadServiceFactory' &&
    nativeImport.modulePath === CORE_RUNTIME_MODULE &&
    isExecutableCallback(constInitializer(source, binding))
  );
};

/** Resolve the original owner callable; native import renames preserve that callable's identity. */
export const hasOwnerLocalReadServiceFactory = (
  sources: ReadonlyMap<string, string>,
  readFile: string,
  ownerPath: string,
  candidate?: string,
): boolean => {
  if (
    candidate === undefined ||
    !/^[A-Za-z_$][A-Za-z0-9_$]*$/u.test(candidate) ||
    path.posix.normalize(ownerPath) !== ownerPath ||
    path.posix.normalize(readFile) !== readFile ||
    !readFile.startsWith(`${ownerPath}/`)
  ) {
    return false;
  }
  const readSource = sources.get(readFile);
  const imported = readSource === undefined ? undefined : namedSourceImport(readSource, candidate);
  if (imported === undefined || !/^\.\.?\//u.test(imported.modulePath) || !imported.modulePath.endsWith('.ts')) {
    return false;
  }
  const factoryFile = path.posix.normalize(path.posix.join(path.posix.dirname(readFile), imported.modulePath));
  const factorySource = factoryFile.startsWith(`${ownerPath}/`) ? sources.get(factoryFile) : undefined;
  return (
    factorySource !== undefined &&
    (hasNativeReadServiceFactoryExport(factorySource, imported.imported) ||
      hasScopedReadFactoryExport(factorySource, imported.imported))
  );
};

const nativeReadFactoryAnnotationBinding = (source: string, annotation: string): string | undefined => {
  const nativeType = /^(?<binding>[A-Za-z_$][A-Za-z0-9_$]*)\s*(?<arguments><[\s\S]+>)$/u.exec(annotation);
  const binding = nativeType?.groups?.binding;
  const argumentsSource = nativeType?.groups?.arguments;
  const imported = binding === undefined ? undefined : namedSourceImport(source, binding, true);
  return argumentsSource !== undefined &&
    topLevelSeparators(maskNonCode(argumentsSource), '>', 0, argumentsSource.length, true)[0] ===
      argumentsSource.length - 1 &&
    imported?.imported === 'ReadServiceFactory' &&
    imported.modulePath === CORE_RUNTIME_MODULE
    ? binding
    : undefined;
};

type ReadFactoryToken = ReturnType<typeof tokenizeGovernedClient>[number];
const READ_FACTORY_DECLARATIONS = new Set([
  SyntaxKind.ClassKeyword,
  SyntaxKind.ConstKeyword,
  SyntaxKind.EnumKeyword,
  SyntaxKind.FunctionKeyword,
  SyntaxKind.InterfaceKeyword,
  SyntaxKind.LetKeyword,
  SyntaxKind.ModuleKeyword,
  SyntaxKind.NamespaceKeyword,
  SyntaxKind.TypeKeyword,
  SyntaxKind.VarKeyword,
]);
const READ_FACTORY_ASSIGNMENTS = new Set([
  SyntaxKind.EqualsToken,
  SyntaxKind.PlusEqualsToken,
  SyntaxKind.MinusEqualsToken,
  SyntaxKind.AsteriskEqualsToken,
  SyntaxKind.SlashEqualsToken,
  SyntaxKind.PercentEqualsToken,
  SyntaxKind.AsteriskAsteriskEqualsToken,
  SyntaxKind.AmpersandEqualsToken,
  SyntaxKind.BarEqualsToken,
  SyntaxKind.CaretEqualsToken,
  SyntaxKind.LessThanLessThanEqualsToken,
  SyntaxKind.GreaterThanGreaterThanEqualsToken,
  SyntaxKind.GreaterThanGreaterThanGreaterThanEqualsToken,
  SyntaxKind.AmpersandAmpersandEqualsToken,
  SyntaxKind.BarBarEqualsToken,
  SyntaxKind.QuestionQuestionEqualsToken,
  SyntaxKind.PlusPlusToken,
  SyntaxKind.MinusMinusToken,
]);
const READ_FACTORY_PARAMETER_OPENINGS = new Set([
  SyntaxKind.OpenParenToken,
  SyntaxKind.OpenBraceToken,
  SyntaxKind.OpenBracketToken,
  SyntaxKind.LessThanToken,
]);
const READ_FACTORY_PARAMETER_CLOSINGS = new Set([
  SyntaxKind.CloseParenToken,
  SyntaxKind.CloseBraceToken,
  SyntaxKind.CloseBracketToken,
  SyntaxKind.GreaterThanToken,
]);

const READ_FACTORY_MUTATORS = new Map([
  ['Object', new Set(['assign', 'defineProperties', 'defineProperty', 'setPrototypeOf'])],
  ['Reflect', new Set(['defineProperty', 'deleteProperty', 'set', 'setPrototypeOf'])],
]);
const READ_FACTORY_PREFIX_MUTATIONS = new Set([
  SyntaxKind.PlusPlusToken,
  SyntaxKind.MinusMinusToken,
  SyntaxKind.DeleteKeyword,
]);
const READ_FACTORY_MEMBER_SELECTORS = new Set([SyntaxKind.DotToken, SyntaxKind.QuestionDotToken]);
const READ_FACTORY_ALIAS_ENDINGS = new Set([
  SyntaxKind.SemicolonToken,
  SyntaxKind.CommaToken,
  SyntaxKind.CloseParenToken,
  SyntaxKind.CloseBraceToken,
  SyntaxKind.CloseBracketToken,
  SyntaxKind.AsKeyword,
  SyntaxKind.SatisfiesKeyword,
]);
const READ_FACTORY_TYPE_DELIMITERS = new Map([
  [SyntaxKind.OpenParenToken, '('],
  [SyntaxKind.CloseParenToken, ')'],
  [SyntaxKind.OpenBraceToken, '{'],
  [SyntaxKind.CloseBraceToken, '}'],
  [SyntaxKind.OpenBracketToken, '['],
  [SyntaxKind.CloseBracketToken, ']'],
  [SyntaxKind.LessThanToken, '<'],
  [SyntaxKind.GreaterThanToken, '>'],
  [SyntaxKind.GreaterThanGreaterThanToken, '>>'],
  [SyntaxKind.GreaterThanGreaterThanGreaterThanToken, '>>>'],
]);

const readFactoryTokenClose = (
  tokens: readonly ReadFactoryToken[],
  opening: number,
  openKind: SyntaxKind,
  closeKind: SyntaxKind,
): number | undefined => {
  let depth = 0;
  for (let index = opening; index < tokens.length; index += 1) {
    if (tokens[index]?.kind === openKind) {
      depth += 1;
    }
    if (tokens[index]?.kind === closeKind) {
      depth -= 1;
      if (depth === 0) {
        return index;
      }
    }
  }
  return undefined;
};

const readFactoryDestructuredBinding = (
  tokens: readonly ReadFactoryToken[],
  opening: number,
  bindings: ReadonlyMap<string, number>,
): boolean => {
  const closeKind =
    tokens[opening]?.kind === SyntaxKind.OpenBraceToken ? SyntaxKind.CloseBraceToken : SyntaxKind.CloseBracketToken;
  const closing = readFactoryTokenClose(tokens, opening, tokens[opening]?.kind ?? SyntaxKind.Unknown, closeKind);
  return (
    closing === undefined ||
    tokens
      .slice(opening + 1, closing)
      .some(
        (token, offset) =>
          token.kind === SyntaxKind.Identifier &&
          bindings.has(token.value) &&
          tokens[opening + offset + 2]?.kind !== SyntaxKind.ColonToken,
      )
  );
};

const readFactoryParametersShadow = (
  tokens: readonly ReadFactoryToken[],
  opening: number,
  closing: number,
  bindings: ReadonlyMap<string, number>,
): boolean => {
  let parameterStart = true;
  let depth = 0;
  for (let index = opening + 1; index < closing; index += 1) {
    const token = tokens[index];
    if (token === undefined) {
      return true;
    }
    if (parameterStart && token.kind !== SyntaxKind.DotDotDotToken) {
      if (token.kind === SyntaxKind.Identifier && bindings.has(token.value)) {
        return true;
      }
      if (
        (token.kind === SyntaxKind.OpenBraceToken || token.kind === SyntaxKind.OpenBracketToken) &&
        readFactoryDestructuredBinding(tokens, index, bindings)
      ) {
        return true;
      }
      parameterStart = false;
    }
    if (READ_FACTORY_PARAMETER_OPENINGS.has(token.kind)) {
      depth += 1;
    }
    if (READ_FACTORY_PARAMETER_CLOSINGS.has(token.kind)) {
      depth -= 1;
    }
    if (depth === 0 && token.kind === SyntaxKind.CommaToken) {
      parameterStart = true;
    }
  }
  return false;
};

const hasReadFactoryReturnArrow = (tokens: readonly ReadFactoryToken[], annotation: number): boolean => {
  const depth = new DelimiterDepth();
  for (const token of tokens.slice(annotation + 1)) {
    if (depth.isTopLevel() && token.kind === SyntaxKind.EqualsGreaterThanToken) {
      return true;
    }
    if (depth.isTopLevel() && token.kind === SyntaxKind.SemicolonToken) {
      return false;
    }
    for (const delimiter of READ_FACTORY_TYPE_DELIMITERS.get(token.kind) ?? '') {
      depth.update(delimiter, undefined, true);
    }
    if (depth.hasUnmatchedClose()) {
      return false;
    }
  }
  return false;
};

const isReadFactoryFunctionParameters = (
  tokens: readonly ReadFactoryToken[],
  opening: number,
  closing: number,
): boolean => {
  const previous = tokens[opening - 1]?.kind;
  const beforePrevious = tokens[opening - 2]?.kind;
  const functionPrefix =
    previous === SyntaxKind.FunctionKeyword ||
    (previous === SyntaxKind.AsteriskToken && beforePrevious === SyntaxKind.FunctionKeyword) ||
    (previous === SyntaxKind.Identifier &&
      (beforePrevious === SyntaxKind.FunctionKeyword ||
        (beforePrevious === SyntaxKind.AsteriskToken && tokens[opening - 3]?.kind === SyntaxKind.FunctionKeyword)));
  if (functionPrefix) {
    return true;
  }
  const after = tokens[closing + 1]?.kind;
  return (
    after === SyntaxKind.EqualsGreaterThanToken ||
    (after === SyntaxKind.ColonToken && hasReadFactoryReturnArrow(tokens, closing + 1))
  );
};

const readFactoryReflectiveMutation = (tokens: readonly ReadFactoryToken[], index: number): boolean => {
  const call = tokens[index - 1];
  const method = tokens[index - 2];
  const selector = tokens[index - 3];
  const owner = tokens[index - 4];
  if (
    call === undefined ||
    method === undefined ||
    selector === undefined ||
    owner === undefined ||
    call.kind !== SyntaxKind.OpenParenToken
  ) {
    return false;
  }
  if (READ_FACTORY_MEMBER_SELECTORS.has(selector.kind)) {
    return READ_FACTORY_MUTATORS.get(owner.value)?.has(method.value) === true;
  }
  return (
    method.kind === SyntaxKind.CloseBracketToken &&
    selector.kind === SyntaxKind.StringLiteral &&
    owner.kind === SyntaxKind.OpenBracketToken &&
    READ_FACTORY_MUTATORS.get(tokens[index - 5]?.value ?? '')?.has(selector.value) === true
  );
};

const readFactoryDeclarationAssignment = (tokens: readonly ReadFactoryToken[], start: number): number | undefined => {
  const depth = new DelimiterDepth();
  for (let assignment = start; assignment < tokens.length; assignment += 1) {
    const token = tokens[assignment];
    if (depth.isTopLevel() && token?.kind === SyntaxKind.EqualsToken) {
      return assignment;
    }
    if (depth.isTopLevel() && token?.kind === SyntaxKind.SemicolonToken) {
      return undefined;
    }
    for (const delimiter of READ_FACTORY_TYPE_DELIMITERS.get(token?.kind ?? SyntaxKind.Unknown) ?? '') {
      depth.update(delimiter, undefined, true);
    }
  }
  return undefined;
};

interface ReadFactoryParameterRange {
  readonly closing: number;
  readonly opening: number;
}

const readFactoryMakerParameterRange = (
  tokens: readonly ReadFactoryToken[],
  maker: string,
): ReadFactoryParameterRange | undefined => {
  const declaration = tokens.findIndex(
    (token, index) =>
      token.kind === SyntaxKind.Identifier &&
      token.value === maker &&
      tokens[index - 1]?.kind === SyntaxKind.ConstKeyword,
  );
  const assignment = declaration === -1 ? undefined : readFactoryDeclarationAssignment(tokens, declaration + 1);
  const opening = assignment === undefined ? undefined : assignment + 1;
  if (opening === undefined || tokens[opening]?.kind !== SyntaxKind.OpenParenToken) {
    return undefined;
  }
  const closing = readFactoryTokenClose(tokens, opening, SyntaxKind.OpenParenToken, SyntaxKind.CloseParenToken);
  return closing === undefined ? undefined : { closing, opening };
};

const isReadFactoryVerifiedDefaultAlias = (
  tokens: readonly ReadFactoryToken[],
  index: number,
  parameters: ReadFactoryParameterRange | undefined,
): boolean =>
  parameters !== undefined &&
  index > parameters.opening &&
  index < parameters.closing &&
  tokens[index - 1]?.kind === SyntaxKind.EqualsToken &&
  tokens[index - 3]?.kind === SyntaxKind.TypeOfKeyword &&
  tokens[index - 2]?.value === tokens[index]?.value;

const readFactoryDirectAliasReference = (
  tokens: readonly ReadFactoryToken[],
  index: number,
  parameters: ReadFactoryParameterRange | undefined,
): boolean => {
  let before = index - 1;
  while (tokens[before]?.kind === SyntaxKind.OpenParenToken) {
    before -= 1;
  }
  const ending = tokens[index + 1]?.kind;
  return (
    tokens[before]?.kind === SyntaxKind.EqualsToken &&
    (ending === undefined || READ_FACTORY_ALIAS_ENDINGS.has(ending)) &&
    !isReadFactoryVerifiedDefaultAlias(tokens, index, parameters)
  );
};

const readFactoryProtectedValueAlias = (
  tokens: readonly ReadFactoryToken[],
  index: number,
  bindings: ReadonlyMap<string, number>,
): boolean => {
  const declaration = tokens[index]?.kind;
  if (
    declaration !== SyntaxKind.ConstKeyword &&
    declaration !== SyntaxKind.LetKeyword &&
    declaration !== SyntaxKind.VarKeyword
  ) {
    return false;
  }
  const bound = tokens[index + 1];
  if (bound?.kind !== SyntaxKind.Identifier || bindings.has(bound.value)) {
    return false;
  }
  const assignment = readFactoryDeclarationAssignment(tokens, index + 2);
  if (assignment === undefined) {
    return false;
  }
  let value = assignment + 1;
  while (tokens[value]?.kind === SyntaxKind.OpenParenToken) {
    value += 1;
  }
  const reference = tokens[value];
  const next = tokens[value + 1]?.kind;
  return (
    reference?.kind === SyntaxKind.Identifier &&
    bindings.has(reference.value) &&
    !READ_FACTORY_MEMBER_SELECTORS.has(next ?? SyntaxKind.Unknown) &&
    next !== SyntaxKind.OpenBracketToken &&
    next !== SyntaxKind.OpenParenToken
  );
};

const readFactoryBindingMutated = (tokens: readonly ReadFactoryToken[], index: number): boolean => {
  if (tokens[index - 1]?.kind === SyntaxKind.TypeOfKeyword) {
    return false;
  }
  let next = index + 1;
  while (tokens[next]?.kind === SyntaxKind.DotToken || tokens[next]?.kind === SyntaxKind.OpenBracketToken) {
    if (tokens[next]?.kind === SyntaxKind.DotToken && tokens[next + 1]?.kind === SyntaxKind.Identifier) {
      next += 2;
    } else if (tokens[next]?.kind === SyntaxKind.OpenBracketToken) {
      const closing = readFactoryTokenClose(tokens, next, SyntaxKind.OpenBracketToken, SyntaxKind.CloseBracketToken);
      if (closing === undefined) {
        return true;
      }
      next = closing + 1;
    } else {
      break;
    }
  }
  const previous = tokens[index - 1]?.kind;
  return (
    READ_FACTORY_ASSIGNMENTS.has(tokens[next]?.kind ?? SyntaxKind.Unknown) ||
    READ_FACTORY_PREFIX_MUTATIONS.has(previous ?? SyntaxKind.Unknown) ||
    readFactoryReflectiveMutation(tokens, index)
  );
};

const readFactoryDeclaredBinding = (tokens: readonly ReadFactoryToken[], index: number): boolean => {
  const previous = tokens[index - 1]?.kind;
  const specifierType =
    previous === SyntaxKind.TypeKeyword &&
    (tokens[index - 2]?.kind === SyntaxKind.OpenBraceToken || tokens[index - 2]?.kind === SyntaxKind.CommaToken);
  return !specifierType && READ_FACTORY_DECLARATIONS.has(previous ?? SyntaxKind.Unknown);
};

const readFactoryDestructuredDeclaration = (
  tokens: readonly ReadFactoryToken[],
  index: number,
  bindings: ReadonlyMap<string, number>,
): boolean => {
  const declaration = tokens[index]?.kind;
  const opening = tokens[index + 1]?.kind;
  return (
    (declaration === SyntaxKind.ConstKeyword ||
      declaration === SyntaxKind.LetKeyword ||
      declaration === SyntaxKind.VarKeyword) &&
    (opening === SyntaxKind.OpenBraceToken || opening === SyntaxKind.OpenBracketToken) &&
    readFactoryDestructuredBinding(tokens, index + 1, bindings)
  );
};

/** Protected imports and declarations must retain their original callable identity. */
const hasStableReadFactoryBindings = (
  source: string,
  expectedDeclarations: ReadonlyMap<string, number>,
  maker: string,
): boolean => {
  const tokens = tokenizeGovernedClient(source);
  const declarations = new Map<string, number>();
  const parameters = readFactoryMakerParameterRange(tokens, maker);
  for (const [index, token] of tokens.entries()) {
    if (
      readFactoryDestructuredDeclaration(tokens, index, expectedDeclarations) ||
      readFactoryProtectedValueAlias(tokens, index, expectedDeclarations)
    ) {
      return false;
    }
    if (
      token.kind === SyntaxKind.Identifier &&
      expectedDeclarations.has(token.value) &&
      !READ_FACTORY_MEMBER_SELECTORS.has(tokens[index - 1]?.kind ?? SyntaxKind.Unknown)
    ) {
      if (readFactoryDeclaredBinding(tokens, index)) {
        declarations.set(token.value, (declarations.get(token.value) ?? 0) + 1);
      } else if (
        readFactoryBindingMutated(tokens, index) ||
        readFactoryDirectAliasReference(tokens, index, parameters) ||
        tokens[index + 1]?.kind === SyntaxKind.EqualsGreaterThanToken
      ) {
        return false;
      }
    }
    if (token.kind === SyntaxKind.OpenParenToken) {
      const closing = readFactoryTokenClose(tokens, index, SyntaxKind.OpenParenToken, SyntaxKind.CloseParenToken);
      if (
        closing === undefined ||
        (isReadFactoryFunctionParameters(tokens, index, closing) &&
          readFactoryParametersShadow(tokens, index, closing, expectedDeclarations))
      ) {
        return false;
      }
    }
  }
  return [...expectedDeclarations].every(([binding, count]) => (declarations.get(binding) ?? 0) === count);
};

interface LocalReadFactoryMaker {
  readonly argumentsList: readonly string[];
  readonly maker: string;
  readonly nativeType: string;
  readonly parameters: readonly string[];
}

const localReadFactoryMaker = (source: string, candidate: string): LocalReadFactoryMaker | undefined => {
  const initializer = constInitializer(source, candidate);
  const maker = /^(?<name>make[A-Z][A-Za-z0-9_$]*)\(/u.exec(initializer ?? '')?.groups?.name;
  const makerSource = maker === undefined ? undefined : constInitializer(source, maker);
  if (initializer === undefined || maker === undefined || makerSource === undefined || !makerSource.startsWith('(')) {
    return undefined;
  }
  const argumentsList = wholeCallArguments(initializer, new RegExp(`^${escapeRegExp(maker)}\\(`, 'u'), true);
  const closing = matchingDelimiterEnd(makerSource, 0, '(', ')');
  if (
    argumentsList === undefined ||
    closing === undefined ||
    !makerSource
      .slice(closing + 1)
      .trimStart()
      .startsWith(':')
  ) {
    return undefined;
  }
  const [arrow] = topLevelSeparators(maskNonCode(makerSource), '=', closing + 1, makerSource.length, true);
  if (arrow === undefined || makerSource.slice(arrow, arrow + 2) !== '=>') {
    return undefined;
  }
  const annotation = maskComments(makerSource.slice(closing + 1, arrow))
    .trim()
    .slice(1)
    .trim();
  const nativeType = nativeReadFactoryAnnotationBinding(source, annotation);
  const effectImport = namedSourceImport(source, 'Effect');
  if (
    nativeType === undefined ||
    !isEffectFnCallback(makerSource.slice(arrow + 2).trim()) ||
    effectImport?.imported !== 'Effect' ||
    effectImport.modulePath !== 'effect'
  ) {
    return undefined;
  }
  const parameters = separatedSource(
    maskComments(makerSource),
    topLevelSeparators(maskNonCode(makerSource), ',', 1, closing, true),
    1,
    closing,
  ).filter((parameter) => parameter !== '');
  return { argumentsList, maker, nativeType, parameters };
};

const hasReadFactoryDependencyExport = (source: string, binding: string): boolean => {
  const exported = new RegExp(`\\bexport\\s+const\\s+${escapeRegExp(binding)}\\b`, 'gu');
  const declarations = [...maskNonCode(source).matchAll(exported)].filter(
    (declaration) => declaration.index !== undefined && isTopLevelCodePosition(source, declaration.index),
  );
  return (
    declarations.length === 1 &&
    topLevelBindingDeclarations(source, binding).length === 1 &&
    isExecutableCallback(constInitializer(source, binding))
  );
};

const readFactoryDependencyDeclarationCount = (
  sources: ReadonlyMap<string, string>,
  readFile: string,
  ownerPath: string,
  source: string,
  dependency: string,
): number | undefined => {
  const imported = namedSourceImport(source, dependency);
  if (imported !== undefined && /^\.\.?\//u.test(imported.modulePath) && imported.modulePath.endsWith('.ts')) {
    const filename = path.posix.normalize(path.posix.join(path.posix.dirname(readFile), imported.modulePath));
    const dependencySource = filename.startsWith(`${ownerPath}/`) ? sources.get(filename) : undefined;
    return dependencySource !== undefined && hasReadFactoryDependencyExport(dependencySource, imported.imported)
      ? 0
      : undefined;
  }
  const local = constInitializer(source, dependency);
  return local !== undefined && isExecutableCallback(local) ? 1 : undefined;
};

const hasImmutableReadFactoryDataExport = (owner: string, binding: string): boolean => {
  const record = constInitializer(owner, binding);
  if (record === undefined || !record.endsWith('as const')) {
    return false;
  }
  const document = record.slice(0, -'as const'.length).trim();
  const members = topLevelObjectEntries(document);
  const declaration = new RegExp(`\\bexport\\s+const\\s+${escapeRegExp(binding)}\\b`, 'gu');
  const declarations = [...maskNonCode(owner).matchAll(declaration)].filter(
    (candidate) => candidate.index !== undefined && isTopLevelCodePosition(owner, candidate.index),
  );
  const tokens = tokenizeGovernedClient(owner);
  const referencesAreClosed = tokens.every(
    (token, index) =>
      token.kind !== SyntaxKind.Identifier ||
      token.value !== binding ||
      tokens[index - 1]?.kind === SyntaxKind.ConstKeyword ||
      tokens[index - 1]?.kind === SyntaxKind.TypeOfKeyword,
  );
  return (
    declarations.length === 1 &&
    referencesAreClosed &&
    members !== undefined &&
    new Set(members.map(objectEntryKey)).size === members.length &&
    members.every((member) => {
      const field = objectEntryKey(member);
      const expression = field === undefined ? undefined : objectProperty(document, field);
      const value = expression === undefined ? [] : tokenizeGovernedClient(expression);
      return value.length === 1 && value[0]?.kind === SyntaxKind.StringLiteral;
    }) &&
    hasStableReadFactoryBindings(owner, new Map([[binding, 1]]), '')
  );
};

const hasOwnerLocalReadFactoryDataOption = (
  sources: ReadonlyMap<string, string>,
  readFile: string,
  ownerPath: string,
  source: string,
  type: string,
  value: string,
): boolean => {
  const valueImport = namedSourceImport(source, value);
  const typeImport = namedSourceImport(source, type, true);
  if (valueImport === undefined || typeImport === undefined) {
    return false;
  }
  const valueFile = path.posix.normalize(path.posix.join(path.posix.dirname(readFile), valueImport.modulePath));
  const typeFile = path.posix.normalize(path.posix.join(path.posix.dirname(readFile), typeImport.modulePath));
  const owner = sources.get(valueFile);
  if (
    !valueImport.modulePath.startsWith('.') ||
    valueFile !== typeFile ||
    !valueFile.startsWith(`${ownerPath}/`) ||
    owner === undefined
  ) {
    return false;
  }
  const annotation = assignedExpression(
    owner,
    new RegExp(`export type ${escapeRegExp(typeImport.imported)}\\s*=\\s*`, 'u'),
  );
  const alternatives = annotation
    ?.split('|')
    .map((part) => part.trim())
    .filter((part) => part !== '');
  return (
    alternatives !== undefined &&
    alternatives.length > 0 &&
    alternatives.every((alternative) => /^typeof [A-Za-z_$][A-Za-z0-9_$]*$/u.test(alternative)) &&
    alternatives.includes(`typeof ${valueImport.imported}`) &&
    hasImmutableReadFactoryDataExport(owner, valueImport.imported)
  );
};

/** A typed optional data option retains its own immutable literal-record provenance. */
const localReadFactoryDataOptions = (
  sources: ReadonlyMap<string, string>,
  readFile: string,
  ownerPath: string,
  source: string,
  parameter: string,
  argument: string | undefined,
): { readonly bindings: ReadonlyMap<string, number>; readonly name: string } | undefined => {
  const parsed = /^(?<name>[A-Za-z_$][A-Za-z0-9_$]*):\s*(?<optionsType>\{[\s\S]*\})\s*=\s*\{\s*\}$/u.exec(parameter);
  const name = parsed?.groups?.name;
  const optionsType = parsed?.groups?.optionsType;
  if (name === undefined || optionsType === undefined) {
    return undefined;
  }
  const properties = separatedSource(
    optionsType,
    topLevelSeparators(maskNonCode(optionsType), ';', 1, optionsType.length - 1),
    1,
    optionsType.length - 1,
  ).filter((entry) => entry !== '');
  const descriptors = properties.map(
    (property) =>
      /^readonly\s+(?<key>[A-Za-z_$][A-Za-z0-9_$]*)\?:\s*(?<type>(?:typeof\s+)?[A-Za-z_$][A-Za-z0-9_$]*)$/u.exec(
        property,
      )?.groups,
  );
  if (
    descriptors.some((descriptor) => descriptor === undefined) ||
    new Set(descriptors.map((descriptor) => descriptor?.key)).size !== descriptors.length
  ) {
    return undefined;
  }
  const entries = argument === undefined ? [] : topLevelObjectEntries(argument);
  const bindings = new Map<string, number>();
  if (entries === undefined || new Set(entries.map(objectEntryKey)).size !== entries.length) {
    return undefined;
  }
  for (const entry of entries) {
    const key = objectEntryKey(entry);
    const type = descriptors.find((property) => property?.key === key)?.type;
    const value = key === undefined ? undefined : objectProperty(argument ?? '', key);
    if (
      type === undefined ||
      value === undefined ||
      !/^[A-Za-z_$][A-Za-z0-9_$]*$/u.test(value) ||
      !hasOwnerLocalReadFactoryDataOption(sources, readFile, ownerPath, source, type, value)
    ) {
      return undefined;
    }
    bindings.set(value, 0);
    bindings.set(type, 0);
  }
  return { bindings, name };
};

interface LocalReadFactoryDependencies {
  readonly bindings: ReadonlyMap<string, number>;
  readonly minimumArguments: number;
}

const localReadFactoryDependencies = (
  sources: ReadonlyMap<string, string>,
  readFile: string,
  ownerPath: string,
  source: string,
  candidate: string,
  factory: LocalReadFactoryMaker,
): LocalReadFactoryDependencies | undefined => {
  const bindings = new Map([
    [candidate, 1],
    [factory.maker, 1],
    ['Effect', 0],
    [factory.nativeType, 0],
  ]);
  const parameterNames: string[] = [];
  let minimumArguments = 0;
  for (const [index, parameter] of factory.parameters.entries()) {
    const options = localReadFactoryDataOptions(
      sources,
      readFile,
      ownerPath,
      source,
      parameter,
      factory.argumentsList[index],
    );
    if (options !== undefined) {
      parameterNames.push(options.name);
      for (const [binding, count] of options.bindings) {
        bindings.set(binding, count);
      }
      continue;
    }
    const parsed =
      /^(?<name>[A-Za-z_$][A-Za-z0-9_$]*):\s*typeof\s+(?<dependency>[A-Za-z_$][A-Za-z0-9_$]*)(?:\s*=\s*(?<default>[A-Za-z_$][A-Za-z0-9_$]*))?$/u.exec(
        parameter,
      );
    const dependency = parsed?.groups?.dependency;
    const defaultValue = parsed?.groups?.default;
    const parameterName = parsed?.groups?.name;
    if (
      dependency === undefined ||
      parameterName === undefined ||
      parameterName === dependency ||
      (defaultValue !== undefined && defaultValue !== dependency)
    ) {
      return undefined;
    }
    parameterNames.push(parameterName);
    if (defaultValue === undefined) {
      minimumArguments = index + 1;
    }
    if (index < factory.argumentsList.length && factory.argumentsList[index] !== dependency) {
      return undefined;
    }
    const declarationCount = readFactoryDependencyDeclarationCount(sources, readFile, ownerPath, source, dependency);
    if (declarationCount === undefined) {
      return undefined;
    }
    bindings.set(dependency, declarationCount);
  }
  return parameterNames.some((name) => bindings.has(name)) ? undefined : { bindings, minimumArguments };
};

/** Prove a local native factory result without accepting a forwarding callback or alias. */
export const hasOwnerLocalReadServiceFactoryResult = (
  sources: ReadonlyMap<string, string>,
  readFile: string,
  ownerPath: string,
  candidate?: string,
): boolean => {
  if (
    candidate === undefined ||
    !/^[A-Za-z_$][A-Za-z0-9_$]*$/u.test(candidate) ||
    path.posix.normalize(ownerPath) !== ownerPath ||
    path.posix.normalize(readFile) !== readFile ||
    !readFile.startsWith(`${ownerPath}/`)
  ) {
    return false;
  }
  const source = sources.get(readFile);
  if (source === undefined) {
    return false;
  }
  const factory = localReadFactoryMaker(source, candidate);
  const dependencies =
    factory === undefined
      ? undefined
      : localReadFactoryDependencies(sources, readFile, ownerPath, source, candidate, factory);
  return (
    factory !== undefined &&
    dependencies !== undefined &&
    factory.argumentsList.length >= dependencies.minimumArguments &&
    factory.argumentsList.length <= factory.parameters.length &&
    hasStableReadFactoryBindings(source, dependencies.bindings, factory.maker)
  );
};

const hasReadCallbacks = (
  source: string,
  readExpression: string,
  kind: GovernedReadKind,
  sources: ReadonlyMap<string, string>,
  readFile: string,
  ownerPath: string,
): boolean => {
  const handler = callArgument(readExpression, /^defineRead\(/u, 1);
  const callbacks = [2, 3];
  if (kind === SEARCH_PROVIDER_KIND) {
    callbacks.push(4);
  }
  const isOwnerLocalImportedCallback = (candidate: string | undefined): boolean => {
    if (candidate === undefined || !/^[A-Za-z_$][A-Za-z0-9_$]*$/u.test(candidate)) {
      return false;
    }
    const imported = namedSourceImport(source, candidate);
    return imported !== undefined && /^\.\/[a-z][a-z0-9-]*\.ts$/u.test(imported.modulePath);
  };
  const isOwnerLocalImportedFactoryResult = (candidate: string | undefined): boolean => {
    if (candidate === undefined || !/^[A-Za-z_$][A-Za-z0-9_$]*$/u.test(candidate)) {
      return false;
    }
    const initializer = constInitializer(source, candidate);
    const factory = /^(?<name>make[A-Z][A-Za-z0-9_$]*)\(/u.exec(initializer ?? '')?.groups?.name;
    return (
      initializer !== undefined &&
      factory !== undefined &&
      isWholeCallExpression(initializer, new RegExp(`^${escapeRegExp(factory)}\\(`, 'u')) &&
      isOwnerLocalImportedCallback(factory)
    );
  };
  const isConditionalPermissionDescriptor = (candidate: string | undefined): boolean => {
    if (candidate === undefined || !/^[A-Za-z_$][A-Za-z0-9_$]*$/u.test(candidate)) {
      return false;
    }
    const initializer = constInitializer(source, candidate);
    const descriptorCall = /^defineReadConditionalPermission(?:<[\s\S]*?>)?\(/u;
    const descriptor = objectArgument(initializer, descriptorCall);
    return (
      descriptor !== undefined &&
      initializer !== undefined &&
      isWholeCallExpression(initializer, descriptorCall) &&
      hasExactValueImport(source, 'defineReadConditionalPermission', CORE_RUNTIME_MODULE)
    );
  };
  return (
    (isReadHandlerCallback(handler, source) || isOwnerLocalImportedFactoryResult(handler)) &&
    callbacks.every((index) => {
      const callback = callArgument(readExpression, /^defineRead\(/u, index);
      return (
        isExecutableCallback(callback, source) ||
        isOwnerLocalImportedCallback(callback) ||
        isOwnerLocalImportedFactoryResult(callback) ||
        (index === 2 && hasOwnerLocalReadServiceFactory(sources, readFile, ownerPath, callback)) ||
        (index === 2 && hasOwnerLocalReadServiceFactoryResult(sources, readFile, ownerPath, callback)) ||
        (index === 3 && isConditionalPermissionDescriptor(callback))
      );
    })
  );
};

const hasReadEntrypoint = (source: string, entrypoint: string, identity: Readonly<Record<string, string>>): boolean => {
  const access = objectProperty(entrypoint, 'access');
  const matchesExactString = (actual: string | undefined, expected: string): boolean => {
    const literal = expected.slice(1, -1);
    if (actual === `'${literal}'` || actual === `"${literal}"`) {
      return true;
    }
    if (actual === undefined || !/^[A-Za-z_$][A-Za-z0-9_$]*$/u.test(actual)) {
      return false;
    }
    const declarations = [
      ...source.matchAll(
        new RegExp(
          `^const\\s+${escapeRegExp(actual)}\\s*=\\s*(['"])${escapeRegExp(literal)}\\1(?:\\s+as\\s+const)?;\\s*$`,
          'gmu',
        ),
      ),
    ];
    return declarations.length === 1;
  };
  const result =
    (access === "'read'" || access === '"read"' || access === "'historical_read'" || access === '"historical_read"') &&
    Object.entries(identity).every(([property, value]) => {
      const actual = objectPropertyValue(entrypoint, property);
      return matchesExactString(actual, value);
    });
  return result;
};

const hasReadContract = (
  source: string,
  contribution: GovernedReadContribution,
  moduleId: string,
  sources: ReadonlyMap<string, string>,
  readFile: string,
  ownerPath: string,
): boolean => {
  const camel = toCamelCase(contribution.name);
  const schemaStem = contributionSchemaStem(contribution.kind, contribution.name);
  const escapedCamel = escapeRegExp(camel);
  const role = contributionRole(contribution.kind);
  const allowedAccessKinds = contributionProfiles[contribution.kind].accessKinds;
  const contributionKey = `${moduleId}.${role}.${contribution.name}`;
  const connected = generatedModuleApiEntrypointReference(source, `${camel}Read`);
  const entrypointExpression =
    connected?.initializer ?? (connected === undefined ? undefined : constInitializer(source, connected.name));
  const readExpression = assignedExpression(source, new RegExp(`export const ${escapedCamel}Read\\s*=\\s*`, 'u'));
  const entrypoint = objectArgument(entrypointExpression, /^defineTenantModuleEntrypoint\(/u);
  const read = objectArgument(readExpression, /^defineRead\(/u);
  const inputSchema = `${schemaStem}RequestSchema`;
  const resultSchema = `${schemaStem}ResponseSchema`;
  if (entrypoint === undefined || read === undefined || readExpression === undefined) {
    return false;
  }
  const checks = {
    callbacks: hasReadCallbacks(source, readExpression, contribution.kind, sources, readFile, ownerPath),
    descriptorReferences:
      connected !== undefined &&
      (objectPropertyValue(read, 'entrypoint') === connected.name ||
        objectPropertyValue(read, 'entrypoint') === connected.initializer) &&
      hasObjectProperties(read, {
        inputSchema,
        resultSchema,
      }),
    descriptorStrings: (
      [
        ['owningModuleKey', moduleId],
        ['readKey', contributionKey],
      ] as const
    ).every(([property, value]) => {
      const actual = objectProperty(read, property);
      if (actual === `'${value}'` || actual === `"${value}"`) {
        return true;
      }
      if (actual === undefined || !/^[A-Za-z_$][A-Za-z0-9_$]*$/u.test(actual)) {
        return false;
      }
      return (
        [
          ...source.matchAll(
            new RegExp(
              `^const\\s+${escapeRegExp(actual)}\\s*=\\s*(['"])${escapeRegExp(value)}\\1(?:\\s+as\\s+const)?;\\s*$`,
              'gmu',
            ),
          ),
        ].length === 1
      );
    }),
    entrypoint: hasReadEntrypoint(source, entrypoint, {
      entrypointKey: `'${contributionKey}'`,
      moduleKey: `'${moduleId}'`,
      role: `'${role}'`,
    }),
    entrypointCall: isWholeObjectCall(entrypointExpression, entrypoint, /^defineTenantModuleEntrypoint\(/u),
    imports: hasContractImports(source, {
      defineRead: CORE_RUNTIME_MODULE,
      defineTenantModuleEntrypoint: CORE_RUNTIME_MODULE,
    }),
    policy: hasReadDescriptorPolicy(read, allowedAccessKinds),
    readCall: isWholeObjectCall(readExpression, read, /^defineRead\(/u),
  };
  return Object.values(checks).every(Boolean);
};

const hasClientContract = (
  source: string,
  contribution: GovernedReadContribution,
  endpointGroup: string,
  apiValue: string,
  deploymentAppId: string,
  ownerContractImport = `../../shared/apis/${contribution.contractStem}.ts`,
): boolean => {
  const type = toPascalCase(contribution.name);
  const operation = contribution.kind === MODULE_API_KIND ? `execute${type}` : `load${type}Client`;
  return hasGeneratedGovernedClientContract(source, {
    authorizedOperation: `${operation}WithAuthorization`,
    defaultApiPrefix: `/${deploymentAppId}-api`,
    endpointGroup,
    generatedHeader: generatedHeader(contribution.kind),
    invocationKind: contribution.kind === MODULE_API_KIND ? 'module-api' : 'provider',
    ownerApiValue: apiValue,
    ownerContractImport,
    publicOperation: operation,
  });
};

const hasProblemSet = (source: string, schemaStem: string, contractImport: string): boolean => {
  const expression = assignedExpression(source, /const problems\s*=\s*/u);
  const call = /^makeGovernedReadProblems\(/u;
  const schemas = objectArgument(expression, call);
  if (
    expression === undefined ||
    schemas === undefined ||
    !isWholeCallExpression(expression, call) ||
    !hasExactValueImport(source, 'makeGovernedReadProblems', GOVERNED_HTTP_RUNTIME_MODULE)
  ) {
    return false;
  }
  const constructors = {
    authentication: 'AuthenticationProblemSchema',
    forbidden: 'ForbiddenProblemSchema',
    internal: 'InternalProblemSchema',
    invalid: 'InvalidProblemSchema',
    notFound: 'NotFoundProblemSchema',
    policyConflict: 'PolicyConflictProblemSchema',
    policyIneligible: 'PolicyProblemSchema',
    unavailable: 'UnavailableProblemSchema',
  } as const;
  const entries = topLevelObjectEntries(schemas);
  return (
    entries !== undefined &&
    entries.length === Object.keys(constructors).length &&
    Object.entries(constructors).every(
      ([key, suffix]) =>
        objectProperty(schemas, key) === `${schemaStem}${suffix}` &&
        hasExactValueImport(source, `${schemaStem}${suffix}`, contractImport),
    )
  );
};

interface SourceSpan {
  readonly end: number;
  readonly start: number;
}

const topLevelDeclarationMatch = (source: string, declaration: RegExp): RegExpExecArray | undefined =>
  [...source.matchAll(new RegExp(declaration.source, 'gu'))].find((candidate) =>
    isTopLevelCodePosition(source, candidate.index),
  );

const thinServerStatementSpan = (source: string, declaration: RegExp): SourceSpan | undefined => {
  const range = assignedExpressionRange(source, declaration);
  const match = topLevelDeclarationMatch(source, declaration);
  return range === undefined || match === undefined
    ? undefined
    : { end: source.indexOf(';', range.end) + 1, start: match.index };
};

const isAllowedThinServerImport = (module: string, allowedImports: ReadonlySet<string>): boolean =>
  allowedImports.has(module) || module === 'effect' || /^\.\.\/shared\/domain\/[a-z][a-z0-9-]*\.ts$/u.test(module);

const thinServerImportSpans = (source: string, allowedImports: ReadonlySet<string>): readonly SourceSpan[] => {
  const imports = /\bimport\s+(?:type\s+)?\{[^}]*\}\s+from\s+['"](?<module>[^'"]+)['"]\s*;/gu;
  return [...source.matchAll(imports)]
    .filter(
      (match) =>
        isTopLevelCodePosition(source, match.index) &&
        isAllowedThinServerImport(match.groups?.module ?? '', allowedImports),
    )
    .map((match) => ({ end: match.index + match[0].length, start: match.index }));
};

const thinServerDeclarations = (exportedName: string, domainMapperName: string | undefined): readonly RegExp[] => [
  /const problems\s*=\s*/u,
  new RegExp(`export const ${escapeRegExp(exportedName)}\\s*=\\s*`, 'u'),
  ...(domainMapperName === undefined
    ? []
    : [new RegExp(`(?:export\\s+)?const ${escapeRegExp(domainMapperName)}\\s*=\\s*`, 'u')]),
];

const removeSourceSpans = (source: string, spans: readonly SourceSpan[]): string =>
  spans.reduce(
    (remaining, { end, start }) => remaining.slice(0, start) + ' '.repeat(end - start) + remaining.slice(end),
    source,
  );

const hasOnlyThinServerStatements = (
  source: string,
  exportedName: string,
  allowedImports: ReadonlySet<string>,
  domainMapperName?: string,
): boolean => {
  const declarationSpans = thinServerDeclarations(exportedName, domainMapperName).map((declaration) =>
    thinServerStatementSpan(source, declaration),
  );
  if (declarationSpans.some((span) => span === undefined)) {
    return false;
  }
  const spans = [
    ...declarationSpans.filter((span): span is SourceSpan => span !== undefined),
    ...thinServerImportSpans(source, allowedImports),
  ];
  return removeSourceSpans(maskComments(source), spans).trim() === '';
};

const optionsFromHandlerCallback = (callbackSource: string | undefined): string | undefined => {
  const prefix = /^\(\s*handlers\s*\)\s*=>\s*/u.exec(callbackSource ?? '');
  if (callbackSource === undefined || prefix === null) {
    return undefined;
  }
  const registration = callbackSource.slice(prefix[0].length).trim();
  if (
    !wholeCall(registration, /^handlers\.handle\(/u) ||
    callArgument(registration, /^handlers\.handle\(/u) !== "'execute'" ||
    !hasExactlyOne(callbackSource, /handlers\.handle\(/gu)
  ) {
    return undefined;
  }
  const handler = callArgument(registration, /^handlers\.handle\(/u, 1);
  return wholeCall(handler, /^makeGovernedReadHttpHandler\(/u)
    ? objectArgument(handler, /^makeGovernedReadHttpHandler\(/u)
    : undefined;
};

const serverHandlerOptions = (
  layerExpression: string | undefined,
  expectedGroup: string,
  apiBinding: string,
): string | undefined => {
  if (
    !wholeCall(layerExpression, /^HttpApiBuilder\.group\(/u) ||
    callArgument(layerExpression, /^HttpApiBuilder\.group\(/u) !== apiBinding ||
    callArgument(layerExpression, /^HttpApiBuilder\.group\(/u, 1) !== `'${expectedGroup}'`
  ) {
    return undefined;
  }
  const callback = callArgument(layerExpression, /^HttpApiBuilder\.group\(/u, 2);
  return optionsFromHandlerCallback(callback);
};

const hasNoServerOptionSpread = (options: string): boolean => !options.includes('...');

const hasExpectedServerOptionCount = (count: number | undefined): boolean => count === 3 || count === 4;

const hasServerAuthenticationOptions = (options: string, readName: string): boolean =>
  hasObjectProperties(options, {
    authenticatePrincipal: 'authenticateOperationPrincipal',
    registration: readName,
  });

const hasServerProblemsOption = (options: string): boolean => objectPropertyValue(options, 'problems') === 'problems';

const hasValidServerDomainMapperOption = (options: string, count: number | undefined): boolean =>
  count === 3 || /^[A-Za-z][A-Za-z0-9]*$/u.test(objectPropertyValue(options, 'mapDomainError') ?? '');

const hasServerOptions = (options: string, readName: string, audience?: string): boolean => {
  const count = topLevelObjectEntries(options)?.length;
  const actualAudience = objectPropertyValue(options, 'audience');
  const baseCount = actualAudience === undefined ? count : (count ?? 0) - 1;
  return (
    hasNoServerOptionSpread(options) &&
    hasExpectedServerOptionCount(baseCount) &&
    (actualAudience === undefined || (audience !== undefined && actualAudience === `'${audience}'`)) &&
    hasServerAuthenticationOptions(options, readName) &&
    hasServerProblemsOption(options) &&
    hasValidServerDomainMapperOption(options, baseCount)
  );
};

const hasDomainMapperContract = (
  source: string,
  mapperName: string | undefined,
  schemaStem: string,
  contractImport: string,
): boolean => {
  if (mapperName === undefined) {
    return true;
  }
  const expression = assignedExpression(source, new RegExp(`const ${escapeRegExp(mapperName)}\\s*=\\s*`, 'u'));
  const constructors = [
    ...new Set(
      [
        ...(expression ?? '').matchAll(
          new RegExp(`\\b(${escapeRegExp(schemaStem)}Domain[A-Za-z0-9]*ProblemSchema)\\.make\\(`, 'gu'),
        ),
      ]
        .map((match) => match[1])
        .filter((name): name is string => name !== undefined),
    ),
  ];
  return (
    expression !== undefined &&
    /^\([^)]*\)\s*:\s*[\s\S]*=>\s*\{/u.test(expression) &&
    constructors.length > 0 &&
    constructors.every((problemConstructor) => hasExactValueImport(source, problemConstructor, contractImport)) &&
    hasExactValueImport(source, 'Schema', 'effect') &&
    !/\b(?:Effect|Promise|fetch|throw|await)\b/u.test(expression)
  );
};

const hasServerContract = (
  source: string,
  escapedCamel: string,
  escapedGroup: string,
  readImport: string,
  schemaStem: string,
  contractImport: string,
  apiBinding: string,
  audience?: string,
): boolean => {
  const code = maskComments(source);
  const layerExpression = assignedExpression(code, new RegExp(`export const ${escapedCamel}ReadApiLive\\s*=\\s*`, 'u'));
  const options = serverHandlerOptions(layerExpression, escapedGroup, apiBinding);
  const domainMapperName = options === undefined ? undefined : objectPropertyValue(options, 'mapDomainError');
  return (
    options !== undefined &&
    hasServerOptions(options, `${escapedCamel}Read`, audience) &&
    hasDomainMapperContract(source, domainMapperName, schemaStem, contractImport) &&
    hasOnlyThinServerStatements(
      source,
      `${escapedCamel}ReadApiLive`,
      new Set([
        GOVERNED_READ_HTTP_MODULE,
        GOVERNED_HTTP_RUNTIME_MODULE,
        EFFECT_EDGE_MODULE,
        './auth/action-principal.ts',
        '../shared/api.ts',
        readImport,
        contractImport,
      ]),
      domainMapperName,
    ) &&
    hasContractImports(source, {
      [`${escapedCamel}Read`]: readImport,
      [apiBinding]: '../shared/api.ts',
      authenticateOperationPrincipal: './auth/action-principal.ts',
      HttpApiBuilder: EFFECT_EDGE_MODULE,
      makeGovernedReadHttpHandler: GOVERNED_READ_HTTP_MODULE,
    }) &&
    hasProblemSet(source, schemaStem, contractImport) &&
    [/HttpApiBuilder\.group\(/gu, /makeGovernedReadHttpHandler\(/gu].every((pattern) => hasExactlyOne(code, pattern))
  );
};

const hasProblemSchemaContract = (source: string, schema: string, status: number, retryable: boolean): boolean => {
  const expression = assignedExpression(source, new RegExp(`export const ${escapeRegExp(schema)}\\s*=\\s*`, 'u'));
  const factory = retryable ? 'makeRetryableProblemDetailsSchema' : 'makeProblemDetailsSchema';
  const call = new RegExp(`^${factory}\\(`, 'u');
  return (
    expression !== undefined &&
    hasExactValueImport(source, factory, '@app/shared-contracts/problem-details') &&
    isWholeCallExpression(expression, call) &&
    callArgument(expression, call) === `'${schema.replace(/Schema$/u, '')}'` &&
    callArgument(expression, call, 1) === String(status) &&
    ['', undefined].includes(callArgument(expression, call, 2)) &&
    callArgument(expression, call, 3) === undefined
  );
};

const addedContractMember = (expression: string | undefined, factory: string, name: string): string | undefined => {
  if (expression === undefined || !expression.startsWith(`${factory}.make(`)) {
    return undefined;
  }
  const make = new RegExp(`^${factory}\\.make\\(`, 'u');
  if (callArgument(expression, make) !== `'${name}'`) {
    return undefined;
  }
  const close = matchingDelimiterEnd(expression, expression.indexOf('('), '(', ')');
  if (close === undefined) {
    return undefined;
  }
  const addition = expression.slice(close + 1).trim();
  return addition.startsWith('.add(') && isWholeCallExpression(addition, /^\.add\(/u)
    ? callArgument(addition, /^\.add\(/u)
    : undefined;
};

const isExecuteEndpoint = (expression: string | undefined, endpointPath: string): boolean =>
  wholeCall(expression, /^HttpApiEndpoint\.post\(/u) &&
  callArgument(expression, /^HttpApiEndpoint\.post\(/u) === "'execute'" &&
  callArgument(expression, /^HttpApiEndpoint\.post\(/u, 1) === `'${endpointPath}'`;

const httpContractEndpointExpression = (
  source: string,
  apiValue: string,
  group: string,
  endpointPath: string,
): string | undefined => {
  const escapedApiValue = escapeRegExp(apiValue);
  const expression = assignedExpression(source, new RegExp(`export const ${escapedApiValue}\\s*=\\s*`, 'u'));
  const groupExpression = addedContractMember(expression, 'HttpApi', apiValue);
  const endpointExpression = addedContractMember(groupExpression, 'HttpApiGroup', group);
  return isExecuteEndpoint(endpointExpression, endpointPath) ? endpointExpression : undefined;
};

interface HttpProblemSchemaDefinition {
  readonly retryable: boolean;
  readonly schema: string;
  readonly status: number;
}

const httpProblemSchemaDefinitions = (schemaStem: string): readonly HttpProblemSchemaDefinition[] => [
  { retryable: false, schema: `${schemaStem}InvalidProblemSchema`, status: 400 },
  { retryable: false, schema: `${schemaStem}AuthenticationProblemSchema`, status: 401 },
  { retryable: false, schema: `${schemaStem}ForbiddenProblemSchema`, status: 403 },
  { retryable: false, schema: `${schemaStem}NotFoundProblemSchema`, status: 404 },
  { retryable: false, schema: `${schemaStem}PolicyConflictProblemSchema`, status: 409 },
  { retryable: false, schema: `${schemaStem}PolicyProblemSchema`, status: 422 },
  { retryable: true, schema: `${schemaStem}UnavailableProblemSchema`, status: 503 },
  { retryable: false, schema: `${schemaStem}InternalProblemSchema`, status: 500 },
];

const hasHttpProblemSchemaContracts = (source: string, definitions: readonly HttpProblemSchemaDefinition[]): boolean =>
  definitions.every(({ retryable, schema, status }) => hasProblemSchemaContract(source, schema, status, retryable));

const hasHttpContractImports = (source: string): boolean =>
  hasContractImports(source, {
    HttpApi: HTTP_API_CONTRACT_MODULE,
    HttpApiEndpoint: HTTP_API_CONTRACT_MODULE,
    HttpApiGroup: HTTP_API_CONTRACT_MODULE,
  });

const hasExactDomainProblemImport = (source: string, problem: string): boolean => {
  const imports = [
    ...source.matchAll(
      /^\s*import\s*\{(?<values>[^}]*)\}\s*from\s*'(?<module>\.[/][a-z][a-z0-9-]*-domain-(?:conflict|policy|unavailable)-problem\.ts)';/gmu,
    ),
  ];
  return imports.some((candidate) =>
    (candidate.groups?.values ?? '')
      .split(',')
      .map((entry) => entry.trim())
      .includes(problem),
  );
};

const isExpectedDomainProblem = (source: string, schemaStem: string, problem: string): boolean =>
  new RegExp(`^${escapeRegExp(schemaStem)}Domain(?:Conflict|Policy|Unavailable)ProblemSchema$`, 'u').test(problem) &&
  hasExactDomainProblemImport(source, problem);

/** This optional generated error has one import binding and one array reference.
 * Any additional binding/use leaves provenance unproven (including shadows and mutation).
 */
const hasCanonicalRequestSchemaProblemImport = (source: string): boolean =>
  hasExactValueImport(source, REQUEST_SCHEMA_PROBLEM_SCHEMA, '@app/shared-contracts/problem-details', true) &&
  tokenizeGovernedClient(source).filter(
    (token) => token.kind === SyntaxKind.Identifier && token.value === REQUEST_SCHEMA_PROBLEM_SCHEMA,
  ).length === 2;

const hasHttpContractErrorEntries = (
  source: string,
  schemaStem: string,
  errorEntries: readonly string[] | undefined,
  problems: readonly string[],
): boolean => {
  if (errorEntries === undefined) {
    return false;
  }
  const domainProblems = errorEntries.filter((entry) => !problems.includes(entry));
  return (
    new Set(errorEntries).size === errorEntries.length &&
    problems.every((problem) => errorEntries.includes(problem)) &&
    domainProblems.every((problem) =>
      problem === REQUEST_SCHEMA_PROBLEM_SCHEMA
        ? hasCanonicalRequestSchemaProblemImport(source)
        : isExpectedDomainProblem(source, schemaStem, problem),
    ) &&
    errorEntries.length === problems.length + domainProblems.length
  );
};

const hasHttpContractSchemaOptions = (options: string, schemaStem: string): boolean =>
  objectProperty(options, 'payload') === `${schemaStem}RequestSchema` &&
  objectProperty(options, 'success') === `${schemaStem}ResponseSchema`;

const hasHttpContract = (
  source: string,
  apiValue: string,
  group: string,
  schemaStem: string,
  endpointPath: string,
): boolean => {
  const endpointExpression = httpContractEndpointExpression(source, apiValue, group, endpointPath);
  const options = objectArgument(endpointExpression, /^HttpApiEndpoint\.post\(/u, 2);
  const definitions = httpProblemSchemaDefinitions(schemaStem);
  const problems = definitions.map(({ schema }) => schema);
  const error = objectProperty(options ?? '', 'error');
  return (
    options !== undefined &&
    hasNoServerOptionSpread(options) &&
    hasHttpContractImports(source) &&
    hasHttpProblemSchemaContracts(source, definitions) &&
    hasHttpContractErrorEntries(
      source,
      schemaStem,
      error === undefined ? undefined : topLevelArrayEntries(error),
      problems,
    ) &&
    hasHttpContractSchemaOptions(options, schemaStem)
  );
};

const hasManifestContract = (manifest: string, contribution: GovernedReadContribution, moduleId: string): boolean => {
  const allOwnerManifestEntries = entriesAcrossSlots(manifest, [
    [MANIFEST_API_SLOT_START, MANIFEST_API_SLOT_END],
    ['// <generated-module-manifest-reports>', '// </generated-module-manifest-reports>'],
    ['// <generated-module-manifest-search>', '// </generated-module-manifest-search>'],
  ]);
  if (contribution.kind === MODULE_API_KIND) {
    const apiEntries = generatedSlotEntries(manifest, MANIFEST_API_SLOT_START, MANIFEST_API_SLOT_END);
    const apiValue = contributionApiValue(contribution.kind, contribution.name);
    const manifestEntriesMatch = (entries: readonly string[] | undefined): boolean =>
      entries?.filter(
        (entry) =>
          entry === `'${contribution.contractStem}': ${apiValue}` ||
          entry === `${contribution.contractStem}: ${apiValue}`,
      ).length === 1;
    return (
      hasExactValueImport(manifest, apiValue, `./shared/apis/${contribution.contractStem}.ts`) &&
      [apiEntries, allOwnerManifestEntries].every(manifestEntriesMatch)
    );
  }
  const role = contributionRole(contribution.kind);
  const manifestSection = contribution.kind === REPORT_KIND ? 'reports' : role;
  const manifestEntries = generatedSlotEntries(
    manifest,
    `// <generated-module-manifest-${manifestSection}>`,
    `// </generated-module-manifest-${manifestSection}>`,
  );
  const shellEntries = generatedSlotEntries(
    manifest,
    `// <generated-module-shell-${manifestSection}>`,
    `// </generated-module-shell-${manifestSection}>`,
  );
  const manifestKey = `${moduleId}.${contribution.name}`;
  const entrypointKey = `${moduleId}.${role}.${contribution.name}`;
  const published = manifestEntries?.filter((entry) => objectProperty(entry, 'key') === `'${manifestKey}'`);
  const allPublished = allOwnerManifestEntries?.filter((entry) => objectProperty(entry, 'key') === `'${manifestKey}'`);
  const shellFunction = contribution.kind === REPORT_KIND ? 'reportContribution' : 'searchContribution';
  const shell = shellEntries?.filter((entry) => {
    const shellObject = objectArgument(entry, new RegExp(`^${shellFunction}\\(`, 'u'));
    const entrypoint = shellObject === undefined ? undefined : objectProperty(shellObject, 'entrypoint');
    return (
      shellObject !== undefined &&
      isWholeCallExpression(entry, new RegExp(`^${shellFunction}\\(`, 'u')) &&
      objectProperty(shellObject, 'contributionKey') === `'${entrypointKey}'` &&
      entrypoint !== undefined &&
      objectProperty(entrypoint, 'entrypointKey') === `'${entrypointKey}'` &&
      objectProperty(entrypoint, 'role') === `'${role}'`
    );
  });
  return published?.length === 1 && allPublished?.length === 1 && shell?.length === 1;
};

const hasPublishedRegistration = (registration: string, contribution: GovernedReadContribution): boolean => {
  const escapedName = escapeRegExp(contribution.name);
  const escapedContractStem = escapeRegExp(contribution.contractStem);
  const { registrationCategory, registrationSection } = contributionProfiles[contribution.kind];
  const registrationEntries = generatedSlotEntries(
    registration,
    `// <generated-module-registration-${registrationSection}>`,
    `// </generated-module-registration-${registrationSection}>`,
  );
  const allRegistrationEntries = entriesAcrossSlots(registration, [
    ['// <generated-module-registration-apis>', '// </generated-module-registration-apis>'],
    ['// <generated-module-registration-reports>', '// </generated-module-registration-reports>'],
    ['// <generated-module-registration-search>', '// </generated-module-registration-search>'],
  ]);
  const registrationPattern = new RegExp(
    `^(?:'${escapedName}'|${escapedName})\\s*:\\s*\\(\\s*\\)\\s*=>\\s*import\\(\\s*'./src/api/${escapedContractStem}-client\\.ts'\\s*\\)$`,
    'u',
  );
  const canonicalRegistrationPattern =
    /^(?:'(?<quoted>[a-z][a-z0-9]*(?:-[a-z0-9]+)*)'|(?<bare>[a-z][a-z0-9]*(?:-[a-z0-9]+)*))\s*:\s*\(\s*\)\s*=>\s*import\(\s*'\.\/src\/api\/(?<file>[a-z][a-z0-9]*(?:-[a-z0-9]+)*)-client\.ts'\s*\)$/u;
  return (
    registrationEntries?.filter((entry) => registrationPattern.test(entry)).length === 1 &&
    allRegistrationEntries?.every((entry) => {
      const match = canonicalRegistrationPattern.exec(entry);
      const name = match?.groups?.quoted ?? match?.groups?.bare;
      const file = match?.groups?.file;
      return (
        name !== undefined &&
        file !== undefined &&
        (file === name || file === `${name}-report` || file === `${name}-search`)
      );
    }) === true &&
    allRegistrationEntries?.filter((entry) => objectEntryKey(entry) === contribution.name).length === 1 &&
    slotIsInsideObjectProperty(
      registration,
      registrationCategory,
      `// <generated-module-registration-${registrationSection}>`,
      `// </generated-module-registration-${registrationSection}>`,
    )
  );
};

const publishesSharedApiContribution = (sharedApi: string, apiValue: string, contractStem: string): boolean => {
  const escapedApiValue = escapeRegExp(apiValue);
  return (
    hasExactlyOne(maskComments(sharedApi), new RegExp(`\\.addHttpApi\\(${escapedApiValue}\\)`, 'gu')) &&
    hasExactValueImport(sharedApi, apiValue, `./apis/${contractStem}.ts`) &&
    slotHasExactlyOneCodeMatch(
      sharedApi,
      GOVERNED_API_SLOT_START,
      GOVERNED_API_SLOT_END,
      new RegExp(`\\.addHttpApi\\(${escapedApiValue}\\)`, 'gu'),
    )
  );
};

const hasPublishedContract = (
  sharedApi: string,
  manifest: string,
  registration: string,
  handlerRoot: string,
  contribution: GovernedReadContribution,
  moduleId: string,
  diagnostics?: string[],
  backendRegistration?: string,
): boolean => {
  const expectedApi = governedApiBinding(sharedApi);
  const apiValue = contributionApiValue(contribution.kind, contribution.name);
  const camel = toCamelCase(contribution.name);
  const serverStem = contributionServerStem(contribution);
  const escapedCamel = escapeRegExp(camel);
  const handlerLayers = generatedSlotEntries(
    handlerRoot,
    GOVERNED_HANDLER_LAYER_SLOT_START,
    GOVERNED_HANDLER_LAYER_SLOT_END,
  );
  const expectedLayer = `${camel}ReadApiLive`;
  const isExpectedHandlerLayer = (entry: string): boolean => {
    if (!isWholeCallExpression(entry, new RegExp(`^${escapedCamel}ReadApiLive\\.pipe\\(`, 'u'))) {
      return false;
    }
    const first = callArgument(entry, new RegExp(`^${escapedCamel}ReadApiLive\\.pipe\\(`, 'u'));
    if (first !== 'GovernedReadLayer.provide(governedReadRuntimeLive)') {
      return false;
    }
    let index = 1;
    let argument = callArgument(entry, new RegExp(`^${escapedCamel}ReadApiLive\\.pipe\\(`, 'u'), index);
    while (argument !== undefined) {
      if (argument === '') {
        return callArgument(entry, new RegExp(`^${escapedCamel}ReadApiLive\\.pipe\\(`, 'u'), index + 1) === undefined;
      }
      if (!/^Layer\.provide\([A-Za-z][A-Za-z0-9]*\)$/u.test(argument)) {
        return false;
      }
      index += 1;
      argument = callArgument(entry, new RegExp(`^${escapedCamel}ReadApiLive\\.pipe\\(`, 'u'), index);
    }
    return entry.startsWith(`${expectedLayer}.pipe(`);
  };
  const publicationChecks = {
    apiBinding: expectedApi !== undefined,
    handlerImport: hasExactValueImport(handlerRoot, `${camel}ReadApiLive`, `./${serverStem}-server.ts`),
    handlerLayer: handlerLayers?.filter(isExpectedHandlerLayer).length === 1,
    handlerRoot: hasGovernedHandlerRoot(handlerRoot, backendRegistration),
    manifest: hasManifestContract(manifest, contribution, moduleId),
    mountedLayer:
      expectedApi !== undefined &&
      slotIsInsideMountedLayer(
        handlerRoot,
        GOVERNED_HANDLER_LAYER_SLOT_START,
        GOVERNED_HANDLER_LAYER_SLOT_END,
        expectedApi,
      ),
    registration: hasPublishedRegistration(registration, contribution),
    sharedContribution: publishesSharedApiContribution(sharedApi, apiValue, contribution.contractStem),
    sharedRoot: hasGovernedSharedApiRoot(sharedApi),
  };
  const failed = Object.entries(publicationChecks)
    .filter(([, valid]) => !valid)
    .map(([name]) => name);
  if (failed.length > 0) {
    diagnostics?.push(`${contribution.name} publication: ${failed.join(', ')}`);
  }
  return failed.length === 0;
};

/**
 * Recognizes every complete semantic governed-read seam emitted by the generators.
 * File presence alone is intentionally insufficient: each contract must remain
 * owner-published, privately registered, authenticated, gated, and contract-derived.
 */
const actionBoundaryHeader = '// @generated by OntOS Codesmith MicroVertical Action Boundary v1\n';
const hasActionBoundaryAuthentication = (source: string | undefined): boolean => {
  if (source === undefined || !source.startsWith(actionBoundaryHeader)) {
    return false;
  }
  const expression = assignedExpression(source, /export const authenticateOperationPrincipal\s*=\s*/u);
  return (
    expression !== undefined &&
    isWholeCallExpression(expression, /^makeMicroverticalHttpPrincipalAuthentication\(/u) &&
    hasExactValueImport(
      source,
      'makeMicroverticalHttpPrincipalAuthentication',
      '@app/core-runtime/http/principal-authentication',
    ) &&
    hasGeneratedOperationPrincipalContract(source)
  );
};
const hasActionBoundaryGateway = (source: string | undefined, appId: string): boolean =>
  source !== undefined &&
  source.startsWith(actionBoundaryHeader) &&
  assignedExpression(source, /export const operationGateway\s*=\s*/u) === 'makeOperationGateway()' &&
  hasGeneratedOperationGatewayContract(source, appId);

type GeneratedContribution = readonly [string, string, GovernedReadContribution | undefined];
const hasMatchingModuleApiSlots = (
  manifest: string,
  registration: string,
  contributions: readonly GeneratedContribution[],
  sources: ReadonlyMap<string, string>,
  ownerPath: string,
  moduleId: string,
): boolean => {
  const moduleApiCount = contributions.filter((entry) => entry[2]?.kind === MODULE_API_KIND).length;
  const manifestApis = generatedSlotEntries(manifest, MANIFEST_API_SLOT_START, MANIFEST_API_SLOT_END);
  const registrationApis = generatedSlotEntries(
    registration,
    '// <generated-module-registration-apis>',
    '// </generated-module-registration-apis>',
  );
  if (manifestApis === undefined || registrationApis?.length !== moduleApiCount) {
    return false;
  }
  const readKeys = new Set(
    contributions.flatMap((entry) => (entry[2]?.kind === MODULE_API_KIND ? [entry[2].contractStem] : [])),
  );
  const readApis = manifestApis.filter((entry) => readKeys.has(objectEntryKey(entry) ?? ''));
  const actionApis = manifestApis.filter((entry) => !readKeys.has(objectEntryKey(entry) ?? ''));
  const operationEntries = generatedSlotEntries(
    manifest,
    '// <generated-module-manifest-operation-contracts>',
    '// </generated-module-manifest-operation-contracts>',
  );
  const keys = manifestApis.map(objectEntryKey);
  return (
    readApis.length === moduleApiCount &&
    new Set(keys).size === keys.length &&
    (operationEntries === undefined ||
      operationEntries.every((entry) => {
        const apiKey = tokenizeGovernedClient(objectProperty(entry, 'apiKey') ?? '');
        return apiKey.length === 1 && apiKey[0]?.kind === SyntaxKind.StringLiteral && keys.includes(apiKey[0].value);
      })) &&
    actionApis.every((entry) => {
      const key = objectEntryKey(entry);
      if (key === undefined || !key.endsWith('-action')) {
        return false;
      }
      const slug = key.slice(0, -'-action'.length);
      const apiValue = `${toPascalCase(key)}Api`;
      const action = toCamelCase(key);
      const contract = sources.get(`${ownerPath}/shared/apis/${key}.ts`);
      const operation = operationEntries?.filter((candidate) => objectProperty(candidate, 'apiKey') === `'${key}'`);
      const claim = operation?.length === 1 ? operation[0] : undefined;
      return (
        contract !== undefined &&
        hasGeneratedSourceHeader(
          contract,
          `${ACTION_HTTP_HEADER}// @ontos-action-http-owner ${moduleId}\n// @ontos-action-http-slug ${slug}\n`,
        ) &&
        [HTTP_API_CONTRACT_MODULE, '@modern-js/bff-effect/effect-client'].some((module) =>
          hasContractImports(contract, { HttpApi: module, HttpApiEndpoint: module, HttpApiGroup: module }),
        ) &&
        (entry === `'${key}': ${apiValue}` || entry === `${key}: ${apiValue}`) &&
        hasExactValueImport(manifest, apiValue, `./shared/apis/${key}.ts`) &&
        hasExactValueImport(manifest, action, `./src/actions/${slug}.action.ts`) &&
        claim !== undefined &&
        topLevelObjectEntries(claim)?.length === 3 &&
        objectProperty(claim, 'operationKey') === `'${action}.execute'` &&
        objectProperty(claim, 'registration') === action
      );
    })
  );
};

const governedOwnerModuleId = (manifest: string | undefined): string | undefined =>
  /^\/\/ @ontos-module-id (?<moduleId>[^\s]+)$/mu.exec(manifest ?? '')?.groups?.moduleId;

/** Keep the generated call shape while permitting a checked, declaration-safe Action type. */
export const hasGeneratedActionRegistrationBinding = (
  source: string,
  camel: string,
  type: string,
  moduleId: string,
): boolean => {
  const actionName = escapeRegExp(`${camel}Action`);
  const direct = new RegExp(`^export const ${actionName} = defineAction\\(`, 'mu');
  const typed = new RegExp(
    `^export const ${actionName}\\s*:\\s*ActionRegistration<\\s*typeof ${escapeRegExp(type)}PayloadSchema\\s*,\\s*typeof ${escapeRegExp(type)}ResultSchema\\s*,\\s*typeof (?<error>[A-Z][A-Za-z0-9]*ErrorSchema)\\s*,\\s*(?<events>Readonly<Record<string, never>>|typeof domainEvents)\\s*,\\s*['"]${escapeRegExp(moduleId)}['"]\\s*,\\s*(?<services>[A-Z][A-Za-z0-9]*Services)(?:\\s*,\\s*(?<requirements>[A-Z][A-Za-z0-9]*))?\\s*>\\s*=\\s*defineAction\\(`,
    'mu',
  );
  const directMatch = direct.exec(source);
  if (directMatch !== null && isCodePosition(source, directMatch.index)) {
    return true;
  }
  const typedMatch = typed.exec(source);
  return (
    typedMatch !== null &&
    isCodePosition(source, typedMatch.index) &&
    source.includes(`domainErrorSchema: ${typedMatch.groups?.error},`) &&
    (typedMatch.groups?.events !== 'typeof domainEvents' || source.includes('domainEvents,')) &&
    source.includes(`payloadSchema: ${type}PayloadSchema,`) &&
    source.includes(`resultSchema: ${type}ResultSchema,`)
  );
};

export const hasGeneratedActionKeyIdentity = (source: string, expectedKey: string): boolean => {
  const escapedKey = escapeRegExp(expectedKey);
  if (new RegExp(`actionKey:\\s*(?<quote>['"])${escapedKey}\\k<quote>`, 'u').test(source)) {
    return true;
  }
  const declarations = [
    ...source.matchAll(
      /\bconst\s+(?<alias>[A-Za-z_$][\w$]*)\s*=\s*(?<quote>['"])(?<key>[^'"\r\n]*)\k<quote>\s*(?:as\s+const\s*)?;/gu,
    ),
  ].filter((match) => isCodePosition(source, match.index));
  return declarations.some((declaration) => {
    if (declaration.groups?.key !== expectedKey) {
      return false;
    }
    const { alias } = declaration.groups;
    if (declarations.filter((candidate) => candidate.groups?.alias === alias).length !== 1) {
      return false;
    }
    const property = new RegExp(`\\bactionKey\\s*(?::\\s*${escapeRegExp(alias)}\\b|(?=\\s*[,}]))`, 'gu');
    return [...source.matchAll(property)].some(
      (match) => match.index > declaration.index && isCodePosition(source, match.index),
    );
  });
};

export const hasGeneratedActionClientPublication = (
  source: string,
  slug: string,
  clientImport = `./${slug}-action-client.ts`,
): boolean => {
  const type = escapeRegExp(toPascalCase(slug));
  return slotHasExactlyOneCodeMatch(
    source,
    '// <generated-action-http-client-exports>',
    '// </generated-action-http-client-exports>',
    new RegExp(
      `export\\s+(?:\\*|\\{\\s*(?:execute${type}WithAuthorization,\\s*execute${type}|execute${type},\\s*execute${type}WithAuthorization),?\\s*\\})\\s+from '${escapeRegExp(clientImport)}';`,
      'gu',
    ),
  );
};

const publicContractSourceLocation = (
  packagePath: string,
  exportedPath: string | undefined,
): PublicContractSourceLocation | undefined => {
  if (exportedPath === undefined || !exportedPath.startsWith('./') || !exportedPath.endsWith('.ts')) {
    return undefined;
  }
  const packageDirectory = path.posix.dirname(packagePath);
  const sourcePath = path.posix.normalize(path.posix.join(packageDirectory, exportedPath));
  return sourcePath.startsWith(`${packageDirectory}/`) ? { packageDirectory, sourcePath } : undefined;
};

export const ownerActionClientPublication = (
  sources: ReadonlyMap<string, string>,
  ownerPath: string,
  appId: string,
): { readonly file: string; readonly source: string } | undefined => {
  const raw = sources.get(`${ownerPath}/package.json`);
  const schema = Schema.Struct({ exports: Schema.optionalKey(Schema.Record(Schema.String, Schema.String)) });
  const metadata =
    raw === undefined
      ? undefined
      : Option.getOrUndefined(Schema.decodeUnknownOption(Schema.fromJsonString(schema))(raw));
  if (raw !== undefined && metadata === undefined) {
    return undefined;
  }
  const target = metadata?.exports === undefined ? `./src/api/${appId}-client.ts` : metadata.exports['./api/client'];
  const location = publicContractSourceLocation(`${ownerPath}/package.json`, target);
  const source = location === undefined ? undefined : sources.get(location.sourcePath);
  return location === undefined || source === undefined ? undefined : { file: location.sourcePath, source };
};

export const hasNativeHttpActionMount = (source: string, layer: string): boolean => {
  const slot = generatedSlotRange(source, GOVERNED_HANDLER_LAYER_SLOT_START, GOVERNED_HANDLER_LAYER_SLOT_END);
  const transport = namedSourceImport(source, 'GovernedFetchHttpClient');
  if (slot === undefined || transport?.imported !== 'FetchHttpClient' || transport.modulePath !== 'effect/http') {
    return false;
  }
  const body = source.slice(slot.bodyStart, slot.bodyEnd);
  const entries = separatedSource(
    body,
    topLevelSeparators(maskNonCode(body), ',', 0, body.length, true),
    0,
    body.length,
  );
  const mounts = entries.filter((entry) => entry.trim().startsWith(`${layer}.pipe(`));
  const mount = mounts.length === 1 ? mounts[0] : undefined;
  const args =
    mount === undefined ? undefined : wholeCallArguments(mount, new RegExp(`^${escapeRegExp(layer)}\\.pipe\\(`, 'u'));
  return (
    args?.length === 2 &&
    hasExactSourceTokens(
      tokenizeGovernedClient(args[0] ?? ''),
      'GovernedReadLayer.provide(governedActionRuntimeLive)',
    ) &&
    hasExactSourceTokens(
      tokenizeGovernedClient(args[1] ?? ''),
      `GovernedReadLayer.provide(
      GovernedFetchHttpClient.layer.pipe(GovernedReadLayer.provide(
        GovernedReadLayer.succeed(GovernedFetchHttpClient.RequestInit, { cache: 'no-store', redirect: 'manual' })
      )))`,
    )
  );
};

const hasCompleteGeneratedActionHttpSeam = (input: {
  readonly deploymentAppId: string;
  readonly handlerRoot: string;
  readonly manifest: string;
  readonly moduleId: string;
  readonly registration: string;
  readonly runtimeDeclaration: string | undefined;
  readonly sharedApi: string;
  readonly sources: ReadonlyMap<string, string>;
  readonly verticalPath: string;
}): boolean => {
  const contractPrefix = `${input.verticalPath}/shared/apis/`;
  const actionContracts = [...input.sources.entries()].filter(
    ([candidate, source]) =>
      candidate.startsWith(contractPrefix) &&
      candidate.endsWith('-action.ts') &&
      !candidate.slice(contractPrefix.length).includes('/') &&
      source.startsWith(ACTION_HTTP_HEADER),
  );
  const publication = ownerActionClientPublication(input.sources, input.verticalPath, input.deploymentAppId);
  return actionContracts.every(([contractPath, contract]) => {
    const stem = path.posix.basename(contractPath, '.ts');
    const slug = stem.slice(0, -'-action'.length);
    const type = toPascalCase(slug);
    const camel = toCamelCase(slug);
    const apiValue = `${type}ActionApi`;
    const layerValue = `${camel}ActionApiLive`;
    const expectedHeader = `${ACTION_HTTP_HEADER}// @ontos-action-http-owner ${input.moduleId}\n// @ontos-action-http-slug ${slug}\n`;
    const actionSource = input.sources.get(`${input.verticalPath}/src/actions/${slug}.action.ts`) ?? '';
    const problems = input.sources.get(`${input.verticalPath}/api/${slug}-action-problems.ts`) ?? '';
    const server = input.sources.get(`${input.verticalPath}/api/${slug}-action-server.ts`) ?? '';
    const client = input.sources.get(`${input.verticalPath}/src/api/${slug}-action-client.ts`) ?? '';
    const clientRoot = publication?.source ?? '';
    const clientRelativeImport =
      publication === undefined
        ? undefined
        : path.posix.relative(
            path.posix.dirname(publication.file),
            `${input.verticalPath}/src/api/${slug}-action-client.ts`,
          );
    const clientImport =
      clientRelativeImport?.startsWith('.') === true ? clientRelativeImport : `./${clientRelativeImport ?? ''}`;
    if (![contract, problems, server, client].every((source) => source.startsWith(expectedHeader))) {
      return false;
    }
    const escapedSlug = escapeRegExp(slug);
    const escapedApiValue = escapeRegExp(apiValue);
    const escapedLayerValue = escapeRegExp(layerValue);
    const escapedActionValue = escapeRegExp(`${camel}Action`);
    return [
      actionSource.startsWith(
        `// @generated by OntOS Codesmith Action v1\n// @ontos-action-owner ${input.moduleId}\n// @ontos-action-slug ${slug}\n`,
      ),
      hasGeneratedActionRegistrationBinding(actionSource, camel, type, input.moduleId),
      hasGeneratedActionKeyIdentity(actionSource, `${input.moduleId}.${slug}`),
      new RegExp(
        `HttpApiEndpoint\\.post\\(\\s*'execute',\\s*'/${escapeRegExp(input.deploymentAppId)}/actions/${escapedSlug}'`,
        'u',
      ).test(contract),
      new RegExp(
        `export const ${escapedApiValue}\\s*=\\s*HttpApi\\.make\\(\\s*'${escapedApiValue}',?\\s*\\)`,
        'u',
      ).test(contract),
      new RegExp(`HttpApiGroup\\.make\\(\\s*'${escapeRegExp(camel)}Action',?\\s*\\)`, 'u').test(contract),
      problems.includes(`export const map${type}ActionProblem =`),
      problems.includes(`from '../src/actions/${slug}.action.ts'`),
      server.includes(`const runActionHttp = bindActionHttpRunner({`),
      server.includes(`registration: ${camel}Action`),
      server.includes(`export const ${layerValue} = HttpApiBuilder.group(`),
      client.includes(`from '../../shared/apis/${slug}-action.ts'`),
      client.includes("from './action-gateway.ts'"),
      new RegExp(
        `operationGateway\\.invoke\\(\\s*\\(credential,\\s*\\{\\s*apiBaseUrl,\\s*compositionRevision\\s*\\}\\)\\s*=>\\s*execute${escapeRegExp(type)}WithAuthorization\\(\\s*payload,\\s*credential,\\s*requestCorrelation,\\s*\\{\\s*\\.\\.\\.options,\\s*baseUrl:\\s*apiBaseUrl,\\s*compositionRevision,?\\s*\\}\\s*,?\\s*\\)`,
        'u',
      ).test(client),
      publishesSharedApiContribution(input.sharedApi, escapedApiValue, escapeRegExp(stem)),
      slotHasExactlyOneCodeMatch(
        input.handlerRoot,
        '// <generated-governed-http-handler-imports>',
        '// </generated-governed-http-handler-imports>',
        new RegExp(`import \\{ ${escapedLayerValue} \\} from './${escapedSlug}-action-server\\.ts';`, 'gu'),
      ),
      slotHasExactlyOneCodeMatch(
        input.handlerRoot,
        GOVERNED_HANDLER_LAYER_SLOT_START,
        GOVERNED_HANDLER_LAYER_SLOT_END,
        new RegExp(
          `\\b${escapedLayerValue}\\.pipe\\(\\s*GovernedReadLayer\\.provide\\(governedActionRuntimeLive\\),?\\s*\\),`,
          'gu',
        ),
      ) || hasNativeHttpActionMount(input.handlerRoot, layerValue),
      hasGeneratedActionClientPublication(clientRoot, slug, clientImport),
      slotHasExactlyOneCodeMatch(
        input.manifest,
        '// <generated-module-manifest-actions>',
        '// </generated-module-manifest-actions>',
        new RegExp(`\\b${escapedActionValue},`, 'gu'),
      ),
      slotHasExactlyOneCodeMatch(
        input.runtimeDeclaration ?? input.registration,
        input.runtimeDeclaration === undefined
          ? '// <generated-module-registration-actions>'
          : '// <generated-module-manifest-actions>',
        input.runtimeDeclaration === undefined
          ? '// </generated-module-registration-actions>'
          : '// </generated-module-manifest-actions>',
        new RegExp(`\\b${escapedActionValue},`, 'gu'),
      ),
    ].every(Boolean);
  });
};

const PublicContractOwnerAppIdSchema = Schema.String.pipe(Schema.brand('PublicContractOwnerAppId'));
const PublicContractOwnerModuleIdSchema = Schema.String.pipe(Schema.brand('PublicContractOwnerModuleId'));
const PublicContractPackageManifestSchema = Schema.Struct({
  exports: Schema.Record(Schema.String, Schema.String),
  name: Schema.String,
  ontosContractOwner: Schema.Struct({
    appId: PublicContractOwnerAppIdSchema,
    moduleApis: Schema.Array(Schema.String),
    moduleId: PublicContractOwnerModuleIdSchema,
    packageName: Schema.String,
  }),
});
const OwnerPackageManifestSchema = Schema.Struct({ name: Schema.String });

interface ResolvedPublicContract {
  readonly packagePath: string;
  readonly source: string;
  readonly sourcePath: string;
  readonly specifier: string;
}

type ExpectedPublicContractOwner = {
  readonly appId: string;
  readonly moduleId: string;
  readonly packageName: string;
} & ({ readonly moduleApi: string } | { readonly actionSlug: string });

interface PublicContractSpecifierParts {
  readonly exportName: string;
  readonly packageName: string;
}

interface PublicContractSourceLocation {
  readonly packageDirectory: string;
  readonly sourcePath: string;
}

type PublicContractPackageManifest = typeof PublicContractPackageManifestSchema.Type;

const publicContractSpecifier = (source: string): string | undefined => {
  const annotated = /^\/\/ @ontos-public-contract (?<specifier>@app\/[a-z][a-z0-9-]*(?:\/[a-z][a-z0-9-]*)*)$/mu.exec(
    source,
  )?.groups?.specifier;
  return (
    annotated ??
    /^\s*export\s+\*\s+from\s+(?<quote>['"])(?<specifier>@app\/[a-z][a-z0-9-]*(?:\/[a-z][a-z0-9-]*)*)\k<quote>;\s*$/u.exec(
      maskComments(source),
    )?.groups?.specifier
  );
};

const namedPublicContractMembersEnd = (
  tokens: ReturnType<typeof tokenizeGovernedClient>,
  start: number,
  typeOnly: boolean,
): number | undefined => {
  let cursor = start;
  let names = 0;
  while (tokens[cursor]?.kind !== SyntaxKind.CloseBraceToken) {
    if (!typeOnly && tokens[cursor]?.kind === SyntaxKind.TypeKeyword) {
      cursor += 1;
    }
    if (tokens[cursor]?.kind !== SyntaxKind.Identifier) {
      return undefined;
    }
    cursor += 1;
    names += 1;
    if (tokens[cursor]?.kind === SyntaxKind.CommaToken) {
      cursor += 1;
    } else if (tokens[cursor]?.kind !== SyntaxKind.CloseBraceToken) {
      return undefined;
    }
  }
  return names === 0 ? undefined : cursor;
};

/** Every token must belong to a static named reexport from the one approved public target. */
const hasClosedNamedPublicContractExports = (
  tokens: ReturnType<typeof tokenizeGovernedClient>,
  specifier: string,
): boolean => {
  let cursor = 0;
  while (cursor < tokens.length) {
    if (tokens[cursor]?.kind !== SyntaxKind.ExportKeyword) {
      return false;
    }
    cursor += 1;
    const typeOnly = tokens[cursor]?.kind === SyntaxKind.TypeKeyword;
    if (typeOnly) {
      cursor += 1;
    }
    if (tokens[cursor]?.kind !== SyntaxKind.OpenBraceToken) {
      return false;
    }
    const close = namedPublicContractMembersEnd(tokens, cursor + 1, typeOnly);
    if (close === undefined || !hasExactSourceTokens(tokens.slice(close + 1, close + 4), `from '${specifier}';`)) {
      return false;
    }
    cursor = close + 4;
  }
  return tokens.length > 0;
};

const isClosedPublicContractExport = (source: string, specifier: string): boolean => {
  if (publicContractSpecifier(source) !== specifier) {
    return false;
  }
  const tokens = tokenizeGovernedClient(source);
  return (
    hasExactSourceTokens(tokens, `export * from '${specifier}';`) ||
    hasClosedNamedPublicContractExports(tokens, specifier)
  );
};

const isExactPublicContractShim = (source: string, header: string, specifier: string): boolean =>
  hasGeneratedSourceHeader(source, header) && isClosedPublicContractExport(source, specifier);

const publicContractSpecifierParts = (specifier: string): PublicContractSpecifierParts | undefined => {
  const [scope, packageStem, ...subpathSegments] = specifier.split('/');
  return scope !== '@app' || packageStem === undefined || subpathSegments.length === 0
    ? undefined
    : {
        exportName: `./${subpathSegments.join('/')}`,
        packageName: `${scope}/${packageStem}`,
      };
};

const publicContractPackageManifests = (
  sources: ReadonlyMap<string, string>,
  packageName: string,
): readonly (readonly [string, PublicContractPackageManifest])[] =>
  [...sources.entries()].flatMap(([candidate, source]) => {
    if (!candidate.startsWith('packages/') || !candidate.endsWith('/package.json')) {
      return [];
    }
    const decoded = Option.getOrUndefined(
      Schema.decodeUnknownOption(Schema.fromJsonString(PublicContractPackageManifestSchema))(source),
    );
    return decoded?.name === packageName ? [[candidate, decoded] as const] : [];
  });

const hasExpectedPublicContractOwner = (
  manifest: PublicContractPackageManifest,
  expected: ExpectedPublicContractOwner,
): boolean =>
  manifest.ontosContractOwner.appId === expected.appId &&
  manifest.ontosContractOwner.moduleId === expected.moduleId &&
  manifest.ontosContractOwner.packageName === expected.packageName &&
  (!('moduleApi' in expected) || manifest.ontosContractOwner.moduleApis.includes(expected.moduleApi));

const hasGeneratedActionContractTarget = (
  source: string,
  expected: ExpectedPublicContractOwner & { readonly actionSlug: string },
): boolean => {
  const type = toPascalCase(expected.actionSlug);
  return (
    hasGeneratedSourceHeader(
      source,
      `${ACTION_HTTP_HEADER}// @ontos-action-http-owner ${expected.moduleId}\n// @ontos-action-http-slug ${expected.actionSlug}\n`,
    ) &&
    hasHttpContractImports(source) &&
    hasConnectedGeneratedActionContract(source, {
      apiValue: `${type}ActionApi`,
      endpoint: `/${expected.appId}/actions/${expected.actionSlug}`,
      group: `${toCamelCase(expected.actionSlug)}Action`,
      invalidProblem: `${type}ActionInvalidProblemSchema`,
      middleware: `${type}ActionSchemaErrorMiddleware`,
      middlewareKey: `${expected.appId}/${type}ActionSchemaErrorMiddleware`,
    })
  );
};

const resolvePublicContract = (
  sources: ReadonlyMap<string, string>,
  specifier: string,
  expected: ExpectedPublicContractOwner,
): ResolvedPublicContract | undefined => {
  const parts = publicContractSpecifierParts(specifier);
  if (parts === undefined) {
    return undefined;
  }
  const manifests = publicContractPackageManifests(sources, parts.packageName);
  if (manifests.length !== 1) {
    return undefined;
  }
  const [packagePath, manifest] = manifests[0] ?? [];
  if (packagePath === undefined || manifest === undefined || !hasExpectedPublicContractOwner(manifest, expected)) {
    return undefined;
  }
  const location = publicContractSourceLocation(packagePath, manifest.exports[parts.exportName]);
  if (location === undefined) {
    return undefined;
  }
  const source = sources.get(location.sourcePath);
  if (source === undefined || ('actionSlug' in expected && !hasGeneratedActionContractTarget(source, expected))) {
    return undefined;
  }
  return { packagePath: location.packageDirectory, source, sourcePath: location.sourcePath, specifier };
};

interface ContributionSourceCandidates {
  readonly ownerClientSource: string | undefined;
  readonly readImport: string;
  readonly readSource: string | undefined;
  readonly serverSource: string | undefined;
}

type DefinedContributionSourceCandidates = ContributionSourceCandidates & {
  readonly ownerClientSource: string;
  readonly readSource: string;
  readonly serverSource: string;
};

interface LoadedContributionSources {
  readonly clientSource: string;
  readonly contractImport: string;
  readonly contractSource: string;
  readonly readImport: string;
  readonly readSource: string;
  readonly serverSource: string;
}

interface PublicContributionSourceInput {
  readonly candidates: DefinedContributionSourceCandidates;
  readonly clientSpecifier: string | undefined;
  readonly contractSpecifier: string | undefined;
  readonly contribution: GovernedReadContribution;
  readonly deploymentAppId: string;
  readonly header: string;
  readonly moduleId: string;
  readonly ownerContractSource: string;
  readonly ownerPackageName: string;
  readonly sources: ReadonlyMap<string, string>;
}

type ValidPublicContributionSourceInput = PublicContributionSourceInput & {
  readonly clientSpecifier: string;
  readonly contractSpecifier: string;
};

interface ResolvedPublicContributionSources {
  readonly client: ResolvedPublicContract;
  readonly contract: ResolvedPublicContract;
}

const contributionSourceCandidates = (
  sources: ReadonlyMap<string, string>,
  verticalPath: string,
  contribution: GovernedReadContribution,
): ContributionSourceCandidates => {
  const readDirectory = contributionReadDirectory(contribution.kind);
  const { readSuffix } = contributionProfiles[contribution.kind];
  const readPath = `src/${readDirectory}/${contribution.name}${readSuffix}.ts`;
  return {
    ownerClientSource: sources.get(`${verticalPath}/src/api/${contribution.contractStem}-client.ts`),
    readImport: `../${readPath}`,
    readSource: sources.get(`${verticalPath}/${readPath}`),
    serverSource: sources.get(`${verticalPath}/api/${contributionServerStem(contribution)}-server.ts`),
  };
};

const hasDefinedContributionSources = (
  candidates: ContributionSourceCandidates,
  // oxlint-disable-next-line effect-native/no-refinement-outside-schema -- This narrows correlated in-memory Map lookups; introducing a runtime document schema would change the generated-boundary check rather than validate external data.
): candidates is DefinedContributionSourceCandidates =>
  candidates.readSource !== undefined &&
  candidates.ownerClientSource !== undefined &&
  candidates.serverSource !== undefined;

const hasGeneratedContributionHeaders = (candidates: DefinedContributionSourceCandidates, header: string): boolean =>
  [candidates.readSource, candidates.ownerClientSource, candidates.serverSource].every((source) =>
    hasGeneratedSourceHeader(source, header),
  );

const ownerLocalContributionSources = (
  candidates: DefinedContributionSourceCandidates,
  contribution: GovernedReadContribution,
  ownerContractSource: string,
): LoadedContributionSources => ({
  clientSource: candidates.ownerClientSource,
  contractImport: `../../shared/apis/${contribution.contractStem}.ts`,
  contractSource: ownerContractSource,
  readImport: candidates.readImport,
  readSource: candidates.readSource,
  serverSource: candidates.serverSource,
});

const hasValidPublicContributionSourcePaths = (
  input: PublicContributionSourceInput,
  // oxlint-disable-next-line effect-native/no-refinement-outside-schema -- This predicate validates cross-file generated source relationships, which are contextual filesystem invariants rather than properties of a standalone data schema.
): input is ValidPublicContributionSourceInput =>
  input.contribution.kind === MODULE_API_KIND &&
  input.contractSpecifier !== undefined &&
  input.clientSpecifier === `${input.contractSpecifier}/client` &&
  isExactPublicContractShim(input.ownerContractSource, input.header, input.contractSpecifier) &&
  isExactPublicContractShim(input.candidates.ownerClientSource, input.header, input.clientSpecifier);

const resolvePublicContributionSources = (
  input: ValidPublicContributionSourceInput,
  expectedOwner: ExpectedPublicContractOwner,
): ResolvedPublicContributionSources | undefined => {
  const contract = resolvePublicContract(input.sources, input.contractSpecifier, expectedOwner);
  const client = resolvePublicContract(input.sources, input.clientSpecifier, expectedOwner);
  return contract !== undefined &&
    client !== undefined &&
    contract.packagePath === client.packagePath &&
    contract.source.startsWith(input.header) &&
    client.source.startsWith(input.header) &&
    hasActionBoundaryGateway(
      input.sources.get(`${contract.packagePath}/src/api/action-gateway.ts`),
      input.deploymentAppId,
    )
    ? { client, contract }
    : undefined;
};

const publicContributionSources = (input: PublicContributionSourceInput): LoadedContributionSources | undefined => {
  if (!hasValidPublicContributionSourcePaths(input)) {
    return undefined;
  }
  const expectedOwner = {
    appId: input.deploymentAppId,
    moduleApi: input.contribution.name,
    moduleId: input.moduleId,
    packageName: input.ownerPackageName,
  };
  const resolved = resolvePublicContributionSources(input, expectedOwner);
  if (resolved === undefined) {
    return undefined;
  }
  const { candidates } = input;
  const { client, contract } = resolved;
  const relativeContractImport = path.posix.relative(path.posix.dirname(client.sourcePath), contract.sourcePath);
  return {
    clientSource: client.source,
    contractImport: relativeContractImport.startsWith('.') ? relativeContractImport : `./${relativeContractImport}`,
    contractSource: contract.source,
    readImport: candidates.readImport,
    readSource: candidates.readSource,
    serverSource: candidates.serverSource,
  };
};

type OwnerPackageManifest = typeof OwnerPackageManifestSchema.Type;

interface GeneratedModuleApiSeamInputs {
  readonly gateway: string | undefined;
  readonly handlerRoot: string | undefined;
  readonly manifest: string | undefined;
  readonly moduleId: string | undefined;
  readonly ownerPackage: OwnerPackageManifest | undefined;
  readonly principal: string | undefined;
  readonly registration: string | undefined;
  readonly runtimeDeclaration: string | undefined;
  readonly sharedApi: string | undefined;
  readonly verticalPath: string;
}

type CompleteGeneratedModuleApiSeamInputs = GeneratedModuleApiSeamInputs & {
  readonly handlerRoot: string;
  readonly manifest: string;
  readonly moduleId: string;
  readonly ownerPackage: OwnerPackageManifest;
  readonly registration: string;
  readonly sharedApi: string;
};

interface GeneratedContributionValidationContext {
  readonly backendRegistration: string | undefined;
  readonly deploymentAppId: string;
  readonly diagnostics: string[] | undefined;
  readonly handlerRoot: string;
  readonly manifest: string;
  readonly moduleId: string;
  readonly ownerPackageName: string;
  readonly registration: string;
  readonly sharedApi: string;
}

const generatedOwnerMarker = (source: string, key: string): string | undefined =>
  new RegExp(`^// @ontos-${key} ([^\\s]+)$`, 'mu').exec(source)?.[1];

const provedRuntimeDeclaration = (
  runtime: string | undefined,
  manifest: string | undefined,
  registration: string | undefined,
  ownerPath: string,
): string | undefined => {
  if (runtime === undefined || manifest === undefined || registration === undefined) {
    return undefined;
  }
  try {
    const markersMatch = ['deployment-app-id', 'module-id'].every(
      (key) =>
        generatedOwnerMarker(runtime, key) !== undefined &&
        generatedOwnerMarker(runtime, key) === generatedOwnerMarker(manifest, key) &&
        generatedOwnerMarker(runtime, key) === generatedOwnerMarker(registration, key),
    );
    return runtime.startsWith('// @generated by OntOS Codesmith Module Contract v1\n') &&
      markersMatch &&
      validRuntimeDeclarationViews(
        runtime,
        manifest,
        registration,
        toCamelCase(path.posix.basename(ownerPath)),
        governedOwnerModuleId(manifest),
      )
      ? runtime
      : undefined;
  } catch {
    return undefined;
  }
};

const generatedModuleApiSeamInputs = (
  sources: ReadonlyMap<string, string>,
  sharedApiFile: string,
): GeneratedModuleApiSeamInputs => {
  const verticalPath = sharedApiFile.slice(0, -'/shared/api.ts'.length);
  const fullManifest = sources.get(`${verticalPath}/vertical.manifest.ts`);
  const registration = sources.get(`${verticalPath}/vertical.registration.ts`);
  const runtime = sources.get(`${verticalPath}/vertical.runtime-declaration.ts`);
  const runtimeDeclaration = provedRuntimeDeclaration(runtime, fullManifest, registration, verticalPath);
  const requiresRuntime =
    runtime !== undefined ||
    [fullManifest, registration].some((source) => source?.includes('vertical.runtime-declaration') === true);
  const declaredManifest = runtimeDeclaration === undefined ? undefined : `${fullManifest}\n${runtimeDeclaration}`;
  const manifest = requiresRuntime ? declaredManifest : fullManifest;
  const ownerPackage = Option.getOrUndefined(
    Schema.decodeUnknownOption(Schema.fromJsonString(OwnerPackageManifestSchema))(
      sources.get(`${verticalPath}/package.json`) ?? '',
    ),
  );
  return {
    gateway: sources.get(`${verticalPath}/src/api/action-gateway.ts`),
    handlerRoot: sources.get(`${verticalPath}/api/index.ts`),
    manifest,
    moduleId: governedOwnerModuleId(manifest),
    ownerPackage,
    principal: sources.get(`${verticalPath}/api/auth/action-principal.ts`),
    registration,
    runtimeDeclaration,
    sharedApi: sources.get(sharedApiFile),
    verticalPath,
  };
};

const hasCompleteGeneratedModuleApiSeamInputs = (
  inputs: GeneratedModuleApiSeamInputs,
  // oxlint-disable-next-line effect-native/no-refinement-outside-schema -- This narrows correlated optional source-discovery results; schema decoding would expand the generated checker and alter its existing boolean boundary.
): inputs is CompleteGeneratedModuleApiSeamInputs =>
  inputs.sharedApi !== undefined &&
  inputs.manifest !== undefined &&
  inputs.registration !== undefined &&
  inputs.handlerRoot !== undefined &&
  inputs.moduleId !== undefined &&
  inputs.ownerPackage !== undefined;

const hasCompleteActionBoundary = (
  inputs: GeneratedModuleApiSeamInputs,
  deploymentAppId: string,
  diagnostics: string[] | undefined,
): boolean => {
  const complete =
    hasActionBoundaryAuthentication(inputs.principal) && hasActionBoundaryGateway(inputs.gateway, deploymentAppId);
  if (!complete) {
    diagnostics?.push('owner authentication or gateway');
  }
  return complete;
};

const hasCompleteContributionContract = (
  contractSource: string,
  contribution: GovernedReadContribution,
  apiValue: string,
  group: string,
  schemaStem: string,
  endpointPath: string,
): boolean =>
  hasHttpContract(contractSource, apiValue, group, schemaStem, endpointPath) &&
  (contribution.kind !== MODULE_API_KIND ||
    hasGeneratedModuleApiContract(contractSource, apiValue, toCamelCase(contribution.name), contribution.name));

const hasCompleteContributionRead = (
  readSource: string,
  contribution: GovernedReadContribution,
  moduleId: string,
  sources: ReadonlyMap<string, string>,
  readFile: string,
  ownerPath: string,
): boolean =>
  hasReadContract(readSource, contribution, moduleId, sources, readFile, ownerPath) &&
  (contribution.kind !== MODULE_API_KIND ||
    hasGeneratedModuleApiReadContract(
      readSource,
      moduleId,
      contribution.name,
      undefined,
      generatedModuleApiEntrypointReference(readSource, `${toCamelCase(contribution.name)}Read`)?.name,
    ));

export const hasPublishedGeneratedContractShim = (
  sources: ReadonlyMap<string, string>,
  file: string,
  source: string,
): boolean => {
  const specifier = publicContractSpecifier(source);
  if (
    specifier === undefined ||
    !isClosedPublicContractExport(source, specifier) ||
    !/^(?:apps|verticals)\/[^/]+\/shared\/apis\/[a-z][a-z0-9-]*\.ts$/u.test(file)
  ) {
    return false;
  }
  const ownerPath = file.slice(0, file.indexOf('/shared/apis/'));
  const inputs = generatedModuleApiSeamInputs(sources, `${ownerPath}/shared/api.ts`);
  if (!hasCompleteGeneratedModuleApiSeamInputs(inputs)) {
    return false;
  }
  const appId = /^\/\/ @ontos-deployment-app-id (?<appId>[^\s]+)$/mu.exec(inputs.manifest)?.groups?.appId;
  if (appId === undefined) {
    return false;
  }
  const name = path.posix.basename(file, '.ts');
  const owner = { appId, moduleId: inputs.moduleId, packageName: inputs.ownerPackage.name };
  if (name.endsWith('-action')) {
    return (
      resolvePublicContract(sources, specifier, { ...owner, actionSlug: name.slice(0, -'-action'.length) }) !==
      undefined
    );
  }
  const contract = resolvePublicContract(sources, specifier, { ...owner, moduleApi: name });
  return (
    contract !== undefined &&
    hasGeneratedSourceHeader(contract.source, MODULE_API_HEADER) &&
    hasHttpContractImports(contract.source) &&
    hasGeneratedModuleApiContract(contract.source, `${toPascalCase(name)}Api`, toCamelCase(name), name)
  );
};

const publishedModuleReadContribution = (
  sources: ReadonlyMap<string, string>,
  candidate: string,
  source: string,
): GovernedReadContribution | undefined => {
  const name = path.posix.basename(candidate, '.ts');
  return !name.endsWith('-action') && hasPublishedGeneratedContractShim(sources, candidate, source)
    ? { contractStem: name, kind: MODULE_API_KIND, name }
    : undefined;
};

const generatedReadContributions = (
  sources: ReadonlyMap<string, string>,
  verticalPath: string,
): readonly GeneratedContribution[] => {
  const contractPrefix = `${verticalPath}/shared/apis/`;
  return [...sources.entries()].flatMap(([candidate, source]): readonly GeneratedContribution[] => {
    if (
      !candidate.startsWith(contractPrefix) ||
      !candidate.endsWith('.ts') ||
      candidate.slice(contractPrefix.length).includes('/')
    ) {
      return [];
    }
    const published = publishedModuleReadContribution(sources, candidate, source);
    const generated =
      hasGeneratedSourceHeader(source, MODULE_API_HEADER) ||
      hasGeneratedSourceHeader(source, GOVERNED_CONTRIBUTION_HEADER);
    return generated || published !== undefined
      ? [[candidate, source, governedReadContribution(path.posix.basename(candidate, '.ts'), source) ?? published]]
      : [];
  });
};

const loadContributionSources = (
  sources: ReadonlyMap<string, string>,
  verticalPath: string,
  contribution: GovernedReadContribution,
  ownerContractSource: string,
  deploymentAppId: string,
  moduleId: string,
  ownerPackageName: string,
): LoadedContributionSources | undefined => {
  const candidates = contributionSourceCandidates(sources, verticalPath, contribution);
  const header = generatedHeader(contribution.kind);
  const published = publishedModuleReadContribution(
    sources,
    `${verticalPath}/shared/apis/${contribution.contractStem}.ts`,
    ownerContractSource,
  );
  if (
    !hasDefinedContributionSources(candidates) ||
    !hasGeneratedContributionHeaders(candidates, header) ||
    !(
      hasGeneratedSourceHeader(ownerContractSource, header) ||
      (published?.kind === contribution.kind && published.name === contribution.name)
    )
  ) {
    return undefined;
  }
  const contractSpecifier = publicContractSpecifier(ownerContractSource);
  const clientSpecifier = publicContractSpecifier(candidates.ownerClientSource);
  if (
    contractSpecifier !== undefined &&
    clientSpecifier === undefined &&
    isClosedPublicContractExport(ownerContractSource, contractSpecifier)
  ) {
    const contract = resolvePublicContract(sources, contractSpecifier, {
      appId: deploymentAppId,
      moduleApi: contribution.name,
      moduleId,
      packageName: ownerPackageName,
    });
    if (contract === undefined || !hasGeneratedSourceHeader(contract.source, header)) {
      return undefined;
    }
    return {
      ...ownerLocalContributionSources(candidates, contribution, ownerContractSource),
      contractSource: contract.source,
    };
  }
  return contractSpecifier === undefined && clientSpecifier === undefined
    ? ownerLocalContributionSources(candidates, contribution, ownerContractSource)
    : publicContributionSources({
        candidates,
        clientSpecifier,
        contractSpecifier,
        contribution,
        deploymentAppId,
        header,
        moduleId,
        ownerContractSource,
        ownerPackageName,
        sources,
      });
};

/**
 * A module-API read may publish one reviewed GET companion beside its governed POST `execute` endpoint:
 * the companion adapts a path/query request into the same governed read registration, so the closed
 * generated POST seam still carries all authority. The companion's contract endpoint, the server's extra
 * imports and its handler tail are bespoke source, therefore they are accepted only as exact pinned text
 * (whitespace-normalized SHA-256). The pinned text is replaced by the canonical generated form and the
 * ordinary closed checks run over the result, so anything else in the files still has to be generated.
 * Changing a pinned block requires a new review and a new pin here.
 */
interface ReviewedReadCompanion {
  readonly contractEndpoint: RegExp;
  readonly contractEndpointSha256: string;
  readonly serverImports: string;
  readonly serverImportsSha256: string;
  readonly serverTailMarker: string;
  readonly serverTailSha256: string;
}

const reviewedReadCompanions = new Map<string, ReviewedReadCompanion>([
  [
    'privacy/notice-presentation',
    {
      contractEndpoint: /\n {4}HttpApiEndpoint\.get\('present'[\s\S]*?\n {4}\}\),\n(?= {2}\),\n\);)/u,
      contractEndpointSha256: '4190871d8f82fd57de69441e5fd769e863c53a6fe6dfa15c94cff4999b14aa6c',
      serverImports:
        "import { Effect, HttpApiBuilder } from '@modern-js/bff-effect/effect-edge';\nimport { HttpEffect, HttpServerResponse } from 'effect/http';\nimport { Redacted } from 'effect';\n",
      serverImportsSha256: '009c7d9d80198ebde19922ce6ba727cc0d1377af72035453c35a4aa63aab1e82',
      serverTailMarker: 'const execute = makeGovernedReadHttpHandler',
      serverTailSha256: '62d9c2829a517650c1bd178fc0246216bb01993be764e8e8bccb2c158b6b4f96',
    },
  ],
]);

const sha256OfNormalizedSource = (source: string): string =>
  createHash('sha256').update(source.replaceAll(/\s+/gu, ' ').trim()).digest('hex');

const canonicalReadApiLiveTail = (camel: string, group: string, apiBinding: string): string =>
  [
    `export const ${camel}ReadApiLive = HttpApiBuilder.group(${apiBinding}, '${group}', (handlers) =>`,
    '  handlers.handle(',
    "    'execute',",
    '    makeGovernedReadHttpHandler({',
    '      authenticatePrincipal: authenticateOperationPrincipal,',
    '      problems,',
    `      registration: ${camel}Read,`,
    '    }),',
    '  ),',
    ');',
    '',
  ].join('\n');

const canonicalReviewedCompanionSources = (
  verticalPath: string,
  contribution: GovernedReadContribution,
  sharedApi: string,
  loaded: LoadedContributionSources,
): LoadedContributionSources => {
  const companion = reviewedReadCompanions.get(`${path.posix.basename(verticalPath)}/${contribution.name}`);
  if (companion === undefined || contribution.kind !== MODULE_API_KIND) {
    return loaded;
  }
  const endpoint = companion.contractEndpoint.exec(loaded.contractSource)?.[0];
  const tailStart = loaded.serverSource.indexOf(companion.serverTailMarker);
  const serverTail = tailStart === -1 ? undefined : loaded.serverSource.slice(tailStart);
  if (
    endpoint === undefined ||
    serverTail === undefined ||
    !loaded.serverSource.includes(companion.serverImports) ||
    sha256OfNormalizedSource(endpoint) !== companion.contractEndpointSha256 ||
    sha256OfNormalizedSource(companion.serverImports) !== companion.serverImportsSha256 ||
    sha256OfNormalizedSource(serverTail) !== companion.serverTailSha256
  ) {
    return loaded;
  }
  const importsReplaced = loaded.serverSource.replace(
    companion.serverImports,
    "import { HttpApiBuilder } from '@modern-js/bff-effect/effect-edge';\n",
  );
  return {
    ...loaded,
    contractSource: loaded.contractSource.replace(endpoint, '\n'),
    serverSource: `${importsReplaced.slice(0, importsReplaced.indexOf(companion.serverTailMarker))}${canonicalReadApiLiveTail(
      toCamelCase(contribution.name),
      contributionGroup(contribution.kind, contribution.name),
      governedApiBinding(sharedApi) ?? '',
    )}`,
  };
};

const hasCompleteGeneratedContribution = (
  sources: ReadonlyMap<string, string>,
  verticalPath: string,
  context: GeneratedContributionValidationContext,
  entry: GeneratedContribution,
): boolean => {
  const [, ownerContractSource, contribution] = entry;
  if (contribution === undefined) {
    return false;
  }
  const camel = toCamelCase(contribution.name);
  const group = contributionGroup(contribution.kind, contribution.name);
  const apiValue = contributionApiValue(contribution.kind, contribution.name);
  const loaded = loadContributionSources(
    sources,
    verticalPath,
    contribution,
    ownerContractSource,
    context.deploymentAppId,
    context.moduleId,
    context.ownerPackageName,
  );
  if (loaded === undefined) {
    context.diagnostics?.push(`${contribution.name}: missing source or provenance marker`);
    return false;
  }
  const { clientSource, contractImport, contractSource, readImport, readSource, serverSource } =
    canonicalReviewedCompanionSources(verticalPath, contribution, context.sharedApi, loaded);
  const schemaStem = contributionSchemaStem(contribution.kind, contribution.name);
  const checks = {
    client: hasClientContract(clientSource, contribution, group, apiValue, context.deploymentAppId, contractImport),
    contract: hasCompleteContributionContract(
      contractSource,
      contribution,
      apiValue,
      group,
      schemaStem,
      contributionEndpoint(contribution, context.moduleId),
    ),
    published: hasPublishedContract(
      context.sharedApi,
      context.manifest,
      context.registration,
      context.handlerRoot,
      contribution,
      context.moduleId,
      context.diagnostics,
      context.backendRegistration,
    ),
    read: hasCompleteContributionRead(
      readSource,
      contribution,
      context.moduleId,
      sources,
      path.posix.normalize(path.posix.join(verticalPath, 'api', readImport)),
      verticalPath,
    ),
    server: hasServerContract(
      serverSource,
      escapeRegExp(camel),
      escapeRegExp(group),
      readImport,
      schemaStem,
      `../shared/apis/${contribution.contractStem}.ts`,
      governedApiBinding(context.sharedApi) ?? '',
      context.deploymentAppId,
    ),
  };
  const failed = Object.entries(checks)
    .filter(([, valid]) => !valid)
    .map(([name]) => name);
  if (failed.length > 0) {
    context.diagnostics?.push(`${contribution.name}: ${failed.join(', ')}`);
  }
  return failed.length === 0;
};

const hasCompleteGeneratedContributions = (
  sources: ReadonlyMap<string, string>,
  inputs: CompleteGeneratedModuleApiSeamInputs,
  deploymentAppId: string,
  diagnostics: string[] | undefined,
): boolean => {
  const contributions = generatedReadContributions(sources, inputs.verticalPath);
  if (contributions.length === 0) {
    return false;
  }
  if (
    !hasMatchingModuleApiSlots(
      inputs.manifest,
      inputs.registration,
      contributions,
      sources,
      inputs.verticalPath,
      inputs.moduleId,
    )
  ) {
    diagnostics?.push('manifest or registration contribution inventory');
    return false;
  }
  const context: GeneratedContributionValidationContext = {
    backendRegistration:
      inputs.runtimeDeclaration === undefined
        ? undefined
        : `${toCamelCase(path.posix.basename(inputs.verticalPath))}BackendRegistration`,
    deploymentAppId,
    diagnostics,
    handlerRoot: inputs.handlerRoot,
    manifest: inputs.manifest,
    moduleId: inputs.moduleId,
    ownerPackageName: inputs.ownerPackage.name,
    registration: inputs.registration,
    sharedApi: inputs.sharedApi,
  };
  return contributions.every((entry) => hasCompleteGeneratedContribution(sources, inputs.verticalPath, context, entry));
};

export const hasCompleteGeneratedModuleApiSeam = (
  sources: ReadonlyMap<string, string>,
  sharedApiFile: string,
  deploymentAppId = path.posix.basename(sharedApiFile.slice(0, -'/shared/api.ts'.length)),
  diagnostics?: string[],
): boolean => {
  const inputs = generatedModuleApiSeamInputs(sources, sharedApiFile);
  if (!hasCompleteGeneratedModuleApiSeamInputs(inputs)) {
    return false;
  }
  if (!hasCompleteActionBoundary(inputs, deploymentAppId, diagnostics)) {
    return false;
  }
  const readsAreComplete = hasCompleteGeneratedContributions(sources, inputs, deploymentAppId, diagnostics);
  return (
    readsAreComplete &&
    hasCompleteGeneratedActionHttpSeam({
      deploymentAppId,
      handlerRoot: inputs.handlerRoot,
      manifest: inputs.manifest,
      moduleId: inputs.moduleId,
      registration: inputs.registration,
      runtimeDeclaration: inputs.runtimeDeclaration,
      sharedApi: inputs.sharedApi,
      sources,
      verticalPath: inputs.verticalPath,
    })
  );
};

const readDirectoryKinds = new Map<string, GovernedReadKind>([
  ['api', MODULE_API_KIND],
  ['reports', REPORT_KIND],
  ['search', SEARCH_PROVIDER_KIND],
]);

export const hasGeneratedGovernedServerContract = (
  source: string,
  exportedName: string,
  sharedApi: string,
  audience?: string,
): boolean => {
  const camel = exportedName.replace(/ReadApiLive$/u, '');
  const readImport =
    /from '(?<path>\.\.\/src\/(?<directory>api|search|reports)\/(?<name>[a-z0-9-]+)\.(?:read|provider)\.ts)'/u.exec(
      source,
    );
  const [, readPath, directory, name] = readImport ?? [];
  if (readPath === undefined || name === undefined || directory === undefined || camel !== toCamelCase(name)) {
    return false;
  }
  const kind = readDirectoryKinds.get(directory);
  if (kind === undefined) {
    return false;
  }
  const stem = kind === MODULE_API_KIND ? name : `${name}-${contributionRole(kind)}`;
  const schemaStem = contributionSchemaStem(kind, name);
  return (
    hasGeneratedSourceHeader(source, generatedHeader(kind)) &&
    hasServerContract(
      source,
      escapeRegExp(camel),
      escapeRegExp(contributionGroup(kind, name)),
      readPath,
      schemaStem,
      `../shared/apis/${stem}.ts`,
      governedApiBinding(sharedApi) ?? '',
      audience,
    )
  );
};
