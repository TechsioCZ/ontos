import path from 'node:path';

const GENERATED_HEADER = '// @generated by OntOS Codesmith module-api v1\n';

const escapeRegExp = (value: string): string => value.replaceAll(/[.*+?^${}()|[\]\\]/gu, '\\$&');

const toPascalCase = (value: string): string =>
  value
    .split('-')
    .map((part) => `${part.slice(0, 1).toUpperCase()}${part.slice(1)}`)
    .join('');

const toCamelCase = (value: string): string => {
  const pascal = toPascalCase(value);
  return `${pascal.slice(0, 1).toLowerCase()}${pascal.slice(1)}`;
};

const matches = (source: string | undefined, expression: RegExp): boolean =>
  source !== undefined && expression.test(source);

/**
 * Recognizes the complete semantic seam emitted by the governed module-API generator.
 * File presence alone is intentionally insufficient: every public descriptor must be
 * owner-published, privately registered, authenticated, gated, and contract-derived.
 */
export const hasCompleteGeneratedModuleApiSeam = (
  sources: ReadonlyMap<string, string>,
  sharedApiFile: string,
): boolean => {
  const verticalPath = sharedApiFile.slice(0, -'/shared/api.ts'.length);
  const sharedApi = sources.get(sharedApiFile);
  const manifest = sources.get(`${verticalPath}/vertical.manifest.ts`);
  const registration = sources.get(`${verticalPath}/vertical.registration.ts`);
  const principal = sources.get(`${verticalPath}/api/auth/action-principal.ts`);
  const gateway = sources.get(`${verticalPath}/src/api/action-gateway.ts`);
  const readServerSupport = sources.get(`${verticalPath}/api/read-server-support.ts`);
  if (
    sharedApi === undefined ||
    manifest === undefined ||
    registration === undefined ||
    principal === undefined ||
    gateway === undefined ||
    !principal.startsWith('// @generated by OntOS Codesmith MicroVertical Action Boundary v1\n') ||
    !principal.includes('verifyOperationPrincipal') ||
    !gateway.startsWith('// @generated by OntOS Codesmith MicroVertical Action Boundary v1\n') ||
    !gateway.includes('operationGateway')
  ) {
    return false;
  }

  const contractPrefix = `${verticalPath}/shared/apis/`;
  const contracts = [...sources.keys()].filter(
    (candidate) =>
      candidate.startsWith(contractPrefix) &&
      candidate.endsWith('.ts') &&
      !candidate.slice(contractPrefix.length).includes('/'),
  );
  if (contracts.length === 0) return false;

  return contracts.every((contract) => {
    const stem = path.posix.basename(contract, '.ts');
    const pascal = toPascalCase(stem);
    const camel = toCamelCase(stem);
    const contractSource = sources.get(contract);
    const readSource = sources.get(`${verticalPath}/src/api/${stem}.read.ts`);
    const clientSource = sources.get(`${verticalPath}/src/api/${stem}-client.ts`);
    const serverSource = sources.get(`${verticalPath}/api/${stem}-read-server.ts`);
    if (
      !contractSource?.startsWith(GENERATED_HEADER) ||
      !readSource?.startsWith(GENERATED_HEADER) ||
      !clientSource?.startsWith(GENERATED_HEADER) ||
      !serverSource?.startsWith(GENERATED_HEADER)
    ) {
      return false;
    }

    const escapedStem = escapeRegExp(stem);
    const escapedPascal = escapeRegExp(pascal);
    const escapedCamel = escapeRegExp(camel);
    return (
      matches(
        contractSource,
        new RegExp(`export const ${escapedPascal}Api\\s*=\\s*HttpApi\\.make\\(`, 'u'),
      ) &&
      matches(
        readSource,
        new RegExp(
          `export const ${escapedCamel}Entrypoint\\s*=\\s*defineTenantModuleEntrypoint`,
          'u',
        ),
      ) &&
      readSource.includes("access: 'read'") &&
      readSource.includes("role: 'api'") &&
      matches(
        readSource,
        new RegExp(`export const ${escapedCamel}Read\\s*=\\s*defineRead\\(`, 'u'),
      ) &&
      readSource.includes('legalEntityScope:') &&
      readSource.includes('permissionTarget:') &&
      readSource.includes('policies:') &&
      clientSource.includes('makeEffectHttpApiClient') &&
      clientSource.includes('operationGateway.invoke') &&
      clientSource.includes("'x-correlation-id'") &&
      serverSource.includes('HttpApiBuilder.group') &&
      (serverSource.includes('verifyOperationPrincipal') ||
        (serverSource.includes('verifyReadPrincipal') &&
          readServerSupport?.includes('verifyOperationPrincipal') === true &&
          readServerSupport.includes("case 'ReadPolicyDenied'"))) &&
      serverSource.includes('ReadRuntime') &&
      serverSource.includes('.runRead({') &&
      matches(
        sharedApi,
        new RegExp(`import \\{ ${escapedPascal}Api \\} from './apis/${escapedStem}\\.ts';`, 'u'),
      ) &&
      matches(sharedApi, new RegExp(`\\.addHttpApi\\(${escapedPascal}Api\\)`, 'u')) &&
      matches(
        manifest,
        new RegExp(
          `import \\{ ${escapedPascal}Api \\} from './shared/apis/${escapedStem}\\.ts';`,
          'u',
        ),
      ) &&
      matches(manifest, new RegExp(`'${escapedStem}': ${escapedPascal}Api,`, 'u')) &&
      matches(
        registration,
        new RegExp(
          `'${escapedStem}': \\(\\) => import\\('./src/api/${escapedStem}-client\\.ts'\\),`,
          'u',
        ),
      )
    );
  });
};
