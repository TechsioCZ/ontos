import path from 'node:path';

import { Predicate, Schema } from 'effect';
import { parseSync, Visitor } from 'oxc-parser';
import type {
  CallExpression,
  Expression,
  ExportNamedDeclaration,
  ObjectExpression,
  ObjectProperty,
  Program,
  PropertyKey,
  Span,
  Statement,
  VariableDeclarator,
} from 'oxc-parser';

import { hasGeneratedSourceHeader } from './generated-module-api-boundary.mts';

/**
 * Consumer-side proof for one Codesmith public component published by another MicroVertical.
 *
 * A cross-MicroVertical import of a browser component is not a private source import: the owner
 * publishes the artifact through the generated Codesmith public-component publication, and the Shell
 * loads the same artifact through Module Federation. This module proves that publication from source
 * so the boundary checker can approve the *selected symbol* of a declared UI artifact instead of
 * granting a blanket path or a file-wide exemption.
 *
 * The proof requires every part of the owner publication to be present and exact:
 *
 * - the owner package export resolves the consumer's subpath to the component artifact;
 * - the artifact carries the Codesmith public-component generator header;
 * - the owner manifest is built by the original Core `defineOntosModuleManifest` factory, its module
 *   identity matches, and the component sits in the reserved generated components slot;
 * - the reserved Shell component slot carries the matching contribution identity, tenant read
 *   entrypoint and Module Federation expose;
 * - the reserved registration slot lazily imports the same artifact;
 * - the Module Federation configuration exposes that selector to that artifact;
 * - the selected symbol is declared by the artifact (or re-exported from an owner-local module) and is
 *   a genuine UI export.
 *
 * Anything else is rejected: an absent or foreign manifest factory, a missing or mismatched reserved
 * slot, a foreign owner identity, a missing generator header, a backend/private re-export, and an
 * arbitrary co-located callable that is neither a React component nor a React hook. A plain owner
 * helper function is deliberately not a UI export: it stays on the pure-contract path.
 */

/** The generator header every Codesmith public-component artifact carries. */
export const PUBLIC_COMPONENT_GENERATOR_HEADER = '// @generated by OntOS Codesmith public-component v1\n';

const CORE_RUNTIME_PACKAGE = '@app/core-runtime';
const MANIFEST_FACTORY = 'defineOntosModuleManifest';
const MANIFEST_FILE = 'vertical.manifest.ts';
const REGISTRATION_FILE = 'vertical.registration.ts';
const FEDERATION_FILE = 'module-federation.config.ts';
const COMPONENT_DIRECTORY = 'src/components';
const COMPONENT_EXTENSION = '.tsx';
const COMPONENT_SLUG = /^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$/u;
const PUBLIC_COMPONENT_ROLE = 'public_component';
const TENANT_SCOPE = 'tenant';
const READ_ACCESS = 'read';
const HOOK_NAME = /^use[A-Z0-9]/u;

/** Reserved Codesmith slots a published component must fill; the checker rejects a file without them. */
const MANIFEST_COMPONENTS_SLOT = 'generated-module-manifest-components';
const SHELL_COMPONENTS_SLOT = 'generated-module-shell-components';
const REGISTRATION_COMPONENTS_SLOT = 'generated-module-registration-components';

/** Mirrors the boundary checker's owner-private source rule: a UI artifact must never re-export these. */
const OWNER_PRIVATE_SOURCE =
  /(?:vertical\.(?:registration|manifest|runtime-declaration)\.[cm]?ts$)|(?:(?:^|\/)src\/(?:handlers|workers|db|database|repositories?)\/)|(?:(?:^|\/)workers\/)/u;

/** One cross-MicroVertical consumer import of an owner's published public component. */
export interface PublicComponentConsumerImport {
  /** Owner deployment app id (`modernjs.appId`). */
  readonly appId: string | undefined;
  /** Whether the consumer's package declares the owner package as a workspace dependency. */
  readonly dependencyDeclared: boolean;
  /** Package subpath the consumer imported, for example `./components/tag-controls`. */
  readonly exportKey: string;
  /** Owner module id (`modernjs.ontosModule.moduleId`). */
  readonly moduleId: string | undefined;
  /** Owner deployment directory, for example `verticals/tagging`. */
  readonly owner: string;
  /** Owner package `exports` map. */
  readonly ownerPackageExports: Readonly<Record<string, string>>;
  /** Imported symbol name, for example `TagCell`. */
  readonly selectedExportName: string;
  /** File that declares the selected symbol, resolved by the checker's module graph. */
  readonly selectedModulePath: string;
  /** Every workspace source by repository-relative path. */
  readonly sources: ReadonlyMap<string, string>;
  /** Resolved export target of `exportKey`, for example `verticals/tagging/src/components/tag-controls.tsx`. */
  readonly target: string;
}

/** The kinds of artifact export this proof can approve; anything else is not a UI export. */
const publishedExportKindValues = Schema.Literals(['component', 'hook', 'type', 'value']);
type PublishedExportKind = typeof publishedExportKindValues.Type;

const readSource = (sources: ReadonlyMap<string, string>, file: string): string | undefined => sources.get(file);

const parseModule = (file: string, source: string): Program | undefined => {
  const parsed = parseSync(file, source, {
    astType: 'ts',
    lang: file.endsWith(COMPONENT_EXTENSION) ? 'tsx' : 'ts',
    sourceType: 'module',
  });
  return parsed.errors.length === 0 ? parsed.program : undefined;
};

const resolveOwnerPath = (owner: string, specifier: string): string =>
  path.posix.normalize(path.posix.join(owner, specifier));

/** The component slug an artifact path declares, or `undefined` when the path is not a component artifact. */
const declaredComponentSlug = (owner: string, target: string): string | undefined => {
  const prefix = `${owner}/${COMPONENT_DIRECTORY}/`;
  if (!target.startsWith(prefix) || !target.endsWith(COMPONENT_EXTENSION)) {
    return undefined;
  }
  const slug = target.slice(prefix.length, -COMPONENT_EXTENSION.length);
  return COMPONENT_SLUG.test(slug) ? slug : undefined;
};

const propertyName = (key: PropertyKey): string | undefined => {
  if (key.type === 'Identifier') {
    return key.name;
  }
  if (key.type === 'Literal' && Predicate.isString(key.value)) {
    return key.value;
  }
  return undefined;
};

const objectProperty = (object: ObjectExpression, name: string): Expression | undefined => {
  const matches = object.properties.filter(
    (property): property is ObjectProperty =>
      property.type === 'Property' && !property.computed && propertyName(property.key) === name,
  );
  return matches.length === 1 ? matches[0]?.value : undefined;
};

/** The value of a string literal node, or `undefined` for any other expression. */
const stringLiteralValue = (node: Expression): string | undefined =>
  node.type === 'Literal' && Predicate.isString(node.value) ? node.value : undefined;

const stringProperty = (object: ObjectExpression, name: string): string | undefined => {
  const property = objectProperty(object, name);
  return property === undefined ? undefined : stringLiteralValue(property);
};

/** The `const` declarators a top-level statement owns, whether exported or not. */
const topLevelConstDeclarators = (statement: Statement): readonly VariableDeclarator[] => {
  if (statement.type === 'VariableDeclaration') {
    return statement.kind === 'const' ? statement.declarations : [];
  }
  if (statement.type === 'ExportNamedDeclaration' && statement.declaration?.type === 'VariableDeclaration') {
    const { declaration } = statement;
    return declaration.kind === 'const' ? declaration.declarations : [];
  }
  return [];
};

/** Module-level `const NAME = 'literal'` bindings, so a generated identity written as a const resolves. */
const constStringBindings = (program: Program): ReadonlyMap<string, string> => {
  const bindings = new Map<string, string>();
  for (const statement of program.body) {
    for (const declarator of topLevelConstDeclarators(statement)) {
      const { init } = declarator;
      const literal = init === null ? undefined : stringLiteralValue(init);
      if (declarator.id.type === 'Identifier' && literal !== undefined) {
        bindings.set(declarator.id.name, literal);
      }
    }
  }
  return bindings;
};

/** A string property that may be written inline or through a module-level const binding. */
const resolvedStringProperty = (
  bindings: ReadonlyMap<string, string>,
  object: ObjectExpression,
  name: string,
): string | undefined => {
  const property = objectProperty(object, name);
  const literal = property === undefined ? undefined : stringLiteralValue(property);
  if (literal !== undefined) {
    return literal;
  }
  return property?.type === 'Identifier' ? bindings.get(property.name) : undefined;
};

/** Text of a reserved generated slot, or `undefined` when the slot is absent or duplicated. */
const reservedSlot = (source: string, slot: string): string | undefined => {
  const opening = `// <${slot}>`;
  const closing = `// </${slot}>`;
  const start = source.indexOf(opening);
  const end = source.indexOf(closing);
  if (
    start === -1 ||
    end === -1 ||
    start !== source.lastIndexOf(opening) ||
    end !== source.lastIndexOf(closing) ||
    end < start
  ) {
    return undefined;
  }
  return source.slice(start + opening.length, end);
};

const slotObject = (file: string, source: string, slot: string): ObjectExpression | undefined => {
  const text = reservedSlot(source, slot);
  if (text === undefined) {
    return undefined;
  }
  const program = parseModule(file, `const reserved = {${text}};`);
  const declaration = program?.body[0]?.type === 'VariableDeclaration' ? program.body[0].declarations[0] : undefined;
  const init = declaration?.init;
  return init?.type === 'ObjectExpression' ? init : undefined;
};

const slotArray = (file: string, source: string, slot: string): readonly Expression[] | undefined => {
  const text = reservedSlot(source, slot);
  if (text === undefined) {
    return undefined;
  }
  const program = parseModule(file, `const reserved = [${text}];`);
  const declaration = program?.body[0]?.type === 'VariableDeclaration' ? program.body[0].declarations[0] : undefined;
  const init = declaration?.init;
  return init?.type === 'ArrayExpression'
    ? init.elements.filter((element): element is Expression => element !== null && element.type !== 'SpreadElement')
    : undefined;
};

/** The original Core manifest factory call, or `undefined` for an absent or foreign factory. */
const coreManifestFactoryCall = (program: Program): CallExpression | undefined => {
  const factories = new Set<string>();
  for (const statement of program.body) {
    if (statement.type !== 'ImportDeclaration' || statement.source.value !== CORE_RUNTIME_PACKAGE) {
      continue;
    }
    for (const specifier of statement.specifiers) {
      if (
        specifier.type === 'ImportSpecifier' &&
        specifier.imported.type === 'Identifier' &&
        specifier.imported.name === MANIFEST_FACTORY
      ) {
        factories.add(specifier.local.name);
      }
    }
  }
  if (factories.size === 0) {
    return undefined;
  }
  for (const statement of program.body) {
    if (statement.type !== 'ExportNamedDeclaration' || statement.declaration?.type !== 'VariableDeclaration') {
      continue;
    }
    for (const declaration of statement.declaration.declarations) {
      const { init } = declaration;
      if (init?.type === 'CallExpression' && init.callee.type === 'Identifier' && factories.has(init.callee.name)) {
        return init;
      }
    }
  }
  return undefined;
};

/** The single named binding the manifest imports from the component artifact. */
const artifactImportBinding = (program: Program, owner: string, target: string): string | undefined => {
  const bindings = new Set<string>();
  for (const statement of program.body) {
    if (statement.type !== 'ImportDeclaration' || resolveOwnerPath(owner, statement.source.value) !== target) {
      continue;
    }
    for (const specifier of statement.specifiers) {
      if (specifier.type === 'ImportSpecifier') {
        bindings.add(specifier.local.name);
      }
    }
  }
  return bindings.size === 1 ? [...bindings][0] : undefined;
};

interface PublishedContribution {
  readonly expose: string;
}

/** The reserved Shell component contribution that binds this artifact, or `undefined` when it is absent. */
const publishedComponentContribution = (
  file: string,
  source: string,
  input: { readonly bindings: ReadonlyMap<string, string>; readonly moduleId: string; readonly slug: string },
): PublishedContribution | undefined => {
  const contributions = slotArray(file, source, SHELL_COMPONENTS_SLOT);
  if (contributions === undefined) {
    return undefined;
  }
  const componentKey = `${input.moduleId}.${input.slug}`;
  const entrypointKey = `${input.moduleId}.component.${input.slug}`;
  const matching = contributions.filter(
    (element) =>
      element.type === 'CallExpression' &&
      element.arguments.length === 1 &&
      element.arguments[0]?.type === 'ObjectExpression' &&
      stringProperty(element.arguments[0], 'componentKey') === componentKey,
  );
  if (matching.length !== 1) {
    return undefined;
  }
  const argument = matching[0]?.type === 'CallExpression' ? matching[0].arguments[0] : undefined;
  if (argument?.type !== 'ObjectExpression') {
    return undefined;
  }
  const expose = stringProperty(argument, 'expose');
  const entrypoint = objectProperty(argument, 'entrypoint');
  if (
    expose === undefined ||
    stringProperty(argument, 'contributionKey') !== `${input.moduleId}.component.${input.slug}` ||
    entrypoint?.type !== 'ObjectExpression' ||
    stringProperty(entrypoint, 'access') !== READ_ACCESS ||
    stringProperty(entrypoint, 'entrypointKey') !== entrypointKey ||
    resolvedStringProperty(input.bindings, entrypoint, 'moduleKey') !== input.moduleId ||
    stringProperty(entrypoint, 'role') !== PUBLIC_COMPONENT_ROLE ||
    stringProperty(entrypoint, 'scope') !== TENANT_SCOPE ||
    objectProperty(entrypoint, 'authorization')?.type !== 'ObjectExpression'
  ) {
    return undefined;
  }
  return { expose };
};

/**
 * The reserved manifest binding for the artifact, or `undefined` when the factory, module identity,
 * components slot or Shell contribution is absent, foreign or mismatched.
 */
const publishedComponentManifest = (
  consumerImport: PublicComponentConsumerImport,
  slug: string,
): PublishedContribution | undefined => {
  const { moduleId, owner, sources, target } = consumerImport;
  if (moduleId === undefined) {
    return undefined;
  }
  const file = `${owner}/${MANIFEST_FILE}`;
  const source = readSource(sources, file);
  const program = source === undefined ? undefined : parseModule(file, source);
  if (source === undefined || program === undefined) {
    return undefined;
  }
  const factory = coreManifestFactoryCall(program);
  const manifest = factory?.arguments[0];
  if (manifest?.type !== 'ObjectExpression') {
    return undefined;
  }
  const bindings = constStringBindings(program);
  const module = objectProperty(manifest, 'module');
  if (module?.type !== 'ObjectExpression' || resolvedStringProperty(bindings, module, 'id') !== moduleId) {
    return undefined;
  }
  const binding = artifactImportBinding(program, owner, target);
  const components = slotObject(file, source, MANIFEST_COMPONENTS_SLOT);
  const entry = components === undefined ? undefined : objectProperty(components, slug);
  if (binding === undefined || entry?.type !== 'Identifier' || entry.name !== binding) {
    return undefined;
  }
  return publishedComponentContribution(file, source, { bindings, moduleId, slug });
};

/** The reserved registration slot's lazy thunk must import the same artifact. */
const hasPublishedComponentRegistration = (consumerImport: PublicComponentConsumerImport, slug: string): boolean => {
  const { owner, sources, target } = consumerImport;
  const file = `${owner}/${REGISTRATION_FILE}`;
  const source = readSource(sources, file);
  const components = source === undefined ? undefined : slotObject(file, source, REGISTRATION_COMPONENTS_SLOT);
  const entry = components === undefined ? undefined : objectProperty(components, slug);
  if (entry?.type !== 'ArrowFunctionExpression') {
    return false;
  }
  const { body } = entry;
  if (body.type !== 'ImportExpression') {
    return false;
  }
  const importedSource = stringLiteralValue(body.source);
  return importedSource !== undefined && resolveOwnerPath(owner, importedSource) === target;
};

/** The Module Federation configuration must expose the declared selector to the same artifact. */
const hasPublishedComponentExposure = (consumerImport: PublicComponentConsumerImport, expose: string): boolean => {
  const { owner, sources, target } = consumerImport;
  const file = `${owner}/${FEDERATION_FILE}`;
  const source = readSource(sources, file);
  const program = source === undefined ? undefined : parseModule(file, source);
  if (program === undefined) {
    return false;
  }
  const candidates: ObjectExpression[] = [];
  new Visitor({
    CallExpression: (call) => {
      for (const argument of call.arguments) {
        if (argument.type === 'ObjectExpression') {
          candidates.push(argument);
        }
      }
    },
    VariableDeclarator: (declarator) => {
      if (declarator.init?.type === 'ObjectExpression') {
        candidates.push(declarator.init);
      }
    },
  }).visit(program);
  const exposes = candidates.filter((candidate) => objectProperty(candidate, 'exposes') !== undefined);
  if (exposes.length !== 1) {
    return false;
  }
  const exposesObject = exposes[0] === undefined ? undefined : objectProperty(exposes[0], 'exposes');
  if (exposesObject?.type !== 'ObjectExpression') {
    return false;
  }
  const exposed = stringProperty(exposesObject, expose);
  return exposed !== undefined && resolveOwnerPath(owner, exposed) === target;
};

const jsxSpans = (program: Program): readonly Span[] => {
  const spans: Span[] = [];
  new Visitor({
    JSXElement: (element) => {
      spans.push(element);
    },
    JSXFragment: (fragment) => {
      spans.push(fragment);
    },
  }).visit(program);
  return spans;
};

const unwrapExpression = (expression: Expression): Expression => {
  let current = expression;
  for (let depth = 0; depth < 16; depth += 1) {
    if (
      current.type === 'TSAsExpression' ||
      current.type === 'TSSatisfiesExpression' ||
      current.type === 'TSNonNullExpression' ||
      current.type === 'ParenthesizedExpression'
    ) {
      current = current.expression;
    } else {
      return current;
    }
  }
  return current;
};

/** A JSX-returning function is a component, a `use*` function is a hook, anything else is not UI. */
const functionExportKind = (name: string, node: Span, spans: readonly Span[]): PublishedExportKind | undefined => {
  if (spans.some((span) => span.start >= node.start && span.end <= node.end)) {
    return 'component';
  }
  return HOOK_NAME.test(name) ? 'hook' : undefined;
};

const expressionExportKind = (
  name: string,
  expression: Expression,
  spans: readonly Span[],
): PublishedExportKind | undefined => {
  const unwrapped = unwrapExpression(expression);
  if (unwrapped.type === 'ArrowFunctionExpression' || unwrapped.type === 'FunctionExpression') {
    return functionExportKind(name, unwrapped, spans);
  }
  if (
    unwrapped.type === 'ObjectExpression' ||
    unwrapped.type === 'ArrayExpression' ||
    unwrapped.type === 'TemplateLiteral' ||
    unwrapped.type === 'Literal'
  ) {
    return 'value';
  }
  return undefined;
};

const declarationExportKind = (
  declaration: ExportNamedDeclaration['declaration'],
  name: string,
  spans: readonly Span[],
): PublishedExportKind | undefined => {
  if (declaration === null) {
    return undefined;
  }
  if (declaration.type === 'TSTypeAliasDeclaration' || declaration.type === 'TSInterfaceDeclaration') {
    return declaration.id.name === name ? 'type' : undefined;
  }
  if (declaration.type === 'TSEnumDeclaration') {
    return declaration.id.name === name ? 'value' : undefined;
  }
  if (declaration.type === 'ClassDeclaration') {
    return declaration.id?.name === name ? 'value' : undefined;
  }
  if (declaration.type === 'FunctionDeclaration') {
    return declaration.id?.name === name ? functionExportKind(name, declaration, spans) : undefined;
  }
  if (declaration.type === 'VariableDeclaration') {
    const declarator = declaration.declarations.find(
      (candidate) => candidate.id.type === 'Identifier' && candidate.id.name === name,
    );
    const init = declarator?.init;
    return init === undefined || init === null ? undefined : expressionExportKind(name, init, spans);
  }
  return undefined;
};

/** The UI kind a module exports under `name`, or `undefined` when it exports no such symbol. */
const publishedExportKind = (file: string, source: string, name: string): PublishedExportKind | undefined => {
  const program = parseModule(file, source);
  if (program === undefined) {
    return undefined;
  }
  const spans = jsxSpans(program);
  for (const statement of program.body) {
    if (statement.type !== 'ExportNamedDeclaration') {
      continue;
    }
    const kind = declarationExportKind(statement.declaration, name, spans);
    if (kind !== undefined) {
      return kind;
    }
    const reexported =
      statement.source === null
        ? statement.specifiers.filter(
            (specifier) => specifier.local.type === 'Identifier' && specifier.local.name === name,
          )
        : [];
    if (reexported.length === 1 && statement.exportKind === 'type') {
      return 'type';
    }
  }
  return undefined;
};

/** The module an artifact re-exports `name` from, or `undefined` when it does not re-export it. */
const reexportedModulePath = (file: string, source: string, name: string): string | undefined => {
  const program = parseModule(file, source);
  if (program === undefined) {
    return undefined;
  }
  for (const statement of program.body) {
    if (statement.type !== 'ExportNamedDeclaration' || statement.source === null) {
      continue;
    }
    const matches = statement.specifiers.filter(
      (specifier) => specifier.exported.type === 'Identifier' && specifier.exported.name === name,
    );
    if (matches.length === 1) {
      return path.posix.normalize(path.posix.join(path.posix.dirname(file), statement.source.value));
    }
  }
  return undefined;
};

/** The selected symbol must be an owner-local UI export of the published artifact. */
const hasPublishedComponentSymbol = (consumerImport: PublicComponentConsumerImport): boolean => {
  const { owner, selectedExportName, selectedModulePath, sources, target } = consumerImport;
  if (!selectedModulePath.startsWith(`${owner}/`) || OWNER_PRIVATE_SOURCE.test(selectedModulePath)) {
    return false;
  }
  const declaringSource = readSource(sources, selectedModulePath);
  if (declaringSource === undefined) {
    return false;
  }
  if (selectedModulePath !== target) {
    const artifactSource = readSource(sources, target);
    if (
      artifactSource === undefined ||
      reexportedModulePath(target, artifactSource, selectedExportName) !== selectedModulePath
    ) {
      return false;
    }
  }
  return publishedExportKind(selectedModulePath, declaringSource, selectedExportName) !== undefined;
};

/**
 * True when a consumer import is the approved use of an owner's published public component: the
 * owner publication is genuine and complete, and the selected symbol is a declared UI export of it.
 */
export const hasPublishedPublicComponent = (consumerImport: PublicComponentConsumerImport): boolean => {
  const { appId, dependencyDeclared, exportKey, moduleId, owner, ownerPackageExports, sources, target } =
    consumerImport;
  if (appId === undefined || moduleId === undefined || !dependencyDeclared || !exportKey.startsWith('./')) {
    return false;
  }
  const slug = declaredComponentSlug(owner, target);
  if (slug === undefined) {
    return false;
  }
  const exported = ownerPackageExports[exportKey];
  if (exported === undefined || resolveOwnerPath(owner, exported) !== target) {
    return false;
  }
  const artifactSource = readSource(sources, target);
  if (artifactSource === undefined || !hasGeneratedSourceHeader(artifactSource, PUBLIC_COMPONENT_GENERATOR_HEADER)) {
    return false;
  }
  const contribution = publishedComponentManifest(consumerImport, slug);
  if (
    contribution === undefined ||
    !hasPublishedComponentRegistration(consumerImport, slug) ||
    !hasPublishedComponentExposure(consumerImport, contribution.expose)
  ) {
    return false;
  }
  return hasPublishedComponentSymbol(consumerImport);
};
