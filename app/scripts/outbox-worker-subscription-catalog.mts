export interface OutboxWorkerSubscriptionCatalogEntry {
  readonly consumerModuleKey: string;
  readonly producerModuleKey: string;
  readonly topic: string;
  readonly workerKey: string;
}

export const OUTBOX_WORKER_SUBSCRIPTION_CATALOG_HEADER =
  '// @generated by OntOS Codesmith Outbox Worker subscriptions v1';

export const renderOutboxWorkerSubscriptionCatalog = (
  subscriptions: readonly OutboxWorkerSubscriptionCatalogEntry[],
): string => {
  const entries = subscriptions
    .toSorted((left, right) => left.workerKey.localeCompare(right.workerKey))
    .map(
      (subscription) => `    Object.freeze({
      consumerModuleKey: '${subscription.consumerModuleKey}',
      producerModuleKey: '${subscription.producerModuleKey}',
      topic: '${subscription.topic}',
      workerKey: '${subscription.workerKey}',
    }),`,
    )
    .join('\n');
  const body = entries.length === 0 ? '  []' : `  [\n${entries}\n  ]`;
  return `${OUTBOX_WORKER_SUBSCRIPTION_CATALOG_HEADER}
import type { OutboxWorkerSubscription } from './definition.ts';

export const installedOutboxWorkerSubscriptions = Object.freeze(
${body},
) satisfies readonly OutboxWorkerSubscription[];
`;
};
