// ---------------------------------------------------------------------------------------------------------------
// Demo-only exception 5: build-time public components.
// A vertical may render another vertical's small inline controls (tag chips, record discussion panels) through a
// build-time import instead of Module Federation, which would add requests and loading states to list rows.
// Main's mechanism is Module Federation; this is a deliberate divergence to raise with the owner. The proof
// keeps it narrow:
// - the consumer imports only the owner's declared public-component entry
//   (`src/components/<slug>.tsx`, Codesmith public-component header, manifest and registration slot);
// - the entry exports React components and types only: no hooks, values, services, clients or server code;
// - everything the entry reaches stays in the owner's client code, and owner API access goes only through its
//   Codesmith-generated clients.
// ---------------------------------------------------------------------------------------------------------------
import nodePath from 'node:path';

import { Schema } from 'effect';
import { parseSync, Visitor } from 'oxc-parser';
import type {
  Argument,
  Declaration,
  ExportDefaultDeclarationKind,
  ExportNamedDeclaration,
  Expression,
  ModuleExportName,
  Program,
  Span,
} from 'oxc-parser';

export const PUBLIC_COMPONENT_HEADER = '// @generated by OntOS Codesmith public-component v1';
const GENERATED_CLIENT_HEADER =
  /^\/\/ @generated by OntOS Codesmith (?:Action HTTP|module-api|Governed Contribution) v1$/u;
const COMPONENT_ENTRY = /^src\/components\/(?<slug>[a-z][a-z0-9]*(?:-[a-z0-9]+)*)\.tsx$/u;
const COMPONENT_NAME = /^[A-Z][A-Za-z0-9]*$/u;
const SOURCE_EXTENSIONS = ['', '.ts', '.tsx', '/index.ts', '/index.tsx'] as const;
// Owner-relative paths an entry must never reach: server roots, persistence, Action/Read declarations, workers.
const OWNER_SERVER_SOURCE =
  /^(?:api\/|vertical\.(?:registration|manifest|runtime-declaration)\.[cm]?ts$|src\/(?:actions|reads|handlers|workers|worker-host|db|database|repositories?|persistence|services|integrations|search)\/)|\.(?:read|action|server)\.[cm]?tsx?$/u;
const FORBIDDEN_PACKAGE = /^(?:pg|drizzle-orm(?:\/.*)?|@app\/core-runtime\/db(?:\/.*)?|node:.*)$/u;
const MAX_REEXPORT_DEPTH = 4;

const ExportKindSchema = Schema.Literals(['component', 'type', 'value']);
type ExportKind = typeof ExportKindSchema.Type;

export interface PublicComponentOwner {
  /** Owner deployment directory, e.g. `verticals/tagging`. */
  readonly directory: string;
  /** Owner package `exports` (string targets only). */
  readonly exports: Readonly<Record<string, string>>;
  /** Owner package name, e.g. `@app/tagging`. */
  readonly packageName: string;
}

export interface PublicComponentImport {
  /** Repository-relative consumer file. */
  readonly consumer: string;
  /** Package names the consumer's package declares as dependencies. */
  readonly consumerDependencies: ReadonlySet<string>;
  readonly owner: PublicComponentOwner;
  /** Every workspace source by repository-relative path. */
  readonly sources: ReadonlyMap<string, string>;
  /** The imported specifier, e.g. `@app/tagging/components/tag-controls`. */
  readonly specifier: string;
}

interface ParsedModule {
  readonly jsx: readonly Span[];
  readonly program: Program;
}

const parseModule = (file: string, source: string): ParsedModule | undefined => {
  const parsed = parseSync(file, source, {
    astType: 'ts',
    lang: file.endsWith('.tsx') ? 'tsx' : 'ts',
    sourceType: 'module',
  });
  if (parsed.errors.length > 0) {
    return undefined;
  }
  const jsx: Span[] = [];
  new Visitor({
    JSXElement: (node) => {
      jsx.push(node);
    },
    JSXFragment: (node) => {
      jsx.push(node);
    },
  }).visit(parsed.program);
  return { jsx, program: parsed.program };
};

const containsJsx = (module: ParsedModule, node: Span): boolean =>
  module.jsx.some((span) => node.start <= span.start && span.end <= node.end);

const exportName = (name: ModuleExportName): string => (name.type === 'Literal' ? name.value : name.name);

/** A component value: a JSX-returning function, optionally wrapped in `memo`/`forwardRef`. */
const isComponentValue = (module: ParsedModule, node: Argument | ExportDefaultDeclarationKind | null): boolean => {
  if (node === null) {
    return false;
  }
  if (
    node.type === 'ArrowFunctionExpression' ||
    node.type === 'FunctionExpression' ||
    node.type === 'FunctionDeclaration'
  ) {
    return containsJsx(module, node);
  }
  if (node.type !== 'CallExpression' || node.arguments.length !== 1) {
    return false;
  }
  const { callee } = node;
  let wrapper: string | undefined;
  if (callee.type === 'Identifier') {
    wrapper = callee.name;
  } else if (callee.type === 'MemberExpression' && callee.property.type === 'Identifier') {
    wrapper = callee.property.name;
  }
  return (wrapper === 'memo' || wrapper === 'forwardRef') && isComponentValue(module, node.arguments[0] ?? null);
};

const componentOrValue = (module: ParsedModule, name: string, value: Argument | Expression | null): ExportKind =>
  COMPONENT_NAME.test(name) && isComponentValue(module, value) ? 'component' : 'value';

const declare = (module: ParsedModule, declarations: Map<string, ExportKind>, declaration: Declaration): void => {
  if (declaration.type === 'TSInterfaceDeclaration' || declaration.type === 'TSTypeAliasDeclaration') {
    declarations.set(declaration.id.name, 'type');
  } else if (declaration.type === 'FunctionDeclaration' && declaration.id !== null) {
    declarations.set(
      declaration.id.name,
      COMPONENT_NAME.test(declaration.id.name) && containsJsx(module, declaration) ? 'component' : 'value',
    );
  } else if (declaration.type === 'VariableDeclaration') {
    for (const declarator of declaration.declarations) {
      if (declarator.id.type === 'Identifier') {
        declarations.set(declarator.id.name, componentOrValue(module, declarator.id.name, declarator.init));
      }
    }
  } else if (
    (declaration.type === 'ClassDeclaration' || declaration.type === 'TSEnumDeclaration') &&
    declaration.id !== null
  ) {
    declarations.set(declaration.id.name, 'value');
  }
};

/** Top-level local declarations by name: components, types, or other values. */
const localDeclarations = (module: ParsedModule): ReadonlyMap<string, ExportKind> => {
  const declarations = new Map<string, ExportKind>();
  for (const statement of module.program.body) {
    if (statement.type === 'ExportNamedDeclaration' && statement.declaration !== null) {
      declare(module, declarations, statement.declaration);
    } else if (
      statement.type === 'VariableDeclaration' ||
      statement.type === 'FunctionDeclaration' ||
      statement.type === 'ClassDeclaration' ||
      statement.type === 'TSInterfaceDeclaration' ||
      statement.type === 'TSTypeAliasDeclaration' ||
      statement.type === 'TSEnumDeclaration'
    ) {
      declare(module, declarations, statement);
    }
  }
  return declarations;
};

const resolveRelative = (
  sources: ReadonlyMap<string, string>,
  importer: string,
  specifier: string,
): string | undefined => {
  const base = nodePath.posix.normalize(nodePath.posix.join(nodePath.posix.dirname(importer), specifier));
  return SOURCE_EXTENSIONS.map((extension) => `${base}${extension}`).find((candidate) => sources.has(candidate));
};

const namedExports = (module: ParsedModule): readonly ExportNamedDeclaration[] =>
  module.program.body.filter((statement) => statement.type === 'ExportNamedDeclaration');

interface ExportLookup {
  readonly owner: string;
  readonly sources: ReadonlyMap<string, string>;
}

/** The kind of `name` as exported by `file`, following named re-exports inside the owner's `src/`. */
const exportedKind = (lookup: ExportLookup, file: string, name: string, depth = 0): ExportKind | undefined => {
  const source = lookup.sources.get(file);
  const module = source === undefined || depth > MAX_REEXPORT_DEPTH ? undefined : parseModule(file, source);
  if (module === undefined) {
    return undefined;
  }
  for (const statement of namedExports(module)) {
    const specifier = statement.specifiers.find((candidate) => exportName(candidate.exported) === name);
    if (specifier === undefined) {
      continue;
    }
    if (statement.exportKind === 'type' || specifier.exportKind === 'type') {
      return 'type';
    }
    const local = exportName(specifier.local);
    if (statement.source === null) {
      return localDeclarations(module).get(local);
    }
    const next = resolveRelative(lookup.sources, file, statement.source.value);
    return next?.startsWith(`${lookup.owner}/src/`) === true ? exportedKind(lookup, next, local, depth + 1) : undefined;
  }
  return localDeclarations(module).get(name);
};

const declaredNames = (statement: ExportNamedDeclaration): readonly string[] => {
  const { declaration } = statement;
  if (declaration === null) {
    return statement.specifiers
      .filter((specifier) => specifier.exportKind !== 'type')
      .map((specifier) => exportName(specifier.exported));
  }
  if (declaration.type === 'VariableDeclaration') {
    return declaration.declarations.flatMap((declarator) =>
      declarator.id.type === 'Identifier' ? [declarator.id.name] : ['<pattern>'],
    );
  }
  return 'id' in declaration && declaration.id !== null && declaration.id.type === 'Identifier'
    ? [declaration.id.name]
    : ['<declaration>'];
};

/** Every export of the entry must be a component or a type. */
const entryExportViolations = (lookup: ExportLookup, entry: string): readonly string[] => {
  const module = parseModule(entry, lookup.sources.get(entry) ?? '');
  if (module === undefined) {
    return ['entry does not parse'];
  }
  const locals = localDeclarations(module);
  const violations: string[] = [];
  for (const statement of module.program.body) {
    if (statement.type === 'ExportAllDeclaration') {
      violations.push('entry uses `export *`');
    } else if (statement.type === 'ExportDefaultDeclaration') {
      const { declaration } = statement;
      const component =
        declaration.type === 'Identifier'
          ? locals.get(declaration.name) === 'component'
          : isComponentValue(module, declaration);
      if (!component) {
        violations.push('default export is not a component');
      }
    } else if (statement.type === 'ExportNamedDeclaration' && statement.exportKind !== 'type') {
      for (const name of declaredNames(statement)) {
        const kind = exportedKind(lookup, entry, name);
        if (kind !== 'component' && kind !== 'type') {
          violations.push(`exports \`${name}\`, which is not a component or a type`);
        }
      }
    }
  }
  return violations;
};

const importSpecifiers = (source: string): readonly string[] =>
  [...source.matchAll(/(?:\bfrom\s+|\bimport\s*\(\s*|^\s*import\s+)['"](?<specifier>[^'"]+)['"]/gmu)].flatMap(
    (match) => (match.groups?.specifier === undefined ? [] : [match.groups.specifier]),
  );

/** A violation for one owner-local module the entry reaches; undefined when the walk may continue through it. */
const reachedModuleViolation = (lookup: ExportLookup, importer: string, target: string): string | undefined => {
  if (!target.startsWith(`${lookup.owner}/`)) {
    return `${importer} reaches outside its owner: ${target}`;
  }
  const ownerRelative = target.slice(lookup.owner.length + 1);
  if (OWNER_SERVER_SOURCE.test(ownerRelative)) {
    return `${importer} reaches owner server code ${target}`;
  }
  if (ownerRelative.startsWith('src/api/')) {
    const [header = ''] = (lookup.sources.get(target) ?? '').split('\n', 1);
    return GENERATED_CLIENT_HEADER.test(header)
      ? undefined
      : `${importer} reaches ${target}, which is not a generated owner client`;
  }
  return undefined;
};

/** Everything the entry reaches inside its owner stays client code; owner API access is generated clients only. */
const reachViolations = (lookup: ExportLookup, entry: string): readonly string[] => {
  const violations: string[] = [];
  const seen = new Set<string>([entry]);
  const pending = [entry];
  for (let file = pending.pop(); file !== undefined; file = pending.pop()) {
    for (const specifier of importSpecifiers(lookup.sources.get(file) ?? '')) {
      const target = specifier.startsWith('.') ? resolveRelative(lookup.sources, file, specifier) : undefined;
      if (FORBIDDEN_PACKAGE.test(specifier)) {
        violations.push(`${file} imports ${specifier}`);
      } else if (target !== undefined && !seen.has(target)) {
        seen.add(target);
        const violation = reachedModuleViolation(lookup, file, target);
        if (violation !== undefined) {
          violations.push(violation);
        } else if (!target.slice(lookup.owner.length + 1).startsWith('src/api/')) {
          pending.push(target);
        }
      }
    }
  }
  return violations;
};

const slotBody = (source: string, slot: string): string | undefined => {
  const start = source.indexOf(`// <${slot}>`);
  const end = source.indexOf(`// </${slot}>`);
  return start !== -1 && end > start ? source.slice(start, end) : undefined;
};

const escapeRegExp = (value: string): string => value.replaceAll(/[.*+?^${}()|[\]\\]/gu, String.raw`\$&`);

/** The entry an import selects when it names a declared public component; undefined for any other import. */
export const publicComponentEntry = (
  owner: PublicComponentOwner,
  specifier: string,
  sources: ReadonlyMap<string, string>,
): { readonly entry: string; readonly slug: string } | undefined => {
  if (!specifier.startsWith(`${owner.packageName}/`)) {
    return undefined;
  }
  const exported = owner.exports[`.${specifier.slice(owner.packageName.length)}`];
  if (exported === undefined || !exported.startsWith('./')) {
    return undefined;
  }
  const relative = nodePath.posix.normalize(exported.slice(2));
  const slug = COMPONENT_ENTRY.exec(relative)?.groups?.slug;
  const entry = `${owner.directory}/${relative}`;
  return slug !== undefined && (sources.get(entry) ?? '').startsWith(`${PUBLIC_COMPONENT_HEADER}\n`)
    ? { entry, slug }
    : undefined;
};

/** The owner's manifest and registration declare the component slug from the entry file. */
const declarationViolations = (owner: PublicComponentOwner, sources: ReadonlyMap<string, string>, slug: string) => {
  const violations: string[] = [];
  const file = `./src/components/${slug}.tsx`;
  const manifest = sources.get(`${owner.directory}/vertical.manifest.ts`) ?? '';
  const binding = new RegExp(String.raw`^\s*'${escapeRegExp(slug)}': (?<binding>[A-Z][A-Za-z0-9]*),$`, 'mu').exec(
    slotBody(manifest, 'generated-module-manifest-components') ?? '',
  )?.groups?.binding;
  if (
    binding === undefined ||
    !new RegExp(String.raw`^import \{ ${binding} \} from '${escapeRegExp(file)}';$`, 'mu').test(manifest)
  ) {
    violations.push(`owner manifest does not declare component '${slug}' from ${file}`);
  }
  const registration = slotBody(
    sources.get(`${owner.directory}/vertical.registration.ts`) ?? '',
    'generated-module-registration-components',
  );
  const registered = new RegExp(
    String.raw`^\s*'${escapeRegExp(slug)}': \(\) => import\('${escapeRegExp(file)}'\),$`,
    'mu',
  );
  if (registration === undefined || !registered.test(registration)) {
    violations.push(`owner registration does not register component '${slug}'`);
  }
  return violations;
};

/** Violations of the public-component rule for one consumer import; empty when it is an approved use. */
export const publicComponentImportViolations = (input: PublicComponentImport): readonly string[] => {
  const { consumer, consumerDependencies, owner, sources, specifier } = input;
  const selected = publicComponentEntry(owner, specifier, sources);
  if (selected === undefined) {
    return ['not a declared public-component entry'];
  }
  const violations: string[] = [];
  if (consumer.startsWith(`${owner.directory}/`)) {
    violations.push('owner imports its own public entry by package name');
  }
  if (!consumerDependencies.has(owner.packageName)) {
    violations.push(`consumer package does not declare ${owner.packageName}`);
  }
  const lookup: ExportLookup = { owner: owner.directory, sources };
  violations.push(
    ...declarationViolations(owner, sources, selected.slug),
    ...entryExportViolations(lookup, selected.entry),
    ...reachViolations(lookup, selected.entry),
  );
  return violations;
};
