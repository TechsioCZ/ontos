import { pathToFileURL } from 'node:url';

import { Effect, FileSystem, Option, Schema } from 'effect';

import { createCodesmithGenerator } from '../generator-adapter.mts';
import { readAndPatch } from '../module-api/core-read.mts';
import {
  createOrAcceptGeneratedMutationEffect,
  ensureUniqueMutationPaths,
  requireCanonicalSlug,
  raiseScaffoldFailure,
  requireCoreModuleKey,
  resolveContainedPath,
  scaffoldFailure,
  toCamelCase,
  toPascalCase,
  tryScaffold,
} from '../shared.mts';
import type { CoreActionHttpScaffoldConfig, CoreActionHttpScaffoldResult, Mutation } from '../shared.mts';
import { collectDomainErrors, inspectAction, isDomainProblemKind } from './scaffold.mts';
import type { DomainErrorIdentity, DomainProblemKind } from './scaffold.mts';

const HEADER = '// @generated by OntOS Codesmith Core Action HTTP v1';
const CONTRACT_MODULE_PATTERN = /^@app\/core-runtime\/(?<subpath>[a-z][a-z0-9-]*(?:\/[a-z][a-z0-9-]*)*)$/u;
/** `./file.ts#name` (a module under apps/shell-super-app/api) or a bare `name` the host root `api/index.ts` defines. */
const REQUEST_SERVICES_PATTERN =
  /^(?:(?<module>\.\/[A-Za-z0-9][A-Za-z0-9._-]*\.ts)#)?(?<export>[A-Za-z][A-Za-z0-9]*)$/u;

const markers = {
  clientImports: 'core-action-client-imports',
  clientOperations: 'core-action-client-operations',
  serverApiGroups: 'core-action-server-api-groups',
  serverGroups: 'core-action-server-groups',
  serverImports: 'core-action-server-imports',
  serverLayers: 'core-action-server-layers',
  sharedGroups: 'core-action-api-groups',
  sharedImports: 'core-action-contract-imports',
} as const;

const MappedProblemKindSchema = Schema.Literals(['conflict', 'forbidden', 'ineligible', 'notFound', 'unavailable']);
type MappedProblemKind = typeof MappedProblemKindSchema.Type;
const isMappedProblemKind = Schema.is(MappedProblemKindSchema);

/**
 * The Shell problem each domain error kind answers with. These are the host's own problem constructors (the same
 * ones the Core reads and the byte edge use), so a Core Action route never invents a second error vocabulary.
 * `rateLimited` and `timeout` have no Shell problem without a retry hint, so they are refused rather than guessed.
 */
const SHELL_PROBLEM_BY_KIND = {
  conflict: 'shellPolicyConflictProblem',
  forbidden: 'shellTargetForbiddenProblem',
  ineligible: 'shellPolicyUnprocessableProblem',
  notFound: 'shellTargetNotFoundProblem',
  unavailable: 'shellCapabilityUnavailableProblem',
} as const satisfies Record<MappedProblemKind, string>;

export interface CoreActionHttpDomainProblem {
  readonly kind: MappedProblemKind;
  readonly tag: string;
}

/** One answer per domain error tag: the kind the name heuristic decides, or the one the owner states. */
export const resolveCoreDomainProblems = (
  errors: readonly DomainErrorIdentity[],
  overrides: readonly string[],
): readonly CoreActionHttpDomainProblem[] => {
  const stated = new Map<string, DomainProblemKind>();
  for (const override of overrides) {
    const [tag, kind, ...rest] = override.split('=');
    if (tag === undefined || kind === undefined || rest.length > 0 || !isDomainProblemKind(kind)) {
      return raiseScaffoldFailure(`--domain-error-kind must be <Tag>=<kind>; got ${override}`);
    }
    if (!errors.some((error) => error.tag === tag)) {
      return raiseScaffoldFailure(`--domain-error-kind names ${tag}, which is not a domain error of the Action`);
    }
    if (stated.has(tag)) {
      return raiseScaffoldFailure(`--domain-error-kind names ${tag} twice`);
    }
    stated.set(tag, kind);
  }
  const tags = [...new Set(errors.map(({ tag }) => tag))].toSorted((left, right) => left.localeCompare(right));
  return tags.map((tag) => {
    const kinds = new Set(errors.filter((error) => error.tag === tag).map(({ kind }) => kind));
    const kind = stated.get(tag) ?? (kinds.size === 1 ? [...kinds][0] : undefined);
    if (kind === undefined) {
      return raiseScaffoldFailure(
        `domain error ${tag} maps to more than one problem kind; state one with --domain-error-kind`,
      );
    }
    if (!isMappedProblemKind(kind)) {
      return raiseScaffoldFailure(
        `domain error ${tag} is ${kind}, which the Shell has no problem for; state another kind with --domain-error-kind`,
      );
    }
    return { kind, tag };
  });
};

/** The browser-safe wire contract: the owner's own schemas, re-published, plus the encoded request shape. */
export const renderCoreActionContract = (module: string, action: string, contractModule: string): string => {
  const type = toPascalCase(action);
  return `${HEADER}
// @ontos-core-action-http-owner ${module}
// @ontos-core-action-http-slug ${action}
import { Schema } from '@modern-js/bff-effect/effect-client';
import { ${type}PayloadSchema } from '${contractModule}';
import type { ${type}ResultSchema } from '${contractModule}';

export { ${type}PayloadSchema, ${type}ResultSchema } from '${contractModule}';

/** The JSON body of the request: the encoded form of the owner's payload. */
export const ${type}RequestSchema = Schema.toEncoded(${type}PayloadSchema);
/** Encodes the owner's payload to the JSON body; the client sends nothing it has not encoded. */
export const encode${type}Payload = Schema.encodeUnknownEffect(${type}PayloadSchema);
export type ${type}Payload = typeof ${type}PayloadSchema.Type;
export type ${type}Result = typeof ${type}ResultSchema.Type;
`;
};

export const renderCoreActionApiGroup = (action: string): string => {
  const type = toPascalCase(action);
  return `  .add(
    HttpApiGroup.make('coreAction${type}').add(
      HttpApiEndpoint.post('execute${type}', '/core/actions/${action}', {
        error: identityErrors,
        headers: IdentityRequestHeadersSchema,
        payload: ${type}RequestSchema,
        success: ${type}ResultSchema,
      }),
    ),
  )`;
};

const renderDomainMapper = (type: string, value: string, problems: readonly CoreActionHttpDomainProblem[]): string => {
  if (problems.length === 0) {
    return `const coreAction${type}Problem = (error: ActionCoreError): IdentityProblem => identityProblem(error);`;
  }
  const handlers = problems.map(({ kind, tag }) => `      ${tag}: ${SHELL_PROBLEM_BY_KIND[kind]},`).join('\n');
  return `const coreAction${type}Problem = (
  error: ActionCoreError | typeof ${value}Action.descriptor.domainErrorSchema.Type,
): IdentityProblem =>
  Schema.is(${value}Action.descriptor.domainErrorSchema)(error)
    ? Match.value(error).pipe(
        Match.tags({
${handlers}
        }),
        Match.exhaustive,
      )
    : identityProblem(error);`;
};

export const renderCoreActionServerGroup = (
  action: string,
  problems: readonly CoreActionHttpDomainProblem[],
  providerExport?: string,
): string => {
  const type = toPascalCase(action);
  const value = toCamelCase(action);
  const run = `runtime.runAction({
        payload,
        principal: resolved.principal,
        registration: ${value}Action,
        savedReply: 'answer',
        transport: { correlationId, idempotencyKey },
      })`;
  const execute =
    providerExport === undefined
      ? `return yield* ${run}.pipe(
        Effect.catch((error) => pipe(error, coreAction${type}Problem, failIdentityProblem)),
      );`
      : `return yield* ${providerExport}({ payload, principal: resolved.principal, transport: { correlationId } })(
        ${run},
      ).pipe(Effect.catch((error) => pipe(error, coreAction${type}Problem, failIdentityProblem)));`;
  return `${renderDomainMapper(type, value, problems)}

const coreAction${type}GroupLive = HttpApiBuilder.group(ShellAuthenticationApi, 'coreAction${type}', (handlers) =>
  handlers.handle('execute${type}', ({ headers, payload, request }) =>
    Effect.gen(function* execute${type}CoreAction() {
      const authentication = yield* AuthenticationService;
      const resolved = yield* authentication.resolveTenantContext(requestHeaders(request.headers)).pipe(
        Effect.catch((error) => pipe(error, identityProblem, failIdentityProblem)),
      );
      yield* forwardSetCookieHeaders(resolved.setCookieHeaders);
      if (resolved.state !== 'authenticated') {
        return yield* failIdentityProblem(shellAuthenticationRequiredProblem());
      }
      const idempotencyKey = yield* requiredIdempotencyKey(headers);
      const correlationId = correlationFromRequest(request);
      const runtime = yield* ActionRuntime;
      ${execute}
    }).pipe(
      recoverUnexpectedDefect(request, 'Unexpected Shell Core Action defect', () =>
        failIdentityProblem(shellInternalProblem()),
      ),
    ),
  ),
);`;
};

export const renderCoreActionClientOperation = (action: string): string => {
  const type = toPascalCase(action);
  return `export const execute${type} = (
  payload: ${type}Payload,
  options: IdentityClientOptions,
): Effect.Effect<${type}Result, IdentityClientError> =>
  encode${type}Payload(payload).pipe(
    Effect.flatMap((encoded) =>
      invokeShellAuthenticationClient(options, (client) =>
        client.coreAction${type}.execute${type}({ headers: identityHeaders(options), payload: encoded }),
      ),
    ),
  );`;
};

const parseRequestServices = (value: string | undefined) => {
  if (value === undefined) {
    return Option.none<{ readonly export: string; readonly module: string | undefined }>();
  }
  const groups = REQUEST_SERVICES_PATTERN.exec(value)?.groups;
  const exported = groups?.['export'];
  if (exported === undefined) {
    return raiseScaffoldFailure(
      '--request-services must be ./<file>.ts#<exportName> under apps/shell-super-app/api, or a name api/index.ts defines',
    );
  }
  return Option.some({ export: exported, module: groups?.['module'] });
};

const readText = Effect.fn('CoreActionHttpScaffold.readText')(function* readText(path: string, label: string) {
  const fs = yield* FileSystem.FileSystem;
  return yield* fs
    .readFileString(path)
    .pipe(Effect.mapError((cause) => scaffoldFailure(`failed to read ${label} ${path}`, cause)));
});

const CoreRuntimeManifestSchema = Schema.Struct({
  exports: Schema.Record(Schema.String, Schema.Unknown),
});
const PublishedSourceExportSchema = Schema.String.check(Schema.isStartingWith('./src/'));
const ContractSchemaSchema = Schema.declare<Schema.Top>(Schema.isSchema);

/** The one published export a contract module specifier names, resolved from the Core runtime's own manifest. */
const resolveContractModuleFile = Effect.fn('CoreActionHttpScaffold.resolveContractModule')(
  function* resolveContractModuleFile(coreRoot: string, contractModule: string) {
    const subpath = CONTRACT_MODULE_PATTERN.exec(contractModule)?.groups?.['subpath'];
    if (subpath === undefined) {
      return yield* scaffoldFailure('--contract-module must be a published @app/core-runtime/<export> specifier');
    }
    const manifestPath = yield* tryScaffold('invalid Core runtime manifest path', () =>
      resolveContainedPath(coreRoot, 'package.json'),
    );
    const manifestSource = yield* readText(manifestPath, 'Core runtime manifest');
    const manifest = yield* Schema.decodeUnknownEffect(Schema.fromJsonString(CoreRuntimeManifestSchema))(
      manifestSource,
    ).pipe(Effect.mapError((cause) => scaffoldFailure(`failed to decode ${manifestPath}`, cause)));
    const exported = yield* Schema.decodeUnknownEffect(PublishedSourceExportSchema)(
      manifest.exports[`./${subpath}`],
    ).pipe(
      Effect.mapError((cause) =>
        scaffoldFailure(`${contractModule} is not a published source export of @app/core-runtime`, cause),
      ),
    );
    return yield* tryScaffold('invalid contract module path', () => resolveContainedPath(coreRoot, exported));
  },
);

/**
 * The shared contract must carry the registration's own schemas, not a copy: a copy can drift from what the
 * Action decodes. Both are loaded through the same file URL the Action source imports, so identity is meaningful.
 */
const validateContractModule = Effect.fn('CoreActionHttpScaffold.validateContractModule')(
  function* validateContractModule(
    contractFile: string,
    type: string,
    contractModule: string,
    descriptor: { readonly payloadSchema: Schema.Top; readonly resultSchema?: Schema.Top | undefined },
  ) {
    const payloadName = `${type}PayloadSchema`;
    const resultName = `${type}ResultSchema`;
    const loaded = yield* Effect.tryPromise({
      catch: (cause) => scaffoldFailure(`failed to inspect ${contractModule}`, cause),
      try: async () => {
        const contract: unknown = await import(pathToFileURL(contractFile).href);
        return contract;
      },
    });
    const schemas = yield* Schema.decodeUnknownEffect(
      Schema.Struct({ [payloadName]: ContractSchemaSchema, [resultName]: ContractSchemaSchema }),
    )(loaded).pipe(
      Effect.mapError((cause) =>
        scaffoldFailure(`${contractModule} must export ${payloadName} and ${resultName}`, cause),
      ),
    );
    if (schemas[payloadName] !== descriptor.payloadSchema || schemas[resultName] !== descriptor.resultSchema) {
      return yield* scaffoldFailure(
        `${contractModule} exports schemas that are not the Action registration's own payload and result schemas`,
      );
    }
    return schemas;
  },
);

/** A Core Action entry is owned by this generator: its tag is what a re-run recognises. */
const patchRoot = (path: string, slots: readonly (readonly [string, string, string])[], coreImport?: string) =>
  readAndPatch(path, slots, coreImport, 'core-action');

export const planCoreActionHttpScaffold = Effect.fn('CoreActionHttpScaffold.plan')(function* planCoreActionHttpScaffold(
  workspaceRoot: string,
  config: CoreActionHttpScaffoldConfig,
) {
  const action = yield* tryScaffold('Action name is invalid', () => requireCanonicalSlug(config.action, 'action'));
  const module = yield* tryScaffold('Core Action module is invalid', () => requireCoreModuleKey(config.module));
  const requestServices = yield* tryScaffold('request services are invalid', () =>
    parseRequestServices(config.requestServices),
  );
  const type = toPascalCase(action);
  const value = toCamelCase(action);
  const coreRoot = yield* tryScaffold('invalid Core path', () =>
    resolveContainedPath(workspaceRoot, 'packages', 'core-runtime'),
  );
  const shellRoot = yield* tryScaffold('invalid Shell path', () =>
    resolveContainedPath(workspaceRoot, 'apps', 'shell-super-app'),
  );
  const actionPath = yield* tryScaffold('invalid Core Action path', () =>
    resolveContainedPath(coreRoot, 'src', 'modules', 'actions', `${action}.action.ts`),
  );
  const contractPath = yield* tryScaffold('invalid Shell contract path', () =>
    resolveContainedPath(shellRoot, 'shared', 'core-actions', `${action}.ts`),
  );
  const browserApi = yield* tryScaffold('invalid Shell browser API path', () =>
    resolveContainedPath(shellRoot, 'shared', 'browser-api.ts'),
  );
  const serverApi = yield* tryScaffold('invalid Shell server API path', () =>
    resolveContainedPath(shellRoot, 'shared', 'api.ts'),
  );
  const serverRoot = yield* tryScaffold('invalid Shell server path', () =>
    resolveContainedPath(shellRoot, 'api', 'index.ts'),
  );
  const clientRoot = yield* tryScaffold('invalid Shell client path', () =>
    resolveContainedPath(shellRoot, 'src', 'api', 'auth-client.ts'),
  );
  if (Option.isSome(requestServices)) {
    const { export: exported, module: providerModule } = requestServices.value;
    const path = yield* tryScaffold('invalid request services path', () =>
      resolveContainedPath(shellRoot, 'api', providerModule ?? 'index.ts'),
    );
    const source = yield* readText(path, 'request services module');
    const declaration = providerModule === undefined ? '(?:export )?(?:const|function)' : 'export (?:const|function)';
    if (!new RegExp(`${declaration} ${exported}\\b`, 'u').test(source)) {
      return yield* scaffoldFailure(`${providerModule ?? 'api/index.ts'} does not define ${exported}`);
    }
  }

  const actionSource = yield* readText(actionPath, 'Core Action source');
  for (const expected of [`// @ontos-action-owner ${module}`, `// @ontos-action-slug ${action}`]) {
    if (!actionSource.includes(expected)) {
      return yield* scaffoldFailure(`Core Action source is missing ${expected}`);
    }
  }
  const inspected = yield* inspectAction(actionPath, `${value}Action`);
  const { descriptor } = inspected;
  if (descriptor.actionKey !== `${module}.${action}` || descriptor.owningModuleKey !== module) {
    return yield* scaffoldFailure('Core Action runtime identity does not match owner/slug');
  }
  if (descriptor.idempotency !== 'required') {
    return yield* scaffoldFailure('a Core Action route needs a required Idempotency-Key; this Action declares none');
  }
  const contractFile = yield* resolveContractModuleFile(coreRoot, config.contractModule);
  yield* validateContractModule(contractFile, type, config.contractModule, descriptor);
  const domainErrors = yield* tryScaffold('Action domain error schema is not transportable', () =>
    collectDomainErrors(descriptor.domainErrorSchema.ast),
  );
  const problems = yield* tryScaffold('Core Action domain errors cannot be mapped', () =>
    resolveCoreDomainProblems(domainErrors, config.domainErrorKinds ?? []),
  );

  const created = yield* createOrAcceptGeneratedMutationEffect(
    contractPath,
    renderCoreActionContract(module, action, config.contractModule),
  );
  const canonicalImport = `// ${value}Action uses the canonical @app/core-runtime import`;
  const providerImport = Option.match(requestServices, {
    onNone: () => canonicalImport,
    onSome: ({ export: exported, module: providerModule }) =>
      providerModule === undefined
        ? canonicalImport
        : `import { ${exported} } from '${providerModule}';\n${canonicalImport}`,
  });
  const patched = yield* Effect.all([
    patchRoot(browserApi, [
      [
        markers.sharedImports,
        action,
        `import { ${type}RequestSchema, ${type}ResultSchema } from './core-actions/${action}.ts';`,
      ],
      [markers.sharedGroups, action, renderCoreActionApiGroup(action)],
    ]),
    patchRoot(serverApi, [[markers.serverApiGroups, action, `  .add(ShellBrowserApi.groups.coreAction${type})`]]),
    patchRoot(
      serverRoot,
      [
        [markers.serverImports, action, providerImport],
        [
          markers.serverGroups,
          action,
          renderCoreActionServerGroup(
            action,
            problems,
            requestServices.pipe(
              Option.map(({ export: exported }) => exported),
              Option.getOrUndefined,
            ),
          ),
        ],
        [markers.serverLayers, action, `coreAction${type}GroupLive,`],
      ],
      `${value}Action`,
    ),
    patchRoot(clientRoot, [
      [
        markers.clientImports,
        action,
        `import { encode${type}Payload } from '../../shared/core-actions/${action}.ts';\nimport type { ${type}Payload, ${type}Result } from '../../shared/core-actions/${action}.ts';`,
      ],
      [markers.clientOperations, action, renderCoreActionClientOperation(action)],
    ]),
  ]);
  const mutations: Mutation[] = [...Option.toArray(created), ...patched.filter((item) => item !== undefined)];
  yield* tryScaffold('Core Action mutation paths are invalid', () => ensureUniqueMutationPaths(mutations));
  return {
    mutations,
    result: { clientPath: clientRoot, contractPath, serverPath: serverRoot } satisfies CoreActionHttpScaffoldResult,
  };
});

export default createCodesmithGenerator(planCoreActionHttpScaffold);
