const HEADER = '// @generated by OntOS Codesmith Action HTTP v1';
const CLIENT_SLOT_START = '// <generated-action-http-client-exports>';
const CLIENT_SLOT_END = '// </generated-action-http-client-exports>';

const DomainProblemKindSchema = Schema.Literals([
  'conflict',
  'forbidden',
  'ineligible',
  'notFound',
  'rateLimited',
  'timeout',
  'unavailable',
]);
type DomainProblemKind = typeof DomainProblemKindSchema.Type;
const AnnotationMapSchema = Schema.Record(Schema.String, Schema.Unknown);
type AnnotationMap = typeof AnnotationMapSchema.Type;

interface DomainErrorIdentity {
  readonly code: string;
  readonly discriminator: '_tag' | 'code' | 'reasonCode';
  readonly kind: DomainProblemKind;
  readonly tag: string;
  readonly value: string;
}

interface SchemaAstPropertyLike {
  readonly name?: unknown;
  readonly type?: SchemaAstLike & { readonly literal?: unknown };
}

interface SchemaAstLike {
  readonly _tag?: string;
  readonly annotations?: AnnotationMap;
  readonly encoding?: readonly { readonly to?: SchemaAstLike }[];
  readonly literal?: unknown;
  readonly propertySignatures?: readonly SchemaAstPropertyLike[];
  readonly typeParameters?: readonly SchemaAstLike[];
  readonly types?: readonly SchemaAstLike[];
}

interface ActionModuleLike {
  readonly descriptor: {
    readonly actionKey: string;
    readonly domainErrorSchema: { readonly ast: SchemaAstLike };
    readonly idempotency: 'optional' | 'required';
    readonly owningModuleKey: string;
  };
}

const UnknownRecordSchema = Schema.Record(Schema.String, Schema.Unknown);
type UnknownRecord = typeof UnknownRecordSchema.Type;
const decodeRecord = Schema.decodeUnknownOption(UnknownRecordSchema);
const isString = Schema.is(Schema.String);
const decodeSentinels = Schema.decodeUnknownOption(
  Schema.Array(Schema.Struct({ key: Schema.String, literal: Schema.String })),
);

const addDomainErrorValue = (values: Map<string, Set<string>>, key: string, value: string): void => {
  const existing = values.get(key) ?? new Set<string>();
  existing.add(value);
  values.set(key, existing);
};

const domainErrorObjectNodes = (node: SchemaAstLike): readonly SchemaAstLike[] => [
  node,
  ...(node.typeParameters ?? []),
  ...(node.encoding ?? []).flatMap((link) => (link.to === undefined ? [] : [link.to])),
];

const domainErrorLiteralValues = (propertyType: SchemaAstLike): readonly string[] => {
  const propertyTypes = propertyType.types;
  const literals = Predicate.isTagged(propertyType, 'Union') ? (propertyTypes ?? []) : [propertyType];
  return literals.flatMap((literal) => {
    const literalValue = literal.literal;
    return Predicate.isTagged(literal, 'Literal') && isString(literalValue) ? [literalValue] : [];
  });
};

const addAstPropertyDomainErrorValues = (values: Map<string, Set<string>>, property: SchemaAstPropertyLike): void => {
  if (!isString(property.name) || property.type === undefined) {
    return;
  }
  for (const literalValue of domainErrorLiteralValues(property.type)) {
    addDomainErrorValue(values, property.name, literalValue);
  }
};

const addAstDomainErrorValues = (values: Map<string, Set<string>>, node: SchemaAstLike): void => {
  for (const objectNode of domainErrorObjectNodes(node)) {
    for (const property of objectNode.propertySignatures ?? []) {
      addAstPropertyDomainErrorValues(values, property);
    }
  }
};

const collectNodeDomainErrorValues = (node: SchemaAstLike): Map<string, Set<string>> => {
  const values = new Map<string, Set<string>>();
  const sentinels = Option.getOrElse(decodeSentinels(node.annotations?.['~sentinels']), () => []);
  for (const sentinel of sentinels) {
    addDomainErrorValue(values, sentinel.key, sentinel.literal);
  }
  addAstDomainErrorValues(values, node);
  return values;
};

const classifyDomainError = (tag: string, code: string): DomainProblemKind => {
  const value = `${tag}_${code}`.toLowerCase();
  if (/rate.?limit|quota/u.test(value)) {
    return 'rateLimited';
  }
  if (/timeout|deadline/u.test(value)) {
    return 'timeout';
  }
  if (/unavailable|dependency|indeterminate|currentness|integration|persistence/u.test(value)) {
    return 'unavailable';
  }
  if (/not.?found|missing|absent/u.test(value)) {
    return 'notFound';
  }
  if (/scope.?mismatch|access.?denied|forbidden|permission.?denied/u.test(value)) {
    return 'forbidden';
  }
  if (
    /conflict|revision|overlap|duplicate|already|lifecycle|stale|archived|suspended|revoked|claimed|in.?use/u.test(
      value,
    )
  ) {
    return 'conflict';
  }
  return 'ineligible';
};

const domainCodeFromTag = (tag: string): string =>
  tag
    .replaceAll(/(?<lower>[a-z0-9])(?<upper>[A-Z])/gu, '$<lower>_$<upper>')
    .replaceAll(/(?<acronym>[A-Z])(?<word>[A-Z][a-z])/gu, '$<acronym>_$<word>')
    .toLowerCase();

const domainErrorValues = (values: Map<string, Set<string>>, key: string): readonly string[] => [
  ...(values.get(key) ?? []),
];

const domainErrorIdentity = (
  tag: string,
  code: string,
  discriminator: DomainErrorIdentity['discriminator'],
  value: string,
  classification = code,
): DomainErrorIdentity => ({
  code,
  discriminator,
  kind: classifyDomainError(tag, classification),
  tag,
  value,
});

const domainErrorIdentitiesFromValues = (values: Map<string, Set<string>>): readonly DomainErrorIdentity[] => {
  const tags = domainErrorValues(values, '_tag');
  if (tags.length !== 1) {
    return raiseScaffoldFailure('every Action domain error must expose one literal _tag sentinel');
  }
  const tag = tags[0] ?? '';
  const codes = domainErrorValues(values, 'code');
  const reasonCodes = domainErrorValues(values, 'reasonCode');
  const normalizedCodes = codes.length === 0 ? [domainCodeFromTag(tag)] : codes;
  if (reasonCodes.length > 0 && normalizedCodes.length === 1) {
    const code = normalizedCodes[0] ?? domainCodeFromTag(tag);
    return reasonCodes.map((reasonCode) =>
      domainErrorIdentity(tag, code, 'reasonCode', reasonCode, `${code}_${reasonCode}`),
    );
  }
  if (normalizedCodes.length > 1) {
    return normalizedCodes.map((code) => domainErrorIdentity(tag, code, 'code', code));
  }
  const code = normalizedCodes[0] ?? domainCodeFromTag(tag);
  return [domainErrorIdentity(tag, code, '_tag', tag)];
};

const collectDomainErrors = (ast: SchemaAstLike): readonly DomainErrorIdentity[] => {
  const astTypes = ast.types;
  const nodes: readonly SchemaAstLike[] = Predicate.isTagged(ast, 'Union') ? (astTypes ?? []) : [ast];
  const errors = nodes.flatMap((node) => domainErrorIdentitiesFromValues(collectNodeDomainErrorValues(node)));
  const identities = new Set(errors.map(({ discriminator, tag, value }) => `${tag}:${discriminator}:${value}`));
  if (identities.size !== errors.length) {
    return raiseScaffoldFailure('Action domain error identities must be unique');
  }
  return errors.toSorted((left, right) => left.tag.localeCompare(right.tag) || left.code.localeCompare(right.code));
};

interface DecodedActionRegistration {
  readonly action: UnknownRecord;
  readonly descriptor: UnknownRecord;
  readonly domainErrorSchema: UnknownRecord;
}

// oxlint-disable-next-line anti-slop/no-unknown-parameters -- Dynamic import namespaces are untrusted here and are decoded field-by-field before the scaffold accepts the registration.
const decodeActionRegistration = (module: unknown, value: string): Option.Option<DecodedActionRegistration> =>
  Option.gen(function* decodeActionRegistrationOption() {
    const moduleRecord = yield* decodeRecord(module);
    const action = yield* decodeRecord(moduleRecord[value]);
    const descriptor = yield* decodeRecord(action['descriptor']);
    const domainErrorSchema = yield* decodeRecord(descriptor['domainErrorSchema']);
    return { action, descriptor, domainErrorSchema };
  });

const isValidActionRegistration = (registration: DecodedActionRegistration): boolean =>
  isString(registration.descriptor['actionKey']) &&
  isString(registration.descriptor['owningModuleKey']) &&
  (registration.descriptor['idempotency'] === 'required' || registration.descriptor['idempotency'] === 'optional') &&
  Schema.is(UnknownRecordSchema)(registration.domainErrorSchema['ast']);

// oxlint-disable-next-line effect-native/no-async-script-program -- Dynamic module import is the script driver boundary and is immediately wrapped by loadAction's typed Effect.tryPromise channel.
const inspectAction = async (actionPath: string, value: string): Promise<ActionModuleLike> => {
  const actionUrl = new URL(`file://${actionPath}`).href;
  const registration = Option.getOrUndefined(decodeActionRegistration(await import(`${actionUrl}?action-http`), value));
  if (registration === undefined || !isValidActionRegistration(registration)) {
    return raiseScaffoldFailure(`Action export ${value} is not a valid registration`);
  }
  // SAFETY: the descriptor shape and all fields consumed by the generator were checked above.
  // oxlint-disable-next-line anti-slop/no-chained-type-assertions, typescript/no-unsafe-type-assertion -- Validated dynamic Action module shape; expires: 2027-03-31.
  return registration.action as unknown as ActionModuleLike;
};

const loadAction = (
  actionPath: string,
  value: string,
): Effect.Effect<ActionModuleLike, ReturnType<typeof scaffoldFailure>> =>
  Effect.tryPromise({
    catch: (cause) => scaffoldFailure(`failed to inspect existing Action ${actionPath}`, cause),
    // oxlint-disable-next-line typescript/promise-function-async -- Effect.tryPromise intentionally accepts a lazy Promise-returning thunk and owns its rejection mapping.
    try: () => inspectAction(actionPath, value),
  });

const literalList = (values: readonly string[]): string => {
  const literals = values.map((value) => `'${value}'`).join(', ');
  return values.length === 1 ? `Schema.Literal('${values[0] ?? ''}')` : `Schema.Literals([${literals}])`;
};

const domainCodes = (errors: readonly DomainErrorIdentity[], kind: DomainProblemKind): readonly string[] => [
  ...new Set(errors.filter((error) => error.kind === kind).map((error) => error.code)),
];

export const renderActionHttpContract = (
  vertical: OntosVerticalMetadata,
  action: string,
  errors: readonly DomainErrorIdentity[],
): string => {
  const type = toPascalCase(action);
  const group = `${toCamelCase(action)}Action`;
  const codes = {
    conflict: ['action_request_hash_conflict', 'action_invocation_state_invalid', ...domainCodes(errors, 'conflict')],
    forbidden: [
      'action_permission_denied',
      'module_state_denied',
      'operation_context_denied',
      'operation_context_invalid',
      ...domainCodes(errors, 'forbidden'),
    ],
    ineligible: ['action_policy_denied', ...domainCodes(errors, 'ineligible')],
    notFound: ['action_invocation_not_found', ...domainCodes(errors, 'notFound')],
    unavailable: [
      'action_invocation_persistence_failed',
      'action_permission_check_failed',
      'action_policy_evaluation_failed',
      'action_transaction_failed',
      'module_state_check_unavailable',
      'operation_context_unavailable',
      ...domainCodes(errors, 'unavailable'),
    ],
  };
  const rateCodes = domainCodes(errors, 'rateLimited');
  const timeoutCodes = domainCodes(errors, 'timeout');
  return `${HEADER}
// @ontos-action-http-owner ${vertical.moduleId}
// @ontos-action-http-slug ${action}
import { makeProblemDetailsSchema, makeRetryableProblemDetailsSchema } from '@app/shared-contracts/problem-details';
import { HttpApi, HttpApiEndpoint, HttpApiGroup, Schema } from '@modern-js/bff-effect/effect-client';
import { HttpApiMiddleware } from 'effect/unstable/httpapi';
import {
  ${type}PayloadSchema,
  ${type}ResultSchema,
} from '../actions/${action}.ts';

export { ${type}PayloadSchema, ${type}ResultSchema } from '../actions/${action}.ts';
export type { ${type}Payload, ${type}Result } from '../actions/${action}.ts';

export const ${type}ActionHeadersSchema = Schema.Struct({
  'idempotency-key': Schema.optionalKey(
    Schema.String.check(Schema.isMinLength(1), Schema.isMaxLength(200)),
  ),
});

export const ${type}ActionInvalidProblemSchema = makeProblemDetailsSchema('${type}ActionInvalidProblem', 400);
export const ${type}ActionAuthenticationProblemSchema = makeProblemDetailsSchema('${type}ActionAuthenticationProblem', 401);
export const ${type}ActionForbiddenProblemSchema = makeProblemDetailsSchema('${type}ActionForbiddenProblem', 403, { code: ${literalList(codes.forbidden)} });
export const ${type}ActionNotFoundProblemSchema = makeProblemDetailsSchema('${type}ActionNotFoundProblem', 404, { code: ${literalList(codes.notFound)} });
export const ${type}ActionConflictProblemSchema = makeProblemDetailsSchema('${type}ActionConflictProblem', 409, { code: ${literalList(codes.conflict)} });
export const ${type}ActionIneligibleProblemSchema = makeProblemDetailsSchema('${type}ActionIneligibleProblem', 422, { code: ${literalList(codes.ineligible)} });
export const ${type}ActionPreconditionProblemSchema = makeProblemDetailsSchema('${type}ActionPreconditionProblem', 428);
${rateCodes.length === 0 ? '' : `export const ${type}ActionRateLimitedProblemSchema = makeProblemDetailsSchema('${type}ActionRateLimitedProblem', 429, { code: ${literalList(rateCodes)} });\n`}${timeoutCodes.length === 0 ? '' : `export const ${type}ActionTimeoutProblemSchema = makeRetryableProblemDetailsSchema('${type}ActionTimeoutProblem', 504, { code: ${literalList(timeoutCodes)} });\n`}export const ${type}ActionUnavailableProblemSchema = makeRetryableProblemDetailsSchema('${type}ActionUnavailableProblem', 503, { code: ${literalList(codes.unavailable)} });
export const ${type}ActionAlreadyCommittedProblemSchema = makeProblemDetailsSchema('${type}ActionAlreadyCommittedProblem', 409, {
  code: Schema.Literal('action_already_committed'),
  invocationId: Schema.String,
  resolution: Schema.Literal('REFRESH_GOVERNED_READS'),
  retryCommand: Schema.Literal(false),
});
export const ${type}ActionCommitIndeterminateProblemSchema = makeProblemDetailsSchema('${type}ActionCommitIndeterminateProblem', 503, {
  invocationId: Schema.String,
  resolution: Schema.Literal('RESOLVE_COMMIT'),
  retryCommand: Schema.Literal(false),
});
export const ${type}ActionInternalProblemSchema = makeProblemDetailsSchema('${type}ActionInternalProblem', 500);

export type ${type}ActionProblem =
  | typeof ${type}ActionInvalidProblemSchema.Type
  | typeof ${type}ActionAuthenticationProblemSchema.Type
  | typeof ${type}ActionForbiddenProblemSchema.Type
  | typeof ${type}ActionNotFoundProblemSchema.Type
  | typeof ${type}ActionConflictProblemSchema.Type
  | typeof ${type}ActionIneligibleProblemSchema.Type
  | typeof ${type}ActionPreconditionProblemSchema.Type
${rateCodes.length === 0 ? '' : `  | typeof ${type}ActionRateLimitedProblemSchema.Type\n`}${timeoutCodes.length === 0 ? '' : `  | typeof ${type}ActionTimeoutProblemSchema.Type\n`}  | typeof ${type}ActionUnavailableProblemSchema.Type
  | typeof ${type}ActionAlreadyCommittedProblemSchema.Type
  | typeof ${type}ActionCommitIndeterminateProblemSchema.Type
  | typeof ${type}ActionInternalProblemSchema.Type;

export class ${type}ActionSchemaErrorMiddleware extends HttpApiMiddleware.Service<${type}ActionSchemaErrorMiddleware>()(
  '${vertical.slug}/${type}ActionSchemaErrorMiddleware',
  { error: ${type}ActionInvalidProblemSchema },
) {}

const actionErrors = [
  ${type}ActionInvalidProblemSchema,
  ${type}ActionAuthenticationProblemSchema,
  ${type}ActionForbiddenProblemSchema,
  ${type}ActionNotFoundProblemSchema,
  ${type}ActionConflictProblemSchema,
  ${type}ActionIneligibleProblemSchema,
  ${type}ActionPreconditionProblemSchema,
${rateCodes.length === 0 ? '' : `  ${type}ActionRateLimitedProblemSchema,\n`}${timeoutCodes.length === 0 ? '' : `  ${type}ActionTimeoutProblemSchema,\n`}  ${type}ActionUnavailableProblemSchema,
  ${type}ActionAlreadyCommittedProblemSchema,
  ${type}ActionCommitIndeterminateProblemSchema,
  ${type}ActionInternalProblemSchema,
] as const;

export const ${type}ActionApi = HttpApi.make('${type}ActionApi').add(
  HttpApiGroup.make('${group}')
    .add(
      HttpApiEndpoint.post('execute', '/${vertical.appId}/actions/${action}', {
        error: actionErrors,
        headers: ${type}ActionHeadersSchema,
        payload: Schema.toEncoded(${type}PayloadSchema),
        success: ${type}ResultSchema,
      }),
    )
    .middleware(${type}ActionSchemaErrorMiddleware),
);
`;
};

export const renderActionHttpProblems = (
  vertical: OntosVerticalMetadata,
  action: string,
  errors: readonly DomainErrorIdentity[],
): string => {
  const type = toPascalCase(action);
  const value = `${toCamelCase(action)}Action`;
  const errorsByTag = Map.groupBy(errors, ({ tag }) => tag);
  const domainMaps = [...errorsByTag.entries()]
    .flatMap(([tag, identities]) => {
      const discriminator = identities[0]?.discriminator ?? '_tag';
      if (discriminator === '_tag') {
        return [];
      }
      const mapName = `${tag.slice(0, 1).toLowerCase()}${tag.slice(1)}ProblemBy${toPascalCase(discriminator)}`;
      const entries = [...identities]
        .toSorted((left, right) => left.value.localeCompare(right.value))
        .map(
          ({ code, kind, value: discriminatorValue }) =>
            `  '${discriminatorValue}': { code: '${code}', kind: '${kind}' },`,
        )
        .join('\n');
      return [
        `const ${mapName} = {\n${entries}\n} as const satisfies Record<Extract<DomainError, { readonly _tag: '${tag}' }>['${discriminator}'], DomainProblemIdentity>;`,
      ];
    })
    .join('\n\n');
  const domainHandlers = [...errorsByTag.entries()]
    .map(([tag, identities]) => {
      const [identity] = identities;
      if (identity === undefined) {
        return '';
      }
      if (identity.discriminator === '_tag') {
        return `    ${tag}: () => ${toCamelCase(action)}ActionProblem.${identity.kind}('${identity.code}'),`;
      }
      const mapName = `${tag.slice(0, 1).toLowerCase()}${tag.slice(1)}ProblemBy${toPascalCase(identity.discriminator)}`;
      return `    ${tag}: (failure) => mapDomainIdentity(${mapName}[failure.${identity.discriminator}]),`;
    })
    .join('\n');
  const domainKinds = (
    ['conflict', 'forbidden', 'ineligible', 'notFound', 'rateLimited', 'timeout', 'unavailable'] as const
  ).filter((kind) => errors.some((error) => error.kind === kind));
  const domainProblemIdentity = domainKinds
    .map(
      (kind) =>
        `  | { readonly code: ${domainCodes(errors, kind)
          .map((code) => `'${code}'`)
          .join(' | ')}; readonly kind: '${kind}' }`,
    )
    .join('\n');
  let domainProblemIdentityDefinition = '';
  if (domainMaps.length > 0) {
    if (domainKinds.length === 1) {
      const [domainKind = 'ineligible'] = domainKinds;
      domainProblemIdentityDefinition = `interface DomainProblemIdentity { readonly code: ${domainCodes(
        errors,
        domainKind,
      )
        .map((code) => `'${code}'`)
        .join(' | ')}; readonly kind: '${domainKind}' }`;
    } else {
      domainProblemIdentityDefinition = `type DomainProblemIdentity =\n${domainProblemIdentity};`;
    }
  }
  const optionalImports = [
    domainCodes(errors, 'rateLimited').length === 0 ? undefined : `  ${type}ActionRateLimitedProblemSchema,`,
    domainCodes(errors, 'timeout').length === 0 ? undefined : `  ${type}ActionTimeoutProblemSchema,`,
  ]
    .filter((line) => line !== undefined)
    .join('\n');
  const optionalFactories = `${
    domainCodes(errors, 'rateLimited').length === 0
      ? ''
      : `
  rateLimited: (code: Extract<ProblemOf<'${type}ActionRateLimitedProblem'>, { readonly code: string }>['code']): ProblemOf<'${type}ActionRateLimitedProblem'> =>
    ${type}ActionRateLimitedProblemSchema.make({ code, detail: 'The Action rate limit has been exceeded.', status: problemStatus.rateLimited, title: 'Action rate limited', type: 'https://ontos.dev/problems/action-rate-limited' }),`
  }${
    domainCodes(errors, 'timeout').length === 0
      ? ''
      : `
  timeout: (code: Extract<ProblemOf<'${type}ActionTimeoutProblem'>, { readonly code: string }>['code']): ProblemOf<'${type}ActionTimeoutProblem'> =>
    ${type}ActionTimeoutProblemSchema.make({ code, detail: 'A required upstream operation exceeded its deadline.', retryable: true, status: problemStatus.timeout, title: 'Action upstream timeout', type: 'https://ontos.dev/problems/action-timeout' }),`
  }`;
  const domainMatchers = (
    ['conflict', 'forbidden', 'ineligible', 'notFound', 'rateLimited', 'timeout', 'unavailable'] as const
  )
    .filter((kind) => errors.some((error) => error.kind === kind))
    .map(
      (kind) =>
        `    Match.when({ kind: '${kind}' as const }, (matched) => ${toCamelCase(action)}ActionProblem.${kind}(matched.code)),`,
    )
    .join('\n');
  return `${HEADER}
// @ontos-action-http-owner ${vertical.moduleId}
// @ontos-action-http-slug ${action}
// oxlint-disable sonarjs/function-name -- Effect Match.tags requires owner-declared tag keys; remove-when: sonarjs accepts discriminant-map properties.
import type { ActionCoreError } from '@app/core-runtime';
import { Effect, HttpApiMiddleware } from '@modern-js/bff-effect/effect-edge';
import { Match, Schema } from 'effect';
import {
  ${type}ActionAlreadyCommittedProblemSchema,
  ${type}ActionAuthenticationProblemSchema,
  ${type}ActionCommitIndeterminateProblemSchema,
  ${type}ActionConflictProblemSchema,
  ${type}ActionForbiddenProblemSchema,
  ${type}ActionIneligibleProblemSchema,
  ${type}ActionInternalProblemSchema,
  ${type}ActionInvalidProblemSchema,
  ${type}ActionNotFoundProblemSchema,
  ${type}ActionPreconditionProblemSchema,
${optionalImports.length === 0 ? '' : `${optionalImports}\n`}  ${type}ActionSchemaErrorMiddleware,
  ${type}ActionUnavailableProblemSchema,
} from '../shared/apis/${action}-action.ts';
import type { ${type}ActionProblem } from '../shared/apis/${action}-action.ts';
import { ${value} } from '../src/actions/${action}.action.ts';

type DomainError = typeof ${value}.descriptor.domainErrorSchema.Type;
type ProblemOf<Tag extends ${type}ActionProblem['_tag']> = Extract<${type}ActionProblem, { readonly _tag: Tag }>;
${domainProblemIdentityDefinition}

const problemStatus = {
  authentication: 401,
  conflict: 409,
  forbidden: 403,
  ineligible: 422,
  internal: 500,
  invalid: 400,
  notFound: 404,
  precondition: 428,
  rateLimited: 429,
  timeout: 504,
  unavailable: 503,
} as const;

${domainMaps}

export const ${toCamelCase(action)}ActionProblem = {
  authentication: (): ProblemOf<'${type}ActionAuthenticationProblem'> => ${type}ActionAuthenticationProblemSchema.make({ detail: 'A valid audience-scoped Bearer assertion is required.', status: problemStatus.authentication, title: 'Authentication required', type: 'https://ontos.dev/problems/operation-authentication-required' }),
  conflict: (code: ProblemOf<'${type}ActionConflictProblem'>['code']): ProblemOf<'${type}ActionConflictProblem'> => ${type}ActionConflictProblemSchema.make({ code, detail: 'The Action conflicts with current state.', status: problemStatus.conflict, title: 'Action conflict', type: 'https://ontos.dev/problems/action-conflict' }),
  forbidden: (code: ProblemOf<'${type}ActionForbiddenProblem'>['code']): ProblemOf<'${type}ActionForbiddenProblem'> => ${type}ActionForbiddenProblemSchema.make({ code, detail: 'The principal is not permitted to perform this Action.', status: problemStatus.forbidden, title: 'Action forbidden', type: 'https://ontos.dev/problems/action-forbidden' }),
  ineligible: (code: ProblemOf<'${type}ActionIneligibleProblem'>['code']): ProblemOf<'${type}ActionIneligibleProblem'> => ${type}ActionIneligibleProblemSchema.make({ code, detail: 'The request is not eligible for this Action.', status: problemStatus.ineligible, title: 'Action ineligible', type: 'https://ontos.dev/problems/action-ineligible' }),
  internal: (): ProblemOf<'${type}ActionInternalProblem'> => ${type}ActionInternalProblemSchema.make({ detail: 'The Action could not be completed.', status: problemStatus.internal, title: 'Action failed', type: 'https://ontos.dev/problems/action-failed' }),
  invalid: (): ProblemOf<'${type}ActionInvalidProblem'> => ${type}ActionInvalidProblemSchema.make({ detail: 'The ${action} Action request is invalid.', status: problemStatus.invalid, title: 'Invalid Action request', type: 'https://ontos.dev/problems/action-invalid' }),
  notFound: (code: ProblemOf<'${type}ActionNotFoundProblem'>['code']): ProblemOf<'${type}ActionNotFoundProblem'> => ${type}ActionNotFoundProblemSchema.make({ code, detail: 'The requested resource was not found.', status: problemStatus.notFound, title: 'Resource not found', type: 'https://ontos.dev/problems/action-resource-not-found' }),
  precondition: (): ProblemOf<'${type}ActionPreconditionProblem'> => ${type}ActionPreconditionProblemSchema.make({ detail: 'An Idempotency-Key header is required.', status: problemStatus.precondition, title: 'Idempotency key required', type: 'https://ontos.dev/problems/idempotency-key-required' }),${optionalFactories}
  unavailable: (code: ProblemOf<'${type}ActionUnavailableProblem'>['code']): ProblemOf<'${type}ActionUnavailableProblem'> => ${type}ActionUnavailableProblemSchema.make({ code, detail: 'The Action capability is temporarily unavailable.', retryable: true, status: problemStatus.unavailable, title: 'Action unavailable', type: 'https://ontos.dev/problems/action-unavailable' }),
} as const;

${
  domainMaps.length === 0
    ? ''
    : `const mapDomainIdentity = (identity: DomainProblemIdentity): ${type}ActionProblem =>
  Match.value(identity).pipe(
${domainMatchers}
    Match.exhaustive,
  );\n`
}

const mapDomainProblem = (error: DomainError): ${type}ActionProblem => Match.value(error).pipe(
  Match.tags({
${domainHandlers}
  }),
  Match.exhaustive,
);

const mapCoreProblem = (error: ActionCoreError): ${type}ActionProblem => Match.value(error).pipe(
  Match.tags({
    ActionAlreadyCommitted: (failure) => ${type}ActionAlreadyCommittedProblemSchema.make({ code: failure.code, detail: 'This Action is already committed. Refresh governed reads.', invocationId: failure.invocationId, resolution: 'REFRESH_GOVERNED_READS', retryCommand: false, status: problemStatus.conflict, title: 'Action already committed', type: 'https://ontos.dev/problems/action-already-committed' }),
    ActionCollectorError: ${toCamelCase(action)}ActionProblem.internal,
    ActionCommitIndeterminate: (failure) => ${type}ActionCommitIndeterminateProblemSchema.make({ detail: 'The Action commit is uncertain. Resolve this invocation before another attempt.', invocationId: failure.invocationId, resolution: 'RESOLVE_COMMIT', retryCommand: false, status: problemStatus.unavailable, title: 'Action commit uncertain', type: 'https://ontos.dev/problems/action-commit-indeterminate' }),
    ActionHandlerExecutionError: ${toCamelCase(action)}ActionProblem.internal,
    ActionIdempotencyKeyRequired: ${toCamelCase(action)}ActionProblem.precondition,
    ActionInvocationNotFound: (failure) => ${toCamelCase(action)}ActionProblem.notFound(failure.code),
    ActionInvocationPersistenceError: (failure) => ${toCamelCase(action)}ActionProblem.unavailable(failure.code),
    ActionInvocationStateError: (failure) => ${toCamelCase(action)}ActionProblem.conflict(failure.code),
    ActionPayloadValidationError: ${toCamelCase(action)}ActionProblem.invalid,
    ActionPermissionCheckError: (failure) => ${toCamelCase(action)}ActionProblem.unavailable(failure.code),
    ActionPermissionDenied: (failure) => ${toCamelCase(action)}ActionProblem.forbidden(failure.code),
    ActionPolicyDenied: (failure) => ${toCamelCase(action)}ActionProblem.ineligible(failure.code),
    ActionPolicyEvaluationError: (failure) => ${toCamelCase(action)}ActionProblem.unavailable(failure.code),
    ActionRequestHashConflict: (failure) => ${toCamelCase(action)}ActionProblem.conflict(failure.code),
    ActionResultValidationError: ${toCamelCase(action)}ActionProblem.internal,
    ActionTransactionError: (failure) => ${toCamelCase(action)}ActionProblem.unavailable(failure.code),
    ActionTrustedContextValidationError: ${toCamelCase(action)}ActionProblem.authentication,
    ModuleStateCheckUnavailableError: (failure) => ${toCamelCase(action)}ActionProblem.unavailable(failure.code),
    ModuleStateDeniedError: (failure) => ${toCamelCase(action)}ActionProblem.forbidden(failure.code),
    OperationAuthenticationRequired: ${toCamelCase(action)}ActionProblem.authentication,
    OperationContextDenied: (failure) => ${toCamelCase(action)}ActionProblem.forbidden(failure.code),
    OperationContextInvalid: (failure) => ${toCamelCase(action)}ActionProblem.forbidden(failure.code),
    OperationContextUnavailable: (failure) => ${toCamelCase(action)}ActionProblem.unavailable(failure.code),
  }),
  Match.exhaustive,
);

const isDomainError = Schema.is(${value}.descriptor.domainErrorSchema);
export const map${type}ActionProblem = (error: ActionCoreError | DomainError): ${type}ActionProblem =>
  isDomainError(error) ? mapDomainProblem(error) : mapCoreProblem(error);

export const ${toCamelCase(action)}ActionSchemaErrorLive = HttpApiMiddleware.layerSchemaErrorTransform(
  ${type}ActionSchemaErrorMiddleware,
  () => Effect.fail(${toCamelCase(action)}ActionProblem.invalid()),
);
`;
};

const renderActionHttpServer = (vertical: OntosVerticalMetadata, action: string): string => {
  const type = toPascalCase(action);
  const value = toCamelCase(action);
  return `${HEADER}
// @ontos-action-http-owner ${vertical.moduleId}
// @ontos-action-http-slug ${action}
import { Effect, HttpApiBuilder, Layer } from '@modern-js/bff-effect/effect-edge';
import type { HttpServerRequest } from 'effect/unstable/http';
import { Redacted, Schema } from 'effect';
import { ${toCamelCase(vertical.slug)}Api } from '../shared/api.ts';
import { ${value}Action } from '../src/actions/${action}.action.ts';
import { bindActionHttpRunner } from './action-http-runner.ts';
import {
  ${value}ActionProblem,
  ${value}ActionSchemaErrorLive,
  map${type}ActionProblem,
} from './${action}-action-problems.ts';

const runActionHttp = bindActionHttpRunner({
  authentication: ${value}ActionProblem.authentication,
  unavailable: () => ${value}ActionProblem.unavailable('operation_context_unavailable'),
});

const execute = Effect.fn('${type}ActionServer.execute')(
  function* execute${type}(
    payload: typeof ${value}Action.descriptor.payloadSchema.Encoded,
    idempotencyKey: string | undefined,
    request: HttpServerRequest.HttpServerRequest,
  ) {
  const correlationId = request.headers['x-correlation-id'];
  if (correlationId !== undefined && correlationId.length > 200) {
    return yield* Effect.fail(${value}ActionProblem.invalid());
  }
  const decoded = yield* Schema.decodeEffect(${value}Action.descriptor.payloadSchema)(payload)
    .pipe(Effect.mapError(${value}ActionProblem.invalid));
  return yield* runActionHttp({
    endpointHeaders: { idempotencyKey, traceId: request.headers['x-trace-id'] },
    internalProblem: ${value}ActionProblem.internal,
    invalidCorrelationProblem: ${value}ActionProblem.invalid,
    mapError: map${type}ActionProblem,
    payload: decoded,
    registration: ${value}Action,
    requestHeaders: {
      authorization: Redacted.make(request.headers['authorization']),
      'x-correlation-id': correlationId,
    },
    });
  },
);

export const ${value}ActionApiLive = HttpApiBuilder.group(
  ${toCamelCase(vertical.slug)}Api,
  '${value}Action',
  (handlers) => handlers.handle('execute', ({ headers, payload, request }) =>
    execute(payload, headers['idempotency-key'], request),
  ),
).pipe(Layer.provide(${value}ActionSchemaErrorLive));
`;
};

export const renderActionHttpClient = (vertical: OntosVerticalMetadata, action: string, required: boolean): string => {
  const type = toPascalCase(action);
  const value = toCamelCase(action);
  return `${HEADER}
// @ontos-action-http-owner ${vertical.moduleId}
// @ontos-action-http-slug ${action}
import { makeGovernedEffectBffClient } from '@app/shared-contracts/client-runtime';
import { Effect, Redacted, Schema } from 'effect';
import { ${type}ActionApi, ${type}PayloadSchema } from '../../shared/apis/${action}-action.ts';
import type { ${type}Payload } from '../../shared/actions/${action}.ts';
import { operationGateway } from './action-gateway.ts';

const traceIdOption = 'traceId' as const;

export interface ${type}ActionClientOptions {
  readonly baseUrl?: string | URL;
  readonly gateway?: Parameters<typeof operationGateway.invoke>[1];
  readonly idempotencyKey${required ? '' : '?'}: string;
  readonly [traceIdOption]?: string;
}

type AuthorizedInvocation = readonly [credential: string, requestCorrelation: string, options: ${type}ActionClientOptions];
type OperationInvocation = readonly [requestCorrelation: string, options: ${type}ActionClientOptions];

interface MakeClientOptions {
  readonly credential: Redacted.Redacted;
  readonly options: ${type}ActionClientOptions;
  readonly requestCorrelation: string;
}

const makeClient = ({ credential, options, requestCorrelation }: MakeClientOptions) =>
  makeGovernedEffectBffClient({ api: ${type}ActionApi, credential, defaultApiPrefix: '/${vertical.appId}-api', requestCorrelation }, options);

export const execute${type}WithAuthorization = (
  payload: ${type}Payload,
  ...[credential, requestCorrelation, options]: AuthorizedInvocation
) => Schema.encodeUnknownEffect(${type}PayloadSchema)(payload).pipe(
  Effect.flatMap((encoded) => makeClient({ credential: Redacted.make(credential), options, requestCorrelation }).pipe(
    Effect.flatMap((client) => client.${value}Action.execute({
      headers: { 'idempotency-key': options.idempotencyKey },
      payload: encoded,
    })),
  )),
);

export const execute${type} = (
  payload: ${type}Payload,
  ...[requestCorrelation, options]: OperationInvocation
) => operationGateway.invoke(
  (credential) => execute${type}WithAuthorization(payload, credential, requestCorrelation, options),
  options.gateway,
);
`;
};

const insertIdempotently = (
  content: string,
  start: string,
  end: string,
  entry: string,
  validate: (candidate: string) => boolean,
): string => {
  const entries = readGeneratedSlotEntries(content, start, end);
  if (entries.some((candidate) => !validate(candidate))) {
    return raiseScaffoldFailure(`generated slot contains unsupported content: ${start}`);
  }
  if (generatedSlotContainsExactEntry(content, start, end, entry)) {
    return content;
  }
  return insertSortedSlot(content, start, end, [entry], validate);
};

const patchClientRoot = (content: string, action: string): string => {
  const entry = `export * from './${action}-action-client.ts';`;
  let nextContent = content;
  if (!nextContent.includes(CLIENT_SLOT_START)) {
    const anchor = "export { Effect, runEffectRequest } from '@modern-js/bff-effect/effect-client';";
    if (!nextContent.includes(anchor)) {
      return raiseScaffoldFailure('client root lacks the generated export anchor');
    }
    nextContent = nextContent.replace(anchor, `${anchor}\n${CLIENT_SLOT_START}\n${CLIENT_SLOT_END}`);
  }
  return insertIdempotently(nextContent, CLIENT_SLOT_START, CLIENT_SLOT_END, entry, (candidate) =>
    /^export \* from '\.\/[a-z][a-z0-9-]*-action-client\.ts';$/u.test(candidate),
  );
};

const patchRuntimeRoot = (content: string, vertical: OntosVerticalMetadata, layerValue: string): string => {
  let nextContent = deduplicateGeneratedSlotEntries(
    content,
    GOVERNED_HTTP_HANDLER_LAYER_SLOT_START,
    GOVERNED_HTTP_HANDLER_LAYER_SLOT_END,
  );
  const appType = toPascalCase(vertical.slug);
  const appValue = toCamelCase(vertical.slug);
  const readLive = `${appValue}ReadRuntimeLive`;
  const actionLive = `${appValue}ActionRuntimeLive`;
  nextContent = nextContent.replace(
    "import type { GatewayAssertionRedemptionService, ReadRuntime } from '@app/core-runtime';",
    "import type { ActionRuntime, GatewayAssertionRedemptionService, ReadRuntime } from '@app/core-runtime';",
  );
  nextContent = nextContent.replace(
    `import { ${readLive} } from './${vertical.slug}-production-layers.ts';`,
    `import { ${actionLive}, ${readLive} } from './${vertical.slug}-production-layers.ts';`,
  );
  const tuple = `type ${appType}ApiRuntimeArguments = readonly [\n`;
  const readRuntimeDefinition = `const productionReadRuntimeLive = ${readLive}.pipe(`;
  const actionRuntimeDefinition = `const productionActionRuntimeLive = ${actionLive}.pipe(\n  Layer.provide(DatabaseConfigLive),\n);\n`;
  if (nextContent.includes(readRuntimeDefinition) && !nextContent.includes('const productionActionRuntimeLive =')) {
    nextContent = nextContent.replace(readRuntimeDefinition, `${actionRuntimeDefinition}${readRuntimeDefinition}`);
  }
  nextContent = nextContent.replace(
    `actionRuntime: Layer.Layer<ActionRuntime, Layer.Error<typeof ${actionLive}>>,`,
    'actionRuntime: Layer.Layer<ActionRuntime, Layer.Error<typeof productionActionRuntimeLive>>,',
  );
  nextContent = nextContent.replace(
    `${tuple}  actionRuntime: Layer.Layer<ActionRuntime, Layer.Error<typeof productionActionRuntimeLive>>,\n  readRuntime: Layer.Layer<ReadRuntime, Layer.Error<typeof productionReadRuntimeLive>>,`,
    `${tuple}  readRuntime: Layer.Layer<ReadRuntime, Layer.Error<typeof productionReadRuntimeLive>>,\n  actionRuntime: Layer.Layer<ActionRuntime, Layer.Error<typeof productionActionRuntimeLive>>,`,
  );
  if (nextContent.includes(tuple) && !nextContent.includes('actionRuntime: Layer.Layer<ActionRuntime')) {
    nextContent = nextContent.replace(
      'readRuntime: Layer.Layer<ReadRuntime, Layer.Error<typeof productionReadRuntimeLive>>,',
      'readRuntime: Layer.Layer<ReadRuntime, Layer.Error<typeof productionReadRuntimeLive>>,\n  actionRuntime: Layer.Layer<ActionRuntime, Layer.Error<typeof productionActionRuntimeLive>>,',
    );
  }
  const runtimeDestructure =
    'const [governedReadRuntimeLive, governedActionRuntimeLive, gatewayAssertionRedemption] = args;';
  nextContent = nextContent.replace(
    'const [governedReadRuntimeLive, gatewayAssertionRedemption] = args;',
    runtimeDestructure,
  );
  nextContent = nextContent.replace(
    'const [governedActionRuntimeLive, governedReadRuntimeLive, gatewayAssertionRedemption] = args;',
    runtimeDestructure,
  );
  const principalVerifierDefinition = `${runtimeDestructure}\n  const actionPrincipalVerifierLive = GovernedActionPrincipalVerifierLive.pipe(\n    Layer.provide(governedActionRuntimeLive),\n  );`;
  if (nextContent.includes(runtimeDestructure) && !nextContent.includes('const actionPrincipalVerifierLive =')) {
    nextContent = nextContent.replace(runtimeDestructure, principalVerifierDefinition);
  }
  nextContent = nextContent.replace(
    'Layer.mergeAll(GovernedActionPrincipalVerifierLive, gatewayAssertionRedemption)',
    'Layer.mergeAll(actionPrincipalVerifierLive, gatewayAssertionRedemption)',
  );
  const defaultCall = `const apiRuntime = make${appType}ApiRuntime(\n`;
  nextContent = nextContent.replace(
    `${defaultCall}  productionActionRuntimeLive,\n  productionActionRuntimeLive,\n  productionReadRuntimeLive,`,
    `${defaultCall}  productionReadRuntimeLive,\n  productionActionRuntimeLive,`,
  );
  nextContent = nextContent.replace(
    `${defaultCall}  productionActionRuntimeLive,\n  productionReadRuntimeLive,`,
    `${defaultCall}  productionReadRuntimeLive,\n  productionActionRuntimeLive,`,
  );
  nextContent = nextContent.replace(
    `${defaultCall}  ${actionLive},\n  productionReadRuntimeLive,`,
    `${defaultCall}  productionReadRuntimeLive,\n  productionActionRuntimeLive,`,
  );
  if (
    nextContent.includes(defaultCall) &&
    !nextContent.includes(`${defaultCall}  productionReadRuntimeLive,\n  productionActionRuntimeLive,`)
  ) {
    nextContent = nextContent.replace(
      `${defaultCall}  productionReadRuntimeLive,`,
      `${defaultCall}  productionReadRuntimeLive,\n  productionActionRuntimeLive,`,
    );
  }
  return insertIdempotently(
    nextContent,
    GOVERNED_HTTP_HANDLER_LAYER_SLOT_START,
    GOVERNED_HTTP_HANDLER_LAYER_SLOT_END,
    `${layerValue}.pipe(GovernedReadLayer.provide(governedActionRuntimeLive)),`,
    (candidate) => /^[A-Za-z][A-Za-z0-9]*(?:Read|Action)ApiLive\.pipe\(/u.test(candidate) && candidate.endsWith('),'),
  );
};

/* oxlint-disable typescript/consistent-return -- Effect failure branches return yielded scaffold errors while successful validation intentionally falls through with void. */
const validateActionSources = Effect.fn('ActionHttpScaffold.validateActionSources')(function* validateActionSources(
  vertical: OntosVerticalMetadata,
  action: string,
  type: string,
  value: string,
  actionSource: string,
  publicActionSource: string,
) {
  for (const expected of [
    `// @ontos-action-owner ${vertical.moduleId}`,
    `// @ontos-action-slug ${action}`,
    `export const ${value} = defineAction(`,
  ]) {
    if (!actionSource.includes(expected)) {
      return yield* scaffoldFailure(`Action source is missing ${expected}`);
    }
  }
  for (const expected of [`${type}PayloadSchema`, `${type}ResultSchema`]) {
    if (
      !publicActionSource.includes(`export const ${expected}`) &&
      !publicActionSource.includes(`export { ${expected}`)
    ) {
      return yield* scaffoldFailure(`public Action contract must export ${expected}`);
    }
  }
  if (/from ['"][^'"]*(?:\/src\/|\.action\.ts)/u.test(publicActionSource)) {
    return yield* scaffoldFailure('public Action contract imports private implementation source');
  }
});
/* oxlint-enable typescript/consistent-return */

/* oxlint-disable typescript/consistent-return -- Effect failure branches return yielded scaffold errors while successful validation intentionally falls through with void. */
const validateActionRuntimeIdentity = Effect.fn('ActionHttpScaffold.validateActionRuntimeIdentity')(
  function* validateActionRuntimeIdentity(action: ActionModuleLike, moduleId: string, actionName: string) {
    if (action.descriptor.actionKey !== `${moduleId}.${actionName}` || action.descriptor.owningModuleKey !== moduleId) {
      return yield* scaffoldFailure('Action runtime identity does not match owner/slug');
    }
  },
);
/* oxlint-enable typescript/consistent-return */

const appendDefinedMutations = (mutations: Mutation[], candidates: readonly (Mutation | undefined)[]): void => {
  for (const mutation of candidates) {
    if (mutation !== undefined) {
      mutations.push(mutation);
    }
  }
};

const plan = Effect.fn('ActionHttpScaffold.plan')(function* planActionHttp(
  workspaceRoot: string,
  config: ActionHttpScaffoldConfig,
) {
  const action = yield* tryScaffold('Action name is invalid', () => requireCanonicalSlug(config.action, 'action'));
  const vertical = yield* discoverOntosModuleEffect(workspaceRoot, config.vertical);
  const type = toPascalCase(action);
  const value = `${toCamelCase(action)}Action`;
  const actionPath = resolveContainedPath(vertical.directory, 'src', 'actions', `${action}.action.ts`);
  const publicActionPath = resolveContainedPath(vertical.directory, 'shared', 'actions', `${action}.ts`);
  const contractPath = resolveContainedPath(vertical.directory, 'shared', 'apis', `${action}-action.ts`);
  const problemsPath = resolveContainedPath(vertical.directory, 'api', `${action}-action-problems.ts`);
  const serverPath = resolveContainedPath(vertical.directory, 'api', `${action}-action-server.ts`);
  const clientPath = resolveContainedPath(vertical.directory, 'src', 'api', `${action}-action-client.ts`);
  const sharedApiPath = resolveContainedPath(vertical.directory, 'shared', 'api.ts');
  const runtimeRootPath = resolveContainedPath(vertical.directory, 'api', 'index.ts');
  const clientRootPath = resolveContainedPath(vertical.directory, 'src', 'api', `${vertical.slug}-client.ts`);
  const fileSystem = yield* FileSystem.FileSystem;
  const [actionSource, publicActionSource, sharedApi, runtimeRoot, clientRoot] = yield* Effect.all([
    fileSystem.readFileString(actionPath),
    fileSystem.readFileString(publicActionPath),
    fileSystem.readFileString(sharedApiPath),
    fileSystem.readFileString(runtimeRootPath),
    fileSystem.readFileString(clientRootPath),
  ]).pipe(Effect.mapError((cause) => scaffoldFailure('failed to read Action HTTP owner sources', cause)));
  yield* validateActionSources(vertical, action, type, value, actionSource, publicActionSource);
  const inspected = yield* loadAction(actionPath, value);
  yield* validateActionRuntimeIdentity(inspected, vertical.moduleId, action);
  const errors = yield* tryScaffold('Action domain error schema is not transportable', () =>
    collectDomainErrors(inspected.descriptor.domainErrorSchema.ast),
  );
  const ownsGeneratedActionHttpArtifact = (current: string): boolean =>
    current.startsWith(
      `${HEADER}\n// @ontos-action-http-owner ${vertical.moduleId}\n// @ontos-action-http-slug ${action}\n`,
    );
  const generated = yield* Effect.all([
    createOrUpdateOwnedGeneratedMutationEffect(
      contractPath,
      renderActionHttpContract(vertical, action, errors),
      ownsGeneratedActionHttpArtifact,
    ),
    createOrUpdateOwnedGeneratedMutationEffect(
      problemsPath,
      renderActionHttpProblems(vertical, action, errors),
      ownsGeneratedActionHttpArtifact,
    ),
    createOrUpdateOwnedGeneratedMutationEffect(
      serverPath,
      renderActionHttpServer(vertical, action),
      ownsGeneratedActionHttpArtifact,
    ),
    createOrUpdateOwnedGeneratedMutationEffect(
      clientPath,
      renderActionHttpClient(vertical, action, inspected.descriptor.idempotency === 'required'),
      ownsGeneratedActionHttpArtifact,
    ),
  ]);
  const apiValue = `${type}ActionApi`;
  const layerValue = `${toCamelCase(action)}ActionApiLive`;
  const nextSharedApi = yield* tryScaffold('failed to patch public API root', () =>
    insertIdempotently(
      insertIdempotently(
        stabilizeGovernedHttpApiAdditionSlot(sharedApi),
        GOVERNED_HTTP_API_IMPORT_SLOT_START,
        GOVERNED_HTTP_API_IMPORT_SLOT_END,
        `import { ${apiValue} } from './apis/${action}-action.ts';`,
        (candidate) => candidate.startsWith('import { ') && candidate.endsWith("';"),
      ),
      GOVERNED_HTTP_API_ADDITION_SLOT_START,
      GOVERNED_HTTP_API_ADDITION_SLOT_END,
      `.addHttpApi(${apiValue})`,
      (candidate) => candidate.startsWith('.addHttpApi(') && candidate.endsWith(')'),
    ),
  );
  const nextRuntimeRoot = yield* tryScaffold('failed to patch Action HTTP runtime root', () =>
    patchRuntimeRoot(
      insertIdempotently(
        runtimeRoot,
        GOVERNED_HTTP_HANDLER_IMPORT_SLOT_START,
        GOVERNED_HTTP_HANDLER_IMPORT_SLOT_END,
        `import { ${layerValue} } from './${action}-action-server.ts';`,
        (candidate) => candidate.startsWith('import { ') && candidate.endsWith("';"),
      ),
      vertical,
      layerValue,
    ),
  );
  const nextClientRoot = yield* tryScaffold('failed to patch Action HTTP client root', () =>
    patchClientRoot(clientRoot, action),
  );
  const mutations: Mutation[] = generated.flatMap(Option.toArray);
  appendDefinedMutations(mutations, [
    updateMutation(sharedApiPath, sharedApi, nextSharedApi),
    updateMutation(runtimeRootPath, runtimeRoot, nextRuntimeRoot),
    updateMutation(clientRootPath, clientRoot, nextClientRoot),
  ]);
  yield* tryScaffold('Action HTTP mutation paths are invalid', () => ensureUniqueMutationPaths(mutations));
  return {
    mutations,
    result: { clientPath, contractPath, serverPath } satisfies ActionHttpScaffoldResult,
  };
});

export default createCodesmithGenerator(plan);
