import { Effect, FileSystem } from 'effect';

import {
  createMutationEffect,
  resolveContainedPath,
  scaffoldFailure,
  updateMutation,
  toCamelCase,
} from '../shared.mts';
import type { GovernedContributionScaffoldConfig, OutboxWorkerScaffoldConfig } from '../shared.mts';

const root = (workspace: string, ...paths: string[]) =>
  resolveContainedPath(workspace, 'packages', 'core-runtime', 'src', ...paths);
const header = '// @generated by OntOS Codesmith Core People Search v1';

/** Core is not an installed business deployment. Only this reviewed system contract is generated here. */
export const planCorePeopleSearchProvider = Effect.fn('CorePeopleScaffold.provider')(function* provider(
  workspace: string,
  config: GovernedContributionScaffoldConfig,
) {
  if (
    config.vertical !== 'core' ||
    config.name !== 'people' ||
    config.resource !== 'person' ||
    config.authorization !== 'protected'
  ) {
    return yield* scaffoldFailure('Core Search requires people/person with protected authorization');
  }
  // Never emit a provider whose reviewed owner resource has not been generated.
  const fileSystem = yield* FileSystem.FileSystem;
  const resource = yield* fileSystem
    .readFileString(root(workspace, 'resources', 'person.ts'))
    .pipe(
      Effect.mapError((cause) =>
        scaffoldFailure('Generate the Core person resource before its search provider', cause),
      ),
    );
  if (!resource.includes('// @ontos-resource-owner core.identity')) {
    return yield* scaffoldFailure('Core person search requires the exact Core-owned resource');
  }
  const artifactPath = root(workspace, 'people', 'people-search.ts');
  const contractPath = root(workspace, 'people', 'people-search-contract.ts');
  const mutations = yield* Effect.all([
    createMutationEffect(
      artifactPath,
      `${header}
import { Effect } from 'effect';
import { defineSystemModuleEntrypoint } from '../modules/module-entrypoint.ts';
import { defineRead } from '../reads/definition.ts';
import { ReadHandlerUnavailable } from '../reads/errors.ts';
import { PeopleSearchRequestSchema, PeopleSearchResponseSchema } from './people-search-contract.ts';

export const peopleSearchRead = defineRead({
  accessDeclaration: {
    key: 'core.identity.people-search.query', kind: 'read', modes: ['run'],
    placement: { group: 'identity', level: 'basic' }, risk: 'sensitive', selectors: [],
  },
  accessKind: 'search',
  entrypoint: defineSystemModuleEntrypoint({
    access: 'read', authorization: { kind: 'protected' },
    entrypointKey: 'core.identity.search.people', moduleKey: 'core.identity', role: 'search',
  }),
  evidencePolicy: { captureMode: 'metadata_only', policyKey: 'core.identity.search.people.access.v1' },
  inputSchema: PeopleSearchRequestSchema, legalEntityScope: 'required',
  owningModuleKey: 'core.identity', policies: [],
  readKey: 'core.identity.search.people', resultSchema: PeopleSearchResponseSchema, schemaVersion: '1',
}, {
  load: () => Effect.fail(new ReadHandlerUnavailable({
    code: 'read_handler_unavailable', reason: 'The Core owner has not implemented people search',
  })),
}, () => Effect.succeed({}));
`,
    ),
    createMutationEffect(
      contractPath,
      `${header}
import { Schema } from 'effect';
import type { OntosSearchDescriptor } from '../modules/manifest.ts';
import { PersonRefSchema } from '../resources/person.ts';

const SelectedLegalEntityIdSchema = Schema.String.check(Schema.isUUID()).pipe(Schema.brand('PeopleSearchSelectedLegalEntityId'), Schema.decodeTo(Schema.String));

export const PeopleSearchRequestSchema = Schema.Struct({
  query: Schema.String.check(Schema.isMinLength(1), Schema.isMaxLength(300)),
});
export const PeopleSearchResponseSchema = Schema.Array(Schema.Struct({
  ref: PersonRefSchema,
  title: Schema.String.check(Schema.isMinLength(1), Schema.isMaxLength(300)),
  selectedLegalEntityId: SelectedLegalEntityIdSchema,
}));
export const peopleSearchDescriptor = Object.freeze({
  accessFiltering: 'resource_permission',
  key: 'core.identity.search.people',
  owningModuleId: 'core.identity',
  resourceType: 'core.identity.person',
} as const satisfies OntosSearchDescriptor);
`,
    ),
  ]);
  return { mutations, result: { artifactPath, clientPath: contractPath, serverPath: artifactPath } };
});

const topics = {
  'project-people-lifecycle-search': 'core.identity.principal-lifecycle-changed.v1',
  'rebuild-people-search': 'core.identity.people-search-rebuild-requested.v1',
} as const;

/** The existing Core host checks Shell artifact identity and exact published system subscriptions. */
export const planCorePeopleSearchWorker = Effect.fn('CorePeopleScaffold.worker')(function* worker(
  workspace: string,
  config: OutboxWorkerScaffoldConfig,
) {
  const approvedTopic = Object.entries(topics).find(([workerName]) => workerName === config.worker)?.[1];
  if (
    config.vertical !== 'core' ||
    config.producer !== 'core' ||
    config.authorization !== 'owner_local_background' ||
    approvedTopic === undefined ||
    approvedTopic !== config.topic
  ) {
    return yield* scaffoldFailure('Core people worker must match an approved identity search worker/topic');
  }
  const workerPath = root(workspace, 'people', `${config.worker}.worker.ts`);
  const symbol = toCamelCase(config.worker);
  const subscription = `${symbol}Subscription`;
  const schemaFile = config.topic.replaceAll('.', '-');
  const fileSystem = yield* FileSystem.FileSystem;
  yield* fileSystem
    .readFileString(root(workspace, 'outbox', `${schemaFile}.ts`))
    .pipe(Effect.mapError((cause) => scaffoldFailure('Core people worker requires its published Core topic', cause)));
  const mutation = yield* createMutationEffect(
    workerPath,
    `${header}
import { Effect } from 'effect';
import { OutboxPayloadSchema } from '../outbox/${schemaFile}.ts';
import { defineOutboxWorker } from '../outbox/definition.ts';
import { PeopleSearchProjector } from './people-search-projection.ts';
import { ${subscription} } from './people-search-subscriptions.ts';
export { ${subscription} } from './people-search-subscriptions.ts';

export const worker = defineOutboxWorker({
  ...${subscription}, legalEntityScope: 'forbidden', leaseDurationMs: 60_000,
  payloadSchema: OutboxPayloadSchema,
  retryPolicy: { initialBackoffMs: 1000, maxAttempts: 20, maxBackoffMs: 60_000, multiplier: 2 },
}, Effect.fn('PeopleSearchWorker.${config.worker}')(function* project(_payload, context) {
  const projector = yield* PeopleSearchProjector;
  return yield* projector.project(context);
}));
`,
  );
  const registryPath = root(workspace, 'people', 'people-search-workers.ts');
  const subscriptionPath = root(workspace, 'people', 'people-search-subscriptions.ts');
  const plans = [mutation];
  for (const [path, prefix, entry] of [
    [
      registryPath,
      `${header}\n`,
      `export { worker as ${symbol}, ${subscription} } from './${config.worker}.worker.ts';\n`,
    ],
    [
      subscriptionPath,
      `${header}\nimport { defineSystemModuleEntrypoint } from '../modules/module-entrypoint.ts';\nconst coreIdentity = 'core.identity';\n`,
      `export const ${subscription} = Object.freeze({
  consumerModuleKey: coreIdentity, producerModuleKey: coreIdentity,
  topic: '${config.topic}', workerKey: 'core.identity.${config.worker}',
  entrypoint: defineSystemModuleEntrypoint({
    access: 'background', authorization: { kind: 'owner_local_background' },
    entrypointKey: 'core.identity.${config.worker}', moduleKey: coreIdentity, role: 'worker',
  }),
});\n`,
    ],
  ] as const) {
    const exists = yield* fileSystem.exists(path);
    const previous = exists ? yield* fileSystem.readFileString(path) : prefix;
    const next = `${previous}${entry}`;
    const planned = exists ? updateMutation(path, previous, next) : yield* createMutationEffect(path, next);
    if (planned !== undefined) {
      plans.push(planned);
    }
  }
  return { mutations: plans, result: { registryPath, workerPath } };
});
