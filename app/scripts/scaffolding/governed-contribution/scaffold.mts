import { Context, Effect } from 'effect';
import { HttpClient, HttpClientRequest } from 'effect/unstable/http';
import { makeEffectHttpApiClient } from '@modern-js/plugin-bff/effect-client';
import { ${value} } from '../../shared/apis/${name}.ts';
import type { ${type}Request } from '../../shared/apis/${name}.ts';
import { operationGateway } from './action-gateway.ts';

export interface ${type}ClientOptions {
  readonly baseUrl?: string | URL;
}

interface ${type}RequestOptions extends ${type}ClientOptions {
  readonly authorization: string;
  readonly correlationId: string;
}

const ${type}RequestOptions = Context.Reference<${type}RequestOptions>(
  '${type}RequestOptions',
  { defaultValue: () => ({ authorization: '', correlationId: '' }) },
);

const ${toCamelCase(name)}Client = makeEffectHttpApiClient(${value}, {
  transformClient: HttpClient.mapRequestEffect((request) =>
    ${type}RequestOptions.pipe(
      Effect.map(({ authorization, baseUrl, correlationId }) =>
        HttpClientRequest.prependUrl(request, (baseUrl ?? '/${vertical.appId}-api').toString()).pipe(
          HttpClientRequest.setHeaders({ authorization, 'x-correlation-id': correlationId }),
        ),
      ),
    ),
  ),
});

export const execute${type}WithAuthorization = (
  payload: ${type}Request,
  authorization: string,
  correlationId: string,
  options: ${type}ClientOptions = {},
) =>
  ${toCamelCase(name)}Client.pipe(
    Effect.flatMap((client) =>
      client.${toCamelCase(name)}.execute({ headers: {}, params: {}, payload, query: {} }),
    ),
    Effect.provideService(${type}RequestOptions, { ...options, authorization, correlationId }),
  );

export const execute${type} = (
  payload: ${type}Request,
  correlationId: string,
  options: ${type}ClientOptions = {},
