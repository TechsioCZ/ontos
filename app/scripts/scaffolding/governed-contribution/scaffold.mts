export type GovernedContributionKind =
  | 'module-api'
  | 'public-component'
  | 'report'
  | 'search-provider';

type ProviderContributionKind = Extract<GovernedContributionKind, 'report' | 'search-provider'>;

const isProviderContribution = (kind: GovernedContributionKind): kind is ProviderContributionKind =>
  kind === 'report' || kind === 'search-provider';

const generatedHeader = (kind: GovernedContributionKind) =>
  kind === 'report' || kind === 'search-provider'
    ? `// @generated by OntOS Codesmith Governed Contribution v1\n// @ontos-contribution-kind ${kind}`
    : `// @generated by OntOS Codesmith ${kind} v1`;

const manifestImport = (kind: GovernedContributionKind, name: string): string | undefined => {
  const value = `${toPascalCase(name)}${kind === 'public-component' ? '' : 'Api'}`;
  if (kind === 'public-component') {
    return `import { ${value} } from './src/components/${name}.tsx';`;
  }
  if (kind === 'module-api') {
    return `import { ${value} } from './shared/apis/${name}.ts';`;
  }
  return undefined;
};

