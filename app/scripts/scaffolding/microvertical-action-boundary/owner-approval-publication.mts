import path from 'node:path';

import { SyntaxKind } from '@typescript/native/unstable/ast';
import { Effect, FileSystem } from 'effect';

import {
  OWNER_ACTION_APPROVAL_PUBLICATION,
  hasOwnerActionApprovalPublication,
  hasNativeGatewayRedemptionExports,
  hasRuntimeNamedSourceImport,
  inspectOwnerActionApprovalMount,
  inspectOwnerApprovalApiType,
} from '../../generated-governed-http-boundary.mts';
import type { OwnerApprovalSourceContext } from '../../generated-governed-http-boundary.mts';
import {
  hasExactSourceTokens,
  hasGeneratedSourceHeader,
  tokenizeGovernedClient,
} from '../../generated-module-api-boundary.mts';
import {
  GOVERNED_HTTP_API_ADDITION_SLOT_START,
  MODULE_MANIFEST_API_SLOT_END,
  MODULE_MANIFEST_API_SLOT_START,
  MODULE_REGISTRATION_API_SLOT_END,
  MODULE_REGISTRATION_API_SLOT_START,
  GOVERNED_HTTP_HANDLER_SUPPORT_IMPORT_SLOT_START,
  GOVERNED_HTTP_HANDLER_SUPPORT_IMPORT_SLOT_END,
  insertSortedSlot,
  isCodePosition,
  maskNonCode,
  raiseScaffoldFailure,
  readGeneratedSlotEntries,
  resolveContainedPath,
  scaffoldFailure,
  replaceGeneratedSlotEntry,
  tryScaffold,
  updateMutation,
} from '../shared.mts';
import type { Mutation, OntosVerticalMetadata, ScaffoldFailure } from '../shared.mts';

/** The same generator header main's action-boundary scaffold emits. */
const ACTION_BOUNDARY_GENERATOR_HEADER = '// @generated by OntOS Codesmith MicroVertical Action Boundary v1';

const contract = OWNER_ACTION_APPROVAL_PUBLICATION;
const apiImport = `import { ${contract.api} } from '${contract.apiModule}';`;
const manifestEntry = `'${contract.key}': ${contract.api},`;
const loaderEntry = `'${contract.key}': () => import('${contract.apiModule}'),`;

export const OWNER_APPROVAL_AUTHENTICATION_SUPPORT_IMPORT =
  "import { ActionPrincipalVerifierLive as GovernedActionPrincipalVerifierLive, authenticateOperationPrincipal as authenticateOwnerApprovalPrincipal } from './auth/action-principal.ts';";
const approvalAuthenticationImport =
  "import { authenticateOperationPrincipal as authenticateOwnerApprovalPrincipal } from './auth/action-principal.ts';";
const principalImport =
  "import { ActionPrincipalVerifierLive as GovernedActionPrincipalVerifierLive } from './auth/action-principal.ts';";
const nativePrincipalImport = "import { ActionPrincipalVerifierLive } from './auth/action-principal.ts';";

const isExactImport = (source: string, expected: string): boolean =>
  hasExactSourceTokens(tokenizeGovernedClient(source), expected);

const combinedAuthenticationImport = (source: string, target: RegExpMatchArray): string => {
  const slotStart = source.indexOf(GOVERNED_HTTP_HANDLER_SUPPORT_IMPORT_SLOT_START);
  const slotEnd = source.indexOf(GOVERNED_HTTP_HANDLER_SUPPORT_IMPORT_SLOT_END);
  const index = target.index ?? -1;
  const inSupportSlot = index > slotStart && index < slotEnd;
  if (isExactImport(target[0], OWNER_APPROVAL_AUTHENTICATION_SUPPORT_IMPORT)) {
    return source;
  }
  if (inSupportSlot && isExactImport(target[0], principalImport)) {
    return replaceGeneratedSlotEntry(
      source,
      GOVERNED_HTTP_HANDLER_SUPPORT_IMPORT_SLOT_START,
      GOVERNED_HTTP_HANDLER_SUPPORT_IMPORT_SLOT_END,
      target[0],
      OWNER_APPROVAL_AUTHENTICATION_SUPPORT_IMPORT,
    );
  }
  if (
    !inSupportSlot &&
    (isExactImport(target[0], nativePrincipalImport) || isExactImport(target[0], principalImport))
  ) {
    const bindings = target.groups?.['bindings']?.trim();
    if (bindings !== undefined) {
      return source.replace(
        target[0],
        `import { ${bindings}, authenticateOperationPrincipal as authenticateOwnerApprovalPrincipal } from './auth/action-principal.ts';`,
      );
    }
  }
  return raiseScaffoldFailure('owner approval authentication import contains unsupported developer content');
};

/** Consolidate only the original owner authentication import, never an indirect compatibility shim. */
export const consolidateOwnerApprovalAuthenticationImport = (source: string): string => {
  if (!source.includes(contract.handlerModule)) {
    return source;
  }
  const imports = [
    ...source.matchAll(/^import\s*\{(?<bindings>[^}]+)\}\s*from\s*['"]\.\/auth\/action-principal\.ts['"];/gmu),
  ].filter((entry) => isCodePosition(source, entry.index));
  const standalone = imports.filter((entry) =>
    hasExactSourceTokens(tokenizeGovernedClient(entry[0]), approvalAuthenticationImport),
  );
  if (imports.length === 1) {
    return source;
  }
  const redundant = standalone.length === 1 ? standalone[0] : undefined;
  const targets = imports.filter((entry) => entry !== redundant);
  const target = targets.length === 1 ? targets[0] : undefined;
  if (redundant === undefined || target === undefined) {
    return raiseScaffoldFailure(
      'owner approval authentication imports are duplicated or not the original owner helpers',
    );
  }
  const combined = combinedAuthenticationImport(source, target);
  return combined.replace(`${redundant[0]}\n`, '');
};

const withOriginalApiImport = (source: string): string => {
  if (hasRuntimeNamedSourceImport(source, contract.api, contract.api, contract.apiModule)) {
    return source;
  }
  if (tokenizeGovernedClient(source).some((token) => token.value === contract.api)) {
    return raiseScaffoldFailure('owner approval API binding already exists without its original Core import');
  }
  const firstImport = /^import\b/mu.exec(maskNonCode(source));
  if (firstImport === null) {
    return raiseScaffoldFailure('owner approval publication requires the existing native API/module imports');
  }
  return `${source.slice(0, firstImport.index)}${apiImport}\n${source.slice(firstImport.index)}`;
};

const publishOwnerApprovalApiType = (source: string): string => {
  const apiType = inspectOwnerApprovalApiType(source);
  if (apiType.kind === 'invalid') {
    return raiseScaffoldFailure('owner approval publication requires the original native API group type');
  }
  return apiType.kind === 'inferred' || apiType.members.includes(contract.api)
    ? source
    : `${source.slice(0, apiType.end)}  | typeof ${contract.api}\n${source.slice(apiType.end)}`;
};

export const publishOwnerApprovalSharedApi = (source: string): string => {
  const imported = publishOwnerApprovalApiType(withOriginalApiImport(source));
  const addition = `.addHttpApi(${contract.api})`;
  if (imported.includes(addition)) {
    return imported;
  }
  const index = imported.indexOf(GOVERNED_HTTP_API_ADDITION_SLOT_START);
  const lineStart = imported.lastIndexOf('\n', index) + 1;
  const indent = imported.slice(lineStart, index);
  if (index === -1 || !/^[\t ]*$/u.test(indent)) {
    return raiseScaffoldFailure('owner approval publication requires the bound native API addition slot');
  }
  return `${imported.slice(0, lineStart)}${indent}${addition}\n${imported.slice(lineStart)}`;
};

const publishSlot = (source: string, start: string, end: string, entry: string): string => {
  const entries = readGeneratedSlotEntries(source, start, end);
  const existing = entries.filter((candidate) => tokenizeGovernedClient(candidate)[0]?.value === contract.key);
  if (existing.length !== 0) {
    if (existing.length !== 1 || !hasExactSourceTokens(tokenizeGovernedClient(existing[0] ?? ''), entry)) {
      return raiseScaffoldFailure('owner approval publication refuses a duplicate or substituted platform API entry');
    }
    return source;
  }
  return insertSortedSlot(source, start, end, [entry], (candidate) => candidate.endsWith(','));
};

export const publishOwnerApprovalManifest = (source: string): string =>
  publishSlot(
    withOriginalApiImport(source),
    MODULE_MANIFEST_API_SLOT_START,
    MODULE_MANIFEST_API_SLOT_END,
    manifestEntry,
  );

export const publishOwnerApprovalLoader = (source: string): string =>
  publishSlot(source, MODULE_REGISTRATION_API_SLOT_START, MODULE_REGISTRATION_API_SLOT_END, loaderEntry);

const readOptionalSource = (file: string) =>
  Effect.gen(function* readOptionalApprovalSource() {
    const fileSystem = yield* FileSystem.FileSystem;
    return (yield* fileSystem.exists(file)) ? yield* fileSystem.readFileString(file) : '';
  }).pipe(Effect.mapError((cause) => scaffoldFailure(`failed to inspect owner approval publication ${file}`, cause)));

const redemptionExports = new Set([
  'GatewayAssertionRedemptionLive',
  'GatewayAssertionRedemptionDatabaseLive',
  'GatewayAssertionPgClientLive',
  'gatewayAssertionRedemptionPgClient',
]);

export const parseOwnedRedemptionReexport = (source: string) => {
  const statement = /^\s*export\s*\{(?<names>[^}]+)\}\s*from\s*['"](?<file>\.\.?\/[^'"]+\.ts)['"];\s*$/u.exec(
    maskNonCode(source, true),
  );
  const names = statement?.groups?.['names']
    ?.split(',')
    .map((name) => name.trim())
    .filter(Boolean);
  const file = statement?.groups?.['file'];
  return file !== undefined &&
    names !== undefined &&
    names.length > 0 &&
    new Set(names).size === names.length &&
    names.includes('GatewayAssertionRedemptionLive') &&
    names.every((name) => redemptionExports.has(name))
    ? { file, names }
    : undefined;
};

export const hasOwnedRedemptionReexportTarget = (
  source: string,
  target: string,
  owner: string,
  names: readonly string[],
  context: OwnerApprovalSourceContext,
): boolean => {
  const originals = [source, target];
  const unambiguous = originals.every((candidate) => {
    const claims = [...candidate.matchAll(/^\/\/ @ontos-action-boundary-owner (?<owner>[a-z0-9-]+)\r?$/gmu)];
    return claims.length <= 1 && claims.every((claim) => claim.groups?.['owner'] === owner);
  });
  return (
    unambiguous &&
    originals.some((candidate) =>
      hasGeneratedSourceHeader(
        candidate,
        `${ACTION_BOUNDARY_GENERATOR_HEADER}\n// @ontos-action-boundary-owner ${owner}`,
      ),
    ) &&
    hasNativeGatewayRedemptionExports(target, names, owner, context)
  );
};

const readApprovalProviderSources = (ownerPath: string, rootFile: string, root: string) =>
  Effect.gen(function* readApprovalProviderSourcesEffect() {
    const fileSystem = yield* FileSystem.FileSystem;
    const owner = yield* fileSystem.realPath(ownerPath);
    const sources = new Map<string, string>();
    const pending = [{ file: rootFile, source: root }];
    for (const current of pending) {
      sources.set(current.file, current.source);
      const imports = [...maskNonCode(current.source, true).matchAll(/\bfrom\s*['"](?<file>\.\.?\/[^'"]+\.ts)['"]/gu)];
      for (const imported of imports) {
        const file = path.resolve(path.dirname(current.file), imported.groups?.['file'] ?? '');
        if (
          file.startsWith(`${ownerPath}/`) &&
          !sources.has(file) &&
          !pending.some((entry) => entry.file === file) &&
          (yield* fileSystem.exists(file))
        ) {
          const real = yield* fileSystem.realPath(file);
          if (!real.startsWith(`${owner}/`)) {
            return yield* scaffoldFailure('owner approval provider import escapes the original owner source');
          }
          pending.push({ file, source: yield* fileSystem.readFileString(file) });
        }
      }
    }
    return sources;
  }).pipe(
    Effect.mapError((cause) => scaffoldFailure('failed to read original owner approval provider sources', cause)),
  );

/** Accept a technical forwarder only after resolving its actual original owner native Layer. */
export const acceptOwnedRedemptionReexport = (
  vertical: Pick<OntosVerticalMetadata, 'appId' | 'directory'>,
  file: string,
) =>
  Effect.gen(function* acceptOwnedRedemptionReexportEffect() {
    const source = yield* readOptionalSource(file);
    if (tokenizeGovernedClient(source)[0]?.kind !== SyntaxKind.ExportKeyword) {
      return false;
    }
    const reexported = parseOwnedRedemptionReexport(source);
    if (reexported === undefined) {
      return yield* scaffoldFailure('unsupported owner redemption reexport; original named Layer exports are required');
    }
    const targetPath = path.resolve(path.dirname(file), reexported.file);
    const fileSystem = yield* FileSystem.FileSystem;
    const ownerPath = yield* fileSystem.realPath(vertical.directory);
    const target = yield* fileSystem.realPath(targetPath);
    if (!target.startsWith(`${ownerPath}/`)) {
      return yield* scaffoldFailure('redemption adapter target escapes its original owner');
    }
    const targetSource = yield* fileSystem.readFileString(target);
    const sources = yield* readApprovalProviderSources(vertical.directory, targetPath, targetSource);
    if (
      !hasOwnedRedemptionReexportTarget(source, targetSource, vertical.appId, reexported.names, {
        ownerPath: vertical.directory,
        rootFile: targetPath,
        sources,
      })
    ) {
      return yield* scaffoldFailure('redemption adapter target lacks original owner/native service provenance');
    }
    return true;
  }).pipe(Effect.mapError((cause) => scaffoldFailure('failed to inspect original redemption adapter target', cause)));

/** The import repair is independently replayable and changes no provider or API publication. */
export const planOwnerApprovalAuthenticationImports = (vertical: Pick<OntosVerticalMetadata, 'directory'>) =>
  Effect.gen(function* planOwnerApprovalAuthenticationImportsEffect() {
    const file = resolveContainedPath(vertical.directory, 'api', 'index.ts');
    const original = yield* readOptionalSource(file);
    const next = yield* tryScaffold('failed to consolidate original approval authentication imports', () =>
      consolidateOwnerApprovalAuthenticationImport(original),
    );
    const mutation = updateMutation(file, original, next);
    return mutation === undefined ? [] : [mutation];
  });

/** This publishes an already-mounted Core platform capability; it creates no runtime or grant. */
export const planOwnerApprovalPublication = (
  vertical: OntosVerticalMetadata,
): Effect.Effect<readonly Mutation[], ScaffoldFailure, FileSystem.FileSystem> =>
  Effect.gen(function* planOwnerApprovalPublicationEffect() {
    const sharedApiPath = resolveContainedPath(vertical.directory, 'shared', 'api.ts');
    const rootPath = resolveContainedPath(vertical.directory, 'api', 'index.ts');
    const [sharedApi, originalRoot] = yield* Effect.all([
      readOptionalSource(sharedApiPath),
      readOptionalSource(rootPath),
    ]);
    const root = yield* tryScaffold('failed to consolidate original approval authentication imports', () =>
      consolidateOwnerApprovalAuthenticationImport(originalRoot),
    );
    const owner = vertical.runtimeDeclaration ?? { content: vertical.manifestContent, path: vertical.manifestPath };
    const sources = new Map([
      [sharedApiPath, sharedApi],
      [rootPath, root],
      [vertical.manifestPath, vertical.manifestContent],
      [vertical.registrationPath, vertical.registrationContent],
      [owner.path, owner.content],
    ]);
    const providers = yield* readApprovalProviderSources(vertical.directory, rootPath, root);
    for (const [file, source] of providers) {
      sources.set(file, source);
    }
    const mounted = inspectOwnerActionApprovalMount(sharedApi, root, vertical.slug, {
      ownerPath: vertical.directory,
      rootFile: rootPath,
      sources,
    });
    if (mounted.kind === 'invalid') {
      return yield* scaffoldFailure(`owner approval publication refused: ${mounted.reason}`);
    }
    if (mounted.kind === 'absent') {
      if (!hasOwnerActionApprovalPublication(sources, sharedApiPath)) {
        return yield* scaffoldFailure('owner approval publication has no executed native owner handler');
      }
      return [];
    }
    const outputs = yield* tryScaffold(
      'failed to publish the original owner approval API',
      () =>
        [
          [sharedApiPath, sharedApi, publishOwnerApprovalSharedApi(sharedApi)],
          [owner.path, owner.content, publishOwnerApprovalManifest(owner.content)],
          [
            vertical.registrationPath,
            vertical.registrationContent,
            publishOwnerApprovalLoader(vertical.registrationContent),
          ],
          [rootPath, originalRoot, root],
        ] as const,
    );
    for (const [file, , next] of outputs) {
      sources.set(file, next);
    }
    const diagnostics: string[] = [];
    if (!hasOwnerActionApprovalPublication(sources, sharedApiPath, diagnostics)) {
      return yield* scaffoldFailure(`owner approval publication failed its complete proof: ${diagnostics.join('; ')}`);
    }
    const mutations: Mutation[] = [];
    for (const [file, before, after] of outputs) {
      const mutation = updateMutation(file, before, after);
      if (mutation !== undefined) {
        mutations.push(mutation);
      }
    }
    return mutations;
  });
