import { FileSystem, Effect, Option } from 'effect';

import {
  createOrAcceptGeneratedMutationEffect,
  ensureUniqueMutationPaths,
  requireCanonicalSlug,
  requireCoreModuleKey,
  raiseScaffoldFailure,
  resolveContainedPath,
  scaffoldFailure,
  toCamelCase,
  toPascalCase,
  tryScaffold,
  updateMutation,
} from '../shared.mts';
import type { CoreReadScaffoldConfig, Mutation } from '../shared.mts';

const HEADER = '// @generated by OntOS Codesmith Core Read v1';

const markers = {
  clientImports: 'core-read-client-imports',
  clientOperations: 'core-read-client-operations',
  coreExports: 'core-read-exports',
  serverGroups: 'core-read-server-groups',
  serverImports: 'core-read-server-imports',
  serverLayers: 'core-read-server-layers',
  sharedGroups: 'core-read-api-groups',
  sharedImports: 'core-read-contract-imports',
} as const;

const marker = (name: string, edge: 'end' | 'start') => `// @ontos-codesmith-${name}:${edge}`;
const comparable = (value: string) => value.replaceAll(/\s+/gu, '').replaceAll(/,(?<closing>[})\]])/gu, '$<closing>');

const patchSlot = (source: string, name: string, identity: string, contribution: string): string => {
  const start = marker(name, 'start');
  const end = marker(name, 'end');
  if (source.split(start).length !== 2 || source.split(end).length !== 2) {
    return raiseScaffoldFailure(`missing or duplicate Core read insertion slot: ${name}`);
  }
  const startIndex = source.indexOf(start) + start.length;
  const endIndex = source.indexOf(end);
  if (startIndex > endIndex) {
    return raiseScaffoldFailure(`reversed Core read insertion slot: ${name}`);
  }
  const body = source.slice(startIndex, endIndex);
  const tag = `// @ontos-core-read ${identity}`;
  if (body.includes(tag)) {
    if (!comparable(body).includes(comparable(contribution))) {
      return raiseScaffoldFailure(`Core read insertion slot drift: ${name} / ${identity}`);
    }
    return source;
  }
  if (body.trim().length > 0 && !body.includes('// @ontos-core-read ')) {
    return raiseScaffoldFailure(`unsupported content in Core read insertion slot: ${name}`);
  }
  const insertion = `\n${tag}\n${contribution}\n`;
  return `${source.slice(0, endIndex)}${insertion}${source.slice(endIndex)}`;
};

const patchCoreRuntimeImport = (source: string, value: string): string => {
  const imports = [...source.matchAll(/import \{(?<members>[^}]*)\} from '@app\/core-runtime';/gu)];
  if (imports.length !== 1 || imports[0]?.groups?.['members'] === undefined) {
    return raiseScaffoldFailure('Core read requires one canonical Shell Core runtime import');
  }
  const [found] = imports;
  const members = found?.groups?.['members'];
  if (members === undefined || found.index === undefined) {
    return raiseScaffoldFailure('Core read cannot patch Shell Core runtime import');
  }
  if (new RegExp(`\\b${value}Read\\b`, 'u').test(members)) {
    return source;
  }
  const replacement = `import {${members.trimEnd()}\n  ${value}Read,\n} from '@app/core-runtime';`;
  return `${source.slice(0, found.index)}${replacement}${source.slice(found.index + found[0].length)}`;
};

const schemaDeclarations = (type: string) => `export const ${type}RequestSchema = Schema.Struct({
  id: Schema.String.check(Schema.isUUID()),
});
export type ${type}Request = typeof ${type}RequestSchema.Type;

export const ${type}ResponseSchema = Schema.Struct({
  ok: Schema.Literal(true),
});
export type ${type}Response = typeof ${type}ResponseSchema.Type;`;

const renderShellContract = (type: string) => `${HEADER}
import { Schema } from '@modern-js/bff-effect/effect-client';

${schemaDeclarations(type)}
`;

const authorizationLiteral = (config: CoreReadScaffoldConfig): string =>
  config.authorization === 'context_permission'
    ? `{ kind: 'context_permission', permission: '${config.permission}' }`
    : `{ kind: 'authenticated_principal' }`;

const renderCoreRead = (module: string, name: string, config: CoreReadScaffoldConfig) => {
  const type = toPascalCase(name);
  const value = toCamelCase(name);
  const key = `${module}.api.${name}`;
  return `${HEADER}
import { Effect, Schema } from 'effect';
import { defineSystemModuleEntrypoint } from '../modules/module-entrypoint.ts';
import { defineRead } from '../reads/definition.ts';
import { ReadHandlerUnavailable } from '../reads/errors.ts';

${schemaDeclarations(type)}

// Fail closed until the Core owner supplies a target-aware permission resolver,
// tenant/lifecycle validation, and owner-local read services. A ResourceRef or
// selected legal entity is not authorization to inspect an arbitrary target.
export const ${value}Read = defineRead(
  {
    accessKind: 'detail',
    entrypoint: defineSystemModuleEntrypoint({
      access: 'read',
      authorization: ${authorizationLiteral(config)},
      entrypointKey: '${key}',
      moduleKey: '${module}',
      role: 'api',
    }),
    evidencePolicy: { captureMode: 'metadata_only', policyKey: '${key}.access.v1' },
    inputSchema: ${type}RequestSchema,
    legalEntityScope: 'optional',
    owningModuleKey: '${module}',
    permissionTarget: 'module',
    policies: [],
    readKey: '${key}',
    resultSchema: ${type}ResponseSchema,
    schemaVersion: '1',
  },
  () => Effect.fail(new ReadHandlerUnavailable({
    code: 'read_handler_unavailable',
    reason: 'Core read requires owner implementation and target authorization',
  })),
  () => Effect.succeed({}),
  () => ({ kind: 'module', moduleId: '${module}' }),
);
`;
};

const renderApiGroup = (name: string, type: string) => `  .add(
    HttpApiGroup.make('coreRead${type}').add(
      HttpApiEndpoint.post('execute${type}', '/core/reads/${name}', {
        error: identityErrors,
        payload: ${type}RequestSchema,
        success: ${type}ResponseSchema,
      }),
    ),
  )`;

const renderServerGroup = (
  type: string,
  value: string,
) => `const coreRead${type}GroupLive = HttpApiBuilder.group(ShellAuthenticationApi, 'coreRead${type}', (handlers) =>
  handlers.handle('execute${type}', ({ payload, request }) =>
    Effect.gen(function* execute${type}CoreRead() {
      const authentication = yield* AuthenticationService;
      const resolved = yield* authentication.resolveTenantContext(requestHeaders(request.headers)).pipe(
        Effect.catch((error) => pipe(error, identityProblem, failIdentityProblem)),
      );
      yield* forwardSetCookieHeaders(resolved.setCookieHeaders);
      if (resolved.state !== 'authenticated') {
        return yield* failIdentityProblem(shellAuthenticationRequiredProblem());
      }
      const runtime = yield* ReadRuntime;
      return yield* runtime.runRead({
        input: payload,
        principal: resolved.principal,
        registration: ${value}Read,
        transport: { correlationId: correlationFromRequest(request) },
      }).pipe(Effect.catch((error) => pipe(error, identityProblem, failIdentityProblem)));
    }).pipe(
      recoverUnexpectedDefect(request, 'Unexpected Shell Core read defect', () =>
        failIdentityProblem(shellInternalProblem()),
      ),
    ),
  ),
);`;

const renderClientOperation = (type: string) => `export const execute${type} = (
  payload: ${type}Request,
  options: ShellAuthenticationClientOptions = {},
): Effect.Effect<${type}Response, IdentityClientError> =>
  invokeShellAuthenticationClient(options, (client) => client.coreRead${type}.execute${type}({ payload }));`;

const readAndPatch = Effect.fn('CoreReadScaffold.patch')(function* readAndPatch(
  path: string,
  slots: readonly [string, string, string][],
  coreImport?: string,
) {
  const fs = yield* FileSystem.FileSystem;
  const current = yield* fs
    .readFileString(path)
    .pipe(Effect.mapError((cause) => scaffoldFailure(`failed to read Core read insertion root ${path}`, cause)));
  let next = current;
  for (const [slot, identity, entry] of slots) {
    const currentSource = next;
    next = yield* tryScaffold(`failed to patch Core read slot ${slot}`, () =>
      patchSlot(currentSource, slot, identity, entry),
    );
  }
  if (coreImport !== undefined) {
    const currentSource = next;
    next = yield* tryScaffold('failed to patch canonical Core runtime import', () =>
      patchCoreRuntimeImport(currentSource, coreImport),
    );
  }
  return updateMutation(path, current, next);
});

export const planCoreReadScaffold = Effect.fn('CoreReadScaffold.plan')(function* planCoreReadScaffold(
  workspaceRoot: string,
  config: CoreReadScaffoldConfig,
) {
  const name = yield* tryScaffold('Core read name is invalid', () => requireCanonicalSlug(config.name, 'Core read'));
  const module = yield* tryScaffold('Core read module is invalid', () => requireCoreModuleKey(config.module));
  if (config.authorization === 'public') {
    return yield* scaffoldFailure('Core reads currently require authenticated_principal or context_permission');
  }
  if (config.authorization === 'context_permission') {
    if (config.permission === undefined || !/^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$/u.test(config.permission)) {
      return yield* scaffoldFailure('context_permission requires a stable --permission');
    }
  } else if (config.permission !== undefined) {
    return yield* scaffoldFailure('--permission is valid only for context_permission');
  }
  const type = toPascalCase(name);
  const value = toCamelCase(name);
  const coreRoot = yield* tryScaffold('invalid Core path', () =>
    resolveContainedPath(workspaceRoot, 'packages', 'core-runtime'),
  );
  const shellRoot = yield* tryScaffold('invalid Shell path', () =>
    resolveContainedPath(workspaceRoot, 'apps', 'shell-super-app'),
  );
  const coreReadPath = yield* tryScaffold('invalid Core read path', () =>
    resolveContainedPath(coreRoot, 'src', 'generated-reads', `${name}.ts`),
  );
  const shellContractPath = yield* tryScaffold('invalid Shell contract path', () =>
    resolveContainedPath(shellRoot, 'shared', 'core-reads', `${name}.ts`),
  );
  const coreIndex = yield* tryScaffold('invalid Core export path', () =>
    resolveContainedPath(coreRoot, 'src', 'index.ts'),
  );
  const sharedApi = yield* tryScaffold('invalid Shell API path', () =>
    resolveContainedPath(shellRoot, 'shared', 'api.ts'),
  );
  const serverRoot = yield* tryScaffold('invalid Shell server path', () =>
    resolveContainedPath(shellRoot, 'api', 'index.ts'),
  );
  const clientRoot = yield* tryScaffold('invalid Shell client path', () =>
    resolveContainedPath(shellRoot, 'src', 'api', 'auth-client.ts'),
  );
  const created = yield* Effect.all([
    createOrAcceptGeneratedMutationEffect(coreReadPath, renderCoreRead(module, name, config)),
    createOrAcceptGeneratedMutationEffect(shellContractPath, renderShellContract(type)),
  ]);
  const patched = yield* Effect.all([
    readAndPatch(coreIndex, [
      [markers.coreExports, name, `export { ${value}Read } from './generated-reads/${name}.ts';`],
    ]),
    readAndPatch(sharedApi, [
      [
        markers.sharedImports,
        name,
        `import { ${type}RequestSchema, ${type}ResponseSchema } from './core-reads/${name}.ts';`,
      ],
      [markers.sharedGroups, name, renderApiGroup(name, type)],
    ]),
    readAndPatch(
      serverRoot,
      [
        [markers.serverImports, name, `// ${value}Read uses the canonical @app/core-runtime import`],
        [markers.serverGroups, name, renderServerGroup(type, value)],
        [markers.serverLayers, name, `coreRead${type}GroupLive,`],
      ],
      value,
    ),
    readAndPatch(clientRoot, [
      [
        markers.clientImports,
        name,
        `import type { ${type}Request, ${type}Response } from '../../shared/core-reads/${name}.ts';`,
      ],
      [markers.clientOperations, name, renderClientOperation(type)],
    ]),
  ]);
  const mutations: Mutation[] = [
    ...created.flatMap((item) => (Option.isSome(item) ? [item.value] : [])),
    ...patched.filter((item) => item !== undefined),
  ];
  yield* tryScaffold('Core read mutation paths are invalid', () => ensureUniqueMutationPaths(mutations));
  return { mutations, result: { artifactPath: coreReadPath, clientPath: clientRoot, serverPath: serverRoot } };
});
