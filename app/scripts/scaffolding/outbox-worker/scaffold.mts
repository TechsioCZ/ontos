import { readFile } from 'node:fs/promises';
import { createCodesmithGenerator } from '../generator-adapter.mts';
import {
  MODULE_REGISTRATION_IMPORT_SLOT_END,
  MODULE_REGISTRATION_IMPORT_SLOT_START,
  MODULE_REGISTRATION_WORKER_SLOT_END,
  MODULE_REGISTRATION_WORKER_SLOT_START,
  OUTBOX_CONTRACT_GENERATOR_HEADER,
  OUTBOX_WORKER_GENERATOR_HEADER,
  OUTBOX_WORKER_IMPORT_SLOT_END,
  OUTBOX_WORKER_IMPORT_SLOT_START,
  OUTBOX_WORKER_REGISTRY_SLOT_END,
  OUTBOX_WORKER_REGISTRY_SLOT_START,
  asJsonObject,
  createMutation,
  discoverOntosModule,
  ensureUniqueMutationPaths,
  insertSortedSlot,
  isMissingFileError,
  patchJsonObjectProperty,
  requireCanonicalSlug,
  requireTopic,
  resolveContainedPath,
  toCamelCase,
  toPascalCase,
  topicToSlug,
  updateMutation,
} from '../shared.mts';
import type {
  MutableJsonObject,
  Mutation,
  OutboxWorkerScaffoldConfig,
  OutboxWorkerScaffoldResult,
  ScaffoldPlan,
  OntosVerticalMetadata,
} from '../shared.mts';

const readRequiredFile = async (filePath: string, label: string): Promise<string> => {
  try {
    return await readFile(filePath, 'utf-8');
  } catch (error) {
    if (isMissingFileError(error)) {
      throw new Error(`${label} is missing at ${filePath}`, { cause: error });
    }
    throw error;
  }
};

const OUTBOX_WORKER_HOST_HEADER = '// @generated by scaffold:outbox-worker worker-host';

const renderWorker = (
  consumer: OntosVerticalMetadata,
  producer: OntosVerticalMetadata,
  worker: string,
  topic: string,
): string => {
  const workerType = toPascalCase(worker);
  const workerVariable = `${toCamelCase(worker)}Worker`;
  const contractPath = `${producer.packageName}/outbox/${topicToSlug(topic)}`;
  return `${OUTBOX_WORKER_GENERATOR_HEADER}
// @ontos-outbox-worker-key ${consumer.moduleId}.${worker}
// @ontos-outbox-worker-owner ${consumer.moduleId}
// @ontos-outbox-worker-producer ${producer.moduleId}
// @ontos-outbox-worker-topic ${topic}
import { Effect, Schema } from 'effect';
import { defineOutboxWorker, defineTenantModuleEntrypoint } from '@app/core-runtime';
import {
  OutboxPayloadSchema,
  outboxProducerModuleKey,
  outboxTopic,
} from '${contractPath}';

export class ${workerType}NotImplemented extends Schema.TaggedError<${workerType}NotImplemented>()(
  '${workerType}NotImplemented',
  {
    code: Schema.Literal('outbox_worker_not_implemented'),
    reason: Schema.String,
  },
) {}

const handle${workerType} = () =>
  Effect.fail(
    new ${workerType}NotImplemented({
      code: 'outbox_worker_not_implemented',
      reason: 'The ${workerType} Outbox Worker is not implemented',
    }),
  );

export const ${workerVariable} = defineOutboxWorker(
  {
    consumerModuleKey: '${consumer.moduleId}',
    entrypoint: defineTenantModuleEntrypoint({
      access: 'background',
      entrypointKey: '${consumer.moduleId}.${worker}',
      moduleKey: '${consumer.moduleId}',
      role: 'worker',
    }),
    leaseDurationMs: 30_000,
    payloadSchema: OutboxPayloadSchema,
    producerModuleKey: outboxProducerModuleKey,
    retryPolicy: {
      initialBackoffMs: 1000,
      maxAttempts: 5,
      maxBackoffMs: 60_000,
      multiplier: 2,
    },
    topic: outboxTopic,
    workerKey: '${consumer.moduleId}.${worker}',
  },
  handle${workerType},
);
`;
};

const renderRegistry =
  (): string => `import type { AnyOutboxWorkerRegistration } from '@app/core-runtime';

${OUTBOX_WORKER_IMPORT_SLOT_START}
${OUTBOX_WORKER_IMPORT_SLOT_END}

export const outboxWorkers = Object.freeze([
  ${OUTBOX_WORKER_REGISTRY_SLOT_START}
  ${OUTBOX_WORKER_REGISTRY_SLOT_END}
]) satisfies readonly AnyOutboxWorkerRegistration[];
`;

const renderWorkerHostLayer = (
  consumer: OntosVerticalMetadata,
): string => `${OUTBOX_WORKER_HOST_HEADER}
// @ontos-outbox-worker-host-owner ${consumer.moduleId}
import { Layer } from 'effect';
import { OutboxWorkerInfrastructureLive } from '@app/core-runtime';

/** Add owner-local repositories and services required by worker handlers here. */
const outboxWorkerHandlerLayer = Layer.empty;

export const outboxWorkerLayer = Layer.merge(
  OutboxWorkerInfrastructureLive,
  outboxWorkerHandlerLayer,
);
`;

const renderWorkerHostMain = (
  consumer: OntosVerticalMetadata,
): string => `${OUTBOX_WORKER_HOST_HEADER}
// @ontos-outbox-worker-host-owner ${consumer.moduleId}
import {
  extractOutboxWorkerSubscriptions,
  startOutboxWorkerProcess,
} from '@app/core-runtime';
import { outboxWorkerLayer } from './layer.ts';
import { outboxWorkers } from '../workers/index.ts';

const outboxSubscriptions = extractOutboxWorkerSubscriptions(outboxWorkers);

startOutboxWorkerProcess({
  claimOwnerPrefix: '${consumer.moduleId}-outbox-worker',
  health: true,
  layer: outboxWorkerLayer,
  registrations: outboxWorkers,
  subscriptions: outboxSubscriptions,
});
`;

const planWorkerHostFile = async (
  filePath: string,
  consumer: OntosVerticalMetadata,
  content: string,
): Promise<Mutation | undefined> => {
  try {
    const existing = await readFile(filePath, 'utf-8');
    if (
      !existing.startsWith(`${OUTBOX_WORKER_HOST_HEADER}\n`) ||
      !existing.includes(`// @ontos-outbox-worker-host-owner ${consumer.moduleId}\n`)
    ) {
      throw new Error(`existing Outbox Worker host is not owned by ${consumer.moduleId}`);
    }
    return undefined;
  } catch (error) {
    if (!isMissingFileError(error)) {
      throw error;
    }
    return createMutation(filePath, content);
  }
};

const patchConsumerPackage = (
  consumer: OntosVerticalMetadata,
  producer: OntosVerticalMetadata,
): string => {
  const dependenciesValue = consumer.packageJson['dependencies'];
  const dependencies: MutableJsonObject =
    dependenciesValue === undefined
      ? {}
      : { ...asJsonObject(dependenciesValue, `vertical ${consumer.slug} dependencies`) };
  for (const [name, version] of [
    ['@app/core-runtime', 'workspace:*'],
    [producer.packageName, 'workspace:*'],
  ] as const) {
    if (name === consumer.packageName) {
      continue;
    }
    const current = dependencies[name];
    if (current !== undefined && current !== version) {
      throw new Error(`vertical ${consumer.slug} has an incompatible ${name} dependency`);
    }
    dependencies[name] = version;
  }
  const sortedDependencies = Object.fromEntries(
    Object.entries(dependencies).toSorted(([left], [right]) => left.localeCompare(right)),
  );
  const scriptsValue = asJsonObject(
    consumer.packageJson['scripts'],
    `vertical ${consumer.slug} package scripts`,
  );
  const workerCommand = 'node --experimental-strip-types ./src/worker-host/main.ts';
  const scripts = { ...scriptsValue };
  for (const scriptName of ['dev:worker', 'worker:start'] as const) {
    const current = scripts[scriptName];
    if (current !== undefined && current !== workerCommand) {
      throw new Error(`vertical ${consumer.slug} has an incompatible ${scriptName} script`);
    }
    scripts[scriptName] = workerCommand;
  }
  const sortedScripts = Object.fromEntries(
    Object.entries(scripts).toSorted(([left], [right]) => left.localeCompare(right)),
  );
  const withDependencies = patchJsonObjectProperty(
    consumer.packageContent,
    [],
    'dependencies',
    sortedDependencies,
  );
  return patchJsonObjectProperty(withDependencies, [], 'scripts', sortedScripts);
};

const patchConsumerTsconfig = (
  content: string,
  consumer: OntosVerticalMetadata,
  producer: OntosVerticalMetadata,
): string => {
  let parsed: unknown;
  try {
    parsed = JSON.parse(content);
  } catch {
    throw new Error(`vertical ${consumer.slug} tsconfig is not valid JSON`);
  }
  const root = asJsonObject(parsed, `vertical ${consumer.slug} tsconfig`);
  const referencesValue = root['references'];
  if (!Array.isArray(referencesValue)) {
    throw new TypeError(`vertical ${consumer.slug} tsconfig references must be an array`);
  }
  const references = referencesValue.map((reference, index) =>
    asJsonObject(reference, `vertical ${consumer.slug} tsconfig reference ${index}`),
  );
  const producerReference = `../${producer.slug}`;
  const matching = references.filter((reference) => reference['path'] === producerReference);
  if (consumer.slug === producer.slug) {
    if (matching.length > 0) {
      throw new Error(`vertical ${consumer.slug} has a circular self project reference`);
    }
    return content;
  }
  if (matching.length > 1) {
    throw new Error(`vertical ${consumer.slug} has duplicate ${producerReference} references`);
  }
  if (matching.length === 1) {
    return content;
  }
  const patched = [...references, { path: producerReference }].toSorted((left, right) =>
    String(left['path']).localeCompare(String(right['path'])),
  );
  return patchJsonObjectProperty(content, [], 'references', patched);
};

export const planOutboxWorkerScaffold = async (
  workspaceRoot: string,
  config: OutboxWorkerScaffoldConfig,
): Promise<ScaffoldPlan<OutboxWorkerScaffoldResult>> => {
  const worker = requireCanonicalSlug(config.worker, 'worker');
  const topic = requireTopic(config.topic);
  const [consumer, producer] = await Promise.all([
    discoverOntosModule(workspaceRoot, config.vertical),
    discoverOntosModule(workspaceRoot, config.producer),
  ]);
  const topicSlug = topicToSlug(topic);
  const contractPath = resolveContainedPath(
    workspaceRoot,
    'verticals',
    producer.slug,
    'shared',
    'outbox',
    `${topicSlug}.ts`,
  );
  const contract = await readRequiredFile(contractPath, 'published producer Outbox contract');
  const contractExport = `./outbox/${topicSlug}`;
  const producerExports = asJsonObject(
    producer.packageJson['exports'],
    `vertical ${producer.slug} package exports`,
  );
  if (producerExports[contractExport] !== `./shared/outbox/${topicSlug}.ts`) {
    throw new Error(`topic ${topic} is not published by ${producer.packageName}`);
  }
  if (
    !contract.startsWith(`${OUTBOX_CONTRACT_GENERATOR_HEADER}\n`) ||
    !contract.includes(`// @ontos-outbox-producer ${producer.moduleId}\n`) ||
    !contract.includes(`// @ontos-outbox-topic ${topic}\n`) ||
    !contract.includes(`export const outboxTopic = '${topic}' as const;`) ||
    !contract.includes(`export const outboxProducerModuleKey = '${producer.moduleId}' as const;`) ||
    !contract.includes('export const OutboxPayloadSchema =') ||
    /(?:src\/actions|create[A-Za-z0-9]+Message|handler|repository|transport)/u.test(contract)
  ) {
    throw new Error(`published Outbox contract for ${topic} has an owner/topic/schema mismatch`);
  }

  const workerPath = resolveContainedPath(
    workspaceRoot,
    'verticals',
    consumer.slug,
    'src',
    'workers',
    `${worker}.worker.ts`,
  );
  const workerMutation = await createMutation(
    workerPath,
    renderWorker(consumer, producer, worker, topic),
  );
  const registryPath = resolveContainedPath(
    workspaceRoot,
    'verticals',
    consumer.slug,
    'src',
    'workers',
    'index.ts',
  );
  let registryContent: string;
  let registryMutation: Mutation;
  try {
    registryContent = await readFile(registryPath, 'utf-8');
    if (
      !registryContent.includes(OUTBOX_WORKER_IMPORT_SLOT_START) ||
      !registryContent.includes(OUTBOX_WORKER_REGISTRY_SLOT_START)
    ) {
      throw new Error('generated worker registry does not contain its owned slots');
    }
    const workerVariable = `${toCamelCase(worker)}Worker`;
    if (new RegExp(`\\b${workerVariable}\\b`, 'u').test(registryContent)) {
      throw new Error(`Outbox Worker identifier ${workerVariable} already exists`);
    }
    const withImport = insertSortedSlot(
      registryContent,
      OUTBOX_WORKER_IMPORT_SLOT_START,
      OUTBOX_WORKER_IMPORT_SLOT_END,
      [`import { ${workerVariable} } from './${worker}.worker.ts';`],
      (candidate) =>
        /^import \{ [A-Za-z0-9]+Worker \} from '\.\/[a-z0-9-]+\.worker\.ts';$/u.test(candidate),
    );
    const withRegistration = insertSortedSlot(
      withImport,
      OUTBOX_WORKER_REGISTRY_SLOT_START,
      OUTBOX_WORKER_REGISTRY_SLOT_END,
      [`${workerVariable},`],
      (candidate) => /^[a-z][A-Za-z0-9]+Worker,$/u.test(candidate),
    );
    const updatedRegistry = updateMutation(registryPath, registryContent, withRegistration);
    if (updatedRegistry === undefined) {
      throw new Error('Outbox Worker registry patch unexpectedly made no change');
    }
    registryMutation = updatedRegistry;
  } catch (error) {
    if (!isMissingFileError(error)) {
      throw error;
    }
    registryContent = renderRegistry();
    const workerVariable = `${toCamelCase(worker)}Worker`;
    const withImport = insertSortedSlot(
      registryContent,
      OUTBOX_WORKER_IMPORT_SLOT_START,
      OUTBOX_WORKER_IMPORT_SLOT_END,
      [`import { ${workerVariable} } from './${worker}.worker.ts';`],
      () => true,
    );
    const withRegistration = insertSortedSlot(
      withImport,
      OUTBOX_WORKER_REGISTRY_SLOT_START,
      OUTBOX_WORKER_REGISTRY_SLOT_END,
      [`${workerVariable},`],
      () => true,
    );
    registryMutation = await createMutation(registryPath, withRegistration);
  }

  const workerHostLayerPath = resolveContainedPath(
    workspaceRoot,
    'verticals',
    consumer.slug,
    'src',
    'worker-host',
    'layer.ts',
  );
  const workerHostMainPath = resolveContainedPath(
    workspaceRoot,
    'verticals',
    consumer.slug,
    'src',
    'worker-host',
    'main.ts',
  );
  const [workerHostLayerMutation, workerHostMainMutation] = await Promise.all([
    planWorkerHostFile(workerHostLayerPath, consumer, renderWorkerHostLayer(consumer)),
    planWorkerHostFile(workerHostMainPath, consumer, renderWorkerHostMain(consumer)),
  ]);

  const workerVariable = `${toCamelCase(worker)}Worker`;
  const registrationImport = `import { ${workerVariable} } from './src/workers/${worker}.worker.ts';`;
  const nextRegistration = insertSortedSlot(
    insertSortedSlot(
      consumer.registrationContent,
      MODULE_REGISTRATION_IMPORT_SLOT_START,
      MODULE_REGISTRATION_IMPORT_SLOT_END,
      [registrationImport],
      (candidate) =>
        /^import \{ [a-z][A-Za-z0-9]*Worker \} from '\.\/src\/workers\/[a-z][a-z0-9-]*\.worker\.ts';$/u.test(
          candidate,
        ) ||
        /^import \{ [a-z][A-Za-z0-9]*Action \} from '\.\/src\/actions\/[a-z][a-z0-9-]*\.action\.ts';$/u.test(
          candidate,
        ),
    ),
    MODULE_REGISTRATION_WORKER_SLOT_START,
    MODULE_REGISTRATION_WORKER_SLOT_END,
    [`${workerVariable},`],
    (candidate) => /^[a-z][A-Za-z0-9]*Worker,$/u.test(candidate),
  );
  const ownerRegistrationMutation = updateMutation(
    consumer.registrationPath,
    consumer.registrationContent,
    nextRegistration,
  );

  const packageContent = patchConsumerPackage(consumer, producer);
  const packageMutation = updateMutation(
    consumer.packagePath,
    consumer.packageContent,
    packageContent,
  );
  const tsconfigPath = resolveContainedPath(
    workspaceRoot,
    'verticals',
    consumer.slug,
    'tsconfig.json',
  );
  const tsconfigContent = await readRequiredFile(
    tsconfigPath,
    `vertical ${consumer.slug} tsconfig`,
  );
  const patchedTsconfig = patchConsumerTsconfig(tsconfigContent, consumer, producer);
  const tsconfigMutation = updateMutation(tsconfigPath, tsconfigContent, patchedTsconfig);
  const mutations = [
    workerMutation,
    registryMutation,
    ...(ownerRegistrationMutation === undefined ? [] : [ownerRegistrationMutation]),
    ...(workerHostLayerMutation === undefined ? [] : [workerHostLayerMutation]),
    ...(workerHostMainMutation === undefined ? [] : [workerHostMainMutation]),
    ...(packageMutation === undefined ? [] : [packageMutation]),
    ...(tsconfigMutation === undefined ? [] : [tsconfigMutation]),
  ];
  ensureUniqueMutationPaths(mutations);
  return { mutations, result: { registryPath, workerPath } };
};

export default createCodesmithGenerator(planOutboxWorkerScaffold);
