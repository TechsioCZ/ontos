import { Effect } from 'effect';
import { createCodesmithGenerator } from '../generator-adapter.mts';
import {
  MODULE_MANIFEST_IMPORT_SLOT_END,
  MODULE_MANIFEST_IMPORT_SLOT_START,
  MODULE_MANIFEST_PERMISSION_SLOT_END,
  MODULE_MANIFEST_PERMISSION_SLOT_START,
  asJsonObject,
  createMutationEffect,
  discoverOntosModuleEffect,
  ensureUniqueMutationPaths,
  insertSortedSlot,
  isModuleManifestImport,
  patchJsonObjectProperty,
  raiseScaffoldFailure,
  resolveContainedPath,
  scaffoldFailure,
  toCamelCase,
  toTitle,
  tryScaffold,
  updateMutation,
} from '../shared.mts';
import type { OntosVerticalMetadata, PermissionScaffoldConfig } from '../shared.mts';

const PERMISSION_GENERATOR_HEADER = '// @generated by OntOS Codesmith Business Permission v1';
const permissionCodePattern =
  /^(?:(?:retail|counterparty)(?:\.[a-z][a-z0-9_]*)+|pricing\.price_group(?:\.[a-z][a-z0-9_]*)+)$/u;

const requirePermissionCode = (value: string): string => {
  if (!permissionCodePattern.test(value)) {
    return raiseScaffoldFailure(
      'permission must be a stable retail.*, counterparty.*, or pricing.price_group.* lowercase dotted code',
    );
  }
  return value;
};

const requireCompatibleScope = (
  permission: string,
  scope: PermissionScaffoldConfig['scope'],
): PermissionScaffoldConfig['scope'] => {
  const pricingPermission = permission.startsWith('pricing.price_group.');
  const pricingScope = scope === 'pricing_catalog' || scope === 'price_group';
  if (pricingPermission !== pricingScope) {
    return raiseScaffoldFailure(
      'pricing.price_group.* permissions require pricing_catalog or price_group scope, and those scopes reject other permission families',
    );
  }
  return scope;
};

const permissionSlug = (permission: string): string => permission.replaceAll('.', '-').replaceAll('_', '-');
const descriptorName = (permission: string): string => `${toCamelCase(permissionSlug(permission))}Permission`;

const renderPermission = (
  vertical: OntosVerticalMetadata,
  permission: string,
  scope: PermissionScaffoldConfig['scope'],
): string => `${PERMISSION_GENERATOR_HEADER}
// @ontos-permission-owner ${vertical.moduleId}
// @ontos-permission-code ${permission}
import { defineBusinessPermission } from '@app/core-runtime';

export const ${descriptorName(permission)} = defineBusinessPermission({
  allowedScopeKinds: ['${scope}'],
  auditSensitivity: 'sensitive',
  authorityGroups: [],
  customerDelegable: false,
  internalGrantable: false,
  key: '${permission}',
  meaning: '${toTitle(permissionSlug(permission))} business permission.',
  owningCapability: '${vertical.moduleId}',
  protectedEntrypoints: [],
  schemaVersion: '1',
});
`;

const isPermissionDescriptor = (candidate: string): boolean => /^[a-z][A-Za-z0-9]*Permission,$/u.test(candidate);

const planPermissionScaffold = Effect.fn('PermissionScaffold.plan')(function* planPermissionScaffoldEffect(
  workspaceRoot: string,
  config: PermissionScaffoldConfig,
) {
  const permission = yield* tryScaffold('permission code is invalid', () => requirePermissionCode(config.permission));
  const scope = yield* tryScaffold('permission scope is invalid', () =>
    requireCompatibleScope(permission, config.scope),
  );
  const vertical = yield* discoverOntosModuleEffect(workspaceRoot, config.vertical);
  const slug = permissionSlug(permission);
  const permissionPath = yield* tryScaffold('failed to resolve permission path', () =>
    resolveContainedPath(vertical.directory, 'shared', 'permissions', `${slug}.ts`),
  );
  const permissionMutation = yield* createMutationEffect(permissionPath, renderPermission(vertical, permission, scope));
  const descriptor = descriptorName(permission);
  const manifestImport = `import { ${descriptor} } from './shared/permissions/${slug}.ts';`;
  const nextManifest = yield* tryScaffold('failed to patch permission manifest', () =>
    insertSortedSlot(
      insertSortedSlot(
        vertical.manifestContent,
        MODULE_MANIFEST_IMPORT_SLOT_START,
        MODULE_MANIFEST_IMPORT_SLOT_END,
        [manifestImport],
        isModuleManifestImport,
      ),
      MODULE_MANIFEST_PERMISSION_SLOT_START,
      MODULE_MANIFEST_PERMISSION_SLOT_END,
      [`${descriptor},`],
      isPermissionDescriptor,
    ),
  );
  const manifestMutation = updateMutation(vertical.manifestPath, vertical.manifestContent, nextManifest);
  if (manifestMutation === undefined) {
    return yield* scaffoldFailure('Permission manifest patch unexpectedly made no change');
  }

  const exportsValue = yield* tryScaffold('failed to read permission package exports', () =>
    asJsonObject(vertical.packageJson['exports'], `vertical ${vertical.slug} package exports`),
  );
  const contractExport = `./permissions/${permission}`;
  if (exportsValue[contractExport] !== undefined) {
    return yield* scaffoldFailure(`permission contract export ${contractExport} already exists`);
  }
  const packageMutation = yield* tryScaffold('failed to patch permission package export', () =>
    updateMutation(
      vertical.packagePath,
      vertical.packageContent,
      patchJsonObjectProperty(
        vertical.packageContent,
        [],
        'exports',
        Object.fromEntries(
          Object.entries({
            ...exportsValue,
            [contractExport]: `./shared/permissions/${slug}.ts`,
          }).toSorted(([left], [right]) => left.localeCompare(right)),
        ),
      ),
    ),
  );
  if (packageMutation === undefined) {
    return yield* scaffoldFailure('Permission package patch unexpectedly made no change');
  }
  const mutations = [permissionMutation, manifestMutation, packageMutation];
  yield* tryScaffold('permission mutation paths are invalid', () => ensureUniqueMutationPaths(mutations));
  return { mutations, result: { permissionPath } };
});

export default createCodesmithGenerator(planPermissionScaffold);
