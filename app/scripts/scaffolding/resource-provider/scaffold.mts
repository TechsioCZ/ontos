import { createCodesmithGenerator } from '../generator-adapter.mts';
import { planActionBoundaryScaffold } from '../microvertical-action-boundary/scaffold.mts';
import {
  MODULE_MANIFEST_API_SLOT_END,
  MODULE_MANIFEST_API_SLOT_START,
  MODULE_MANIFEST_IMPORT_SLOT_END,
  MODULE_MANIFEST_IMPORT_SLOT_START,
  MODULE_MANIFEST_RESOURCE_TYPE_SLOT_END,
  MODULE_MANIFEST_RESOURCE_TYPE_SLOT_START,
  MODULE_MANIFEST_SHELL_RESOURCE_DETAIL_SLOT_END,
  MODULE_MANIFEST_SHELL_RESOURCE_DETAIL_SLOT_START,
  MODULE_MANIFEST_SHELL_TIMELINE_SLOT_END,
  MODULE_MANIFEST_SHELL_TIMELINE_SLOT_START,
  MODULE_REGISTRATION_API_SLOT_END,
  MODULE_REGISTRATION_API_SLOT_START,
  createMutation,
  discoverOntosModule,
  ensureUniqueMutationPaths,
  insertSortedSlot,
  pathExists,
  requireCanonicalSlug,
  resolveContainedPath,
  toCamelCase,
  toPascalCase,
  toTitle,
  updateMutation,
} from '../shared.mts';
import type {
  Mutation,
  OntosVerticalMetadata,
  ResourceProviderScaffoldConfig,
  ResourceProviderScaffoldResult,
  ScaffoldPlan,
} from '../shared.mts';
import {
  renderApiClient,
  renderApiContract,
  renderGovernedServer,
} from '../governed-contribution/scaffold.mts';

const generatedHeader = '// @generated by OntOS Codesmith Resource Provider v1';
const serverSupportHeader = '// @generated by OntOS Codesmith Resource Provider Server Support v1';

const renderServerSupport = (): string => `${serverSupportHeader}
import type { ReadCoreError, TrustedPrincipalContext } from '@app/core-runtime';
import { Effect, HttpEffect, HttpServerResponse } from '@modern-js/plugin-bff/effect-edge';
import { Config } from 'effect';
import { verifyOperationPrincipal } from './action-principal.ts';

export type ResourceProviderVerificationFailure =
  | { readonly _tag: 'ResourceProviderAuthenticationFailure' }
  | { readonly _tag: 'ResourceProviderVerificationUnavailable' };

export const resourceProviderBearerChallenge = HttpEffect.appendPreResponseHandler(
  (_request, response) =>
    Effect.succeed(HttpServerResponse.setHeader(response, 'www-authenticate', 'Bearer')),
);

export const verifyResourceProviderPrincipal = (
  authorization: string | undefined,
): Effect.Effect<TrustedPrincipalContext, ResourceProviderVerificationFailure> =>
  Effect.gen(function* verifyGeneratedResourceProviderPrincipal() {
    const environment = yield* Config.all({
      ONTOS_GATEWAY_ISSUER: Config.string('ONTOS_GATEWAY_ISSUER'),
      ONTOS_GATEWAY_PUBLIC_JWKS: Config.string('ONTOS_GATEWAY_PUBLIC_JWKS'),
    }).pipe(
      Effect.mapError(() => ({ _tag: 'ResourceProviderVerificationUnavailable' as const })),
    );
    return yield* verifyOperationPrincipal(authorization, { environment }).pipe(
      Effect.mapError((error): ResourceProviderVerificationFailure =>
        error._tag === 'ActionPrincipalConfigurationError' ||
        error._tag === 'ActionPrincipalUnavailableError'
          ? { _tag: 'ResourceProviderVerificationUnavailable' }
          : { _tag: 'ResourceProviderAuthenticationFailure' },
      ),
    );
  });

export type ResourceProviderReadFailure =
  | { readonly kind: 'authentication' }
  | { readonly kind: 'forbidden' }
  | { readonly kind: 'internal' }
  | { readonly kind: 'not_found' }
  | { readonly kind: 'policy'; readonly status: 409 | 422 }
  | { readonly kind: 'unavailable' };

export const classifyResourceProviderReadFailure = (
  error: ReadCoreError,
): ResourceProviderReadFailure => {
  switch (error._tag) {
    case 'OperationAuthenticationRequired': {
      return { kind: 'authentication' };
    }
    case 'ModuleStateDeniedError':
    case 'OperationContextDenied':
    case 'OperationContextInvalid':
    case 'ReadPermissionDenied': {
      return { kind: 'forbidden' };
    }
    case 'ReadHandlerNotFound': {
      return { kind: 'not_found' };
    }
    case 'ReadPolicyDenied': {
      return { kind: 'policy', status: error.httpStatus };
    }
    case 'ModuleStateCheckUnavailableError':
    case 'OperationContextUnavailable':
    case 'ReadEvidencePersistenceError':
    case 'ReadHandlerUnavailable':
    case 'ReadPermissionUnavailable':
    case 'ReadPolicyEvaluationError': {
      return { kind: 'unavailable' };
    }
    default: {
      return { kind: 'internal' };
    }
  }
};
`;

const providerName = (resource: string, surface: 'detail' | 'timeline') => `${resource}-${surface}`;

const resourceDescriptor = (
  vertical: OntosVerticalMetadata,
  resource: string,
  timelineVisible: boolean,
) =>
  `{ capabilities: { graphVisible: false, linkable: true, mediaAttachable: false, searchable: false, timelineVisible: ${timelineVisible} }, description: '${toTitle(resource)} resource owned by ${vertical.moduleId}.', key: '${vertical.moduleId}.${resource}', label: '${toTitle(resource)}', owningModuleId: '${vertical.moduleId}' },`;

const renderContract = (
  vertical: OntosVerticalMetadata,
  resource: string,
  surface: 'detail' | 'timeline',
): string => {
  const name = providerName(resource, surface);
  const group = toCamelCase(name);
  const request = `Schema.Struct({\n  moduleId: Schema.Literal('${vertical.moduleId}'),\n  resourceId: Schema.String.check(Schema.isMinLength(1), Schema.isMaxLength(300)),\n  resourceType: Schema.Literal('${vertical.moduleId}.${resource}'),\n})`;
  const response =
    surface === 'detail'
      ? `Schema.Struct({\n  fields: Schema.Array(\n    Schema.Struct({\n      label: Schema.String.check(Schema.isMinLength(1), Schema.isMaxLength(300)),\n      value: Schema.String.check(Schema.isMaxLength(2000)),\n    }),\n  ),\n  title: Schema.String.check(Schema.isMinLength(1), Schema.isMaxLength(300)),\n})`
      : `Schema.Struct({\n  entries: Schema.Array(\n    Schema.Struct({\n      occurredAt: Schema.String.check(Schema.isMinLength(1)),\n      summary: Schema.String.check(Schema.isMinLength(1), Schema.isMaxLength(300)),\n      timelineEntryId: Schema.String.check(Schema.isMinLength(1), Schema.isMaxLength(300)),\n    }),\n  ),\n  projectionLagging: Schema.Boolean,\n})`;
  return renderApiContract(name)
    .replace('// @generated by OntOS Codesmith module-api v1', generatedHeader)
    .replace("HttpApiGroup.make('reads')", `HttpApiGroup.make('${group}')`)
    .replace('Schema.Struct({});', request)
    .replace('Schema.Struct({ ok: Schema.Literal(true) });', response);
};

const renderServer = (name: string, group: string): string => {
  const rendered = renderGovernedServer('module-api', name)
    .replace('// @generated by OntOS Codesmith module-api v1', generatedHeader)
    .replace("  'reads',", `  '${group}',`)
    .replace(`  HttpEffect,\n  HttpServerResponse,\n`, '')
    .replace("import { Config } from 'effect';\n", '')
    .replace(
      "import { verifyOperationPrincipal } from './auth/action-principal.ts';\n",
      "import {\n  classifyResourceProviderReadFailure,\n  resourceProviderBearerChallenge,\n  verifyResourceProviderPrincipal,\n} from './auth/resource-provider-server.ts';\n",
    )
    .replace(
      /const bearerChallenge = HttpEffect[\s\S]*?const readProblem = \(error: ReadCoreError\) => \{[\s\S]*?\n\};\n\nexport const/u,
      `type VerificationProblem =\n  | ReturnType<typeof authenticationProblem>\n  | ReturnType<typeof unavailableProblem>;\nconst readProblem = (error: ReadCoreError) => {\n  const failure = classifyResourceProviderReadFailure(error);\n  switch (failure.kind) {\n    case 'authentication':\n      return authenticationProblem();\n    case 'forbidden':\n      return forbiddenProblem();\n    case 'not_found':\n      return notFoundProblem();\n    case 'policy':\n      return policyProblem(failure.status);\n    case 'unavailable':\n      return unavailableProblem();\n    case 'internal':\n      return internalProblem();\n    default:\n      return internalProblem();\n  }\n};\n\nexport const`,
    )
    .replace(
      /        const environment = yield\* Config\.all\([\s\S]*?        const runtime = yield\* ReadRuntime;/u,
      `        const principal = yield* verifyResourceProviderPrincipal(\n          request.headers['authorization'],\n        ).pipe(\n          Effect.catch((error) =>\n            error._tag === 'ResourceProviderAuthenticationFailure'\n              ? resourceProviderBearerChallenge.pipe(\n                  Effect.andThen(Effect.fail<VerificationProblem>(authenticationProblem())),\n                )\n              : Effect.fail<VerificationProblem>(unavailableProblem()),\n          ),\n        );\n        const runtime = yield* ReadRuntime;`,
    )
    .replaceAll('bearerChallenge', 'resourceProviderBearerChallenge')
    .replace(
      `              const problem = readProblem(error);\n              return (problem.status === 401 ? resourceProviderBearerChallenge : Effect.void).pipe(\n                Effect.andThen(Effect.fail(problem)),\n              );`,
      `              const problem = readProblem(error);\n              const logFailure =\n                problem.status === 500\n                  ? Effect.logError('Unexpected governed resource-provider failure', error).pipe(\n                      Effect.annotateLogs({\n                        correlationId: request.headers['x-correlation-id'] ?? 'missing',\n                      }),\n                    )\n                  : Effect.void;\n              return logFailure.pipe(\n                Effect.andThen(\n                  problem.status === 401 ? resourceProviderBearerChallenge : Effect.void,\n                ),\n                Effect.andThen(Effect.fail(problem)),\n              );`,
    );
  return rendered;
};

const renderRead = (
  vertical: OntosVerticalMetadata,
  resource: string,
  surface: 'detail' | 'timeline',
): string => {
  const name = providerName(resource, surface);
  const type = toPascalCase(name);
  const value = toCamelCase(name);
  return `${generatedHeader}
import { ReadHandlerUnavailable, defineRead, defineTenantModuleEntrypoint } from '@app/core-runtime';
import { Effect } from 'effect';
import { ${type}RequestSchema, ${type}ResponseSchema } from '../../shared/apis/${name}.ts';

export const ${value}Entrypoint = defineTenantModuleEntrypoint({
  access: 'read',
  entrypointKey: '${vertical.moduleId}.api.${name}',
  moduleKey: '${vertical.moduleId}',
  role: 'api',
});

export const ${value}Read = defineRead(
  {
    accessKind: '${surface === 'detail' ? 'detail' : 'list'}',
    entrypoint: ${value}Entrypoint,
    evidencePolicy: {
      captureMode: 'metadata_only',
      policyKey: '${vertical.moduleId}.api.${name}.evidence.v1',
    },
    inputSchema: ${type}RequestSchema,
    legalEntityScope: 'required',
    owningModuleKey: '${vertical.moduleId}',
    permissionTarget: 'resource',
    policies: [],
    readKey: '${vertical.moduleId}.api.${name}',
    resultSchema: ${type}ResponseSchema,
    schemaVersion: '1',
  },
  () =>
    Effect.fail(
      new ReadHandlerUnavailable({
        code: 'read_handler_unavailable',
        reason: 'The generated ${toTitle(resource)} ${surface} provider has no business implementation',
      }),
    ),
  () => Effect.succeed({}),
  ({ moduleId, resourceId, resourceType }) => ({
    kind: 'resource',
    resource: { moduleId, resourceId, resourceType },
  }),
);
`;
};

const patchManifest = (
  vertical: OntosVerticalMetadata,
  resource: string,
  surface: 'detail' | 'timeline',
): string => {
  const name = providerName(resource, surface);
  const type = toPascalCase(name);
  const resourceType = `${vertical.moduleId}.${resource}`;
  let manifest = insertSortedSlot(
    vertical.manifestContent,
    MODULE_MANIFEST_IMPORT_SLOT_START,
    MODULE_MANIFEST_IMPORT_SLOT_END,
    [`import { ${type}Api } from './shared/apis/${name}.ts';`],
    (candidate) => /^import \{ [A-Za-z][A-Za-z0-9]* \} from '.+';$/u.test(candidate),
  );
  manifest = insertSortedSlot(
    manifest,
    MODULE_MANIFEST_API_SLOT_START,
    MODULE_MANIFEST_API_SLOT_END,
    [`'${name}': ${type}Api,`],
    (candidate) => candidate.endsWith(','),
  );
  if (surface === 'detail') {
    manifest = insertSortedSlot(
      manifest,
      MODULE_MANIFEST_RESOURCE_TYPE_SLOT_START,
      MODULE_MANIFEST_RESOURCE_TYPE_SLOT_END,
      [resourceDescriptor(vertical, resource, false)],
      (candidate) => candidate.endsWith(','),
    );
  } else {
    const withoutTimeline = resourceDescriptor(vertical, resource, false);
    if (!manifest.includes(withoutTimeline)) {
      throw new Error(
        `timeline resource ${resourceType} must be declared by a same-owner detail provider`,
      );
    }
    manifest = manifest.replace(withoutTimeline, resourceDescriptor(vertical, resource, true));
  }
  const contribution = `{ apiKey: '${vertical.moduleId}.${name}', contributionKey: '${vertical.moduleId}.resource-${surface}.${resource}', entrypoint: { access: 'read', entrypointKey: '${vertical.moduleId}.api.${name}', moduleKey: '${vertical.moduleId}', role: 'api', scope: 'tenant' }, resourceType: '${resourceType}' },`;
  return insertSortedSlot(
    manifest,
    surface === 'detail'
      ? MODULE_MANIFEST_SHELL_RESOURCE_DETAIL_SLOT_START
      : MODULE_MANIFEST_SHELL_TIMELINE_SLOT_START,
    surface === 'detail'
      ? MODULE_MANIFEST_SHELL_RESOURCE_DETAIL_SLOT_END
      : MODULE_MANIFEST_SHELL_TIMELINE_SLOT_END,
    [contribution],
    (candidate) => candidate.endsWith(','),
  );
};

export const planResourceProviderScaffold = async (
  workspaceRoot: string,
  config: ResourceProviderScaffoldConfig,
): Promise<ScaffoldPlan<ResourceProviderScaffoldResult>> => {
  const resource = requireCanonicalSlug(config.resource, 'resource');
  const vertical = await discoverOntosModule(workspaceRoot, config.vertical);
  const name = providerName(resource, config.surface);
  const group = toCamelCase(name);
  const contractPath = resolveContainedPath(vertical.directory, 'shared', 'apis', `${name}.ts`);
  const readPath = resolveContainedPath(vertical.directory, 'src', 'api', `${name}.read.ts`);
  const clientPath = resolveContainedPath(vertical.directory, 'src', 'api', `${name}-client.ts`);
  const serverPath = resolveContainedPath(vertical.directory, 'api', `${name}-read-server.ts`);
  const mutations: Mutation[] = [
    await createMutation(contractPath, renderContract(vertical, resource, config.surface)),
    await createMutation(readPath, renderRead(vertical, resource, config.surface)),
    await createMutation(
      clientPath,
      renderApiClient(name)
        .replace('// @generated by OntOS Codesmith module-api v1', generatedHeader)
        .replace('client.reads.execute', `client.${group}.execute`),
    ),
    await createMutation(serverPath, renderServer(name, group)),
  ];
  const boundaryPath = resolveContainedPath(
    vertical.directory,
    'api',
    'auth',
    'action-principal.ts',
  );
  if (!(await pathExists(boundaryPath))) {
    const boundary = await planActionBoundaryScaffold(workspaceRoot, { vertical: vertical.slug });
    mutations.push(...boundary.mutations);
  }
  const serverSupportPath = resolveContainedPath(
    vertical.directory,
    'api',
    'auth',
    'resource-provider-server.ts',
  );
  if (!(await pathExists(serverSupportPath))) {
    mutations.push(await createMutation(serverSupportPath, renderServerSupport()));
  }
  const manifest = patchManifest(vertical, resource, config.surface);
  const registration = insertSortedSlot(
    vertical.registrationContent,
    MODULE_REGISTRATION_API_SLOT_START,
    MODULE_REGISTRATION_API_SLOT_END,
    [`'${name}': () => import('./src/api/${name}-client.ts'),`],
    (candidate) => candidate.endsWith(','),
  );
  const manifestMutation = updateMutation(
    vertical.manifestPath,
    vertical.manifestContent,
    manifest,
  );
  const registrationMutation = updateMutation(
    vertical.registrationPath,
    vertical.registrationContent,
    registration,
  );
  if (manifestMutation !== undefined) mutations.push(manifestMutation);
  if (registrationMutation !== undefined) mutations.push(registrationMutation);
  ensureUniqueMutationPaths(mutations);
  return { mutations, result: { clientPath, contractPath, readPath, serverPath } };
};

export default createCodesmithGenerator(planResourceProviderScaffold);
