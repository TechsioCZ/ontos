import { Schema } from 'effect';
import { expect, it } from 'effect-rstest';

import { publicProposalResultSchemaName, upgradeActionHttpForbiddenContract } from '../action-http/proposal.mts';

const action = 'apply-command';
const moduleId = 'demo.fixture';
const factoryModule = '@app/shared-contracts/problem-details';
const nativeResult = 'ApplyCommandResultSchema';
const result = Schema.Struct({
  entityIds: Schema.Array(Schema.String.pipe(Schema.brand('FixtureEntityId'))),
  revision: Schema.Int,
});
const permissionCode = 'action_permission_denied';
const approvalCode = 'action_approval_required';
const header = `// @generated by OntOS Codesmith Action HTTP v1
// @ontos-action-http-owner ${moduleId}
// @ontos-action-http-slug ${action}
`;
const source = () => `${header}import { makeProblemDetailsSchema } from '${factoryModule}';
import { HttpApiEndpoint, Schema } from '@modern-js/bff-effect/effect-client';
import { ApplyCommandResultSchema } from '../actions/apply-command.ts';
export const ApplyCommandActionForbiddenProblemSchema = makeProblemDetailsSchema(
  'ApplyCommandActionForbiddenProblem', 403,
  { code: Schema.Literals(['${permissionCode}', 'fixture_forbidden']) },
);
export const ObservationSchema = Schema.Struct({ state: Schema.String });
export const ApplyCommandResponseSchema = Schema.Struct({
  ...ApplyCommandResultSchema.fields,
  observation: Schema.optionalKey(ObservationSchema),
});
const endpoint = HttpApiEndpoint.post('execute', '/fixture/actions/apply-command', {
  success: ApplyCommandResponseSchema,
});
`;
const upgrade = (content: string) => upgradeActionHttpForbiddenContract({ action, content, moduleId });
const responseBase = (content: string) => publicProposalResultSchemaName(content, action, 'fixture', result);

it('adds exactly the approval refusal while preserving owner response and custom forbidden codes, idempotently', () => {
  const original = source();
  const updated = upgrade(original);
  expect(updated).toBe(original.replace(`'${permissionCode}'`, `'${approvalCode}', '${permissionCode}'`));
  expect(upgrade(updated)).toBe(updated);
  expect(responseBase(updated)).toBe(nativeResult);
});

it('refuses foreign or type-only factories, wrong identity/status and unclosed or dynamic code vocabularies', () => {
  const original = source();
  for (const invalid of [
    original.replace(factoryModule, 'foreign-problem-factory'),
    original.replace('import { makeProblemDetailsSchema }', 'import type { makeProblemDetailsSchema }'),
    original.replace('import { makeProblemDetailsSchema }', 'import { fakeFactory as makeProblemDetailsSchema }'),
    original.replace("Problem', 403,", "Problem', 422,"),
    original.replace("Problem', 403,", "OtherProblem', 403,"),
    original.replace(`'${permissionCode}'`, 'dynamicCode'),
    original.replace(`'${permissionCode}',`, `'${permissionCode}', ...otherCodes,`),
    original.replace(`'${permissionCode}'`, `'${permissionCode}', '${permissionCode}'`),
    original.replace('Schema.Literals', 'ForeignSchema.Literals'),
    original.replace('import { HttpApiEndpoint, Schema }', 'import type { HttpApiEndpoint, Schema }'),
    original.replace(header, header.replace(moduleId, 'other.owner')),
  ]) {
    expect(() => upgrade(invalid)).toThrow();
  }
});

it('refuses response extensions that replace native fields, require observations, escape the native result or repeat fields', () => {
  const original = source();
  for (const invalid of [
    original.replace('observation:', 'revision:'),
    original.replace('Schema.optionalKey(ObservationSchema)', 'ObservationSchema'),
    original.replace('...ApplyCommandResultSchema.fields', '...ForeignResultSchema.fields'),
    original.replace("from '../actions/apply-command.ts'", "from '../actions/other.ts'"),
    original.replace('observation: Schema.optionalKey(ObservationSchema),', '...otherFields,'),
    original.replace(
      'observation: Schema.optionalKey(ObservationSchema),',
      'observation: Schema.optionalKey(ObservationSchema), observation: Schema.optionalKey(ObservationSchema),',
    ),
    original.replace('Schema.Struct({\n  ...', 'OtherSchema.Struct({\n  ...'),
  ]) {
    expect(() => responseBase(invalid)).toThrow();
  }
});
