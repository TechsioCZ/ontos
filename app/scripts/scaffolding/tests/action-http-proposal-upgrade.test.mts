/**
 * The proposal-only upgrade is a surgical transport migration, so these cases pin what it must never
 * touch: owner domain semantics, owner recovery literals, owner header decoding and owner client
 * composition. Each source text is a compact stand-in for a real endpoint that already carries those
 * decisions, and each expectation is the exact edited text — not a "contains" check that would also
 * pass after a full re-render.
 */
import { NodeServices } from '@effect/platform-node';
import { Effect, Predicate, Schema } from 'effect';
import { expect, it } from 'effect-rstest';
import { mkdtemp, readFile } from 'node:fs/promises';
import { tmpdir } from 'node:os';
import path from 'node:path';

import {
  inspectAction,
  isProposableActionDeclaration,
  validateActionSources,
  validatePublicActionSchemas,
} from '../action-http/scaffold.mts';
import { runScaffoldEffect } from '../cli.mts';
import {
  formatActionHttpProposalMutations,
  planActionHttpProposalArtifacts,
  planActionHttpProposalBaselineMutations,
  upgradeActionHttpProposalClient,
  upgradeActionHttpProposalContract,
  upgradeActionHttpProposalServer,
} from '../action-http/proposal.mts';
import { write } from './fixture-files.mts';
import { linkFixtureDependencies, withCreatedFixture } from './fixture-ownership.mts';
import type { OntosVerticalMetadata } from '../shared.mts';

const appRoot = path.resolve(import.meta.dirname, '../../..');
const ACTION = 'assert-size-equivalence';
const APP_ID = 'catalog';
const MODULE_ID = 'commerce.catalog';
const OWNER_SLUG = 'catalog';
const PROPOSAL_IMPORT = "import { ActionProposalAcceptedSchema } from '@app/core-runtime/http/action-proposal';";
const PROPOSAL_EXPORT = "export { ActionProposalAcceptedSchema } from '@app/core-runtime/http/action-proposal';";
const REGISTRATION_PROPERTY = '    registration: assertSizeEquivalenceAction,\n';
const RESULT_SUCCESS_PROPERTY = 'success: AssertSizeEquivalenceResultSchema,';
const CONTRACT_PATH = '/w/action.ts';
const SERVER_PATH = '/w/action-server.ts';
const CLIENT_PATH = '/w/action-client.ts';
const PROPOSAL_INTENT_DOC = [
  '  /**',
  '   * O80: ask for a parked proposal instead of an immediate write. Omitted means the ordinary run, so a',
  "   * refusal is never turned into a proposal on the caller's behalf.",
  '   */',
  "  readonly intent?: 'propose';",
].join('\n');

const vertical = (): OntosVerticalMetadata => ({
  appId: APP_ID,
  directory: `/workspace/verticals/${OWNER_SLUG}`,
  manifestContent: '',
  manifestPath: `/workspace/verticals/${OWNER_SLUG}/vertical.manifest.ts`,
  moduleId: MODULE_ID,
  packageContent: '{}',
  packageJson: {},
  packageName: `@app/${OWNER_SLUG}`,
  packagePath: `/workspace/verticals/${OWNER_SLUG}/package.json`,
  registrationContent: '',
  registrationPath: `/workspace/verticals/${OWNER_SLUG}/vertical.registration.ts`,
  slug: OWNER_SLUG,
  topologyEntry: {},
});

/**
 * A catalog contract that maps one domain error onto four HTTP problems and names its own recovery
 * resolution. The full scaffold rewrites all of it; the proposal upgrade must not.
 */
const contractSource = (): string =>
  `// @generated by OntOS Codesmith Action HTTP v1
// @ontos-action-http-owner ${MODULE_ID}
// @ontos-action-http-slug ${ACTION}
import { makeProblemDetailsSchema, makeRetryableProblemDetailsSchema } from '@app/shared-contracts/problem-details';
import { HttpApi, HttpApiEndpoint, HttpApiGroup, Schema } from '@modern-js/bff-effect/effect-client';
import { HttpApiMiddleware } from 'effect/http-api';
import {
  AssertSizeEquivalencePayloadSchema,
  AssertSizeEquivalenceResultSchema,
} from '../actions/${ACTION}.ts';

export { AssertSizeEquivalencePayloadSchema } from '../actions/${ACTION}.ts';

export const AssertSizeEquivalenceActionNotFoundProblemSchema = makeProblemDetailsSchema(
  'AssertSizeEquivalenceActionNotFoundProblem',
  404,
  { code: Schema.Literals(['action_invocation_not_found', 'size_equivalence_not_found']) },
);
export const AssertSizeEquivalenceActionConflictProblemSchema = makeProblemDetailsSchema(
  'AssertSizeEquivalenceActionConflictProblem',
  409,
  {
    code: Schema.Literals([
      'action_request_hash_conflict',
      'action_invocation_state_invalid',
      'size_equivalence_conflict',
    ]),
  },
);
export const AssertSizeEquivalenceActionAlreadyCommittedProblemSchema = makeProblemDetailsSchema(
  'AssertSizeEquivalenceActionAlreadyCommittedProblem',
  409,
  {
    code: Schema.Literal('action_already_committed'),
    invocationId: Schema.String,
    resolution: Schema.Literal('RECOVER_ASSERT_SIZE_EQUIVALENCE'),
    retryCommand: Schema.Literal(false),
  },
);

export class AssertSizeEquivalenceActionSchemaErrorMiddleware extends HttpApiMiddleware.Service<AssertSizeEquivalenceActionSchemaErrorMiddleware>()(
  'catalog/AssertSizeEquivalenceActionSchemaErrorMiddleware',
  { error: AssertSizeEquivalenceActionConflictProblemSchema },
) {}

const actionErrors = [AssertSizeEquivalenceActionConflictProblemSchema] as const;

export const AssertSizeEquivalenceActionApi = HttpApi.make('AssertSizeEquivalenceActionApi').add(
  HttpApiGroup.make('assertSizeEquivalenceAction')
    .add(
      HttpApiEndpoint.post('execute', '/${APP_ID}/actions/${ACTION}', {
        error: actionErrors,
        payload: Schema.toEncoded(AssertSizeEquivalencePayloadSchema),
        success: AssertSizeEquivalenceResultSchema,
      }),
    )
    .middleware(AssertSizeEquivalenceActionSchemaErrorMiddleware),
);
`;

/** An assortment-style server that reads the idempotency key from the handler headers. */
const serverSource = (): string =>
  `// @generated by OntOS Codesmith Action HTTP v1
// @ontos-action-http-owner ${MODULE_ID}
// @ontos-action-http-slug ${ACTION}
import { Effect, HttpApiBuilder, Layer } from '@modern-js/bff-effect/effect-edge';
import type { HttpServerRequest } from 'effect/http';
import { Redacted, Schema } from 'effect';
import { assortmentApi } from '../shared/api.ts';
import { assertSizeEquivalenceAction } from '../src/actions/${ACTION}.action.ts';
import { bindActionHttpRunner } from './action-http-runner.ts';
import {
  assertSizeEquivalenceActionProblem,
  assertSizeEquivalenceActionSchemaErrorLive,
  mapAssertSizeEquivalenceActionProblem,
} from './${ACTION}-action-problems.ts';

const runActionHttp = bindActionHttpRunner({
  authentication: assertSizeEquivalenceActionProblem.authentication,
  unavailable: () => assertSizeEquivalenceActionProblem.unavailable('operation_context_unavailable'),
});

const execute = Effect.fn('AssertSizeEquivalenceActionServer.execute')(function* executeAssertSizeEquivalence(
  payload: typeof assertSizeEquivalenceAction.descriptor.payloadSchema.Encoded,
  idempotencyKey: string | undefined,
  request: HttpServerRequest.HttpServerRequest,
) {
  const correlationId = request.headers['x-correlation-id'];
  const decoded = yield* Schema.decodeEffect(assertSizeEquivalenceAction.descriptor.payloadSchema)(payload).pipe(
    Effect.mapError(assertSizeEquivalenceActionProblem.invalid),
  );
  return yield* runActionHttp({
    endpointHeaders: { idempotencyKey, traceId: request.headers['x-trace-id'] },
    internalProblem: assertSizeEquivalenceActionProblem.internal,
    invalidCorrelationProblem: assertSizeEquivalenceActionProblem.invalid,
    mapError: mapAssertSizeEquivalenceActionProblem,
    payload: decoded,
    registration: assertSizeEquivalenceAction,
    requestHeaders: {
      authorization: Redacted.make(request.headers['authorization']),
      'x-correlation-id': correlationId,
    },
  });
});

export const assertSizeEquivalenceActionApiLive = HttpApiBuilder.group(
  assortmentApi,
  'assertSizeEquivalenceAction',
  (handlers) =>
    handlers.handle('execute', ({ headers, payload, request }) =>
      execute(payload, headers['idempotency-key'], request),
    ),
).pipe(Layer.provide(assertSizeEquivalenceActionSchemaErrorLive));
`;

/**
 * An assortment-style client whose transport object is written on one line and whose execute call
 * still sends the endpoint headers itself. The proposal intent is added inside that object; the
 * headers argument stays exactly where the owner put it.
 */
const clientSource = (): string =>
  `// @generated by OntOS Codesmith Action HTTP v1
// @ontos-action-http-owner ${MODULE_ID}
// @ontos-action-http-slug ${ACTION}
import { makeGovernedEffectBffClient } from '@app/shared-contracts/client-runtime';
import { Effect, Redacted, Schema } from 'effect';
import { AssertSizeEquivalenceActionApi, AssertSizeEquivalencePayloadSchema } from '../../shared/apis/${ACTION}-action.ts';
import type { AssertSizeEquivalencePayload } from '../../shared/actions/${ACTION}.ts';
import { operationGateway } from './action-gateway.ts';

const traceIdOption = 'traceId' as const;

export interface AssertSizeEquivalenceActionClientOptions {
  readonly baseUrl?: string | URL;
  readonly compositionRevision?: string;
  readonly gateway?: Parameters<typeof operationGateway.invoke>[1];
  readonly idempotencyKey: string;
  readonly [traceIdOption]?: string;
}

const makeClient = ({ credential, options, requestCorrelation }: MakeClientOptions) =>
  makeGovernedEffectBffClient(
    { api: AssertSizeEquivalenceActionApi, credential, defaultApiPrefix: '/assortment-api', requestCorrelation },
    options,
  );

export const executeAssertSizeEquivalenceWithAuthorization = (
  payload: AssertSizeEquivalencePayload,
  ...[credential, requestCorrelation, options]: AuthorizedInvocation
) =>
  Schema.encodeUnknownEffect(AssertSizeEquivalencePayloadSchema)(payload).pipe(
    Effect.flatMap((encoded) =>
      makeClient({ credential: Redacted.make(credential), options, requestCorrelation }).pipe(
        Effect.flatMap((client) =>
          client.assertSizeEquivalenceAction.execute({
            headers: { 'idempotency-key': options.idempotencyKey },
            payload: encoded,
          }),
        ),
      ),
    ),
  );
`;

const upgradeContract = (content: string): string =>
  upgradeActionHttpProposalContract({ action: ACTION, appId: APP_ID, content, moduleId: MODULE_ID });

const upgradeServer = (content: string): string =>
  upgradeActionHttpProposalServer({ action: ACTION, content, moduleId: MODULE_ID });

const upgradeClient = (content: string): string =>
  upgradeActionHttpProposalClient({ action: ACTION, content, moduleId: MODULE_ID });

const plan = (
  content: { readonly client: string; readonly contract: string; readonly server: string },
  proposalAccepted: boolean,
) =>
  planActionHttpProposalArtifacts({
    action: ACTION,
    appId: APP_ID,
    artifacts: content,
    moduleId: MODULE_ID,
    proposalAccepted,
  });

/** Runs a transform expected to fail closed and returns its failure message. */
const failureOf = (evaluate: () => string): string => {
  try {
    evaluate();
  } catch (error) {
    return Predicate.hasProperty(error, 'message') && Schema.is(Schema.String)(error.message)
      ? error.message
      : 'no failure message';
  }
  return '';
};

it.live(
  'routes --proposal-only to the Action HTTP command only',
  Effect.fn(function* proposalOnlyFlagRouting() {
    // A missing vertical fails before any write in both modes; the flag is rejected at parse time on
    // every other scaffold command, so it can never silently switch another generator's behaviour.
    const accepted = yield* Effect.exit(
      runScaffoldEffect('action-http', ['--vertical', 'missing', '--action', ACTION, '--proposal-only'], {
        workspaceRoot: '/nonexistent-workspace',
      }),
    );
    expect(String(accepted)).not.toContain('unknown flag');
    const rejected = yield* Effect.exit(
      runScaffoldEffect('action', ['--vertical', 'missing', '--action', ACTION, '--proposal-only'], {
        workspaceRoot: '/nonexistent-workspace',
      }),
    );
    expect(String(rejected)).toContain('unknown flag --proposal-only');
  }, Effect.provide(NodeServices.layer)),
);

it('adds only the 202 success entry, its import and its re-export to a custom contract', () => {
  const source = contractSource();
  const upgraded = upgradeContract(source);
  const expected = source
    .replace(
      "import { makeProblemDetailsSchema, makeRetryableProblemDetailsSchema } from '@app/shared-contracts/problem-details';",
      `import { makeProblemDetailsSchema, makeRetryableProblemDetailsSchema } from '@app/shared-contracts/problem-details';\n${PROPOSAL_IMPORT}`,
    )
    .replace(
      `export { AssertSizeEquivalencePayloadSchema } from '../actions/${ACTION}.ts';`,
      `export { AssertSizeEquivalencePayloadSchema } from '../actions/${ACTION}.ts';\n${PROPOSAL_EXPORT}`,
    )
    .replace(RESULT_SUCCESS_PROPERTY, 'success: [ActionProposalAcceptedSchema, AssertSizeEquivalenceResultSchema],');
  expect(upgraded).toBe(expected);
  // Owner domain semantics survive byte for byte: the four-way problem mapping and its recovery name.
  expect(upgraded).toContain("'size_equivalence_not_found'");
  expect(upgraded).toContain("'size_equivalence_conflict'");
  expect(upgraded).toContain("resolution: Schema.Literal('RECOVER_ASSERT_SIZE_EQUIVALENCE'),");
  // The 202 is a success entry, never a Problem Details body and never a mapper branch.
  expect(upgraded).not.toContain('ActionProposalAcceptedProblem');
});

it('is idempotent on the source it produced', () => {
  const contract = upgradeContract(contractSource());
  const server = upgradeServer(serverSource());
  const client = upgradeClient(clientSource());
  expect(upgradeContract(contract)).toBe(contract);
  expect(upgradeServer(server)).toBe(server);
  expect(upgradeClient(client)).toBe(client);
  expect(plan({ client, contract, server }, true).changed).toEqual([]);
});

it('declares the success contract after request headers and keeps owner header decoding', () => {
  const source = serverSource();
  const upgraded = upgradeServer(source);
  const expected = source.replace('    },\n  });', "    },\n    successContract: 'result-or-proposal',\n  });");
  expect(upgraded).toBe(expected);
  // The owner's own idempotency header plumbing and handler argument stay exactly as written.
  expect(upgraded).toContain("endpointHeaders: { idempotencyKey, traceId: request.headers['x-trace-id'] },");
  expect(upgraded).toContain("execute(payload, headers['idempotency-key'], request),");
});

it('offers the optional propose intent from the client without touching its composition', () => {
  const source = clientSource();
  const upgraded = upgradeClient(source);
  expect(upgraded).toContain(`${PROPOSAL_INTENT_DOC}\n  readonly [traceIdOption]?: string;`);
  expect(upgraded).toContain(
    "{ api: AssertSizeEquivalenceActionApi, credential, defaultApiPrefix: '/assortment-api', intent: options.intent, requestCorrelation },",
  );
  // The owner's execute call keeps sending its own endpoint headers and payload.
  expect(upgraded).toContain("headers: { 'idempotency-key': options.idempotencyKey },");
  expect(upgraded).toContain('payload: encoded,');
  // The header itself stays the governed runtime's job.
  expect(upgraded).not.toContain('x-action-intent');
});

it('adds intent to a client whose options have only ordinary named properties', () => {
  const source = clientSource().replace('readonly [traceIdOption]?: string;', 'readonly traceId?: string;');
  expect(source).not.toContain('readonly [traceIdOption]');
  const upgraded = upgradeClient(source);
  expect(upgraded).toContain(PROPOSAL_INTENT_DOC);
  expect(upgraded).toContain('readonly traceId?: string;');
  expect(upgraded).toContain('intent: options.intent, requestCorrelation');
  expect(upgradeClient(upgraded)).toBe(upgraded);
});

it('rejects an existing success array with extra or duplicate proposal arms', () => {
  for (const arms of [
    'ActionProposalAcceptedSchema, AssertSizeEquivalenceResultSchema, Schema.String',
    'ActionProposalAcceptedSchema, ActionProposalAcceptedSchema',
  ]) {
    const source = contractSource().replace(RESULT_SUCCESS_PROPERTY, `success: [${arms}],`);
    expect(failureOf(() => upgradeContract(source))).toContain('unsupported success union');
  }
});

it('leaves a non-proposable or ephemeral Action byte-identical', () => {
  const artifacts = { client: clientSource(), contract: contractSource(), server: serverSource() };
  const skipped = plan(artifacts, false);
  expect(skipped.proposalAccepted).toBe(false);
  expect(skipped.changed).toEqual([]);
  expect(skipped.artifacts).toEqual(artifacts);
  const mutations = planActionHttpProposalBaselineMutations({
    action: ACTION,
    appId: APP_ID,
    artifacts,
    files: {
      client: { content: artifacts.client, path: '/w/client.ts' },
      contract: { content: artifacts.contract, path: '/w/contract.ts' },
      server: { content: artifacts.server, path: '/w/server.ts' },
    },
    moduleId: MODULE_ID,
    proposalAccepted: false,
  });
  expect(mutations.mutations).toEqual([]);
});

it('plans mutations only for the three owned endpoint artifacts', () => {
  const artifacts = { client: clientSource(), contract: contractSource(), server: serverSource() };
  const { mutations, plan: applied } = planActionHttpProposalBaselineMutations({
    action: ACTION,
    appId: APP_ID,
    artifacts,
    files: {
      client: { content: artifacts.client, path: CLIENT_PATH },
      contract: { content: artifacts.contract, path: CONTRACT_PATH },
      server: { content: artifacts.server, path: SERVER_PATH },
    },
    moduleId: MODULE_ID,
    proposalAccepted: true,
  });
  expect(applied.changed).toEqual(['contract', 'server', 'client']);
  expect(mutations.map((mutation) => mutation.path)).toEqual([CONTRACT_PATH, SERVER_PATH, CLIENT_PATH]);
  // A problem mapper, a barrel or a package file is never planned by this mode.
  expect(mutations.some((mutation) => mutation.path.includes('problems'))).toBe(false);
  expect(mutations.some((mutation) => mutation.path.includes('package.json'))).toBe(false);
});

it.live(
  'formats planned mutations exactly as Codesmith would before writing them',
  Effect.fn(function* formatsPlannedMutations() {
    const artifacts = { client: clientSource(), contract: contractSource(), server: serverSource() };
    const { mutations, plan: applied } = planActionHttpProposalBaselineMutations({
      action: ACTION,
      appId: APP_ID,
      artifacts,
      files: {
        client: { content: artifacts.client, path: CLIENT_PATH },
        contract: { content: artifacts.contract, path: CONTRACT_PATH },
        server: { content: artifacts.server, path: SERVER_PATH },
      },
      moduleId: MODULE_ID,
      proposalAccepted: true,
    });
    const formatted = yield* formatActionHttpProposalMutations(mutations);
    expect(formatted.map((mutation) => mutation.path)).toEqual(mutations.map((mutation) => mutation.path));
    const contentOf = (pathName: string): string => {
      const mutation = formatted.find((entry) => entry.path === pathName);
      return mutation === undefined || mutation.kind === 'delete' ? '' : mutation.content;
    };
    // The contract and server edits are already canonical, so formatting is a no-op there.
    expect(contentOf(CONTRACT_PATH)).toBe(applied.artifacts.contract);
    expect(contentOf(SERVER_PATH)).toBe(applied.artifacts.server);
    // A one-line client transport object that no longer fits is reflowed, keeping the new intent.
    expect(contentOf(CLIENT_PATH)).toContain('intent: options.intent,');
    // Formatting is itself idempotent, so a caller can write the planned text directly.
    expect(yield* formatActionHttpProposalMutations(formatted)).toEqual(formatted);
  }),
);

it('fails closed on ambiguous or unsupported source shapes instead of overwriting them', () => {
  const ambiguousContract = contractSource().replace(
    RESULT_SUCCESS_PROPERTY,
    'success: Schema.Union([AssertSizeEquivalenceResultSchema, Schema.Struct({})]),',
  );
  expect(failureOf(() => upgradeContract(ambiguousContract))).toContain(
    'success schema is not one named result schema',
  );
  const repeatedEndpoint = contractSource().replace(
    'export const AssertSizeEquivalenceActionApi = HttpApi.make(',
    `export const duplicate = HttpApiEndpoint.post('execute', '/${APP_ID}/actions/${ACTION}', { success: Schema.String });\nexport const AssertSizeEquivalenceActionApi = HttpApi.make(`,
  );
  expect(failureOf(() => upgradeContract(repeatedEndpoint))).toContain('more than once');
  expect(failureOf(() => upgradeServer(serverSource().replace(REGISTRATION_PROPERTY, '')))).toContain(
    'lacks registration',
  );
  expect(
    failureOf(() =>
      upgradeServer(
        serverSource().replace(
          REGISTRATION_PROPERTY,
          "    registration: assertSizeEquivalenceAction,\n    successContract: 'result-only',\n",
        ),
      ),
    ),
  ).toContain('already declares another success contract');
  expect(
    failureOf(() =>
      upgradeClient(clientSource().replace('readonly idempotencyKey: string;', "readonly intent?: 'run';")),
    ),
  ).toContain('already declares an unsupported intent option');
  expect(
    failureOf(() =>
      upgradeClient(
        clientSource().replace(
          "defaultApiPrefix: '/assortment-api', requestCorrelation",
          "defaultApiPrefix: '/assortment-api'",
        ),
      ),
    ),
  ).toContain('lacks requestCorrelation');
  const foreignOwner = contractSource().replace(
    `// @ontos-action-http-owner ${MODULE_ID}`,
    '// @ontos-action-http-owner other.owner',
  );
  expect(failureOf(() => upgradeContract(foreignOwner))).toContain('is not the generated Action HTTP artifact');
});

it('fails the whole plan before any artifact is produced', () => {
  const artifacts = {
    client: clientSource(),
    contract: contractSource(),
    server: serverSource().replace(REGISTRATION_PROPERTY, ''),
  };
  expect(failureOf(() => plan(artifacts, true).changed.join(','))).toContain('lacks registration');
});

/** A registration source that only ever exports through a typed alias, never one constructor call. */
const registrationSource = (accessDeclaration?: string): string => {
  const declaration = accessDeclaration === undefined ? '' : `  accessDeclaration: ${accessDeclaration},\n`;
  return `import { Schema } from 'effect';

const descriptor = {
${declaration}  actionKey: '${MODULE_ID}.${ACTION}',
  domainErrorSchema: Schema.Union([Schema.TaggedError('FixtureConflict')({ code: Schema.String })]),
  idempotency: 'required',
  owningModuleKey: '${MODULE_ID}',
  payloadSchema: Schema.Struct({ rate: Schema.Number }),
};

const registered = { descriptor };
export const assertSizeEquivalenceAction: typeof registered = registered;
`;
};

it.live(
  'accepts a typed exported registration and derives proposal acceptance from its declaration',
  Effect.fn(function* typedExportedRegistration() {
    yield* withCreatedFixture(Effect.promise(() => mkdtemp(path.join(tmpdir(), 'ontos-action-proposal-'))))(
      Effect.fn(function* registrationFixture(root) {
        yield* linkFixtureDependencies(root, appRoot, { effect: 'node_modules/effect' });
        yield* write(
          root,
          'proposable.ts',
          registrationSource("{ ephemeral: false, modes: ['run', 'propose', 'approve'] }"),
        );
        yield* write(root, 'ephemeral.ts', registrationSource("{ ephemeral: true, modes: ['run', 'propose'] }"));
        yield* write(root, 'run-only.ts', registrationSource());
        const inspectFixture = (name: string) => inspectAction(path.join(root, name), 'assertSizeEquivalenceAction');
        const proposable = yield* inspectFixture('proposable.ts');
        expect(proposable.descriptor.actionKey).toBe(`${MODULE_ID}.${ACTION}`);
        expect(isProposableActionDeclaration(proposable.descriptor.accessDeclaration)).toBe(true);
        // An ephemeral declaration is run-only by construction (O22), even when it claims `propose`.
        const ephemeral = yield* inspectFixture('ephemeral.ts');
        expect(isProposableActionDeclaration(ephemeral.descriptor.accessDeclaration)).toBe(false);
        // A declaration older than the carrier carries no declaration at all and can never propose.
        const runOnly = yield* inspectFixture('run-only.ts');
        expect(isProposableActionDeclaration(runOnly.descriptor.accessDeclaration)).toBe(false);
      }),
    );
  }),
);

it.live(
  'validates the real owner markers and re-exported public schemas the proposal mode relies on',
  Effect.fn(function* validatesOwnerAndSchemaExports() {
    yield* withCreatedFixture(Effect.promise(() => mkdtemp(path.join(tmpdir(), 'ontos-action-proposal-schemas-'))))(
      Effect.fn(function* schemaFixture(root) {
        yield* linkFixtureDependencies(root, appRoot, { effect: 'node_modules/effect' });
        yield* write(
          root,
          'shared/actions/rate-schemas.ts',
          `import { Schema } from 'effect';
export const InputSchema = Schema.Struct({ rate: Schema.Number });
export const OutputSchema = Schema.Struct({ accepted: Schema.Boolean });
`,
        );
        const publicActionPath = path.join(root, 'shared/actions/assert-size-equivalence.ts');
        yield* write(
          root,
          'shared/actions/assert-size-equivalence.ts',
          `export {
  InputSchema as AssertSizeEquivalencePayloadSchema,
  OutputSchema as AssertSizeEquivalenceResultSchema,
} from './rate-schemas.ts';
`,
        );
        // The private source spells its registration through a typed alias, never one constructor call.
        const privateSource = `// @ontos-action-owner ${MODULE_ID}
// @ontos-action-slug ${ACTION}
const registered = {};
export const assertSizeEquivalenceAction: typeof registered = registered;
`;
        const publicSource = yield* Effect.promise(() => readFile(publicActionPath, 'utf-8'));
        yield* validateActionSources(vertical(), ACTION, privateSource, publicSource);
        yield* validatePublicActionSchemas(publicActionPath, 'AssertSizeEquivalence');
      }),
    );
  }),
);

it.live(
  'rejects a public contract that imports private implementation source',
  Effect.fn(function* rejectsPrivateImplementationImport() {
    const publicSource = `export { Something } from '../src/api/action-gateway.ts';\n`;
    const exit = yield* Effect.exit(
      validateActionSources(
        vertical(),
        ACTION,
        `// @ontos-action-owner ${MODULE_ID}\n// @ontos-action-slug ${ACTION}\n`,
        publicSource,
      ),
    );
    expect(String(exit)).toContain('private implementation source');
  }),
);
