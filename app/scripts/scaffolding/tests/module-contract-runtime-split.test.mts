import { parseSync } from 'oxc-parser';
import { describe, expect, it } from 'effect-rstest';
import {
  bindBackendRuntimeApi,
  bindBackendRuntimeWorker,
  splitRuntimeOwnerSources,
} from '../module-contract/runtime-split.mts';

const header =
  '// @generated by OntOS Codesmith Module Contract v1\n// @ontos-deployment-app-id fixture\n// @ontos-module-id fixture.module\n';
const manifest = `${header}
import { defineOntosModuleManifest } from '@app/core-runtime';
// <generated-module-manifest-imports>
import { RecordsPage } from './src/routes/[lang]/records/page.tsx';
// </generated-module-manifest-imports>
type Placement = { readonly family: string };
const moduleKey = 'fixture.module';
const family: Placement = { family: 'records' };
const contribution = (value: { readonly module: string; readonly placement: Placement }) => value;
export const fixtureManifest = defineOntosModuleManifest({
  activation: { defaultState: 'inactive', scope: 'tenant' },
  module: { id: moduleKey },
  requirements: { schemaVersion: '1', intrinsic: ['native-dependency'], coreCapabilities: [], operations: [] },
  publicSurface: {
    actions: [
      // <generated-module-manifest-actions>
      // </generated-module-manifest-actions>
    ],
    api: {
      // <generated-module-manifest-apis>
      // </generated-module-manifest-apis>
    },
    components: { records: RecordsPage },
    events: [{ topic: 'fixture.changed' }],
    reports: [],
    resourceTypes: [{ key: 'fixture.record' }],
    search: [{ placement: family }],
    businessPermissions: [{ key: 'fixture.private' }],
    mcp: { name: 'fixture' },
    shellContributions: { pages: [contribution({ module: moduleKey, placement: family })] },
  },
});`;
const registration = `${header}
import { defineVerticalRuntimeRegistration } from '@app/core-runtime';
import { fixtureManifest } from './vertical.manifest.ts';
// <generated-module-registration-imports>
// </generated-module-registration-imports>
export const fixtureRegistration = defineVerticalRuntimeRegistration({
  actions: [],
  manifest: fixtureManifest,
  reads: [
    // <generated-module-registration-reads>
    // </generated-module-registration-reads>
  ],
  outboxWorkers: [
    // <generated-module-registration-workers>
    // </generated-module-registration-workers>
  ],
  entrypoints: { pages: { records: () => import('./src/routes/[lang]/records/page.tsx') } },
});`;
const apiRoot = `import { fixtureRegistration as owner } from '../vertical.registration.ts';
const runtime = makeReadRuntimeLive(marker, owner);`;
const input = { apiRoot, appId: 'fixture', manifest, moduleId: 'fixture.module', prefix: 'fixture', registration };

describe('shared owner runtime split', () => {
  it('moves real metadata dependencies and preserves every full frontend publication', () => {
    const result = splitRuntimeOwnerSources(input);
    expect(result.declaration).not.toContain('RecordsPage');
    expect(result.declaration).not.toContain('/src/routes/');
    expect(result.declaration).toContain('type Placement');
    expect(result.declaration).toContain('const moduleKey');
    expect(result.declaration).toContain('const contribution');
    expect(result.declaration).toContain("intrinsic: ['native-dependency']");
    expect(result.manifest).toContain('records: RecordsPage');
    expect(result.manifest).toContain("topic: 'fixture.changed'");
    expect(result.manifest).toContain("key: 'fixture.record'");
    expect(result.manifest).toContain("key: 'fixture.private'");
    expect(result.manifest).toContain("mcp: { name: 'fixture' }");
    expect(result.manifest).toContain("defaultState: 'inactive'");
    expect(result.manifest).toContain(
      "import { fixtureRuntimeManifest, family } from './vertical.runtime-declaration.ts';",
    );
    expect(result.registration).toContain("records: () => import('./src/routes/[lang]/records/page.tsx')");
    expect(result.registration).not.toContain('// <generated-module-registration-imports>');
    expect(result.apiRoot).toContain('fixtureBackendRegistration as owner');
    expect(result.apiRoot).not.toContain('../vertical.registration.ts');
  });

  it('groups genuine named imports while retaining aliases and effective type-only identity', () => {
    const imported = manifest
      .replace(
        "import { defineOntosModuleManifest } from '@app/core-runtime';",
        `import { defineOntosModuleManifest, ShellPageContributionSchema as ImportedPageSchema } from '@app/core-runtime';
import type { ShellNavigationContributionSchema as ImportedNavigationSchema } from '@app/core-runtime';
import { Result as ImportedResult, Schema as ImportedSchema } from 'effect';
type ImportedNavigation = typeof ImportedNavigationSchema.Encoded;`,
      )
      .replace(
        'const contribution = (value: { readonly module: string; readonly placement: Placement }) => value;',
        'const contribution = (value: { readonly module: string; readonly placement: Placement; readonly extra?: ImportedNavigation }) => ImportedResult.getOrThrow(ImportedSchema.decodeUnknownResult(ImportedPageSchema)(value));',
      );
    const result = splitRuntimeOwnerSources({ ...input, manifest: imported });
    const imports = parseSync('runtime.ts', result.declaration, {
      astType: 'ts',
      lang: 'ts',
      sourceType: 'module',
    }).program.body.filter((statement) => statement.type === 'ImportDeclaration');
    const core = imports.filter((statement) => statement.source.value === '@app/core-runtime');
    expect(core).toHaveLength(1);
    expect(imports.filter((statement) => statement.source.value === 'effect')).toHaveLength(1);
    const specifiers = core.flatMap((statement) =>
      statement.specifiers
        .filter((specifier) => specifier.type === 'ImportSpecifier')
        .map((specifier) => ({
          imported: specifier.imported.type === 'Identifier' ? specifier.imported.name : '',
          kind: statement.importKind === 'type' ? 'type' : specifier.importKind,
          local: specifier.local.name,
        })),
    );
    expect(specifiers).toContainEqual({
      imported: 'ShellPageContributionSchema',
      kind: 'value',
      local: 'ImportedPageSchema',
    });
    expect(specifiers).toContainEqual({
      imported: 'ShellNavigationContributionSchema',
      kind: 'type',
      local: 'ImportedNavigationSchema',
    });
    expect(specifiers).toContainEqual({
      imported: 'defineVerticalRuntimeRegistration',
      kind: 'value',
      local: 'defineVerticalRuntimeRegistration',
    });
    expect(specifiers).toContainEqual({
      imported: 'VerticalRuntimeRegistrationInput',
      kind: 'type',
      local: 'VerticalRuntimeRegistrationInput',
    });
    expect(result.declaration).not.toContain('RecordsPage');
    expect(() =>
      splitRuntimeOwnerSources({
        ...input,
        manifest: imported,
        registration: registration.replace(
          "import { defineVerticalRuntimeRegistration } from '@app/core-runtime';",
          "import { defineVerticalRuntimeRegistration } from '@app/core-runtime';\nimport type { ShellPageContributionSchema as ImportedPageSchema } from '@app/core-runtime';",
        ),
      }),
    ).toThrow(/conflicting import binding/u);
    for (const binding of ['RecordsPage', '* as RecordsPage']) {
      expect(() =>
        splitRuntimeOwnerSources({
          ...input,
          manifest: manifest.replace(
            "import { RecordsPage } from './src/routes/[lang]/records/page.tsx';",
            `import ${binding} from '@app/core-runtime';`,
          ),
        }),
      ).toThrow(/default or namespace/u);
    }
  });

  it('does not silently drop unmodelled side effects', () => {
    expect(() =>
      splitRuntimeOwnerSources({ ...input, manifest: `${manifest}\nimport './initialize-publication.ts';` }),
    ).toThrow(/side.effect/u);
  });

  it('rejects a frontend implementation used by runtime metadata', () => {
    expect(() =>
      splitRuntimeOwnerSources({
        ...input,
        manifest: manifest.replace('pages: [contribution(', 'pages: [RecordsPage('),
      }),
    ).toThrow(/frontend/u);
  });

  it('refuses to bless an unrelated factory as the canonical owner', () => {
    expect(() =>
      splitRuntimeOwnerSources({
        ...input,
        manifest: manifest.replace('= defineOntosModuleManifest(', '= counterfeitManifest('),
      }),
    ).toThrow(/factory/u);
  });

  it('retains authored owner, import and trailing comments in the full views', () => {
    const annotatedManifest = `${manifest
      .replace(
        'import { defineOntosModuleManifest }',
        '// Authored import documentation\nimport { defineOntosModuleManifest }',
      )
      .replace(
        'export const fixtureManifest =',
        '/** Published owner contract. */\nexport const fixtureManifest =',
      )}\n// End of authored publication`;
    const annotatedRegistration = registration.replace(
      'export const fixtureRegistration =',
      '/** Frontend entrypoint documentation. */\nexport const fixtureRegistration =',
    );
    const result = splitRuntimeOwnerSources({
      ...input,
      manifest: annotatedManifest,
      registration: annotatedRegistration,
    });
    expect(result.manifest.startsWith(header)).toBe(true);
    expect(result.manifest).toContain('// Authored import documentation');
    expect(result.manifest).toContain('/** Published owner contract. */\nexport const fixtureManifest');
    expect(result.manifest).toContain('// End of authored publication');
    expect(result.registration).toContain(
      '/** Frontend entrypoint documentation. */\nexport const fixtureRegistration',
    );
    expect(() =>
      splitRuntimeOwnerSources({
        ...input,
        manifest: manifest.replace('export const fixtureManifest', '// @ts-expect-error\nexport const fixtureManifest'),
      }),
    ).toThrow(/compiler directives/u);
  });

  it('requires registration to retain its genuine own manifest', () => {
    expect(() =>
      splitRuntimeOwnerSources({
        ...input,
        registration: registration.replace('manifest: fixtureManifest', 'manifest: foreignManifest'),
      }),
    ).toThrow(/own manifest/u);
    expect(() =>
      splitRuntimeOwnerSources({
        ...input,
        registration: registration.replace("from './vertical.manifest.ts'", "from './foreign.manifest.ts'"),
      }),
    ).toThrow(/own manifest/u);
  });

  it('preserves explicit public owner type annotations', () => {
    const typed = manifest
      .replace(
        'import { defineOntosModuleManifest }',
        "import type { OntosModuleManifestInput } from '@app/core-runtime';\nimport { defineOntosModuleManifest }",
      )
      .replace('export const fixtureManifest =', 'export const fixtureManifest: OntosModuleManifestInput =');
    const result = splitRuntimeOwnerSources({ ...input, manifest: typed });
    expect(result.manifest).toContain('fixtureManifest: OntosModuleManifestInput =');
    expect(result.manifest).toContain('type OntosModuleManifestInput');
  });

  it('refuses to discard authored exports or reorder owner-dependent statements', () => {
    expect(() =>
      splitRuntimeOwnerSources({
        ...input,
        manifest: manifest.replace('const moduleKey =', 'export const moduleKey ='),
      }),
    ).toThrow(/exports/u);
    expect(() =>
      splitRuntimeOwnerSources({ ...input, manifest: `${manifest}\nconst ownerId = fixtureManifest.module.id;` }),
    ).toThrow(/before initialization/u);
    expect(() =>
      splitRuntimeOwnerSources({ ...input, manifest: `${manifest}\nexport default fixtureManifest;` }),
    ).toThrow(/exports/u);
  });

  it('refuses executable metadata mutation instead of changing runtime policy', () => {
    expect(() =>
      splitRuntimeOwnerSources({
        ...input,
        manifest: manifest.replace('const contribution =', 'family.family = "other";\nconst contribution ='),
      }),
    ).toThrow(/top.level/u);
    expect(() =>
      splitRuntimeOwnerSources({
        ...input,
        manifest: manifest.replace('const contribution =', 'const mutation = mutate(family);\nconst contribution ='),
      }),
    ).toThrow(/initializer calls/u);
  });

  it('preserves existing native worker entries with no full registration dependency', () => {
    const nativeWorker = `import { defineOutboxWorkerEntry, extractOutboxWorkerSubscriptions } from '@app/core-runtime/outbox/worker';
import { ultramodernApiMarker } from '../../shared/ultramodern-build.ts';
import { outboxWorkers } from '../workers/index.ts';
export const outboxWorkerEntry = defineOutboxWorkerEntry({ expectedDeployment: ultramodernApiMarker, registrations: outboxWorkers, subscriptions: extractOutboxWorkerSubscriptions(outboxWorkers) });`;
    expect(bindBackendRuntimeWorker(nativeWorker, 'fixture')).toBe(nativeWorker);
    expect(() =>
      bindBackendRuntimeWorker(
        `import { foreignRegistration } from '../../vertical.registration.ts';\n${nativeWorker}`,
        'fixture',
      ),
    ).toThrow(/binding/u);
  });

  it('retains API local aliases and is stable after binding the real backend registration', () => {
    const result = bindBackendRuntimeApi(apiRoot, 'fixture');
    expect(result).toContain('makeReadRuntimeLive(marker, owner)');
    expect(bindBackendRuntimeApi(result, 'fixture')).toBe(result);
    expect(() =>
      bindBackendRuntimeApi(apiRoot.replace('fixtureRegistration as owner', 'foreignRegistration as owner'), 'fixture'),
    ).toThrow(/foreign/u);
  });
});
