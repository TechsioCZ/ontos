    const root = yield* Effect.promise(() => mkdtemp(path.join(tmpdir(), 'ontos-projects-outbox-')));
    yield* write(root, 'package.json', json({ name: 'fixture', private: true, type: 'module' }));
    yield* write(
      root,
      'verticals/projects/package.json',
      json({
        exports: { '.': INDEX_SOURCE },
        modernjs: {
          appId: 'projects',
          ontosModule: {
            contractPath: '/.well-known/ontos-module-manifest.json',
            manifest: './vertical.manifest.ts',
            moduleId: 'projects.core',
            registration: './vertical.registration.ts',
            schemaVersion: ONTOS_MODULE_CONTRACT_PACKAGE_SCHEMA_VERSION,
          },
          role: 'module-federation-remote',
          topology: '../../topology/reference-topology.json',
        },
        name: '@app/projects',
        private: true,
        type: 'module',
      }),
    );
    yield* write(
      root,
      'topology/reference-topology.json',
      json({
        verticals: [{ id: 'projects', kind: 'vertical', package: '@app/projects', path: 'verticals/projects' }],
      }),
    );
    const ownerHeader = `// @generated by OntOS Codesmith Module Contract v1
// @ontos-deployment-app-id projects
// @ontos-module-id projects.core
`;
    yield* write(root, 'verticals/projects/vertical.manifest.ts', `${ownerHeader}export const manifest = {};\n`);
    yield* write(
