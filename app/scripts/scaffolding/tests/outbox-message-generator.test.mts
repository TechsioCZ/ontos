import { NodeServices } from '@effect/platform-node';
import { Cause, Effect, Schema } from 'effect';
import { expect, it } from 'effect-rstest';
import { mkdtemp, readFile } from 'node:fs/promises';
import { tmpdir } from 'node:os';
import path from 'node:path';

import { getHelpText, runScaffoldEffect } from '../cli.mts';
import { snapshotTree, write } from './fixture-files.mts';
import { withCreatedFixture } from './fixture-ownership.mts';

const CORE_MODULE = 'core.identity';
const CORE_ACTION = 'change-user-binding-status';
const CORE_TOPIC = 'core.identity.user-binding-status-changed.v1';
const CORE_TOPIC_SLUG = 'core-identity-user-binding-status-changed-v1';
const CORE_ACTION_BASE = 'ChangeUserBindingStatusCoreIdentityUserBindingStatusChangedV1Outbox';
const CORE_PACKAGE = 'packages/core-runtime/package.json';
const CORE_ACTION_FILE = `packages/core-runtime/src/modules/actions/${CORE_ACTION}.action.ts`;
const CORE_MESSAGE_FILE = `packages/core-runtime/src/modules/actions/${CORE_ACTION}-${CORE_TOPIC_SLUG}.outbox-message.ts`;
const CORE_CONTRACT_FILE = `packages/core-runtime/src/outbox/${CORE_TOPIC_SLUG}.ts`;
const OUTBOX_COMMAND = 'outbox-message' as const;
const CorePackageSchema = Schema.Struct({
  exports: Schema.Record(Schema.String, Schema.String),
});

const json = (value: typeof Schema.Json.Type): string => `${JSON.stringify(value, null, 2)}\n`;

const generatedCoreAction = `// @generated by OntOS Codesmith Action v1
// @ontos-action-owner ${CORE_MODULE}
// @ontos-action-slug ${CORE_ACTION}
import { Effect, Schema } from 'effect';
import { defineAction } from '../../actions/definition.ts';
import { defineSystemModuleEntrypoint } from '../module-entrypoint.ts';

export const ChangeUserBindingStatusPayloadSchema = Schema.Struct({});
export const ChangeUserBindingStatusResultSchema = Schema.Struct({});
export const changeUserBindingStatusAction = defineAction(
  {
    actionKey: '${CORE_MODULE}.${CORE_ACTION}',
    entrypoint: defineSystemModuleEntrypoint({
      access: 'write',
      entrypointKey: '${CORE_MODULE}.${CORE_ACTION}',
      moduleKey: '${CORE_MODULE}',
      role: 'action',
    }),
    owningModuleKey: '${CORE_MODULE}',
  },
  () => Effect.succeed(undefined),
);
`;

const createFixture = (): Effect.Effect<string, unknown> =>
  Effect.gen(function* createOutboxFixture() {
    const root = yield* Effect.promise(() => mkdtemp(path.join(tmpdir(), 'ontos-core-outbox-')));
    yield* write(root, 'package.json', json({ name: 'fixture', private: true }));
    yield* write(
      root,
      CORE_PACKAGE,
      json({
        exports: { '.': './src/index.ts' },
        name: '@app/core-runtime',
        private: true,
      }),
    );
    yield* write(root, CORE_ACTION_FILE, generatedCoreAction);
    return root;
  });

const withFixture = withCreatedFixture(createFixture());

const runCoreOutbox = (root: string, argumentsList: readonly string[]) =>
  runScaffoldEffect(OUTBOX_COMMAND, argumentsList, { workspaceRoot: root }).pipe(Effect.provide(NodeServices.layer));

const scaffoldCoreOutbox = (root: string) =>
  runCoreOutbox(root, ['--scope', 'core', '--module', CORE_MODULE, '--action', CORE_ACTION, '--topic', CORE_TOPIC]);

const readCoreOutput = (root: string) =>
  Effect.all({
    action: Effect.promise(() => readFile(path.join(root, CORE_ACTION_FILE), 'utf-8')),
    contract: Effect.promise(() => readFile(path.join(root, CORE_CONTRACT_FILE), 'utf-8')),
    message: Effect.promise(() => readFile(path.join(root, CORE_MESSAGE_FILE), 'utf-8')),
    package: Effect.promise(() => readFile(path.join(root, CORE_PACKAGE), 'utf-8')),
  });

const expectFailure = <A, E, R>(self: Effect.Effect<A, E, R>, check: (cause: unknown) => void) =>
  Effect.matchCauseEffect(self, {
    onFailure: (cause) => Effect.sync(() => check(Cause.squash(cause))),
    onSuccess: () => Effect.fail(new Error('Expected operation to fail')),
  });

it.live('documents Core ownership and generates a deterministic schema-only Outbox contract', () =>
  withFixture(
    Effect.fn(function* generatesCoreOutbox(root) {
      expect(getHelpText('outbox-message')).toMatch(/scaffold:outbox-message -- --scope core --module <core\.module>/u);
      yield* scaffoldCoreOutbox(root);
      const first = yield* readCoreOutput(root);
      yield* scaffoldCoreOutbox(root);
      expect(yield* readCoreOutput(root)).toEqual(first);

      expect(first.action).toMatch(/entrypoint: defineSystemModuleEntrypoint\(\{/u);
      expect(first.action).toMatch(/<generated-outbox-message-exports>/u);
      expect(first.action).toMatch(new RegExp(CORE_ACTION_BASE, 'u'));
      expect(first.message).toMatch(new RegExp(`@ontos-outbox-action ${CORE_MODULE}\\.${CORE_ACTION}`, 'u'));
      expect(first.message).toMatch(/import type \{ OutboxMessage \} from '\.\.\/\.\.\/actions\/events\.ts';/u);
      expect(first.message).toMatch(new RegExp(`create${CORE_ACTION_BASE}Message`, 'u'));
      expect(first.contract).toMatch(new RegExp(`@ontos-outbox-producer ${CORE_MODULE}`, 'u'));
      expect(first.contract).toMatch(new RegExp(`outboxTopic = '${CORE_TOPIC}'`, 'u'));
      expect(first.contract).toMatch(new RegExp(`outboxProducerModuleKey = '${CORE_MODULE}'`, 'u'));
      const generatedPackage = yield* Schema.decodeUnknownEffect(Schema.fromJsonString(CorePackageSchema))(
        first.package,
      );
      expect(generatedPackage.exports[`./outbox/${CORE_TOPIC_SLUG}`]).toBe(`./src/outbox/${CORE_TOPIC_SLUG}.ts`);
      expect(first.contract).not.toMatch(/handler|repository|transport/u);
    }),
  ),
);

it.live('refuses Core owner or contract drift before any Outbox mutation', () =>
  withFixture(
    Effect.fn(function* refusesCoreOutboxDrift(root) {
      yield* write(root, CORE_CONTRACT_FILE, 'export const handwritten = true;\n');
      const before = yield* snapshotTree(root);
      yield* expectFailure(scaffoldCoreOutbox(root), (error) =>
        expect(String(error)).toMatch(/refusing to overwrite existing business file/u),
      );
      expect(yield* snapshotTree(root)).toEqual(before);

      const wrongOwnerAction = generatedCoreAction.replaceAll(CORE_MODULE, 'core.other');
      yield* write(root, CORE_ACTION_FILE, wrongOwnerAction);
      const beforeOwnerRefusal = yield* snapshotTree(root);
      yield* expectFailure(scaffoldCoreOutbox(root), (error) =>
        expect(String(error)).toMatch(/matching generated Core Action with its governed write entrypoint/u),
      );
      expect(yield* snapshotTree(root)).toEqual(beforeOwnerRefusal);

      for (const driftedAction of [
        generatedCoreAction.replaceAll('defineSystemModuleEntrypoint', 'defineTenantModuleEntrypoint'),
        generatedCoreAction.replace("access: 'write'", "access: 'read'"),
        generatedCoreAction.replace(
          `entrypointKey: '${CORE_MODULE}.${CORE_ACTION}'`,
          `entrypointKey: '${CORE_MODULE}.different-action'`,
        ),
      ] as const) {
        yield* write(root, CORE_ACTION_FILE, driftedAction);
        const beforeEntrypointRefusal = yield* snapshotTree(root);
        yield* expectFailure(scaffoldCoreOutbox(root), (error) =>
          expect(String(error)).toMatch(/matching generated Core Action with its governed write entrypoint/u),
        );
        expect(yield* snapshotTree(root)).toEqual(beforeEntrypointRefusal);
      }
    }),
  ),
);

it.live('rejects Core schema drift, package export collisions, and mixed ownership atomically', () =>
  withFixture(
    Effect.fn(function* refusesCoreOutboxDrift(root) {
      yield* write(
        root,
        CORE_CONTRACT_FILE,
        `// @generated by OntOS Codesmith Outbox Message Contract v1
// @ontos-outbox-producer ${CORE_MODULE}
// @ontos-outbox-topic ${CORE_TOPIC}
import { Schema } from 'effect';

export const OutboxPayloadSchema = Schema.Struct({
  data: Schema.Json,
});
export type OutboxPayload = Schema.Schema.Type<typeof OutboxPayloadSchema>;

export const outboxTopic = '${CORE_TOPIC}' as const;
export const outboxProducerModuleKey = '${CORE_MODULE}' as const;

export const handler = () => undefined;
`,
      );
      const beforeSchemaDrift = yield* snapshotTree(root);
      yield* expectFailure(scaffoldCoreOutbox(root), (error) =>
        expect(String(error)).toMatch(/refusing to overwrite existing business file/u),
      );
      expect(yield* snapshotTree(root)).toEqual(beforeSchemaDrift);

      yield* write(
        root,
        CORE_CONTRACT_FILE,
        `// @generated by OntOS Codesmith Outbox Message Contract v1
// @ontos-outbox-producer ${CORE_MODULE}
// @ontos-outbox-topic ${CORE_TOPIC}
import { Schema } from 'effect';

export const OutboxPayloadSchema = Schema.Struct({
  data: Schema.Json,
});
export type OutboxPayload = Schema.Schema.Type<typeof OutboxPayloadSchema>;

export const outboxTopic = '${CORE_TOPIC}' as const;
export const outboxProducerModuleKey = '${CORE_MODULE}' as const;
`,
      );
      const conflictingPackage = `${JSON.stringify(
        {
          exports: {
            '.': './src/index.ts',
            [`./outbox/${CORE_TOPIC_SLUG}`]: './src/other-contract.ts',
          },
          name: '@app/core-runtime',
          private: true,
        },
        null,
        2,
      )}\n`;
      yield* write(root, CORE_PACKAGE, conflictingPackage);
      const beforePackageConflict = yield* snapshotTree(root);
      yield* expectFailure(scaffoldCoreOutbox(root), (error) =>
        expect(String(error)).toMatch(/Outbox contract export .* already exists/u),
      );
      expect(yield* snapshotTree(root)).toEqual(beforePackageConflict);

      const beforeMixedOwnership = yield* snapshotTree(root);
      yield* expectFailure(
        runScaffoldEffect(
          OUTBOX_COMMAND,
          [
            '--vertical',
            'inventory-stock',
            '--scope',
            'core',
            '--module',
            CORE_MODULE,
            '--action',
            CORE_ACTION,
            '--topic',
            CORE_TOPIC,
          ],
          { workspaceRoot: root },
        ).pipe(Effect.provide(NodeServices.layer)),
        (error) => expect(String(error)).toMatch(/mutually exclusive/u),
      );
      expect(yield* snapshotTree(root)).toEqual(beforeMixedOwnership);
    }),
  ),
);

it.live('rejects invalid Core owners and names before planning mutations', () =>
  withFixture(
    Effect.fn(function* refusesInvalidCoreInput(root) {
      const beforeInvalidModule = yield* snapshotTree(root);
      yield* expectFailure(
        runCoreOutbox(root, [
          '--scope',
          'core',
          '--module',
          'identity',
          '--action',
          CORE_ACTION,
          '--topic',
          CORE_TOPIC,
        ]),
        (error) => expect(String(error)).toMatch(/stable lowercase core/u),
      );
      expect(yield* snapshotTree(root)).toEqual(beforeInvalidModule);

      const beforeInvalidAction = yield* snapshotTree(root);
      yield* expectFailure(
        runCoreOutbox(root, [
          '--scope',
          'core',
          '--module',
          CORE_MODULE,
          '--action',
          'not valid',
          '--topic',
          CORE_TOPIC,
        ]),
        (error) => expect(String(error)).toMatch(/action must be canonical lower-kebab-case/u),
      );
      expect(yield* snapshotTree(root)).toEqual(beforeInvalidAction);

      const beforeInvalidTopic = yield* snapshotTree(root);
      yield* expectFailure(
        runCoreOutbox(root, [
          '--scope',
          'core',
          '--module',
          CORE_MODULE,
          '--action',
          CORE_ACTION,
          '--topic',
          'not-a-topic',
        ]),
        (error) => expect(String(error)).toMatch(/topic must be a lowercase dot-separated/u),
      );
      expect(yield* snapshotTree(root)).toEqual(beforeInvalidTopic);
    }),
  ),
);

it.live('refuses Core factory drift before mutating generated owners', () =>
  withFixture(
    Effect.fn(function* refusesCoreFactoryDrift(root) {
      yield* scaffoldCoreOutbox(root);
      const generatedMessage = yield* Effect.promise(() => readFile(path.join(root, CORE_MESSAGE_FILE), 'utf-8'));
      yield* write(root, CORE_MESSAGE_FILE, `${generatedMessage}\nexport const handler = () => undefined;\n`);
      const before = yield* snapshotTree(root);
      yield* expectFailure(scaffoldCoreOutbox(root), (error) =>
        expect(String(error)).toMatch(/refusing to overwrite existing business file/u),
      );
      expect(yield* snapshotTree(root)).toEqual(before);
    }),
  ),
);
