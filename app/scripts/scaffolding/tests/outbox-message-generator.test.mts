`;

const createFixture = (): Effect.Effect<string, unknown> =>
  Effect.gen(function* createOutboxFixture() {
    const root = yield* Effect.promise(() => mkdtemp(path.join(tmpdir(), 'ontos-core-outbox-')));
    yield* write(root, 'package.json', json({ name: 'fixture', private: true }));
    yield* write(
      root,
      CORE_PACKAGE,
      json({
        exports: { '.': INDEX_SOURCE },
        name: '@app/core-runtime',
        private: true,
      }),
    );
    yield* write(root, CORE_ACTION_FILE, generatedCoreAction);
    return root;
  });

const withFixture = withCreatedFixture(createFixture());

const PROJECT_ACTION_FILE = 'verticals/projects/src/actions/create-project.action.ts';
const PROJECT_TOPIC = 'projects.core.search-refresh-requested.v1';
const PROJECT_TOPIC_SLUG = 'projects-core-search-refresh-requested-v1';
const PROJECT_MODULE_DECLARATION = "const projectModuleKey = 'projects.core';";
const generatedProjectAction = `// @generated by OntOS Codesmith Action v1
