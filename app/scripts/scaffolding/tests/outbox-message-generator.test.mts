const withProjectsFixture = withCreatedFixture(createProjectsFixture());
const scaffoldProjectsOutbox = (root: string) =>
  runScaffoldEffect(
    OUTBOX_COMMAND,
    ['--vertical', 'projects', '--action', 'create-project', '--topic', PROJECT_TOPIC],
    { workspaceRoot: root },
  ).pipe(Effect.provide(NodeServices.layer));

const runCoreOutbox = (root: string, argumentsList: readonly string[]) =>
  runScaffoldEffect(OUTBOX_COMMAND, argumentsList, { workspaceRoot: root }).pipe(Effect.provide(NodeServices.layer));

const scaffoldCoreOutbox = (root: string) =>
  runCoreOutbox(root, ['--scope', 'core', '--module', CORE_MODULE, '--action', CORE_ACTION, '--topic', CORE_TOPIC]);

const readCoreOutput = (root: string) =>
  Effect.all({
    action: Effect.promise(() => readFile(path.join(root, CORE_ACTION_FILE), 'utf-8')),
    contract: Effect.promise(() => readFile(path.join(root, CORE_CONTRACT_FILE), 'utf-8')),
    message: Effect.promise(() => readFile(path.join(root, CORE_MESSAGE_FILE), 'utf-8')),
    package: Effect.promise(() => readFile(path.join(root, CORE_PACKAGE), 'utf-8')),
  });

const expectFailure = <A, E, R>(self: Effect.Effect<A, E, R>, check: (cause: unknown) => void) =>
  Effect.matchCauseEffect(self, {
    onFailure: (cause) => Effect.sync(() => check(Cause.squash(cause))),
    onSuccess: () => Effect.fail(new Error('Expected operation to fail')),
  });

it.live('accepts the generated Projects Action with immutable constant ownership and preserves it on reruns', () =>
  withProjectsFixture(
    Effect.fn(function* generatesProjectsOutbox(root) {
      yield* scaffoldProjectsOutbox(root);
      const first = yield* snapshotTree(root);
      const action = yield* Effect.promise(() => readFile(path.join(root, PROJECT_ACTION_FILE), 'utf-8'));
      expect(action).toContain(PROJECT_MODULE_DECLARATION);
      expect(action).toContain(PROJECT_MODULE_FIELD);
      expect(action).toContain(PROJECT_OWNER_FIELD);
      expect(action).toContain(`./create-project-${PROJECT_TOPIC_SLUG}.outbox-message.ts`);
      const contract = yield* Effect.promise(() =>
        readFile(path.join(root, `verticals/projects/shared/outbox/${PROJECT_TOPIC_SLUG}.ts`), 'utf-8'),
      );
      expect(contract).toContain("outboxProducerModuleKey = 'projects.core' as const;");
      expect(contract).toContain(`outboxTopic = '${PROJECT_TOPIC}' as const;`);
      yield* scaffoldProjectsOutbox(root);
      expect(yield* snapshotTree(root)).toEqual(first);
    }),
  ),
);

it.live('continues to accept generated literal ownership and const-asserted ownership', () =>
  withProjectsFixture(
    Effect.fn(function* acceptsStaticProjectsOwnership(root) {
      for (const source of [
        generatedProjectAction.replaceAll(': projectModuleKey,', ": 'projects.core',"),
        generatedProjectAction.replace(
          PROJECT_MODULE_DECLARATION,
          "const projectModuleKey = 'projects.core' as const;",
        ),
        generatedProjectAction.replace(
          PROJECT_MODULE_DECLARATION,
          "const owner = 'projects.core';\nconst projectModuleKey = owner;",
        ),
        generatedProjectAction.replace(
          '() => Effect.succeed(undefined)',
          '() => { let calls = 0; calls += 1; return Effect.succeed(calls); }',
        ),
        generatedProjectAction
          .replace("import { defineAction, defineTenantModuleEntrypoint } from '@app/core-runtime';\n", '')
          .replace(
            '// @generated by OntOS Codesmith Action v1',
            "import { defineAction, defineTenantModuleEntrypoint } from '@app/core-runtime';\n// @generated by OntOS Codesmith Action v1",
          ),
      ]) {
        yield* write(root, PROJECT_ACTION_FILE, source);
        yield* scaffoldProjectsOutbox(root);
      }
    }),
  ),
);

it.live('rejects wrong, mutable, ambiguous, or indeterminate Projects ownership without mutations', () =>
  withProjectsFixture(
    Effect.fn(function* rejectsUnprovenProjectsOwnership(root) {
      for (const source of [
        generatedProjectAction.replace(PROJECT_MODULE_DECLARATION, "const projectModuleKey = 'projects.other';"),
        generatedProjectAction.replace(PROJECT_MODULE_DECLARATION, "let projectModuleKey = 'projects.core';"),
        generatedProjectAction.replace(PROJECT_MODULE_DECLARATION, "var projectModuleKey = 'projects.core';"),
        generatedProjectAction.replace(PROJECT_MODULE_DECLARATION, 'const projectModuleKey = resolveOwner();'),
        generatedProjectAction.replace(
          PROJECT_MODULE_DECLARATION,
          "const projectModuleKey = resolveOwner() as 'projects.core';",
        ),
        generatedProjectAction.replace(PROJECT_MODULE_DECLARATION, 'const projectModuleKey = 42;'),
        generatedProjectAction.replace(PROJECT_MODULE_DECLARATION, "import { projectModuleKey } from './owner.ts';"),
        generatedProjectAction.replace(PROJECT_MODULE_DECLARATION, 'declare const projectModuleKey: string;'),
        `${generatedProjectAction.replace(PROJECT_MODULE_DECLARATION, '')}\n${PROJECT_MODULE_DECLARATION}\n`,
        generatedProjectAction.replace(PROJECT_MODULE_DECLARATION, 'const projectModuleKey = projectModuleKey;'),
        generatedProjectAction.replace(
          PROJECT_MODULE_DECLARATION,
          `${PROJECT_MODULE_DECLARATION}\n${PROJECT_MODULE_DECLARATION}`,
        ),
        `${generatedProjectAction}\nprojectModuleKey = 'projects.other';\n`,
        `${generatedProjectAction}\n({ owner: projectModuleKey } = otherOwner);\n`,
        `${generatedProjectAction}\nprojectModuleKey++;\n`,
        `${generatedProjectAction}\nfor (projectModuleKey of owners) {}\n`,
        generatedProjectAction.replace(PROJECT_OWNER_FIELD, "owningModuleKey: 'projects.other',"),
        generatedProjectAction.replace(PROJECT_MODULE_FIELD, "moduleKey: 'projects.other',"),
        generatedProjectAction.replace(
          PROJECT_OWNER_FIELD,
          "owningModuleKey: projectModuleKey,\n    owningModuleKey: 'projects.other',",
        ),
        generatedProjectAction.replace(PROJECT_MODULE_FIELD, 'moduleKey: projectModuleKey,\n      ...otherOwner,'),
      ]) {
        yield* write(root, PROJECT_ACTION_FILE, source);
        const before = yield* snapshotTree(root);
        yield* expectFailure(scaffoldProjectsOutbox(root), (error) =>
          expect(String(error)).toMatch(/matching generated Action with its governed write entrypoint/u),
        );
        expect(yield* snapshotTree(root)).toEqual(before);
      }
    }),
  ),
);

