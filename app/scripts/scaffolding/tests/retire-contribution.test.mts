const appRoot = path.resolve(import.meta.dirname, '../../..');
const paymentVertical = 'verticals/payment-term-catalog';
const paymentContracts = 'packages/payment-term-catalog-contracts';
const paymentSlug = 'payment-term-catalog';
const paymentHistoryRead = 'payment-term-history';
const customerVertical = 'verticals/commerce-customer-context';
const customerRecoveryRead = 'market-retirement-reservation-recovery';
const customerRecoveryContracts = 'packages/customer-market-retirement-contracts';
const customerSlug = 'commerce-customer-context';

const sourceTree = async (root: string, directory: string): Promise<readonly (readonly [string, string])[]> => {
  const entries = await readdir(path.join(root, directory), { withFileTypes: true });
  const nested = await Promise.all(
    entries.map(async (entry): Promise<readonly (readonly [string, string])[]> => {
      const relative = path.posix.join(directory, entry.name);
      if (entry.isDirectory()) {
        return ['node_modules', 'dist', '.modern-js'].includes(entry.name) ? [] : await sourceTree(root, relative);
      }
      return /\.(?:ts|json)$/u.test(entry.name) ? [[relative, await readFile(path.join(root, relative), 'utf-8')]] : [];
    }),
  );
  return nested.flat();
};

/** A file of the copy and what it becomes before the retirement (from `''` when the module has no such file). */
type CopyEdit = readonly [file: string, edit: (source: string) => string];

/** A module specifier naming one of the read's files: its contract, Read binding, client or server. */
const namesReadFile = (read: string): RegExp =>
  new RegExp(`['"\`][^'"\`]*${read}(?:\\.read|-client|-read-server)?(?:\\.ts)?['"\`]`, 'u');

/**
 * What a person removes before retiring a read, since no generator wrote it: the module's and the package's own
 * tests of the read, and the package root's re-exports of the read's contract and client.
 */
const handWrittenUses = Effect.fn(function* handWrittenUses(read: string, folders: readonly string[]) {
  const trees = yield* Effect.promise(() => Promise.all(folders.map((folder) => sourceTree(appRoot, folder))));
  return trees.flat().flatMap(([file, source]): readonly CopyEdit[] => {
    if (!namesReadFile(read).test(source)) {
      return [];
    }
    if (file.includes('/tests/')) {
      return [[file, () => '']];
    }
    return file.endsWith('/src/index.ts')
      ? [
          [
            file,
            (text) =>
              text
                .split('\n')
                .filter((line) => !namesReadFile(read).test(line))
                .join('\n'),
          ],
        ]
      : [];
  });
});

/**
 * The manifest of every module and package of the workspace: what the `@app/…` specifiers of a copied module resolve
 * through, held without their files.
 */
const workspaceManifests = async (): Promise<readonly string[]> => {
  const listed = await Promise.all(
    ['packages', 'verticals'].map(async (folder) => {
      const entries = await readdir(path.join(appRoot, folder), { withFileTypes: true });
      return entries.filter((entry) => entry.isDirectory()).map((entry) => `${folder}/${entry.name}/package.json`);
    }),
  );
  const manifests = await Promise.all(
    listed
      .flat()
      .map(async (file) => [file, await readFile(path.join(appRoot, file), 'utf-8').catch(() => '')] as const),
  );
  return manifests.flatMap(([file, source]) => (source === '' ? [] : [file]));
};

/** A copy of actual modules or packages and the topology, outside their dependencies, beside the workspace's manifests. */
const copyModule = Effect.fn(function* copyModule(root: string, folders: readonly string[]) {
  const manifests = yield* Effect.promise(workspaceManifests);
  for (const relative of [...manifests, ...folders, 'topology/reference-topology.json']) {
    yield* Effect.promise(() =>
      cp(path.join(appRoot, relative), path.join(root, relative), {
        filter: (source) => !source.includes(`${path.sep}node_modules`),
        recursive: true,
      }),
    );
  }
});

/** Retire one read of an actual module in a copy, and return the module and its contract package as they remain. */
const retireInCopy = Effect.fn(function* retireInCopy(
  name: string,
  vertical: string = paymentVertical,
  contracts: string = paymentContracts,
  slug: string = paymentSlug,
  edits: readonly CopyEdit[] = [],
  prepare: (read: string, folders: readonly string[]) => Effect.Effect<readonly CopyEdit[]> = handWrittenUses,
) {
  const root = yield* Effect.promise(() => mkdtemp(path.join(tmpdir(), 'ontos-retire-read-')));
  return yield* Effect.gen(function* retireAndRead() {
    yield* copyModule(root, [vertical, contracts]);
    const prepared = yield* prepare(name, [vertical, contracts]);
    for (const [file, edit] of [...prepared, ...edits]) {
      const target = path.join(root, file);
      const source = yield* Effect.promise(() => readFile(target, 'utf-8').catch(() => ''));
      yield* Effect.promise(() => writeFile(target, edit(source)));
    }
    yield* runScaffoldEffect(RETIRE_CONTRIBUTION_COMMAND, [VERTICAL_FLAG, slug, '--kind', 'api', '--name', name], {
      workspaceRoot: root,
    }).pipe(Effect.provide(NodeServices.layer));
    const trees = yield* Effect.promise(() =>
      Promise.all([vertical, contracts].map((folder) => sourceTree(root, folder))),
    );
    const manifests = yield* Effect.promise(async () => {
      const files = await workspaceManifests();
      return await Promise.all(
        files.map(async (file) => [file, await readFile(path.join(root, file), 'utf-8')] as const),
      );
    });
    return new Map([...manifests, ...trees.flat()]);
  }).pipe(Effect.ensuring(Effect.promise(() => rm(root, { force: true, recursive: true }))));
});

/** Every relative import and export of the owner entries names a file that is still there. */
const expectNoReferenceToDeletedFiles = (sources: ReadonlyMap<string, string>, vertical: string, aggregate: string) => {
  for (const file of [
    `${vertical}/vertical.manifest.ts`,
    `${vertical}/vertical.registration.ts`,
    `${vertical}/shared/api.ts`,
    `${vertical}/api/index.ts`,
    aggregate,
  ]) {
    expect(sources.has(file), file).toBe(true);
    const { errors, module } = parseSync(file, sources.get(file) ?? '', { lang: 'ts', sourceType: 'module' });
    expect(errors, file).toEqual([]);
    const specifiers = [
      ...module.staticImports.map((entry) => entry.moduleRequest.value),
      ...module.staticExports.flatMap((entry) => entry.entries.flatMap((item) => item.moduleRequest?.value ?? [])),
    ].filter((specifier) => specifier.startsWith('.'));
    for (const specifier of specifiers) {
      const target = path.posix.join(path.posix.dirname(file), specifier);
      expect(
        [target, `${target}.ts`, `${target}/index.ts`].some((candidate) => sources.has(candidate)),
        `${file} -> ${specifier}`,
      ).toBe(true);
    }
  }
};

