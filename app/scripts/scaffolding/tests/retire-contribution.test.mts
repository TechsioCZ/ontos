/** A package manifest with one more entry in its `exports`. */
const exported = (entry: string) => (source: string) =>
  source.replace('"exports": {\n', () => `"exports": {\n    ${entry},\n`);

/** The line count of a file of the module as it is checked in: the line an appended use stands on. */
const lineCount = async (file: string): Promise<number> => {
  const source = await readFile(path.join(appRoot, file), 'utf-8');
  return source.split('\n').length;
};

it.live(
  'judges the planned retirement as a whole before it writes anything, wherever the read is still named',
  Effect.fn(function* refuseBrokenPlan() {
    const aggregate = `${paymentVertical}/src/api/payment-term-catalog-client.ts`;
    const manifestFile = `${paymentVertical}/vertical.manifest.ts`;
    const forwarder = `${paymentVertical}/src/api/history-public.ts`;
    const loader = `${paymentVertical}/src/api/history-loader.ts`;
    const mjsLoader = `${paymentVertical}/src/api/loader.mjs`;
    const cjsLoader = `${paymentVertical}/src/api/loader.cjs`;
    const helper = `${paymentVertical}/src/api/history-helper.ts`;
    const packageLoader = `${paymentContracts}/src/loader.ts`;
    const readLoader = `${paymentVertical}/src/read-loader.ts`;
    const ownerManifest = `${paymentVertical}/package.json`;
    const deletedClient = './payment-term-history-client.ts';
    const escapedForwarder = `${paymentVertical}/src/api/history-escaped.ts`;
    for (const [label, edits, refusal] of [
      [
        'a client loads the retired contract through a template literal without interpolation',
        [
          [
            aggregate,
            (source: string) =>
              `${source}export const loadHistory = () => import(\`../../shared/apis/payment-term-history.ts\`);\n`,
          ],
        ],
        `${aggregate}:${yield* Effect.promise(async () => await lineCount(aggregate))} still names ../../shared/apis/payment-term-history.ts, which the retirement deletes`,
      ],
      [
        'the manifest uses the retired API value its generated import brought in',
        [[manifestFile, (source: string) => `${source}export const history = PaymentTermHistoryApi;\n`]],
        `${manifestFile}:${yield* Effect.promise(async () => await lineCount(manifestFile))} still uses PaymentTermHistoryApi, which the retirement unbinds`,
      ],
      // A `var` of a class static block is declared in the block: the manifest's later use is still of the import.
      [
        'the manifest uses the retired API value past a var of the same name in a class static block',
        [
          [
            manifestFile,
            (source: string) =>
              `${source}class Holder {\n  static {\n    var PaymentTermHistoryApi = 1;\n    void PaymentTermHistoryApi;\n  }\n}\nvoid Holder;\nexport const leaked = PaymentTermHistoryApi;\n`,
          ],
        ],
        `${manifestFile}:${(yield* Effect.promise(async () => await lineCount(manifestFile))) + 7} still uses PaymentTermHistoryApi, which the retirement unbinds`,
      ],
      [
        'an entry star-exports an owner file that star-exports the retired client',
        [
          [forwarder, () => "export * from './payment-term-history-client.ts';\n"],
          [aggregate, (source: string) => `${source}export * from './history-public.ts';\n`],
        ],
        `${forwarder}:1 still names ./payment-term-history-client.ts, which the retirement deletes`,
      ],
      [
        'a JavaScript loader imports the retired client',
        [[mjsLoader, () => "import * as history from './payment-term-history-client.ts';\nexport default history;\n"]],
        `${mjsLoader}:1 still names ./payment-term-history-client.ts, which the retirement deletes`,
      ],
      // Any string written whole that names a deleted file refuses the plan, whatever it stands in.
      [
        'a CommonJS loader requires the retired client through a parenthesized require',
        [[cjsLoader, () => `module.exports = (require)('${deletedClient}');\n`]],
        `${cjsLoader}:1 still names ${deletedClient}, which the retirement deletes`,
      ],
      [
        'a URL of the retired client',
        [[helper, () => `export const where = new URL('${deletedClient}', import.meta.url);\n`]],
        `${helper}:1 still names ${deletedClient}, which the retirement deletes`,
      ],
      [
        'an argument of a function the rules do not know',
        [
          [
            helper,
            () => `declare const lazy: (path: string) => unknown;\nexport const history = lazy('${deletedClient}');\n`,
          ],
        ],
        `${helper}:2 still names ${deletedClient}, which the retirement deletes`,
      ],
      // A relative path names a deleted file with any JavaScript or TypeScript extension, or without one.
      ...(['./payment-term-history-client.js', './payment-term-history-client'] as const).map(
        (specifier) =>
          [
            `an owner file star-exports the retired client as ${specifier}`,
            [[helper, () => `export * from '${specifier}';\n`]],
            `${helper}:1 still names ${specifier}, which the retirement deletes`,
          ] as const,
      ),
      // Every contract package the module owns is read, whether or not it publishes the read.
      [
        'a contract package of the module re-exports the retired client of the module by a relative path',
        [
          [
            packageLoader,
            () => "export * from '../../../verticals/payment-term-catalog/src/api/payment-term-history-client.ts';\n",
          ],
        ],
        `${packageLoader}:1 still names ../../../verticals/payment-term-catalog/src/api/payment-term-history-client.ts, which the retirement deletes`,
      ],
      // A whole workspace package specifier resolves through the package's exports.
      [
        "a contract package re-exports the retired contract through the owner package's exports",
        [
          [ownerManifest, exported('"./apis/payment-term-history": "./shared/apis/payment-term-history.ts"')],
          [packageLoader, () => "export * from '@app/payment-term-catalog/apis/payment-term-history';\n"],
        ],
        `${packageLoader}:1 still names @app/payment-term-catalog/apis/payment-term-history, which the retirement deletes`,
      ],
      // A pattern export publishes the retired contract under a name that is not its base name.
      [
        "a contract package re-exports the retired contract through a pattern of the owner package's exports",
        [
          [ownerManifest, exported('"./apis/*": "./shared/apis/payment-term-*.ts"')],
          [packageLoader, () => "export * from '@app/payment-term-catalog/apis/history';\n"],
        ],
        `${packageLoader}:1 still names @app/payment-term-catalog/apis/history, which the retirement deletes`,
      ],
      [
        "an owner source loads the retired contract through a pattern of the owner package's exports",
        [
          [ownerManifest, exported('"./apis/*": "./shared/apis/payment-term-*.ts"')],
          [readLoader, () => "export const loadHistory = () => import('@app/payment-term-catalog/apis/history');\n"],
        ],
        `${readLoader}:1 still names @app/payment-term-catalog/apis/history, which the retirement deletes`,
      ],
      [
        'an owner file star-exports the retired client under an escaped specifier',
        [[escapedForwarder, () => "export * from './payment\\u002dterm-history-client.ts';\n"]],
        `${escapedForwarder}:1 still names ./payment-term-history-client.ts, which the retirement deletes`,
      ],
      [
        'a loader loads the retired client under an escaped specifier',
        [[loader, () => "export const loadHistory = () => import('./payment\\x2dterm-history-client.ts');\n"]],
        `${loader}:1 still names ./payment-term-history-client.ts, which the retirement deletes`,
      ],
      [
        'a source that names the retired read loads a module it builds at run time',
        [
          [
            loader,
            () =>
              `const read = 'payment-term-history';\nexport const loadHistory = () => import(\`./\${read}-client.ts\`);\n`,
          ],
        ],
        `${loader}:2 loads a module it does not name statically`,
      ],
      [
        'a source that names the retired read only through an escape loads a module it builds at run time',
        [
          [
            loader,
            () =>
              `const read = 'payment\\x2dterm-history';\nexport const loadHistory = () => import(\`./\${read}-client.ts\`);\n`,
          ],
        ],
        `${loader}:2 loads a module it does not name statically`,
      ],
    ] as const) {
      yield* expectFailure(
        retireInCopy(paymentHistoryRead, paymentVertical, paymentContracts, paymentSlug, edits),
        (cause) => {
          expect(String(cause), label).toContain(refusal);
        },
      );
    }
  }),
);

