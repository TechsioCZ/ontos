definition principal {}

definition resource_type {
  relation reader: principal
  relation creator: principal

  permission read = reader
  permission create = creator
}

definition task_collection {
  relation reader: principal
  relation creator: principal

  permission read = reader + creator
  permission create = creator
}

definition core_modules {
  relation viewer: principal
  relation changer: principal

  permission view = viewer + changer
  permission change = changer
}
