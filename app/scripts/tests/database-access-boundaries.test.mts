      );
      const violations = yield* checkDatabaseAccessBoundaries(root).pipe(Effect.provide(NodeServices.layer));
      expect(violations.filter(({ file }) => file.includes('/valid-'))).toEqual([]);
      expect(
        EffectArray.sort(
