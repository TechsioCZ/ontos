it.live('finds a package read from its package and rejects orphan, unclaimed, unexported and duplicated reads', () =>
  Effect.gen(function* packageReadDiscovery() {
    const sources = yield* loadSources([owner, contracts, customerContracts]);
    expect(sources.has(ownerContract)).toBe(false);
    expect(sources.has(ownerClient)).toBe(false);
    expect(seam(sources)).toBe(true);
    const contract = required(sources, packageContract);
    const client = required(sources, packageClient);
    const manifestSource = required(sources, packageManifest);
    const copy = 'packages/payment-term-catalog-contracts-copy';
    for (const [label, changes] of [
      [
        'orphan header-carrying leaf',
        [[`${contracts}/src/apis/orphan-read.ts`, `${HEADER}export const OrphanReadApi = {};\n`]],
      ],
      [
        'package naming another module',
        [
          [
            packageManifest,
            replaced(manifestSource, '"moduleId": "payment.term-catalog"', '"moduleId": "payment.other"'),
          ],
        ],
      ],
      [
        'package client bound to another contract',
        [[packageClient, client.replaceAll(`from '../apis/${name}.ts'`, `from '${contractSpecifier}'`)]],
      ],
      [
        'package client exported from another file',
        [
          [
            packageManifest,
            replaced(
              manifestSource,
              `"./${name}/client": "./src/api/${name}-client.ts"`,
              `"./${name}/client": "./src/api/action-gateway.ts"`,
            ),
          ],
        ],
      ],
      ['package read without its package gateway', [[`${contracts}/src/api/action-gateway.ts`, undefined]]],
      [
        'package naming another owner package',
        [
          [
            packageManifest,
            replaced(manifestSource, '"packageName": "@app/payment-term-catalog"', '"packageName": "@app/other"'),
          ],
        ],
      ],
      [
        'package contract on a counterfeit HTTP module',
        [
          [
            packageContract,
            contract
              .replaceAll("from 'effect/http-api'", "from './fake-native.ts'")
              .replaceAll("from '@modern-js/bff-effect/effect-client'", "from './fake-native.ts'"),
          ],
        ],
      ],
      [
        'package contract with a shadowing group decoy',
        [[packageContract, `${contract}\nconst HttpApiGroup = fakeGroup;\n`]],
      ],
      ['unclaimed leaf', [[packageManifest, replaced(manifestSource, claim, '"moduleApis": []')]]],
      ['unexported leaf', [[packageManifest, replaced(manifestSource, contractExport, '')]]],
      [
        'claimed and exported leaf its owner does not declare',
        [
          [`${contracts}/src/apis/undeclared-read.ts`, contract],
          [
            packageManifest,
            replaced(
              replaced(manifestSource, claim, `"moduleApis": ["${name}", "undeclared-read"]`),
              contractExport,
              `${contractExport} "./undeclared-read": "./src/apis/undeclared-read.ts",`,
            ),
          ],
        ],
      ],
      [
        'claim without a contract',
        [[packageManifest, replaced(manifestSource, claim, `"moduleApis": ["${name}", "missing-read"]`)]],
      ],
      [
        'one name published in the owner and the package',
        [
          [
            ownerContract,
            contract.replaceAll("from './", "from '../../../../packages/payment-term-catalog-contracts/src/apis/"),
          ],
        ],
      ],
      [
        'two packages claiming the same owner and name',
        [
          [
            `${copy}/package.json`,
            replaced(
              manifestSource,
              '"@app/payment-term-catalog-contracts"',
              '"@app/payment-term-catalog-contracts-copy"',
            ),
          ],
          [`${copy}/src/apis/${name}.ts`, contract],
        ],
      ],
      [
        'a forwarding contract left in the owner',
        [[ownerContract, `${HEADER}export * from '${contractSpecifier}';\n`]],
      ],
      [
        'a forwarding client left in the owner',
        [[ownerClient, `${HEADER}export * from '${contractSpecifier}/client';\n`]],
      ],
      [
        'contract in the package, client in the owner',
        [
          [ownerClient, client],
          [packageClient, undefined],
        ],
      ],
      [
        'contract in the owner, client in the package',
        [
          [ownerContract, contract],
          [packageContract, undefined],
        ],
      ],
    ] as const) {
      expect(seam(sources, changes), label).toBe(false);
    }
    // A header-carrying leaf is found whatever its package manifest says about exports, and judged by the module it names.
    for (const [label, manifest] of [
      ['without exports', packageJson({ ontosContractOwner: { ...paymentOwner, moduleApis: [] } })],
      [
        'with only an unrelated conditional root export',
        packageJson({
          exports: { '.': { import: './src/index.ts' } },
          ontosContractOwner: { ...paymentOwner, moduleApis: [] },
        }),
      ],
    ] as const) {
      const verdict = judged(sources, [
        [`${secondPackage}/package.json`, manifest],
        [`${secondPackage}/src/apis/orphan.ts`, `${HEADER}export const OrphanApi = {};\n`],
      ]);
      expect(verdict.valid, label).toBe(false);
      expect(verdict.diagnostics, label).toContain(`${secondPackage}/src/apis/orphan.ts: not a package read`);
    }
    // One read name of one owner has one claiming package, whatever the second package holds at that path.
    for (const [label, leaf] of [
      ['an ordinary file', 'export const currentPaymentTerms = true;\n'],
      ['a copy of the contract', contract],
    ] as const) {
      const verdict = judged(sources, [
        [
          `${secondPackage}/package.json`,
          packageJson({
            exports: { [`./${name}`]: `./src/apis/${name}.ts` },
            ontosContractOwner: { ...paymentOwner, moduleApis: [name] },
          }),
        ],
        [`${secondPackage}/src/apis/${name}.ts`, leaf],
      ]);
      expect(verdict.valid, label).toBe(false);
      expect(verdict.diagnostics, label).toContain(
        `${name}: one read of payment.term-catalog is claimed by more than one package`,
      );
    }
  }),
);

it.live('binds every owner file of a package read to its package and keeps the owner entries free of it', () =>
  Effect.gen(function* packageReadOwnerFiles() {
    const sources = yield* loadSources([owner, contracts]);
    expect(seam(sources)).toBe(true);
    const manifest = required(sources, manifestFile);
    const registration = required(sources, registrationFile);
    const sharedApi = required(sources, sharedApiFile);
    const aggregate = required(sources, aggregateFile);
    const server = required(sources, serverFile);
    const lazyClient = `import('${contractSpecifier}/client')`;
    for (const [label, file, source] of [
      [
        'registration loads the client of a package not claiming the read',
        registrationFile,
        replaced(
          registration,
          lazyClient,
          "import('@app/customer-payment-term-contracts/current-payment-terms/client')",
        ),
      ],
      [
        'registration loads an owner client path',
        registrationFile,
        replaced(registration, lazyClient, `import('./src/api/${name}-client.ts')`),
      ],
      [
        'declaration imports the contract from the owner path',
        manifestFile,
        replaced(manifest, `from '${contractSpecifier}'`, `from './shared/apis/${name}.ts'`),
      ],
      [
        'mount imports the contract from the owner path',
        sharedApiFile,
        replaced(sharedApi, `from '${contractSpecifier}'`, `from './apis/${name}.ts'`),
      ],
      [
        'server imports the contract from the owner path',
        serverFile,
        server.replaceAll(`from '${contractSpecifier}'`, `from '../shared/apis/${name}.ts'`),
      ],
      ['./api re-exports the package read', sharedApiFile, `${sharedApi}\nexport * from '${contractSpecifier}';\n`],
      ['./api re-exports the mounted API value', sharedApiFile, `${sharedApi}\nexport { CurrentPaymentTermsApi };\n`],
      // Outside the generated import slot, so only the owner-entry rule sees the second binding.
      [
        './api imports a second binding of the read and re-exports it',
        sharedApiFile,
        `import { CurrentPaymentTermsRequestSchema } from '${contractSpecifier}';\n${sharedApi}\nexport { CurrentPaymentTermsRequestSchema };\n`,
      ],
      [
        './api imports a second binding of the read without exporting it',
        sharedApiFile,
        `import { CurrentPaymentTermsRequestSchema } from '${contractSpecifier}';\n${sharedApi}`,
      ],
      [
        './api imports the API value under another local name',
        sharedApiFile,
        `import { CurrentPaymentTermsApi as PaymentTermsApi } from '${contractSpecifier}/client';\n${sharedApi}\nexport { PaymentTermsApi };\n`,
      ],
      [
        './api exports the API value under another name',
        sharedApiFile,
        `${sharedApi}\nexport const X = CurrentPaymentTermsApi;\n`,
      ],
      [
        './api renames the API value on export',
        sharedApiFile,
        `${sharedApi}\nexport { CurrentPaymentTermsApi as Renamed };\n`,
      ],
      [
        './api exports a type alias that names the read',
        sharedApiFile,
        `${sharedApi}\ntype CurrentPaymentTermsShape = typeof CurrentPaymentTermsApi;\nexport type { CurrentPaymentTermsShape };\n`,
      ],
      [
        './api/client aggregate imports the package contract',
        aggregateFile,
        `import { CurrentPaymentTermsApi } from '${contractSpecifier}';\n${aggregate}\nexport const leaked = CurrentPaymentTermsApi;\n`,
      ],
      [
        './api/client aggregate re-exports the package client',
        aggregateFile,
        `${aggregate}\nexport * from '${contractSpecifier}/client';\n`,
      ],
      [
        './api/client aggregate re-exports the package contract',
        aggregateFile,
        `${aggregate}\nexport { CurrentPaymentTermsRequestSchema } from '${contractSpecifier}';\n`,
      ],
      [
        './api/client aggregate re-exports the read from the root of its contract package',
        aggregateFile,
        `${aggregate}\nexport { CurrentPaymentTermsRequestSchema } from '@app/payment-term-catalog-contracts';\n`,
      ],
      // A declaration reaches the read through every local alias that does, whatever the aliases are called.
      [
        './api exports a type alias of a local alias of the read',
        sharedApiFile,
        `${sharedApi}\ntype Mounted = typeof CurrentPaymentTermsApi;\nexport type CurrentApi = Mounted;\n`,
      ],
      [
        './api exports a type alias of a local alias of the read declared after it',
        sharedApiFile,
        `${sharedApi}\nexport type CurrentApi = Mounted;\ntype Mounted = Shape;\ntype Shape = typeof CurrentPaymentTermsApi;\n`,
      ],
      [
        './api exports an interface whose member has a local alias of the read',
        sharedApiFile,
        `${sharedApi}\ntype Shape = typeof CurrentPaymentTermsApi;\nexport interface Public {\n  api: Shape;\n}\n`,
      ],
      [
        './api exports a value annotated with a local alias of the read',
        sharedApiFile,
        `${sharedApi}\ntype Shape = typeof CurrentPaymentTermsApi;\nexport const leaked: Shape = paymentTermCatalogFoundationApi;\n`,
      ],
      [
        './api exports a second HttpApi that mounts the read',
        sharedApiFile,
        `${sharedApi}\nexport const other = HttpApi.make('Other').addHttpApi(CurrentPaymentTermsApi);\n`,
      ],
      // Reach is per declarator and per destructured name: the one that holds the read is the one that leaves.
      [
        './api exports the declarator that holds the read beside an unrelated one',
        sharedApiFile,
        `${sharedApi}\nconst mounted = CurrentPaymentTermsApi, currency = 'EUR';\nexport { mounted };\n`,
      ],
      [
        './api exports the destructured name whose default is the read',
        sharedApiFile,
        `${sharedApi}\nconst { mounted = CurrentPaymentTermsApi, currency } = { currency: 'EUR' };\nexport { mounted };\n`,
      ],
      [
        './api loads the read',
        sharedApiFile,
        `${sharedApi}\nexport const load = () => import('${contractSpecifier}');\n`,
      ],
      [
        './api/client aggregate exports an import type of the read',
        aggregateFile,
        `${aggregate}\nexport type Request = import('${contractSpecifier}').CurrentPaymentTermsRequest;\n`,
      ],
    ] as const) {
      expect(source, label).not.toBe(sources.get(file));
      expect(seam(sources, [[file, source]]), label).toBe(false);
    }
    // What an entry passes on is judged by what it resolves to, through an owner file, a whole module's member, a
    // rename and a `typeof`: each of these is the read. A name an owner file does not export cannot be followed.
    for (const [label, changes, diagnostic] of [
      [
        'the aggregate passes on a member of the read taken as a whole module by an owner file',
        [
          [
            `${owner}/src/api/public-request.ts`,
            `import type * as Read from '${contractSpecifier}';\n\nexport type PublicRequest = Read.CurrentPaymentTermsRequest;\n`,
          ],
          [aggregateFile, `${aggregate}\nexport type { PublicRequest } from './public-request.ts';\n`],
        ],
        `${aggregateFile}: export PublicRequest passes on the package read ${packageContract}`,
      ],
      [
        './api exports the typeof of a rename an owner file passes on of the read',
        [
          [
            `${owner}/shared/schema-from-read.ts`,
            `export { CurrentPaymentTermsRequestSchema as SchemaFromRead } from '${contractSpecifier}';\n`,
          ],
          [
            sharedApiFile,
            `import type { SchemaFromRead } from './schema-from-read.ts';\n${sharedApi}\nexport type PublicSchema = typeof SchemaFromRead;\n`,
          ],
        ],
        `${sharedApiFile}: export PublicSchema passes on the package read ${packageContract}`,
      ],
      [
        './api re-exports a name the owner file does not export',
        [
          [`${owner}/shared/extra.ts`, 'export const Other = 1;\n'],
          [sharedApiFile, `${sharedApi}\nexport type { PublicRequest } from './extra.ts';\n`],
        ],
        `${sharedApiFile}: export PublicRequest cannot be followed: ${owner}/shared/extra.ts exports no PublicRequest`,
      ],
    ] as const) {
      const verdict = judged(sources, changes);
      expect(verdict.valid, label).toBe(false);
      expect(verdict.diagnostics, label).toContain(diagnostic);
    }
    // Free: a local type that reaches no read, a parameter that only shares the read's name, a declarator or a
    // destructured name beside the one holding the read, the type of the module's own API, and the aliases the
    // module's own HttpApi value is annotated with, which reach the read only in that annotation.
    for (const [label, source] of [
      ['an unrelated local type exported', `${sharedApi}\ntype Currency = string;\nexport type { Currency };\n`],
      [
        'an unrelated declarator beside the one holding the read',
        `${sharedApi}\nconst mounted = CurrentPaymentTermsApi, currency = 'EUR';\nexport { currency };\n`,
      ],
      [
        'an unrelated destructured name beside the one whose default is the read',
        `${sharedApi}\nconst { mounted = CurrentPaymentTermsApi, currency } = { currency: 'EUR' };\nexport { currency };\n`,
      ],
      ['the type of the module own API', `${sharedApi}\nexport type PublicApi = typeof paymentTermCatalogApi;\n`],
      [
        'a parameter named like the read',
        `${sharedApi}\nexport const describeApi = (CurrentPaymentTermsApi: string): string => CurrentPaymentTermsApi;\n`,
      ],
      [
        'the typed union of the mounted groups annotating the module HttpApi value',
        replaced(
          sharedApi,
          "export const paymentTermCatalogApi = HttpApi.make('PaymentTermCatalogApi')",
          [
            'type GroupsOf<Api> = Api extends HttpApi.HttpApi<string, infer Groups> ? Groups : never;',
            'type PaymentTermCatalogApiGroups = GroupsOf<',
            '  | typeof paymentTermCatalogFoundationApi',
            '  | typeof CurrentPaymentTermsApi',
            '>;',
            "type PaymentTermCatalogHttpApi = HttpApi.HttpApi<'PaymentTermCatalogApi', PaymentTermCatalogApiGroups>;",
            "export const paymentTermCatalogApi: PaymentTermCatalogHttpApi = HttpApi.make('PaymentTermCatalogApi')",
          ].join('\n'),
        ),
      ],
    ] as const) {
      expect(seam(sources, [[sharedApiFile, source]]), label).toBe(true);
    }
    // Only the mount inside the initializer of the module's own HttpApi value is exempt, however it breaks over
    // lines; any other mount of the read is a use of it, and counts as a second contribution even unexported.
    expect(
      judged(sources, [
        [
          sharedApiFile,
          `${sharedApi}\nexport const other = HttpApi.make('Other').addHttpApi(\n  CurrentPaymentTermsApi,\n);\n`,
        ],
      ]).diagnostics,
    ).toContain(`${sharedApiFile}: export other reaches a package read of the module`);
    expect(
      seam(sources, [
        [
          sharedApiFile,
          `${sharedApi}\nconst unused = () =>\n  HttpApi.make('Other').addHttpApi(\n    CurrentPaymentTermsApi,\n  );\n`,
        ],
      ]),
    ).toBe(false);
  }),
);

