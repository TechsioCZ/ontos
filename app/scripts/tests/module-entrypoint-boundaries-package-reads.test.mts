import path from 'node:path';
import { Effect } from 'effect';
import { expect, it } from 'effect-rstest';
import { undeclaredPackageReadImports } from '../check-module-entrypoint-boundaries.mts';
import { hasCompleteGeneratedModuleApiSeam } from '../generated-governed-http-boundary.mts';
import { readPricingSourceTree } from './module-entrypoint-boundary-fixtures.mts';

// Payment Term Catalog publishes `current-payment-terms` from its contract package; its other reads stay in the owner.
const owner = 'verticals/payment-term-catalog';
const contracts = 'packages/payment-term-catalog-contracts';
const name = 'current-payment-terms';
const contractSpecifier = '@app/payment-term-catalog-contracts/current-payment-terms';
const packageManifest = `${contracts}/package.json`;
const packageContract = `${contracts}/src/apis/${name}.ts`;
const packageClient = `${contracts}/src/api/${name}-client.ts`;
const ownerContract = `${owner}/shared/apis/${name}.ts`;
const ownerClient = `${owner}/src/api/${name}-client.ts`;
const manifestFile = `${owner}/vertical.manifest.ts`;
const registrationFile = `${owner}/vertical.registration.ts`;
const sharedApiFile = `${owner}/shared/api.ts`;
const aggregateFile = `${owner}/src/api/payment-term-catalog-client.ts`;
const serverFile = `${owner}/api/${name}-read-server.ts`;
const HEADER = '// @generated by OntOS Codesmith module-api v1\n';

const loadSources = Effect.fn(function* loadSources(folders: readonly string[]) {
  const root = path.resolve(import.meta.dirname, '../..');
  const trees = yield* Effect.all(folders.map((folder) => readPricingSourceTree(root, folder)));
  return new Map(trees.flat());
});

const required = (sources: ReadonlyMap<string, string>, file: string): string => {
  const source = sources.get(file);
  if (source === undefined) {
    expect.unreachable(`expected ${file}`);
  }
  return source;
};

const replaced = (source: string, from: string, to: string): string => {
  expect(source).toContain(from);
  return source.replace(from, to);
};

const claim = `"moduleApis": [\n      "${name}"\n    ]`;
const contractExport = `"./${name}": "./src/apis/${name}.ts",`;

const seam = (
  sources: ReadonlyMap<string, string>,
  changes: readonly (readonly [string, string | undefined])[] = [],
) => {
  const changed = new Map(sources);
  for (const [file, source] of changes) {
    if (source === undefined) {
      changed.delete(file);
    } else {
      changed.set(file, source);
    }
  }
  return hasCompleteGeneratedModuleApiSeam(changed, sharedApiFile, 'payment-term-catalog');
};

it.live('finds a package read from its package and rejects orphan, unclaimed, unexported and duplicated reads', () =>
  Effect.gen(function* packageReadDiscovery() {
    const sources = yield* loadSources([owner, contracts, 'packages/customer-payment-term-contracts']);
    expect(sources.has(ownerContract)).toBe(false);
    expect(sources.has(ownerClient)).toBe(false);
    expect(seam(sources)).toBe(true);
    const contract = required(sources, packageContract);
    const client = required(sources, packageClient);
    const manifestSource = required(sources, packageManifest);
    const copy = 'packages/payment-term-catalog-contracts-copy';
    for (const [label, changes] of [
      [
        'orphan header-carrying leaf',
        [[`${contracts}/src/apis/orphan-read.ts`, `${HEADER}export const OrphanReadApi = {};\n`]],
      ],
      [
        'package naming another module',
        [
          [
            packageManifest,
            replaced(manifestSource, '"moduleId": "payment.term-catalog"', '"moduleId": "payment.other"'),
          ],
        ],
      ],
      [
        'package client bound to another contract',
        [[packageClient, client.replaceAll(`from '../apis/${name}.ts'`, `from '${contractSpecifier}'`)]],
      ],
      [
        'package client exported from another file',
        [
          [
            packageManifest,
            replaced(
              manifestSource,
              `"./${name}/client": "./src/api/${name}-client.ts"`,
              `"./${name}/client": "./src/api/action-gateway.ts"`,
            ),
          ],
        ],
      ],
      ['package read without its package gateway', [[`${contracts}/src/api/action-gateway.ts`, undefined]]],
      [
        'package naming another owner package',
        [
          [
            packageManifest,
            replaced(manifestSource, '"packageName": "@app/payment-term-catalog"', '"packageName": "@app/other"'),
          ],
        ],
      ],
      [
        'package contract on a counterfeit HTTP module',
        [
          [
            packageContract,
            contract
              .replaceAll("from 'effect/http-api'", "from './fake-native.ts'")
              .replaceAll("from '@modern-js/bff-effect/effect-client'", "from './fake-native.ts'"),
          ],
        ],
      ],
      [
        'package contract with a shadowing group decoy',
        [[packageContract, `${contract}\nconst HttpApiGroup = fakeGroup;\n`]],
      ],
      ['unclaimed leaf', [[packageManifest, replaced(manifestSource, claim, '"moduleApis": []')]]],
      ['unexported leaf', [[packageManifest, replaced(manifestSource, contractExport, '')]]],
      [
        'claimed and exported leaf its owner does not declare',
        [
          [`${contracts}/src/apis/undeclared-read.ts`, contract],
          [
            packageManifest,
            replaced(
              replaced(manifestSource, claim, `"moduleApis": ["${name}", "undeclared-read"]`),
              contractExport,
              `${contractExport} "./undeclared-read": "./src/apis/undeclared-read.ts",`,
            ),
          ],
        ],
      ],
      [
        'claim without a contract',
        [[packageManifest, replaced(manifestSource, claim, `"moduleApis": ["${name}", "missing-read"]`)]],
      ],
      [
        'one name published in the owner and the package',
        [
          [
            ownerContract,
            contract.replaceAll("from './", "from '../../../../packages/payment-term-catalog-contracts/src/apis/"),
          ],
        ],
      ],
      [
        'two packages claiming the same owner and name',
        [
          [
            `${copy}/package.json`,
            replaced(
              manifestSource,
              '"@app/payment-term-catalog-contracts"',
              '"@app/payment-term-catalog-contracts-copy"',
            ),
          ],
          [`${copy}/src/apis/${name}.ts`, contract],
        ],
      ],
      [
        'a forwarding contract left in the owner',
        [[ownerContract, `${HEADER}export * from '${contractSpecifier}';\n`]],
      ],
      [
        'a forwarding client left in the owner',
        [[ownerClient, `${HEADER}export * from '${contractSpecifier}/client';\n`]],
      ],
      [
        'contract in the package, client in the owner',
        [
          [ownerClient, client],
          [packageClient, undefined],
        ],
      ],
      [
        'contract in the owner, client in the package',
        [
          [ownerContract, contract],
          [packageContract, undefined],
        ],
      ],
    ] as const) {
      expect(seam(sources, changes), label).toBe(false);
    }
  }),
);

it.live('binds every owner file of a package read to its package and keeps the owner entries free of it', () =>
  Effect.gen(function* packageReadOwnerFiles() {
    const sources = yield* loadSources([owner, contracts]);
    expect(seam(sources)).toBe(true);
    const manifest = required(sources, manifestFile);
    const registration = required(sources, registrationFile);
    const sharedApi = required(sources, sharedApiFile);
    const aggregate = required(sources, aggregateFile);
    const server = required(sources, serverFile);
    const lazyClient = `import('${contractSpecifier}/client')`;
    for (const [label, file, source] of [
      [
        'registration loads the client of a package not claiming the read',
        registrationFile,
        replaced(
          registration,
          lazyClient,
          "import('@app/customer-payment-term-contracts/current-payment-terms/client')",
        ),
      ],
      [
        'registration loads an owner client path',
        registrationFile,
        replaced(registration, lazyClient, `import('./src/api/${name}-client.ts')`),
      ],
      [
        'declaration imports the contract from the owner path',
        manifestFile,
        replaced(manifest, `from '${contractSpecifier}'`, `from './shared/apis/${name}.ts'`),
      ],
      [
        'mount imports the contract from the owner path',
        sharedApiFile,
        replaced(sharedApi, `from '${contractSpecifier}'`, `from './apis/${name}.ts'`),
      ],
      [
        'server imports the contract from the owner path',
        serverFile,
        server.replaceAll(`from '${contractSpecifier}'`, `from '../shared/apis/${name}.ts'`),
      ],
      ['./api re-exports the package read', sharedApiFile, `${sharedApi}\nexport * from '${contractSpecifier}';\n`],
      ['./api re-exports the mounted API value', sharedApiFile, `${sharedApi}\nexport { CurrentPaymentTermsApi };\n`],
      [
        './api/client aggregate re-exports the package client',
        aggregateFile,
        `${aggregate}\nexport * from '${contractSpecifier}/client';\n`,
      ],
      [
        './api/client aggregate re-exports the package contract',
        aggregateFile,
        `${aggregate}\nexport { CurrentPaymentTermsRequestSchema } from '${contractSpecifier}';\n`,
      ],
    ] as const) {
      expect(source, label).not.toBe(sources.get(file));
      expect(seam(sources, [[file, source]]), label).toBe(false);
    }
  }),
);

it.live('requires a declared dependency for a production import of a package read outside its provider', () =>
  Effect.gen(function* packageReadDependency() {
    const sources = yield* loadSources([
      'apps/shell-super-app',
      'packages/price-group-catalog-contracts',
      'verticals/price-group-catalog',
    ]);
    const consumer = 'apps/shell-super-app/api/symmy/source-read-projections.ts';
    const specifier = '@app/price-group-catalog-contracts/price-group-definition/client';
    expect(required(sources, consumer)).toContain(`'${specifier}'`);
    expect(undeclaredPackageReadImports(sources, consumer, [specifier])).toEqual([]);
    const shellManifest = 'apps/shell-super-app/package.json';
    const undeclared = new Map([
      ...sources,
      [
        shellManifest,
        replaced(required(sources, shellManifest), '"@app/price-group-catalog-contracts": "workspace:*",', ''),
      ],
    ]);
    expect(undeclaredPackageReadImports(undeclared, consumer, [specifier])).toEqual([specifier]);
    // The provider module and the package itself need no declaration of their own package.
    expect(
      undeclaredPackageReadImports(
        new Map([
          ...undeclared,
          [
            'verticals/price-group-catalog/package.json',
            replaced(
              required(sources, 'verticals/price-group-catalog/package.json'),
              '"@app/price-group-catalog-contracts": "workspace:*"',
              '"@app/unrelated": "workspace:*"',
            ),
          ],
        ]),
        'verticals/price-group-catalog/vertical.registration.ts',
        [specifier],
      ),
    ).toEqual([]);
    expect(
      undeclaredPackageReadImports(
        undeclared,
        'packages/price-group-catalog-contracts/src/api/price-group-definition-client.ts',
        [specifier],
      ),
    ).toEqual([]);
  }),
);
