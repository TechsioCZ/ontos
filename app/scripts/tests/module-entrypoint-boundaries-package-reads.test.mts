const chainNames = {
  aggregate: `${PRICE_GROUP_OWNER}/src/api/price-group-catalog-client.ts`,
  exportsPublicApi: 'export PublicApi',
  exportsPublicRequest: 'export PublicRequest',
  passesOnTheRead: PASSES_ON_READ,
