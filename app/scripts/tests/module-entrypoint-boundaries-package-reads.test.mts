/** The library file that passes on the whole of the adapter. */
const STARTUP_ADAPTER = "export * as Startup from './adapter.js';\n";
const ADDITIONS_START = '  // <generated-governed-http-api-additions>\n';
const EXPORTS_OPEN = '"exports": {\n';
const PASSES_ON_READ = 'passes on the package read';

/** A declaration of an owner file that wraps an API value in a new one of its own. */
const annotated = (api: string): string =>
  `export const ExtraApi = ${api}.annotate(HttpApi.ParseOptions, { onExcessProperty: 'error' });`;

const loadSources = Effect.fn(function* loadSources(folders: readonly string[]) {
  const root = path.resolve(import.meta.dirname, '../..');
  const trees = yield* Effect.all(folders.map((folder) => readPricingSourceTree(root, folder)));
  const manifests = yield* readWorkspaceManifests(root, ['packages', 'verticals']);
  return new Map([...manifests, ...trees.flat()]);
});

const required = (sources: ReadonlyMap<string, string>, file: string): string => {
  const source = sources.get(file);
  if (source === undefined) {
    expect.unreachable(`expected ${file}`);
  }
  return source;
};

const replaced = (source: string, from: string, to: string): string => {
  expect(source).toContain(from);
  return source.replace(from, to);
};

const withoutLines = (source: string, lines: readonly string[]): string => {
  let next = source;
  for (const line of lines) {
    next = replaced(next, line, '');
  }
  return next;
};

const claim = `"moduleApis": [\n      "${name}"\n    ]`;
const paymentOwner: ContractOwnerFixture = {
  appId: 'payment-term-catalog',
  moduleId: 'payment.term-catalog',
  packageName: '@app/payment-term-catalog',
};
const contractExport = `"./${name}": "./src/apis/${name}.ts",`;

const seam = (
  sources: ReadonlyMap<string, string>,
  changes: readonly (readonly [string, string | undefined])[] = [],
) => {
  const changed = new Map(sources);
  for (const [file, source] of changes) {
    if (source === undefined) {
      changed.delete(file);
    } else {
      changed.set(file, source);
    }
  }
  return hasCompleteGeneratedModuleApiSeam(changed, sharedApiFile, paymentOwner.appId);
};

/** The seam's verdict and diagnostics after `changes`. */
const judged = (sources: ReadonlyMap<string, string>, changes: readonly (readonly [string, string | undefined])[]) => {
  const changed = new Map(sources);
  for (const [file, source] of changes) {
    if (source === undefined) {
      changed.delete(file);
    } else {
      changed.set(file, source);
    }
  }
  const diagnostics: string[] = [];
  const valid = hasCompleteGeneratedModuleApiSeam(changed, sharedApiFile, paymentOwner.appId, diagnostics);
  return { diagnostics: diagnostics.join('\n'), valid };
};

