        "export const ExtraApi = HttpApi.make('Extra').pipe((api) => {\n  void [process.argv, process.cwd(), import.meta.url, globalThis.crypto, globalThis.fetch];\n  return api;\n});",
        [],
      ],
      [
        'a builtin module process.getBuiltinModule loads',
        "export const ExtraApi = HttpApi.make('Extra').pipe((api) => {\n  void process.getBuiltinModule('node:path');\n  return api;\n});",
        [],
      ],
      [
        'an owner file imported by a .js path',
        "import { helper } from './extra-helper.js';\nexport const ExtraApi = HttpApi.make('Extra').pipe((api) => {\n  void helper;\n  return api;\n});",
        [[`${owner}/shared/extra-helper.ts`, 'export const helper = 1;\n']],
      ],
    ] as const) {
      const verdict = extraMounted(extra, changes);
      expect(verdict.valid, `${label}: ${verdict.diagnostics}`).toBe(true);
    }
    // Another module's schema, helper or read client is used, not mounted: one of its entry may be used inside an API
    // of the owner.
    expect(
      extraMounted(
        [
          "import { priceGroupCatalogItemSchema } from '@app/price-group-catalog/api';",
          "export const ExtraApi = HttpApi.make('Extra').add(",
          "  HttpApiGroup.make('extra').add(HttpApiEndpoint.get('extra', '/extra', { success: priceGroupCatalogItemSchema })),",
          ').pipe(identity);',
        ].join('\n'),
      ).valid,
    ).toBe(true);
    // So may one of its read clients, which uses the read's API value only inside its functions, and a module of the
    // owner may be loaded.
    for (const [label, extra, changes] of [
      [
        "another module's read client",
        [
          "import { executePriceGroupDefinitionWithAuthorization } from '@app/price-group-catalog-contracts/price-group-definition/client';",
          "export const ExtraApi = HttpApi.make('Extra').pipe((api) => {",
          '  void executePriceGroupDefinitionWithAuthorization;',
          '  return api;',
          '});',
        ].join('\n'),
        [],
      ],
      [
        'a module of the owner it loads',
        [
          "export const ExtraApi = HttpApi.make('Extra').pipe((api) => {",
          "  void import('./extra-loaded.ts');",
          '  return api;',
          '});',
        ].join('\n'),
        [[`${owner}/shared/extra-loaded.ts`, 'export const loaded = 1;\n']],
      ],
    ] as const) {
      expect(extraMounted(extra, changes).valid, label).toBe(true);
    }
    // The provider's rename in its own entry is its own business; and another module's schema may be used inside an
    // API of the owner's own.
    expect(
      hasCompleteGeneratedModuleApiSeam(
        new Map([
          ...wider,
          [
            `${priceGroups}/shared/api.ts`,
            `${priceGroupApi}export { PriceGroupCatalogHeadApi as HeadApi } from './apis/price-group-catalog-head.ts';\n`,
          ],
        ]),
        `${priceGroups}/shared/api.ts`,
        PRICE_GROUP_ID,
      ),
    ).toBe(true);
    for (const [label, imported, schema] of [
      [
        'by name',
        "import { ManageQuotationPayloadSchema } from '@app/pricing-contracts/manage-quotation/api';",
        'ManageQuotationPayloadSchema',
      ],
      [
        'as a member of the whole contract',
        "import * as Pricing from '@app/pricing-contracts/manage-quotation/api';",
        'Pricing.ManageQuotationPayloadSchema',
      ],
    ] as const) {
      expect(
        extraMounted(
          [
            imported,
            "export const ExtraApi = HttpApi.make('Extra').add(",
            `  HttpApiGroup.make('extra').add(HttpApiEndpoint.post('extra', '/extra', { payload: ${schema} })),`,
            ').pipe(identity);',
          ].join('\n'),
        ).valid,
        label,
      ).toBe(true);
    }
    // A handler layer from a package, and one passed on by a declaration of the entry from a server of no read.
    for (const [label, changes, layer] of [
      [
        'a package layer',
        [
          [
            handlerFile,
            replaced(
              `import { ForeignHandlersLive } from '@app/zz-handlers';\n${handler}`,
              layersStart,
              `    ForeignHandlersLive,\n${layersStart}`,
            ),
          ],
        ],
        'ForeignHandlersLive',
      ],
      [
        'an alias of a server of no read',
        [
          [`${owner}/api/stale-read-server.ts`, 'export const staleReadApiLive = {};\n'],
          [
            handlerFile,
            replaced(
              `import { staleReadApiLive } from './stale-read-server.ts';\nconst staleLive = staleReadApiLive;\n${handler}`,
              layersStart,
              `    staleLive,\n${layersStart}`,
            ),
          ],
        ],
        'staleLive',
      ],
    ] as const) {
      const verdict = judged(sources, changes);
      expect(verdict.valid, label).toBe(false);
      expect(verdict.diagnostics, label).toContain(unknown(handlerFile, layer));
    }
    // A mount the rule cannot resolve fails closed.
    const unresolvable = judged(sources, [
      [
        sharedApiFile,
        replaced(
          `import { MissingApi } from './missing-api.ts';\n${sharedApi}`,
          additionsStart,
          `  .addHttpApi(MissingApi)\n${additionsStart}`,
        ),
      ],
    ]);
    expect(unresolvable.valid).toBe(false);
    expect(unresolvable.diagnostics).toContain(unknown(sharedApiFile, 'MissingApi'));
    // An import alone, outside the slots, of another module's read or of a server of no read.
    for (const [label, file, source, binding] of [
      ['a foreign read', sharedApiFile, `import { ${foreign} } from '${foreignSpecifier}';\n${sharedApi}`, foreign],
      [
        'a server of no read',
        handlerFile,
        `import { staleReadApiLive } from './stale-read-server.ts';\n${handler}`,
        'staleReadApiLive',
      ],
    ] as const) {
      const verdict = judged(sources, [[file, source]]);
      expect(verdict.valid, label).toBe(false);
      expect(verdict.diagnostics, label).toContain(unknown(file, binding));
    }
    // The module's own API and layer: a layer through a plain alias in the runtime factory, and an API declared in a
    // file of the owner, by name or as its default export, mounted outside the slots.
    const factoryComposition = '  const apiHandlersLive = Layer.mergeAll(\n    paymentTermCatalogReadinessLayer,';
    const throughLocal = (declaration: string) =>
      replaced(
        handler,
        factoryComposition,
        `  ${declaration} readiness = paymentTermCatalogReadinessLayer;\n  const apiHandlersLive = Layer.mergeAll(\n    readiness,`,
      );
    expect(seam(sources, [[handlerFile, throughLocal('const')]])).toBe(true);
    // A layer composed through a local `let` fails closed, and says why.
    const rebound = judged(sources, [[handlerFile, throughLocal('let')]]);
    expect(rebound.valid).toBe(false);
    expect(rebound.diagnostics).toContain(unknown(handlerFile, 'readiness'));
    expect(rebound.diagnostics).toContain(`${handlerFile} readiness is declared with let`);
    // A readable load and a plain alias of a member are judged as what they are written as, as composed; the module's own
    // layer under parentheses and through a plain alias still pass.
    for (const [label, source, layer] of [
      [
        'an inline load',
        replaced(handler, layersStart, `    require('@effect/platform-node/NodeCrypto').layer,\n${layersStart}`),
        "require('@effect/platform-node/NodeCrypto').layer",
      ],
      [
        'a local alias of a member',
        replaced(
          handler,
          factoryComposition,
          `  const extraLayer = FetchHttpClient.layer;\n${replaced(factoryComposition, 'mergeAll(\n', 'mergeAll(\n    extraLayer,\n')}`,
        ),
        'extraLayer',
      ],
    ] as const) {
      const verdict = judged(sources, [[handlerFile, source]]);
      expect(verdict.valid, label).toBe(false);
      expect(verdict.diagnostics, label).toContain(unknown(handlerFile, layer));
    }
    const parenthesized = judged(sources, [
      [
        handlerFile,
        replaced(
          handler,
          factoryComposition,
          replaced(factoryComposition, 'paymentTermCatalogReadinessLayer,', '(paymentTermCatalogReadinessLayer),'),
        ),
      ],
    ]);
    expect(parenthesized.valid, parenthesized.diagnostics).toBe(true);
    expect(
      seam(sources, [
        [
          `${owner}/shared/extra-api.ts`,
          "import { HttpApi } from '@modern-js/bff-effect/effect-client';\n\nexport default HttpApi.make('Extra');\n",
        ],
        [
          sharedApiFile,
          replaced(
            `import ExtraApi from './extra-api.ts';\n${sharedApi}`,
            additionsStart,
            `  .addHttpApi(ExtraApi)\n${additionsStart}`,
          ),
        ],
      ]),
    ).toBe(true);
    expect(
      seam(sources, [
        [
          `${owner}/shared/extra-api.ts`,
          "import { HttpApi } from '@modern-js/bff-effect/effect-client';\n\nexport const ExtraApi = HttpApi.make('Extra');\n",
        ],
        [
          sharedApiFile,
          replaced(
            `import { ExtraApi } from './extra-api.ts';\n${sharedApi}`,
            additionsStart,
            `  .addHttpApi(ExtraApi)\n${additionsStart}`,
          ),
        ],
      ]),
    ).toBe(true);
  }),
);

/** A list 1 form carrying a read's API value to `Carried`: the carrier's source, and how a consumer imports and refers to it. */
interface CarryForm {
  readonly carrier: (read: CarriedRead) => string;
  readonly imported: (read: CarriedRead) => string;
  readonly label: string;
  readonly value: (read: CarriedRead) => string;
}

const named = (): string => `{ ${CARRIED} }`;
const carried = (): string => CARRIED;

/** Every list 1 form that carries a name from one file to the next. */
const CARRY_FORMS: readonly CarryForm[] = [
  {
    carrier: (read) => `export { ${read.name} as ${CARRIED} } from '${read.specifier}';\n`,
    imported: named,
    label: 'export … from',
    value: carried,
  },
  {
    carrier: (read) => `export * from '${read.specifier}';\n`,
    imported: (read) => `{ ${read.name} as ${CARRIED} }`,
    label: 'export *',
    value: carried,
  },
  {
    carrier: (read) => `export * as ${CARRIED} from '${read.specifier}';\n`,
    imported: named,
    label: 'export * as',
    value: (read) => `${CARRIED}.${read.name}`,
  },
  {
    carrier: (read) => `import { ${read.name} } from '${read.specifier}';\nexport { ${read.name} as ${CARRIED} };\n`,
    imported: named,
    label: 'an import exported again',
    value: carried,
  },
  {
    carrier: (read) => `import { ${read.name} } from '${read.specifier}';\nexport const ${CARRIED} = ${read.name};\n`,
    imported: named,
    label: 'a const alias',
    value: carried,
  },
  {
    carrier: (read) =>
      `import * as Contract from '${read.specifier}';\nexport const ${CARRIED} = Contract.${read.name};\n`,
    imported: named,
    label: 'a namespace member',
    value: carried,
  },
  {
    carrier: (read) =>
      `import * as Contract from '${read.specifier}';\nexport const { ${read.name}: ${CARRIED} } = Contract;\n`,
    imported: named,
    label: 'a destructuring',
    value: carried,
  },
  {
    carrier: (read) => `export const ${CARRIED} = require('${read.specifier}').${read.name};\n`,
    imported: named,
    label: 'a readable load',
    value: carried,
  },
  {
    carrier: (read) => `import { ${read.name} } from '${read.specifier}';\nexport default ${read.name};\n`,
    imported: carried,
    label: 'a default export of a name',
    value: carried,
  },
];

/** A consumer of `Carried` in the owner entries: the files it writes and the diagnostic of its rule. */
interface CarryConsumer {
  /** What no diagnostic of the cell may say: the rule's line must not stand for another one. */
  readonly absent?: readonly string[];
  readonly diagnostics: readonly string[];
  readonly files: (
    sources: ReadonlyMap<string, string>,
    imported: string,
    value: string,
  ) => readonly (readonly [string, string])[];
  readonly label: string;
  /** A library value that is no read, which the consumer may take. */
  readonly libraryValue: string;
  readonly read: CarriedRead;
}

const PROBLEM_DETAILS_VALUE = "{ makeProblemDetailsSchema as Carried } from '@app/shared-contracts/problem-details'";

/** The consumer that writes `declaration` into `./api` after what it imports. */
const entryConsumer = (
  label: string,
  declaration: (value: string) => string,
  diagnostics: readonly string[],
): CarryConsumer => ({
  diagnostics,
  files: (sources, imported, value) => [
    [sharedApiFile, `${required(sources, sharedApiFile)}\n${imported}${declaration(value)}`],
  ],
  label,
  libraryValue: PROBLEM_DETAILS_VALUE,
  read: OWN_READ,
});

const REACHES = `${sharedApiFile}: export Wrapped reaches a package read of the module`;

const EXPORT_CONSUMERS: readonly CarryConsumer[] = [
  entryConsumer('a plain export', () => `export { ${CARRIED} };\n`, [
    `${sharedApiFile}: export ${CARRIED}`,
    PASSES_ON_READ,
  ]),
  {
    ...entryConsumer('a namespace export of the carrier', () => '', [
      `${sharedApiFile}: export Carriers.`,
      PASSES_ON_READ,
    ]),
    files: (sources, imported) => {
      const from = /from '(?<specifier>[^']+)'/u.exec(imported)?.groups?.specifier ?? '';
      return [[sharedApiFile, `${required(sources, sharedApiFile)}\nexport * as Carriers from '${from}';\n`]];
    },
  },
];

const BUILDER_CONSUMERS: readonly CarryConsumer[] = [
  entryConsumer(
    'a call',
    (value) => `export const Wrapped = ${value}.annotate(HttpApi.ParseOptions, { onExcessProperty: 'error' });\n`,
    [REACHES],
  ),
  entryConsumer('an object holding a member', (value) => `export const Wrapped = { groups: ${value}.groups };\n`, [
    REACHES,
  ]),
  entryConsumer('a bound member', (value) => `export const Wrapped = ${value}.bind(undefined);\n`, [REACHES]),
];

const MOUNT_CONSUMER: CarryConsumer = {
  // The mount's line also stands for a carrier that cannot be followed, which no cell of the column is.
  absent: ['cannot be followed'],
  diagnostics: [unknown(sharedApiFile, 'ExtraApi')],
  files: (sources, imported, value) => [
    [
      `${owner}/shared/extra.ts`,
      `import { HttpApi } from '@modern-js/bff-effect/effect-client';\n${imported}\nexport const ExtraApi = ${value}.annotate(HttpApi.ParseOptions, { onExcessProperty: 'error' });\n`,
    ],
    [
      sharedApiFile,
      replaced(
        `import { ExtraApi } from './extra.ts';\n${required(sources, sharedApiFile)}`,
        ADDITIONS_START,
        `  .addHttpApi(ExtraApi)\n${ADDITIONS_START}`,
      ),
    ],
  ],
  label: "a mount through an owner file of another module's API",
  libraryValue: "{ ExternalIdentityApiGroup as Carried } from '@app/shared-contracts/external-identity'",
  read: FOREIGN_READ,
};

/**
 * The consumer that holds a whole module of the carrier, taken through an owner barrel (`export * as Carriers`), in a
 * new value an owner entry exports.
 */
const wholeModuleConsumer = (label: string, entryFile: string, barrel: string, held: string): CarryConsumer => ({
  diagnostics: [`${entryFile}: export Wrapped reaches a package read of the module`],
  files: (sources, imported) => {
    const from = /from '(?<specifier>[^']+)'/u.exec(imported)?.groups?.specifier ?? '';
    return [
      [`${owner}/shared/carriers.ts`, `export * as Carriers from '${from}';\n`],
      [
        entryFile,
        `${required(sources, entryFile)}\nimport { Carriers } from '${barrel}';\nexport const Wrapped = ${held};\n`,
      ],
    ];
  },
  label,
  libraryValue: PROBLEM_DETAILS_VALUE,
  read: OWN_READ,
});

const CARRIERS_BARREL = './carriers.ts';
/** What follows `head` on the diagnostic line that starts with it. */
const reasonAfter = (diagnostics: string, head: string): string | undefined =>
  diagnostics
    .split('\n')
    .find((line) => line.startsWith(head))
    ?.slice(head.length);

/** An owner barrel that passes on the whole of its relay. */
const CARRIERS_RELAY = "export * as Carriers from './relay.ts';\n";

const WHOLE_MODULE_CONSUMERS: readonly CarryConsumer[] = [
  wholeModuleConsumer(
    'a value holding a whole module of the carrier',
    sharedApiFile,
    CARRIERS_BARREL,
    '{ carriers: Carriers }',
  ),
  wholeModuleConsumer(
    'a value of the client aggregate holding a whole module of the carrier',
    aggregateFile,
    '../../shared/carriers.ts',
    '{ carriers: Carriers }',
  ),
  wholeModuleConsumer('an array holding a whole module of the carrier', sharedApiFile, CARRIERS_BARREL, '[Carriers]'),
  wholeModuleConsumer('a spread of a whole module of the carrier', sharedApiFile, CARRIERS_BARREL, '{ ...Carriers }'),
];

/** Payment Term Catalog's sources with the workspace libraries whose files a carrier may stand in. */
const carrySources = Effect.fn(function* carrySources() {
  return yield* loadSources([
    owner,
    contracts,
    customerContracts,
    'packages/shared-contracts',
    'packages/core-runtime',
  ]);
});

/**
 * The verdict of every cell of the table: each form in each place, consumed as `consumer` consumes it, and the two
 * controls (the direct import of the contract package, which fails; a library value that is no read, which passes).
 * A cell reads `fails by its rule` when the seam fails with every diagnostic of the consumer's rule.
 */
const carriedVerdicts = (
  sources: ReadonlyMap<string, string>,
  consumer: CarryConsumer,
): readonly (readonly [string, string])[] => {
  const startupManifest = replaced(
    required(sources, SHARED_CONTRACTS_MANIFEST),
    EXPORTS_OPEN,
    '"exports": {\n    "./startup": "./src/startup.ts",\n',
  );
  const places = [
    ['an owner file', './carrier.ts', (source: string) => [[`${owner}/shared/carrier.ts`, source] as const]],
    [
      'a held library file',
      '@app/shared-contracts/startup',
      (source: string) => [[SHARED_CONTRACTS_MANIFEST, startupManifest] as const, [STARTUP_FILE, source] as const],
    ],
  ] as const;
  const verdict = (changes: readonly (readonly [string, string])[]): string => {
    const seen = judged(sources, changes);
    if (seen.valid) {
      return 'passes';
    }
    return consumer.diagnostics.every((expected) => seen.diagnostics.includes(expected)) &&
      !(consumer.absent ?? []).some((other) => seen.diagnostics.includes(other))
      ? 'fails by its rule'
      : `fails otherwise: ${seen.diagnostics}`;
  };
  const cells = places.flatMap(([place, carrierSpecifier, carrierFiles]) =>
    CARRY_FORMS.map(
      (form) =>
        [
          `${form.label} in ${place}, then ${consumer.label}`,
          verdict([
            ...carrierFiles(form.carrier(consumer.read)),
            ...consumer.files(
              sources,
              `import ${form.imported(consumer.read)} from '${carrierSpecifier}';\n`,
              form.value(consumer.read),
            ),
          ]),
        ] as const,
    ),
  );
  return [
    ...cells,
    [
      `the direct import of the contract package, then ${consumer.label}`,
      verdict(
        consumer.files(
          sources,
          `import { ${consumer.read.name} as ${CARRIED} } from '${consumer.read.specifier}';\n`,
          CARRIED,
        ),
      ),
    ],
    [
      `a library value that is no read, then ${consumer.label}`,
      verdict(consumer.files(sources, `import ${consumer.libraryValue};\n`, CARRIED)),
    ],
  ];
};

/** What every cell of the table must read: each form and the direct import fail by the rule, the library value passes. */
const expectedVerdicts = (verdicts: readonly (readonly [string, string])[]) =>
  verdicts.map(([label]) => [label, label.startsWith('a library value') ? 'passes' : 'fails by its rule']);

it.live(
  'fails every list 1 form that carries the read to what an owner entry exports, from an owner file or a held library',
  () =>
    Effect.gen(function* carriedToExports() {
      const sources = yield* carrySources();
      const verdicts = EXPORT_CONSUMERS.flatMap((consumer) => carriedVerdicts(sources, consumer));
      expect(verdicts).toEqual(expectedVerdicts(verdicts));
    }),
);

it.live(
  'fails every list 1 form that carries the read into a builder an owner entry exports, from an owner file or a held library',
  () =>
    Effect.gen(function* carriedToBuilders() {
      const sources = yield* carrySources();
      const verdicts = BUILDER_CONSUMERS.flatMap((consumer) => carriedVerdicts(sources, consumer));
      expect(verdicts).toEqual(expectedVerdicts(verdicts));
    }),
);

it.live(
  "fails every list 1 form that carries another module's API into a mounted owner declaration, from an owner file or a held library",
  () =>
    Effect.gen(function* carriedToMounts() {
      const sources = yield* carrySources();
      const verdicts = carriedVerdicts(sources, MOUNT_CONSUMER);
      expect(verdicts).toEqual(expectedVerdicts(verdicts));
      // A whole module a mounted declaration uses is judged as a file too: a CommonJS adapter lists no names.
      const adapterMount = judged(sources, [
        [
          SHARED_CONTRACTS_MANIFEST,
          replaced(
            required(sources, SHARED_CONTRACTS_MANIFEST),
            EXPORTS_OPEN,
            `${EXPORTS_OPEN}    "./startup": "./src/startup.ts",\n`,
          ),
        ],
        [STARTUP_FILE, STARTUP_ADAPTER],
        [ADAPTER_FILE, `module.exports = require('${FOREIGN_READ.specifier}');\n`],
        ...MOUNT_CONSUMER.files(
          sources,
          "import { Startup as Carried } from '@app/shared-contracts/startup';\n",
          'HttpApi.make(String(Carried))',
        ),
      ]);
      expect(adapterMount.diagnostics).toContain(
        `cannot be followed: ${ADAPTER_FILE} loads a module it does not read statically at line 1`,
      );
      // A whole module is never mounted: of a library file, or of an owner relay of the module's own read.
      const mountedWholeModules = [
        ['a library file', "export * as Carriers from '@app/shared-contracts/external-identity';\n", []],
        [
          "an owner relay of the module's own read",
          CARRIERS_RELAY,
          [[`${owner}/shared/relay.ts`, `export { ${OWN_READ.name} } from '${OWN_READ.specifier}';\n`]],
        ],
      ] as const;
      const mountedVerdicts = mountedWholeModules.map(([label, barrel, more]) => {
        const seen = judged(sources, [
          ...more,
          [`${owner}/shared/carriers.ts`, barrel],
          [
            sharedApiFile,
            replaced(
              `import { Carriers } from './carriers.ts';\n${required(sources, sharedApiFile)}`,
              ADDITIONS_START,
              `  .addHttpApi(Carriers)\n${ADDITIONS_START}`,
            ),
          ],
        ]);
        return [
          `a mount of a whole module of ${label}`,
          seen.diagnostics.includes(unknown(sharedApiFile, 'Carriers')) &&
            !seen.diagnostics.includes('cannot be followed'),
        ];
      });
      expect(mountedVerdicts).toEqual(mountedVerdicts.map(([label]) => [label, true]));
      // A whole module a mounted declaration uses is judged by its names: one that cannot be followed fails the mount.
      const optionsMount = (binding: string) =>
        judged(sources, [
          [`${owner}/shared/options.ts`, `export ${binding} onExcessProperty = 'error' as const;\n`],
          [
            `${owner}/shared/extra.ts`,
            "import { HttpApi } from '@modern-js/bff-effect/effect-client';\nimport * as Options from './options.ts';\nexport const ExtraApi = HttpApi.make('Extra').annotate(HttpApi.ParseOptions, { ...Options });\n",
          ],
          [
            sharedApiFile,
            replaced(
              `import { ExtraApi } from './extra.ts';\n${required(sources, sharedApiFile)}`,
              ADDITIONS_START,
              `  .addHttpApi(ExtraApi)\n${ADDITIONS_START}`,
            ),
          ],
        ]);
      const mutableOption = `(cannot be followed: ${owner}/shared/options.ts onExcessProperty is declared with let, so what it holds cannot be read from its declaration)`;
      const optionVerdicts = [
        ['a mounted declaration spreading a whole module whose name is a let', 'let', mutableOption],
        ['a mounted declaration spreading a whole module whose name is a const', 'const', null],
      ].map(([label, binding, reason]) => {
        const seen = optionsMount(binding ?? '');
        const mountLine = seen.diagnostics
          .split('\n')
          .find((line) => line.startsWith(unknown(sharedApiFile, 'ExtraApi')));
        return [
          label,
          reason === null ? seen.valid && seen.diagnostics === '' : !seen.valid && mountLine?.endsWith(reason) === true,
        ];
      });
      expect(optionVerdicts).toEqual(optionVerdicts.map(([label]) => [label, true]));
    }),
);

it.live(
  'fails every list 1 form whose whole module an owner entry holds in a new value, from an owner file or a held library',
  () =>
    Effect.gen(function* carriedInWholeModules() {
      const sources = yield* carrySources();
      const verdicts = WHOLE_MODULE_CONSUMERS.flatMap((consumer) => carriedVerdicts(sources, consumer));
      expect(verdicts).toEqual(expectedVerdicts(verdicts));
      // A load, an import type and what `export default` writes ask the same of a whole module.
      const barrel = [
        [`${owner}/shared/relay.ts`, `export { ${OWN_READ.name} } from '${OWN_READ.specifier}';\n`],
        [`${owner}/shared/carriers.ts`, CARRIERS_RELAY],
      ] as const;
      const sites = [
        [
          "export const loadCarriers = () => import('./carriers.ts');\n",
          `loads the package read ${owner}/shared/carriers.ts`,
        ],
        [
          "export type Held = typeof import('./carriers.ts');\n",
          `${sharedApiFile}: export Held reaches a package read`,
        ],
        [
          "import { Carriers } from './carriers.ts';\nexport default { carriers: Carriers };\n",
          `${sharedApiFile}: export default reaches a package read`,
        ],
      ].map(([appended, expected]) => [
        appended,
        judged(sources, [
          ...barrel,
          [sharedApiFile, `${required(sources, sharedApiFile)}\n${appended}`],
        ]).diagnostics.includes(expected),
      ]);
      expect(sites).toEqual(sites.map(([appended]) => [appended, true]));
      // A name of a held whole module that cannot be followed fails as it does when the module is exported, with the
      // same reason; held as a `const`, the same name reaches the read.
      const relayed = (binding: string, appended: string) =>
        judged(sources, [
          [
            `${owner}/shared/relay.ts`,
            `import { ${OWN_READ.name} } from '${OWN_READ.specifier}';\nexport ${binding} execute = ${OWN_READ.name};\n`,
          ],
          [`${owner}/shared/carriers.ts`, CARRIERS_RELAY],
          [sharedApiFile, `${required(sources, sharedApiFile)}\n${appended}`],
        ]).diagnostics;
      const heldModule = "import { Carriers } from './carriers.ts';\nexport const clients = { payments: Carriers };\n";
      const unfollowedExecute = ` Carriers.execute cannot be followed: ${owner}/shared/relay.ts `;
      const heldLet = reasonAfter(
        relayed('let', heldModule),
        `${sharedApiFile}:${required(sources, sharedApiFile).split('\n').length + 2}${unfollowedExecute}`,
      );
      const exportedLet = reasonAfter(
        relayed('let', "export { Carriers } from './carriers.ts';\n"),
        `${sharedApiFile}: export${unfollowedExecute}`,
      );
      expect(heldLet).toBeDefined();
      expect(heldLet).toBe(exportedLet);
      expect(relayed('const', heldModule)).toContain(`${sharedApiFile}: export clients reaches a package read`);
    }),
);

