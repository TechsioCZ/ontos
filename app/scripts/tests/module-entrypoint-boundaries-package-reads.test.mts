            passesOnTheRead,
          ],
          // The wrappers are read at every level: around the load, around its callee and under `await`.
          [
            'a non-null dynamic import of it under await',
            `export const PublicApi = (await (import('${read}')!)).PriceGroupDefinitionApi;`,
            passesOnTheRead,
          ],
          [
            'a dynamic import of it asserted to its own type under await',
            `export const PublicApi = (await (import('${read}') as Promise<typeof import('${read}')>)).PriceGroupDefinitionApi;`,
            passesOnTheRead,
          ],
          [
            'a dynamic import of it that satisfies a promise under await',
            `export const PublicApi = (await (import('${read}') satisfies Promise<unknown>)).PriceGroupDefinitionApi;`,
            passesOnTheRead,
          ],
          [
            'a parenthesized require of it',
            `export const PublicApi = (require)('${read}').PriceGroupDefinitionApi;`,
            passesOnTheRead,
          ],
          [
            'a non-null require of it',
            `export const PublicApi = require!('${read}').PriceGroupDefinitionApi;`,
            passesOnTheRead,
          ],
          // A file on the chain that holds a load no static rule reads may pass anything on: judged once, as a file.
          [
            'an alias of the global require',
            `const load = require;\nexport const PublicApi = load('${read}').PriceGroupDefinitionApi;`,
            `${LOADS_UNREAD} at line 3`,
            `re-exports through ${priceGroups}/shared/public.ts`,
          ],
          // A default may hold anything; an object rest holds the whole, which its members are taken of.
          [
            'a destructuring with a default',
            'export const { PriceGroupDefinitionApi: PublicApi = undefined } = Read;',
            'PublicApi is destructured with a default, so what it holds cannot be read',
          ],
          [
            'a destructuring with a default of an object rest',
            'const { ...rest } = Read;\nexport const { PriceGroupDefinitionApi: PublicApi = rest } = rest;',
            'PublicApi is destructured with a default, so what it holds cannot be read',
          ],
          [
            'a member of an object rest',
            'const { Other: _other, ...rest } = Read;\nexport const PublicApi = rest.PriceGroupDefinitionApi;',
            passesOnTheRead,
          ],
          ['an indexed type', "export type PublicApi = (typeof Read)['PriceGroupDefinitionApi'];", passesOnTheRead],
          [
            'a computed key it builds',
            "const key = 'PriceGroupDefinitionApi';\nexport const { [key]: PublicApi } = Read;",
            'is taken a member that cannot be read statically',
          ],
          [
            'a member access it builds',
            "const key = 'PriceGroupDefinitionApi';\nexport const PublicApi = Read[key];",
            'is taken a member that cannot be read statically',
          ],
        ] as const
      ).map(
        ([taken, declaration, expected, leaves = exportsPublicApi]: readonly [string, string, string, string?]) =>
          [
            `a member of the whole read taken by ${taken}, re-exported by ${sharedApi}`,
            sharedApi,
            "export { PublicApi } from './public.ts';\n",
            [[`${priceGroups}/shared/public.ts`, `import * as Read from '${read}';\n\n${declaration}\n`]],
            leaves,
            expected,
          ] as const,
      ),
      [
        'a re-export of an alias with a type parameter of its own of the read type',
        sharedApi,
        "export type { PublicRequest } from './public.ts';\n",
        [
          [
            `${priceGroups}/shared/public.ts`,
            `import type { PriceGroupDefinitionRequest } from '${read}';\n\nexport type PublicRequest<_T = unknown> = PriceGroupDefinitionRequest;\n`,
          ],
        ],
        exportsPublicRequest,
        passesOnTheRead,
      ],
      [
        "a re-export of an alias with a type parameter of its own of the typeof the read's API value",
        sharedApi,
        "export type { PublicApi } from './public.ts';\n",
        [
          [
            `${priceGroups}/shared/public.ts`,
            `import type { PriceGroupDefinitionApi } from '${read}';\n\nexport type PublicApi<_T = unknown> = typeof PriceGroupDefinitionApi;\n`,
          ],
        ],
        exportsPublicApi,
        passesOnTheRead,
      ],
    ] as const) {
      const failure = yield* judgedChain(entry, appended, files);
      expect(failure, form).toContain(`${entry}: ${exported}`);
      expect(failure, form).toContain(verdict);
    }
  }),
);

it.live('judges strict reach in the entry and admits a declaration of an owner file of its own', () =>
  Effect.gen(function* packageReadStrictReach() {
    const { priceGroups, read, sharedApi } = chainNames;
    const judgedChain = yield* chainJudge();
    for (const [form, entry, appended, files, exported, verdict] of relativeEntries.flatMap(
      ([entryFile, _folder, _leaf, _member, relative]) => [
        // In the entry itself reach is strict: a new object holding the read leaves with it.
        [
          `a new object holding the read's schema imported by a relative path in ${entryFile}`,
          entryFile,
          `import { PriceGroupDefinitionRequestSchema as RelSchema } from ${relative};\nexport const bundle = { RelSchema };\n`,
          [],
          'export bundle',
          'reaches a package read of the module',
        ] as const,
      ],
    )) {
      const failure = yield* judgedChain(entry, appended, files);
      expect(failure, form).toContain(`${entry}: ${exported}`);
      expect(failure, form).toContain(verdict);
    }
    // A declaration of an owner file that builds something new from the read's schema is the owner's own.
    expect(
      yield* judgedChain(
        sharedApi,
        "export { PriceGroupDefinitionEnvelopeSchema } from './price-group-envelope.ts';\n",
        [
          [
            `${priceGroups}/shared/price-group-envelope.ts`,
            [
              "import { Schema } from 'effect';",
              `import { PriceGroupDefinitionRequestSchema } from '${read}';`,
              '',
              'export const PriceGroupDefinitionEnvelopeSchema = Schema.Struct({ request: PriceGroupDefinitionRequestSchema });',
              '',
            ].join('\n'),
          ],
        ],
      ),
    ).toBeUndefined();
  }),
);

it.live('fails a chain of an owner entry that cannot be followed', () =>
  Effect.gen(function* packageReadUnfollowedChains() {
    const { exportsPublicRequest, priceGroups, sharedApi } = chainNames;
    const judgedChain = yield* chainJudge();
    for (const [form, entry, appended, files, exported, verdict] of [
      [
        'a re-export of a name the owner file does not export',
        sharedApi,
        "export type { PublicRequest } from './extra.ts';\n",
        [[`${priceGroups}/shared/extra.ts`, 'export const Other = 1;\n']],
        exportsPublicRequest,
        'exports no PublicRequest',
      ],
      // A chain that ends anywhere but on a declaration of an owner file cannot be followed, and fails closed.
      [
        'a re-export of a library binding through an owner file',
        sharedApi,
        "export { Schema } from './price-group-definition.ts';\n",
        [[`${priceGroups}/shared/price-group-definition.ts`, "export { Schema } from 'effect';\n"]],
        'export Schema',
        'which is no declaration of an owner file',
      ],
      [
        'a re-export of a missing owner file',
        sharedApi,
        "export { Missing } from './missing.ts';\n",
        [],
        'export Missing',
        'names ./missing.ts, which is no file of the workspace',
      ],
      // A workspace specifier resolves as TypeScript's bundler resolution and the package's exports resolve it; one that
      // names no file fails closed.
      ...(
        [
          ['a missing subpath of a contract package', '@app/price-group-catalog-contracts/missing'],
          ['a missing owner file by a .js path', './gone.js'],
          ['an unknown workspace package', '@app/no-such-package'],
        ] as const
      ).map(
        ([label, specifier]) =>
          [
            `a re-export of ${label}`,
            sharedApi,
            `export { Missing } from '${specifier}';\n`,
            [],
            'export Missing',
            `names ${specifier}, which is no file of the workspace`,
          ] as const,
      ),
    ] as const) {
      const failure = yield* judgedChain(entry, appended, files);
      expect(failure, form).toContain(`${entry}: ${exported}`);
      expect(failure, form).toContain(verdict);
    }
  }),
);

it.live('judges every file on a chain once and every load of the entry', () =>
  Effect.gen(function* packageReadChainFilesAndLoads() {
    const { priceGroups, read, sharedApi } = chainNames;
    const judgedChain = yield* chainJudge();
    for (const [form, entry, appended, files, exported, verdict] of [
      // Every file the entry's re-exports reach is judged once, as a file, whatever order the re-exports stand in.
      ...(
        [
          ['public.ts first', "export * from './public.ts';\nexport * from './second.ts';\n"],
          ['second.ts first', "export * from './second.ts';\nexport * from './public.ts';\n"],
        ] as const
      ).map(
        ([order, reexports]) =>
          [
            `a star re-export of a file that loads what it does not read and re-exports a file the entry also re-exports, ${order}`,
            sharedApi,
            reexports,
            [
              [
                `${priceGroups}/shared/public.ts`,
                `export { ok } from './second.ts';\n\nconst target = '${read}';\nvoid import(target);\n`,
              ],
              [`${priceGroups}/shared/second.ts`, 'export const ok = 1;\n'],
            ],
            `re-exports through ${priceGroups}/shared/public.ts`,
            `${LOADS_UNREAD} at line 4`,
          ] as const,
      ),
      [
        'a star re-export of a file without exports that loads what it does not read',
        sharedApi,
        "export * from './side.ts';\n",
        [[`${priceGroups}/shared/side.ts`, `const target = '${read}';\nvoid import(target);\n`]],
        `re-exports through ${priceGroups}/shared/side.ts`,
        `${LOADS_UNREAD} at line 2`,
      ],
    ] as const) {
      const failure = yield* judgedChain(entry, appended, files);
      expect(failure, form).toContain(`${entry}: ${exported}`);
      expect(failure, form).toContain(verdict);
    }
    // A load no static rule reads, anywhere in an entry, fails closed; a readable one of the read fails as a load of it.
    for (const [form, appended, verdict] of [
      [
        'a dynamic import of a name it builds',
        `const leaf = '${read}';\nexport const loadRead = () => import(leaf);\n`,
        LOADS_UNREAD,
      ],
      ['a dynamic import of the read', `export const loadRead = () => import('${read}');\n`, 'loads the package read'],
      [
        'a dynamic import of the read by a relative .js path',
        "export const loadRead = () => import('../../../packages/price-group-catalog-contracts/src/apis/price-group-definition.js');\n",
        'loads the package read',
      ],
      ['require.resolve', `export const where = require.resolve('${read}');\n`, LOADS_UNREAD],
      ['module.require', `export const load = module.require;\n`, LOADS_UNREAD],
      ['import.meta.resolve', `export const where = import.meta.resolve('${read}');\n`, LOADS_UNREAD],
      [
        "Node's module loader",
        "import { createRequire } from 'node:module';\nexport const load = createRequire(import.meta.url);\n",
        LOADS_UNREAD,
      ],
    ] as const) {
      const failure = yield* judgedChain(sharedApi, appended, []);
      expect(failure, form).toMatch(new RegExp(`${sharedApi}:\\d+ ${verdict}`, 'u'));
    }
  }),
);

it.live('requires a declared dependency for a production import of a package read outside its provider', () =>
  Effect.gen(function* packageReadDependency() {
    const sources = yield* loadSources(['apps/shell-super-app', priceGroupContracts, 'verticals/price-group-catalog']);
    const consumer = 'apps/shell-super-app/api/symmy/source-read-projections.ts';
    const specifier = '@app/price-group-catalog-contracts/price-group-definition/client';
    expect(required(sources, consumer)).toContain(`'${specifier}'`);
    expect(undeclaredPackageReadImports(sources, consumer, [specifier])).toEqual([]);
    const shellManifest = 'apps/shell-super-app/package.json';
    const undeclared = new Map([
      ...sources,
      [
        shellManifest,
        replaced(required(sources, shellManifest), '"@app/price-group-catalog-contracts": "workspace:*",', ''),
      ],
    ]);
    expect(undeclaredPackageReadImports(undeclared, consumer, [specifier])).toEqual([specifier]);
    // The provider module and the package itself need no declaration of their own package.
    expect(
      undeclaredPackageReadImports(
        new Map([
          ...undeclared,
          [
            'verticals/price-group-catalog/package.json',
            replaced(
              required(sources, 'verticals/price-group-catalog/package.json'),
              '"@app/price-group-catalog-contracts": "workspace:*"',
              '"@app/unrelated": "workspace:*"',
            ),
          ],
        ]),
        'verticals/price-group-catalog/vertical.registration.ts',
        [specifier],
      ),
    ).toEqual([]);
    expect(
      undeclaredPackageReadImports(
        undeclared,
        'packages/price-group-catalog-contracts/src/api/price-group-definition-client.ts',
        [specifier],
      ),
    ).toEqual([]);
  }),
);
