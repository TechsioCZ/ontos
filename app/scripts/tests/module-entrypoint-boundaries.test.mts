const write = async (root: string, file: string, source: string): Promise<void> => {
  const target = path.join(root, file);
  await mkdir(path.dirname(target), { recursive: true });
  await writeFile(target, source, 'utf-8');
};

const governedClientFixture = (options: {
  readonly apiValue: string;
  readonly authorizedOperation: string;
  readonly clientHelper: string;
  readonly contractImport: string;
  readonly endpointGroup: string;
  readonly generatedHeader: string;
  readonly invocationKind: 'module-api' | 'provider';
  readonly publicOperation: string;
}): string => {
  const apiStem = options.apiValue.replace(/Api$/u, '');
  const operationStem =
    options.invocationKind === MODULE_API_KIND
      ? apiStem
      : apiStem.replace(/(?:Report|Search)$/u, '');
  const requestType =
    options.invocationKind === MODULE_API_KIND
      ? `${apiStem}Request`
      : `${operationStem}ProviderRequest`;
  return `${options.generatedHeader}import { makeEffectBffClient } from '@app/shared-contracts/client-runtime';
import { Effect, Redacted } from 'effect';
import { ${options.apiValue} } from '${options.contractImport}';
import type { ${requestType} } from '${options.contractImport}';
${GATEWAY_IMPORT}
export interface ${operationStem}ClientOptions {
  readonly baseUrl?: string | URL;
}
type ${apiStem}AuthorizedInvocation = readonly [credential: string, requestCorrelation: string, options?: ${operationStem}ClientOptions];
type ${apiStem}OperationInvocation = readonly [requestCorrelation: string, options?: ${operationStem}ClientOptions];
const ${options.clientHelper} = (
  credential: Redacted.Redacted<string>,
  requestCorrelation: string,
  options: ${operationStem}ClientOptions,
) => {
  const clientConfig = {
    api: ${options.apiValue},
    defaultApiPrefix: '/inventory-stock-api',
    transportHeaders: {
      authorization: Redacted.value(credential),
      'x-correlation-id': requestCorrelation,
    },
  };
  return makeEffectBffClient(
    options.baseUrl === undefined ? clientConfig : { ...clientConfig, baseUrl: options.baseUrl },
  );
};
export const ${options.authorizedOperation} = (
  payload: ${requestType},
  ...[credential, requestCorrelation, options = {}]: ${apiStem}AuthorizedInvocation
) =>
  ${options.clientHelper}(Redacted.make(credential), requestCorrelation, options).pipe(
    Effect.flatMap((client) => client.${options.endpointGroup}.execute(${
      options.invocationKind === MODULE_API_KIND
        ? '{ headers: {}, params: {}, payload, query: {} }'
        : '{ payload }'
    })),
  );
export const ${options.publicOperation} = (
  payload: ${requestType},
  ...[requestCorrelation, options = {}]: ${apiStem}OperationInvocation
) =>
  operationGateway.invoke((credential) =>
    ${options.authorizedOperation}(payload, credential, requestCorrelation, options),
  );`;
};

const problemKinds = [
  ['authentication', 'Authentication', 401],
  ['invalid', 'Invalid', 400],
  ['unavailable', 'Unavailable', 503],
  ['forbidden', 'Forbidden', 403],
  ['notFound', 'NotFound', 404],
  ['policyIneligible', 'Policy', 422],
  ['policyConflict', 'PolicyConflict', 409],
  ['internal', 'Internal', 500],
] as const;

const governedServerFixture = (options: {
  readonly apiValue: string;
  readonly contractImport: string;
  readonly exportedName: string;
  readonly generatedHeader: string;
  readonly group: string;
  readonly readValue: string;
}): string => {
  const provider = options.generatedHeader !== MODULE_API_HEADER;
  const schemaStem = provider
    ? options.apiValue.replace(/(?:Search|Report)Api$/u, 'Provider')
    : options.apiValue.replace(/Api$/u, '');
  const contractStem = path.posix.basename(options.contractImport, '.ts');
  const name = provider ? contractStem.replace(/-(?:search|report)$/u, '') : contractStem;
  let directory = 'api';
  if (provider) {
    directory = options.apiValue.endsWith('ReportApi') ? 'reports' : 'search';
  }
  const readSuffix = provider ? 'provider' : 'read';
  return `${options.generatedHeader}import { HttpApiBuilder } from '@modern-js/plugin-bff/effect-edge';
import { governedReadHttpStatus, makeGovernedReadHttpHandler } from '@app/core-runtime/http/governed-read';
import { authenticateOperationPrincipal } from './auth/action-principal.ts';
import { governedHttpApi } from '../shared/api.ts';
import { ${options.readValue} } from '../src/${directory}/${name}.${readSuffix}.ts';
import { ${problemKinds.map(([, suffix]) => `${schemaStem}${suffix}ProblemSchema`).join(', ')} } from '${options.contractImport}';
const problems = {
${problemKinds.map(([key, suffix]) => `  ${key}: () => ${schemaStem}${suffix}ProblemSchema.make({ status: governedReadHttpStatus.${key}${key === 'unavailable' ? ', retryable: true' : ''} }),`).join('\n')}
};
export const ${options.exportedName} = HttpApiBuilder.group(
  governedHttpApi,
  '${options.group}',
  (handlers) => handlers.handle('execute', makeGovernedReadHttpHandler({
    authenticatePrincipal: authenticateOperationPrincipal,
    problems,
    registration: ${options.readValue},
  })),
);`;
};

const moduleContractFixture = (name: string, type: string, camel: string): string => {
  const schemaStem = type;
  return `${MODULE_API_HEADER}import { HttpApi, HttpApiEndpoint, HttpApiGroup } from 'effect/unstable/httpapi';
import { makeProblemDetailsSchema, makeRetryableProblemDetailsSchema } from '@app/shared-contracts/problem-details';
${problemKinds.map(([key, suffix, status]) => `export const ${schemaStem}${suffix}ProblemSchema = ${key === 'unavailable' ? 'makeRetryableProblemDetailsSchema' : 'makeProblemDetailsSchema'}('${schemaStem}${suffix}Problem', ${status});`).join('\n')}
export const ${type}Api = HttpApi.make('${type}Api').add(HttpApiGroup.make('${camel}').add(HttpApiEndpoint.post('execute', '/reads/${name}', {
  payload: ${type}RequestSchema,
  success: ${type}ResponseSchema,
  error: [${['Invalid', 'Authentication', 'Forbidden', 'NotFound', 'PolicyConflict', 'Policy', 'Unavailable', 'Internal'].map((suffix) => `${type}${suffix}ProblemSchema`).join(', ')}],
})));`;
};

