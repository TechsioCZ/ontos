export const manifest = defineOntosModuleManifest({ module: { id: 'party.registry' } });
`;

const partyOutboxSource = `// @generated by OntOS Codesmith Outbox Message Contract v1
// @ontos-outbox-producer party.registry
// @ontos-outbox-topic party.registry.party-created.v1
import { Schema } from 'effect';
export const OutboxPayloadSchema = Schema.Struct({ partyId: Schema.String });
export const outboxProducerModuleKey = 'party.registry' as const;
`;

test('validates Outbox producer module identity when deployment appId differs from moduleId', () => {
  const moduleId = resolvePublishedContractModuleId({
    dependencyPackageJson: partyPackage,
    dependencyPackageName: '@app/party-registry',
    expectedAppId: 'party-registry',
    manifestSource: partyManifestSource,
  });
  assert.equal(moduleId, 'party.registry');
  assert.doesNotThrow(() =>
    assertPublishedOutboxContractSource({
      moduleId,
      source: partyOutboxSource,
      specifier: '@app/party-registry/outbox/party-created',
    }),
  );
});

test('rejects an Outbox producer that substitutes deployment appId for moduleId', () => {
  assert.throws(
    () =>
      assertPublishedOutboxContractSource({
        moduleId: 'party.registry',
        source: partyOutboxSource.replace(
          '@ontos-outbox-producer party.registry',
          '@ontos-outbox-producer party-registry',
        ),
        specifier: '@app/party-registry/outbox/party-created',
      }),
    /must remain a generated schema-only Outbox contract/u,
  );
});

test('rejects mismatched package and generated manifest ownership for published contracts', () => {
  assert.throws(
    () =>
      resolvePublishedContractModuleId({
        dependencyPackageJson: { ...partyPackage, name: '@app/somewhere-else' },
        dependencyPackageName: '@app/party-registry',
        expectedAppId: 'party-registry',
        manifestSource: partyManifestSource,
      }),
    /package and generated manifest ownership disagree/u,
  );
});

test('keeps executable owner behavior out of published Outbox contracts', () => {
  assert.throws(
    () =>
      assertPublishedOutboxContractSource({
        moduleId: 'party.registry',
        source: `${partyOutboxSource}import { handler } from '../../src/actions/create-party.action.ts';\n`,
        specifier: '@app/party-registry/outbox/party-created',
      }),
    /must remain a generated schema-only Outbox contract/u,
  );
});
test('rejects missing, orphaned, and cross-owner route manifest entries', async () => {
  const root = await makeFixture();
  try {
    await write(
      root,
      'apps/shell-super-app/src/routes/ultramodern-route-metadata.ts',
      `export const routes = [{ entrypoint: { entrypointKey: 'inventory.stock.page.orders' } }];`,
    );
    await assert.rejects(checkModuleEntrypointBoundaries(root), /manifest is stale/u);
  } finally {
    await rm(root, { force: true, recursive: true });
  }
});
