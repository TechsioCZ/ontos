const generatedPartyDetailClientSource = `// @generated by OntOS Codesmith module-api v1
export const executePartyDetail = true;
`;

const generatedPartyCommandClientSource = `// @generated by OntOS Codesmith MicroVertical Command Client v1
// @ontos-command-client-owner party-registry
export const executeCreateParty = true;
