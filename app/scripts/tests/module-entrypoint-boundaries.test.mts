  await write(
    root,
    '.modernjs/ultramodern.json',
    JSON.stringify({
      topology: {
        apps: [
          { id: 'shell-super-app', path: 'apps/shell-super-app' },
          { id: 'inventory-stock', path: 'verticals/inventory-stock' },
