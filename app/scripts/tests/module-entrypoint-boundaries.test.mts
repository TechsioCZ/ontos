for (const [binding, disconnected] of [
  [
    'authenticatePrincipal: authenticateOperationPrincipal',
    'authenticatePrincipal: disconnectedPrincipal',
  ],
  [STOCK_LIST_READ_BINDING, 'registration: unrelatedRead'],
] as const) {
  test(`shared governed HTTP handler requires connected ${binding}`, async () => {
    const root = await makeFixture();
    const serverFile = 'verticals/inventory-stock/api/stock-list-read-server.ts';
    try {
      await writeGovernedModuleApi(root);
      const server = await readFile(path.join(root, serverFile), 'utf-8');
      await checkModuleEntrypointBoundaries(root);
      await write(root, serverFile, server.replace(binding, disconnected));
      await assert.rejects(checkModuleEntrypointBoundaries(root), /module APIs require/u);
      await write(root, serverFile, server);
      await checkModuleEntrypointBoundaries(root);
      await write(
        root,
        serverFile,
        server.replace(
          "from '@app/core-runtime/http/governed-read'",
          "from './unused-neighbor.ts'",
        ),
      );
      await assert.rejects(checkModuleEntrypointBoundaries(root), /module APIs require/u);
    } finally {
      await rm(root, { force: true, recursive: true });
    }
  });
}

