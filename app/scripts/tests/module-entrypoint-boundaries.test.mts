export const PartyRefSchema = Schema.Struct({
  moduleId: Schema.Literal('${PARTY_MODULE_ID}'),
  resourceId: Schema.String,
  resourceType: Schema.Literal('party.registry.party'),
  tenantId: Schema.String,
});
export type PartyRef = typeof PartyRefSchema.Type;
export const partyResourceDescriptor = {
  capabilities: {
    graphVisible: false,
    linkable: true,
    mediaAttachable: false,
    searchable: true,
    timelineVisible: true,
  },
  description: 'Party resource.',
  key: 'party.registry.party',
