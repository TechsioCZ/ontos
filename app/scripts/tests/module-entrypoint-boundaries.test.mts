const violations = [
  {
    expected: /raw loadRemote.*approved Shell module-entrypoint loader/u,
    file: 'apps/shell-super-app/src/raw-remote.ts',
    source: `loadRemote /* bypass attempt */ ('inventory/Widget');`,
  },
  {
    expected: /cross-vertical private imports.*gateway/u,
    file: 'verticals/inventory-stock/src/private-import.ts',
    source: `import value from /* bypass attempt */ '@app/billing/src/handlers/private.ts';`,
  },
  {
    expected: /private handler accessors.*module-state gate/u,
    file: 'apps/shell-super-app/src/direct-handler.ts',
    source: `getActionHandler /* bypass attempt */ (registration);`,
  },
  {
    expected: /module APIs require an approved Codesmith generator.*ModuleEntrypointGateway/u,
    file: 'verticals/inventory-stock/shared/api.ts',
    source: `export const endpoint = HttpApiEndpoint /* bypass attempt */ .make('orders');`,
  },
  {
    expected: /public components, search, and reports require an approved Codesmith generator/u,
    file: 'verticals/inventory-stock/src/public-components/card.tsx',
    source: `export const Card = () => null;`,
  },
  {
    expected: /public components, search, and reports require an approved Codesmith generator/u,
    file: 'verticals/inventory-stock/src/search/orders.ts',
    source: `export const search = true;`,
  },
  {
    expected: /public components, search, and reports require an approved Codesmith generator/u,
    file: 'verticals/inventory-stock/src/reports/orders.ts',
    source: `export const report = true;`,
  },
  {
    expected: /eager remote implementation imports.*lazy thunk/u,
    file: 'verticals/inventory-stock/src/eager.ts',
    source: `import Widget from /* bypass attempt */ 'inventory/remote/Widget';`,
  },
  {
    expected: /package exports must not publish private/u,
    file: 'verticals/inventory-stock/package.json',
    source: `{"exports":{"./private":"./src/db/schema.ts"}}`,
  },
  {
    expected: /reserved generated-public-component-registrations slots/u,
    file: 'verticals/inventory-stock/vertical.registration.ts',
    source: `export const registration = {};`,
  },
  {
    expected: /Core may export only module-entrypoint descriptors/u,
    file: 'packages/core-runtime/src/index.ts',
    source: `export { makeModuleStateSnapshot } from './modules/module-state-gate.ts';`,
  },
] as const;

for (const violation of violations) {
  it.live(`rejects bypass ${violation.file}`, () =>
    Effect.gen(function* testEffect6() {
      const root = yield* makeFixture();
      yield* write(root, violation.file, violation.source);
      expect(
        ((error: Error) => {
          expect(error.message).toMatch(violation.expected);
          expect(error.message).toMatch(
            new RegExp(violation.file.replaceAll('.', String.raw`\.`), 'u'),
          );
          expect(error.message).not.toMatch(/Widget =|endpoint =|registration =/u);
          return true;
        })(yield* Effect.flip(checkModuleEntrypointBoundaries(root))),
      ).toBe(true);
    }),
  );
}

