import assert from 'node:assert/strict';
import { mkdtemp, mkdir, rm, writeFile } from 'node:fs/promises';
import os from 'node:os';
import path from 'node:path';
import test from 'node:test';
import { checkModuleEntrypointBoundaries } from '../check-module-entrypoint-boundaries.mts';

const ACTION_HEADER_FOR_TEST = '// @generated by OntOS Codesmith Action v1';
const validAction = `${ACTION_HEADER_FOR_TEST}
// @ontos-action-owner inventory.stock
// @ontos-action-slug reserve
const entrypoint = defineTenantModuleEntrypoint({ access: 'write', entrypointKey: 'inventory.stock.reserve', moduleKey: 'inventory.stock', role: 'action' });
`;
const validWorker = `// @generated by OntOS Codesmith Outbox Worker v1
// @ontos-outbox-worker-key inventory.stock.project
// @ontos-outbox-worker-owner inventory.stock
// @ontos-outbox-worker-producer producer.core
// @ontos-outbox-worker-topic producer.created
const entrypoint = defineTenantModuleEntrypoint({ access: 'background', entrypointKey: 'inventory.stock.project', moduleKey: 'inventory.stock', role: 'worker' });
`;

const write = async (root: string, file: string, source: string): Promise<void> => {
  const target = path.join(root, file);
  await mkdir(path.dirname(target), { recursive: true });
  await writeFile(target, source, 'utf-8');
};

const makeFixture = async (): Promise<string> => {
  const root = await mkdtemp(path.join(os.tmpdir(), 'ontos-module-entrypoints-'));
  await write(
    root,
    '.modernjs/ultramodern.json',
    JSON.stringify({
      topology: {
        apps: [
          { id: 'shell-super-app', path: 'apps/shell-super-app' },
          { id: 'inventory-stock', path: 'verticals/inventory-stock' },
        ],
      },
    }),
  );
  await write(
    root,
    'apps/shell-super-app/src/routes/home/route.meta.ts',
    `
import { defineSystemModuleEntrypoint } from '@app/core-runtime';
export const routeMeta = { ownerAppId: 'shell-super-app', entrypoint: defineSystemModuleEntrypoint({ access: 'read', entrypointKey: 'shell-super-app.page.home', moduleKey: 'shell-super-app', role: 'page' }) };
`,
  );
  await write(
    root,
    'apps/shell-super-app/src/routes/ultramodern-route-metadata.ts',
    `export const routes = [{ entrypoint: { entrypointKey: 'shell-super-app.page.home' } }, { entrypoint: { entrypointKey: 'inventory.stock.page.orders' } }];`,
  );
  await write(
    root,
    'verticals/inventory-stock/src/routes/orders/route.meta.ts',
    `
import { defineTenantModuleEntrypoint } from '@app/core-runtime';
export const routeMeta = { moduleId: 'inventory.stock', ownerAppId: 'inventory-stock', entrypoint: defineTenantModuleEntrypoint({ access: 'read', entrypointKey: 'inventory.stock.page.orders', moduleKey: 'inventory.stock', role: 'page' }) };
`,
  );
  await write(root, 'verticals/inventory-stock/src/actions/reserve.action.ts', validAction);
  await write(root, 'verticals/inventory-stock/src/workers/project.worker.ts', validWorker);
  await write(root, 'packages/core-runtime/src/index.ts', `export const core = true;`);
  return root;
};

test('accepts governed generated Actions, pages, Workers, catalogs, and route manifests', async () => {
  const root = await makeFixture();
  try {
    await checkModuleEntrypointBoundaries(root);
  } finally {
    await rm(root, { force: true, recursive: true });
  }
});

const violations = [
  {
    expected: /raw loadRemote.*approved Shell module-entrypoint loader/u,
    file: 'apps/shell-super-app/src/raw-remote.ts',
    source: `loadRemote /* bypass attempt */ ('inventory/Widget');`,
  },
  {
    expected: /cross-vertical private imports.*gateway/u,
    file: 'verticals/inventory-stock/src/private-import.ts',
    source: `import value from /* bypass attempt */ '@app/billing/src/handlers/private.ts';`,
  },
  {
    expected: /private handler accessors.*module-state gate/u,
    file: 'apps/shell-super-app/src/direct-handler.ts',
    source: `getActionHandler /* bypass attempt */ (registration);`,
  },
  {
    expected: /module APIs require an approved Codesmith generator.*ModuleEntrypointGateway/u,
    file: 'verticals/inventory-stock/shared/api.ts',
    source: `export const endpoint = HttpApiEndpoint /* bypass attempt */ .make('orders');`,
  },
  {
    expected: /public components, search, and reports require an approved Codesmith generator/u,
    file: 'verticals/inventory-stock/src/public-components/card.tsx',
    source: `export const Card = () => null;`,
  },
  {
    expected: /public components, search, and reports require an approved Codesmith generator/u,
    file: 'verticals/inventory-stock/src/search/orders.ts',
    source: `export const search = true;`,
  },
  {
    expected: /public components, search, and reports require an approved Codesmith generator/u,
    file: 'verticals/inventory-stock/src/reports/orders.ts',
    source: `export const report = true;`,
  },
  {
    expected: /eager remote implementation imports.*lazy thunk/u,
    file: 'verticals/inventory-stock/src/eager.ts',
    source: `import Widget from /* bypass attempt */ 'inventory/remote/Widget';`,
  },
  {
    expected: /package exports must not publish private/u,
    file: 'verticals/inventory-stock/package.json',
    source: `{"exports":{"./private":"./src/db/schema.ts"}}`,
  },
  {
    expected: /reserved generated-public-component-registrations slots/u,
    file: 'verticals/inventory-stock/vertical.registration.ts',
    source: `export const registration = {};`,
  },
  {
    expected: /Core may export only module-entrypoint descriptors/u,
    file: 'packages/core-runtime/src/index.ts',
    source: `export { makeModuleStateSnapshot } from './modules/module-state-gate.ts';`,
  },
] as const;

for (const violation of violations) {
  test(`rejects bypass ${violation.file}`, async () => {
    const root = await makeFixture();
    try {
      await write(root, violation.file, violation.source);
      await assert.rejects(checkModuleEntrypointBoundaries(root), (error: Error) => {
        assert.match(error.message, violation.expected);
        assert.match(error.message, new RegExp(violation.file.replaceAll('.', '\\.'), 'u'));
        assert.doesNotMatch(error.message, /Widget =|endpoint =|registration =/u);
        return true;
      });
    } finally {
      await rm(root, { force: true, recursive: true });
    }
  });
}

test('rejects missing headers, spoofed metadata, and stale generated descriptors', async () => {
  const root = await makeFixture();
  try {
    await write(
      root,
      'verticals/inventory-stock/src/actions/reserve.action.ts',
      `${ACTION_HEADER_FOR_TEST}
// @ontos-action-owner inventory.stock
// @ontos-action-slug reserve
export const stale = true;
`,
    );
    await assert.rejects(checkModuleEntrypointBoundaries(root), /scaffold:action/u);
    await write(
      root,
      'verticals/inventory-stock/src/actions/reserve.action.ts',
      `export const ignored = true;`,
    );
    await assert.rejects(checkModuleEntrypointBoundaries(root), /scaffold:action/u);
    await write(
      root,
      'verticals/inventory-stock/src/actions/reserve.action.ts',
      `${ACTION_HEADER_FOR_TEST}
// @ontos-action-owner inventory.stock
// @ontos-action-slug reserve
// defineTenantModuleEntrypoint({ access: 'write', entrypointKey: 'inventory.stock.reserve', moduleKey: 'inventory.stock', role: 'action' });
export const spoofed = true;
`,
    );
    await assert.rejects(checkModuleEntrypointBoundaries(root), /scaffold:action/u);
    await write(root, 'verticals/inventory-stock/src/actions/reserve.action.ts', validAction);
    await write(
      root,
      'verticals/inventory-stock/src/workers/project.worker.ts',
      `// @generated by OntOS Codesmith Outbox Worker v1
// @ontos-outbox-worker-key inventory.stock.project
// @ontos-outbox-worker-owner inventory.stock
export const stale = true;
`,
    );
    await assert.rejects(checkModuleEntrypointBoundaries(root), /scaffold:outbox-worker/u);
    await write(
      root,
      'verticals/inventory-stock/src/workers/project.worker.ts',
      `export const ignored = true;`,
    );
    await assert.rejects(checkModuleEntrypointBoundaries(root), /scaffold:outbox-worker/u);
  } finally {
    await rm(root, { force: true, recursive: true });
  }
});
