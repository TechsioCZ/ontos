/**
 * The module-api read rule in the final v2 contract (O62): a `protected` read decides its own record,
 * declares its own carrier and names no legacy permission target, while a read on any other
 * classification still has to name the permission target it is decided by.
 *
 * Self-contained on purpose: the v2 shape leaves an *empty* argument slot behind, which the rule sees
 * as the empty text a trailing comma produces or as the explicit `undefined` placeholders that keep a
 * later executable-policy argument in position. The callback layer of the same seam (where those slots
 * accept only an absent value, never a substitution) is covered end to end by the Pricing seam test in
 * `module-entrypoint-boundaries-*.test.mts`.
 */
import { expect, it } from 'effect-rstest';

import {
  hasGeneratedModuleApiReadContract,
  hasMatchingProviderLegalEntityScope,
} from '../generated-module-api-boundary.mts';

const MODULE_ID = 'inventory.stock';
const NAME = 'stock-list';
const KEY = `${MODULE_ID}.api.${NAME}`;
const MODULE_API_HEADER = '// @generated by OntOS Codesmith module-api v1\n';
const PROTECTED_AUTHORIZATION = "{ kind: 'protected' }";
const AUTHENTICATED_AUTHORIZATION = "{ kind: 'authenticated_principal' }";
const DECLARATION =
  "{ key: 'inventory.stock.api.stock-list.read', kind: 'read', modes: ['run'], placement: { group: 'stock', level: 'basic' }, risk: 'routine', selectors: [] }";

interface ReadSourceOptions {
  readonly authorization: string;
  readonly declaration?: string;
  readonly permissionTarget?: string;
  /** Everything after the service-factory argument, including its leading comma. */
  readonly resolverArguments: string;
}

const readSource = (
  options: ReadSourceOptions,
): string => `${MODULE_API_HEADER}import { defineRead, defineTenantModuleEntrypoint } from '@app/core-runtime';

export const stockListEntrypoint = defineTenantModuleEntrypoint({
  access: 'read',
  authorization: ${options.authorization},
  entrypointKey: '${KEY}',
  moduleKey: '${MODULE_ID}',
  role: 'api',
});

export const stockListRead = defineRead(
  {
${options.declaration === undefined ? '' : `    accessDeclaration: ${options.declaration},\n`}    accessKind: 'detail',
    entrypoint: stockListEntrypoint,
    evidencePolicy: { captureMode: 'metadata_only', policyKey: '${KEY}.evidence.v1' },
    inputSchema: StockListRequestSchema,
    legalEntityScope: 'optional',
    owningModuleKey: '${MODULE_ID}',
${options.permissionTarget === undefined ? '' : `    permissionTarget: '${options.permissionTarget}',\n`}    policies: [],
    readKey: '${KEY}',
    resultSchema: StockListResponseSchema,
    schemaVersion: '1',
  },
  () => Effect.succeed({ evidence: { resultCount: 0 }, result: [] }),
  () => Layer.empty${options.resolverArguments}
);`;

const v2Read = (resolverArguments: string): string =>
  readSource({ authorization: PROTECTED_AUTHORIZATION, declaration: DECLARATION, resolverArguments });

const acceptsProtectedRead = (source: string): boolean =>
  hasGeneratedModuleApiReadContract(source, MODULE_ID, NAME, { kind: 'protected' });

it('accepts the empty resolver slots a v2 protected read leaves behind', () => {
  // No resolver argument at all.
  expect(acceptsProtectedRead(v2Read(''))).toBe(true);
  // The formatter's multiline shape: a trailing comma leaves an empty final slot.
  expect(acceptsProtectedRead(v2Read(',\n'))).toBe(true);
  // A read that still carries an executable-policy list keeps the two legacy slots as explicit holes.
  expect(acceptsProtectedRead(v2Read(',\n  undefined,\n  undefined,\n  []'))).toBe(true);
  // The permission target is still accepted on the same read until the module lanes drop the field
  // and C03b makes it required-absent (O62, O68).
  const transitional = readSource({
    authorization: PROTECTED_AUTHORIZATION,
    declaration: DECLARATION,
    permissionTarget: 'module',
    resolverArguments: ",\n  () => ({ kind: 'module', moduleId: 'inventory.stock' })",
  });
  expect(acceptsProtectedRead(transitional)).toBe(true);
});

it('refuses a read on any other classification that names no permission target', () => {
  const unprotectedWithoutTarget = readSource({
    authorization: AUTHENTICATED_AUTHORIZATION,
    resolverArguments: ',\n',
  });
  // The legacy gate is the permission target, so its absence is never an implicit allow.
  expect(
    hasGeneratedModuleApiReadContract(unprotectedWithoutTarget, MODULE_ID, NAME, {
      kind: 'authenticated_principal',
    }),
  ).toBe(false);
  // Negative control: the same read with its target and resolver is still the accepted shape.
  const unprotectedWithTarget = readSource({
    authorization: AUTHENTICATED_AUTHORIZATION,
    permissionTarget: 'tenant',
    resolverArguments: ",\n  () => ({ kind: 'tenant', permission: 'manage_identity' })",
  });
  expect(
    hasGeneratedModuleApiReadContract(unprotectedWithTarget, MODULE_ID, NAME, {
      kind: 'authenticated_principal',
    }),
  ).toBe(true);
});

const searchProviderSource = (
  legalEntityScope: string,
): string => `${MODULE_API_HEADER}import { defineRead, defineTenantModuleEntrypoint } from '@app/core-runtime';

export const stockListEntrypoint = defineTenantModuleEntrypoint({
  access: 'read',
  authorization: { kind: 'protected' },
  entrypointKey: '${MODULE_ID}.search.${NAME}',
  moduleKey: '${MODULE_ID}',
  role: 'search',
});

export const stockListRead = defineRead(
  {
    accessDeclaration: ${DECLARATION},
    accessKind: 'search',
    entrypoint: stockListEntrypoint,
    evidencePolicy: { captureMode: 'metadata_only', policyKey: '${MODULE_ID}.search.${NAME}.v1' },
    inputSchema: StockListRequestSchema,
    legalEntityScope: '${legalEntityScope}',
    owningModuleKey: '${MODULE_ID}',
    policies: [],
    readKey: '${MODULE_ID}.search.${NAME}',
    resultSchema: StockListResponseSchema,
    schemaVersion: '1',
  },
  () => Effect.succeed({ evidence: { resultCount: 0 }, result: [] }),
  () => Layer.empty,
);
`;

const manifestWithSearchScope = (descriptorScope?: string): string => `export const m = {
  search: [
    // <generated-module-manifest-search>
    {
      accessFiltering: 'resource_permission',
      accessKey: '${MODULE_ID}.${NAME}.search',
      key: '${MODULE_ID}.${NAME}',
${descriptorScope === undefined ? '' : `      legalEntityScope: '${descriptorScope}',\n`}      owningModuleId: '${MODULE_ID}',
      resourceType: '${MODULE_ID}.record',
    },
    // </generated-module-manifest-search>
  ],
};
`;

it('keeps a search descriptor in the scope its own provider read declares (O78)', () => {
  const provider = searchProviderSource('optional');
  // The descriptor names the same scope as the read: accepted.
  expect(
    hasMatchingProviderLegalEntityScope(provider, manifestWithSearchScope('optional'), MODULE_ID, NAME, 'search'),
  ).toBe(true);
  // Transitional: while `accessFiltering` still exists an absent value is tolerated, but never a different one.
  expect(hasMatchingProviderLegalEntityScope(provider, manifestWithSearchScope(), MODULE_ID, NAME, 'search')).toBe(
    true,
  );
  expect(
    hasMatchingProviderLegalEntityScope(provider, manifestWithSearchScope('required'), MODULE_ID, NAME, 'search'),
  ).toBe(false);
  // Negative control: a descriptor that does not describe this provider is not silently accepted.
  const otherProvider = manifestWithSearchScope('optional').replaceAll(
    `key: '${MODULE_ID}.${NAME}'`,
    `key: '${MODULE_ID}.other'`,
  );
  expect(hasMatchingProviderLegalEntityScope(provider, otherProvider, MODULE_ID, NAME, 'search')).toBe(false);
});
