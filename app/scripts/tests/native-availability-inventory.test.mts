import { readFileSync, readdirSync } from 'node:fs';
import path from 'node:path';
import { expect, it } from 'effect-rstest';

import { hasCompleteGeneratedModuleApiSeam } from '../generated-governed-http-boundary.mts';

// Availability ships a generated readiness-only foundation. Its preserved owner-local read
// declaration (`shared/apis/current-availability.ts`) is deliberately not registered until the live
// owner integration lands (#874), so `shared/api.ts` publishes no business API surface. The official
// boundary checkers exempt a readiness foundation (`isGeneratedInfrastructureReadinessApi`) before
// they ask for a module API seam, so a direct `hasCompleteGeneratedModuleApiSeam` call is the only
// place that reports the empty inventory. These tests pin that intentional state and the inventory
// gate, so a later regeneration cannot silently publish the preserved declaration without review.
const root = path.resolve(import.meta.dirname, '../..');
const owner = 'verticals/availability';
const sharedApi = `${owner}/shared/api.ts`;
const manifestFile = `${owner}/vertical.manifest.ts`;
const registrationFile = `${owner}/vertical.registration.ts`;
const declarationFile = `${owner}/shared/apis/current-availability.ts`;
const readFile = `${owner}/src/api/current-availability.read.ts`;
const moduleApiHeader = '// @generated by OntOS Codesmith module-api v1';
const inventoryDiagnostic = 'manifest or registration contribution inventory';
const manifestApiSlot = '// <generated-module-manifest-apis>';
const manifestApiSlotEnd = '// </generated-module-manifest-apis>';
const registrationApiSlot = '// <generated-module-registration-apis>';
const registrationApiSlotEnd = '// </generated-module-registration-apis>';

const readSources = (directory: string, sources = new Map<string, string>()) => {
  for (const entry of readdirSync(path.join(root, directory), { withFileTypes: true })) {
    if (['node_modules', 'dist', '.output', '.modern', 'coverage', 'cloudflare-dist'].includes(entry.name)) {
      continue;
    }
    const file = `${directory}/${entry.name}`;
    if (entry.isDirectory()) {
      readSources(file, sources);
    } else if (entry.name.endsWith('.ts') || entry.name === 'package.json') {
      sources.set(file, readFileSync(path.join(root, file), 'utf-8'));
    }
  }
  return sources;
};

const slotBody = (source: string, start: string, end: string): string => {
  const startIndex = source.indexOf(start);
  const endIndex = source.indexOf(end);
  expect(startIndex, `${start} must be present`).toBeGreaterThanOrEqual(0);
  expect(endIndex, `${end} must follow ${start}`).toBeGreaterThan(startIndex);
  return source.slice(startIndex + start.length, endIndex);
};

const availabilityInventory = (manifestAdd: string, registrationAdd: string) => {
  const sources = readSources(owner);
  const manifest = sources.get(manifestFile) ?? '';
  const registration = sources.get(registrationFile) ?? '';
  return new Map([
    ...sources,
    [manifestFile, manifest.replace(manifestApiSlot, `${manifestApiSlot}${manifestAdd}`)],
    [registrationFile, registration.replace(registrationApiSlot, `${registrationApiSlot}${registrationAdd}`)],
  ]);
};

const seamDiagnostics = (sources: ReadonlyMap<string, string>): readonly string[] => {
  const diagnostics: string[] = [];
  expect(hasCompleteGeneratedModuleApiSeam(sources, sharedApi, 'availability', diagnostics)).toBe(false);
  return diagnostics;
};

it('keeps the availability foundation readiness-only with an intentionally empty API inventory', () => {
  const sources = readSources(owner);
  const shared = sources.get(sharedApi) ?? '';
  // The published contract stays a readiness-only foundation: one readiness endpoint, one composed api.
  const endpoints = [...shared.matchAll(/HttpApiEndpoint\.(?:get|post)\(\s*'(?<name>[^']+)'/gu)].map(
    (match) => match.groups?.name,
  );
  expect(endpoints).toEqual(['readiness']);
  expect([...shared.matchAll(/\.addHttpApi\s*\(/gu)]).toHaveLength(1);
  expect(shared).toContain('export const availabilityApiContract = {');
  expect(shared).toContain("readinessPath: '/availability-api/availability/readiness'");
  // The preserved declaration and owner-local read are genuinely generated...
  expect(sources.get(declarationFile) ?? '').toContain(moduleApiHeader);
  expect(sources.get(readFile) ?? '').toContain(moduleApiHeader);
  // ...but nothing is registered: both generated inventories stay empty.
  expect(slotBody(sources.get(manifestFile) ?? '', manifestApiSlot, manifestApiSlotEnd).trim()).toBe('');
  expect(slotBody(sources.get(registrationFile) ?? '', registrationApiSlot, registrationApiSlotEnd).trim()).toBe('');
  // A direct seam call therefore reports exactly the inventory gate and nothing else.
  expect(seamDiagnostics(sources)).toEqual([inventoryDiagnostic]);
});

const entry = (key: string) => `\n      '${key}': CurrentAvailabilityApi,`;
const loader = (key: string, file: string) => `\n      '${key}': () => import('./src/api/${file}'),`;
const currentAvailability = 'current-availability';

it('clears the availability inventory gate only for a consistent manifest and registration inventory', () => {
  const consistentManifest = entry(currentAvailability);
  const consistentLoader = loader(currentAvailability, 'current-availability-client.ts');
  // Positive: a consistent inventory satisfies the gate; the seam then still fails on later publication proof.
  const cleared = seamDiagnostics(availabilityInventory(consistentManifest, consistentLoader));
  expect(cleared).not.toContain(inventoryDiagnostic);
  expect(cleared.length).toBeGreaterThan(0);
  // Negatives: partial, duplicated or stray inventories keep the gate diagnostic.
  const mismatches: readonly (readonly [string, string])[] = [
    [consistentManifest, ''],
    ['', consistentLoader],
    [`${entry(currentAvailability)}${entry(currentAvailability)}`, consistentLoader],
    [consistentManifest, `${consistentLoader}${consistentLoader}`],
    [`${consistentManifest}${entry('other-read')}`, consistentLoader],
    [entry('foreign-read'), consistentLoader],
  ];
  for (const [manifestAdd, registrationAdd] of mismatches) {
    expect(seamDiagnostics(availabilityInventory(manifestAdd, registrationAdd))).toContain(inventoryDiagnostic);
  }
});
