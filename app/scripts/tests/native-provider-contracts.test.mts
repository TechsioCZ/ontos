import { readFile } from 'node:fs/promises';
import { Effect } from 'effect';
import { expect, it } from 'effect-rstest';
import {
  hasGeneratedGovernedClientContract,
  hasGeneratedProviderApiContract,
  hasGeneratedProviderManifest,
  hasGeneratedProviderReadContract,
  hasGeneratedProviderRegistration,
  hasMatchingGeneratedProviderAuthorization,
  hasMatchingProviderLegalEntityScope,
} from '../generated-module-api-boundary.mts';
import { hasGeneratedGovernedServerContract } from '../generated-governed-http-boundary.mts';

const moduleId = 'commerce.market-catalog';
const providerName = 'markets';
const deploymentAppId = 'commerce-market-catalog';
const ownerDirectory = `../../verticals/${deploymentAppId}/`;
const source = (file: string) =>
  Effect.promise(() => readFile(new URL(`${ownerDirectory}${file}`, import.meta.url), 'utf-8'));
const ownerSources = Effect.all({
  manifestSource: source('vertical.manifest.ts'),
  runtimeDeclarationSource: source('vertical.runtime-declaration.ts'),
});
const providerSource = source('src/search/markets.provider.ts');
const completeManifest = (sources: { readonly manifestSource: string; readonly runtimeDeclarationSource: string }) =>
  `${sources.manifestSource}\n${sources.runtimeDeclarationSource}`;
const acceptsManifest = (sources: { readonly manifestSource: string; readonly runtimeDeclarationSource: string }) =>
  hasGeneratedProviderManifest(completeManifest(sources), moduleId, providerName, 'search', sources);
const acceptsRead = (provider: string) =>
  hasGeneratedProviderReadContract(provider, moduleId, providerName, 'search', { kind: 'protected' });

it.effect(
  'accepts the actual mounted market search, its native owner bindings, schemas, and authenticated transport',
  () =>
    Effect.gen(function* actualNativeProvider() {
      const [provider, owners, registration, contract, client, server, sharedApi] = yield* Effect.all([
        providerSource,
        ownerSources,
        source('vertical.registration.ts'),
        source('shared/apis/markets-search.ts'),
        source('src/api/markets-search-client.ts'),
        source('api/markets-search-server.ts'),
        source('shared/api.ts'),
      ]);
      const manifest = completeManifest(owners);
      expect(acceptsRead(provider)).toBe(true);
      expect(acceptsManifest(owners)).toBe(true);
      expect(hasMatchingGeneratedProviderAuthorization(provider, manifest, moduleId, providerName, 'search')).toBe(
        true,
      );
      expect(hasMatchingProviderLegalEntityScope(provider, manifest, moduleId, providerName, 'search')).toBe(true);
      expect(hasGeneratedProviderRegistration(registration, providerName, 'search')).toBe(true);
      expect(hasGeneratedProviderApiContract(contract, 'MarketsSearchApi', moduleId, providerName, 'search')).toBe(
        true,
      );
      expect(
        hasGeneratedGovernedClientContract(client, {
          authorizedOperation: 'loadMarketsClientWithAuthorization',
          defaultApiPrefix: `/${deploymentAppId}-api`,
          endpointGroup: 'marketsSearch',
          generatedHeader:
            '// @generated by OntOS Codesmith Governed Contribution v1\n// @ontos-contribution-kind search-provider\n',
          invocationKind: 'provider',
          ownerApiValue: 'MarketsSearchApi',
          ownerContractImport: '../../shared/apis/markets-search.ts',
          publicOperation: 'loadMarketsClient',
        }),
      ).toBe(true);
      expect(hasGeneratedGovernedServerContract(server, 'marketsReadApiLive', sharedApi, deploymentAppId)).toBe(true);
    }),
);

const PROTECTED_AUTHORIZATION = "authorization: { kind: 'protected' }";

it.effect('matches authorization through the actual immutable provider entrypoint binding, not its name', () =>
  Effect.gen(function* connectedNativeProviderAuthorization() {
    const [provider, owners] = yield* Effect.all([providerSource, ownerSources]);
    const manifest = completeManifest(owners);
    const renamed = provider.replaceAll('marketsEntrypoint', 'scopedMarketsEntrypoint');
    expect(renamed).not.toBe(provider);
    expect(acceptsRead(renamed)).toBe(true);
    expect(hasMatchingGeneratedProviderAuthorization(renamed, manifest, moduleId, providerName, 'search')).toBe(true);

    const foreign = `${provider.replace('entrypoint: marketsEntrypoint', 'entrypoint: foreignEntrypoint')}\nimport { foreignEntrypoint } from './foreign-entrypoint.ts';`;
    expect(hasMatchingGeneratedProviderAuthorization(foreign, manifest, moduleId, providerName, 'search')).toBe(false);
  }),
);

it.effect('rejects changed provider authority, identity, scope, and foreign constructor or entrypoint bindings', () =>
  Effect.gen(function* rejectedNativeReadBindings() {
    const provider = yield* providerSource;
    const invalidSources = [
      provider.replace(PROTECTED_AUTHORIZATION, "authorization: { kind: 'public' }"),
      provider.replace(PROTECTED_AUTHORIZATION, "authorization: 'protected'"),
      provider.replace(PROTECTED_AUTHORIZATION, "authorization: { kind: 'context_permission' }"),
      provider.replace("const moduleKey = 'commerce.market-catalog'", "const moduleKey = 'foreign.module'"),
      provider.replace('const moduleKey =', 'let moduleKey ='),
      provider.replace(
        "readKey: 'commerce.market-catalog.search.markets'",
        "readKey: 'commerce.market-catalog.search.other'",
      ),
      provider.replace("    legalEntityScope: 'required',\n", ''),
      provider.replace("from '@app/core-runtime'", "from './foreign-core.ts'"),
      `${provider.replace('entrypoint: marketsEntrypoint', 'entrypoint: foreignEntrypoint')}\nimport { foreignEntrypoint } from './foreign-entrypoint.ts';`,
      `${provider}\nforeignConsumer(marketsEntrypoint);`,
    ];
    for (const invalid of invalidSources) {
      expect(invalid).not.toBe(provider);
      expect(acceptsRead(invalid)).toBe(false);
    }
  }),
);

it.effect('rejects changed manifest ownership, identity, authority, or foreign runtime bindings', () =>
  Effect.gen(function* rejectedNativeManifestBindings() {
    const [provider, owners] = yield* Effect.all([providerSource, ownerSources]);
    const invalidSources = [
      {
        ...owners,
        manifestSource: owners.manifestSource.replace(
          "from './vertical.runtime-declaration.ts'",
          "from '../foreign/vertical.runtime-declaration.ts'",
        ),
      },
      {
        ...owners,
        manifestSource: owners.manifestSource.replace("from '@app/core-runtime'", "from './foreign-core.ts'"),
      },
      {
        ...owners,
        runtimeDeclarationSource: owners.runtimeDeclarationSource.replace(
          "const moduleKey = 'commerce.market-catalog'",
          "const moduleKey = 'foreign.module'",
        ),
      },
      {
        ...owners,
        runtimeDeclarationSource: owners.runtimeDeclarationSource.replace('const moduleKey =', 'let moduleKey ='),
      },
      {
        ...owners,
        manifestSource: owners.manifestSource.replace('owningModuleId: moduleKey', "owningModuleId: 'foreign.module'"),
      },
      {
        ...owners,
        manifestSource: owners.manifestSource.replace(
          "key: 'commerce.market-catalog.markets'",
          "key: 'commerce.market-catalog.other'",
        ),
      },
      {
        ...owners,
        runtimeDeclarationSource: owners.runtimeDeclarationSource.replace(
          "searchKey: 'commerce.market-catalog.markets'",
          "searchKey: 'commerce.market-catalog.other'",
        ),
      },
      {
        ...owners,
        runtimeDeclarationSource: owners.runtimeDeclarationSource.replace("role: 'search'", "role: 'api'"),
      },
      {
        ...owners,
        runtimeDeclarationSource: `${owners.runtimeDeclarationSource.replaceAll('moduleKey,', 'moduleKey: foreignModuleKey,')}\nimport { foreignModuleKey } from './foreign-owner.ts';`,
      },
    ];
    for (const invalid of invalidSources) {
      expect(completeManifest(invalid)).not.toBe(completeManifest(owners));
      expect(acceptsManifest(invalid)).toBe(false);
    }
    const changedAuthority = owners.runtimeDeclarationSource.replaceAll(
      PROTECTED_AUTHORIZATION,
      "authorization: { kind: 'public' }",
    );
    expect(changedAuthority).not.toBe(owners.runtimeDeclarationSource);
    expect(
      hasMatchingGeneratedProviderAuthorization(
        provider,
        completeManifest({ ...owners, runtimeDeclarationSource: changedAuthority }),
        moduleId,
        providerName,
        'search',
      ),
    ).toBe(false);
  }),
);

it.effect('requires the projected contributions to belong to the supplied original owner objects', () =>
  Effect.gen(function* closedNativeManifestProjection() {
    const owners = yield* ownerSources;
    const manifest = completeManifest(owners);
    // A projected shorthand without its original source binding is not an identity proof.
    expect(hasGeneratedProviderManifest(manifest, moduleId, providerName, 'search')).toBe(false);
    const changedDescriptor = manifest.replace('owningModuleId: moduleKey', "owningModuleId: 'foreign.module'");
    expect(hasGeneratedProviderManifest(changedDescriptor, moduleId, providerName, 'search', owners)).toBe(false);
    const changedShell = manifest.replace("role: 'search'", "role: 'api'");
    expect(hasGeneratedProviderManifest(changedShell, moduleId, providerName, 'search', owners)).toBe(false);
    const decoy = owners.manifestSource.replace('  publicSurface: {', '  unusedSurface: {');
    expect(acceptsManifest({ ...owners, manifestSource: decoy })).toBe(false);
    const shellDecoy = owners.runtimeDeclarationSource.replace(
      '    shellContributions: {',
      '    unusedContributions: {',
    );
    expect(acceptsManifest({ ...owners, runtimeDeclarationSource: shellDecoy })).toBe(false);
  }),
);
