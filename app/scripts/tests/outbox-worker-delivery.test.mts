      /^ {8}PARTY_REGISTRY_DATABASE_URL:.*\$\{migrator_PARTY_REGISTRY_DB_PASSWORD\}.*\n/mu,
      '',
    );
    const failure = yield* Effect.tryPromise(() => generateOutboxWorkerDeployment(root, missingDedicated)).pipe(
      Effect.flip,
    );
    expect(String(failure.cause)).toContain('Missing PARTY_REGISTRY_DATABASE_URL for party-registry');
  }),
);
