it.live('generates a separate supervised worker setup without changing owner configuration', () =>
  Effect.gen(function* testEffect2() {
    const root = yield* makeFixture();
    const owner = `zerops:\n  - setup: 'ledger'\n    build:\n      buildCommands:\n        - cd app && pnpm --filter '@app/ledger' run build\n        - cd app && pnpm run zerops:materialize --app 'ledger' --package '@app/ledger' --package-dir 'verticals/ledger'\n        - cp 'app/topology/reference-topology.json' 'app/.zerops/runtime/ledger/topology.json'\n      deployFiles:\n        - 'app/.zerops/runtime/ledger'\n    run:\n      base: 'nodejs@24'\n      envVariables:\n        DATABASE_URL: postgresql://ontos_runtime:\${db18_password}@\${db18_hostname}:\${db18_port}/\${db18_dbName}\n        PORT: '4110'\n        VERTICAL_LEDGER_PORT: '4110'\n        ONTOS_KEEP_ME: 'true'\n        ULTRAMODERN_ZEROPS_SERVICE: ledger\n      healthCheck:\n        httpGet:\n          path: '/ledger-api/ledger/readiness'\n      start: sh -c 'cd app/.zerops/runtime/ledger && exec npm run serve'\n`;
    const { deployment: generated } = yield* Effect.tryPromise(() => generateOutboxWorkerDeployment(root, owner));
    const [, workerAndHost] = generated.split("setup: 'ledger-worker'");
    const [worker] = (workerAndHost ?? '').split("setup: 'outbox-worker-host'");
    expect(generated).toMatch(/setup: 'ledger-worker'/u);
    expect(generated).toMatch(/zerops:materialize .* --worker/u);
    expect(worker).toContain(`DATABASE_URL: postgresql://ontos_runtime:\${db18_password}@\${db18_hostname}`);
    expect(generated).not.toContain('ledger_DATABASE_URL');
    expect(generated).toMatch(/OUTBOX_WORKER_HEALTH_PORT: '4110'/u);
    expect(worker?.match(/DATABASE_URL:/gu)).toHaveLength(1);
    // Zerops expands only direct references, so the worker binds PostgreSQL itself, as the runtime role.
    expect(worker).not.toMatch(/db18_(?:user|superUser)/u);
    expect(worker).not.toMatch(/ run build/u);
    expect(worker).toContain('cd app/.zerops/runtime/ledger-worker && exec node worker.mjs');
    expect(worker).not.toMatch(/(?:^|\s)&(?:\s|$)/u);
    expect(generated.match(/ONTOS_KEEP_ME: 'true'/gu)?.length).toBe(3);
    expect((yield* Effect.tryPromise(() => generateOutboxWorkerDeployment(root, generated))).deployment).toBe(
      generated,
    );
  }),
);

it.live('generates the Outbox Worker host setup and entry beside the dedicated workers', () =>
  Effect.gen(function* generatesHost() {
    const root = yield* makeFixture();
    const owner = `zerops:\n  - setup: 'ledger'\n    build:\n      buildCommands:\n        - cd app && pnpm run zerops:materialize --app 'ledger' --package '@app/ledger' --package-dir 'verticals/ledger'\n      deployFiles:\n        - 'app/.zerops/runtime/ledger'\n    deploy:\n      readinessCheck:\n        httpGet:\n          port: 4110\n          path: '/ledger-api/ledger/readiness'\n    run:\n      base: 'nodejs@24'\n      envVariables:\n        DATABASE_URL: postgresql://ontos_runtime:\${db18_password}@\${db18_hostname}:\${db18_port}/\${db18_dbName}\n        PORT: '4110'\n        ULTRAMODERN_ZEROPS_SERVICE: ledger\n      start: sh -c 'test -n "$SNAPSHOT" || exit 1; cd app/.zerops/runtime/ledger && exec npm run serve'\n`;
    const { deployment, hostEntry } = yield* Effect.tryPromise(() => generateOutboxWorkerDeployment(root, owner));
    const [, host] = deployment.split(`setup: '${OUTBOX_WORKER_HOST.stageSetup}'`);
    // The dedicated worker stays for the Zerops target; the host runs it on the Cloudflare target.
    expect(deployment).toContain("setup: 'ledger-worker'");
    expect(host).toContain("zerops:materialize --app 'outbox-worker-host' --package 'app' --package-dir '.' --worker");
    expect(host).toContain("deployFiles:\n        - 'app/.zerops/runtime/outbox-worker-host'");
    expect(host).toContain("OUTBOX_WORKER_HEALTH_PORT: '4100'");
    expect(host).toContain('ULTRAMODERN_ZEROPS_SERVICE: outbox-worker-host');
    expect(host).toContain('DATABASE_URL: postgresql://ontos_runtime:');
    expect(host).not.toContain('4110');
    expect(host).toContain(
      `start: sh -c 'test -n "$SNAPSHOT" || exit 1; cd app/.zerops/runtime/outbox-worker-host && `,
    );
    expect(hostEntry).toContain(
      "import { outboxWorkerEntry as ledgerOutboxWorkerEntry } from '../verticals/ledger/src/worker-host/entry.ts';",
    );
    expect(hostEntry).toContain('    ledgerOutboxWorkerEntry,\n');
  }),
);

it.live('refuses to materialize an Outbox Worker host whose entry drifted from its owners', () =>
  Effect.gen(function* refusesHostDrift() {
    const root = yield* makeFixture();
    const error = yield* Effect.flip(
      Effect.tryPromise(() =>
        materializeOutboxWorker({
          appId: OUTBOX_WORKER_HOST.id,
          packageDir: '.',
          packageName: 'app',
          runtimeDir: path.join(root, '.zerops/runtime', OUTBOX_WORKER_HOST.id),
          workspaceRoot: root,
        }),
      ),
    );
    expect(String(error.cause)).toContain('Outbox Worker host entry drift');
  }),
);

it.live('bundles every hosted owner entry into the real Outbox Worker host artifact', () =>
  Effect.gen(function* bundlesHost() {
    const runtimeDir = yield* Effect.acquireRelease(
      Effect.tryPromise(() => mkdtemp(path.join(os.tmpdir(), 'ontos-outbox-worker-host-bundle-'))),
      (directory) => Effect.promise(() => rm(directory, { force: true, recursive: true })),
    );
    const runtimePackage = yield* Effect.tryPromise(() =>
      materializeOutboxWorker({
        appId: OUTBOX_WORKER_HOST.id,
        packageDir: '.',
        packageName: 'app',
        runtimeDir,
        workspaceRoot: process.cwd(),
      }),
    );
    const artifact = decodeWorkerArtifact(
      yield* Effect.tryPromise(() => readFile(path.join(runtimeDir, 'worker-artifact.json'), 'utf-8')),
    );
    expect(artifact.serviceId).toBe(OUTBOX_WORKER_HOST.id);
    expect(runtimePackage.name).toBe('outbox-worker-host-runtime');
    for (const owner of ['party-registry', 'commerce-customer-context', 'price-group-catalog']) {
      expect(artifact.sourceInputs).toContain(`verticals/${owner}/src/worker-host/entry.ts`);
      expect(artifact.sourceInputs).not.toContain(`verticals/${owner}/src/worker-host/main.ts`);
    }
    expect(artifact.sourceInputs).toContain(OUTBOX_WORKER_HOST.entry);
  }),
);

it.live('materializes and starts a relocatable production worker artifact', () =>
  Effect.gen(function* testEffect3() {
    const root = yield* makeFixture();
    const child = yield* scopedChild(() =>
      spawn(
        '/usr/bin/env',
        [
          `ULTRAMODERN_WORKSPACE_ROOT=${root}`,
          'mise',
          'exec',
          '--',
          'pnpm',
          'run',
          'zerops:materialize',
          '--app',
          'ledger',
          '--package',
          LEDGER_PACKAGE,
          '--package-dir',
          LEDGER_PATH,
          '--worker',
        ],
        {
          cwd: process.cwd(),
          stdio: ['ignore', 'pipe', 'pipe'],
        },
      ),
    );
    let diagnostics = '';
    child.stdout.on('data', (data) => {
      diagnostics += String(data);
    });
    child.stderr.on('data', (data) => {
      diagnostics += String(data);
    });
    yield* Effect.tryPromise((signal) => once(child, 'exit', { signal }));
    const status = child.exitCode;
    expect(status, diagnostics).toBe(0);
    const artifact = decodeWorkerArtifact(
      yield* Effect.tryPromise(() =>
        readFile(path.join(root, '.zerops/runtime/ledger-worker/worker-artifact.json'), 'utf-8'),
      ),
    );
    expect(artifact.serviceId).toBe('ledger-worker');
    expect(artifact.sourceInputs.some((input: string) => input.endsWith(WORKER_HOST_ENTRY))).toBe(true);
    const runtime = yield* scopedChild(() =>
      spawn(process.execPath, ['worker.mjs'], {
        cwd: path.join(root, '.zerops/runtime/ledger-worker'),
        stdio: ['ignore', 'pipe', 'pipe'],
      }),
    );
    const output = yield* readWorkerOutput(runtime);
    expect(output).toMatch(/worker-started/u);
  }),
);

