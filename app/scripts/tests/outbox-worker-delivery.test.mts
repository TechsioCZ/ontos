  Effect.gen(function* testEffect1() {
    const root = yield* Effect.acquireRelease(
      Effect.tryPromise(() => mkdtemp(path.join(os.tmpdir(), 'ontos-worker-artifact-'))),
      (directory) => Effect.promise(() => rm(directory, { force: true, recursive: true })),
    );
    yield* Effect.tryPromise(() =>
      mkdir(path.join(root, LEDGER_PATH, 'src/worker-host'), { recursive: true }),
    );
    yield* Effect.tryPromise(() => mkdir(path.join(root, 'topology'), { recursive: true }));
    yield* Effect.tryPromise(() =>
      writeFile(
        path.join(root, LEDGER_PATH, 'package.json'),
        JSON.stringify({
          name: LEDGER_PACKAGE,
          scripts: { 'worker:start': `node --experimental-strip-types ./${WORKER_HOST_ENTRY}` },
          type: 'module',
        }),
      ),
    );
    yield* Effect.tryPromise(() =>
      writeFile(
        path.join(root, LEDGER_PATH, WORKER_HOST_ENTRY),
        '// @generated by scaffold:outbox-worker worker-host\nconsole.log("worker-started"); setInterval(() => {}, 1000);\n',
      ),
    );
    yield* Effect.tryPromise(() =>
      writeFile(
        path.join(root, 'topology/reference-topology.json'),
        JSON.stringify({
          verticals: [
            {
              id: 'ledger',
              moduleFederation: { manifestUrl: 'http://localhost:4110/mf-manifest.json' },
              package: LEDGER_PACKAGE,
              path: LEDGER_PATH,
            },
          ],
        }),
