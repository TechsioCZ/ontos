const compileReleaseFixture = (
  root: string,
  sourceRevision: string,
  {
    injectSourceRevision = true,
    ownerRevisions,
  }: {
    readonly injectSourceRevision?: boolean;
    readonly ownerRevisions?: string;
  } = {},
) =>
  Effect.gen(function* compileReleaseFixtureEffect() {
    const runtimeDir = path.join(root, '.zerops/runtime', sourceRevision, OUTBOX_WORKER_HOST.id);
    const options = {
      appId: OUTBOX_WORKER_HOST.id,
      packageDir: '.',
      packageName: 'app',
      runtimeDir,
      // JSON drops an absent revision map.
      ownerRevisions,
      workspaceRoot: root,
    };
    const materializer = new URL('../materialize-outbox-worker.mjs', import.meta.url).href;
    const source = `import { materializeOutboxWorker } from ${JSON.stringify(materializer)}; await materializeOutboxWorker(${JSON.stringify(options)});`;
    const buildProcess = yield* scopedChild(() =>
      spawn(
        ENV_COMMAND,
        [
          ...(injectSourceRevision ? [] : ['-u', 'ULTRAMODERN_SOURCE_REVISION']),
          'ULTRAMODERN_BUILD_MARKER=untrusted-build-environment-marker',
          ...(injectSourceRevision ? [`ULTRAMODERN_SOURCE_REVISION=${sourceRevision}`] : []),
          process.execPath,
          '--input-type=module',
          '--eval',
          source,
        ],
        {
          cwd: root,
          stdio: ['ignore', 'pipe', 'pipe'],
        },
      ),
    );
    let diagnostics = '';
    buildProcess.stderr.on('data', (data) => {
      diagnostics += String(data);
    });
    yield* Effect.tryPromise((signal) => once(buildProcess, 'exit', { signal }));
    expect(buildProcess.exitCode, diagnostics).toBe(0);
    const worker = yield* scopedChild(() =>
      spawn(
        ENV_COMMAND,
        [
          'ULTRAMODERN_BUILD_MARKER=untrusted-runtime-environment-marker',
          `ULTRAMODERN_SOURCE_REVISION=${'c'.repeat(40)}`,
          process.execPath,
          WORKER_BUNDLE,
        ],
        {
          cwd: runtimeDir,
          stdio: ['ignore', 'pipe', 'pipe'],
        },
      ),
    );
    const identities = decodeWorkerIdentities(yield* readWorkerOutput(worker));
    const artifact = decodeWorkerArtifact(
      yield* Effect.tryPromise(() => readFile(path.join(runtimeDir, WORKER_ARTIFACT), 'utf-8')),
    );
    expect(artifact.sourceRevision).toEqual(Option.some(sourceRevision));
    expect(
      artifact.ownerBuildIdentities.map(({ buildMarker, sourceRevision: compiledRevision, unitId }) => ({
