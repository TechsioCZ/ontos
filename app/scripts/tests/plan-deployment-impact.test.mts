        {
          id: 'shared-contracts',
          package: '@app/shared-contracts',
          path: 'packages/shared-contracts',
        },
        { id: 'shell-super-app', package: '@app/shell-super-app', path: 'apps/shell-super-app' },
        { id: 'contacts', package: '@app/contacts-old', path: 'verticals/contacts-old' },
