import { expect, it } from 'effect-rstest';

import {
  PUBLIC_COMPONENT_HEADER,
  publicComponentEntry,
  publicComponentImportViolations,
} from '../public-component-boundary.mts';
import type { PublicComponentImport } from '../public-component-boundary.mts';

const owner = {
  directory: 'verticals/tagging',
  exports: { './api/client': './src/api/client.ts', './components/tag-controls': './src/components/tag-controls.tsx' },
  packageName: '@app/tagging',
};
const entryFile = 'verticals/tagging/src/components/tag-controls.tsx';
const entry = `${PUBLIC_COMPONENT_HEADER}
import { listTags } from '../api/records-client.ts';
import { Chip } from '../ui/chip.tsx';

export interface TagCellProps {
  readonly tags: readonly string[];
}
export type TagTone = 'neutral' | 'accent';
export const TagCell = ({ tags }: TagCellProps) => <span>{tags.map((tag) => <Chip key={tag} label={tag} />)}</span>;
export function TagControls() {
  void listTags;
  return <div />;
}
export { Chip } from '../ui/chip.tsx';
export type { ChipProps } from '../ui/chip.tsx';
export default TagControls;
`;
const manifest = `import { TagControls } from './src/components/tag-controls.tsx';
export default defineOntosModuleManifest({
  components: {
    // <generated-module-manifest-components>
    'tag-controls': TagControls,
    // </generated-module-manifest-components>
  },
});
`;
const registration = `export default {
  components: {
    // <generated-module-registration-components>
    'tag-controls': () => import('./src/components/tag-controls.tsx'),
    // </generated-module-registration-components>
  },
};
`;
const baseSources = new Map<string, string>([
  [entryFile, entry],
  [
    'verticals/tagging/src/ui/chip.tsx',
    'export interface ChipProps { readonly label: string }\nexport const Chip = ({ label }: ChipProps) => <b>{label}</b>;\n',
  ],
  [
    'verticals/tagging/src/api/records-client.ts',
    '// @generated by OntOS Codesmith module-api v1\nexport const listTags = () => undefined;\n',
  ],
  ['verticals/tagging/vertical.manifest.ts', manifest],
  ['verticals/tagging/vertical.registration.ts', registration],
]);

const input = (
  changes: Partial<PublicComponentImport> & { readonly files?: Readonly<Record<string, string>> } = {},
) => {
  const sources = new Map(baseSources);
  for (const [file, source] of Object.entries(changes.files ?? {})) {
    sources.set(file, source);
  }
  return {
    consumer: changes.consumer ?? 'verticals/crm/src/routes/page.tsx',
    consumerDependencies: changes.consumerDependencies ?? new Set(['@app/tagging']),
    owner: changes.owner ?? owner,
    sources,
    specifier: changes.specifier ?? '@app/tagging/components/tag-controls',
  };
};
const withEntry = (source: string) => input({ files: { [entryFile]: source } });

it('accepts components, their prop types and named component re-exports from a declared public entry', () => {
  expect(publicComponentImportViolations(input())).toEqual([]);
});

it('selects only declared public-component entries', () => {
  const plain = input();
  expect(publicComponentEntry(owner, '@app/tagging/api/client', plain.sources)).toBeUndefined();
  expect(publicComponentEntry(owner, '@app/tagging/components/missing', plain.sources)).toBeUndefined();
  const unheaded = withEntry(entry.replace(`${PUBLIC_COMPONENT_HEADER}\n`, ''));
  expect(publicComponentEntry(owner, unheaded.specifier, unheaded.sources)).toBeUndefined();
});

it('rejects a consumer whose package does not declare the owner', () => {
  expect(publicComponentImportViolations(input({ consumerDependencies: new Set() }))).toEqual([
    'consumer package does not declare @app/tagging',
  ]);
});

it('rejects an entry missing from the owner manifest or registration slot', () => {
  expect(
    publicComponentImportViolations(
      input({ files: { 'verticals/tagging/vertical.manifest.ts': manifest.replace("'tag-controls'", "'other'") } }),
    ),
  ).toEqual(["owner manifest does not declare component 'tag-controls' from ./src/components/tag-controls.tsx"]);
  expect(
    publicComponentImportViolations(
      input({
        files: { 'verticals/tagging/vertical.registration.ts': registration.replace("'tag-controls'", "'other'") },
      }),
    ),
  ).toEqual(["owner registration does not register component 'tag-controls'"]);
});

it('rejects hooks, values, services, `export *` and a non-component default export', () => {
  for (const [addition, violation] of [
    ['export const useTags = () => [];', 'exports `useTags`, which is not a component or a type'],
    ['export const tagColor = { red: 1 };', 'exports `tagColor`, which is not a component or a type'],
    [
      'export const TagService = { load: () => undefined };',
      'exports `TagService`, which is not a component or a type',
    ],
    ["export * from '../ui/chip.tsx';", 'entry uses `export *`'],
    ["export { listTags } from '../api/records-client.ts';", 'exports `listTags`, which is not a component or a type'],
  ] as const) {
    expect(publicComponentImportViolations(withEntry(`${entry}${addition}\n`))).toEqual([violation]);
  }
  expect(
    publicComponentImportViolations(
      withEntry(entry.replace('export default TagControls;', 'export default { TagControls };')),
    ),
  ).toEqual(['default export is not a component']);
});

it('rejects an entry that reaches owner server code, a hand-written API module, a driver or another owner', () => {
  for (const [file, specifier] of [
    ['verticals/tagging/src/services/tags.service.ts', '../services/tags.service.ts'],
    ['verticals/tagging/api/index.ts', '../../api/index.ts'],
    ['verticals/tagging/src/api/records.read.ts', '../api/records.read.ts'],
    ['verticals/tagging/src/persistence/tags.ts', '../persistence/tags.ts'],
  ] as const) {
    expect(
      publicComponentImportViolations(
        input({
          files: {
            [entryFile]: entry.replace("'../ui/chip.tsx';\n", `'../ui/chip.tsx';\nimport '${specifier}';\n`),
            [file]: 'export {};\n',
          },
        }),
      ),
    ).toEqual([`${entryFile} reaches owner server code ${file}`]);
  }
  expect(
    publicComponentImportViolations(
      input({
        files: {
          [entryFile]: entry.replace("'../api/records-client.ts'", "'../api/records-consumer.ts'"),
          'verticals/tagging/src/api/records-consumer.ts': 'export const listTags = () => undefined;\n',
        },
      }),
    ),
  ).toEqual([
    `${entryFile} reaches verticals/tagging/src/api/records-consumer.ts, which is not a generated owner client`,
  ]);
  expect(
    publicComponentImportViolations(
      input({
        files: {
          'verticals/tagging/src/ui/chip.tsx': "import { Pool } from 'pg';\nexport const Chip = () => <b />;\n",
        },
      }),
    ),
  ).toEqual(['verticals/tagging/src/ui/chip.tsx imports pg']);
  expect(
    publicComponentImportViolations(
      input({
        files: {
          [entryFile]: entry.replace(
            "'../ui/chip.tsx';\n",
            "'../ui/chip.tsx';\nimport '../../../crm/src/private.ts';\n",
          ),
          'verticals/crm/src/private.ts': 'export {};\n',
        },
      }),
    ),
  ).toEqual([`${entryFile} reaches outside its owner: verticals/crm/src/private.ts`]);
});

it('rejects the owner importing its own public entry by package name', () => {
  expect(publicComponentImportViolations(input({ consumer: 'verticals/tagging/src/routes/page.tsx' }))).toEqual([
    'owner imports its own public entry by package name',
  ]);
});
