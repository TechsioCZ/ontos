const accepts = (source = readSource): boolean => {
  const candidates = new Map([...sources, [`${owner}/src/api/stock-list.read.ts`, source]]);
  const diagnostics: string[] = [];
  const accepted = hasCompleteGeneratedModuleApiSeam(
    candidates,
    `${owner}/shared/api.ts`,
    'inventory-stock',
    diagnostics,
  );
  if (!accepted) {
    expect(diagnostics).toEqual(['stock-list read: callbacks', 'stock-list: read']);
  }
  return accepted;
};

it('accepts native Effect.succeedNone returned by a typed load callback in a literal read pipeline', () => {
  expect(accepts()).toBe(true);
});

it('accepts native Effect.succeedNone returned from an executable block body', () => {
  expect(accepts(readSource.replace(effectValueReturn, '=> { return Effect.succeedNone; }'))).toBe(true);
});

it('still accepts a called Effect constructor', () => {
  expect(accepts(readSource.replace(effectValueReturn, '=> Effect.succeed(Option.none())'))).toBe(true);
});

const localEffectLoad = `const loadStockSnapshot = Effect.fn('StockList.load')(
  function* () { return yield* Effect.succeedNone; },
);
`;
const withLocalLoad = (declaration = localEffectLoad, expression = 'loadStockSnapshot()') =>
  readSource
    .replace('export const stockListRead', `${declaration}export const stockListRead`)
    .replace(effectValueReturn, `=> ${expression}`);

it('accepts a call to a stable owner-local Effect.fn load helper', () => {
  expect(accepts(withLocalLoad())).toBe(true);
});

for (const [name, source] of [
  ['uncalled helper', withLocalLoad(localEffectLoad, 'loadStockSnapshot')],
  ['plain value helper', withLocalLoad('const loadStockSnapshot = () => ({ items: [] });\n')],
  ['foreign helper', withLocalLoad("import { loadStockSnapshot } from '../foreign-owner.ts';\n")],
  ['reassigned helper', withLocalLoad(`${localEffectLoad}loadStockSnapshot = () => undefined;\n`)],
  ['mutated helper', withLocalLoad(`${localEffectLoad}Object.assign(loadStockSnapshot, { call: undefined });\n`)],
  ['shadowed Effect', withLocalLoad(localEffectLoad.replace('function* ()', 'function* (Effect)'))],
  ['non-native Effect', withLocalLoad().replace(effectImport, "import { Effect, Option } from './fake-effect.ts';")],
  ['helper result fallback', withLocalLoad(localEffectLoad, 'loadStockSnapshot() || undefined')],
] as const) {
  it(`rejects an owner-local load with ${name}`, () => {
    expect(accepts(source)).toBe(false);
  });
}

for (const [name, replacement] of [
  ['missing Effect import', "import { Option } from 'effect';"],
  ['type-only Effect import', "import { type Effect, Option } from 'effect';"],
  ['foreign Effect import', "import { Effect, Option } from './fake-effect.ts';"],
  ['fabricated Effect binding', 'const Effect = { succeedNone: undefined };'],
] as const) {
  it(`rejects Effect.succeedNone with a ${name}`, () => {
    expect(accepts(readSource.replace(effectImport, replacement))).toBe(false);
  });
}

for (const [name, replacement] of [
  ['missing load', ''],
  ['missing callback', 'load: undefined'],
  ['uncalled Effect value as callback', 'load: Effect.succeedNone'],
  ['plain Option value', 'load: () => Option.none()'],
  ['arbitrary member value', 'load: () => other.succeedNone'],
  ['unknown Effect property', 'load: () => Effect.unknownProperty'],
  ['uncalled Effect function', 'load: () => Effect.succeed'],
  ['identifier value', 'load: () => succeedNone'],
  ['string value', "load: () => 'Effect.succeedNone'"],
  ['template string value', 'load: () => `Effect.succeedNone`'],
  ['comment-only value', 'load: () => undefined /* Effect.succeedNone */'],
  ['nested property value', 'load: () => Effect.succeedNone.other'],
  ['non-Effect fallback', 'load: () => Effect.succeedNone || undefined'],
] as const) {
  it(`rejects ${name} instead of a callback returning a known Effect value`, () => {
    // A missing step removes its whole entry, so the pipeline literal stays well formed.
    expect(accepts(readSource.replace(replacement === '' ? `${load},` : load, replacement))).toBe(false);
  });
}

const serviceInvocation = 'context.services.load(input)';
const typedServiceLoad = `load: (input: StockListRequest, context: ReadLoadContext<{
  readonly load: (input: StockListRequest) => ReturnType<typeof loadStockSnapshot>;
}>) => context.services.load(input)`;
const withTypedServiceLoad = (declaration = localEffectLoad, loadExpression = typedServiceLoad) =>
  readSource
    .replace(effectImport, `${effectImport}\nimport type { ReadLoadContext } from '@app/core-runtime';`)
    .replace('export const stockListRead', `${declaration}export const stockListRead`)
    .replace(load, loadExpression);

it('accepts a readonly typed service method retaining an exact stable local Effect.fn result', () => {
  expect(accepts(withTypedServiceLoad())).toBe(true);
});

for (const [name, source] of [
  [
    'uncalled service method',
    withTypedServiceLoad(localEffectLoad, typedServiceLoad.replace(serviceInvocation, 'context.services.load')),
  ],
  [
    'computed service method',
    withTypedServiceLoad(
      localEffectLoad,
      typedServiceLoad.replace(serviceInvocation, "context.services['load'](input)"),
    ),
  ],
  [
    'optional service method',
    withTypedServiceLoad(
      localEffectLoad,
      typedServiceLoad.replace(serviceInvocation, 'context.services.load?.(input)'),
    ),
  ],
  [
    'mutable method contract',
    withTypedServiceLoad(localEffectLoad, typedServiceLoad.replace('readonly load:', 'load:')),
  ],
  ['plain return helper', withTypedServiceLoad('const loadStockSnapshot = () => ({ items: [] });\n')],
  ['foreign return helper', withTypedServiceLoad("import { loadStockSnapshot } from '../foreign-owner.ts';\n")],
  [
    'mutated return helper',
    withTypedServiceLoad(`${localEffectLoad}Object.assign(loadStockSnapshot, { call: undefined });\n`),
  ],
  ['reassigned return helper', withTypedServiceLoad(`${localEffectLoad}loadStockSnapshot = () => undefined;\n`)],
  [
    'non-Core context type',
    withTypedServiceLoad().replace(
      "import type { ReadLoadContext } from '@app/core-runtime';",
      "import type { ReadLoadContext } from './foreign-runtime.ts';",
    ),
  ],
] as const) {
  it(`rejects a service load with ${name}`, () => {
    expect(accepts(source)).toBe(false);
  });
}
