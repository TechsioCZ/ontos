{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["*.ts", "*.mts", "rules/**/*.ts", "shared/**/*.ts", "tests/*.mts", "tests/*.ts"],
  "exclude": ["tests/fixtures"]
}
