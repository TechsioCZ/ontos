{
  "extends": "../../tsconfig.node-tooling.json",
  "include": [
    "anti-slop/**/*.ts",
    "anti-slop/**/*.mts",
    "anti-slop/**/*.tsx"
  ],
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": "../../node_modules/.cache/tsrs/tools__oxlint__tsconfig.tsbuildinfo",
    "disableSourceOfProjectReferenceRedirect": true
  },
  "exclude": [
    "**/node_modules/**"
  ],
  "references": [
    {
      "path": "../../tsconfig.sources.json"
    }
  ]
}
