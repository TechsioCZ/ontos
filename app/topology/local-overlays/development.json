        "adapterVersion": "backend-mf-effect-v1",
        "remoteName": "verticalCommerceCustomerContextBackend",
        "manifestEnv": "VERTICAL_COMMERCE_CUSTOMER_CONTEXT_BACKEND_MF_MANIFEST",
        "manifestUrl": "http://localhost:4101/backend-mf-manifest.json",
        "containerEntry": "http://localhost:4101/backendRemoteEntry.cjs",
        "remoteType": "commonjs-module",
        "expose": "./effect-api",
        "runtimePackage": "@modern-js/plugin-bff/effect",
        "expected": {
          "unitId": "app/commerce-customer-context",
          "buildMarker": "2b4d72d8d032dd53"
        }
      }
    },
    "payment-term-catalog": {
