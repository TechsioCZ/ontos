{
  "schemaVersion": 1,
  "environment": "development",
  "preset": "presetUltramodern",
  "ports": {
    "shell-super-app": 3020,
    "ticketing": 4101
  },
  "manifests": {
    "ticketing": "http://localhost:4101/mf-manifest.json"
  },
  "apis": {
    "ticketing": "http://localhost:4101/ticketing-api"
  },
  "serverExecution": {
    "ticketing": {
      "apiBaseUrl": "http://localhost:4101/ticketing-api",
      "versionBoundary": "web-and-api-same-build",
      "deliveryUnit": {
        "unitId": "app/ticketing",
        "buildMarker": "07a52f1d8403302d"
      },
      "cloudflare": {
        "kind": "cloudflare-worker-snapshot",
        "workerName": "app-ticketing",
        "publicUrlEnv": "ULTRAMODERN_PUBLIC_URL_TICKETING",
        "ssr": {
          "workerEntry": ".output/server/index.mjs",
          "workerManifest": ".output/server/modern-worker-manifest.json",
          "routeManifest": ".output/server/route.json",
          "ssrBundle": ".output/worker/index.js",
          "effectBffBundle": ".output/worker/__modern_bff_effect.js",
          "assetsBinding": "ASSETS"
        },
        "zephyr": {
          "runtime": "ssr-worker",
          "integration": "managed-cloudflare",
          "snapshotIdEnv": "ZEPHYR_TICKETING_SNAPSHOT_ID",
          "versionIdEnv": "ZEPHYR_TICKETING_VERSION_ID",
          "applicationUidEnv": "ZEPHYR_TICKETING_APPLICATION_UID"
        },
        "workerDispatch": {
          "preferred": "service-binding",
          "serviceBinding": "VERTICAL_TICKETING_WORKER",
          "serviceBindingEnv": "VERTICAL_TICKETING_WORKER_BINDING",
          "dispatchNamespaceEnv": "VERTICAL_TICKETING_DISPATCH_NAMESPACE",
          "dispatchWorkerNameEnv": "VERTICAL_TICKETING_WORKER_NAME",
          "requestInterface": "fetch"
        }
      },
      "node": {
        "kind": "node-mf-runtime",
        "adapterVersion": "backend-mf-effect-v1",
        "remoteName": "verticalTicketingBackend",
        "manifestEnv": "VERTICAL_TICKETING_BACKEND_MF_MANIFEST",
        "manifestUrl": "http://localhost:4101/backend-mf-manifest.json",
        "containerEntry": "http://localhost:4101/backendRemoteEntry.mjs",
        "remoteType": "module",
        "expose": "./effect-api",
        "runtimePackage": "@modern-js/plugin-bff/effect",
        "expected": {
          "unitId": "app/ticketing",
          "buildMarker": "07a52f1d8403302d"
        }
      }
    }
  }
}
