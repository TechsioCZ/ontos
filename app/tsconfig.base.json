              "**/packages/storefront-registry-contracts/tests/**/*",
              "**/tools/oxlint/effect-native/tests/*.mts",
              "**/tools/oxlint/effect-native/tests/*.ts",
              "**/verticals/party-registry/scripts/**/*",
              "**/verticals/party-registry/tests/**/*",
              "**/verticals/pricing/tests/**/*",
              "**/verticals/privacy/scripts/legacy-completion-connections.ts",
              "**/verticals/privacy/scripts/legacy-completion-publication.ts",
              "**/verticals/privacy/scripts/legacy-completion-runtime-pair.ts",
              "**/verticals/privacy/scripts/outbox-worker.ts",
              "**/verticals/storefront-registry/tests/**/*",
              "**/verticals/tax/tests/**/*"
            ],
            "options": {
              "diagnosticSeverity": {
                "abortControllerInEffect": "off",
                "acquireReleaseDisposable": "off",
                "allOfMapToForEach": "off",
                "anyUnknownInErrorContext": "off",
                "apiStabilityLeak": "off",
                "asyncFunction": "off",
                "catchAllTagDispatchToCatchTag": "off",
                "catchAllToMapError": "off",
                "catchChainToFirstSuccessOf": "off",
                "catchConditionalRefailToCatchIf": "off",
                "catchDieToOrDie": "off",
                "catchIfTagToCatchTag": "off",
                "catchRefailToTapError": "off",
                "catchTagToCatchReason": "off",
                "catchToIgnore": "off",
                "catchToOrElseSucceed": "off",
                "catchUnfailableEffect": "off",
                "classSelfMismatch": "off",
                "cryptoRandomUUID": "off",
