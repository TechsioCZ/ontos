                "raceFirstWithSleepToTimeout": "off",
                "redundantMapError": "off",
                "redundantOrDie": "off",
                "redundantSchemaTagIdentifier": "off",
                "resultMatchToFromResult": "off",
                "returnEffectInGen": "off",
                "runEffectInsideEffect": "off",
                "runOfExitToRunExit": "off",
                "schemaClassMissingBrand": "off",
                "schemaClassObjectLiteral": "off",
                "schemaLiteralNonFinite": "off",
                "schemaNumber": "off",
                "schemaOpaqueInstanceMember": "off",
                "schemaStructWithTag": "off",
                "schemaSync": "off",
                "schemaSyncInEffect": "off",
                "schemaUnionOfLiterals": "off",
                "scopeInLayerEffect": "off",
                "serviceNotAsClass": "off",
