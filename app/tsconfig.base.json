        "overrides": [
          {
            "include": [
              "**/tests/**/*",
              "**/*.test.*",
              "**/scripts/**/*"
            ],
            "exclude": [
              "**/packages/catalog-selection-contracts/tests/**/*",
              "**/packages/commerce-cart-contracts/tests/**/*",
              "**/packages/core-runtime/scripts/**/*",
