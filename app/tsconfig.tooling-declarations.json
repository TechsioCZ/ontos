{
  "extends": "./tsconfig.node-tooling.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "noCheck": true,
    "rootDir": ".",
    "outDir": "./node_modules/.cache/tsrs/declarations/tooling",
    "tsBuildInfoFile": "./node_modules/.cache/tsrs/tooling-declarations.tsbuildinfo",
    "resolveJsonModule": true,
    "disableSourceOfProjectReferenceRedirect": true
  },
  "include": [
    "*.ts",
    "*.mts",
    "scripts/**/*.ts",
    "scripts/**/*.tsx",
    "scripts/**/*.mts",
    "scripts/**/*.mjs",
    "scripts/**/*.json",
    "tools/oxlint/**/*.ts",
    "tools/oxlint/**/*.mts",
    "tools/oxlint/**/*.mjs",
    "tools/oxlint/**/*.json",
    "packages/shared-contracts/tooling/**/*.ts",
    "topology/**/*.json",
    "package.json"
  ],
  "exclude": [
    "**/node_modules/**",
    "**/dist/**",
    "**/.output/**",
    "**/.modern/**",
    "**/.modernjs/**",
    "tools/oxlint/effect-native/tests/fixtures",
    "scripts/integration/tests/*.old-release.mts"
  ],
  "references": [
    {
      "path": "./tsconfig.sources.json"
    }
  ]
}
