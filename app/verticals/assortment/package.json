{
  "name": "@app/assortment",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./api": "./shared/api.ts",
    "./api/client": "./src/api/assortment-client.ts",
    "./contracts/consumer-evidence": "./shared/domain/consumer-evidence.ts",
    "./outbox/commerce-assortment-binding-created-v1": "./shared/outbox/commerce-assortment-binding-created-v1.ts",
    "./outbox/commerce-assortment-binding-ended-v1": "./shared/outbox/commerce-assortment-binding-ended-v1.ts",
    "./outbox/commerce-assortment-binding-replaced-v1": "./shared/outbox/commerce-assortment-binding-replaced-v1.ts",
    "./outbox/commerce-assortment-boundary-created-v1": "./shared/outbox/commerce-assortment-boundary-created-v1.ts",
    "./outbox/commerce-assortment-boundary-ended-v1": "./shared/outbox/commerce-assortment-boundary-ended-v1.ts",
    "./outbox/commerce-assortment-boundary-replaced-v1": "./shared/outbox/commerce-assortment-boundary-replaced-v1.ts",
    "./outbox/commerce-assortment-rule-created-v1": "./shared/outbox/commerce-assortment-rule-created-v1.ts",
    "./outbox/commerce-assortment-rule-retired-v1": "./shared/outbox/commerce-assortment-rule-retired-v1.ts",
    "./outbox/commerce-assortment-rule-revision-created-v1": "./shared/outbox/commerce-assortment-rule-revision-created-v1.ts",
    "./permissions/assortment.binding.create": "./shared/permissions/assortment-binding-create.ts",
    "./permissions/assortment.binding.end": "./shared/permissions/assortment-binding-end.ts",
    "./permissions/assortment.boundary.create": "./shared/permissions/assortment-boundary-create.ts",
    "./permissions/assortment.boundary.end": "./shared/permissions/assortment-boundary-end.ts",
    "./permissions/assortment.configuration.read": "./shared/permissions/assortment-configuration-read.ts",
    "./permissions/assortment.decision.explain": "./shared/permissions/assortment-decision-explain.ts",
    "./permissions/assortment.rule.create": "./shared/permissions/assortment-rule-create.ts",
    "./permissions/assortment.rule.retire": "./shared/permissions/assortment-rule-retire.ts",
    "./permissions/assortment.rule.revision.create": "./shared/permissions/assortment-rule-revision-create.ts",
    "./ports/owner-evidence": "./shared/domain/ports/owner-evidence.ts",
    "./resources/applicability-binding": "./shared/resources/applicability-binding.ts",
    "./resources/closed-assortment-boundary": "./shared/resources/closed-assortment-boundary.ts",
    "./resources/decision-set-proof": "./shared/resources/decision-set-proof.ts",
    "./resources/rule-revision": "./shared/resources/rule-revision.ts",
    "./resources/stable-rule": "./shared/resources/stable-rule.ts",
    "./Route": "./src/federation-entry.tsx"
  },
  "scripts": {
    "dev": "node ../../scripts/prepare-dev-module-contract.mts assortment && modern dev",
    "build": "modern build --deploy-target node && node ../../scripts/generate-ontos-module-contract.mts --vertical assortment --target dist && ultramodern-create ultramodern public-surface --app assortment --target dist && modern deploy --skip-build --deploy-target node",
    "cloudflare:build": "modern build --deploy-target cloudflare && node ../../scripts/generate-ontos-module-contract.mts --vertical assortment --target cloudflare-dist && ultramodern-create ultramodern public-surface --app assortment --target cloudflare-dist && modern deploy --skip-build --deploy-target cloudflare",
    "cloudflare:deploy": "node ../../scripts/immutable-application-release.mts deploy --app-directory .",
    "cloudflare:preview": "pnpm run cloudflare:build && wrangler dev --config .output/wrangler.json",
    "cloudflare:proof": "ultramodern-create ultramodern cloudflare-proof --app assortment",
    "db:check": "drizzle-kit check --config drizzle.config.ts",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config drizzle.config.ts",
    "db:test": "rstest run tests/unit/database-schema-contract.test.ts --config rstest.config.ts",
    "db:verify": "node scripts/verify-db-schema.mts",
    "serve": "modern serve",
    "test:integration": "rstest --project integration",
    "test:unit": "rstest --project unit",
    "typecheck": "ultramodern-create ultramodern typecheck --project tsconfig.json"
  },
  "dependencies": {
    "@app/core-runtime": "workspace:*",
    "@app/gateway-principal-verifier": "workspace:*",
    "@app/shared-contracts": "workspace:*",
    "@app/shared-design-tokens": "workspace:*",
    "@effect/opentelemetry": "4.0.0-rc.117",
    "@effect/sql-pg": "4.0.0-rc.117",
    "@modern-js/bff-effect": "catalog:ultramodern",
    "@modern-js/federation-runtime": "catalog:ultramodern",
    "@modern-js/i18n-integration": "catalog:ultramodern",
    "@modern-js/plugin-bff": "catalog:ultramodern",
    "@modern-js/plugin-bff-extensions": "catalog:ultramodern",
    "@modern-js/plugin-i18n": "catalog:ultramodern",
    "@modern-js/plugin-tanstack": "catalog:ultramodern",
    "@modern-js/runtime": "catalog:ultramodern",
    "@modern-js/runtime-extensions": "catalog:ultramodern",
    "@modern-js/runtime-renderer-extensions": "catalog:ultramodern",
    "@module-federation/modern-js-v3": "npm:@bleedingdev/mf-modern-js-v3@2.9.3",
    "@module-federation/runtime": "npm:@bleedingdev/mf-runtime@2.9.2",
    "drizzle-orm": "1.0.0-rc.5-ab785fc",
    "@tanstack/react-router": "1.170.39",
    "effect": "4.0.0-rc.117",
    "i18next": "26.4.2",
    "pg": "8.22.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@effect/tsgo": "0.41.0",
    "@modern-js/app-tools": "catalog:ultramodern",
    "@modern-js/app-tools-extensions": "catalog:ultramodern",
    "@modern-js/plugin-bff-build-extensions": "catalog:ultramodern",
    "@modern-js/ultramodern-app-tools": "catalog:ultramodern",
    "@rsbuild/plugin-tailwindcss": "^2.0.3",
    "@rstest/core": "0.11.12",
    "@types/node": "^26.4.1",
    "@types/pg": "8.20.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@typescript/native": "npm:typescript@7.0.2",
    "drizzle-kit": "1.0.0-rc.5-ab785fc",
    "effect-rstest": "https://pkg.pr.new/ScriptedAlchemy/effect-rstest@cbbf87e05c7517a85eb412d33421cd2ab5234597",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2",
    "wrangler": "4.137.0"
  },
  "modernjs": {
    "preset": "presetUltramodern",
    "role": "module-federation-remote",
    "appId": "assortment",
    "topology": "../../topology/reference-topology.json",
    "apiRuntime": "effect",
    "ontosModule": {
      "contractPath": "/.well-known/ontos-module-manifest.json",
      "manifest": "./vertical.manifest.ts",
      "moduleId": "commerce.assortment",
      "registration": "./vertical.registration.ts",
      "schemaVersion": 2
    }
  },
  "zephyr:dependencies": {}
}
