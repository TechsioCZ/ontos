{
  "name": "@app/availability",
  "version": "0.1.0",
  "private": true,
  "exports": {
    "./api": "./shared/api.ts",
    "./api/client": "./src/api/availability-client.ts",
    "./domain/availability-consumer-contract": "./shared/domain/availability-consumer-contract.ts",
    "./api/current-availability-client": "./src/api/current-availability-client.ts",
    "./api/current-availability": "./shared/apis/current-availability.ts"
  },
  "scripts": {
    "dev": "modern dev",
    "build": "modern build --deploy-target node && node ../../scripts/generate-ontos-module-contract.mts --vertical availability --target dist && pnpm --dir ../.. exec ultramodern-create ultramodern public-surface --app availability --target dist && modern deploy --skip-build --deploy-target node",
    "cloudflare:build": "modern build --deploy-target cloudflare && node ../../scripts/generate-ontos-module-contract.mts --vertical availability --target cloudflare-dist && pnpm --dir ../.. exec ultramodern-create ultramodern public-surface --app availability --target cloudflare-dist && modern deploy --skip-build --deploy-target cloudflare && ultramodern-create ultramodern cloudflare-output-verify --app availability",
    "cloudflare:deploy": "modern build --deploy-target cloudflare && pnpm --dir ../.. exec ultramodern-create ultramodern public-surface --app availability --target cloudflare-dist --require-public-origin && modern deploy --skip-build --deploy-target cloudflare && ultramodern-create ultramodern cloudflare-output-verify --app availability --require-public-urls && wrangler deploy --config .output/wrangler.json",
    "cloudflare:preview": "pnpm run cloudflare:build && wrangler dev --config .output/wrangler.json",
    "cloudflare:proof": "ultramodern-create ultramodern cloudflare-proof --app availability",
    "serve": "modern serve",
    "typecheck": "ultramodern-create ultramodern typecheck --project tsconfig.json",
    "test:unit": "rstest --project unit"
  },
  "dependencies": {
    "@app/catalog": "workspace:*",
    "@app/commerce-customer-context": "workspace:*",
    "@app/core-runtime": "workspace:*",
    "@app/gateway-principal-verifier": "workspace:*",
    "@app/inventory": "workspace:*",
    "@app/shared-contracts": "workspace:*",
    "@effect/opentelemetry": "4.0.0-rc.117",
    "@modern-js/bff-effect": "catalog:ultramodern",
    "@modern-js/federation-runtime": "catalog:ultramodern",
    "@modern-js/i18n-integration": "catalog:ultramodern",
    "@modern-js/plugin-bff": "catalog:ultramodern",
    "@modern-js/plugin-bff-extensions": "catalog:ultramodern",
    "@modern-js/plugin-i18n": "catalog:ultramodern",
    "@modern-js/plugin-tanstack": "catalog:ultramodern",
    "@modern-js/runtime": "catalog:ultramodern",
    "@modern-js/runtime-extensions": "catalog:ultramodern",
    "@modern-js/runtime-renderer-extensions": "catalog:ultramodern",
    "@module-federation/modern-js-v3": "npm:@bleedingdev/mf-modern-js-v3@2.9.3",
    "@module-federation/runtime": "npm:@bleedingdev/mf-runtime@2.9.2",
    "effect": "4.0.0-rc.117",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@modern-js/app-tools": "catalog:ultramodern",
    "@modern-js/app-tools-extensions": "catalog:ultramodern",
    "@modern-js/plugin-bff-build-extensions": "catalog:ultramodern",
    "@modern-js/ultramodern-app-tools": "catalog:ultramodern",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "typescript": "7.0.2",
    "wrangler": "4.137.0",
    "effect-rstest": "https://pkg.pr.new/ScriptedAlchemy/effect-rstest@cbbf87e05c7517a85eb412d33421cd2ab5234597",
    "@rstest/core": "0.11.12"
  },
  "modernjs": {
    "preset": "presetUltramodern",
    "role": "module-federation-remote",
    "appId": "availability",
    "topology": "../../topology/reference-topology.json",
    "apiRuntime": "effect",
    "ontosModule": {
      "contractPath": "/.well-known/ontos-module-manifest.json",
      "manifest": "./vertical.manifest.ts",
      "moduleId": "commerce.availability",
      "registration": "./vertical.registration.ts",
      "schemaVersion": 2
    }
  },
  "zephyr:dependencies": {}
}
