{
  "name": "@app/commerce-cart",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./api": "./shared/api.ts",
    "./api/client": "./shared/commerce-cart-client.ts",
    "./permissions/commerce.cart.read.open_selection_population": "./shared/permissions/commerce-cart-read-open-selection-population.ts",
    "./resources/cart": "./shared/resources/cart.ts",
    "./resources/final-cart-candidate": "./shared/resources/final-cart-candidate.ts",
    "./api/preapproval-cart-observation": "./shared/apis/preapproval-cart-observation.ts",
    "./api/preapproval-cart-observation/client": "./src/api/preapproval-cart-observation-client.ts"
  },
  "scripts": {
    "dev": "node ../../scripts/prepare-dev-module-contract.mts commerce-cart && ultramodern dev",
    "build": "ultramodern build --deploy-target node && node ../../scripts/generate-ontos-module-contract.mts --vertical commerce-cart --target dist && pnpm --dir ../.. exec ultramodern-create ultramodern public-surface --app commerce-cart --target dist && ultramodern deploy --skip-build --deploy-target node",
    "cloudflare:build": "ultramodern build --deploy-target cloudflare && node ../../scripts/generate-ontos-module-contract.mts --vertical commerce-cart --target cloudflare-dist && pnpm --dir ../.. exec ultramodern-create ultramodern public-surface --app commerce-cart --target cloudflare-dist && ultramodern deploy --skip-build --deploy-target cloudflare && ultramodern-create ultramodern cloudflare-output-verify --app commerce-cart",
    "cloudflare:deploy": "ultramodern build --deploy-target cloudflare && pnpm --dir ../.. exec ultramodern-create ultramodern public-surface --app commerce-cart --target cloudflare-dist --require-public-origin && ultramodern deploy --skip-build --deploy-target cloudflare && ultramodern-create ultramodern cloudflare-output-verify --app commerce-cart --require-public-urls && wrangler deploy --config .output/wrangler.json",
    "cloudflare:preview": "pnpm run cloudflare:build && wrangler dev --config .output/wrangler.json",
    "cloudflare:proof": "ultramodern-create ultramodern cloudflare-proof --app commerce-cart",
    "serve": "ultramodern serve",
    "typecheck": "ultramodern-create ultramodern typecheck --project tsconfig.json",
    "db:check": "drizzle-kit check --config drizzle.config.ts",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config drizzle.config.ts",
    "db:verify": "node scripts/verify-db-schema.mts",
    "test:unit": "rstest --project unit"
  },
  "dependencies": {
    "@app/commerce-cart-contracts": "workspace:*",
    "@app/core-runtime": "workspace:*",
    "@app/gateway-principal-verifier": "workspace:*",
    "@app/shared-contracts": "workspace:*",
    "@effect/opentelemetry": "4.0.7",
    "@effect/platform-node": "4.0.7",
    "@modern-js/backend-federation-contracts": "catalog:ultramodern",
    "@modern-js/bff-effect": "catalog:ultramodern",
    "@modern-js/plugin-bff": "catalog:ultramodern",
    "@modern-js/plugin-bff-extensions": "catalog:ultramodern",
    "@module-federation/runtime": "npm:@bleedingdev/mf-runtime@2.9.3",
    "effect": "4.0.7",
    "@app/catalog-selection-contracts": "workspace:*",
    "@effect/sql-pg": "4.0.7",
    "drizzle-orm": "1.0.0-rc.5-ab785fc",
    "@app/pricing-contracts": "workspace:*",
    "@app/catalog": "workspace:*",
    "@app/commerce-customer-context": "workspace:*",
    "@app/commerce-cart-finalization-contracts": "workspace:*"
  },
  "devDependencies": {
    "@modern-js/app-tools": "catalog:ultramodern",
    "@modern-js/app-tools-extensions": "catalog:ultramodern",
    "@modern-js/plugin-bff-build-extensions": "catalog:ultramodern",
    "@modern-js/ultramodern-app-tools": "catalog:ultramodern",
    "@types/node": "26.6.4",
    "typescript": "7.0.2",
    "drizzle-kit": "1.0.0-rc.5-ab785fc",
    "pg": "8.22.0",
    "@rstest/core": "0.11.12",
    "effect-rstest": "https://pkg.pr.new/ScriptedAlchemy/effect-rstest@cbbf87e05c7517a85eb412d33421cd2ab5234597",
    "wrangler": "4.137.0"
  },
  "engines": {
    "node": ">=26.10.0"
  },
  "modernjs": {
    "preset": "presetUltramodern",
    "role": "api-only",
    "appId": "commerce-cart",
    "topology": "../../topology/reference-topology.json",
    "apiRuntime": "effect",
    "ontosModule": {
      "contractPath": "/.well-known/ontos-module-manifest.json",
      "manifest": "./vertical.manifest.ts",
      "moduleId": "commerce.cart",
      "registration": "./vertical.registration.ts",
      "schemaVersion": 2
    }
  }
}
