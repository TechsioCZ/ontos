  "scripts": {
    "build": "modern build --deploy-target node && node ../../scripts/generate-ontos-module-contract.mts --vertical commerce-customer-context --target dist && ultramodern-create ultramodern public-surface --app commerce-customer-context --target dist && modern deploy --skip-build --deploy-target node",
    "db:check": "drizzle-kit check --config drizzle.config.ts",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config drizzle.config.ts",
    "db:test": "rstest run tests/unit/database-schema-contract.test.ts --config rstest.config.ts",
    "db:verify": "node scripts/verify-db-schema.mts",
    "dev": "node ../../scripts/prepare-dev-module-contract.mts commerce-customer-context && modern dev",
    "serve": "modern serve",
    "test:integration": "rstest --project integration",
    "test:integration:native-preproposal": "ONTOS_PREPROPOSAL_STANDALONE=true ONTOS_PREPROPOSAL_NATIVE=true ONTOS_APPROVAL_NATIVE=true rstest --project integration --pool.maxWorkers 1 tests/integration/preproposal-basis-postgres.test.ts --testTimeout 1200000",
    "test:unit": "rstest --project unit",
    "typecheck": "ultramodern-create ultramodern typecheck --project tsconfig.json",
    "worker:start": "node --experimental-strip-types ./src/worker-host/main.ts",
    "db:portal-auth:check": "drizzle-kit check --config drizzle.portal-auth.config.ts",
    "db:portal-auth:generate": "drizzle-kit generate --config drizzle.portal-auth.config.ts",
    "db:portal-auth:migrate": "drizzle-kit migrate --config drizzle.portal-auth.config.ts",
    "db:portal-auth:verify": "node scripts/verify-portal-auth-db-schema.mts",
    "db:portal-auth:bootstrap-runtime-role": "node scripts/bootstrap-portal-auth-runtime-role.mts"
  },
