{
  "name": "@app/commerce-market-catalog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./api": "./shared/api.ts",
    "./api/client": "./src/api/commerce-market-catalog-client.ts",
    "./outbox/commerce-market-catalog-market-activated-v1": "./shared/outbox/commerce-market-catalog-market-activated-v1.ts",
    "./outbox/commerce-market-catalog-market-created-v1": "./shared/outbox/commerce-market-catalog-market-created-v1.ts",
    "./outbox/commerce-market-catalog-market-definition-revised-v1": "./shared/outbox/commerce-market-catalog-market-definition-revised-v1.ts",
    "./outbox/commerce-market-catalog-market-retired-v1": "./shared/outbox/commerce-market-catalog-market-retired-v1.ts",
    "./outbox/commerce-market-catalog-market-suspended-v1": "./shared/outbox/commerce-market-catalog-market-suspended-v1.ts",
    "./outbox/commerce-market-catalog-storefront-associated-v1": "./shared/outbox/commerce-market-catalog-storefront-associated-v1.ts",
    "./outbox/commerce-market-catalog-storefront-association-removed-v1": "./shared/outbox/commerce-market-catalog-storefront-association-removed-v1.ts",
    "./outbox/commerce-market-catalog-storefront-association-revised-v1": "./shared/outbox/commerce-market-catalog-storefront-association-revised-v1.ts",
    "./resources/market": "./shared/resources/market.ts",
    "./resources/market-catalog-root": "./shared/resources/market-catalog-root.ts",
    "./resources/market-definition-revision": "./shared/resources/market-definition-revision.ts",
    "./resources/storefront-association": "./shared/resources/storefront-association.ts",
    "./Route": "./src/federation-entry.tsx"
  },
  "scripts": {
    "dev": "modern dev",
    "db:check": "drizzle-kit check --config drizzle.config.ts",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config drizzle.config.ts",
    "db:test": "rstest run tests/unit/database-schema-contract.test.ts --config rstest.config.ts",
    "db:verify": "node scripts/verify-db-schema.mts",
    "build": "modern build && node ../../scripts/generate-ontos-module-contract.mts --vertical commerce-market-catalog --target dist && ultramodern-create ultramodern public-surface --app commerce-market-catalog --target dist && cross-env MODERNJS_DEPLOY=node modern deploy --skip-build",
    "cloudflare:build": "cross-env MODERNJS_DEPLOY=cloudflare modern build && node ../../scripts/generate-ontos-module-contract.mts --vertical commerce-market-catalog --target cloudflare-dist && ultramodern-create ultramodern public-surface --app commerce-market-catalog --target cloudflare-dist && cross-env MODERNJS_DEPLOY=cloudflare modern deploy --skip-build && ultramodern-create ultramodern cloudflare-output-verify --app commerce-market-catalog",
    "cloudflare:deploy": "cross-env ULTRAMODERN_CLOUDFLARE_REQUIRE_PUBLIC_URLS=true pnpm run cloudflare:build && wrangler deploy --config .output/wrangler.json",
    "cloudflare:preview": "pnpm run cloudflare:build && wrangler dev --config .output/wrangler.json",
    "cloudflare:proof": "ultramodern-create ultramodern cloudflare-proof --app commerce-market-catalog",
    "serve": "modern serve",
    "test:unit": "rstest --project unit",
    "test:integration": "rstest --project integration",
    "typecheck": "ultramodern-create ultramodern typecheck --project tsconfig.json"
  },
  "dependencies": {
    "@app/core-runtime": "workspace:*",
    "@app/customer-market-retirement-contracts": "workspace:*",
    "@app/gateway-principal-verifier": "workspace:*",
    "@app/shared-contracts": "workspace:*",
    "@app/shared-design-tokens": "workspace:*",
    "@app/storefront-registry-contracts": "workspace:*",
    "@effect/opentelemetry": "4.0.0-rc.117",
    "@effect/sql-pg": "4.0.0-rc.117",
    "drizzle-orm": "1.0.0-rc.5-ab785fc",
    "@modern-js/bff-effect": "catalog:ultramodern",
    "@modern-js/federation-runtime": "catalog:ultramodern",
    "@modern-js/i18n-integration": "catalog:ultramodern",
    "@modern-js/plugin-bff": "catalog:ultramodern",
    "@modern-js/plugin-bff-extensions": "catalog:ultramodern",
    "@modern-js/plugin-i18n": "catalog:ultramodern",
    "@modern-js/plugin-tanstack": "catalog:ultramodern",
    "@modern-js/runtime": "catalog:ultramodern",
    "@modern-js/runtime-extensions": "catalog:ultramodern",
    "@modern-js/runtime-renderer-extensions": "catalog:ultramodern",
    "@module-federation/modern-js-v3": "npm:@bleedingdev/mf-modern-js-v3@2.9.1",
    "@module-federation/runtime": "npm:@bleedingdev/mf-runtime@2.9.1",
    "@tanstack/react-router": "1.170.39",
    "effect": "4.0.0-rc.117",
    "i18next": "26.4.2",
    "pg": "8.22.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@effect/tsgo": "0.41.0",
    "@modern-js/app-tools": "catalog:ultramodern",
    "@modern-js/app-tools-extensions": "catalog:ultramodern",
    "@modern-js/plugin-bff-build-extensions": "catalog:ultramodern",
    "@modern-js/ultramodern-app-tools": "catalog:ultramodern",
    "@rsbuild/plugin-tailwindcss": "^2.0.3",
    "@rstest/core": "0.11.12",
    "@types/node": "^26.4.1",
    "@types/pg": "8.20.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@typescript/native": "npm:typescript@7.0.2",
    "cross-env": "10.1.0",
    "drizzle-kit": "1.0.0-rc.5-ab785fc",
    "effect-rstest": "https://pkg.pr.new/ScriptedAlchemy/effect-rstest@f29b3f495d45a11037334620bf5f693414fb5578",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2",
    "wrangler": "4.137.0",
    "zephyr-rspack-plugin": "1.2.4"
  },
  "modernjs": {
    "preset": "presetUltramodern",
    "role": "module-federation-remote",
    "appId": "commerce-market-catalog",
    "topology": "../../topology/reference-topology.json",
    "apiRuntime": "effect",
    "ontosModule": {
      "contractPath": "/.well-known/ontos-module-manifest.json",
      "manifest": "./vertical.manifest.ts",
      "moduleId": "commerce.market-catalog",
      "registration": "./vertical.registration.ts",
      "schemaVersion": 2
    }
  },
  "zephyr:dependencies": {}
}
