{
  "name": "@app/commerce-order",
  "version": "0.1.0",
  "private": true,
  "exports": {
    "./api": "./shared/api.ts",
    "./api/client": "./shared/commerce-order-client.ts",
    "./api/order-commitment-state": "./shared/apis/order-commitment-state.ts",
    "./api/order-commitment-state/client": "./src/api/order-commitment-state-client.ts",
    "./api/verify-order-commitment-binding": "./shared/apis/verify-order-commitment-binding.ts",
    "./api/verify-order-commitment-binding/client": "./src/api/verify-order-commitment-binding-client.ts",
    "./outbox/commerce-order-finalization-work": "./shared/outbox/commerce-order-finalization-work.ts",
    "./resources/acceptance-bundle": "./shared/resources/acceptance-bundle.ts",
    "./resources/commitment-attempt": "./shared/resources/commitment-attempt.ts",
    "./resources/finalization-intent": "./shared/resources/finalization-intent.ts",
    "./resources/order": "./shared/resources/order.ts",
    "./resources/proof-request": "./shared/resources/proof-request.ts",
    "./outbox-worker-host": "./src/worker-host/entry.ts"
  },
  "scripts": {
    "build": "ultramodern build --deploy-target node && node ../../scripts/generate-ontos-module-contract.mts --vertical commerce-order --target dist && pnpm --dir ../.. exec ultramodern-create ultramodern public-surface --app commerce-order --target dist && ultramodern deploy --skip-build --deploy-target node",
    "cloudflare:build": "ultramodern build --deploy-target cloudflare && node ../../scripts/generate-ontos-module-contract.mts --vertical commerce-order --target cloudflare-dist && pnpm --dir ../.. exec ultramodern-create ultramodern public-surface --app commerce-order --target cloudflare-dist && ultramodern deploy --skip-build --deploy-target cloudflare && ultramodern-create ultramodern cloudflare-output-verify --app commerce-order",
    "cloudflare:deploy": "ultramodern build --deploy-target cloudflare && pnpm --dir ../.. exec ultramodern-create ultramodern public-surface --app commerce-order --target cloudflare-dist --require-public-origin && ultramodern deploy --skip-build --deploy-target cloudflare && ultramodern-create ultramodern cloudflare-output-verify --app commerce-order --require-public-urls && wrangler deploy --config .output/wrangler.json",
    "cloudflare:preview": "pnpm run cloudflare:build && wrangler dev --config .output/wrangler.json",
    "cloudflare:proof": "ultramodern-create ultramodern cloudflare-proof --app commerce-order",
    "db:check": "drizzle-kit check --config drizzle.config.ts",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config drizzle.config.ts",
    "db:verify": "node ./scripts/verify-database.mts",
    "dev": "node ../../scripts/prepare-dev-module-contract.mts commerce-order && ultramodern dev",
    "serve": "ultramodern serve",
    "test:integration": "rstest run tests/integration",
    "test:unit": "rstest run tests/unit",
    "typecheck": "ultramodern-create ultramodern typecheck --project tsconfig.json",
    "worker:start": "node --experimental-strip-types ./src/worker-host/main.ts"
  },
  "dependencies": {
    "@app/commerce-cart-finalization-contracts": "workspace:*",
    "@app/commerce-customer-context": "workspace:*",
    "@app/commerce-order-contracts": "workspace:*",
    "@app/core-runtime": "workspace:*",
    "@app/gateway-principal-verifier": "workspace:*",
    "@app/payment-term-catalog-contracts": "workspace:*",
    "@app/pricing-contracts": "workspace:*",
    "@app/shared-contracts": "workspace:*",
    "@app/tax": "workspace:*",
    "@effect/opentelemetry": "4.0.7",
    "@effect/platform-node": "4.0.7",
    "@effect/sql-pg": "4.0.7",
    "@modern-js/backend-federation-contracts": "catalog:ultramodern",
    "@modern-js/bff-effect": "catalog:ultramodern",
    "@modern-js/plugin-bff": "catalog:ultramodern",
    "@modern-js/plugin-bff-extensions": "catalog:ultramodern",
    "@module-federation/runtime": "npm:@bleedingdev/mf-runtime@2.9.3",
    "@noble/hashes": "2.2.0",
    "drizzle-orm": "1.0.0-rc.5-ab785fc",
    "effect": "4.0.7"
  },
  "devDependencies": {
    "@modern-js/app-tools": "catalog:ultramodern",
    "@modern-js/app-tools-extensions": "catalog:ultramodern",
    "@modern-js/plugin-bff-build-extensions": "catalog:ultramodern",
    "@modern-js/ultramodern-app-tools": "catalog:ultramodern",
    "@types/node": "^26.4.1",
    "typescript": "7.0.2",
    "drizzle-kit": "1.0.0-rc.5-ab785fc",
    "wrangler": "4.137.0"
  },
  "engines": {
    "node": ">=26.10.0"
  },
  "modernjs": {
    "preset": "presetUltramodern",
    "role": "api-only",
    "appId": "commerce-order",
    "topology": "../../topology/reference-topology.json",
    "apiRuntime": "effect",
    "ontosModule": {
      "contractPath": "/.well-known/ontos-module-manifest.json",
      "manifest": "./vertical.manifest.ts",
      "moduleId": "commerce.order",
      "registration": "./vertical.registration.ts",
      "schemaVersion": 2
    }
  },
  "type": "module"
}
