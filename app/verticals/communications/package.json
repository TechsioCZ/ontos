{
  "name": "@app/communications",
  "version": "0.1.0",
  "private": true,
  "exports": {
    "./api": "./shared/api.ts",
    "./api/client": "./src/api/communications-client.ts",
    "./api/submit-communication-request-action": "./shared/apis/submit-communication-request-action.ts",
    "./api/submit-communication-request-action/client": "./src/api/submit-communication-request-action-client.ts",
    "./api/privacy-owner-coverage": "./shared/apis/privacy-owner-coverage.ts",
    "./api/privacy-owner-execution-outcome": "./shared/apis/privacy-owner-execution-outcome.ts",
    "./api/privacy-owner-execution-outcome/client": "./src/api/privacy-owner-execution-outcome-client.ts",
    "./privacy-owner/coverage": "./shared/privacy-owner/coverage.ts",
    "./privacy-owner/inventory": "./shared/privacy-owner/inventory.ts",
    "./privacy-owner/outcome": "./shared/privacy-owner/outcome.ts",
    "./outbox/communications-core-message-intent-prepared-v1": "./shared/outbox/communications-core-message-intent-prepared-v1.ts",
    "./outbox-worker-host": "./src/worker-host/entry.ts"
  },
  "scripts": {
    "build": "ultramodern build --deploy-target node && node ../../scripts/generate-ontos-module-contract.mts --vertical communications --target dist && pnpm --dir ../.. exec ultramodern-create ultramodern public-surface --app communications --target dist && ultramodern deploy --skip-build --deploy-target node",
    "cloudflare:build": "ultramodern build --deploy-target cloudflare && node ../../scripts/generate-ontos-module-contract.mts --vertical communications --target cloudflare-dist && pnpm --dir ../.. exec ultramodern-create ultramodern public-surface --app communications --target cloudflare-dist && ultramodern deploy --skip-build --deploy-target cloudflare && ultramodern-create ultramodern cloudflare-output-verify --app communications",
    "cloudflare:deploy": "node ../../scripts/immutable-application-release.mts deploy --app-directory .",
    "cloudflare:preview": "pnpm run cloudflare:build && wrangler dev --config .output/wrangler.json",
    "cloudflare:proof": "ultramodern-create ultramodern cloudflare-proof --app communications",
    "db:check": "drizzle-kit check --config drizzle.config.ts",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config drizzle.config.ts",
    "db:test": "rstest run tests/unit/database-schema-contract.test.ts --config rstest.config.ts && node ../../scripts/generate-ontos-module-contract.mts --vertical communications --target dist && rstest --project integration tests/integration/persistence.test.ts",
    "db:verify": "node scripts/verify-db-schema.mts",
    "dev": "node ../../scripts/prepare-dev-module-contract.mts communications && ultramodern dev",
    "serve": "ultramodern serve",
    "test:integration": "node ../../scripts/generate-ontos-module-contract.mts --vertical communications --target dist && rstest --project integration",
    "test:unit": "rstest --project unit",
    "typecheck": "ultramodern-create ultramodern typecheck --project tsconfig.json",
    "worker:start": "node --experimental-strip-types ./src/worker-host/main.ts"
  },
  "dependencies": {
    "@app/communications-contracts": "workspace:*",
    "@app/core-runtime": "workspace:*",
    "@app/email-delivery": "workspace:*",
    "@app/gateway-principal-verifier": "workspace:*",
    "@app/privacy": "workspace:*",
    "@app/shared-contracts": "workspace:*",
    "@effect/opentelemetry": "4.0.7",
    "@effect/platform-node": "4.0.7",
    "@effect/sql-pg": "4.0.7",
    "@modern-js/backend-federation-contracts": "catalog:ultramodern",
    "@modern-js/bff-effect": "catalog:ultramodern",
    "@modern-js/plugin-bff": "catalog:ultramodern",
    "@modern-js/plugin-bff-extensions": "catalog:ultramodern",
    "@module-federation/runtime": "npm:@bleedingdev/mf-runtime@2.9.3",
    "drizzle-orm": "1.0.0-rc.5-ab785fc",
    "effect": "4.0.7"
  },
  "devDependencies": {
    "@modern-js/app-tools": "catalog:ultramodern",
    "@modern-js/app-tools-extensions": "catalog:ultramodern",
    "@modern-js/plugin-bff-build-extensions": "catalog:ultramodern",
    "@modern-js/ultramodern-app-tools": "catalog:ultramodern",
    "@rstest/core": "0.12.6",
    "@types/node": "26.6.4",
    "drizzle-kit": "1.0.0-rc.5-ab785fc",
    "effect-rstest": "1.0.0",
    "pg": "8.22.0",
    "typescript": "7.0.2",
    "wrangler": "4.137.0"
  },
  "engines": {
    "node": ">=26.12.0"
  },
  "modernjs": {
    "preset": "presetUltramodern",
    "role": "api-only",
    "appId": "communications",
    "topology": "../../topology/reference-topology.json",
    "apiRuntime": "effect",
    "ontosModule": {
      "contractPath": "/.well-known/ontos-module-manifest.json",
      "manifest": "./vertical.manifest.ts",
      "moduleId": "communications.core",
      "registration": "./vertical.registration.ts",
      "schemaVersion": 2
    }
  }
}
