{
  "name": "@app/contacts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./api": "./shared/api.ts",
    "./api/client": "./src/api/contacts-client.ts",
    "./locales/cs": "./locales/cs/contacts.json",
    "./locales/en": "./locales/en/contacts.json",
    "./resources/organization-engagement-profile": "./shared/resources/organization-engagement-profile.ts",
    "./resources/person-engagement-profile": "./shared/resources/person-engagement-profile.ts"
  },
  "scripts": {
    "dev": "node ../../scripts/prepare-dev-module-contract.mts contacts && modern dev",
    "build": "modern build && node ../../scripts/generate-ontos-module-contract.mts --vertical contacts --target dist && node ../../scripts/generate-public-surface-assets.mts --app contacts --target dist && MODERNJS_DEPLOY=node modern deploy --skip-build",
    "cloudflare:build": "MODERNJS_DEPLOY=cloudflare modern build && node ../../scripts/generate-ontos-module-contract.mts --vertical contacts --target cloudflare-dist && node ../../scripts/generate-public-surface-assets.mts --app contacts --target cloudflare-dist && MODERNJS_DEPLOY=cloudflare modern deploy --skip-build && node ../../scripts/verify-cloudflare-output.mts --app contacts",
    "cloudflare:deploy": "ULTRAMODERN_CLOUDFLARE_REQUIRE_PUBLIC_URLS=true pnpm run cloudflare:build && wrangler deploy --config .output/wrangler.json",
    "cloudflare:preview": "pnpm run cloudflare:build && wrangler dev --config .output/wrangler.json",
    "cloudflare:proof": "node ../../scripts/proof-cloudflare-version.mts --app contacts",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:check": "drizzle-kit check --config drizzle.config.ts",
    "db:migrate": "node scripts/prepare-contacts-migration.mts && drizzle-kit migrate --config drizzle.config.ts",
    "db:test": "pnpm test:unit && pnpm test:integration",
    "db:verify": "node scripts/verify-db-schema.mts",
    "serve": "modern serve",
    "test:component": "rstest --config rstest.config.ts",
    "test:integration": "node --test tests/integration/*.test.ts",
    "test:unit": "node --test tests/unit/*.test.ts",
    "typecheck": "node ../../scripts/ultramodern-typecheck.mts --project tsconfig.json"
  },
  "dependencies": {
    "@app/core-runtime": "workspace:*",
    "@app/party-registry": "workspace:*",
    "@app/shared-contracts": "workspace:*",
    "@app/shared-design-tokens": "workspace:*",
    "@authzed/authzed-node": "1.6.1",
    "@effect/opentelemetry": "4.0.0-beta.107",
    "@modern-js/plugin-bff": "npm:@bleedingdev/modern-js-plugin-bff@3.8.2-ultramodern.12",
    "@modern-js/plugin-i18n": "npm:@bleedingdev/modern-js-plugin-i18n@3.8.2-ultramodern.12",
    "@modern-js/plugin-tanstack": "npm:@bleedingdev/modern-js-plugin-tanstack@3.8.2-ultramodern.12",
    "@modern-js/runtime": "npm:@bleedingdev/modern-js-runtime@3.8.2-ultramodern.12",
    "@module-federation/bridge-react": "2.8.0",
    "@module-federation/modern-js-v3": "2.8.0",
    "@module-federation/runtime": "2.8.0",
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-router": "1.170.25",
    "@techsio/ui-kit": "0.25.1",
    "dotenv": "17.4.2",
    "drizzle-orm": "1.0.0-rc.4",
    "effect": "4.0.0-beta.107",
    "i18next": "26.3.6",
    "jose": "6.2.5",
    "node-fetch": "^3.3.2",
    "pg": "8.22.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "7.18.1"
  },
  "devDependencies": {
    "@effect/tsgo": "0.19.0",
    "@modern-js/adapter-rstest": "npm:@bleedingdev/modern-js-adapter-rstest@3.8.2-ultramodern.12",
    "@modern-js/app-tools": "npm:@bleedingdev/modern-js-app-tools@3.8.2-ultramodern.12",
    "@rsbuild/plugin-tailwindcss": "^2.0.3",
    "@rstest/core": "0.11.10",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "^20",
    "@types/pg": "8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript/native": "npm:typescript@7.0.2",
    "drizzle-kit": "1.0.0-rc.4",
    "happy-dom": "20.8.3",
    "tailwindcss": "^4.3.2",
    "typescript": "7.0.2",
    "wrangler": "4.110.0",
    "zephyr-rspack-plugin": "1.2.4"
  },
  "modernjs": {
    "preset": "presetUltramodern",
    "role": "module-federation-remote",
    "appId": "contacts",
    "topology": "../../topology/reference-topology.json",
    "apiRuntime": "effect",
    "ontosModule": {
      "contractPath": "/.well-known/ontos-module-manifest.json",
      "manifest": "./vertical.manifest.ts",
      "moduleId": "contacts.core",
      "registration": "./vertical.registration.ts",
      "schemaVersion": 2
    }
  },
  "zephyr:dependencies": {}
}
