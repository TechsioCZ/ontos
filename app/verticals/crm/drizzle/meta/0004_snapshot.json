          "withCheck": "\"crm\".\"deals\".\"tenant_id\" = nullif(current_setting('ontos.tenant_id', true), '')::uuid and \"crm\".\"deals\".\"legal_entity_id\" = nullif(current_setting('ontos.legal_entity_id', true), '')::uuid"
