          "name": "crm_deals_title_ck",
          "value": "\"crm\".\"deals\".\"title\" = btrim(\"crm\".\"deals\".\"title\") and char_length(\"crm\".\"deals\".\"title\") between 1 and 300"
        },
        "crm_deals_description_ck": {
          "name": "crm_deals_description_ck",
          "value": "\"crm\".\"deals\".\"description\" is null or (\"crm\".\"deals\".\"description\" = btrim(\"crm\".\"deals\".\"description\") and char_length(\"crm\".\"deals\".\"description\") between 1 and 5000)"
        },
        "crm_deals_expected_value_ck": {
          "name": "crm_deals_expected_value_ck",
          "value": "\"crm\".\"deals\".\"expected_value\" >= 0 and \"crm\".\"deals\".\"expected_value\" <= 999999999999.99"
        },
        "crm_deals_expected_close_date_ck": {
          "name": "crm_deals_expected_close_date_ck",
          "value": "\"crm\".\"deals\".\"expected_close_date\" is null or extract(year from \"crm\".\"deals\".\"expected_close_date\") between 1 and 9999"
        },
        "crm_deals_status_ck": {
          "name": "crm_deals_status_ck",
          "value": "\"crm\".\"deals\".\"status\" in ('New', 'Qualified', 'Offer sent', 'Negotiation', 'Won', 'Lost')"
        },
        "crm_deals_version_ck": {
          "name": "crm_deals_version_ck",
          "value": "\"crm\".\"deals\".\"version\" >= 1"
        }
      },
