{
  "name": "@app/facility-operations",
  "version": "0.1.0",
  "private": true,
  "exports": {
    "./ui/record-discussion": "./src/ui/record-discussion.tsx",
    "./agendas": "./shared/agendas.ts",
    "./api": "./shared/api.ts",
    "./api/client": "./src/api/facility-operations-client.ts",
    "./clients/apply-command": "./src/api/apply-command-action-client.ts",
    "./clients/records": "./src/api/records-client.ts",
    "./contracts/apply-command": "./shared/actions/apply-command.ts",
    "./contracts/records": "./shared/apis/records.ts",
    "./domain/common": "./shared/domain/common.ts",
    "./permissions/facility.operations.read_all": "./shared/permissions/facility-operations-read-all.ts",
    "./permissions/facility.operations.read_operational": "./shared/permissions/facility-operations-read-operational.ts",
    "./permissions/facility.operations.write_all": "./shared/permissions/facility-operations-write-all.ts",
    "./permissions/facility.operations.write_operational": "./shared/permissions/facility-operations-write-operational.ts",
    "./Route": "./src/federation-entry.tsx"
  },
  "scripts": {
    "dev": "node ../../scripts/prepare-dev-module-contract.mts facility-operations && modern dev",
    "build": "pnpm --dir ../.. exec ultramodern-create ultramodern routes-generate --app facility-operations --manifest-only && modern build --deploy-target node && node ../../scripts/generate-ontos-module-contract.mts --vertical facility-operations --target dist && pnpm --dir ../.. exec ultramodern-create ultramodern public-surface --app facility-operations --target dist && modern deploy --skip-build --deploy-target node",
    "cloudflare:build": "pnpm --dir ../.. exec ultramodern-create ultramodern routes-generate --app facility-operations --manifest-only && modern build --deploy-target cloudflare && node ../../scripts/generate-ontos-module-contract.mts --vertical facility-operations --target cloudflare-dist && pnpm --dir ../.. exec ultramodern-create ultramodern public-surface --app facility-operations --target cloudflare-dist && modern deploy --skip-build --deploy-target cloudflare && ultramodern-create ultramodern cloudflare-output-verify --app facility-operations",
    "cloudflare:deploy": "pnpm --dir ../.. exec ultramodern-create ultramodern routes-generate --app facility-operations --manifest-only && modern build --deploy-target cloudflare && pnpm --dir ../.. exec ultramodern-create ultramodern public-surface --app facility-operations --target cloudflare-dist --require-public-origin && modern deploy --skip-build --deploy-target cloudflare && ultramodern-create ultramodern cloudflare-output-verify --app facility-operations --require-public-urls && wrangler deploy --config .output/wrangler.json",
    "cloudflare:preview": "pnpm run cloudflare:build && wrangler dev --config .output/wrangler.json",
    "cloudflare:proof": "ultramodern-create ultramodern cloudflare-proof --app facility-operations",
    "serve": "modern serve",
    "typecheck": "ultramodern-create ultramodern typecheck --project tsconfig.json",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:check": "drizzle-kit check --config drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config drizzle.config.ts",
    "test:unit": "rstest",
    "seed:demo": "node scripts/reset-demo.mts --sales-demo"
  },
  "dependencies": {
    "@app/admin-ui": "workspace:*",
    "@app/core-runtime": "workspace:*",
    "@app/email-delivery": "workspace:*",
    "@app/gateway-principal-verifier": "workspace:*",
    "@app/party-registry": "workspace:*",
    "@app/shared-contracts": "workspace:*",
    "@app/shared-design-tokens": "workspace:*",
    "@app/legal-agreements": "workspace:*",
    "@app/finance-billing": "workspace:*",
    "@app/property-leasing": "workspace:*",
    "@app/property-portfolio": "workspace:*",
    "@app/work-tasks": "workspace:*",
    "@effect/opentelemetry": "4.0.5",
    "@effect/platform-node": "4.0.5",
    "@effect/sql-pg": "4.0.5",
    "@modern-js/bff-effect": "catalog:ultramodern",
    "@modern-js/federation-runtime": "catalog:ultramodern",
    "@modern-js/i18n-integration": "catalog:ultramodern",
    "@modern-js/plugin-bff": "catalog:ultramodern",
    "@modern-js/plugin-bff-extensions": "catalog:ultramodern",
    "@modern-js/plugin-i18n": "catalog:ultramodern",
    "@modern-js/plugin-tanstack": "catalog:ultramodern",
    "@modern-js/runtime": "catalog:ultramodern",
    "@modern-js/runtime-extensions": "catalog:ultramodern",
    "@modern-js/runtime-renderer-extensions": "catalog:ultramodern",
    "@module-federation/modern-js-v3": "npm:@bleedingdev/mf-modern-js-v3@2.9.4",
    "@module-federation/runtime": "npm:@bleedingdev/mf-runtime@2.9.3",
    "@tanstack/react-router": "1.170.39",
    "@techsio/ui-kit": "catalog:",
    "drizzle-orm": "1.0.0-rc.5-ab785fc",
    "effect": "4.0.5",
    "i18next": "26.4.2",
    "pdfjs-dist": "5.4.624",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@modern-js/backend-federation-contracts": "catalog:ultramodern"
  },
  "devDependencies": {
    "@effect/tsgo": "0.53.1",
    "@modern-js/app-tools": "catalog:ultramodern",
    "@modern-js/app-tools-extensions": "catalog:ultramodern",
    "@modern-js/plugin-bff-build-extensions": "catalog:ultramodern",
    "@modern-js/ultramodern-app-tools": "catalog:ultramodern",
    "@rsbuild/plugin-tailwindcss": "^2.0.3",
    "@rstest/core": "0.11.12",
    "@types/node": "^26.4.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "drizzle-kit": "1.0.0-rc.5-ab785fc",
    "effect-rstest": "https://pkg.pr.new/ScriptedAlchemy/effect-rstest@cbbf87e05c7517a85eb412d33421cd2ab5234597",
    "pg": "8.22.0",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2",
    "wrangler": "4.137.0",
    "zephyr-rspack-plugin": "1.2.4"
  },
  "modernjs": {
    "preset": "presetUltramodern",
    "role": "module-federation-remote",
    "appId": "facility-operations",
    "topology": "../../topology/reference-topology.json",
    "apiRuntime": "effect",
    "ontosModule": {
      "contractPath": "/.well-known/ontos-module-manifest.json",
      "manifest": "./vertical.manifest.ts",
      "moduleId": "facility.operations",
      "registration": "./vertical.registration.ts",
      "schemaVersion": 2
    }
  },
  "zephyr:dependencies": {},
  "type": "module"
}
