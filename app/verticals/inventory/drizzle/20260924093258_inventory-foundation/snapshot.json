    {
      "value": "char_length(btrim(\"exact_selection_meaning_id\")) between 1 and 300 and \"exact_selection_kind\" in ('PRODUCT_VARIANT', 'PACKAGE_OPTION', 'SET_VARIANT', 'CONFIGURED_SELECTION')",
      "name": "inventory_stock_items_meaning_ck",
      "entityType": "checks",
      "schema": "inventory",
      "table": "stock_items"
    },
    {
      "value": "\"stock_unit_module_id\" = 'commerce.catalog' and \"stock_unit_resource_type\" = 'commerce.catalog.product-unit' and \"stock_unit_tenant_id\" = \"tenant_id\"",
      "name": "inventory_stock_items_unit_ck",
      "entityType": "checks",
      "schema": "inventory",
      "table": "stock_items"
    },
    {
      "value": "\"revision\" >= 1",
      "name": "inventory_stock_items_revision_ck",
      "entityType": "checks",
      "schema": "inventory",
      "table": "stock_items"
    },
    {
      "value": "\"lifecycle_state\" in ('CURRENT', 'RETIRED')",
      "name": "inventory_stock_items_lifecycle_ck",
      "entityType": "checks",
      "schema": "inventory",
      "table": "stock_items"
    },
    {
      "value": "(\"lifecycle_state\" = 'CURRENT' and \"retired_at\" is null) or (\"lifecycle_state\" = 'RETIRED' and \"retired_at\" is not null)",
      "name": "inventory_stock_items_retirement_ck",
      "entityType": "checks",
      "schema": "inventory",
      "table": "stock_items"
    },
    {
      "value": "\"revision\" >= 1",
      "name": "inventory_stock_location_revisions_revision_ck",
      "entityType": "checks",
      "schema": "inventory",
      "table": "stock_location_revisions"
    },
    {
      "value": "\"current_revision\" >= 1",
      "name": "inventory_stock_locations_revision_ck",
      "entityType": "checks",
      "schema": "inventory",
      "table": "stock_locations"
    },
    {
      "value": "\"display_name\" = btrim(\"display_name\") and length(\"display_name\") between 1 and 300",
      "name": "inventory_stock_locations_display_name_ck",
      "entityType": "checks",
      "schema": "inventory",
      "table": "stock_locations"
    },
    {
      "value": "\"scope_kind\" in ('PHYSICAL_SITE', 'LOGICAL_AGGREGATE')",
      "name": "inventory_stock_locations_scope_kind_ck",
      "entityType": "checks",
      "schema": "inventory",
      "table": "stock_locations"
    },
    {
      "value": "jsonb_typeof(\"physical_site_keys\") = 'array' and jsonb_array_length(\"physical_site_keys\") <= 100 and (\"scope_kind\" <> 'PHYSICAL_SITE' or jsonb_array_length(\"physical_site_keys\") = 1)",
      "name": "inventory_stock_locations_site_keys_ck",
      "entityType": "checks",
      "schema": "inventory",
      "table": "stock_locations"
    },
    {
      "value": "\"lifecycle_state\" in ('ACTIVE', 'RETIRED', 'REPLACED', 'MERGED')",
      "name": "inventory_stock_locations_lifecycle_ck",
      "entityType": "checks",
      "schema": "inventory",
      "table": "stock_locations"
    },
    {
      "value": "((\"lifecycle_state\" in ('ACTIVE', 'RETIRED')) and \"successor_stock_location_id\" is null) or ((\"lifecycle_state\" in ('REPLACED', 'MERGED')) and \"successor_stock_location_id\" is not null and \"successor_stock_location_id\" <> \"stock_location_id\")",
      "name": "inventory_stock_locations_successor_ck",
      "entityType": "checks",
      "schema": "inventory",
      "table": "stock_locations"
    },
    {
      "value": "(\"lifecycle_state\" = 'ACTIVE' and \"transition_reason\" is null and \"transitioned_at\" is null) or (\"lifecycle_state\" <> 'ACTIVE' and \"transition_reason\" = btrim(\"transition_reason\") and length(\"transition_reason\") between 1 and 1000 and \"transitioned_at\" is not null)",
      "name": "inventory_stock_locations_transition_ck",
      "entityType": "checks",
      "schema": "inventory",
      "table": "stock_locations"
    },
