  "type": "module",
  "exports": {
    "./api": "./shared/api.ts",
    "./api/client": "./src/api/inventory-client.ts",
    "./backend-configuration": "./shared/domain/inventory-backend-configuration.ts",
    "./launch-scope": "./shared/inventory-launch-scope.ts",
    "./outbox/commerce-inventory-commitment-protection-changed-v1": "./shared/outbox/commerce-inventory-commitment-protection-changed-v1.ts",
