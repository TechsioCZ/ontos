    "./permissions/inventory.stock.correct": "./shared/permissions/inventory-stock-correct.ts",
    "./permissions/inventory.stock.issue": "./shared/permissions/inventory-stock-issue.ts",
    "./permissions/inventory.stock.receipt": "./shared/permissions/inventory-stock-receipt.ts",
