    "./outbox/commerce-inventory-reservation-guarantee-changed-v1": "./shared/outbox/commerce-inventory-reservation-guarantee-changed-v1.ts",
    "./outbox/commerce-inventory-stock-issue-requested-v1": "./shared/outbox/commerce-inventory-stock-issue-requested-v1.ts",
    "./outbox/commerce-inventory-stock-position-evidence-changed-v1": "./shared/outbox/commerce-inventory-stock-position-evidence-changed-v1.ts",
    "./outbox/commerce-inventory-stock-receipt-requested-v1": "./shared/outbox/commerce-inventory-stock-receipt-requested-v1.ts",
