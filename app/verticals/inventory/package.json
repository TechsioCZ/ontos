    "./permissions/inventory.external_stock_correlation.manage": "./shared/permissions/inventory-external-stock-correlation-manage.ts",
    "./permissions/inventory.migration.manage": "./shared/permissions/inventory-migration-manage.ts",
    "./permissions/inventory.recovery.execute": "./shared/permissions/inventory-recovery-execute.ts",
