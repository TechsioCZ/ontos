{
  "name": "@app/merchandise",
  "version": "0.1.0",
  "private": true,
  "exports": {
    "./api": "./shared/api.ts",
    "./api/client": "./src/api/merchandise-client.ts",
    "./apis/manage-markets-action": "./shared/apis/manage-markets-action.ts",
    "./apis/manage-markets-action/client": "./src/api/manage-markets-action-client.ts",
    "./apis/records": "./shared/apis/records.ts",
    "./apis/records/client": "./src/api/records-client.ts",
    "./apis/review-order-changes-action": "./shared/apis/review-order-changes-action.ts",
    "./apis/review-order-changes-action/client": "./src/api/review-order-changes-action-client.ts",
    "./clients/place-storefront-order": "./src/api/place-storefront-order-action-client.ts",
    "./contracts/apply-command": "./shared/actions/apply-command.ts",
    "./contracts/place-storefront-order": "./shared/actions/place-storefront-order.ts",
    "./contracts/records": "./shared/apis/records.ts",
    "./domain/market-offers": "./shared/domain/market-offers.ts",
    "./domain/merchandise-model": "./shared/domain/merchandise-model.ts",
    "./outbox/demo-merchandise-search-rebuild-requested-v1": "./shared/outbox/demo-merchandise-search-rebuild-requested-v1.ts",
    "./outbox/demo-merchandise-search-refresh-requested-v1": "./shared/outbox/demo-merchandise-search-refresh-requested-v1.ts",
    "./resources/order": "./shared/resources/order.ts",
    "./resources/product": "./shared/resources/product.ts",
    "./Route": "./src/federation-entry.tsx",
    "./outbox-worker-host": "./src/worker-host/entry.ts"
  },
  "scripts": {
    "build": "pnpm --dir ../.. exec ultramodern-create ultramodern routes-generate --app merchandise --manifest-only && modern build --deploy-target node && node ../../scripts/generate-ontos-module-contract.mts --vertical merchandise --target dist && pnpm --dir ../.. exec ultramodern-create ultramodern public-surface --app merchandise --target dist && modern deploy --skip-build --deploy-target node",
    "db:check": "drizzle-kit check --config drizzle.config.ts",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config drizzle.config.ts",
    "db:verify": "node scripts/verify-db-schema.mts",
    "dev": "node ../../scripts/prepare-dev-module-contract.mts merchandise && modern dev",
    "serve": "modern serve",
    "test:integration": "rstest --project integration",
    "test:unit": "rstest --project unit",
    "typecheck": "ultramodern-create ultramodern typecheck --project tsconfig.json",
    "worker:start": "node --experimental-strip-types ./src/worker-host/main.ts"
  },
  "dependencies": {
    "@app/admin-ui": "workspace:*",
    "@app/core-runtime": "workspace:*",
    "@app/email-delivery": "workspace:*",
    "@app/gateway-principal-verifier": "workspace:*",
    "@app/party-registry": "workspace:*",
    "@app/shared-contracts": "workspace:*",
    "@app/shared-design-tokens": "workspace:*",
    "@app/tagging": "workspace:*",
    "@app/tax": "workspace:*",
    "@effect/opentelemetry": "4.0.7",
    "@effect/platform-node": "4.0.7",
    "@effect/sql-pg": "4.0.7",
    "@modern-js/backend-federation-contracts": "catalog:ultramodern",
    "@modern-js/bff-effect": "catalog:ultramodern",
    "@modern-js/federation-runtime": "catalog:ultramodern",
    "@modern-js/i18n-integration": "catalog:ultramodern",
    "@modern-js/plugin-bff": "catalog:ultramodern",
    "@modern-js/plugin-bff-extensions": "catalog:ultramodern",
    "@modern-js/plugin-i18n": "catalog:ultramodern",
    "@modern-js/plugin-tanstack": "catalog:ultramodern",
    "@modern-js/runtime": "catalog:ultramodern",
    "@modern-js/runtime-extensions": "catalog:ultramodern",
    "@modern-js/runtime-renderer-extensions": "catalog:ultramodern",
    "@module-federation/modern-js-v3": "npm:@bleedingdev/mf-modern-js-v3@2.9.4",
    "@module-federation/runtime": "npm:@bleedingdev/mf-runtime@2.9.3",
    "@tanstack/react-router": "1.170.39",
    "@techsio/ui-kit": "catalog:",
    "drizzle-orm": "1.0.0-rc.5-ab785fc",
    "effect": "4.0.7",
    "i18next": "26.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@effect/tsgo": "0.67.0",
    "@modern-js/app-tools": "catalog:ultramodern",
    "@modern-js/app-tools-extensions": "catalog:ultramodern",
    "@modern-js/plugin-bff-build-extensions": "catalog:ultramodern",
    "@modern-js/ultramodern-app-tools": "catalog:ultramodern",
    "@rsbuild/plugin-tailwindcss": "^2.0.3",
    "@types/node": "^26.4.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2",
    "zephyr-rspack-plugin": "1.2.4",
    "drizzle-kit": "1.0.0-rc.5-ab785fc",
    "@rstest/core": "0.11.12",
    "effect-rstest": "https://pkg.pr.new/ScriptedAlchemy/effect-rstest@cbbf87e05c7517a85eb412d33421cd2ab5234597",
    "pg": "8.22.0",
    "tsrs": "0.21.0-ts7.1.0-beta"
  },
  "modernjs": {
    "preset": "presetUltramodern",
    "role": "module-federation-remote",
    "appId": "merchandise",
    "topology": "../../topology/reference-topology.json",
    "apiRuntime": "effect",
    "ontosModule": {
      "contractPath": "/.well-known/ontos-module-manifest.json",
      "manifest": "./vertical.manifest.ts",
      "moduleId": "demo.merchandise",
      "registration": "./vertical.registration.ts",
      "schemaVersion": 2
    }
  },
  "zephyr:dependencies": {},
  "type": "module"
}
