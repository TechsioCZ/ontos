// Writes src/services/akros-baseline.generated.ts: the AKROS demo baseline (`demo:seed:akros --reset`) as gzip +
// base64 parts the in-app reset decodes and inserts one at a time, on Node and Cloudflare Workers alike (no
// filesystem at request time, one part in memory at a time). The parts sit inside a function body so a Worker
// isolate materializes the 1.6 MB of string constants only when a reset runs, not on every cold start. Run after
// the storefront feed or the baseline builder changes; tests/unit/akros-baseline.test.ts fails while the generated
// module is stale.
//   node scripts/generate-akros-baseline.mts
import { gzipSync } from 'node:zlib';
import { NodeRuntime, NodeServices } from '@effect/platform-node';
import { Console, Effect, Encoding, FileSystem, Path, Schema } from 'effect';
import { buildAkrosEncoded } from './akros-catalog.mts';
import { akrosBaselineParts } from './akros-baseline-parts.ts';

const program = Effect.gen(function* generateAkrosBaseline() {
  const fileSystem = yield* FileSystem.FileSystem;
  const path = yield* Path.Path;
  const parts = yield* buildAkrosEncoded().pipe(Effect.flatMap(akrosBaselineParts));
  const encoded = yield* Effect.forEach(
    parts,
    (part) =>
      Schema.encodeEffect(Schema.fromJsonString(Schema.Json))(part).pipe(
        Effect.map((json) => Encoding.encodeBase64(gzipSync(json, { level: 9 }))),
      ),
    { concurrency: 1 },
  );
  const target = yield* path.fromFileUrl(new URL('../src/services/akros-baseline.generated.ts', import.meta.url));
  yield* fileSystem.writeFileString(
    target,
    [
      '// @generated by scripts/generate-akros-baseline.mts from the AKROS storefront feed. Do not edit.',
      '/**',
      ' * The encoded AKROS baseline in parts (gzip + base64 JSON): categories and orders first, then products. A function,',
      ' * so the string constants are created only when a reset runs, never during module evaluation on a cold isolate.',
      ' */',
      'export const loadAkrosBaselineParts = (): readonly string[] => [',
      ...encoded.map((part) => `  '${part}',`),
      '];',
      '',
    ].join('\n'),
  );
  yield* Console.log(
    `AKROS baseline: ${parts.length} parts, ${encoded.reduce((sum, part) => sum + part.length, 0)} base64 characters`,
  );
});

NodeRuntime.runMain(program.pipe(Effect.provide(NodeServices.layer)));
