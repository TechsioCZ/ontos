// Writes the AKROS demo baseline as gzip + base64 insert parts for Node and Cloudflare Workers.
// Each generated TypeScript chunk stays below the consumer analyzer's per-file source limit.
// All chunks remain statically imported, with string arrays created only when the reset loads them.
// Run after the storefront feed or baseline builder changes; tests/unit/akros-baseline.test.ts checks every module.
//   node scripts/generate-akros-baseline.mts
import { gzipSync } from 'node:zlib';
import { NodeRuntime, NodeServices } from '@effect/platform-node';
import { Console, Effect, FileSystem, Path, Schema } from 'effect';
import { Base64 } from 'effect/encoding';
import { MerchandiseStateSchema } from '../shared/apis/records.ts';
import { buildAkrosEncoded } from './akros-catalog.mts';
import { akrosBaselineParts } from './akros-baseline-parts.ts';

/** Includes the generated header and wrapper, with room below the analyzer's unchanged 1 MB limit. */
export const AKROS_BASELINE_SOURCE_BYTES = 900_000;

class AkrosBaselineGenerationError extends Schema.TaggedError<AkrosBaselineGenerationError>()(
  'AkrosBaselineGenerationError',
  { cause: Schema.optional(Schema.Defect()), reason: Schema.String },
) {}

const generatedHeader =
  '// @generated by scripts/generate-akros-baseline.mts from the AKROS storefront feed. Do not edit.';
const baselineJsonText = Schema.fromJsonString(Schema.Json);
const chunkName = (index: number) => `akros-baseline-chunk-${index}.generated.ts`;
const renderChunk = (parts: readonly string[], index: number): string =>
  [
    generatedHeader,
    `export const loadAkrosBaselineChunk${index} = (): readonly string[] => [`,
    ...parts.map((part) => `  '${part}',`),
    '];',
    '',
  ].join('\n');

/** Groups whole encoded insert parts without changing their bytes, boundaries or order. */
export const renderAkrosBaselineModules = Effect.fn('Merchandise.renderAkrosBaselineModules')(function* render(
  encoded: readonly string[],
) {
  const chunks: string[][] = [];
  let current: string[] = [];
  for (const part of encoded) {
    if (Buffer.byteLength(renderChunk([...current, part], chunks.length)) > AKROS_BASELINE_SOURCE_BYTES) {
      if (current.length > 0) {
        chunks.push(current);
      }
      current = [];
      if (Buffer.byteLength(renderChunk([part], chunks.length)) > AKROS_BASELINE_SOURCE_BYTES) {
        return yield* new AkrosBaselineGenerationError({
          reason: 'An AKROS insert part exceeds the generated source limit; reduce its JSON part size.',
        });
      }
    }
    current.push(part);
  }
  if (current.length > 0) {
    chunks.push(current);
  }
  return new Map<string, string>([
    [
      'akros-baseline.generated.ts',
      [
        generatedHeader,
        ...chunks.map((_, index) => `import { loadAkrosBaselineChunk${index} } from './${chunkName(index)}';`),
        '',
        '/** Categories and orders first, then products; arrays are created only when a reset loads them. */',
        'export const loadAkrosBaselineParts = (): readonly string[] => [',
        ...chunks.map((_, index) => `  ...loadAkrosBaselineChunk${index}(),`),
        '];',
        '',
      ].join('\n'),
    ],
    ...chunks.map((chunk, index): [string, string] => [chunkName(index), renderChunk(chunk, index)]),
  ]);
});

if (import.meta.main) {
  NodeRuntime.runMain(
    Effect.gen(function* generate() {
      const fileSystem = yield* FileSystem.FileSystem;
      const path = yield* Path.Path;
      const parts = yield* buildAkrosEncoded().pipe(Effect.flatMap(akrosBaselineParts));
      const encoded: string[] = [];
      for (const part of parts) {
        yield* Schema.decodeEffect(MerchandiseStateSchema)(part);
        // Serialize the validated original, not the decoded state: property order and fixture bytes must not change.
        const json = yield* Schema.encodeEffect(baselineJsonText)(part);
        encoded.push(
          yield* Effect.try({
            catch: (cause) => new AkrosBaselineGenerationError({ cause, reason: 'Unable to compress an AKROS part' }),
            try: () => Base64.encode(gzipSync(json, { level: 9 })),
          }),
        );
      }
      const modules = yield* renderAkrosBaselineModules(encoded);
      for (const [name, source] of modules) {
        const target = yield* path.fromFileUrl(new URL(`../src/services/${name}`, import.meta.url));
        yield* fileSystem.writeFileString(target, source);
      }
      yield* Console.log(
        `AKROS baseline: ${parts.length} parts, ${modules.size - 1} source chunks, ${encoded.reduce((sum, part) => sum + part.length, 0)} base64 characters`,
      );
    }).pipe(Effect.provide(NodeServices.layer)),
  );
}
