// Writes src/services/akros-baseline.generated.ts: the AKROS demo baseline (`demo:seed:akros --reset`) as gzip +
// base64 parts the in-app reset decodes and inserts one at a time, on Node and Cloudflare Workers alike (no
// filesystem at request time, one part in memory at a time). Run after the storefront feed or the baseline builder
// changes; tests/unit/akros-baseline.test.ts fails while the generated module is stale.
//   node scripts/generate-akros-baseline.mts
import { writeFileSync } from 'node:fs';
import { gzipSync } from 'node:zlib';
import { buildAkrosEncoded } from './akros-catalog.mts';
import { akrosBaselineParts } from './akros-baseline-parts.ts';

const parts = akrosBaselineParts(buildAkrosEncoded());
const encoded = parts.map((part) => gzipSync(JSON.stringify(part), { level: 9 }).toString('base64'));
const target = new URL('../src/services/akros-baseline.generated.ts', import.meta.url);
writeFileSync(
  target,
  [
    '// @generated by scripts/generate-akros-baseline.mts from the AKROS storefront feed. Do not edit.',
    '/** The encoded AKROS baseline in parts (gzip + base64 JSON): categories and orders first, then products. */',
    'export const AKROS_BASELINE_PARTS: readonly string[] = [',
    ...encoded.map((part) => `  '${part}',`),
    '];',
    '',
  ].join('\n'),
);
console.log(
  `AKROS baseline: ${parts.length} parts, ${encoded.reduce((sum, part) => sum + part.length, 0)} base64 characters`,
);
