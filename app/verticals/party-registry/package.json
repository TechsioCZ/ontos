    "./outbox/party-registry-contact-point-updated-v1": "./shared/outbox/party-registry-contact-point-updated-v1.ts",
    "./outbox/party-registry-counterparty-created-v1": "./shared/outbox/party-registry-counterparty-created-v1.ts",
    "./outbox/party-registry-counterparty-role-added-v1": "./shared/outbox/party-registry-counterparty-role-added-v1.ts",
    "./outbox/party-registry-counterparty-role-ended-v1": "./shared/outbox/party-registry-counterparty-role-ended-v1.ts",
    "./outbox/party-registry-official-identifier-added-v1": "./shared/outbox/party-registry-official-identifier-added-v1.ts",
    "./outbox/party-registry-official-identifier-ended-v1": "./shared/outbox/party-registry-official-identifier-ended-v1.ts",
    "./outbox/party-registry-official-identifier-updated-v1": "./shared/outbox/party-registry-official-identifier-updated-v1.ts",
    "./outbox/party-registry-party-archived-v1": "./shared/outbox/party-registry-party-archived-v1.ts",
    "./outbox/party-registry-party-created-v1": "./shared/outbox/party-registry-party-created-v1.ts",
    "./outbox/party-registry-party-fact-corrected-v1": "./shared/outbox/party-registry-party-fact-corrected-v1.ts",
    "./outbox/party-registry-party-unarchived-v1": "./shared/outbox/party-registry-party-unarchived-v1.ts",
    "./outbox/party-registry-party-updated-v1": "./shared/outbox/party-registry-party-updated-v1.ts",
    "./outbox/party-registry-relationship-created-v1": "./shared/outbox/party-registry-relationship-created-v1.ts",
    "./outbox/party-registry-relationship-ended-v1": "./shared/outbox/party-registry-relationship-ended-v1.ts",
    "./outbox/party-registry-relationship-updated-v1": "./shared/outbox/party-registry-relationship-updated-v1.ts",
    "./outbox/party-registry-search-rebuild-requested-v1": "./shared/outbox/party-registry-search-rebuild-requested-v1.ts",
    "./resources/counterparty": "./shared/resources/counterparty.ts",
    "./resources/counterparty-role-period": "./shared/resources/counterparty-role-period.ts",
    "./resources/duplicate-candidate-case": "./shared/resources/duplicate-candidate-case.ts",
    "./resources/organization-engagement-profile": "./shared/resources/organization-engagement-profile.ts",
    "./resources/party": "./shared/resources/party.ts",
    "./resources/party-alias": "./shared/resources/party-alias.ts",
    "./resources/party-contact-point": "./shared/resources/party-contact-point.ts",
    "./resources/party-correction": "./shared/resources/party-correction.ts",
    "./resources/party-match-decision": "./shared/resources/party-match-decision.ts",
    "./resources/party-merge": "./shared/resources/party-merge.ts",
    "./resources/party-official-identifier": "./shared/resources/party-official-identifier.ts",
    "./resources/party-relationship": "./shared/resources/party-relationship.ts",
    "./resources/person-engagement-profile": "./shared/resources/person-engagement-profile.ts"
  },
  "scripts": {
    "build": "modern build && node ../../scripts/generate-ontos-module-contract.mts --vertical party-registry --target dist && node ../../scripts/generate-public-surface-assets.mts --app party-registry --target dist && cross-env MODERNJS_DEPLOY=node modern deploy --skip-build",
    "cloudflare:build": "cross-env MODERNJS_DEPLOY=cloudflare modern build && node ../../scripts/generate-ontos-module-contract.mts --vertical party-registry --target cloudflare-dist && node ../../scripts/generate-public-surface-assets.mts --app party-registry --target cloudflare-dist && cross-env MODERNJS_DEPLOY=cloudflare modern deploy --skip-build && node ../../scripts/verify-cloudflare-output.mts --app party-registry",
    "cloudflare:deploy": "cross-env ULTRAMODERN_CLOUDFLARE_REQUIRE_PUBLIC_URLS=true pnpm run cloudflare:build && wrangler deploy --config .output/wrangler.json",
    "cloudflare:preview": "pnpm run cloudflare:build && wrangler dev --config .output/wrangler.json",
    "cloudflare:proof": "node ../../scripts/proof-cloudflare-version.mts --app party-registry",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts && drizzle-kit generate --config drizzle.contacts.config.ts",
    "db:check": "drizzle-kit check --config drizzle.config.ts && drizzle-kit check --config drizzle.contacts.config.ts",
    "db:migrate": "node scripts/prepare-contacts-migration.mts && drizzle-kit migrate --config drizzle.contacts.config.ts && drizzle-kit migrate --config drizzle.config.ts",
    "db:test": "pnpm test:unit && pnpm test:integration",
    "db:verify": "node scripts/verify-db-schema.mts && node scripts/verify-engagement-db-schema.mts",
    "dev": "node ../../scripts/prepare-dev-module-contract.mts party-registry && modern dev",
    "dev:worker": "node --experimental-strip-types ./src/worker-host/main.ts",
    "serve": "modern serve",
    "test:component": "rstest --project component",
    "test:integration": "rstest --project integration",
    "test:unit": "rstest --project unit",
    "typecheck": "node ../../scripts/ultramodern-typecheck.mts --project tsconfig.json",
    "worker:start": "node --experimental-strip-types ./src/worker-host/main.ts"
  },
  "dependencies": {
    "@app/core-runtime": "workspace:*",
    "@app/gateway-principal-verifier": "workspace:*",
    "@app/shared-contracts": "workspace:*",
    "@app/shared-design-tokens": "workspace:*",
    "@effect/opentelemetry": "4.0.0-rc.112",
    "@modern-js/plugin-bff": "npm:@bleedingdev/modern-js-plugin-bff@3.9.0-ultramodern.10",
    "@modern-js/plugin-i18n": "npm:@bleedingdev/modern-js-plugin-i18n@3.9.0-ultramodern.10",
    "@modern-js/plugin-tanstack": "npm:@bleedingdev/modern-js-plugin-tanstack@3.9.0-ultramodern.10",
    "@modern-js/runtime": "npm:@bleedingdev/modern-js-runtime@3.9.0-ultramodern.10",
    "@module-federation/modern-js-v3": "2.9.0",
    "@module-federation/runtime": "2.9.0",
    "@tanstack/react-router": "1.170.33",
    "drizzle-orm": "1.0.0-rc.5-ab785fc",
    "effect": "4.0.0-rc.112",
    "i18next": "26.4.2",
    "pg": "8.22.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "@effect/sql-pg": "4.0.0-rc.112",
    "@modern-js/runtime-extensions": "npm:@bleedingdev/modern-js-runtime-extensions@3.9.0-ultramodern.10",
    "@modern-js/bff-effect": "npm:@bleedingdev/modern-js-bff-effect@3.9.0-ultramodern.10",
    "@modern-js/plugin-bff-extensions": "npm:@bleedingdev/modern-js-plugin-bff-extensions@3.9.0-ultramodern.10",
    "@modern-js/i18n-integration": "npm:@bleedingdev/modern-js-i18n-integration@3.9.0-ultramodern.10",
    "@modern-js/federation-runtime": "npm:@bleedingdev/modern-js-federation-runtime@3.9.0-ultramodern.10",
    "@modern-js/runtime-renderer-extensions": "npm:@bleedingdev/modern-js-runtime-renderer-extensions@3.9.0-ultramodern.10"
  },
  "devDependencies": {
    "@effect/tsgo": "0.41.0",
    "@modern-js/adapter-rstest": "npm:@bleedingdev/modern-js-adapter-rstest@3.9.0-ultramodern.10",
    "@modern-js/app-tools": "npm:@bleedingdev/modern-js-app-tools@3.9.0-ultramodern.10",
    "@rsbuild/plugin-tailwindcss": "^2.0.3",
    "@rstest/core": "0.11.11",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "^26.4.1",
    "@types/pg": "8.20.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@typescript/native": "npm:typescript@7.0.2",
    "drizzle-kit": "1.0.0-rc.5-ab785fc",
    "fast-check": "4.9.0",
    "happy-dom": "20.8.3",
    "jose": "6.2.5",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2",
    "wrangler": "4.116.0",
    "zephyr-rspack-plugin": "1.2.4",
    "effect-rstest": "https://pkg.pr.new/ScriptedAlchemy/effect-rstest@79abbf684c7b150ee5f32694129a7caf969903bc",
    "cross-env": "10.1.0",
    "@modern-js/app-tools-extensions": "npm:@bleedingdev/modern-js-app-tools-extensions@3.9.0-ultramodern.10",
    "@modern-js/plugin-bff-build-extensions": "npm:@bleedingdev/modern-js-plugin-bff-build-extensions@3.9.0-ultramodern.10",
    "@modern-js/ultramodern-app-tools": "npm:@bleedingdev/modern-js-ultramodern-app-tools@3.9.0-ultramodern.10"
  },
  "modernjs": {
    "preset": "presetUltramodern",
    "role": "module-federation-remote",
    "appId": "party-registry",
    "topology": "../../topology/reference-topology.json",
    "apiRuntime": "effect",
    "ontosModule": {
      "contractPath": "/.well-known/ontos-module-manifest.json",
      "manifest": "./vertical.manifest.ts",
      "moduleId": "party.registry",
      "registration": "./vertical.registration.ts",
      "schemaVersion": 2
    }
  },
  "zephyr:dependencies": {}
}
