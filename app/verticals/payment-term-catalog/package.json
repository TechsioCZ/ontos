{
  "name": "@app/payment-term-catalog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./api": "./shared/api.ts",
    "./api/client": "./src/api/payment-term-catalog-client.ts",
    "./ports/customer-context-gateway-credential": "./shared/domain/customer-context-gateway-credential.ts",
    "./outbox/payment-term-catalog-payment-term-created-v1": "./shared/outbox/payment-term-catalog-payment-term-created-v1.ts",
    "./outbox/payment-term-catalog-payment-term-metadata-corrected-v1": "./shared/outbox/payment-term-catalog-payment-term-metadata-corrected-v1.ts",
    "./outbox/payment-term-catalog-payment-term-reference-reconciled-v1": "./shared/outbox/payment-term-catalog-payment-term-reference-reconciled-v1.ts",
    "./outbox/payment-term-catalog-payment-term-retired-v1": "./shared/outbox/payment-term-catalog-payment-term-retired-v1.ts",
    "./resources/payment-term-catalog-root": "./shared/resources/payment-term-catalog-root.ts"
  },
  "scripts": {
    "dev": "node ../../scripts/prepare-dev-module-contract.mts payment-term-catalog && modern dev",
    "build": "modern build && node ../../scripts/generate-ontos-module-contract.mts --vertical payment-term-catalog --target dist && node ../../scripts/generate-public-surface-assets.mts --app payment-term-catalog --target dist && MODERNJS_DEPLOY=node modern deploy --skip-build",
    "cloudflare:build": "MODERNJS_DEPLOY=cloudflare modern build && node ../../scripts/generate-ontos-module-contract.mts --vertical payment-term-catalog --target cloudflare-dist && node ../../scripts/generate-public-surface-assets.mts --app payment-term-catalog --target cloudflare-dist && MODERNJS_DEPLOY=cloudflare modern deploy --skip-build && node ../../scripts/verify-cloudflare-output.mts --app payment-term-catalog",
    "cloudflare:deploy": "ULTRAMODERN_CLOUDFLARE_REQUIRE_PUBLIC_URLS=true pnpm run cloudflare:build && wrangler deploy --config .output/wrangler.json",
    "cloudflare:preview": "pnpm run cloudflare:build && wrangler dev --config .output/wrangler.json",
    "cloudflare:proof": "node ../../scripts/proof-cloudflare-version.mts --app payment-term-catalog",
    "db:check": "drizzle-kit check --config drizzle.config.ts",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config drizzle.config.ts",
    "db:test": "rstest run tests/unit/database-schema-contract.test.ts --config rstest.config.ts",
    "db:verify": "node scripts/verify-db-schema.mts",
    "serve": "modern serve",
    "test:unit": "rstest --project unit",
    "typecheck": "node ../../scripts/ultramodern-typecheck.mts --project tsconfig.json"
  },
  "dependencies": {
    "@app/core-runtime": "workspace:*",
    "@app/customer-payment-term-contracts": "workspace:*",
    "@app/gateway-principal-verifier": "workspace:*",
    "@app/payment-term-catalog-contracts": "workspace:*",
    "@app/shared-contracts": "workspace:*",
    "@app/shared-design-tokens": "workspace:*",
    "@effect/opentelemetry": "4.0.0-beta.107",
    "@effect/sql-pg": "4.0.0-beta.107",
    "@modern-js/plugin-bff": "npm:@bleedingdev/modern-js-plugin-bff@3.8.2-ultramodern.12",
    "@modern-js/plugin-i18n": "npm:@bleedingdev/modern-js-plugin-i18n@3.8.2-ultramodern.12",
    "@modern-js/plugin-tanstack": "npm:@bleedingdev/modern-js-plugin-tanstack@3.8.2-ultramodern.12",
    "@modern-js/runtime": "npm:@bleedingdev/modern-js-runtime@3.8.2-ultramodern.12",
    "@module-federation/bridge-react": "2.8.0",
    "@module-federation/modern-js-v3": "2.8.0",
    "@module-federation/runtime": "2.8.0",
    "@tanstack/react-router": "1.170.25",
    "drizzle-orm": "1.0.0-rc.5-ab785fc",
    "effect": "4.0.0-beta.107",
    "i18next": "26.3.6",
    "pg": "8.22.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@effect/tsgo": "0.19.0",
    "@modern-js/adapter-rstest": "npm:@bleedingdev/modern-js-adapter-rstest@3.8.2-ultramodern.12",
    "@modern-js/app-tools": "npm:@bleedingdev/modern-js-app-tools@3.8.2-ultramodern.12",
    "@rstest/core": "0.11.11",
    "@types/node": "^20",
    "@types/pg": "8.20.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript/native": "npm:typescript@7.0.2",
    "drizzle-kit": "1.0.0-rc.5-ab785fc",
    "effect-rstest": "https://pkg.pr.new/ScriptedAlchemy/effect-rstest@79abbf684c7b150ee5f32694129a7caf969903bc",
    "fast-check": "4.9.0",
    "typescript": "7.0.2",
    "wrangler": "4.116.0",
    "zephyr-rspack-plugin": "1.2.1"
  },
  "modernjs": {
    "preset": "presetUltramodern",
    "role": "module-federation-remote",
    "appId": "payment-term-catalog",
    "topology": "../../topology/reference-topology.json",
    "apiRuntime": "effect",
    "ontosModule": {
      "contractPath": "/.well-known/ontos-module-manifest.json",
      "manifest": "./vertical.manifest.ts",
      "moduleId": "payment.term-catalog",
      "registration": "./vertical.registration.ts",
      "schemaVersion": 2
    }
  },
  "zephyr:dependencies": {}
}
