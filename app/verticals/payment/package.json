{
  "name": "@app/payment",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./api": "./shared/api.ts",
    "./api/capture-provider-notification-action": "./shared/apis/capture-provider-notification-action.ts",
    "./api/capture-provider-notification-action/client": "./src/api/capture-provider-notification-action-client.ts",
    "./api/client": "./src/api/payment-client.ts",
    "./api/provider-binding-route": "./shared/apis/provider-binding-route.ts",
    "./api/provider-binding-route/client": "./src/api/provider-binding-route-client.ts",
    "./api/request-payment-operation-recovery-action": "./shared/apis/request-payment-operation-recovery-action.ts",
    "./api/request-payment-operation-recovery-action/client": "./src/api/request-payment-operation-recovery-action-client.ts",
    "./outbox/payment-core-authorization-issued-v1": "./shared/outbox/payment-core-authorization-issued-v1.ts",
    "./outbox/payment-core-operation-outcome-changed-v1": "./shared/outbox/payment-core-operation-outcome-changed-v1.ts",
    "./outbox/payment-core-operation-recovery-requested-v1": "./shared/outbox/payment-core-operation-recovery-requested-v1.ts",
    "./outbox/payment-core-operation-requested-v1": "./shared/outbox/payment-core-operation-requested-v1.ts",
    "./outbox/payment-core-payment-created-v1": "./shared/outbox/payment-core-payment-created-v1.ts",
    "./outbox/payment-core-provider-notification-captured-v1": "./shared/outbox/payment-core-provider-notification-captured-v1.ts",
    "./owner-evidence/commitment-attempt": "./shared/domain/commitment-attempt-evidence.ts",
    "./payment-gateway-relay": "./shared/payment-gateway-relay.ts",
    "./resources/payment": "./shared/resources/payment.ts",
    "./resources/payment-root": "./shared/resources/payment-root.ts",
    "./outbox-worker-host": "./src/worker-host/entry.ts"
  },
  "scripts": {
    "build": "modern build --deploy-target node && node ../../scripts/generate-ontos-module-contract.mts --vertical payment --target dist && ultramodern-create ultramodern public-surface --app payment --target dist && modern deploy --skip-build --deploy-target node",
    "cloudflare:build": "modern build --deploy-target cloudflare && node ../../scripts/generate-ontos-module-contract.mts --vertical payment --target cloudflare-dist && ultramodern-create ultramodern public-surface --app payment --target cloudflare-dist && modern deploy --skip-build --deploy-target cloudflare",
    "cloudflare:deploy": "node ../../scripts/immutable-application-release.mts deploy --app-directory .",
    "cloudflare:preview": "pnpm run cloudflare:build && wrangler dev --config .output/wrangler.json",
    "cloudflare:proof": "ultramodern-create ultramodern cloudflare-proof --app payment",
    "db:check": "drizzle-kit check --config drizzle.config.ts",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config drizzle.config.ts",
    "db:test": "rstest run tests/unit/database-schema-contract.test.ts --config rstest.config.ts",
    "db:verify": "node scripts/verify-db-schema.mts",
    "dev": "node ../../scripts/prepare-dev-module-contract.mts payment && modern dev",
    "serve": "modern serve",
    "test:integration": "rstest --project integration",
    "test:sandbox": "rstest --project sandbox",
    "test:unit": "rstest --project unit",
    "typecheck": "ultramodern-create ultramodern typecheck --project tsconfig.json",
    "worker:start": "node --experimental-strip-types ./src/worker-host/main.ts"
  },
  "dependencies": {
    "@app/commerce-customer-context": "workspace:*",
    "@app/core-runtime": "workspace:*",
    "@app/gateway-principal-verifier": "workspace:*",
    "@app/payment-term-catalog-contracts": "workspace:*",
    "@app/shared-contracts": "workspace:*",
    "@effect/opentelemetry": "4.0.7",
    "@effect/platform-node": "4.0.7",
    "@effect/sql-pg": "4.0.7",
    "@modern-js/backend-federation-contracts": "catalog:ultramodern",
    "@modern-js/bff-effect": "catalog:ultramodern",
    "@modern-js/plugin-bff": "catalog:ultramodern",
    "@module-federation/modern-js-v3": "npm:@bleedingdev/mf-modern-js-v3@2.9.4",
    "@module-federation/runtime": "npm:@bleedingdev/mf-runtime@2.9.3",
    "@noble/hashes": "2.2.0",
    "drizzle-orm": "1.0.0-rc.5-ab785fc",
    "effect": "4.0.7"
  },
  "devDependencies": {
    "@modern-js/app-tools": "catalog:ultramodern",
    "@modern-js/app-tools-extensions": "catalog:ultramodern",
    "@modern-js/plugin-bff-build-extensions": "catalog:ultramodern",
    "@modern-js/ultramodern-app-tools": "catalog:ultramodern",
    "@rstest/core": "0.11.12",
    "@types/node": "^20",
    "drizzle-kit": "1.0.0-rc.5-ab785fc",
    "effect-rstest": "https://pkg.pr.new/ScriptedAlchemy/effect-rstest@cbbf87e05c7517a85eb412d33421cd2ab5234597",
    "pg": "8.22.0",
    "typescript": "7.0.2",
    "wrangler": "4.137.0"
  },
  "modernjs": {
    "preset": "presetUltramodern",
    "role": "api-only",
    "appId": "payment",
    "topology": "../../topology/reference-topology.json",
    "apiRuntime": "effect",
    "ontosModule": {
      "contractPath": "/.well-known/ontos-module-manifest.json",
      "manifest": "./vertical.manifest.ts",
      "moduleId": "payment.core",
      "registration": "./vertical.registration.ts",
      "schemaVersion": 2
    }
  },
  "zephyr:dependencies": {}
}
