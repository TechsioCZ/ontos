{
  "name": "@app/price-group-catalog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./api": "./shared/api.ts",
    "./api/client": "./src/api/price-group-catalog-client.ts",
    "./outbox/pricing-price-group-containment-projection-requested": "./shared/outbox/pricing-price-group-containment-projection-requested.ts",
    "./outbox/pricing-price-group-created": "./shared/outbox/pricing-price-group-created.ts",
    "./outbox/pricing-price-group-definition-revision-created": "./shared/outbox/pricing-price-group-definition-revision-created.ts",
    "./outbox/pricing-price-group-retirement-accepted": "./shared/outbox/pricing-price-group-retirement-accepted.ts",
    "./permissions/pricing.price_group.create": "./shared/permissions/pricing-price-group-create.ts",
    "./permissions/pricing.price_group.read": "./shared/permissions/pricing-price-group-read.ts",
    "./permissions/pricing.price_group.retire": "./shared/permissions/pricing-price-group-retire.ts",
    "./permissions/pricing.price_group.revision.create": "./shared/permissions/pricing-price-group-revision-create.ts",
    "./resources/price-group": "./shared/resources/price-group.ts",
    "./resources/price-group-catalog-root": "./shared/resources/price-group-catalog-root.ts"
  },
  "scripts": {
    "build": "modern build && node ../../scripts/generate-ontos-module-contract.mts --vertical price-group-catalog --target dist && node ../../scripts/generate-public-surface-assets.mts --app price-group-catalog --target dist && cross-env MODERNJS_DEPLOY=node modern deploy --skip-build",
    "cloudflare:build": "cross-env MODERNJS_DEPLOY=cloudflare modern build && node ../../scripts/generate-ontos-module-contract.mts --vertical price-group-catalog --target cloudflare-dist && node ../../scripts/generate-public-surface-assets.mts --app price-group-catalog --target cloudflare-dist && cross-env MODERNJS_DEPLOY=cloudflare modern deploy --skip-build && node ../../scripts/verify-cloudflare-output.mts --app price-group-catalog",
    "cloudflare:deploy": "cross-env ULTRAMODERN_CLOUDFLARE_REQUIRE_PUBLIC_URLS=true pnpm run cloudflare:build && wrangler deploy --config .output/wrangler.json",
    "cloudflare:preview": "pnpm run cloudflare:build && wrangler dev --config .output/wrangler.json",
    "cloudflare:proof": "node ../../scripts/proof-cloudflare-version.mts --app price-group-catalog",
    "db:check": "drizzle-kit check --config drizzle.config.ts",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config drizzle.config.ts",
    "db:test": "rstest run tests/unit/database-schema-contract.test.ts tests/unit/migration-security-contract.test.ts --config rstest.config.ts",
    "db:verify": "node scripts/verify-db-schema.mts",
    "dev": "modern dev",
    "dev:worker": "node --experimental-strip-types ./src/worker-host/main.ts",
    "serve": "modern serve",
    "test:integration": "rstest --project integration",
    "test:unit": "rstest --project unit",
    "typecheck": "node ../../scripts/ultramodern-typecheck.mts --project tsconfig.json",
    "worker:start": "node --experimental-strip-types ./src/worker-host/main.ts"
  },
  "dependencies": {
    "@app/core-runtime": "workspace:*",
    "@app/gateway-principal-verifier": "workspace:*",
    "@app/price-group-catalog-contracts": "workspace:*",
    "@app/shared-contracts": "workspace:*",
    "@effect/opentelemetry": "4.0.0-rc.112",
    "@effect/platform-node": "4.0.0-rc.112",
    "@effect/sql-pg": "4.0.0-rc.112",
    "@modern-js/bff-effect": "npm:@bleedingdev/modern-js-bff-effect@3.9.0-ultramodern.11",
    "@modern-js/federation-runtime": "npm:@bleedingdev/modern-js-federation-runtime@3.9.0-ultramodern.11",
    "@modern-js/i18n-integration": "npm:@bleedingdev/modern-js-i18n-integration@3.9.0-ultramodern.11",
    "@modern-js/plugin-bff": "npm:@bleedingdev/modern-js-plugin-bff@3.9.0-ultramodern.11",
    "@modern-js/plugin-bff-extensions": "npm:@bleedingdev/modern-js-plugin-bff-extensions@3.9.0-ultramodern.11",
    "@modern-js/plugin-i18n": "npm:@bleedingdev/modern-js-plugin-i18n@3.9.0-ultramodern.11",
    "@modern-js/plugin-tanstack": "npm:@bleedingdev/modern-js-plugin-tanstack@3.9.0-ultramodern.11",
    "@modern-js/runtime": "npm:@bleedingdev/modern-js-runtime@3.9.0-ultramodern.11",
    "@modern-js/runtime-extensions": "npm:@bleedingdev/modern-js-runtime-extensions@3.9.0-ultramodern.11",
    "@modern-js/runtime-renderer-extensions": "npm:@bleedingdev/modern-js-runtime-renderer-extensions@3.9.0-ultramodern.11",
    "@module-federation/modern-js-v3": "2.9.0",
    "@module-federation/runtime": "2.9.0",
    "drizzle-orm": "1.0.0-rc.5-ab785fc",
    "effect": "4.0.0-rc.112",
    "i18next": "26.4.2",
    "pg": "8.22.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@modern-js/app-tools": "npm:@bleedingdev/modern-js-app-tools@3.9.0-ultramodern.11",
    "@modern-js/app-tools-extensions": "npm:@bleedingdev/modern-js-app-tools-extensions@3.9.0-ultramodern.11",
    "@modern-js/plugin-bff-build-extensions": "npm:@bleedingdev/modern-js-plugin-bff-build-extensions@3.9.0-ultramodern.11",
    "@modern-js/ultramodern-app-tools": "npm:@bleedingdev/modern-js-ultramodern-app-tools@3.9.0-ultramodern.11",
    "@rstest/core": "0.11.12",
    "@types/node": "^26.4.1",
    "@types/pg": "8.20.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "cross-env": "10.1.0",
    "drizzle-kit": "1.0.0-rc.5-ab785fc",
    "effect-rstest": "https://pkg.pr.new/ScriptedAlchemy/effect-rstest@f29b3f495d45a11037334620bf5f693414fb5578",
    "typescript": "7.0.2",
    "wrangler": "4.116.0"
  },
  "modernjs": {
    "preset": "presetUltramodern",
    "role": "module-federation-remote",
    "appId": "price-group-catalog",
    "topology": "../../topology/reference-topology.json",
    "apiRuntime": "effect",
    "ontosModule": {
      "contractPath": "/.well-known/ontos-module-manifest.json",
      "manifest": "./vertical.manifest.ts",
      "moduleId": "pricing.price-group-catalog",
      "registration": "./vertical.registration.ts",
      "schemaVersion": 2
    }
  },
  "zephyr:dependencies": {}
}
