{
  "name": "@app/price-group-catalog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./api": "./shared/api.ts",
    "./api/client": "./src/api/price-group-catalog-client.ts",
    "./outbox/pricing-price-group-containment-projection-requested": "./shared/outbox/pricing-price-group-containment-projection-requested.ts",
    "./outbox/pricing-price-group-created": "./shared/outbox/pricing-price-group-created.ts",
    "./outbox/pricing-price-group-definition-revision-created": "./shared/outbox/pricing-price-group-definition-revision-created.ts",
    "./outbox/pricing-price-group-retirement-accepted": "./shared/outbox/pricing-price-group-retirement-accepted.ts",
    "./permissions/pricing.price_group.create": "./shared/permissions/pricing-price-group-create.ts",
    "./permissions/pricing.price_group.read": "./shared/permissions/pricing-price-group-read.ts",
    "./permissions/pricing.price_group.retire": "./shared/permissions/pricing-price-group-retire.ts",
    "./permissions/pricing.price_group.revision.create": "./shared/permissions/pricing-price-group-revision-create.ts",
    "./resources/price-group": "./shared/resources/price-group.ts",
    "./resources/price-group-catalog-root": "./shared/resources/price-group-catalog-root.ts"
  },
  "scripts": {
    "dev": "node ../../scripts/prepare-dev-module-contract.mts price-group-catalog && modern dev",
    "build": "modern build && node ../../scripts/generate-ontos-module-contract.mts --vertical price-group-catalog --target dist && ultramodern-create ultramodern public-surface --app price-group-catalog --target dist && cross-env MODERNJS_DEPLOY=node modern deploy --skip-build",
    "cloudflare:build": "cross-env MODERNJS_DEPLOY=cloudflare modern build && node ../../scripts/generate-ontos-module-contract.mts --vertical price-group-catalog --target cloudflare-dist && ultramodern-create ultramodern public-surface --app price-group-catalog --target cloudflare-dist && cross-env MODERNJS_DEPLOY=cloudflare modern deploy --skip-build && ultramodern-create ultramodern cloudflare-output-verify --app price-group-catalog",
    "cloudflare:deploy": "cross-env ULTRAMODERN_CLOUDFLARE_REQUIRE_PUBLIC_URLS=true pnpm run cloudflare:build && wrangler deploy --config .output/wrangler.json",
    "cloudflare:preview": "pnpm run cloudflare:build && wrangler dev --config .output/wrangler.json",
    "cloudflare:proof": "ultramodern-create ultramodern cloudflare-proof --app price-group-catalog",
    "db:check": "drizzle-kit check --config drizzle.config.ts",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config drizzle.config.ts",
    "db:test": "rstest run tests/unit/database-schema-contract.test.ts tests/unit/migration-security-contract.test.ts --config rstest.config.ts",
    "db:verify": "node scripts/verify-db-schema.mts",
    "serve": "modern serve",
    "test:integration": "rstest --project integration",
    "test:unit": "rstest --project unit",
    "worker:start": "node --experimental-strip-types ./src/worker-host/main.ts",
    "typecheck": "ultramodern-create ultramodern typecheck --project tsconfig.json"
  },
  "dependencies": {
    "@app/core-runtime": "workspace:*",
    "@app/gateway-principal-verifier": "workspace:*",
    "@app/price-group-catalog-contracts": "workspace:*",
    "@app/shared-contracts": "workspace:*",
    "@effect/opentelemetry": "4.0.0-rc.117",
    "@effect/platform-node": "4.0.0-rc.117",
    "@effect/sql-pg": "4.0.0-rc.117",
    "@modern-js/bff-effect": "catalog:ultramodern",
    "@modern-js/federation-runtime": "catalog:ultramodern",
    "@modern-js/i18n-integration": "catalog:ultramodern",
    "@modern-js/plugin-bff": "catalog:ultramodern",
    "@modern-js/plugin-bff-extensions": "catalog:ultramodern",
    "@modern-js/plugin-i18n": "catalog:ultramodern",
    "@modern-js/plugin-tanstack": "catalog:ultramodern",
    "@modern-js/runtime": "catalog:ultramodern",
    "@modern-js/runtime-extensions": "catalog:ultramodern",
    "@modern-js/runtime-renderer-extensions": "catalog:ultramodern",
    "@module-federation/modern-js-v3": "npm:@bleedingdev/mf-modern-js-v3@2.9.1",
    "@module-federation/runtime": "npm:@bleedingdev/mf-runtime@2.9.1",
    "drizzle-orm": "1.0.0-rc.5-ab785fc",
    "effect": "4.0.0-rc.117",
    "i18next": "26.4.2",
    "pg": "8.22.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@modern-js/app-tools": "catalog:ultramodern",
    "@modern-js/app-tools-extensions": "catalog:ultramodern",
    "@modern-js/plugin-bff-build-extensions": "catalog:ultramodern",
    "@modern-js/ultramodern-app-tools": "catalog:ultramodern",
    "@rstest/core": "0.11.12",
    "@types/node": "^26.4.1",
    "@types/pg": "8.20.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "cross-env": "10.1.0",
    "drizzle-kit": "1.0.0-rc.5-ab785fc",
    "effect-rstest": "https://pkg.pr.new/ScriptedAlchemy/effect-rstest@f29b3f495d45a11037334620bf5f693414fb5578",
    "typescript": "7.0.2",
    "wrangler": "4.137.0"
  },
  "modernjs": {
    "preset": "presetUltramodern",
    "role": "module-federation-remote",
    "appId": "price-group-catalog",
    "topology": "../../topology/reference-topology.json",
    "apiRuntime": "effect",
    "ontosModule": {
      "contractPath": "/.well-known/ontos-module-manifest.json",
      "manifest": "./vertical.manifest.ts",
      "moduleId": "pricing.price-group-catalog",
      "registration": "./vertical.registration.ts",
      "schemaVersion": 2
    }
  },
  "zephyr:dependencies": {}
}
