{
  "name": "@app/pricing",
  "version": "0.1.0",
  "private": true,
  "exports": {
    "./actions/define-price": "./shared/actions/define-price.ts",
    "./actions/manage-quantity-tier": "./shared/actions/manage-quantity-tier.ts",
    "./actions/revise-price": "./shared/actions/revise-price.ts",
    "./api": "./shared/api.ts",
    "./api/client": "./src/api/pricing-client.ts",
    "./apis/price-group-source-prices": "./shared/apis/price-group-source-prices.ts",
    "./apis/price-result-lookup": "./shared/apis/price-result-lookup.ts",
    "./apis/price-schedule": "./shared/apis/price-schedule.ts",
    "./apis/price-source-result-lookup": "./shared/apis/price-source-result-lookup.ts",
    "./permissions/pricing.commercial_fee.read": "./shared/permissions/pricing-commercial-fee-read.ts",
    "./permissions/pricing.currency_support.read": "./shared/permissions/pricing-currency-support-read.ts",
    "./permissions/pricing.exact_price_resolution.read": "./shared/permissions/pricing-exact-price-resolution-read.ts",
    "./permissions/pricing.price.read": "./shared/permissions/pricing-price-read.ts",
    "./resources/commercial-fee": "./shared/resources/commercial-fee.ts",
    "./resources/price": "./shared/resources/price.ts",
    "./source-request-identity": "./shared/source-request-identity.ts",
    "./testing/c14-price-input-bootstrap": "./tests/support/c14-price-input-bootstrap.fixture.ts",
    "./testing/c14-source-authority-bootstrap": "./tests/support/c14-source-authority-bootstrap.fixture.ts",
    "./testing/c14-source-authority": "./tests/support/c14-source-authority.fixture.ts"
  },
  "scripts": {
    "build": "cross-env ULTRAMODERN_SKIP_SERVER_TYPECHECK=1 modern build --deploy-target node && node ../../scripts/generate-ontos-module-contract.mts --vertical pricing --target dist && ultramodern-create ultramodern public-surface --app pricing --target dist && modern deploy --skip-build --deploy-target node",
    "db:check": "drizzle-kit check --dialect postgresql --out ./drizzle --output text",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config drizzle.config.ts",
    "db:test": "rstest run tests/unit/database-schema-contract.test.ts --config rstest.config.ts",
    "db:verify": "node scripts/verify-db-schema.mts",
    "test:integration": "rstest --project integration",
    "test:unit": "rstest --project unit",
    "typecheck": "node ../../scripts/typecheck.mjs --build tsconfig.typecheck.json"
  },
  "dependencies": {
    "@app/catalog": "workspace:*",
    "@app/commerce-cart-finalization-contracts": "workspace:*",
    "@app/commerce-customer-context": "workspace:*",
    "@app/commerce-market-catalog": "workspace:*",
    "@app/commerce-order-contracts": "workspace:*",
    "@app/core-runtime": "workspace:*",
    "@app/gateway-principal-verifier": "workspace:*",
    "@app/price-group-catalog-contracts": "workspace:*",
    "@app/pricing-contracts": "workspace:*",
    "@app/shared-contracts": "workspace:*",
    "@effect/platform-node": "4.0.7",
    "@effect/sql-pg": "4.0.7",
    "@modern-js/backend-federation-contracts": "catalog:ultramodern",
    "@modern-js/bff-effect": "catalog:ultramodern",
    "@modern-js/plugin-bff": "catalog:ultramodern",
    "@module-federation/modern-js-v3": "npm:@bleedingdev/mf-modern-js-v3@2.9.4",
    "@module-federation/runtime": "npm:@bleedingdev/mf-runtime@2.9.3",
    "@noble/hashes": "2.2.0",
    "drizzle-orm": "1.0.0-rc.5-ab785fc",
    "effect": "4.0.7"
  },
  "devDependencies": {
    "@app/party-registry-identity-contracts": "workspace:*",
    "@app/shell-super-app": "workspace:*",
    "@modern-js/app-tools": "catalog:ultramodern",
    "@modern-js/app-tools-extensions": "catalog:ultramodern",
    "@modern-js/plugin-bff-build-extensions": "catalog:ultramodern",
    "@modern-js/ultramodern-app-tools": "catalog:ultramodern",
    "@rstest/core": "0.11.12",
    "@types/node": "^26.4.1",
    "bun-types": "1.4.0",
    "drizzle-kit": "1.0.0-rc.5-ab785fc",
    "effect-rstest": "https://pkg.pr.new/ScriptedAlchemy/effect-rstest@cbbf87e05c7517a85eb412d33421cd2ab5234597",
    "pg": "8.22.0",
    "typescript": "7.0.2"
  },
  "modernjs": {
    "preset": "presetUltramodern",
    "role": "api-only",
    "appId": "pricing",
    "topology": "../../topology/reference-topology.json",
    "apiRuntime": "effect",
    "ontosModule": {
      "contractPath": "/.well-known/ontos-module-manifest.json",
      "manifest": "./vertical.manifest.ts",
      "moduleId": "commerce.pricing",
      "registration": "./vertical.registration.ts",
      "schemaVersion": 2
    }
  },
  "zephyr:dependencies": {}
}
