{
  "name": "@app/projects",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./api": "./shared/api.ts",
    "./api/client": "./src/api/projects-client.ts"
  },
  "scripts": {
    "build": "modern build && node ../../scripts/generate-ontos-module-contract.mts --vertical projects --target dist && MODERNJS_DEPLOY=node modern deploy --skip-build",
    "cloudflare:build": "MODERNJS_DEPLOY=cloudflare modern build && node ../../scripts/generate-ontos-module-contract.mts --vertical projects --target cloudflare-dist && MODERNJS_DEPLOY=cloudflare modern deploy --skip-build",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config drizzle.config.ts",
    "db:test": "pnpm test:unit && pnpm test:integration",
    "dev": "modern dev",
    "serve": "modern serve",
    "test:integration": "node --test tests/integration/*.test.ts",
    "test:unit": "node --test tests/unit/*.test.ts",
    "typecheck": "node ../../scripts/ultramodern-typecheck.mts --project tsconfig.json"
  },
  "dependencies": {
    "@app/core-runtime": "workspace:*",
    "@app/shared-contracts": "workspace:*",
    "@modern-js/plugin-bff": "npm:@bleedingdev/modern-js-plugin-bff@3.8.2-ultramodern.12",
    "@modern-js/runtime": "npm:@bleedingdev/modern-js-runtime@3.8.2-ultramodern.12",
    "@module-federation/modern-js-v3": "2.8.0",
    "@module-federation/runtime": "2.8.0",
    "drizzle-orm": "0.45.2",
    "effect": "4.0.0-beta.107",
    "jose": "6.2.5",
    "pg": "8.22.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@effect/tsgo": "0.19.0",
    "@modern-js/app-tools": "npm:@bleedingdev/modern-js-app-tools@3.8.2-ultramodern.12",
    "@types/node": "^20",
    "@types/pg": "8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "drizzle-kit": "0.31.10",
    "typescript": "7.0.2"
  },
  "modernjs": {
    "appId": "projects",
    "apiRuntime": "effect",
    "preset": "presetUltramodern",
    "role": "module-federation-remote",
    "topology": "../../topology/reference-topology.json",
    "ontosModule": {
      "contractPath": "/.well-known/ontos-module-manifest.json",
      "manifest": "./vertical.manifest.ts",
      "moduleId": "projects.core",
      "registration": "./vertical.registration.ts",
      "schemaVersion": 2
    }
  }
}
