{
  "name": "@app/projects",
  "version": "0.1.0",
  "private": true,
  "exports": {
    "./api": "./shared/api.ts",
    "./api/client": "./src/api/projects-client.ts",
    "./locales/cs": "./locales/cs/projects.json",
    "./locales/en": "./locales/en/projects.json"
  },
  "scripts": {
    "dev": "node ../../scripts/prepare-dev-module-contract.mts projects && modern dev",
    "build": "pnpm --dir ../.. exec ultramodern-create ultramodern routes-generate --app projects --manifest-only && modern build --deploy-target node && node ../../scripts/generate-ontos-module-contract.mts --vertical projects --target dist && pnpm --dir ../.. exec ultramodern-create ultramodern public-surface --app projects --target dist && modern deploy --skip-build --deploy-target node",
    "cloudflare:build": "pnpm --dir ../.. exec ultramodern-create ultramodern routes-generate --app projects --manifest-only && modern build --deploy-target cloudflare && node ../../scripts/generate-ontos-module-contract.mts --vertical projects --target cloudflare-dist && pnpm --dir ../.. exec ultramodern-create ultramodern public-surface --app projects --target cloudflare-dist && modern deploy --skip-build --deploy-target cloudflare && ultramodern-create ultramodern cloudflare-output-verify --app projects",
    "cloudflare:deploy": "pnpm --dir ../.. exec ultramodern-create ultramodern routes-generate --app projects --manifest-only && modern build --deploy-target cloudflare && pnpm --dir ../.. exec ultramodern-create ultramodern public-surface --app projects --target cloudflare-dist --require-public-origin && modern deploy --skip-build --deploy-target cloudflare && ultramodern-create ultramodern cloudflare-output-verify --app projects --require-public-urls && wrangler deploy --config .output/wrangler.json",
    "cloudflare:preview": "pnpm run cloudflare:build && wrangler dev --config .output/wrangler.json",
    "cloudflare:proof": "ultramodern-create ultramodern cloudflare-proof --app projects",
    "serve": "modern serve",
    "typecheck": "ultramodern-create ultramodern typecheck --project tsconfig.json",
    "db:check": "drizzle-kit check --config drizzle.config.ts",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config drizzle.config.ts",
    "db:verify": "node scripts/verify-db-schema.mts",
    "test:unit": "rstest --project unit",
    "test:integration": "rstest --project integration",
    "db:test": "pnpm test:unit && pnpm test:integration"
  },
  "dependencies": {
    "@app/core-runtime": "workspace:*",
    "@app/gateway-principal-verifier": "workspace:*",
    "@app/shared-contracts": "workspace:*",
    "@app/shared-design-tokens": "workspace:*",
    "@effect/opentelemetry": "4.0.0",
    "@effect/platform-node": "4.0.0",
    "@effect/sql-pg": "4.0.0",
    "@modern-js/backend-federation-contracts": "catalog:ultramodern",
    "@modern-js/bff-effect": "catalog:ultramodern",
    "@modern-js/federation-runtime": "catalog:ultramodern",
    "@modern-js/i18n-integration": "catalog:ultramodern",
    "@modern-js/plugin-bff": "catalog:ultramodern",
    "@modern-js/plugin-bff-extensions": "catalog:ultramodern",
    "@modern-js/plugin-i18n": "catalog:ultramodern",
    "@modern-js/plugin-tanstack": "catalog:ultramodern",
    "@modern-js/runtime": "catalog:ultramodern",
    "@modern-js/runtime-extensions": "catalog:ultramodern",
    "@modern-js/runtime-renderer-extensions": "catalog:ultramodern",
    "@module-federation/modern-js-v3": "npm:@bleedingdev/mf-modern-js-v3@2.9.4",
    "@module-federation/runtime": "npm:@bleedingdev/mf-runtime@2.9.3",
    "@tanstack/react-router": "1.170.39",
    "@techsio/ui-kit": "0.25.1",
    "drizzle-orm": "1.0.0-rc.5-ab785fc",
    "effect": "4.0.0",
    "i18next": "26.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@effect/tsgo": "0.53.1",
    "@modern-js/app-tools": "catalog:ultramodern",
    "@modern-js/app-tools-extensions": "catalog:ultramodern",
    "@modern-js/plugin-bff-build-extensions": "catalog:ultramodern",
    "@modern-js/ultramodern-app-tools": "catalog:ultramodern",
    "@rsbuild/plugin-tailwindcss": "^2.0.3",
    "@rstest/core": "0.11.12",
    "@types/node": "^26.4.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "drizzle-kit": "1.0.0-rc.5-ab785fc",
    "effect-rstest": "https://pkg.pr.new/ScriptedAlchemy/effect-rstest@cbbf87e05c7517a85eb412d33421cd2ab5234597",
    "pg": "8.22.0",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2",
    "wrangler": "4.137.0"
  },
  "modernjs": {
    "preset": "presetUltramodern",
    "role": "module-federation-remote",
    "appId": "projects",
    "topology": "../../topology/reference-topology.json",
    "apiRuntime": "effect",
    "ontosModule": {
      "contractPath": "/.well-known/ontos-module-manifest.json",
      "manifest": "./vertical.manifest.ts",
      "moduleId": "projects.core",
      "registration": "./vertical.registration.ts",
      "schemaVersion": 2
    }
  },
  "zephyr:dependencies": {},
  "type": "module"
}
