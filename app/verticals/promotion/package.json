{
  "name": "@app/promotion",
  "version": "0.1.0",
  "private": true,
  "exports": {
    "./api": "./shared/api.ts",
    "./api/client": "./src/api/promotion-client.ts",
    "./resources/promotion": "./shared/resources/promotion.ts",
    "./resources/voucher": "./shared/resources/voucher.ts"
  },
  "scripts": {
    "dev": "node ../../scripts/prepare-dev-module-contract.mts promotion && ultramodern dev",
    "build": "ultramodern build --deploy-target node && node ../../scripts/generate-ontos-module-contract.mts --vertical promotion --target dist && pnpm --dir ../.. exec ultramodern-create ultramodern public-surface --app promotion --target dist && ultramodern deploy --skip-build --deploy-target node",
    "cloudflare:build": "ultramodern build --deploy-target cloudflare && node ../../scripts/generate-ontos-module-contract.mts --vertical promotion --target cloudflare-dist && pnpm --dir ../.. exec ultramodern-create ultramodern public-surface --app promotion --target cloudflare-dist && ultramodern deploy --skip-build --deploy-target cloudflare && ultramodern-create ultramodern cloudflare-output-verify --app promotion",
    "cloudflare:deploy": "node ../../scripts/immutable-application-release.mts deploy --app-directory .",
    "cloudflare:preview": "pnpm run cloudflare:build && wrangler dev --config .output/wrangler.json",
    "cloudflare:proof": "ultramodern-create ultramodern cloudflare-proof --app promotion",
    "serve": "ultramodern serve",
    "typecheck": "ultramodern-create ultramodern typecheck --project tsconfig.json",
    "test:unit": "rstest --project unit",
    "test:integration": "node ../../scripts/generate-ontos-module-contract.mts --vertical promotion --target dist && rstest --project integration",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config drizzle.config.ts",
    "db:check": "drizzle-kit check --dialect postgresql --out ./drizzle --output text",
    "db:verify": "node scripts/verify-db-schema.mts",
    "db:test": "node ../../scripts/generate-ontos-module-contract.mts --vertical promotion --target dist && rstest --project integration tests/integration/persistence.test.ts"
  },
  "dependencies": {
    "@app/core-runtime": "workspace:*",
    "@app/gateway-principal-verifier": "workspace:*",
    "@app/pricing-contracts": "workspace:*",
    "@app/shared-contracts": "workspace:*",
    "@effect/opentelemetry": "4.0.7",
    "@effect/platform-node": "4.0.7",
    "@effect/sql-pg": "4.0.7",
    "@modern-js/backend-federation-contracts": "catalog:ultramodern",
    "@modern-js/bff-effect": "catalog:ultramodern",
    "@modern-js/plugin-bff": "catalog:ultramodern",
    "@modern-js/plugin-bff-extensions": "catalog:ultramodern",
    "@module-federation/runtime": "npm:@bleedingdev/mf-runtime@2.9.3",
    "@noble/hashes": "2.2.0",
    "drizzle-orm": "1.0.0-rc.5-ab785fc",
    "effect": "4.0.7"
  },
  "devDependencies": {
    "@modern-js/app-tools": "catalog:ultramodern",
    "@modern-js/app-tools-extensions": "catalog:ultramodern",
    "@modern-js/plugin-bff-build-extensions": "catalog:ultramodern",
    "@modern-js/ultramodern-app-tools": "catalog:ultramodern",
    "@types/node": "^26.4.1",
    "typescript": "7.0.2",
    "@rstest/core": "0.11.12",
    "effect-rstest": "https://pkg.pr.new/ScriptedAlchemy/effect-rstest@cbbf87e05c7517a85eb412d33421cd2ab5234597",
    "drizzle-kit": "1.0.0-rc.5-ab785fc",
    "pg": "8.22.0",
    "wrangler": "4.137.0"
  },
  "engines": {
    "node": ">=26.12.0"
  },
  "modernjs": {
    "preset": "presetUltramodern",
    "role": "api-only",
    "appId": "promotion",
    "topology": "../../topology/reference-topology.json",
    "apiRuntime": "effect",
    "ontosModule": {
      "contractPath": "/.well-known/ontos-module-manifest.json",
      "manifest": "./vertical.manifest.ts",
      "moduleId": "commerce.promotion",
      "registration": "./vertical.registration.ts",
      "schemaVersion": 2
    }
  }
}
