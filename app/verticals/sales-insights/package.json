{
  "name": "@app/sales-insights",
  "version": "0.1.0",
  "private": true,
  "exports": {
    "./api": "./shared/api.ts",
    "./api/client": "./src/api/sales-insights-client.ts",
    "./clients/apply-command": "./src/api/apply-command-action-client.ts",
    "./clients/records": "./src/api/records-client.ts",
    "./contracts/apply-command": "./shared/actions/apply-command.ts",
    "./contracts/records": "./shared/apis/records.ts",
    "./metrics": "./shared/metrics.ts",
    "./permissions/demo.sales_insights.read_all": "./shared/permissions/sales-insights-read-all.ts",
    "./permissions/demo.sales_insights.write_all": "./shared/permissions/sales-insights-write-all.ts",
    "./resources/metric": "./shared/resources/metric.ts",
    "./resources/metric-collection": "./shared/resources/metric-collection.ts",
    "./Route": "./src/federation-entry.tsx"
  },
  "scripts": {
    "dev": "node ../../scripts/prepare-dev-module-contract.mts sales-insights && modern dev",
    "build": "pnpm --dir ../.. exec ultramodern-create ultramodern routes-generate --app sales-insights --manifest-only && modern build --deploy-target node && node ../../scripts/generate-ontos-module-contract.mts --vertical sales-insights --target dist && pnpm --dir ../.. exec ultramodern-create ultramodern public-surface --app sales-insights --target dist && modern deploy --skip-build --deploy-target node",
    "cloudflare:build": "pnpm --dir ../.. exec ultramodern-create ultramodern routes-generate --app sales-insights --manifest-only && modern build --deploy-target cloudflare && node ../../scripts/generate-ontos-module-contract.mts --vertical sales-insights --target cloudflare-dist && pnpm --dir ../.. exec ultramodern-create ultramodern public-surface --app sales-insights --target cloudflare-dist && modern deploy --skip-build --deploy-target cloudflare && ultramodern-create ultramodern cloudflare-output-verify --app sales-insights",
    "cloudflare:deploy": "pnpm --dir ../.. exec ultramodern-create ultramodern routes-generate --app sales-insights --manifest-only && modern build --deploy-target cloudflare && pnpm --dir ../.. exec ultramodern-create ultramodern public-surface --app sales-insights --target cloudflare-dist --require-public-origin && modern deploy --skip-build --deploy-target cloudflare && ultramodern-create ultramodern cloudflare-output-verify --app sales-insights --require-public-urls && wrangler deploy --config .output/wrangler.json",
    "cloudflare:preview": "pnpm run cloudflare:build && wrangler dev --config .output/wrangler.json",
    "cloudflare:proof": "ultramodern-create ultramodern cloudflare-proof --app sales-insights",
    "serve": "modern serve",
    "typecheck": "ultramodern-create ultramodern typecheck --project tsconfig.json",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:check": "drizzle-kit check --config drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config drizzle.config.ts",
    "test:unit": "rstest",
    "db:verify": "node scripts/verify-db-schema.mts"
  },
  "dependencies": {
    "@app/admin-ui": "workspace:*",
    "@app/core-runtime": "workspace:*",
    "@app/gateway-principal-verifier": "workspace:*",
    "@app/merchandise": "workspace:*",
    "@app/party-registry": "workspace:*",
    "@app/sales-pipeline": "workspace:*",
    "@app/shared-contracts": "workspace:*",
    "@app/shared-design-tokens": "workspace:*",
    "@app/siampark-billing-finance": "workspace:*",
    "@app/siampark-work": "workspace:*",
    "@app/tagging": "workspace:*",
    "@app/workforce": "workspace:*",
    "@effect/opentelemetry": "4.0.0-rc.117",
    "@effect/platform-node": "4.0.0-rc.117",
    "@effect/sql-pg": "4.0.0-rc.117",
    "@internationalized/date": "3.12.4",
    "@modern-js/bff-effect": "catalog:ultramodern",
    "@modern-js/federation-runtime": "catalog:ultramodern",
    "@modern-js/i18n-integration": "catalog:ultramodern",
    "@modern-js/plugin-bff": "catalog:ultramodern",
    "@modern-js/plugin-bff-extensions": "catalog:ultramodern",
    "@modern-js/plugin-i18n": "catalog:ultramodern",
    "@modern-js/plugin-tanstack": "catalog:ultramodern",
    "@modern-js/runtime": "catalog:ultramodern",
    "@modern-js/runtime-extensions": "catalog:ultramodern",
    "@modern-js/runtime-renderer-extensions": "catalog:ultramodern",
    "@module-federation/modern-js-v3": "npm:@bleedingdev/mf-modern-js-v3@2.9.3",
    "@module-federation/runtime": "npm:@bleedingdev/mf-runtime@2.9.2",
    "@tanstack/react-router": "1.170.39",
    "@techsio/ui-kit": "0.56.0",
    "drizzle-orm": "1.0.0-rc.5-ab785fc",
    "effect": "4.0.0-rc.117",
    "i18next": "26.4.2",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@effect/tsgo": "0.41.0",
    "@modern-js/app-tools": "catalog:ultramodern",
    "@modern-js/app-tools-extensions": "catalog:ultramodern",
    "@modern-js/plugin-bff-build-extensions": "catalog:ultramodern",
    "@modern-js/ultramodern-app-tools": "catalog:ultramodern",
    "@rsbuild/plugin-tailwindcss": "^2.0.3",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@typescript/native": "npm:typescript@7.0.2",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2",
    "wrangler": "4.137.0",
    "zephyr-rspack-plugin": "1.2.4",
    "drizzle-kit": "1.0.0-rc.5-ab785fc",
    "@rstest/core": "0.11.12",
    "effect-rstest": "https://pkg.pr.new/ScriptedAlchemy/effect-rstest@cbbf87e05c7517a85eb412d33421cd2ab5234597",
    "pg": "8.22.0"
  },
  "modernjs": {
    "preset": "presetUltramodern",
    "role": "module-federation-remote",
    "appId": "sales-insights",
    "topology": "../../topology/reference-topology.json",
    "apiRuntime": "effect",
    "ontosModule": {
      "contractPath": "/.well-known/ontos-module-manifest.json",
      "manifest": "./vertical.manifest.ts",
      "moduleId": "demo.sales-insights",
      "registration": "./vertical.registration.ts",
      "schemaVersion": 2
    }
  },
  "zephyr:dependencies": {},
  "type": "module"
}
