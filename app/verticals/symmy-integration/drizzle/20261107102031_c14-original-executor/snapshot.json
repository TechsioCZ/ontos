    {
      "value": "\"audience\" = 'symmy-integration'",
      "name": "symmy_gateway_assertion_redemptions_audience_ck",
      "entityType": "checks",
      "schema": "symmy_integration",
      "table": "gateway_assertion_redemptions"
    },
    {
      "value": "\"idempotency_digest\" ~ '^[0-9a-f]{64}$' and \"intent_digest\" ~ '^[0-9a-f]{64}$'",
      "name": "symmy_import_jobs_digests_ck",
      "entityType": "checks",
      "schema": "symmy_integration",
      "table": "import_jobs"
    },
    {
      "value": "char_length(\"fixture_id\") between 1 and 80",
      "name": "symmy_import_jobs_fixture_id_ck",
      "entityType": "checks",
      "schema": "symmy_integration",
      "table": "import_jobs"
    },
    {
      "value": "\"phase\" = 'admitted'",
      "name": "symmy_import_jobs_phase_ck",
      "entityType": "checks",
      "schema": "symmy_integration",
      "table": "import_jobs"
    },
    {
      "value": "\"version\" >= 0",
      "name": "symmy_job_effects_version_ck",
      "entityType": "checks",
      "schema": "symmy_integration",
      "table": "job_effects"
    },
    {
      "value": "\"state\" in ('planned', 'attempting', 'indeterminate', 'blocked', 'settled')",
      "name": "symmy_job_effects_state_ck",
      "entityType": "checks",
      "schema": "symmy_integration",
      "table": "job_effects"
    },
    {
      "value": "\"effect\"->>'itemId' = \"item_id\"::text and \"effect\"->>'effectKey' = \"effect_key\" and \"effect\" #>> '{ref,effectId}' = \"effect_id\"::text",
      "name": "symmy_job_effects_ref_ck",
      "entityType": "checks",
      "schema": "symmy_integration",
      "table": "job_effects"
    },
    {
      "value": "(\"state\" = 'attempting') = (\"claim_token\" is not null and \"lease_until\" is not null)",
      "name": "symmy_job_effects_lease_ck",
      "entityType": "checks",
      "schema": "symmy_integration",
      "table": "job_effects"
    },
    {
      "value": "(\"state\" in ('settled', 'blocked')) = (\"outcome\" is not null)",
      "name": "symmy_job_effects_outcome_ck",
      "entityType": "checks",
      "schema": "symmy_integration",
      "table": "job_effects"
    },
    {
      "value": "\"state\" <> 'blocked' or \"outcome\"->>'status' = 'denied'",
      "name": "symmy_job_effects_blocked_ck",
      "entityType": "checks",
      "schema": "symmy_integration",
      "table": "job_effects"
    },
    {
      "value": "(\n        \"route_key\" in ('customerGroupCustomersBatch', 'priceListPricesBatch')\n        and \"route_code\" is not null and char_length(\"route_code\") between 1 and 80\n      ) or (\n        \"route_key\" in ('customersBatch', 'priceListsBatchUpsert', 'productsBatch', 'customerGroupsBatch', 'inventoryStockBatch', 'adminCustomers', 'adminProducts', 'adminRegions', 'priceLists') and \"route_code\" is null\n      )",
      "name": "symmy_job_routes_selector_ck",
      "entityType": "checks",
      "schema": "symmy_integration",
      "table": "job_routes"
    },
