{
  "name": "@app/symmy-integration",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./api": "./shared/api.ts",
    "./api/admit-symmy-job-action": "./shared/apis/admit-symmy-job-action.ts",
    "./api/admit-symmy-job-action/client": "./src/api/admit-symmy-job-action-client.ts",
    "./api/admit-symmy-sync-action": "./shared/apis/admit-symmy-sync-action.ts",
    "./api/admit-symmy-sync-action/client": "./src/api/admit-symmy-sync-action-client.ts",
    "./api/client": "./shared/symmy-integration-client.ts",
    "./api/execute-symmy-retention-action": "./shared/apis/execute-symmy-retention-action.ts",
    "./api/symmy-job-privacy-execution": "./shared/apis/symmy-job-privacy-execution.ts",
    "./api/symmy-job-privacy-execution/client": "./src/api/symmy-job-privacy-execution-client.ts",
    "./api/symmy-job-status": "./shared/apis/symmy-job-status.ts",
    "./api/symmy-job-status/client": "./src/api/symmy-job-status-client.ts",
    "./api/symmy-route-context": "./shared/apis/symmy-route-context.ts",
    "./api/symmy-route-context/client": "./src/api/symmy-route-context-client.ts",
    "./api/symmy-sync-admission": "./shared/apis/symmy-sync-admission.ts",
    "./api/symmy-sync-admission/client": "./src/api/symmy-sync-admission-client.ts",
    "./api/symmy-source-organization-facts": "./shared/apis/symmy-source-organization-facts.ts",
    "./api/symmy-source-organization-facts/client": "./src/api/symmy-source-organization-facts-client.ts",
    "./outbox-worker-host": "./src/worker-host/entry.ts",
    "./outbox/integration-symmy-job-admitted-v1": "./shared/outbox/integration-symmy-job-admitted-v1.ts",
    "./resources/import-job": "./shared/resources/import-job.ts",
    "./resources/sync-admission": "./shared/resources/sync-admission.ts",
    "./symmy-internal-contracts": "./shared/symmy-internal-contracts.ts",
    "./symmy-source-selector": "./shared/domain/symmy-source-selector.ts",
    "./testing/accepted-effect-native": "./tests/support/accepted-effect-native.fixture.ts"
  },
  "scripts": {
    "build": "ultramodern build --deploy-target node && node ../../scripts/generate-ontos-module-contract.mts --vertical symmy-integration --target dist && pnpm --dir ../.. exec ultramodern-create ultramodern public-surface --app symmy-integration --target dist && ultramodern deploy --skip-build --deploy-target node",
    "cloudflare:build": "ultramodern build --deploy-target cloudflare && node ../../scripts/generate-ontos-module-contract.mts --vertical symmy-integration --target cloudflare-dist && pnpm --dir ../.. exec ultramodern-create ultramodern public-surface --app symmy-integration --target cloudflare-dist && ultramodern deploy --skip-build --deploy-target cloudflare && ultramodern-create ultramodern cloudflare-output-verify --app symmy-integration",
    "cloudflare:deploy": "ultramodern build --deploy-target cloudflare && pnpm --dir ../.. exec ultramodern-create ultramodern public-surface --app symmy-integration --target cloudflare-dist --require-public-origin && ultramodern deploy --skip-build --deploy-target cloudflare && ultramodern-create ultramodern cloudflare-output-verify --app symmy-integration --require-public-urls && wrangler deploy --config .output/wrangler.json",
    "cloudflare:preview": "pnpm run cloudflare:build && wrangler dev --config .output/wrangler.json",
    "cloudflare:proof": "ultramodern-create ultramodern cloudflare-proof --app symmy-integration",
    "db:check": "drizzle-kit check --config drizzle.config.ts",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config drizzle.config.ts",
    "db:test": "pnpm test:integration",
    "db:verify": "node scripts/verify-db-schema.mts",
    "dev": "node ../../scripts/prepare-dev-module-contract.mts symmy-integration && ultramodern dev",
    "serve": "ultramodern serve",
    "test:integration": "rstest --project integration",
    "test:unit": "rstest --project unit",
    "typecheck": "ultramodern-create ultramodern typecheck --project tsconfig.json",
    "worker:start": "node --experimental-strip-types ./src/worker-host/main.ts"
  },
  "dependencies": {
    "@app/assortment": "workspace:*",
    "@app/catalog": "workspace:*",
    "@app/commerce-customer-context": "workspace:*",
    "@app/core-runtime": "workspace:*",
    "@app/gateway-principal-verifier": "workspace:*",
    "@app/inventory": "workspace:*",
    "@app/party-registry": "workspace:*",
    "@app/price-group-catalog": "workspace:*",
    "@app/pricing": "workspace:*",
    "@app/privacy": "workspace:*",
    "@app/shared-contracts": "workspace:*",
    "@app/tax": "workspace:*",
    "@effect/opentelemetry": "4.0.7",
    "@effect/platform-node": "4.0.7",
    "@effect/sql-pg": "4.0.7",
    "@modern-js/backend-federation-contracts": "catalog:ultramodern",
    "@modern-js/bff-effect": "catalog:ultramodern",
    "@modern-js/plugin-bff": "catalog:ultramodern",
    "@modern-js/plugin-bff-extensions": "catalog:ultramodern",
    "@module-federation/runtime": "npm:@bleedingdev/mf-runtime@2.9.3",
    "@noble/hashes": "2.2.0",
    "drizzle-orm": "1.0.0-rc.5-ab785fc",
    "effect": "4.0.7"
  },
  "devDependencies": {
    "@modern-js/app-tools": "catalog:ultramodern",
    "@modern-js/app-tools-extensions": "catalog:ultramodern",
    "@modern-js/plugin-bff-build-extensions": "catalog:ultramodern",
    "@modern-js/ultramodern-app-tools": "catalog:ultramodern",
    "@rstest/core": "0.12.6",
    "@types/node": "^26.4.1",
    "drizzle-kit": "1.0.0-rc.5-ab785fc",
    "effect-rstest": "https://pkg.pr.new/ScriptedAlchemy/effect-rstest@cbbf87e05c7517a85eb412d33421cd2ab5234597",
    "pg": "8.22.0",
    "typescript": "7.0.2",
    "wrangler": "4.137.0"
  },
  "engines": {
    "node": ">=26.12.0"
  },
  "modernjs": {
    "preset": "presetUltramodern",
    "role": "api-only",
    "appId": "symmy-integration",
    "topology": "../../topology/reference-topology.json",
    "apiRuntime": "effect",
    "ontosModule": {
      "contractPath": "/.well-known/ontos-module-manifest.json",
      "manifest": "./vertical.manifest.ts",
      "moduleId": "integration.symmy",
      "registration": "./vertical.registration.ts",
      "schemaVersion": 2
    }
  }
}
