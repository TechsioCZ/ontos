{
  "name": "@app/tax",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./api": "./shared/api.ts",
    "./api/client": "./src/api/tax-client.ts"
  },
  "scripts": {
    "build": "modern build --deploy-target node && node ../../scripts/generate-ontos-module-contract.mts --vertical tax --target dist && ultramodern-create ultramodern public-surface --app tax --target dist && modern deploy --skip-build --deploy-target node",
    "cloudflare:build": "modern build --deploy-target cloudflare && node ../../scripts/generate-ontos-module-contract.mts --vertical tax --target cloudflare-dist && ultramodern-create ultramodern public-surface --app tax --target cloudflare-dist && modern deploy --skip-build --deploy-target cloudflare",
    "cloudflare:deploy": "node ../../scripts/immutable-application-release.mts deploy --app-directory .",
    "cloudflare:preview": "pnpm run cloudflare:build && wrangler dev --config .output/wrangler.json",
    "cloudflare:proof": "ultramodern-create ultramodern cloudflare-proof --app tax",
    "dev": "modern dev",
    "test:unit": "rstest --project unit",
    "typecheck": "ultramodern-create ultramodern typecheck --project tsconfig.json"
  },
  "dependencies": {
    "@app/core-runtime": "workspace:*",
    "@app/gateway-principal-verifier": "workspace:*",
    "@app/shared-contracts": "workspace:*",
    "@modern-js/bff-effect": "catalog:ultramodern",
    "@modern-js/plugin-bff": "catalog:ultramodern",
    "@modern-js/plugin-i18n": "catalog:ultramodern",
    "@modern-js/plugin-tanstack": "catalog:ultramodern",
    "@modern-js/runtime": "catalog:ultramodern",
    "@module-federation/modern-js-v3": "npm:@bleedingdev/mf-modern-js-v3@2.9.3",
    "@module-federation/runtime": "npm:@bleedingdev/mf-runtime@2.9.2",
    "effect": "4.0.0-rc.117",
    "i18next": "26.4.2",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@modern-js/app-tools": "catalog:ultramodern",
    "@modern-js/app-tools-extensions": "catalog:ultramodern",
    "@modern-js/plugin-bff-build-extensions": "catalog:ultramodern",
    "@modern-js/ultramodern-app-tools": "catalog:ultramodern",
    "@rstest/core": "0.11.12",
    "@types/node": "20.19.43",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "effect-rstest": "https://pkg.pr.new/ScriptedAlchemy/effect-rstest@cbbf87e05c7517a85eb412d33421cd2ab5234597",
    "typescript": "7.0.2",
    "wrangler": "4.137.0"
  },
  "modernjs": {
    "preset": "presetUltramodern",
    "role": "module-federation-remote",
    "appId": "tax",
    "topology": "../../topology/reference-topology.json",
    "apiRuntime": "effect",
    "ontosModule": {
      "contractPath": "/.well-known/ontos-module-manifest.json",
      "manifest": "./vertical.manifest.ts",
      "moduleId": "commerce.tax",
      "registration": "./vertical.registration.ts",
      "schemaVersion": 2
    }
  },
  "zephyr:dependencies": {}
}
