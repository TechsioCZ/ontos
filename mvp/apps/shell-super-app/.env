# UltraModern environment defaults (committed, non-secret).
# Per-developer overrides go in .env.local or the shell, which take precedence.

# Zephyr Cloud deployment switch.
# false  -> Zephyr disabled. `pnpm dev` boots without prompting for Zephyr Cloud auth.
# true   -> Zephyr enabled (requires Zephyr Cloud authentication).
# Read by apps/shell-super-app/modern.config.ts; build scripts also pass it inline.
ULTRAMODERN_ZEPHYR=false
