{
  "private": true,
  "name": "@mvp/ultramodern-config",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "node -e \"const fs = require('node:fs'); const { execFileSync, spawnSync } = require('node:child_process'); const bin = execFileSync('effect-tsgo', ['get-exe-path'], { encoding: 'utf8' }).trim(); if (process.platform !== 'win32') fs.chmodSync(bin, 0o755); const result = spawnSync(bin, ['--noEmit', '-p', 'tsconfig.json'], { stdio: 'inherit' }); process.exit(result.status ?? 1);\""
  },
  "dependencies": {
    "@modern-js/app-tools": "npm:@bleedingdev/modern-js-app-tools@3.2.0-ultramodern.120",
    "@modern-js/plugin-bff": "npm:@bleedingdev/modern-js-plugin-bff@3.2.0-ultramodern.120",
    "@modern-js/plugin-i18n": "npm:@bleedingdev/modern-js-plugin-i18n@3.2.0-ultramodern.120",
    "@modern-js/plugin-tanstack": "npm:@bleedingdev/modern-js-plugin-tanstack@3.2.0-ultramodern.120",
    "@modern-js/runtime": "npm:@bleedingdev/modern-js-runtime@3.2.0-ultramodern.120",
    "@module-federation/modern-js-v3": "2.5.1",
    "@tanstack/react-router": "1.170.15",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zephyr-rspack-plugin": "1.1.1"
  },
  "devDependencies": {
    "@effect/tsgo": "0.14.3",
    "@types/node": "^20",
    "@typescript/native-preview": "7.0.0-dev.20260610.1",
    "typescript": "6.0.3"
  }
}
