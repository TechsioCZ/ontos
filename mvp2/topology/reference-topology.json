{
  "schemaVersion": 1,
  "id": "ultramodern-superapp-workspace-reference-topology",
  "description": "Generated UltraModern SuperApp shell that can grow by adding full-stack verticals.",
  "preset": "presetUltramodern",
  "shell": {
    "id": "shell-super-app",
    "kind": "shell",
    "package": "@mvp2/shell-super-app",
    "verticalRefs": [
      "properties"
    ],
    "moduleFederation": {
      "role": "host",
      "name": "shellSuperApp",
      "remotes": [
        {
          "id": "properties",
          "name": "verticalProperties",
          "manifestUrl": "http://localhost:4101/mf-manifest.json"
        }
      ],
      "ssr": true,
      "sharedContractVersion": "mf-ssr-contract-v1"
    },
    "cloudflare": {
      "target": "cloudflare",
      "workerName": "mvp2-shell-super-app",
      "publicUrlEnv": "ULTRAMODERN_PUBLIC_URL_SHELL_SUPER_APP",
      "compatibilityDate": "2026-06-02",
      "compatibilityFlags": [
        "nodejs_compat",
        "global_fetch_strictly_public"
      ],
      "assetsBinding": "ASSETS",
      "routes": {
        "ssr": "/en",
        "mfManifest": "/mf-manifest.json",
        "locale": "/locales/en/shell.json"
      },
      "security": {
        "enabled": true,
        "headers": {
          "referrerPolicy": "strict-origin-when-cross-origin",
          "contentTypeOptions": "nosniff",
          "permissionsPolicy": "camera=(), geolocation=(), microphone=(), payment=(), usb=()"
        },
        "contentSecurityPolicy": {
          "mode": "report-only",
          "directives": {
            "base-uri": [
              "'self'"
            ],
            "connect-src": [
              "'self'",
              "https:",
              "http:",
              "wss:",
              "ws:"
            ],
            "default-src": [
              "'self'"
            ],
            "font-src": [
              "'self'",
              "data:",
              "https:",
              "http:"
            ],
            "form-action": [
              "'self'"
            ],
            "frame-ancestors": [
              "'self'"
            ],
            "img-src": [
              "'self'",
              "data:",
              "blob:",
              "https:",
              "http:"
            ],
            "manifest-src": [
              "'self'",
              "https:",
              "http:"
            ],
            "object-src": [
              "'none'"
            ],
            "script-src": [
              "'self'",
              "'unsafe-inline'",
              "'unsafe-eval'",
              "https:",
              "http:",
              "blob:"
            ],
            "style-src": [
              "'self'",
              "'unsafe-inline'",
              "https:",
              "http:"
            ],
            "worker-src": [
              "'self'",
              "blob:"
            ]
          },
          "reason": "Report-only by default so Cloudflare Module Federation SSR can prove remote script, style, and connect compatibility before enforcement."
        },
        "noindex": {
          "workersDev": true,
          "localhost": true,
          "previewHostnames": []
        }
      },
      "qualityGates": {
        "publicRoutes": {
          "requireSitemapWhenPresent": true,
          "requireRobotsSitemapConsistency": true,
          "requireWebManifestWhenPresent": true
        },
        "statusCodes": {
          "notFoundRoute": "/__ultramodern-smoke-missing",
          "unknownRouteStatus": 404
        },
        "indexing": {
          "previewNoindex": true,
          "productionPublicRoutesIndexable": true
        },
        "assets": {
          "cssPreloadRequired": true,
          "cssResponseRequired": true,
          "cacheControlRequiredForCss": true,
          "sourcemapsPubliclyReferenced": false
        },
        "budgets": {
          "ssrHtmlMaxBytes": 250000,
          "mfManifestMaxBytes": 500000,
          "localeJsonMaxBytes": 100000,
          "sitemapXmlMaxBytes": 500000,
          "cssAssetMaxBytes": 750000
        },
        "csp": {
          "finalMode": "report-only-dogfood",
          "decision": "Report-only remains the generated final mode until public smoke proof records MF SSR script/style/connect compatibility for the deployed surface."
        }
      },
      "evidence": {
        "proofScript": "scripts/proof-cloudflare-version.mjs",
        "reportDefault": ".codex/reports/cloudflare-version-proof/public-url-proof.json"
      }
    },
    "ownership": {
      "team": "super-app-platform",
      "slack": "#super-app-platform",
      "pagerDuty": "pd-super-app-platform",
      "runbookRef": "runbooks/wave2/shell-super-app.md",
      "adrRef": "docs/super-app-rfc-adr/wave2/reference-topology.md#shell-super-app",
      "blastRadius": {
        "tier": "tier-0-shell",
        "references": [
          "docs/super-app-rfc-adr/wave2/blast-radius.md#shell",
          "docs/super-app-rfc-adr/wave2/rollback.md#shell-lkg"
        ]
      }
    }
  },
  "verticals": [
    {
      "id": "properties",
      "kind": "vertical",
      "domain": "properties",
      "package": "@mvp2/properties",
      "path": "verticals/properties",
      "moduleFederation": {
        "role": "remote",
        "name": "verticalProperties",
        "manifestUrl": "http://localhost:4101/mf-manifest.json",
        "exposes": [
          "./Route",
          "./Widget"
        ],
        "ssr": true,
        "fallbackTelemetryEvent": "modernjs:mv-runtime-parity",
        "sharedContractVersion": "mf-ssr-contract-v1"
      },
      "api": {
        "effect": {
          "runtime": "effect",
          "bff": {
            "prefix": "/properties-api",
            "openapi": "/openapi.json"
          },
          "contract": {
            "export": "./shared/effect/api",
            "path": "verticals/properties/shared/effect/api.ts"
          },
          "client": {
            "export": "./effect/client",
            "path": "verticals/properties/src/effect/properties-client.ts"
          },
          "serverEntry": "verticals/properties/api/effect/index.ts",
          "basePath": "/properties-api/effect/properties",
          "consumedBy": [
            "shell-super-app",
            "properties"
          ],
          "readiness": {
            "endpoint": "/effect/properties/readiness",
            "marker": {
              "ui": "ultramodernUiMarker",
              "api": "ultramodernApiMarker",
              "skew": "none"
            },
            "checks": [
              "moduleFederation",
              "ssr",
              "translations",
              "effectBff"
            ]
          },
          "requestContext": {
            "propagatedHeaders": [
              "accept-language",
              "authorization",
              "traceparent",
              "x-correlation-id",
              "x-tenant-id",
              "x-ultramodern-env",
              "x-vertical-version-id"
            ],
            "source": "shell-to-vertical-effect-client"
          },
          "domainOperations": {
            "workspaceFeed": {
              "client": "listProperties",
              "method": "GET",
              "path": "/effect/properties",
              "resource": "workspace-items",
              "owner": "properties"
            },
            "workspaceDetail": {
              "client": "getProperties",
              "method": "GET",
              "path": "/effect/properties/:id",
              "resource": "workspace-item",
              "owner": "properties"
            },
            "workspaceCreate": {
              "client": "createProperties",
              "method": "POST",
              "path": "/effect/properties",
              "resource": "properties",
              "owner": "properties"
            }
          }
        }
      },
      "cloudflare": {
        "target": "cloudflare",
        "workerName": "mvp2-properties",
        "publicUrlEnv": "ULTRAMODERN_PUBLIC_URL_PROPERTIES",
        "compatibilityDate": "2026-06-02",
        "compatibilityFlags": [
          "nodejs_compat",
          "global_fetch_strictly_public"
        ],
        "assetsBinding": "ASSETS",
        "routes": {
          "ssr": "/en",
          "mfManifest": "/mf-manifest.json",
          "locale": "/locales/en/properties.json",
          "effectReadiness": "/properties-api/effect/properties/readiness"
        },
        "security": {
          "enabled": true,
          "headers": {
            "referrerPolicy": "strict-origin-when-cross-origin",
            "contentTypeOptions": "nosniff",
            "permissionsPolicy": "camera=(), geolocation=(), microphone=(), payment=(), usb=()"
          },
          "contentSecurityPolicy": {
            "mode": "report-only",
            "directives": {
              "base-uri": [
                "'self'"
              ],
              "connect-src": [
                "'self'",
                "https:",
                "http:",
                "wss:",
                "ws:"
              ],
              "default-src": [
                "'self'"
              ],
              "font-src": [
                "'self'",
                "data:",
                "https:",
                "http:"
              ],
              "form-action": [
                "'self'"
              ],
              "frame-ancestors": [
                "'self'"
              ],
              "img-src": [
                "'self'",
                "data:",
                "blob:",
                "https:",
                "http:"
              ],
              "manifest-src": [
                "'self'",
                "https:",
                "http:"
              ],
              "object-src": [
                "'none'"
              ],
              "script-src": [
                "'self'",
                "'unsafe-inline'",
                "'unsafe-eval'",
                "https:",
                "http:",
                "blob:"
              ],
              "style-src": [
                "'self'",
                "'unsafe-inline'",
                "https:",
                "http:"
              ],
              "worker-src": [
                "'self'",
                "blob:"
              ]
            },
            "reason": "Report-only by default so Cloudflare Module Federation SSR can prove remote script, style, and connect compatibility before enforcement."
          },
          "noindex": {
            "workersDev": true,
            "localhost": true,
            "previewHostnames": []
          }
        },
        "qualityGates": {
          "publicRoutes": {
            "requireSitemapWhenPresent": true,
            "requireRobotsSitemapConsistency": true,
            "requireWebManifestWhenPresent": true
          },
          "statusCodes": {
            "notFoundRoute": "/__ultramodern-smoke-missing",
            "unknownRouteStatus": 404
          },
          "indexing": {
            "previewNoindex": true,
            "productionPublicRoutesIndexable": true
          },
          "assets": {
            "cssPreloadRequired": true,
            "cssResponseRequired": true,
            "cacheControlRequiredForCss": true,
            "sourcemapsPubliclyReferenced": false
          },
          "budgets": {
            "ssrHtmlMaxBytes": 250000,
            "mfManifestMaxBytes": 500000,
            "localeJsonMaxBytes": 100000,
            "sitemapXmlMaxBytes": 500000,
            "cssAssetMaxBytes": 750000
          },
          "csp": {
            "finalMode": "report-only-dogfood",
            "decision": "Report-only remains the generated final mode until public smoke proof records MF SSR script/style/connect compatibility for the deployed surface."
          }
        },
        "evidence": {
          "proofScript": "scripts/proof-cloudflare-version.mjs",
          "reportDefault": ".codex/reports/cloudflare-version-proof/public-url-proof.json"
        }
      },
      "ownership": {
        "team": "super-app-platform",
        "slack": "#super-app-platform",
        "pagerDuty": "pd-super-app-platform",
        "runbookRef": "runbooks/verticals/properties.md",
        "adrRef": "docs/super-app-rfc-adr/verticals.md#properties",
        "blastRadius": {
          "tier": "tier-2-vertical",
          "references": [
            "docs/super-app-rfc-adr/blast-radius.md#properties"
          ]
        }
      }
    }
  ],
  "sharedPackages": [
    {
      "id": "shared-contracts",
      "package": "@mvp2/shared-contracts",
      "path": "packages/shared-contracts",
      "description": "Route, ownership, and topology contract placeholders."
    },
    {
      "id": "shared-design-tokens",
      "package": "@mvp2/shared-design-tokens",
      "path": "packages/shared-design-tokens",
      "description": "Design token placeholders consumed by shell and verticals."
    }
  ],
  "validation": {
    "script": "scripts/validate-ultramodern-workspace.mjs",
    "commands": [
      "pnpm i18n:boundaries",
      "pnpm contract:check"
    ]
  }
}
